// The compiler builds itself through the same project graph as user programs.
Builder, BuildError = std.build
Res, Ok = std.core

build = (b :: Builder) Res<(), BuildError> {
    b.exe("zen", {
        src: Path("src/zen/zen.zen"),
        deps: [],
        out: Ok(Path("zen")),
    }).try();
    Ok(())
}
