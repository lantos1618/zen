{ stream_xor, authenticate, initialize, poly_key } = chacha20poly1305
time = (env: Env, label: str, count: usize, run: () ()) {
    target: u64 = 300000000;
    start = env.clock.since_start().ns;
    elapsed :: u64 = 0; bytes :: u64 = 0;
    (elapsed < target).loop((h) {
        Range<usize>(0, 64).loop((i) { run(); });
        bytes   = bytes + 64 * count.to_u64();
        elapsed = env.clock.since_start().ns - start;
    });
    tenths = bytes * 10000 / elapsed;
    println("{} {} B: {}.{} MB/s", label, count, tenths / 10, tenths % 10);
}
main = (env: Env) Res<i32, AllocError> {
    a       = env.mem.alloc();
    buffer  = a.realloc<u8>(null_ptr<u8>(), 16384 + 64).try();
    out     = a.realloc<u8>(null_ptr<u8>(), 16384 + 64).try();
    key     = a.realloc<u8>(null_ptr<u8>(), 64).try();
    scratch = a.realloc<u64>(null_ptr<u64>(), 40).try();
    Range<usize>(0, 64).loop((i) { key.write(i, (i * 7 + 3).to_u8().match({Ok(b) => b, None => 0})); });
    Range<usize>(0, 16384).loop((i) { buffer.write(i, (i % 251).to_u8().match({Ok(b) => b, None => 0})); });
    initialize(scratch, key, key.offset(32));
    poly_key(scratch);
    count: usize = 16384;
    time(env, "chacha20", count, () { stream_xor(scratch, out, buffer, count); });
    time(env, "poly1305", count, () { authenticate(scratch, key, 0, buffer, count); });
    println("check {}", out.read(100));
    Ok(0)
}
