@@ -19,12 +19,16 @@
 //
 // Encryption-only: GCM never needs the inverse cipher.
 Ptr = std.mem
-bit_xor, bit_and, shift_right = std.core.num
+bit_xor, bit_and, bit_or, shift_left, shift_right = std.core.num
