@@ -364,14 +381,288 @@
         true  => {
             sp = spans(scratch);
             count = ciphertext_count - 16;
-            setup(sp, key, nonce);
-            authenticate(sp, ciphertext, count, aad, aad_count);
-            // subtle.ConstantTimeCompare over the full tag.
-            difference: u64 ::= 0;
-            Range(0, 16).loop((i) { difference = or64(difference, sp.tag.read(i).to_u64().bit_xor(ciphertext.read(count + i).to_u64())); });
-            authentic = difference == 0;
-            authentic.then(() { counter_crypt(sp, output, ciphertext, count); });
-            authentic
+            powers = scratch.offset(48).to<u8>();
+            aes().match({
+                Ok(cpu) => clmul().match({
