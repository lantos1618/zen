// ZEN_LANGUAGE.md §2: bytes to tokens. A token is a kind and a span. A lexical fault is
// a token too (Kind.Fault), so lexing never fails and the parser reports the first fault.

{ Res, Ok, None, Range, to_usize, truncate_u32, is_digit, is_space, is_ident_start, is_ident_cont } = std.core
{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ str } = std.text
{ Source } = front.parse.source

Kind* = {
    | Name
    | At            // @Self @meta @scope
    | Int
    | Float
    | Str
    | Char
    | LParen        // (
    | RParen        // )
    | LBrace        // {
    | RBrace        // }
    | LBracket      // [
    | RBracket      // ]
    | Comma         // ,
    | Semi          // ;
    | Dot           // .
    | Colon         // :
    | ColonColon    // ::
    | Define        // ::=
    | Assign        // =
    | Arrow         // =>
    | Equal         // ==
    | NotEqual      // !=
    | Lt            // <
    | Le            // <=
    | Gt            // >
    | Ge            // >=
    | Plus          // +
    | Minus         // -
    | Star          // *
    | Slash         // /
    | Percent       // %
    | PlusWrap      // +%
    | MinusWrap     // -%
    | StarWrap      // *%
    | Amp           // &
    | Pipe          // |
    | Caret         // ^
    | Tilde         // ~
    | Shl           // <<
    | Shr           // >>
    | Not           // !
    | And           // &&
    | Or            // ||
    | End
    | Fault: Fault
}

Fault* = {
    | LeadingZero
    | IntegerTooLarge
    | UnknownEscape
    | Unterminated
    | UnexpectedByte
}

Token* = { kind*: Kind, start*: u32, end*: u32 }

lex* = (a: Alloc, text: str) Res<Vec<Token>, AllocError> {
    s = Source(text: text);
    tokens ::= a.Vec<Token>();
    at ::= skip(s, 0);
    Range(0, text.len + 1).loop((h, _) {
        t = token(s, at);
        tokens.add(t).try();
        t.kind.match({ End => h.break(), _ => () });
        at = skip(s, t.end.to_usize());
    });
    Ok(tokens)
}

// Past whitespace and `//` comments.
skip = (s: Source, from: usize) usize {
    i ::= from;
    Range(from, s.text.len + 1).loop((h, _) {
        comment = s.byte(i) == '/' && s.byte(i + 1) == '/';
        is_space(s.byte(i)).match({
            true  => { i = i + 1; },
            false => comment.match({ true => { i = s.line_end(i); }, false => h.break() }),
        });
    });
    i
}

span = (kind: Kind, start: usize, end: usize) Token {
    Token(kind: kind, start: start.truncate_u32(), end: end.truncate_u32())
}

// What a token's first byte says it is.
Start = {
    | End
    | Name
    | Digit
    | Quote
    | Apostrophe
    | At
    | Other
}

start = (s: Source, at: usize) Start {
    c = s.byte(at);
    (at >= s.text.len).match({
        true  => Start.End,
        false => is_ident_start(c).match({
            true  => Start.Name,
            false => is_digit(c).match({
                true  => Start.Digit,
                false => c.match({ '"' => Start.Quote, '\'' => Start.Apostrophe, '@' => Start.At, _ => Start.Other }),
            }),
        }),
    })
}

// The token that starts at `at`.
token = (s: Source, at: usize) Token {
    start(s, at).match({
        End        => span(Kind.End, at, at),
        Name       => span(Kind.Name, at, s.scan(at, (c) { is_ident_cont(c) })),
        Digit      => number(s, at),
        Quote      => quoted(s, at, '"', Kind.Str),
        Apostrophe => quoted(s, at, '\'', Kind.Char),
        At         => span(Kind.At, at, s.scan(at + 1, (c) { is_ident_cont(c) })),
        Other      => symbol(s, at),
    })
}

// Decimal only. A leading zero is refused (`010`), and the value must fit u64.
number = (s: Source, at: usize) Token {
    end = s.scan(at, (c) { is_digit(c) });
    fraction = s.byte(end) == '.' && is_digit(s.byte(end + 1));
    fraction.match({
        true  => span(Kind.Float, at, s.scan(end + 1, (c) { is_digit(c) })),
        false => (s.byte(at) == '0' && end - at > 1).match({
            true  => span(Kind.Fault(Fault.LeadingZero), at, end),
            false => s.text.slice(at, end).parse_usize().match({
                Ok(_) => span(Kind.Int, at, end),
                None  => span(Kind.Fault(Fault.IntegerTooLarge), at, end),
            }),
        }),
    })
}

// A string or char literal on one line. Escapes: \n \t \r \0 \\ \" \'.
// An unknown escape faults at the escape but ends with the literal, so lexing
// resumes after it instead of opening a new string at the closing quote.
quoted = (s: Source, at: usize, close: u8, kind: Kind) Token {
    i ::= at + 1;
    bad :: Res<usize> = None;
    closed ::= false;
    Range(at + 1, s.text.len + 1).loop((h, _) {
        c = s.byte(i);
        (c == close || c == '\n' || i >= s.text.len).match({
            true  => { closed = c == close; h.break(); },
            false => (),
        });
        (c == '\\').match({
            true  => {
                known = is_escape(s.byte(i + 1));
                (known || bad.match({ Ok(_) => true, None => false })).match({ true => (), false => { bad = Ok(i); } });
                i = i + 2;
            },
            false => { i = i + 1; },
        });
    });
    closed.match({
        false => span(Kind.Fault(Fault.Unterminated), at, i),
        true  => bad.match({
            Ok(b) => span(Kind.Fault(Fault.UnknownEscape), b, i + 1),
            None  => span(kind, at, i + 1),
        }),
    })
}

is_escape = (c: u8) bool {
    c.match({ 'n' => true, 't' => true, 'r' => true, '0' => true, '\\' => true, '"' => true, '\'' => true, _ => false })
}

// Operators and punctuation, longest match first.
symbol = (s: Source, at: usize) Token {
    c   = s.byte(at);
    n   = s.byte(at + 1);
    one = (k: Kind) Token { span(k, at, at + 1) }
    two = (k: Kind) Token { span(k, at, at + 2) }
    c.match({
        '(' => one(Kind.LParen),
        ')' => one(Kind.RParen),
        '{' => one(Kind.LBrace),
        '}' => one(Kind.RBrace),
        '[' => one(Kind.LBracket),
        ']' => one(Kind.RBracket),
        ',' => one(Kind.Comma),
        ';' => one(Kind.Semi),
        '.' => one(Kind.Dot),
        '~' => one(Kind.Tilde),
        '^' => one(Kind.Caret),
        '/' => one(Kind.Slash),
        '%' => one(Kind.Percent),
        ':' => (n == ':').match({
            true  => (s.byte(at + 2) == '=').match({ true => span(Kind.Define, at, at + 3), false => two(Kind.ColonColon) }),
            false => one(Kind.Colon),
        }),
        '=' => n.match({ '=' => two(Kind.Equal), '>' => two(Kind.Arrow), _ => one(Kind.Assign) }),
        '!' => n.match({ '=' => two(Kind.NotEqual), _ => one(Kind.Not) }),
        '<' => n.match({ '=' => two(Kind.Le), '<' => two(Kind.Shl), _ => one(Kind.Lt) }),
        '>' => n.match({ '=' => two(Kind.Ge), '>' => two(Kind.Shr), _ => one(Kind.Gt) }),
        '+' => n.match({ '%' => two(Kind.PlusWrap), _ => one(Kind.Plus) }),
        '-' => n.match({ '%' => two(Kind.MinusWrap), _ => one(Kind.Minus) }),
        '*' => n.match({ '%' => two(Kind.StarWrap), _ => one(Kind.Star) }),
        '&' => n.match({ '&' => two(Kind.And), _ => one(Kind.Amp) }),
        '|' => n.match({ '|' => two(Kind.Or), _ => one(Kind.Pipe) }),
        _   => one(Kind.Fault(Fault.UnexpectedByte)),
    })
}
