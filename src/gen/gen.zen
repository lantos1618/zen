// Code generation owns backend selection and artifact rendering. Drivers
// publish each borrowed artifact synchronously; no filesystem policy lives here.

{ Emit*, order* } = gen.gen_emit

{ Alloc, AllocError, Mem } = std.mem
{ Ast } = std.ast
{ Checker } = sema.sema
{ Codegen, Target } = std.build
{ String, str } = std.text
{ lower, lower_hosted, LowerError } = gen.gen_lower
{ needs_probe, probe_source, resolve } = gen.gen_probe
{ link, Linking } = gen.gen_jit_extern
{ Program, Scalar, float, same } = gen.gen_ir
{ emit_js, emit_app, emit_runtime, PAGE, supports } = gen.gen_js
{ emit_c, emit_c_units, symbol_map, c_supports } = gen.gen_c_ir
{ refused, describe } = gen.gen_ir_feature
{ X86_64Linux } = gen.gen_asm_x86
{ Arm64, Arm64Os } = gen.gen_asm_arm64
{ verify, message } = gen.gen_verify
{ Res, Ok, Err, None } = std.core
{ Vec } = std.collections
{ execute, refused_by_jit } = gen.gen_jit_interp
{ prepare, Arenas } = gen.gen_asm_prepare
{ Platform } = gen.gen_sys

Layout* = { Single | Modules }
ArtifactKind* = { Source | Symbols }

ScalarBackend = { Js | Asm | C }

// Names and bytes borrow the renderer's current buffer. Consumers must write
// or copy them during the callback; retaining this record extends no lifetime.
Artifact* = {
    kind*: ArtifactKind,
    name*: str,
    text*: str,
}

Generation* = {
    alloc*: Alloc,
    mem*: Mem,
    tree*: Ast,
    check*: Checker,
    backend*: Codegen,
    entry*: usize,
    layout*: Layout,
    ffi*: bool,
    symbols*: bool,
    // The native machine for assembly; None when no target was resolved.
    target*: Res<Target>,
    // JavaScript for a page (`--target js-browser`): publish index.html,
    // runtime.js and app.js instead of one script.
    browser* :: bool = false,

    // Lowering diagnostics precede publication. The returned count includes
    // backend faults and publication failures; allocation errors stay typed.
    emit* = (self: @Self, report :: String,
             publish: (artifact: Artifact) Res<usize, AllocError>)
            Res<usize, AllocError> {
        self.backend.match({
            Js  => self.scalar(
                ScalarBackend.Js,
                report,
                (artifact) { publish(artifact) }
            ),
            Asm => self.scalar(
                ScalarBackend.Asm,
                report,
                (artifact) { publish(artifact) }
            ),
            Jit => {
                report.add(
                    "error: the jit backend runs a program and emits no source; give no output file\n"
                ).try();
                Ok(1)
            },
            C   => self.c_ir(report, (artifact) { publish(artifact) }),
        })
    }

    // C renders the one lowering too; a program it refuses is reported by
    // the construct it cannot lower.
    c_ir = (self: @Self, report :: String,
            publish: (artifact: Artifact) Res<usize, AllocError>)
           Res<usize, AllocError> {
        self.lowered(ScalarBackend.C).match({
            Err(error)  => error.match({
                OutOfMemory        => Err(AllocError.OutOfMemory),
                Unsupported(fault) => {
                    report.fmt(
                        "{}:{}:{}: error: unsupported by this backend: {}\n",
                        fault.span.file,
                        fault.span.start.line,
                        fault.span.start.col,
                        fault.what
                    ).try();
                    Ok(1)
                },
            }),
            Ok(program) => self.render_scalar(
                ScalarBackend.C,
                program,
                report,
                (artifact) { publish(artifact) }
            ),
        })
    }

    // One `zen.c`, or `zen.h` plus a file per module, then the symbol map
    // when one was asked for.
    c_artifacts = (self: @Self, program: Program,
                   publish: (artifact: Artifact) Res<usize, AllocError>)
                  Res<usize, AllocError> {
        failed = self.layout.match({
            Single  => publish(Artifact(
                kind: ArtifactKind.Source,
                name: "zen.c",
                text: emit_c(self.alloc, program).try().view()
            )).try(),
            Modules => {
                split = emit_c_units(self.alloc, program).try();
                count ::= publish(Artifact(
                    kind: ArtifactKind.Source,
                    name: "zen.h",
                    text: split.header.view()
                )).try();
                split.units.loop((u) {
                    module_name = self.tree.module_at(u.unit).match({
                        None    => "zg_unit",
                        Ok(mod) => mod.name,
                    });
                    file        = self.alloc.String("{}.c", module_name).try();
                    count       = count + publish(Artifact(
                        kind: ArtifactKind.Source,
                        name: file.view(),
                        text: u.text.view()
                    )).try();
                });
                count
            },
        });
        (failed == 0 && self.symbols).match({
            true  => publish(Artifact(
                kind: ArtifactKind.Symbols,
                name: "symbols",
                text: symbol_map(self.alloc, program).try().view()
            )),
            false => Ok(failed),
        })
    }


    scalar = (self: @Self, backend: ScalarBackend, report :: String,
              publish: (artifact: Artifact) Res<usize, AllocError>)
             Res<usize, AllocError> {
        single = self.layout.match({ Single => true, Modules => false });
        (single && self.symbols == false).match({
            false => {
                report.add(
                    "error: JS and assembly backends require single-file output without a symbol map\n"
                ).try();
                Ok(1)
            },
            true  => self.lowered(backend).match({
                Err(error)  => error.match({
                    OutOfMemory        => Err(AllocError.OutOfMemory),
                    Unsupported(fault) => {
                        report.fmt(
                            "{}:{}:{}: error: unsupported by this backend: {}\n",
                            fault.span.file,
                            fault.span.start.line,
                            fault.span.start.col,
                            fault.what
                        ).try();
                        Ok(1)
                    },
                }),
                Ok(program) => self.render_scalar(
                    backend,
                    program,
                    report,
                    (artifact) { publish(artifact) }
                ),
            }),
        })
    }

    // Every backend renders the one lowering.
    lowered = (self: @Self, backend: ScalarBackend) Res<Program, LowerError> {
        lower(
            self.alloc,
            self.tree,
            self.check,
            self.entry,
            backend.match({ C => true, _ => false }),
            backend.match({ C => true, _ => false })
        )
    }

    render_scalar = (self: @Self, backend: ScalarBackend, program: Program,
                     report :: String,
                     publish: (artifact: Artifact) Res<usize, AllocError>)
                    Res<usize, AllocError> {
        self.valid(program, report).try().match({
            false => Ok(1),
            true  => backend.match({
                Js  => program.refused((feature) { supports(feature) }).match({
                    Ok(refusal) => {
                        report.fmt(
                            "error: unsupported by this backend: {} (first in `{}`)\n",
                            refusal.feature.describe(),
                            refusal.function
                        ).try();
                        Ok(1)
                    },
                    None        => self.browser.match({
                        false => publish(Artifact(
                            kind: ArtifactKind.Source,
                            name: "zen.js",
                            text: emit_js(self.alloc, program).try().view()
                        )),
                        true  => {
                            page    = publish(Artifact(
                                kind: ArtifactKind.Source,
                                name: "index.html",
                                text: PAGE
                            )).try();
                            runtime = publish(Artifact(
                                kind: ArtifactKind.Source,
                                name: "runtime.js",
                                text: emit_runtime(self.alloc).try().view()
                            )).try();
                            app     = publish(Artifact(
                                kind: ArtifactKind.Source,
                                name: "app.js",
                                text: emit_app(self.alloc, program).try().view()
                            )).try();
                            Ok(page + runtime + app)
                        },
                    }),
                }),
                C   => program.refused(
                    (feature) { c_supports(feature) }
                ).match({
                    Ok(refusal) => {
                        report.fmt(
                            "error: unsupported by the C backend: {} (first in `{}`)\n",
                            refusal.feature.describe(),
                            refusal.function
                        ).try();
                        Ok(1)
                    },
                    None        => self.c_artifacts(
                        program,
                        (artifact) { publish(artifact) }
                    ),
                }),
                Asm => refused_by_asm(program).match({
                    Ok(refusal) => {
                        report.fmt(
                            "error: unsupported by the asm backend: {} (in `{}`)\n",
                            refusal.what,
                            refusal.function
                        ).try();
                        Ok(1)
                    },
                    None        => self.publish_assembly(
                        program,
                        report,
                        (artifact) { publish(artifact) }
                    ),
                }),
            }),
        })
    }

    // False after reporting why `program` is not valid IR.
    valid = (self: @Self, program: Program, report :: String)
            Res<bool, AllocError> {
        program.verify(self.alloc).match({
            Err(error) => error.match({
                OutOfMemory    => Err(AllocError.OutOfMemory),
                Invalid(fault) => {
                    name = program.functions.get(
                        fault.function
                    ).match({ Ok(f) => f.name, None => "?" });
                    report.fmt(
                        "compiler error: invalid IR at function {} ({}), block {}: {}\n",
                        fault.function,
                        name,
                        fault.block,
                        fault.reason.message()
                    ).try();
                    Ok(false)
                },
            }),
            Ok(_)      => Ok(true),
        })
    }

    // The jit backend runs the one lowering in this process with `argv` as
    // its command line instead of publishing it. The result is the
    // program's exit status; None when it was refused or cannot run on
    // this host, after the report says why.
    // `host` compiles and runs a C program with the host C compiler and
    // answers its standard output; None when it could not.
    run* = (self: @Self, report :: String, argv: Vec<str>,
            host: (source: str) Res<String>)
           Res<Res<i32>, AllocError> {
        lower_hosted(self.alloc, self.tree, self.check, self.entry).match({
            Err(error)  => error.match({
                OutOfMemory        => Err(AllocError.OutOfMemory),
                Unsupported(fault) => {
                    report.fmt(
                        "{}:{}:{}: error: unsupported by this backend: {}\n",
                        fault.span.file,
                        fault.span.start.line,
                        fault.span.start.col,
                        fault.what
                    ).try();
                    Ok(None)
                },
            }),
            Ok(lowered) => self.probed(
                lowered,
                report,
                (source) { host(source) }
            ).try().match({
                None        => Ok(None),
                Ok(program) => self.checked(program, report, argv),
            }),
        })
    }

    // The jit's run of a lowered program, once it verifies and nothing in
    // it is refused.
    checked = (self: @Self, program: Program, report :: String,
               argv: Vec<str>)
              Res<Res<i32>, AllocError> {
        self.valid(program, report).try().match({
            false => Ok(None),
            true  => refused_by_jit(program).match({
                Ok(refusal) => {
                    report.fmt(
                        "error: unsupported by the jit backend: {} (in `{}`)\n",
                        refusal.what,
                        refusal.function
                    ).try();
                    Ok(None)
                },
                None        => self.platform().match({
                    None         => {
                        report.add(
                            "error: the jit backend runs on x86_64-linux, aarch64-linux and arm64-darwin hosts\n"
                        ).try();
                        Ok(None)
                    },
                    Ok(platform) => self.linked(
                        program,
                        platform,
                        report,
                        argv
                    ),
                }),
            }),
        })
    }

    // The run once every C function the program calls is resolved
    // (gen_jit_extern).
    linked = (self: @Self, program: Program, platform: Platform,
              report :: String, argv: Vec<str>)
             Res<Res<i32>, AllocError> {
        link(self.alloc, program, platform).try().match({
            Refused(name) => {
                report.fmt(
                    "error: unsupported by the jit backend: calls of C functions (in `{}`)\n",
                    name
                ).try();
                Ok(None)
            },
            Missing(name) => {
                report.fmt(
                    "error: the jit backend found no library defining the C function `{}`\n",
                    name
                ).try();
                Ok(None)
            },
            Ready(found)  => execute(
                self.alloc,
                prepare(
                    Arenas(alloc: self.alloc, mem: self.mem),
                    program
                ).try(),
                platform,
                argv,
                found
            ).try().match({
                None       => {
                    report.add(
                        "error: the jit backend could not map its memory\n"
                    ).try();
                    Ok(None)
                },
                Ok(status) => Ok(Ok(status)),
            }),
        })
    }

    // The program with its header constants and native record layouts
    // answered by the host C compiler (gen_probe); None after the report
    // says why it could not be.
    probed = (self: @Self, program: Program, report :: String,
              host: (source: str) Res<String>)
             Res<Res<Program>, AllocError> {
        needs_probe(program).match({
            false => Ok(Ok(program)),
            true  => probe_source(
                self.alloc,
                program,
                self.host_name()
            ).try().match({
                None       => {
                    report.add(
                        "error: unsupported by the jit backend: a C header constant whose class is not an integer\n"
                    ).try();
                    Ok(None)
                },
                Ok(source) => host(source.view()).match({
                    None        => {
                        report.add(
                            "error: the host C compiler could not answer this program's C header constants and native C records\n"
                        ).try();
                        Ok(None)
                    },
                    Ok(answers) => resolve(
                        self.alloc,
                        program,
                        answers.view()
                    ).try().match({
                        true  => Ok(Ok(program)),
                        false => {
                            report.add(
                                "error: the host C compiler's answers do not match this program's C header constants and native C records\n"
                            ).try();
                            Ok(None)
                        },
                    }),
                }),
            }),
        })
    }

    host_name = (self: @Self) str {
        self.platform().match({
            Ok(p) => p.match({
                LinuxX86_64 => "x86_64-linux",
                LinuxArm64  => "aarch64-linux",
                Darwin      => "arm64-darwin",
            }),
            None  => "unknown",
        })
    }

    // The host's system interface, from the resolved target.
    platform = (self: @Self) Res<Platform> {
        self.target.match({
            None        => None,
            Ok(machine) => machine.os.match({
                Macos => Ok(Platform.Darwin),
                Linux => machine.arch.match({
                    X86_64 => Ok(Platform.LinuxX86_64),
                    Arm64  => Ok(Platform.LinuxArm64),
                }),
                _     => None,
            }),
        })
    }

    publish_assembly = (self: @Self, program: Program, report :: String,
                        publish: (artifact: Artifact) Res<usize, AllocError>)
                       Res<usize, AllocError> {
        self.assembly(program).try().match({
            None     => {
                report.add(
                    "error: the asm backend supports x86_64-linux, aarch64-linux and arm64-darwin targets\n"
                ).try();
                Ok(1)
            },
            Ok(text) => publish(Artifact(
                kind: ArtifactKind.Source,
                name: "zen.s",
                text: text.view()
            )),
        })
    }

    assembly = (self: @Self, program: Program)
               Res<Res<String>, AllocError> {
        self.target.match({
            None        => Ok(None),
            Ok(machine) => emit_assembly(
                self.alloc,
                self.mem,
                machine,
                program
            ),
        })
    }
}

// The IR features the assembly renderers do not implement yet, checked
// before rendering so the program is refused with a reason (IR_ARCHITECTURE
// §2.3: support boundaries are declared, not discovered).
AsmRefusal = { what: str, function: str }

refused_by_asm = (program: Program) Res<AsmRefusal> {
    found :: Res<AsmRefusal> = None;
    program.functions.loop((function) {
        function.slots.loop((ty) {
            float(ty).then(() { found = Ok(AsmRefusal(what: "floating-point values", function: function.name)); });
            same(ty, Scalar.U128).then(() { found = Ok(AsmRefusal(what: "128-bit integers", function: function.name)); });
        });
        function.secrets.when_ok(
            (_) { found = Ok(AsmRefusal(
                what: "Secret parameters",
                function: function.name
            )); }
        );
        function.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    Foreign(_)      => { found = Ok(AsmRefusal(
                        what: "calls of C functions",
                        function: function.name
                    )); },
                    NativeConst(_)  => { found = Ok(AsmRefusal(
                        what: "constants from C headers",
                        function: function.name
                    )); },
                    Machine(_)      => { found = Ok(AsmRefusal(
                        what: "SIMD vectors and machine instructions",
                        function: function.name
                    )); },
                    NativeLayout(_) => { found = Ok(AsmRefusal(
                        what: "native C record layouts",
                        function: function.name
                    )); },
                    NativeClear(_)  => { found = Ok(AsmRefusal(
                        what: "native C record layouts",
                        function: function.name
                    )); },
                    Opaque(_)       => { found = Ok(AsmRefusal(
                        what: "constant-time value barriers (std.ct)",
                        function: function.name
                    )); },
                    Host(_)         => { found = Ok(AsmRefusal(
                        what: "JavaScript host calls (js.bind)",
                        function: function.name
                    )); },
                    Wait(_)         => { found = Ok(AsmRefusal(
                        what: "JavaScript event waits (std.js.wait)",
                        function: function.name
                    )); },
                    _               => (),
                });
            });
        });
    });
    found
}

// Target selection happens here, at the generation boundary; the renderer
// contract does not import its implementations. None: no renderer exists
// for this machine. The caller verifies the program first.
emit_assembly* = (alloc: Alloc, mem: Mem, machine: Target, program: Program)
                 Res<Res<String>, AllocError> {
    machine.os.match({
        Linux   => machine.arch.match({
            X86_64 => Ok(Ok(
                X86_64Linux(alloc: alloc, mem: mem).emit(program).try()
            )),
            Arm64  => Ok(Ok(
                Arm64(alloc: alloc, mem: mem, os: Arm64Os.Linux).emit(program).try()
            )),
        }),
        Macos   => machine.arch.match({
            Arm64  => Ok(Ok(
                Arm64(alloc: alloc, mem: mem, os: Arm64Os.Darwin).emit(program).try()
            )),
            X86_64 => Ok(None),
        }),
        Windows => Ok(None),
    })
}
