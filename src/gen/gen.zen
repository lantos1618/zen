// Code generation owns backend selection and artifact rendering. Drivers
// publish each borrowed artifact synchronously; no filesystem policy lives here.
// Direct C entry points remain available to compiler tools and backend tests.

Emit*, order* = gen.gen_emit
CBackend*, emit_program*, render_symbol_map* = gen.gen_c
lower_program*, emit_header*, emit_unit*, group_bodies*, ModuleBodies* = gen.gen_c

Alloc, AllocError, Mem = std.mem
Ast = std.ast
Checker = sema.sema
Codegen, Target = std.build
String, str = std.text
lower, LowerError = gen.gen_lower
lower_native = gen.gen_lower_core
Program = gen.gen_ir
emit_js = gen.gen_js
X86_64Linux = gen.gen_asm_x86
Arm64, Arm64Os = gen.gen_asm_arm64
verify, verify_native, message = gen.gen_verify

Layout* = Single | Modules
ArtifactKind* = Source | Symbols

ScalarBackend = Js | Asm

// Names and bytes borrow the renderer's current buffer. Consumers must write
// or copy them during the callback; retaining this record extends no lifetime.
Artifact* = {
    kind*: ArtifactKind,
    name*: str,
    text*: str,
}

Generation* = {
    alloc*: Alloc,
    mem*: Mem,
    tree*: Ast,
    check*: Checker,
    backend*: Codegen,
    entry*: usize,
    layout*: Layout,
    ffi*: bool,
    symbols*: bool,
    // The native machine for assembly; None when no target was resolved.
    target*: Res<Target>,

    // Lowering diagnostics precede publication. The returned count includes
    // backend faults and publication failures; allocation errors stay typed.
    emit* = (self: @Self, report :: String,
             publish: (artifact: Artifact) Res<usize, AllocError>)
            Res<usize, AllocError> {
        self.backend.match({
            Js  => self.scalar(
                ScalarBackend.Js,
                report,
                (artifact) { publish(artifact) }
            ),
            Asm => self.scalar(
                ScalarBackend.Asm,
                report,
                (artifact) { publish(artifact) }
            ),
            C   => {
                be ::= self.alloc.CBackend(self.tree, self.check).try();
                self.ffi.then(() { be.enable_ffi(); });
                output ::= COutput(generation: self, be: be);
                faults = self.layout.match({
                    Single  => output.single(
                        report,
                        (artifact) { publish(artifact) }
                    ),
                    Modules => output.modules(
                        report,
                        (artifact) { publish(artifact) }
                    ),
                }).try();
                (faults == 0 && self.symbols).match({
                    true  => output.symbols((artifact) { publish(artifact) }),
                    false => Ok(faults),
                })
            },
        })
    }

    scalar = (self: @Self, backend: ScalarBackend, report :: String,
              publish: (artifact: Artifact) Res<usize, AllocError>)
             Res<usize, AllocError> {
        single = self.layout.match({ Single => true, Modules => false });
        (single && self.symbols == false).match({
            false => {
                report.add(
                    "error: JS and assembly backends require single-file output without a symbol map\n"
                ).try();
                Ok(1)
            },
            true  => self.lowered(backend).match({
                Err(error)  => error.match({
                    OutOfMemory        => Err(AllocError.OutOfMemory),
                    Unsupported(fault) => {
                        report.fmt(
                            "{}:{}:{}: error: unsupported by this backend: {}\n",
                            fault.span.file,
                            fault.span.start.line,
                            fault.span.start.col,
                            fault.what
                        ).try();
                        Ok(1)
                    },
                }),
                Ok(program) => self.render_scalar(
                    backend,
                    program,
                    report,
                    (artifact) { publish(artifact) }
                ),
            }),
        })
    }

    // JavaScript consumes the scalar surface; assembly the native surface.
    lowered = (self: @Self, backend: ScalarBackend) Res<Program, LowerError> {
        backend.match({
            Js  => lower(self.alloc, self.tree, self.check, self.entry),
            Asm => lower_native(self.alloc, self.tree, self.check, self.entry),
        })
    }

    render_scalar = (self: @Self, backend: ScalarBackend, program: Program,
                     report :: String,
                     publish: (artifact: Artifact) Res<usize, AllocError>)
                    Res<usize, AllocError> {
        backend.match({
            Js  => program.verify(self.alloc),
            Asm => program.verify_native(self.alloc),
        }).match({
            Err(error) => error.match({
                OutOfMemory    => Err(AllocError.OutOfMemory),
                Invalid(fault) => {
                    name = program.functions.get(fault.function).match({ Ok(f) => f.name, None => "?" });
                    report.fmt(
                        "compiler error: invalid IR at function {} ({}), block {}: {}\n",
                        fault.function,
                        name,
                        fault.block,
                        fault.reason.message()
                    ).try();
                    Ok(1)
                },
            }),
            Ok(_)      => backend.match({
                Js  => publish(Artifact(
                    kind: ArtifactKind.Source,
                    name: "zen.js",
                    text: emit_js(self.alloc, program).try().view()
                )),
                Asm => self.assembly(program).try().match({
                    None      => {
                        report.add(
                            "error: the asm backend supports x86_64-linux, aarch64-linux and arm64-darwin targets\n"
                        ).try();
                        Ok(1)
                    },
                    Ok(text)  => publish(Artifact(
                        kind: ArtifactKind.Source,
                        name: "zen.s",
                        text: text.view()
                    )),
                }),
            }),
        })
    }


    assembly = (self: @Self, program: Program)
               Res<Res<String>, AllocError> {
        self.target.match({
            None         => Ok(None),
            Ok(machine)  => emit_assembly(self.alloc, machine, program),
        })
    }
}

// One backend owns lowering state throughout rendering. Split C lowers once,
// retains its stable order, and releases each scratch buffer after publication.
COutput = {
    generation: Generation,
    be :: CBackend,

    single = (self :: @Self, report :: String,
              publish: (artifact: Artifact) Res<usize, AllocError>)
             Res<usize, AllocError> {
        out ::= self.generation.alloc.Emit().try();
        self.be.emit_program(self.generation.entry, out).try();
        self.be.render_diags(report).try();
        faults = self.be.diag_count();
        (faults == 0).match({
            false => Ok(faults),
            true  => publish(Artifact(
                kind: ArtifactKind.Source,
                name: "zen.c",
                text: out.view()
            )),
        })
    }

    modules = (self :: @Self, report :: String,
               publish: (artifact: Artifact) Res<usize, AllocError>)
              Res<usize, AllocError> {
        self.be.use_externs();
        self.be.lower_program(self.generation.entry).try();
        header ::= self.generation.alloc.Emit().try();
        self.be.emit_header(header).try();
        self.be.render_diags(report).try();
        faults = self.be.diag_count();
        (faults == 0).match({
            false => Ok(faults),
            true  => {
                groups = self.be.group_bodies().try();
                failed ::= publish(Artifact(
                    kind: ArtifactKind.Source,
                    name: "zen.h",
                    text: header.view()
                )).try();
                groups.loop((h, group) {
                    unit = group.unit;
                    ((unit == self.generation.entry) || (group.functions.len > 0)).then(() {
                        scratch ::= self.generation.mem.alloc();
                        out     ::= scratch.Emit().try();
                        self.be.emit_unit(
                            self.generation.entry,
                            group,
                            out
                        ).try();
                        module_name = self.generation.tree.module_at(
                            unit
                        ).match({
                            None    => "zg_unit",
                            Ok(mod) => mod.name,
                        });
                        name        = scratch.String("{}.c", module_name).try();
                        failed      = failed + publish(Artifact(
                            kind: ArtifactKind.Source,
                            name: name.view(),
                            text: out.view()
                        )).try();
                    });
                });
                Ok(failed)
            },
        })
    }

    symbols = (self :: @Self,
               publish: (artifact: Artifact) Res<usize, AllocError>)
              Res<usize, AllocError> {
        out ::= self.generation.alloc.String().try();
        self.be.render_symbol_map(out).try();
        publish(Artifact(
            kind: ArtifactKind.Symbols,
            name: "symbols",
            text: out.view()
        ))
    }
}

// Target selection happens here, at the generation boundary; the renderer
// contract does not import its implementations. None: no renderer exists
// for this machine. The caller verifies the program first.
emit_assembly* = (alloc: Alloc, machine: Target, program: Program)
                 Res<Res<String>, AllocError> {
    machine.os.match({
        Linux   => machine.arch.match({
            X86_64 => Ok(Ok(X86_64Linux(alloc: alloc).emit(program).try())),
            Arm64  => Ok(Ok(Arm64(alloc: alloc, os: Arm64Os.Linux).emit(program).try())),
        }),
        Macos   => machine.arch.match({
            Arm64  => Ok(Ok(Arm64(alloc: alloc, os: Arm64Os.Darwin).emit(program).try())),
            X86_64 => Ok(None),
        }),
        Windows => Ok(None),
    })
}
