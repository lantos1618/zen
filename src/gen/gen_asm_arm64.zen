// AArch64 assembly for the native IR under AAPCS64. Two operating systems
// share the instruction selection and differ only in object dialect and in
// how the runtime reaches the kernel:
//
// - Linux: ELF, its own `_start`, raw `svc #0` system calls, no libc.
// - Darwin: Mach-O, `_main` entered from dyld, and libSystem calls, because
//   Darwin's system-call numbers are not a stable ABI. No C is compiled.
//
// Homes: `gen_asm_regalloc` places each word slot in a register, as a
// constant, or in the frame. Frame slots are addressed from `sp` above a
// preallocated outgoing argument area, so `sp` never moves in a body. Words
// hold their value extended to 64 bits wherever they live. x0-x3, x8, x9
// and x16 are this renderer's scratch registers and are never allocated.
// An aggregate argument is passed
// as a pointer to the caller's copy; an aggregate result is written through
// the indirect-result register x8, as AAPCS64 does for large composites.

Alloc, AllocError = std.mem
str, String = std.text
Res, Ok, None, loop, Range = std.core
Vec = std.collections
Program, Func, BasicBlock, Instruction, Terminator, Unary, Binary, Invocation, Print = gen.gen_ir
Scalar, Layout, Op, TrapKind, Fault = gen.gen_ir
Convert, Load, Store, SysCall, Start, Stream = gen.gen_ir
width, signed, word, trap_message = gen.gen_ir
Span = std.source
Target = gen.gen_asm
Sys, linux_arm64, darwin_symbol, constant_value, Platform = gen.gen_sys
darwin_result, LINUX_ARM64_EXIT = gen.gen_sys
Update, Compare, IndirectCall = gen.gen_ir
Plan, Home, Pool, Address, Modes, plan = gen.gen_asm_regalloc
NONE, bits, log2, low_mask, modulo, bit_width, scale_of = gen.gen_asm_flow
prepare = gen.gen_asm_prepare
peephole, Dialect = gen.gen_asm_peephole

Arm64Os* = Linux | Darwin

Arm64* = { alloc*: Alloc, os*: Arm64Os }

Arm64.impl(Target, {
    emit = (self: @Self, original: Program) Res<String, AllocError> {
        program = prepare(self.alloc, original).try();
        writer ::= Assembly(
            alloc: self.alloc,
            os: self.os,
            program: program,
            out: self.alloc.String().try(),
            data: self.alloc.String().try(),
            scratch: self.alloc.String().try(),
            traps: self.alloc.Vec<TrapSite>(),
            offsets: self.alloc.Vec<usize>(),
            next_label: 0,
            plan: Plan(
                function: Func(
                    name: "",
                    parameters: 0,
                    slots: self.alloc.Vec<Scalar>(),
                    blocks: self.alloc.Vec<BasicBlock>(),
                    result: Scalar.Unit
                ),
                homes: self.alloc.Vec<Home>(),
                saved: self.alloc.Vec<usize>(),
                uses: self.alloc.Vec<usize>(),
                local: self.alloc.Vec<bool>()
            ),
            save_offsets: self.alloc.Vec<usize>(),
            addresses: self.alloc.Vec<Address>(),
            absorbed: self.alloc.Vec<bool>()
        );
        writer.render().try();
        peephole(self.alloc, writer.out.view(), Dialect.Arm)
    }
})

TrapSite = { label: usize, location: usize, length: usize }

Assembly = {
    alloc: Alloc,
    os: Arm64Os,
    program: Program,
    out :: String,
    data :: String,
    // Formats a trap report once so its byte length is known exactly.
    scratch :: String,
    traps :: Vec<TrapSite>,
    // Per function: each slot's distance above `sp`.
    offsets :: Vec<usize>,
    next_label :: usize,
    function_id :: usize = 0,
    frame :: usize = 0,
    // Where the hidden aggregate-result pointer (x8) is saved.
    result_offset :: usize = 0,
    // The current function's allocation and where its callee-saved
    // registers are kept, above `sp`.
    plan :: Plan,
    save_offsets :: Vec<usize>,
    // The block being rendered, for falling through to the next one.
    block_id :: usize = 0,
    // Per instruction of that block: the address a memory access reads or
    // writes, and whether the instruction's work was absorbed into one.
    addresses :: Vec<Address>,
    absorbed :: Vec<bool>,
    at :: usize = 0,

    darwin = (self: @Self) bool {
        self.os.match({ Darwin => true, Linux => false })
    }

    // Assembler-local label prefix for this object format.
    local = (self: @Self) str {
        self.darwin().match({ true => "L", false => ".L" })
    }

    render = (self :: @Self) Res<(), AllocError> {
        self.darwin().match({
            true  => self.out.add(".build_version macos, 11, 0\n.text\n"),
            false => self.out.add(".text\n"),
        }).try();
        self.program.functions.loop((h, i, function) {
            self.function(i, function).try();
        });
        self.entry().try();
        self.runtime().try();
        self.darwin().match({
            true  => {
                self.out.add(".section __TEXT,__const\n").try();
                self.out.add(self.data.view()).try();
                self.out.add(
                    ".zerofill __DATA,__bss,za_out_buf,65536,4\n.zerofill __DATA,__bss,za_out_len,8,3\n.zerofill __DATA,__bss,za_argc,8,3\n.zerofill __DATA,__bss,za_argv,8,3\n.zerofill __DATA,__bss,za_envp,8,3\n.zerofill __DATA,__bss,za_out_lock,8,3\n.zerofill __DATA,__bss,za_globals,256,4\n"
                )
            },
            false => {
                self.out.add(".section .rodata\n").try();
                self.out.add(self.data.view()).try();
                self.out.add(
                    ".bss\n.p2align 4\nza_out_buf:\n    .zero 65536\nza_out_len:\n    .zero 8\nza_argc:\n    .zero 8\nza_argv:\n    .zero 8\nza_envp:\n    .zero 8\nza_out_lock:\n    .zero 8\n.p2align 4\nza_globals:\n    .zero 256\nza_main_tcb:\n    .zero 64\n.section .note.GNU-stack,\"\",@progbits\n"
                )
            },
        })
    }

    entry = (self :: @Self) Res<(), AllocError> {
        self.darwin().match({
            // dyld calls main(argc, argv, envp) with an aligned stack; the
            // program never returns through it.
            true  => {
                self.out.add(
                    ".globl _main\n.p2align 2\n_main:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n"
                ).try();
                self.address("x9", "za_argc").try();
                self.out.add("    str x0, [x9]\n").try();
                self.address("x9", "za_argv").try();
                self.out.add("    str x1, [x9]\n").try();
                self.address("x9", "za_envp").try();
                self.out.add("    str x2, [x9]\n").try();
            },
            // The kernel enters with sp 16-byte aligned at argc, followed
            // by argv and envp.
            false => {
                self.out.add(
                    ".globl _start\n.type _start, %function\n.p2align 2\n_start:\n    mov x29, #0\n    mov x30, #0\n    ldr x0, [sp]\n    add x1, sp, #8\n    add x2, x1, x0, lsl #3\n    add x2, x2, #8\n"
                ).try();
                self.address("x9", "za_argc").try();
                self.out.add("    str x0, [x9]\n").try();
                self.address("x9", "za_argv").try();
                self.out.add("    str x1, [x9]\n").try();
                self.address("x9", "za_envp").try();
                self.out.add("    str x2, [x9]\n").try();
                // The main thread's control block; its first word is its
                // own address, as for every thread std.sys starts.
                self.address("x9", "za_main_tcb").try();
                self.out.add("    str x9, [x9]\n    msr tpidr_el0, x9\n").try();
            },
        });
        self.out.fmt("    bl za_fn_{}\n    b za_exit\n", self.program.entry)
    }

    slot_type = (self: @Self, slot: usize) Scalar {
        self.plan.function.slots.get(slot).value_or(Scalar.Unit)
    }

    offset = (self: @Self, slot: usize) usize {
        self.offsets.get(slot).value_or(0)
    }

    layout_frame = (self :: @Self, function: Func) {
        outgoing :: usize = 0;
        function.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    Invoke(call) => {
                        (call.args.len > REGISTER_ARGUMENTS).then(() {
                            need = (call.args.len - REGISTER_ARGUMENTS) * 8;
                            (need > outgoing).then(() { outgoing = need; });
                        });
                    },
                    _            => (),
                });
            });
        });
        cursor ::= round_up(outgoing, 16);
        self.result_offset = cursor;
        cursor             = cursor + 8;
        self.save_offsets.clear();
        self.plan.saved.loop((_) {
            self.save_offsets.add(cursor).ignore();
            cursor = cursor + 8;
        });
        self.offsets.clear();
        // Slots with a register or constant home take no frame space.
        function.slots.loop((h, i, ty) {
            framed = self.plan.home(i).match({ Frame => true, _ => false });
            framed.match({
                true  => {
                    align  = ty.match({ Block(l) => (l.align > 8).match({ true => 16, false => 8 }), _ => 8 });
                    cursor = round_up(cursor, align);
                    self.offsets.add(cursor).ignore();
                    cursor = cursor + round_up(
                        at_least_word(stored_size(ty)),
                        8
                    );
                },
                false => { self.offsets.add(0).ignore(); },
            });
        });
        self.frame = round_up(cursor, 16);
    }

    function = (self :: @Self, id: usize, original: Func)
               Res<(), AllocError> {
        self.function_id = id;
        self.plan        = plan(
            self.alloc,
            original,
            Pool(caller: 10, callee: 10)
        ).try();
        function         = self.plan.function;
        self.layout_frame(function);
        self.darwin().match({
            true  => self.out.fmt(".p2align 2\nza_fn_{}:\n", id),
            false => self.out.fmt(
                ".type za_fn_{}, %function\n.p2align 2\nza_fn_{}:\n",
                id,
                id
            ),
        }).try();
        self.out.add("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n").try();
        self.adjust("sub", self.frame).try();
        is_block(function.result).then(() {
            self.memory("str", "x8", self.result_offset).try();
        });
        self.plan.saved.loop((sh, k, r) {
            self.memory(
                "str",
                pool_register(r),
                self.save_offsets.get(k).value_or(0)
            ).try();
        });
        self.parameters(function).try();
        // An aggregate slot briefly holds the caller's pointer to its value.
        Range(0, function.parameters).loop((i) {
            ty = function.slots.get(i).value_or(Scalar.Unit);
            is_block(ty).then(() {
                self.memory("ldr", "x1", self.offset(i)).try();
                self.slot_address(i, "x0").try();
                self.copy_block(stored_size(ty)).try();
            });
        });
        function.blocks.loop((h, block_id, block) {
            self.block_id = block_id;
            self.out.fmt("{}za_f{}_b{}:\n", self.local(), id, block_id).try();
            fused = self.fused_compare(block);
            self.addressing(block).try();
            block.code.loop((ih, k, instruction) {
                self.at = k;
                (!(fused && k + 1 == block.code.len) && !self.absorbed.get(k).value_or(false)).then(() {
                    self.instruction(instruction).try();
                });
            });
            fused.match({
                true  => block.code.get(block.code.len - 1).when_ok((last) {
                    last.match({
                        BinaryValue(compare) => block.exit.match({
                            Branch(branch) => self.compare_branch(
                                compare,
                                branch.yes,
                                branch.no
                            ),
                            _              => Ok(()),
                        }),
                        _                    => Ok(()),
                    }).try();
                }),
                false => self.terminator(function, block.exit).try(),
            });
        });
        self.trap_stubs().try();
        self.darwin().match({
            true  => Ok(()),
            false => self.out.fmt(".size za_fn_{}, .-za_fn_{}\n", id, id),
        })
    }

    // `sp` adjustments larger than an add immediate go through x16.
    adjust = (self :: @Self, op: str, bytes: usize) Res<(), AllocError> {
        (bytes == 0).match({
            true  => Ok(()),
            false => (bytes < 4096).match({
                true  => self.out.fmt("    {} sp, sp, #{}\n", op, bytes),
                false => {
                    self.immediate("x16", bytes.to_u64()).try();
                    self.out.fmt("    {} sp, sp, x16\n", op)
                },
            }),
        })
    }

    instruction = (self :: @Self, instruction: Instruction)
                  Res<(), AllocError> {
        instruction.match({
            Constant(value)     => self.plan.home(value.out).match({
                // A fixed slot's constant is materialized where it is read.
                Fixed(_) => Ok(()),
                _        => {
                    d = self.destination(value.out);
                    self.immediate(d, bits64(value.value)).try();
                    self.settle(value.out, d)
                },
            }),
            Copy(value)         => self.copy(value.out, value.source),
            UnaryValue(value)   => self.unary(value),
            BinaryValue(value)  => self.binary(value),
            Invoke(call)        => self.call(call),
            PrintValue(value)   => self.print(value),
            Text(bytes)         => self.text(bytes),
            Cast(value)         => {
                d = self.destination(value.out);
                a = self.value(value.input, "x1").try();
                self.convert(
                    self.slot_type(value.input),
                    self.slot_type(value.out),
                    d,
                    a
                ).try();
                self.settle(value.out, d)
            },
            AddressOf(value)    => self.plan.home(value.out).match({
                Pointer(_) => Ok(()),
                _          => {
                    self.slot_address(value.slot, "x0").try();
                    self.store(value.out, "x0")
                },
            }),
            LoadValue(value)    => self.load_memory(value),
            StoreValue(value)   => self.store_memory(value),
            CopyBytes(value)    => {
                self.load(value.dest, "x0").try();
                self.load(value.source, "x1").try();
                self.load(value.bytes, "x2").try();
                self.out.add("    bl za_copy\n")
            },
            Bytes(value)        => {
                label = self.literal(value.bytes).try();
                name  = self.data_label(label).try();
                self.address("x0", name.view()).try();
                self.store(value.out, "x0")
            },
            WriteOut(value)     => {
                self.load(value.data, "x0").try();
                self.load(value.len, "x1").try();
                self.out.fmt(
                    "    mov x2, #{}\n    bl za_emit\n",
                    descriptor(value.stream)
                )
            },
            System(call)        => self.system(call),
            MapPages(value)     => {
                self.load(value.bytes, "x0").try();
                self.out.add("    bl za_map\n").try();
                self.store(value.out, "x0")
            },
            UnmapPages(slot)    => {
                self.load(slot, "x0").try();
                self.out.add("    bl za_unmap\n")
            },
            Flush               => {
                self.out.add("    bl za_flush\n")
            },
            // JavaScript-host instructions; `refused_by_asm` rejects such
            // programs before any renderer runs.
            Host(_)             => Ok(()),
            Wait(_)             => Ok(()),
            SysConst(value)     => {
                platform = self.darwin().match({ true => Platform.Darwin, false => Platform.LinuxArm64 });
                self.immediate(
                    "x0",
                    bits64(constant_value(value.name, platform))
                ).try();
                self.store(value.out, "x0")
            },
            Startup(value)      => {
                value.value.match({
                    Globals => self.address("x0", "za_globals"),
                    _       => {
                        symbol = value.value.match({ Argc => "za_argc", Argv => "za_argv", _ => "za_envp" });
                        self.address("x9", symbol).try();
                        self.out.add("    ldr x0, [x9]\n")
                    },
                }).try();
                self.store(value.out, "x0")
            },
            // gen_verify rejects machine operations (gen_ir_machine) before
            // rendering; should one arrive anyway, the program faults here.
            Machine(_)          => self.out.add("    brk #1\n"),
            AtomicLoad(value)   => self.atomic_load(value),
            AtomicStore(value)  => self.atomic_store(value),
            AtomicUpdate(value) => self.atomic_update(value),
            CompareSwap(value)  => self.compare_swap(value),
            CodeAddress(value)  => {
                name = self.alloc.String("za_fn_{}", value.function).try();
                self.address("x0", name.view()).try();
                self.store(value.out, "x0")
            },
            InvokeAt(call)      => self.call_at(call),
        })
    }

    // Sequentially consistent atomics: load-acquire and store-release
    // (RCsc on AArch64), and read-modify-write as exclusive-pair loops.
    // They use only ARMv8.0 instructions, so no CPU feature check is needed.
    atomic_address = (self :: @Self, base: usize, offset: usize) Res<(), AllocError> {
        self.load(base, "x1").try();
        self.add_offset("x1", offset)
    }

    atomic_load = (self :: @Self, value: Load) Res<(), AllocError> {
        ty = self.slot_type(value.out);
        self.atomic_address(value.base, value.offset).try();
        self.out.fmt("    ldar {}0, [x1]\n", register_width(ty)).try();
        self.canon(ty, "x0", "x0").try();
        self.store(value.out, "x0")
    }

    atomic_store = (self :: @Self, value: Store) Res<(), AllocError> {
        ty = self.slot_type(value.value);
        self.atomic_address(value.base, value.offset).try();
        self.load(value.value, "x2").try();
        self.out.fmt("    stlr {}2, [x1]\n", register_width(ty)).try();
        Ok(())
    }

    atomic_update = (self :: @Self, value: Update) Res<(), AllocError> {
        ty = self.slot_type(value.out);
        r  = register_width(ty);
        self.atomic_address(value.base, 0).try();
        self.load(value.value, "x2").try();
        value.op.match({
            Swap => self.out.fmt(
                "1:\n    ldaxr {r}0, [x1]\n    stlxr w3, {r}2, [x1]\n    cbnz w3, 1b\n"
            ),
            Add  => self.out.fmt(
                "1:\n    ldaxr {r}0, [x1]\n    add {r}4, {r}0, {r}2\n    stlxr w3, {r}4, [x1]\n    cbnz w3, 1b\n"
            ),
        }).try();
        self.canon(ty, "x0", "x0").try();
        self.store(value.out, "x0")
    }

    compare_swap = (self :: @Self, value: Compare) Res<(), AllocError> {
        ty = self.slot_type(value.out);
        r  = register_width(ty);
        self.atomic_address(value.base, 0).try();
        self.load(value.expected, "x2").try();
        self.load(value.desired, "x3").try();
        self.out.fmt(
            "1:\n    ldaxr {r}0, [x1]\n    cmp {r}0, {r}2\n    b.ne 2f\n    stlxr w4, {r}3, [x1]\n    cbnz w4, 1b\n2:\n"
        ).try();
        self.canon(ty, "x0", "x0").try();
        self.store(value.out, "x0")
    }

    // A call through a code address: word arguments in registers only. The
    // target is loaded last, into x17, which no argument load uses.
    call_at = (self :: @Self, call: IndirectCall) Res<(), AllocError> {
        call.args.loop(
            (h, i, slot) { self.load(slot, argument_register(i)).try(); }
        );
        self.load(call.target, "x17").try();
        self.out.add("    blr x17\n").try();
        self.store(call.out, "x0")
    }

    terminator = (self :: @Self, function: Func,
                  exit: Terminator) Res<(), AllocError> {
        exit.match({
            Return(value)  => {
                is_block(function.result).match({
                    true  => {
                        self.slot_address(value, "x1").try();
                        self.memory("ldr", "x0", self.result_offset).try();
                        self.copy_block(stored_size(function.result)).try();
                        self.memory("ldr", "x0", self.result_offset)
                    },
                    false => self.load(value, "x0"),
                }).try();
                self.plan.saved.loop((sh, k, r) {
                    self.memory(
                        "ldr",
                        pool_register(r),
                        self.save_offsets.get(k).value_or(0)
                    ).try();
                });
                self.out.add("    mov sp, x29\n    ldp x29, x30, [sp], #16\n    ret\n")
            },
            Jump(block)    => self.jump(block),
            Branch(branch) => self.plan.home(branch.value).match({
                Fixed(v)   => self.jump(
                    (v != 0).match({ true => branch.yes, false => branch.no })
                ),
                // A frame address is never null.
                Pointer(_) => self.jump(branch.yes),
                _          => {
                    r    = self.value(branch.value, "x0").try();
                    next = self.block_id + 1;
                    (branch.yes == next).match({
                        true  => self.out.fmt(
                            "    cbz {}, {}za_f{}_b{}\n",
                            r,
                            self.local(),
                            self.function_id,
                            branch.no
                        ),
                        false => {
                            self.out.fmt(
                                "    cbnz {}, {}za_f{}_b{}\n",
                                r,
                                self.local(),
                                self.function_id,
                                branch.yes
                            ).try();
                            self.jump(branch.no)
                        },
                    })
                },
            }),
            Trap(fault)    => self.trap_if("", fault.span, fault.what),
        })
    }

    copy = (self :: @Self, out: usize, source: usize) Res<(), AllocError> {
        ty = self.slot_type(out);
        is_block(ty).match({
            true  => {
                self.slot_address(source, "x1").try();
                self.slot_address(out, "x0").try();
                self.copy_block(stored_size(ty))
            },
            false => self.plan.home(out).match({
                Register(r) => self.fetch(source, pool_register(r)),
                Frame       => {
                    v = self.value(source, "x0").try();
                    self.memory("str", v, self.offset(out))
                },
                _           => Ok(()),
            }),
        })
    }

    // Instruction selection reads each operand from its home: an allocated
    // register as it is, anything else through a scratch register. A result
    // is computed in its home register when it has one, else in x0, and
    // `settle` puts it home. x0-x3 and x16 are scratch.

    // The register holding a slot's value, loading it into `scratch` when
    // it is not already in one.
    value = (self :: @Self, slot: usize, scratch: str) Res<str, AllocError> {
        self.plan.home(slot).match({
            Register(r) => Ok(pool_register(r)),
            _           => {
                self.fetch(slot, scratch).try();
                Ok(scratch)
            },
        })
    }

    destination = (self: @Self, slot: usize) str {
        self.plan.home(slot).match({
            Register(r) => pool_register(r),
            _           => "x0",
        })
    }

    settle = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        self.plan.home(slot).match({
            Register(r) => (!register.eq(pool_register(r))).match({
                true  => self.out.fmt(
                    "    mov {}, {}\n",
                    pool_register(r),
                    register
                ),
                false => Ok(()),
            }),
            Frame       => self.memory("str", register, self.offset(slot)),
            _           => Ok(()),
        })
    }

    unary = (self :: @Self, value: Unary) Res<(), AllocError> {
        ty = self.slot_type(value.input);
        d  = self.destination(value.out);
        a  = self.value(value.input, "x1").try();
        value.op.match({
            Neg => (width(ty) == 8).match({
                true  => {
                    self.out.fmt("    negs {}, {}\n", d, a).try();
                    self.trap_if("vs", value.span, TrapKind.Overflow)
                },
                false => {
                    self.out.fmt("    neg {}, {}\n", d, a).try();
                    self.range_check(ty, value.span, d)
                },
            }),
            Not => self.out.fmt("    eor {}, {}, #1\n", d, a),
        }).try();
        self.settle(value.out, d)
    }

    // The 64-bit result must equal itself re-extended from the type's width.
    range_check = (self :: @Self, ty: Scalar, span: Span, d: str) Res<(), AllocError> {
        self.out.fmt("    cmp {}, {}, {}\n", d, low32(d), extension(ty)).try();
        self.trap_if("ne", span, TrapKind.Overflow)
    }

    // Re-extend `d` from `ty`'s width, reading `source` (which may be `d`).
    canon = (self :: @Self, ty: Scalar, d: str, source: str) Res<(), AllocError> {
        ty.match({
            I8   => self.out.fmt("    sxtb {}, {}\n", d, low32(source)),
            U8   => self.out.fmt("    and {}, {}, #0xff\n", d, source),
            Bool => self.out.fmt("    and {}, {}, #0xff\n", d, source),
            I16  => self.out.fmt("    sxth {}, {}\n", d, low32(source)),
            U16  => self.out.fmt("    and {}, {}, #0xffff\n", d, source),
            I32  => self.out.fmt("    sxtw {}, {}\n", d, low32(source)),
            U32  => self.out.fmt("    mov {}, {}\n", low32(d), low32(source)),
            _    => (d.eq(source)).match({
                true  => Ok(()),
                false => self.out.fmt("    mov {}, {}\n", d, source),
            }),
        })
    }

    convert = (self :: @Self, from: Scalar, to: Scalar, d: str, source: str) Res<(), AllocError> {
        to.match({
            Bool => (width(from) == 1 && !signed(from)).match({
                true  => self.canon(Scalar.U64, d, source),
                false => self.out.fmt("    cmp {}, #0\n    cset {}, ne\n", source, d),
            }),
            _    => self.canon(to, d, source),
        })
    }

    binary = (self :: @Self, value: Binary) Res<(), AllocError> {
        ty = self.slot_type(value.left);
        value.op.match({
            Div          => self.divide_op(value, ty, false),
            Rem          => self.divide_op(value, ty, true),
            Equal        => self.compare_op(value, ty),
            NotEqual     => self.compare_op(value, ty),
            Less         => self.compare_op(value, ty),
            LessEqual    => self.compare_op(value, ty),
            Greater      => self.compare_op(value, ty),
            GreaterEqual => self.compare_op(value, ty),
            Shl          => self.shift_op(value, ty),
            Shr          => self.shift_op(value, ty),
            Rotr         => self.shift_op(value, ty),
            _            => self.arithmetic(value, ty),
        })
    }

    // Arithmetic and bit operations on registers. Operands keep their
    // extension to 64 bits, so 32-bit instructions serve 32-bit classes
    // (writing a w register clears the upper half) and flags check 32- and
    // 64-bit overflow directly; narrower classes compute in 64 bits and
    // compare against the re-extended result.
    arithmetic = (self :: @Self, value: Binary, ty: Scalar) Res<(), AllocError> {
        w         = width(ty);
        is_signed = signed(ty);
        d         = self.destination(value.out);
        a         = self.value(value.left, "x1").try();
        // An add or subtract takes a 12-bit unsigned immediate.
        small   = self.plan.home(value.right).match({
            Fixed(c) => (c > 0 && c < 4096).match({ true => c, false => -1 }),
            _        => -1,
        });
        adding  = value.op.match({ Add => true, Sub => true, WrapAdd => true, WrapSub => true, _ => false });
        b       = (adding && small > 0).match({
            true  => "",
            false => self.value(value.right, "x2").try(),
        });
        narrow  = w == 4 && value.op.match({ And => false, Or => false, Xor => false, Mul => false, _ => true });
        dn      = narrow.match({ true => low32(d), false => d });
        an      = narrow.match({ true => low32(a), false => a });
        bn      = narrow.match({ true => low32(b), false => b });
        operand = (adding && small > 0).match({
            true  => self.alloc.String("#{}", small).try(),
            false => self.alloc.String("{}", bn).try(),
        });
        value.op.match({
            Add     => {
                self.out.fmt(
                    "    adds {}, {}, {}\n",
                    dn,
                    an,
                    operand.view()
                ).try();
                (w >= 4).match({
                    true  => {
                        self.trap_if(
                            is_signed.match({ true => "vs", false => "hs" }),
                            value.span,
                            TrapKind.Overflow
                        ).try();
                        (w == 4 && is_signed).match({ true => self.canon(ty, d, d), false => Ok(()) })
                    },
                    false => self.range_check(ty, value.span, d),
                })
            },
            Sub     => {
                self.out.fmt(
                    "    subs {}, {}, {}\n",
                    dn,
                    an,
                    operand.view()
                ).try();
                (w >= 4).match({
                    true  => {
                        self.trap_if(
                            is_signed.match({ true => "vs", false => "lo" }),
                            value.span,
                            TrapKind.Overflow
                        ).try();
                        (w == 4 && is_signed).match({ true => self.canon(ty, d, d), false => Ok(()) })
                    },
                    false => self.range_check(ty, value.span, d),
                })
            },
            Mul     => (w == 8).match({
                true  => is_signed.match({
                    true  => {
                        self.out.fmt(
                            "    mul x3, {}, {}\n    smulh x2, {}, {}\n    cmp x2, x3, asr #63\n",
                            a,
                            b,
                            a,
                            b
                        ).try();
                        self.trap_if("ne", value.span, TrapKind.Overflow).try();
                        self.out.fmt("    mov {}, x3\n", d)
                    },
                    false => {
                        self.out.fmt(
                            "    umulh x3, {}, {}\n    mul {}, {}, {}\n",
                            a,
                            b,
                            d,
                            a,
                            b
                        ).try();
                        self.out.add("    cmp x3, #0\n").try();
                        self.trap_if("ne", value.span, TrapKind.Overflow)
                    },
                }),
                // Extended operands of at most 32 bits multiply exactly.
                false => {
                    self.out.fmt("    mul {}, {}, {}\n", d, a, b).try();
                    self.range_check(ty, value.span, d)
                },
            }),
            WrapAdd => {
                self.out.fmt("    add {}, {}, {}\n", dn, an, operand.view()).try();
                self.wrapped(ty, d)
            },
            WrapSub => {
                self.out.fmt("    sub {}, {}, {}\n", dn, an, operand.view()).try();
                self.wrapped(ty, d)
            },
            WrapMul => {
                self.out.fmt("    mul {}, {}, {}\n", dn, an, operand.view()).try();
                self.wrapped(ty, d)
            },
            And     => self.out.fmt("    and {}, {}, {}\n", d, a, b),
            Or      => self.out.fmt("    orr {}, {}, {}\n", d, a, b),
            _       => self.out.fmt("    eor {}, {}, {}\n", d, a, b),
        }).try();
        self.settle(value.out, d)
    }

    // A wrapped result re-extended from its class width. A 32-bit
    // instruction already truncated an unsigned 32-bit result.
    wrapped = (self :: @Self, ty: Scalar, d: str) Res<(), AllocError> {
        ty.match({
            U32 => Ok(()),
            U64 => Ok(()),
            I64 => Ok(()),
            Ptr => Ok(()),
            _   => self.canon(ty, d, d),
        })
    }

    // Counts at or beyond the width produce zero, as the std contract says;
    // rotation counts are taken modulo the width.
    shift_op = (self :: @Self, value: Binary, ty: Scalar) Res<(), AllocError> {
        w    = width(ty);
        bits = w * 8;
        d    = self.destination(value.out);
        a    = self.value(value.left, "x1").try();
        self.plan.home(value.right).match({
            Fixed(k) => value.op.match({
                Rotr => w.match({
                    4 => self.out.fmt(
                        "    ror {}, {}, #{}\n",
                        low32(d),
                        low32(a),
                        modulo(k, 32)
                    ),
                    8 => self.out.fmt(
                        "    ror {}, {}, #{}\n",
                        d,
                        a,
                        modulo(k, 64)
                    ),
                    _ => self.rotate_narrow(
                        ty,
                        d,
                        a,
                        self.value(value.right, "x2").try()
                    ),
                }),
                _    => (k < 0 || k >= bit_width(w)).match({
                    true  => self.out.fmt("    mov {}, xzr\n", d),
                    false => {
                        mnemonic = value.op.match({ Shl => "lsl", _ => "lsr" });
                        self.out.fmt(
                            "    {} {}, {}, #{}\n",
                            mnemonic,
                            d,
                            a,
                            k
                        ).try();
                        value.op.match({
                            Shl => self.canon(ty, d, d),
                            _   => signed(ty).match({ true => self.canon(ty, d, d), false => Ok(()) }),
                        })
                    },
                }),
            }),
            _        => {
                b = self.value(value.right, "x2").try();
                value.op.match({
                    Rotr => w.match({
                        4 => self.out.fmt(
                            "    ror {}, {}, {}\n",
                            low32(d),
                            low32(a),
                            low32(b)
                        ),
                        8 => self.out.fmt("    ror {}, {}, {}\n", d, a, b),
                        _ => self.rotate_narrow(ty, d, a, b),
                    }),
                    _    => {
                        mnemonic = value.op.match({ Shl => "lsl", _ => "lsr" });
                        self.out.fmt(
                            "    {} x3, {}, {}\n    cmp {}, #{}\n    csel {}, xzr, x3, hs\n",
                            mnemonic,
                            a,
                            b,
                            b,
                            bits,
                            d
                        ).try();
                        self.canon(ty, d, d)
                    },
                })
            },
        }).try();
        self.settle(value.out, d)
    }

    rotate_narrow = (self :: @Self, ty: Scalar, d: str, a: str, count: str) Res<(), AllocError> {
        bits = width(ty) * 8;
        self.out.fmt(
            "    and w2, {}, #{}\n    lsr w3, {}, w2\n    neg w16, w2\n    and w16, w16, #{}\n    lsl w16, {}, w16\n    orr {}, w3, w16\n",
            low32(count),
            bits - 1,
            low32(a),
            bits - 1,
            low32(a),
            low32(d)
        ).try();
        self.canon(ty, d, d)
    }

    // Set flags for `left op right`; true when the operands were exchanged.
    compare_flags = (self :: @Self, left: usize, right: usize) Res<bool, AllocError> {
        right_small = self.plan.home(
            right
        ).match({ Fixed(c) => c >= 0 && c < 4096, _ => false });
        left_small  = self.plan.home(
            left
        ).match({ Fixed(c) => c >= 0 && c < 4096, _ => false });
        swapped     = left_small && !right_small;
        first       = swapped.match({ true => right, false => left });
        second      = swapped.match({ true => left, false => right });
        a           = self.value(first, "x1").try();
        self.plan.home(second).match({
            Fixed(c) => (c >= 0 && c < 4096).match({
                true  => self.out.fmt("    cmp {}, #{}\n", a, c),
                false => {
                    b = self.value(second, "x2").try();
                    self.out.fmt("    cmp {}, {}\n", a, b)
                },
            }),
            _        => {
                b = self.value(second, "x2").try();
                self.out.fmt("    cmp {}, {}\n", a, b)
            },
        }).try();
        Ok(swapped)
    }

    compare_op = (self :: @Self, value: Binary, ty: Scalar) Res<(), AllocError> {
        swapped = self.compare_flags(value.left, value.right).try();
        d       = self.destination(value.out);
        self.out.fmt(
            "    cset {}, {}\n",
            d,
            condition(value.op, signed(ty), swapped)
        ).try();
        self.settle(value.out, d)
    }

    // A block ending in a comparison read only by its branch compares and
    // branches without materializing the boolean.
    fused_compare = (self: @Self, block: BasicBlock) bool {
        (block.code.len > 0).match({
            false => false,
            true  => block.exit.match({
                Branch(branch) => block.code.get(block.code.len - 1).match({
                    Ok(last) => last.match({
                        BinaryValue(compare) => compare.out == branch.value
                            && self.plan.reads_of(compare.out) == 1
                            && self.plan.is_local(compare.out)
                            && compare.op.match({
                                Equal => true, NotEqual => true, Less => true, LessEqual => true,
                                Greater => true, GreaterEqual => true, _ => false,
                            }),
                        _                    => false,
                    }),
                    None     => false,
                }),
                _              => false,
            }),
        })
    }

    compare_branch = (self :: @Self, compare: Binary, yes: usize, no: usize) Res<(), AllocError> {
        swapped = self.compare_flags(compare.left, compare.right).try();
        self.branch(
            condition(
                compare.op,
                signed(self.slot_type(compare.left)),
                swapped
            ),
            yes,
            no
        )
    }

    // Branch on `cc` to `yes`, else to `no`, falling through to whichever
    // is the next block.
    branch = (self :: @Self, cc: str, yes: usize, no: usize) Res<(), AllocError> {
        next = self.block_id + 1;
        (no == next).match({
            true  => self.out.fmt(
                "    b.{} {}za_f{}_b{}\n",
                cc,
                self.local(),
                self.function_id,
                yes
            ),
            false => (yes == next).match({
                true  => self.out.fmt(
                    "    b.{} {}za_f{}_b{}\n",
                    inverse(cc),
                    self.local(),
                    self.function_id,
                    no
                ),
                false => {
                    self.out.fmt(
                        "    b.{} {}za_f{}_b{}\n",
                        cc,
                        self.local(),
                        self.function_id,
                        yes
                    ).try();
                    self.jump(no)
                },
            }),
        })
    }

    jump = (self :: @Self, block: usize) Res<(), AllocError> {
        (block == self.block_id + 1).match({
            true  => Ok(()),
            false => self.out.fmt(
                "    b {}za_f{}_b{}\n",
                self.local(),
                self.function_id,
                block
            ),
        })
    }

    divide_op = (self :: @Self, value: Binary, ty: Scalar, remainder: bool) Res<(), AllocError> {
        power = self.plan.home(value.right).match({ Fixed(c) => log2(c), _ => NONE });
        (power != NONE && power > 0 && power < 31 && !signed(ty)).match({
            // An unsigned division by a power of two is a shift and its
            // remainder a mask; the divisor is not zero.
            true  => {
                d = self.destination(value.out);
                a = self.value(value.left, "x1").try();
                remainder.match({
                    true  => self.out.fmt(
                        "    and {}, {}, #{}\n",
                        d,
                        a,
                        low_mask(power)
                    ),
                    false => self.out.fmt("    lsr {}, {}, #{}\n", d, a, power),
                }).try();
                self.settle(value.out, d)
            },
            false => {
                self.fetch(value.left, "x0").try();
                self.fetch(value.right, "x1").try();
                self.divide(ty, value.span, remainder).try();
                self.settle(value.out, "x0")
            },
        })
    }

    // sdiv/udiv do not fault, so zero and MIN / -1 are checked explicitly
    // to keep Zen's traps rather than the hardware's quiet results.
    divide = (self :: @Self, ty: Scalar, span: Span, remainder: bool)
             Res<(), AllocError> {
        self.out.add("    cmp x1, #0\n").try();
        self.trap_if("eq", span, TrapKind.DivideByZero).try();
        signed(ty).match({
            true  => {
                self.immediate("x2", bits64(minimum(ty))).try();
                self.out.add("    cmn x1, #1\n    ccmp x0, x2, #0, eq\n").try();
                self.trap_if("eq", span, TrapKind.Overflow).try();
                self.out.add("    sdiv x2, x0, x1\n")
            },
            false => self.out.add("    udiv x2, x0, x1\n"),
        }).try();
        remainder.match({
            true  => self.out.add("    msub x0, x2, x1, x0\n"),
            false => self.out.add("    mov x0, x2\n"),
        })
    }

    load_memory = (self :: @Self, value: Load) Res<(), AllocError> {
        ty = self.slot_type(value.out);
        is_block(ty).match({
            true  => {
                self.fetch(value.base, "x1").try();
                self.add_offset("x1", value.offset).try();
                self.slot_address(value.out, "x0").try();
                self.copy_block(stored_size(ty))
            },
            false => {
                d = self.destination(value.out);
                w = width(ty);
                (w == 0).match({
                    true  => self.out.fmt("    mov {}, #0\n", d),
                    false => {
                        mnemonic = ty.match({
                            I8   => "ldrsb",
                            U8   => "ldrb",
                            Bool => "ldrb",
                            I16  => "ldrsh",
                            U16  => "ldrh",
                            I32  => "ldrsw",
                            U32  => "ldr",
                            _    => "ldr",
                        });
                        target   = ty.match({
                            U8   => low32(d),
                            Bool => low32(d),
                            U16  => low32(d),
                            U32  => low32(d),
                            _    => d,
                        });
                        self.memory_access(
                            mnemonic,
                            target,
                            value.base,
                            value.offset,
                            w
                        )
                    },
                }).try();
                self.settle(value.out, d)
            },
        })
    }

    store_memory = (self :: @Self, value: Store) Res<(), AllocError> {
        ty = self.slot_type(value.value);
        is_block(ty).match({
            true  => {
                self.fetch(value.base, "x0").try();
                self.add_offset("x0", value.offset).try();
                self.slot_address(value.value, "x1").try();
                self.copy_block(stored_size(ty)).try();
            },
            false => {
                w = width(ty);
                (w > 0).then(() {
                    stored   = self.plan.home(value.value).match({
                        Fixed(v) => (v == 0).match({ true => "xzr", false => self.value(
                            value.value,
                            "x3"
                        ).try() }),
                        _        => self.value(value.value, "x3").try(),
                    });
                    mnemonic = w.match({ 1 => "strb", 2 => "strh", _ => "str" });
                    register = (w == 8).match({ true => stored, false => low32(
                        stored
                    ) });
                    self.memory_access(
                        mnemonic,
                        register,
                        value.base,
                        value.offset,
                        w
                    ).try();
                });
            },
        });
        Ok(())
    }

    // Find the memory operand of every word access in `block` and mark the
    // pointer arithmetic it absorbs.
    addressing = (self :: @Self, block: BasicBlock) Res<(), AllocError> {
        self.addresses.clear();
        self.absorbed.clear();
        block.code.loop((_) {
            self.addresses.add(Address(
                base: NONE,
                index: NONE,
                scale: 1,
                displacement: 0,
                absorbed: 0
            )).try();
            self.absorbed.add(false).try();
        });
        modes = Modes(any_scale: false);
        block.code.loop((h, k, instruction) {
            found = instruction.match({
                LoadValue(v)  => {
                    w = width(self.slot_type(v.out));
                    (w > 0 && !is_block(self.slot_type(v.out))).match({
                        true  => Ok(self.plan.address(
                            block,
                            k,
                            v.base,
                            w,
                            modes
                        )),
                        false => None,
                    })
                },
                StoreValue(v) => {
                    w = width(self.slot_type(v.value));
                    (w > 0 && !is_block(self.slot_type(v.value))).match({
                        true  => Ok(self.plan.address(
                            block,
                            k,
                            v.base,
                            w,
                            modes
                        )),
                        false => None,
                    })
                },
                _             => None,
            });
            found.when_ok((address) {
                self.addresses.set(k, address);
                Range(0, address.absorbed).loop((i) { self.absorbed.set(k - 1 - i, true); });
            });
        });
        Ok(())
    }

    // `mnemonic register, [address]` for the access being rendered, whose
    // base pointer is `base`, `offset` bytes further on. Address arithmetic
    // the addressing modes cannot express goes through x16.
    memory_access = (self :: @Self, mnemonic: str, register: str, base: usize, offset: usize, w: usize)
                    Res<(), AllocError> {
        found = self.addresses.get(self.at).match({
            Ok(a) => (a.base == NONE).match({
                true  => Address(
                    base: base,
                    index: NONE,
                    scale: 1,
                    displacement: 0,
                    absorbed: 0
                ),
                false => a,
            }),
            None  => Address(
                base: base,
                index: NONE,
                scale: 1,
                displacement: 0,
                absorbed: 0
            ),
        });
        displacement ::= found.displacement + bits(offset);
        from         ::= "sp";
        self.plan.home(found.base).match({
            Pointer(s) => { displacement = displacement + bits(self.offset(
                s
            )); },
            _          => { from = self.value(found.base, "x1").try(); },
        });
        index ::= "";
        (found.index != NONE).then(() {
            self.plan.home(found.index).match({
                Fixed(c) => (c > -268435456 && c < 268435456).match({
                    true  => { displacement = displacement + c * scale_of(
                        found.scale
                    ); },
                    false => { index = self.value(found.index, "x2").try(); },
                }),
                _        => { index = self.value(found.index, "x2").try(); },
            });
        });
        (index.is_empty()).match({
            true  => {
                unscaled = displacement >= -256 && displacement < 256;
                scaled   = displacement >= 0 && displacement % bits(w) == 0 && displacement / bits(w) < 4096;
                scaled.match({
                    true  => self.out.fmt(
                        "    {} {}, [{}, #{}]\n",
                        mnemonic,
                        register,
                        from,
                        displacement
                    ),
                    false => unscaled.match({
                        true  => self.out.fmt(
                            "    {} {}, [{}, #{}]\n",
                            unscaled_form(mnemonic),
                            register,
                            from,
                            displacement
                        ),
                        false => {
                            self.offset_into("x16", from, displacement).try();
                            self.out.fmt("    {} {}, [x16]\n", mnemonic, register)
                        },
                    }),
                })
            },
            false => {
                (displacement != 0).then(() {
                    self.offset_into("x16", from, displacement).try();
                    from = "x16";
                });
                (found.scale == 1).match({
                    true  => self.out.fmt(
                        "    {} {}, [{}, {}]\n",
                        mnemonic,
                        register,
                        from,
                        index
                    ),
                    false => self.out.fmt(
                        "    {} {}, [{}, {}, lsl #{}]\n",
                        mnemonic,
                        register,
                        from,
                        index,
                        log2(scale_of(found.scale))
                    ),
                })
            },
        })
    }

    // `target = from + displacement` for any displacement.
    offset_into = (self :: @Self, target: str, from: str, displacement: i64) Res<(), AllocError> {
        (displacement >= 0 && displacement < 4096).match({
            true  => self.out.fmt(
                "    add {}, {}, #{}\n",
                target,
                from,
                displacement
            ),
            false => (displacement < 0 && displacement > -4096).match({
                true  => self.out.fmt(
                    "    sub {}, {}, #{}\n",
                    target,
                    from,
                    0 - displacement
                ),
                false => {
                    self.immediate("x17", bits64(displacement)).try();
                    self.out.fmt("    add {}, {}, x17\n", target, from)
                },
            }),
        })
    }

    add_offset = (self :: @Self, register: str, offset: usize)
                 Res<(), AllocError> {
        (offset == 0).match({
            true  => Ok(()),
            false => (offset < 4096).match({
                true  => self.out.fmt(
                    "    add {}, {}, #{}\n",
                    register,
                    register,
                    offset
                ),
                false => {
                    self.immediate("x16", offset.to_u64()).try();
                    self.out.fmt("    add {}, {}, x16\n", register, register)
                },
            }),
        })
    }

    // Copy `size` bytes from [x1] to [x0], clobbering x0-x3.
    copy_block = (self :: @Self, size: usize) Res<(), AllocError> {
        (size > 128).match({
            true  => {
                self.immediate("x2", size.to_u64()).try();
                self.out.add("    bl za_copy\n").try();
            },
            false => {
                at :: usize = 0;
                loop(() { at + 8 <= size }, (h) {
                    self.out.fmt(
                        "    ldr x2, [x1, #{}]\n    str x2, [x0, #{}]\n",
                        at,
                        at
                    ).try();
                    at = at + 8;
                });
                loop(() { at < size }, (h) {
                    self.out.fmt(
                        "    ldrb w2, [x1, #{}]\n    strb w2, [x0, #{}]\n",
                        at,
                        at
                    ).try();
                    at = at + 1;
                });
            },
        });
        Ok(())
    }

    call = (self :: @Self, call: Invocation) Res<(), AllocError> {
        hidden = self.program.functions.get(call.function).match({
            Ok(f) => is_block(f.result),
            None  => false,
        });
        call.args.loop((h, i, slot) {
            (i >= REGISTER_ARGUMENTS).then(() {
                self.argument(slot, "x9").try();
                self.out.fmt(
                    "    str x9, [sp, #{}]\n",
                    (i - REGISTER_ARGUMENTS) * 8
                ).try();
            });
        });
        // Arguments live in callee-saved registers, memory or constants
        // (see gen_asm_regalloc), never in the registers loaded here.
        call.args.loop((h, i, slot) {
            (i == REGISTER_ARGUMENTS).then(() { h.break(); });
            self.argument(slot, argument_register(i)).try();
        });
        hidden.then(() { self.slot_address(call.out, "x8").try(); });
        self.out.fmt("    bl za_fn_{}\n", call.function).try();
        hidden.match({
            true  => Ok(()),
            false => self.store(call.out, "x0"),
        })
    }

    // A word travels by value; an aggregate by the address of its slot.
    argument = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        is_block(self.slot_type(slot)).match({
            true  => self.slot_address(slot, register),
            false => self.load(slot, register),
        })
    }

    system = (self :: @Self, call: SysCall) Res<(), AllocError> {
        call.args.loop((h, i, slot) {
            self.load(slot, argument_register(i)).try();
        });
        self.darwin().match({
            // openat's mode is variadic (on the stack), getentropy caps its
            // length and pthread_create needs a C entry point and stack size,
            // so these go through runtime adapters.
            true  => call.call.match({
                Openat       => self.out.add(
                    "    bl za_d_openat\n    cmn x0, #1\n    b.ne 1f\n    bl ___error\n    ldrsw x0, [x0]\n    neg x0, x0\n1:\n"
                ),
                Getrandom    => self.out.add("    bl za_d_getrandom\n"),
                PthreadStart => self.out.add("    bl za_d_thread_start\n"),
                _            => darwin_symbol(call.call).match({
                    Ok(symbol) => darwin_result(call.call).match({
                        Errno    => self.out.fmt(
                            "    bl _{}\n    cmn x0, #1\n    b.ne 1f\n    bl ___error\n    ldrsw x0, [x0]\n    neg x0, x0\n1:\n",
                            symbol
                        ),
                        Returned => self.out.fmt(
                            "    bl _{}\n    neg x0, x0\n",
                            symbol
                        ),
                        Handle   => self.out.fmt("    bl _{}\n", symbol),
                    }),
                    None       => self.out.add("    mov x0, #-78\n"),
                }),
            }),
            false => call.call.match({
                // The running thread's control block is its TLS pointer.
                ThreadSelf  => self.out.add("    mrs x0, tpidr_el0\n"),
                CloneThread => self.out.add("    bl za_clone\n"),
                _           => linux_arm64(call.call).match({
                    Ok(number) => self.out.fmt(
                        "    mov x8, #{}\n    svc #0\n",
                        number
                    ),
                    None       => self.out.add("    mov x0, #-38\n"),
                }),
            }),
        }).try();
        self.store(call.out, "x0")
    }

    print = (self :: @Self, value: Print) Res<(), AllocError> {
        fd = descriptor(value.stream);
        value.ty.match({
            Bool => {
                self.load(value.value, "x9").try();
                self.address("x0", "za_false").try();
                self.address("x10", "za_true").try();
                self.out.fmt(
                    "    cmp x9, #0\n    csel x0, x0, x10, eq\n    cset x1, eq\n    add x1, x1, #4\n    mov x2, #{}\n    bl za_emit\n",
                    fd
                )
            },
            Unit => {
                label = self.literal("()").try();
                data  = self.data_label(label).try();
                self.address("x0", data.view()).try();
                self.out.fmt("    mov x1, #2\n    mov x2, #{}\n    bl za_emit\n", fd)
            },
            _    => {
                self.load(value.value, "x0").try();
                self.out.fmt("    mov x1, #{}\n", fd).try();
                signed(value.ty).match({
                    true  => self.out.add("    bl za_print_i64\n"),
                    false => self.out.add("    bl za_print_u64\n"),
                })
            },
        }).try();
        Ok(())
    }

    text = (self :: @Self, bytes: str) Res<(), AllocError> {
        (!bytes.is_empty()).then(() {
            label = self.literal(bytes).try();
            data  = self.data_label(label).try();
            self.address("x0", data.view()).try();
            self.immediate("x1", bytes.len.to_u64()).try();
            self.out.add("    bl za_out\n").try();
        });
        Ok(())
    }

    data_label = (self: @Self, label: usize) Res<String, AllocError> {
        self.alloc.String("{}za_d{}", self.local(), label)
    }

    // Materialize a data address; Mach-O and ELF spell page relocations
    // differently.
    address = (self :: @Self, register: str, symbol: str)
              Res<(), AllocError> {
        self.darwin().match({
            true  => self.out.fmt(
                "    adrp {}, {}@PAGE\n    add {}, {}, {}@PAGEOFF\n",
                register,
                symbol,
                register,
                register,
                symbol
            ),
            false => self.out.fmt(
                "    adrp {}, {}\n    add {}, {}, :lo12:{}\n",
                register,
                symbol,
                register,
                register,
                symbol
            ),
        })
    }

    // movz/movk sequence for any 64-bit pattern; a w register receives the
    // low 32 bits.
    immediate = (self :: @Self, register: str, bits: u64)
                Res<(), AllocError> {
        chunks: usize = register.starts_with(
            "x"
        ).match({ true => 4, false => 2 });
        self.out.fmt("    movz {}, #{}\n", register, bits % 65536).try();
        scale ::= bits / 65536;
        Range(1, chunks).loop((i) {
            part = scale % 65536;
            (part != 0).then(() {
                self.out.fmt(
                    "    movk {}, #{}, lsl #{}\n",
                    register,
                    part,
                    i * 16
                ).try();
            });
            scale = scale / 65536;
        });
        Ok(())
    }

    literal = (self :: @Self, bytes: str) Res<usize, AllocError> {
        label = self.label();
        self.data.fmt("{}za_d{}:\n", self.local(), label).try();
        self.data_bytes(bytes).try();
        Ok(label)
    }

    data_bytes = (self :: @Self, bytes: str) Res<(), AllocError> {
        bytes.loop((h, i, byte) {
            (i % 32 == 0).then(() {
                (i > 0).then(() { self.data.add("\n").try(); });
                self.data.add("    .byte ").try();
            });
            (i % 32 > 0).then(() { self.data.add(",").try(); });
            self.data.fmt("{}", byte).try();
        });
        (!bytes.is_empty()).then(() { self.data.add("\n").try(); });
        Ok(())
    }

    label = (self :: @Self) usize {
        label           = self.next_label;
        self.next_label = label + 1;
        label
    }

    slot_address = (self :: @Self, slot: usize, register: str)
                   Res<(), AllocError> {
        offset = self.offset(slot);
        (offset < 4096).match({
            true  => self.out.fmt("    add {}, sp, #{}\n", register, offset),
            false => {
                self.immediate("x16", offset.to_u64()).try();
                self.out.fmt("    add {}, sp, x16\n", register)
            },
        })
    }

    load = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        self.fetch(slot, register)
    }

    // Read a slot's value from its home into `register`.
    fetch = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        self.plan.home(slot).match({
            Register(r)  => (!register.eq(pool_register(r))).match({
                true  => self.out.fmt(
                    "    mov {}, {}\n",
                    register,
                    pool_register(r)
                ),
                false => Ok(()),
            }),
            Fixed(value) => self.immediate(register, bits64(value)),
            Pointer(s)   => self.slot_address(s, register),
            Frame        => self.memory("ldr", register, self.offset(slot)),
        })
    }

    // Move incoming arguments to their homes. Register-to-register moves
    // form a parallel assignment (a home may be another argument's incoming
    // register), ordered so no source is overwritten before it is read and
    // with x16 breaking any cycle.
    parameters = (self :: @Self, function: Func) Res<(), AllocError> {
        sources ::= self.alloc.Vec<usize>();
        targets ::= self.alloc.Vec<usize>();
        Range(0, function.parameters).loop((i) {
            (i < REGISTER_ARGUMENTS).then(() {
                self.plan.home(i).match({
                    Register(r) => {
                        sources.add(i).try();
                        targets.add(register_number(r)).try();
                    },
                    Frame       => self.memory(
                        "str",
                        argument_register(i),
                        self.offset(i)
                    ).try(),
                    // A parameter is never a constant or an address.
                    _           => (),
                });
            });
        });
        done ::= self.alloc.Vec<bool>();
        sources.loop(
            (h, i, source) { done.add(source == targets.get(i).value_or(source)).try(); }
        );
        pending ::= 0;
        done.loop((d) { (!d).then(() { pending = pending + 1; }); });
        loop(() { pending > 0 }, (h) {
            progressed ::= false;
            Range(0, sources.len).loop((i) {
                (!done.get(i).value_or(true)).then(() {
                    target = targets.get(i).value_or(0);
                    blocked ::= false;
                    Range(0, sources.len).loop((j) {
                        (j != i && !done.get(j).value_or(true) && sources.get(j).value_or(0) == target)
                            .then(() { blocked = true; });
                    });
                    (!blocked).then(() {
                        self.out.fmt(
                            "    mov x{}, x{}\n",
                            target,
                            sources.get(i).value_or(0)
                        ).try();
                        done.set(i, true);
                        pending    = pending - 1;
                        progressed = true;
                    });
                });
            });
            (!progressed).then(() {
                // Every pending target is still to be read: park one in x16.
                Range(0, sources.len).loop((ih, i) {
                    (!done.get(i).value_or(true)).then(() {
                        target = targets.get(i).value_or(0);
                        self.out.fmt("    mov x16, x{}\n", target).try();
                        Range(0, sources.len).loop((j) {
                            (!done.get(j).value_or(true) && sources.get(j).value_or(0) == target)
                                .then(() { sources.set(j, 16); });
                        });
                        ih.break();
                    });
                });
            });
        });
        Range(0, function.parameters).loop((i) {
            (i >= REGISTER_ARGUMENTS).then(() {
                self.plan.home(i).match({
                    Register(r) => self.out.fmt(
                        "    ldr {}, [x29, #{}]\n",
                        pool_register(r),
                        16 + (i - REGISTER_ARGUMENTS) * 8
                    ).try(),
                    Frame       => {
                        self.out.fmt(
                            "    ldr x9, [x29, #{}]\n",
                            16 + (i - REGISTER_ARGUMENTS) * 8
                        ).try();
                        self.memory("str", "x9", self.offset(i)).try();
                    },
                    _           => (),
                });
            });
        });
        Ok(())
    }

    store = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        self.plan.home(slot).match({
            Register(r) => (!register.eq(pool_register(r))).then(() {
                self.out.fmt("    mov {}, {}\n", pool_register(
                    r
                ), register).try();
            }),
            // Only the defining `Constant` or `AddressOf` writes a fixed or
            // pointer slot, and it emits nothing.
            Fixed(_)    => (),
            Pointer(_)  => (),
            Frame       => self.memory(
                "str",
                register,
                self.offset(slot)
            ).try(),
        });
        Ok(())
    }

    // Scaled unsigned offsets reach 32 KiB for doublewords; larger frames
    // address through x16.
    memory = (self :: @Self, op: str, register: str, offset: usize)
             Res<(), AllocError> {
        (offset < 32760).match({
            true  => self.out.fmt("    {} {}, [sp, #{}]\n", op, register, offset),
            false => {
                self.immediate("x16", offset.to_u64()).try();
                self.out.fmt("    {} {}, [sp, x16]\n", op, register)
            },
        })
    }

    // Branch to an out-of-line trap when `condition` holds; an empty
    // condition branches unconditionally.
    trap_if = (self :: @Self, condition: str, span: Span, what: TrapKind)
              Res<(), AllocError> {
        label = self.label();
        site  = self.location(label, span, what).try();
        self.traps.add(site).try();
        condition.is_empty().match({
            true  => self.out.fmt("    b {}za_trap{}\n", self.local(), label),
            false => self.out.fmt(
                "    b.{} {}za_trap{}\n",
                condition,
                self.local(),
                label
            ),
        })
    }

    location = (self :: @Self, label: usize, span: Span, what: TrapKind)
               Res<TrapSite, AllocError> {
        data = self.label();
        self.scratch.clear();
        self.scratch.add(span.file).try();
        self.scratch.fmt(
            ":{}:{}: trap: {}\n",
            span.start.line,
            span.start.col,
            trap_message(what)
        ).try();
        self.data.fmt("{}za_d{}:\n", self.local(), data).try();
        self.data_bytes(self.scratch.view()).try();
        Ok(TrapSite(
            label: label,
            location: data,
            length: self.scratch.view().len
        ))
    }

    trap_stubs = (self :: @Self) Res<(), AllocError> {
        self.traps.loop((site) {
            self.out.fmt("{}za_trap{}:\n", self.local(), site.label).try();
            data = self.data_label(site.location).try();
            self.address("x0", data.view()).try();
            self.immediate("x1", site.length.to_u64()).try();
            self.out.add("    b za_trap\n").try();
        });
        self.traps.clear();
        Ok(())
    }

    // Kernel entry points in the -errno convention. Linux traps directly;
    // Darwin calls the libSystem function and translates errno.
    syscalls = (self :: @Self) Res<(), AllocError> {
        self.darwin().match({
            true  => {
                write = darwin_symbol(Sys.Write).value_or("write");
                exit  = darwin_symbol(Sys.ExitGroup).value_or("_exit");
                self.out.fmt(
                    "za_sys_write:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    bl _{}\n    cmn x0, #1\n    b.ne 1f\n    bl ___error\n    ldrsw x0, [x0]\n    neg x0, x0\n1:\n    ldp x29, x30, [sp], #16\n    ret\nza_sys_exit:\n    bl _{}\n    brk #1\n",
                    write,
                    exit
                )
            },
            false => {
                write = linux_arm64(Sys.Write).value_or(0);
                exit  = linux_arm64(Sys.ExitGroup).value_or(0);
                self.out.fmt(
                    "za_sys_write:\n    mov x8, #{}\n    svc #0\n    ret\nza_sys_exit:\n    mov x8, #{}\n    svc #0\n    brk #1\n",
                    write,
                    exit
                )
            },
        })
    }

    // Standard output is one buffer shared by every thread; `_held`
    // routines run with `za_out_lock` taken. On Linux the lock is a futex
    // word (0 free, 1 held, 2 held with waiters); on Darwin it is an
    // os_unfair_lock, whose zero value is its initial state.
    stdout_lock = (self :: @Self) Res<(), AllocError> {
        self.out.add("za_lock_out:\n").try();
        self.address("x0", "za_out_lock").try();
        self.darwin().match({
            true  => self.out.add("    b _os_unfair_lock_lock\n"),
            false => self.out.add(
                "    mov w1, #1\n1:\n    ldaxr w2, [x0]\n    cbnz w2, 2f\n    stxr w3, w1, [x0]\n    cbnz w3, 1b\n    ret\n2:\n    mov w1, #2\n3:\n    ldaxr w2, [x0]\n    stxr w3, w1, [x0]\n    cbnz w3, 3b\n    cbz w2, 4f\n    mov x9, x0\n    mov x1, #128\n    mov x2, #2\n    mov x3, #0\n    mov x8, #98\n    svc #0\n    mov x0, x9\n    b 2b\n4:\n    ret\n"
            ),
        }).try();
        self.out.add("za_unlock_out:\n").try();
        self.address("x0", "za_out_lock").try();
        self.darwin().match({
            true  => self.out.add("    b _os_unfair_lock_unlock\n"),
            false => self.out.add(
                "1:\n    ldxr w1, [x0]\n    stlxr w2, wzr, [x0]\n    cbnz w2, 1b\n    cmp w1, #2\n    b.ne 2f\n    mov x1, #129\n    mov x2, #1\n    mov x8, #98\n    svc #0\n2:\n    ret\n"
            ),
        }).try();
        self.out.add(
            "za_flush:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    bl za_lock_out\n    bl za_flush_held\n    bl za_unlock_out\n    ldp x29, x30, [sp], #16\n    ret\nza_out:\n    stp x29, x30, [sp, #-32]!\n    mov x29, sp\n    stp x0, x1, [sp, #16]\n    bl za_lock_out\n    ldp x0, x1, [sp, #16]\n    bl za_out_held\n    bl za_unlock_out\n    ldp x29, x30, [sp], #32\n    ret\n"
        )
    }

    // Thread start. Every thread begins at `entry(arg)` read from its
    // control block (entry at +8, argument at +16; see std.sys.sys_thread).
    thread_runtime = (self :: @Self) Res<(), AllocError> {
        self.darwin().match({
            // thread_start(x0 block) -> 0 or -errno: pthread_create with an
            // 8 MiB stack, storing the pthread_t at block+32. The C entry
            // point saves the callee-saved registers AAPCS64 lets the Zen
            // code clobber.
            true  => self.out.add(
                "za_d_thread_start:\n    stp x29, x30, [sp, #-96]!\n    mov x29, sp\n    str x19, [sp, #16]\n    mov x19, x0\n    add x0, sp, #32\n    bl _pthread_attr_init\n    cbnz x0, 1f\n    add x0, sp, #32\n    mov x1, #0x800000\n    bl _pthread_attr_setstacksize\n    add x0, x19, #32\n    add x1, sp, #32\n    adrp x2, za_thread_entry@PAGE\n    add x2, x2, za_thread_entry@PAGEOFF\n    mov x3, x19\n    bl _pthread_create\n    mov x19, x0\n    add x0, sp, #32\n    bl _pthread_attr_destroy\n    mov x0, x19\n1:\n    neg x0, x0\n    ldr x19, [sp, #16]\n    ldp x29, x30, [sp], #96\n    ret\nza_thread_entry:\n    stp x29, x30, [sp, #-160]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    stp x21, x22, [sp, #32]\n    stp x23, x24, [sp, #48]\n    stp x25, x26, [sp, #64]\n    stp x27, x28, [sp, #80]\n    stp d8, d9, [sp, #96]\n    stp d10, d11, [sp, #112]\n    stp d12, d13, [sp, #128]\n    stp d14, d15, [sp, #144]\n    ldr x16, [x0, #8]\n    ldr x0, [x0, #16]\n    blr x16\n    ldp x19, x20, [sp, #16]\n    ldp x21, x22, [sp, #32]\n    ldp x23, x24, [sp, #48]\n    ldp x25, x26, [sp, #64]\n    ldp x27, x28, [sp, #80]\n    ldp d8, d9, [sp, #96]\n    ldp d10, d11, [sp, #112]\n    ldp d12, d13, [sp, #128]\n    ldp d14, d15, [sp, #144]\n    mov x0, #0\n    ldp x29, x30, [sp], #160\n    ret\n"
            ),
            // clone(x0 flags, x1 stack top, x2 block): the kernel stores the
            // new thread's id at block+24, clears it and wakes futex waiters
            // when the thread exits, and makes the block the thread's TLS
            // (AArch64 passes tls before the child id). x9 carries the block
            // into the child, which calls entry(arg) and exits alone.
            false => self.out.fmt(
                "za_clone:\n    mov x9, x2\n    add x2, x9, #24\n    mov x3, x9\n    add x4, x9, #24\n    mov x8, #{}\n    svc #0\n    cbz x0, 1f\n    ret\n1:\n    mov x29, #0\n    mov x30, #0\n    ldr x16, [x9, #8]\n    ldr x0, [x9, #16]\n    blr x16\n    mov x0, #0\n    mov x8, #{}\n    svc #0\n    brk #1\n",
                linux_arm64(Sys.Clone).value_or(0),
                LINUX_ARM64_EXIT
            ),
        })
    }

    // Buffered standard output, decimal integers, traps and exit. Routines
    // may clobber caller-saved registers; no value stays live in one.
    runtime = (self :: @Self) Res<(), AllocError> {
        self.out.add(".p2align 2\n").try();
        self.syscalls().try();
        self.out.add("za_exit:\n    str x0, [sp, #-16]!\n").try();
        // exit(x0 status), continued: run the exit hook installed in
        // za_globals, if any, then flush standard output and exit.
        self.address("x9", "za_globals").try();
        self.out.add(
            "    ldr x9, [x9]\n    cbz x9, 1f\n    blr x9\n1:\n    bl za_flush\n    ldr x0, [sp], #16\n    bl za_sys_exit\n"
        ).try();
        self.thread_runtime().try();
        // copy(x0 dest, x1 source, x2 bytes): doublewords, then bytes.
        self.out.add(
            "za_copy:\n    lsr x3, x2, #3\n    cbz x3, 2f\n1:\n    ldr x4, [x1], #8\n    str x4, [x0], #8\n    subs x3, x3, #1\n    b.ne 1b\n2:\n    ands x2, x2, #7\n    b.eq 4f\n3:\n    ldrb w4, [x1], #1\n    strb w4, [x0], #1\n    subs x2, x2, #1\n    b.ne 3b\n4:\n    ret\n"
        ).try();
        // write_all(x0 fd, x1 bytes, x2 length): retry EINTR and short
        // writes; any other failure abandons the remaining bytes.
        self.out.add(
            "za_write_all:\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    str x21, [sp, #32]\n    mov x19, x0\n    mov x20, x1\n    mov x21, x2\n0:\n    cbz x21, 2f\n    mov x0, x19\n    mov x1, x20\n    mov x2, x21\n    bl za_sys_write\n    cmn x0, #4\n    b.eq 0b\n    cmp x0, #0\n    b.le 2f\n    add x20, x20, x0\n    sub x21, x21, x0\n    b 0b\n2:\n    ldp x19, x20, [sp, #16]\n    ldr x21, [sp, #32]\n    ldp x29, x30, [sp], #48\n    ret\n"
        ).try();
        self.stdout_lock().try();
        self.out.add(
            "za_flush_held:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n"
        ).try();
        self.address("x9", "za_out_len").try();
        self.out.add(
            "    ldr x2, [x9]\n    cbz x2, 1f\n    str xzr, [x9]\n    mov x0, #1\n"
        ).try();
        self.address("x1", "za_out_buf").try();
        self.out.add(
            "    bl za_write_all\n1:\n    ldp x29, x30, [sp], #16\n    ret\n"
        ).try();
        // out_held(x0 bytes, x1 length) appends to the stdout buffer. A run
        // larger than the buffer is written through after a flush.
        self.out.add(
            "za_out_held:\n    stp x29, x30, [sp, #-32]!\n    mov x29, sp\n"
        ).try();
        self.address("x9", "za_out_len").try();
        self.out.add(
            "    ldr x3, [x9]\n    add x4, x3, x1\n    mov x5, #65536\n    cmp x4, x5\n    b.ls 1f\n    stp x0, x1, [sp, #16]\n    bl za_flush_held\n    ldp x0, x1, [sp, #16]\n    mov x5, #65536\n    cmp x1, x5\n    b.ls 0f\n    mov x2, x1\n    mov x1, x0\n    mov x0, #1\n    ldp x29, x30, [sp], #32\n    b za_write_all\n0:\n    mov x3, #0\n"
        ).try();
        self.address("x9", "za_out_len").try();
        self.out.add(
            "1:\n    add x4, x3, x1\n    str x4, [x9]\n    mov x2, x1\n    mov x1, x0\n"
        ).try();
        self.address("x0", "za_out_buf").try();
        self.out.add(
            "    add x0, x0, x3\n    ldp x29, x30, [sp], #32\n    b za_copy\n"
        ).try();
        // map(x0 bytes) -> x0: anonymous pages behind a 16-byte header
        // holding the mapping's length; null on failure. unmap(x0).
        self.darwin().match({
            true  => self.out.add(
                "za_map:\n    stp x29, x30, [sp, #-32]!\n    mov x29, sp\n    add x1, x0, #16\n    str x1, [sp, #16]\n    mov x0, #0\n    mov x2, #3\n    movz x3, #0x1002\n    mov x4, #-1\n    mov x5, #0\n    bl _mmap\n    cmn x0, #1\n    b.eq 1f\n    ldr x1, [sp, #16]\n    str x1, [x0]\n    add x0, x0, #16\n    ldp x29, x30, [sp], #32\n    ret\n1:\n    mov x0, #0\n    ldp x29, x30, [sp], #32\n    ret\nza_unmap:\n    cbz x0, 1f\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    sub x0, x0, #16\n    ldr x1, [x0]\n    bl _munmap\n    ldp x29, x30, [sp], #16\n1:\n    ret\n"
            ),
            false => self.out.fmt(
                "za_map:\n    add x1, x0, #16\n    mov x9, x1\n    mov x0, #0\n    mov x2, #3\n    mov x3, #0x22\n    mov x4, #-1\n    mov x5, #0\n    mov x8, #{}\n    svc #0\n    cmn x0, #4095\n    b.hs 1f\n    str x9, [x0]\n    add x0, x0, #16\n    ret\n1:\n    mov x0, #0\n    ret\nza_unmap:\n    cbz x0, 1f\n    sub x0, x0, #16\n    ldr x1, [x0]\n    mov x8, #{}\n    svc #0\n1:\n    ret\n",
                linux_arm64(Sys.Mmap).value_or(0),
                linux_arm64(Sys.Munmap).value_or(0)
            ),
        }).try();
        self.darwin().then(() {
            self.out.add(
                "za_d_openat:\n    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n    sub sp, sp, #16\n    str x3, [sp]\n    bl _openat\n    add sp, sp, #16\n    ldp x29, x30, [sp], #16\n    ret\nza_d_getrandom:\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    stp x19, x20, [sp, #16]\n    str x21, [sp, #32]\n    mov x19, x0\n    mov x20, x1\n    mov x21, #0\n1:\n    cmp x21, x20\n    b.hs 3f\n    sub x1, x20, x21\n    mov x9, #256\n    cmp x1, x9\n    csel x1, x1, x9, ls\n    str x1, [sp, #40]\n    add x0, x19, x21\n    bl _getentropy\n    cbnz x0, 2f\n    ldr x1, [sp, #40]\n    add x21, x21, x1\n    b 1b\n2:\n    bl ___error\n    ldrsw x0, [x0]\n    neg x0, x0\n    b 4f\n3:\n    mov x0, x21\n4:\n    ldp x19, x20, [sp, #16]\n    ldr x21, [sp, #32]\n    ldp x29, x30, [sp], #48\n    ret\n"
            ).try();
        });
        // emit(x0 bytes, x1 length, x2 descriptor): buffered stdout,
        // written-through stderr.
        self.out.add(
            "za_emit:\n    cmp x2, #1\n    b.eq za_out\n    mov x2, x1\n    mov x1, x0\n    mov x0, #2\n    b za_write_all\n"
        ).try();
        // print_i64(x0, x1 descriptor) / print_u64: digits are produced
        // backwards into a stack buffer. Negation of the minimum is exact as
        // unsigned.
        self.out.add(
            "za_print_u64:\n    mov x9, #0\n    b 1f\nza_print_i64:\n    mov x9, x0\n    cmp x0, #0\n    cneg x0, x0, lt\n1:\n    mov x10, x1\n    stp x29, x30, [sp, #-48]!\n    mov x29, sp\n    add x1, sp, #48\n    mov x2, #10\n2:\n    udiv x3, x0, x2\n    msub x4, x3, x2, x0\n    add w4, w4, #48\n    strb w4, [x1, #-1]!\n    mov x0, x3\n    cbnz x0, 2b\n    tbz x9, #63, 3f\n    mov w4, #45\n    strb w4, [x1, #-1]!\n3:\n    add x2, sp, #48\n    sub x2, x2, x1\n    mov x0, x1\n    mov x1, x2\n    mov x2, x10\n    bl za_emit\n    ldp x29, x30, [sp], #48\n    ret\n"
        ).try();
        // trap(x0/x1 report): flush stdout first so output preceding the
        // fault is not lost, then report on stderr and exit 134.
        self.out.add(
            "za_trap:\n    mov x19, x0\n    mov x20, x1\n    bl za_flush\n    mov x0, #2\n    mov x1, x19\n    mov x2, x20\n    bl za_write_all\n    mov x0, #134\n    bl za_sys_exit\n"
        ).try();
        self.data.add(
            "za_true:\n    .ascii \"true\"\nza_false:\n    .ascii \"false\"\n"
        )
    }
}

// The register prefix for a 4- or 8-byte word.
register_width = (ty: Scalar) str {
    (width(ty) == 4).match({ true => "w", false => "x" })
}

descriptor = (stream: Stream) usize { stream.match({ Out => 1, Err => 2 }) }

is_block = (ty: Scalar) bool { ty.match({ Block(_) => true, _ => false }) }

stored_size = (ty: Scalar) usize {
    ty.match({ Block(l) => l.size, _ => 8 })
}

at_least_word = (
    size : usize
) usize { (size < 8).match({ true => 8, false => size }) }

round_up = (value: usize, align: usize) usize {
    ((value + align - 1) / align) * align
}

// The register-extension operand that re-extends a class from its width.
extension = (ty: Scalar) str {
    ty.match({
        I8   => "sxtb",
        U8   => "uxtb",
        Bool => "uxtb",
        I16  => "sxth",
        U16  => "uxth",
        I32  => "sxtw",
        _    => "uxtw",
    })
}

minimum = (ty: Scalar) i64 {
    ty.match({
        I8  => -128,
        I16 => -32768,
        I32 => -2147483648,
        _   => i64.MIN,
    })
}

// The two's-complement bit pattern of a signed value.
bits64 = (value: i64) u64 {
    (value < 0).match({
        true  => u64.MAX - (-(value + 1)).to_usize().value_or(0).to_u64(),
        false => value.to_usize().value_or(0).to_u64(),
    })
}

REGISTER_ARGUMENTS: usize = 8

// Allocatable registers in pool order: caller-saved x4-x7 and x10-x15,
// then callee-saved x19-x28.
register_number = (r: usize) usize {
    (r < 4).match({
        true  => r + 4,
        false => (r < 10).match({ true => r + 6, false => r + 9 }),
    })
}

pool_register = (r: usize) str {
    r.match({
        0  => "x4",
        1  => "x5",
        2  => "x6",
        3  => "x7",
        4  => "x10",
        5  => "x11",
        6  => "x12",
        7  => "x13",
        8  => "x14",
        9  => "x15",
        10 => "x19",
        11 => "x20",
        12 => "x21",
        13 => "x22",
        14 => "x23",
        15 => "x24",
        16 => "x25",
        17 => "x26",
        18 => "x27",
        _  => "x28",
    })
}

// Called only for the register prefix; later arguments use the stack.
argument_register = (index: usize) str {
    index.match({
        0 => "x0",
        1 => "x1",
        2 => "x2",
        3 => "x3",
        4 => "x4",
        5 => "x5",
        6 => "x6",
        _ => "x7",
    })
}

// The 32-bit name of a register.
low32 = (register: str) str {
    register.match({
        "x0"  => "w0",
        "x1"  => "w1",
        "x2"  => "w2",
        "x3"  => "w3",
        "x4"  => "w4",
        "x5"  => "w5",
        "x6"  => "w6",
        "x7"  => "w7",
        "x10" => "w10",
        "x11" => "w11",
        "x12" => "w12",
        "x13" => "w13",
        "x14" => "w14",
        "x15" => "w15",
        "x16" => "w16",
        "x19" => "w19",
        "x20" => "w20",
        "x21" => "w21",
        "x22" => "w22",
        "x23" => "w23",
        "x24" => "w24",
        "x25" => "w25",
        "x26" => "w26",
        "x27" => "w27",
        "x28" => "w28",
        _     => "wzr",
    })
}

// The load or store with an unscaled signed 9-bit offset.
unscaled_form = (mnemonic: str) str {
    mnemonic.match({
        "ldr"   => "ldur",
        "ldrb"  => "ldurb",
        "ldrsb" => "ldursb",
        "ldrh"  => "ldurh",
        "ldrsh" => "ldursh",
        "ldrsw" => "ldursw",
        "str"   => "stur",
        "strb"  => "sturb",
        _       => "sturh",
    })
}

// The condition code for `left op right`, mirrored when the operands were
// exchanged.
condition = (op: Op, is_signed: bool, swapped: bool) str {
    op.match({
        Equal     => "eq",
        NotEqual  => "ne",
        Less      => swapped.match({ false => is_signed.match({ true => "lt", false => "lo" }), true => is_signed.match({ true => "gt", false => "hi" }) }),
        LessEqual => swapped.match({ false => is_signed.match({ true => "le", false => "ls" }), true => is_signed.match({ true => "ge", false => "hs" }) }),
        Greater   => swapped.match({ false => is_signed.match({ true => "gt", false => "hi" }), true => is_signed.match({ true => "lt", false => "lo" }) }),
        _         => swapped.match({ false => is_signed.match({ true => "ge", false => "hs" }), true => is_signed.match({ true => "le", false => "ls" }) }),
    })
}

inverse = (cc: str) str {
    cc.match({
        "eq" => "ne",
        "ne" => "eq",
        "lt" => "ge",
        "ge" => "lt",
        "le" => "gt",
        "gt" => "le",
        "lo" => "hs",
        "hs" => "lo",
        "ls" => "hi",
        _    => "ls",
    })
}
