// Calls for the native lowering: function instances, inlined higher-order
// calls, constructions, compiler-provided operations (loops, loop handles,
// pointers, numeric conversions and bit operations, console output) and
// formatted printing. Every other bodiless declaration is refused.

Alloc, AllocError = std.mem
Vec, Map = std.collections
String, str = std.text
Range = std.core
fmt_at = std.text.text_fmt
decode_literal = std.lex
Ast, ExprId, BlockId, TypeId, Span, Function, Literal, Call, Arg, Param = std.ast
Expr, Lambda, Access, Struct, Member, Impl = std.ast
ImplId = sema.sema
nowhere = std.ast
Checker, DeclId, Def, TyId, Ctx, Inst, decl_at, CheckedCall = sema.sema
subst = sema.sema
Scalar, Op, UnaryOp, Const, Move, Unary, Binary, Invocation, Print = gen.gen_ir
Instruction, Terminator, Convert, Address, Load, Store, CopyMem, StaticBytes = gen.gen_ir
Write, Stream, TrapKind = gen.gen_ir
word, integer, signed, same = gen.gen_ir
LowerError, unsupported = gen.gen_lower
Native, Value, Place, Base, LocalKind, LambdaRef, LoopTarget, Frame, Callee = gen.gen_asm_lower
member_call, mem_call = gen.gen_asm_member
to_i64_bits = gen.gen_asm_lower
Shape, Form, FieldAt, VariantAt, shape, class_of, field_types = gen.gen_asm_shape
variant_index, size_of = gen.gen_asm_shape

// One argument position after binding names and the receiver.
Source* = Given(ExprId) | Absent | Computed(Value) | Located(Place)

// ---------------------------------------------------------------------
// dispatch
// ---------------------------------------------------------------------

call* = (lo :: Native, id: ExprId, c: Call, span: Span) Res<Value, LowerError> {
    callee = lo.stripped(c.callee);
    callee.kind.match({
        Name(n)   => lo.lookup(n.text).match({
            Ok(Closure(lambda)) => {
                args ::= lo.alloc.Vec<Value>();
                c.args.loop((a) { args.add(lo.expr(a.value).try()).try(LowerError.OutOfMemory); });
                lo.inline_lambda(lambda, args, lo.type_of(id).try())
            },
            _                   => lo.named_call(id, c, n.text, span),
        }),
        Access(a) => lo.dot_call(id, c, a, span),
        _         => Err(unsupported(span, "a call through an expression")),
    })
}

stripped = (lo :: Native, id: ExprId) Expr {
    e = lo.tree.expr_at(id);
    e.kind.match({ Paren(p) => lo.stripped(p.inner), _ => e })
}

named_call = (lo :: Native, id: ExprId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    selected = lo.check.checked_call(id);
    resolved = selected.match({
        Ok(checked) => checked.declaration.match({ Ok(_) => true, None => false }),
        None        => false,
    });
    sugar ::= name.is_in(["print", "println"]) && !resolved;
    sugar.then(() {
        defs ::= lo.alloc.Vec<Def>();
        lo.check.world.defs_of(lo.here().module, name, defs).try(LowerError.OutOfMemory);
        sugar = defs.len == 0;
    });
    sugar.match({
        true  => lo.print_call(c.args, 0, name.eq("println"), Stream.Out, span),
        false => selected.match({
            Ok(checked) => checked.declaration.match({
                Ok(_) => lo.checked_invoke(id, c, checked, None, span),
                None  => lo.construction(id, c, name, span),
            }),
            None        => lo.construction(id, c, name, span),
        }),
    })
}

// A call without a checked function: a struct construction or a variant.
construction = (lo :: Native, id: ExprId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    s  = lo.shape(ty).try();
    s.form.match({
        Record(_) => lo.construct_named(ty, c, span),
        _         => lo.variant_call(ty, c, name, span),
    })
}

variant_call = (lo :: Native, ty: TyId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    payload: Res<Value> = c.args.get(0).match({
        None    => None,
        Ok(arg) => {
            variants = lo.variants_of(ty).try();
            index = variant_index(variants, name).ok_or(unsupported(span, "an unknown variant")).try();
            expected = variants.get(index).ok_or(unsupported(span, "a missing variant")).try().payload.ok_or(unsupported(span, "a payload for a payload-free variant")).try();
            Ok(lo.expr_as(arg.value, expected).try())
        },
    });
    lo.variant_value(ty, name, payload, span)
}

dot_call = (lo :: Native, id: ExprId, c: Call, a: Access, span: Span) Res<Value, LowerError> {
    base = lo.tree.expr_at(a.base);
    handle: Res<usize> = base.kind.match({
        Name(n) => lo.lookup(n.text).match({ Ok(Handle(loop_id)) => Ok(loop_id), _ => None }),
        _       => None,
    });
    handle.match({
        Ok(loop_id) => lo.handle_call(loop_id, a.name.text, c, span),
        None        => {
            type_base = base.kind.match({
                Name(n) => lo.lookup(n.text).match({
                    Ok(_) => false,
                    None  => lo.names_type(n.text),
                }),
                _       => false,
            });
            selected = lo.check.checked_call(id);
            declared = selected.match({
                Ok(checked) => checked.declaration.match({ Ok(_) => true, None => false }),
                None        => false,
            });
            (type_base && !declared).match({
                // `Type.Variant(payload)` or a construction through a type.
                true  => {
                    ty = lo.type_of(id).try();
                    s  = lo.shape(ty).try();
                    s.form.match({
                        Record(_) => lo.construct_named(ty, c, span),
                        _         => lo.variant_call(ty, c, a.name.text, span),
                    })
                },
                false => {
                    checked = selected.ok_or(unsupported(span, "a call without successful semantic checking")).try();
                    receiver: Res<ExprId> = type_base.match({ true => None, false => Ok(a.base) });
                    lo.checked_invoke(id, c, checked, receiver, span)
                },
            })
        },
    })
}

// ---------------------------------------------------------------------
// checked calls
// ---------------------------------------------------------------------

checked_invoke = (lo :: Native, id: ExprId, c: Call, checked: CheckedCall,
                  dot_receiver: Res<ExprId>, span: Span) Res<Value, LowerError> {
    signature_receiver: Res<ExprId> = checked.signature.match({
        Ok(sig) => sig.receiver,
        None    => None,
    });
    checked.declaration.match({
        Ok(decl_id) => {
            decl = decl_at(lo.tree, decl_id).ok_or(unsupported(span, "a missing callee")).try();
            decl.kind.match({
                Function(f) => {
                    // A dot call on a value passes that value first unless
                    // sema resolved it as a static member.
                    recv = signature_receiver.match({
                        Ok(r) => Ok(r),
                        None  => dot_receiver.match({
                            Ok(r) => (f.params.len == c.args.len + 1).match({ true => Ok(r), false => None }),
                            None  => None,
                        }),
                    });
                    callee = Callee(
                        f: f,
                        owner: decl_id,
                        member: None,
                        module: decl_id.module.to_usize(),
                        inst: lo.call_inst(checked.inst).try(),
                        self_ty: None,
                        generic_owner: None
                    );
                    sources = lo.bind_sources(f, c, recv, span).try();
                    lo.invoke(id, callee, sources, c, span)
                },
                Struct(_)   => {
                    ty = lo.type_of(id).try();
                    lo.construct_named(ty, c, span)
                },
                _           => Err(unsupported(span, "a call to this kind of declaration")),
            })
        },
        None        => {
            receiver = signature_receiver.match({ Ok(r) => Ok(r), None => dot_receiver })
                .ok_or(unsupported(span, "a member call without a receiver")).try();
            name = lo.stripped(c.callee).kind.match({ Access(a) => a.name.text, _ => "" });
            lo.member_call(id, c, checked, receiver, name, span)
        },
    })
}

// Run a resolved callee: compiler-provided bodiless operations, inlined
// closure-taking bodies, or a call to a real function instance.
invoke* = (lo :: Native, id: ExprId, callee: Callee, written: Vec<Source>, c: Call, span: Span)
          Res<Value, LowerError> {
    sources = callee.f.body.match({
        None  => written,
        Ok(_) => lo.in_written_order(callee, written, c).try(),
    });
    callee.f.body.match({
        None    => lo.intrinsic(id, callee, sources, c, span),
        Ok(_)   => lo.higher_order(callee.f).match({
            true  => lo.inline_call(callee, sources, span),
            false => lo.real_call(callee, sources, span),
        }),
    })
}

// The call's substitution with the caller's own parameters resolved.
call_inst* = (lo :: Native, raw: Inst) Res<Inst, LowerError> {
    inst ::= lo.alloc.Inst();
    Range(0, raw.len()).loop((i) {
        v = raw.var_at(i).ok_or(unsupported(nowhere(), "a malformed instantiation")).try();
        a = raw.arg_at(i).ok_or(unsupported(nowhere(), "a malformed instantiation")).try();
        inst.bind(v, lo.concrete(a).try()).try(LowerError.OutOfMemory);
    });
    Ok(inst)
}

// Arguments in parameter order: the receiver first, then positional
// arguments, named arguments by name; omitted trailing parameters stay
// Absent (a Res parameter then receives None).
bind_sources* = (lo :: Native, f: Function, c: Call, receiver: Res<ExprId>, span: Span)
                Res<Vec<Source>, LowerError> {
    out ::= lo.alloc.Vec<Source>();
    f.params.loop((_) { out.add(Source.Absent).try(LowerError.OutOfMemory); });
    next ::= 0;
    receiver.when_ok((r) {
        out.set(0, Source.Given(r));
        next = 1;
    });
    c.args.loop((a) {
        a.name.match({
            None    => {
                (next < out.len).ensure(unsupported(a.span, "more arguments than parameters")).try();
                out.set(next, Source.Given(a.value));
                next = next + 1;
            },
            Ok(name) => {
                found: Res<usize> = loop<usize>((h) {
                    f.params.loop((ph, i, p) { p.name.text.eq(name.text).then(() { h.break(i); }); });
                    h.break();
                });
                index = found.ok_or(unsupported(a.span, "a named argument without a parameter")).try();
                out.set(index, Source.Given(a.value));
            },
        });
    });
    Ok(out)
}

// By-value arguments evaluate in the order they are written (the receiver
// first), whatever order their parameters have.
in_written_order = (lo :: Native, callee: Callee, sources: Vec<Source>, c: Call)
                   Res<Vec<Source>, LowerError> {
    out ::= lo.alloc.Vec<Source>();
    sources.loop((s) { out.add(s).try(LowerError.OutOfMemory); });
    order ::= lo.alloc.Vec<ExprId>();
    // The receiver, when present, is the first argument not written in
    // the parentheses.
    sources.loop((s) {
        s.match({
            Given(e) => c.args.find((a) { a.value == e }).match({
                None    => order.add(e).try(LowerError.OutOfMemory),
                Ok(_)   => (),
            }),
            _        => (),
        });
    });
    c.args.loop((a) { order.add(a.value).try(LowerError.OutOfMemory); });
    order.loop((e) {
        source_index(sources, e).when_ok((i) {
            p = callee.f.params.get(i).ok_or(unsupported(nowhere(), "a missing parameter")).try();
            ty = lo.param_type(callee, i).try();
            special = lo.is_fn_type(ty) || lo.is_capability(ty);
            (!special).then(() {
                p.mutable.match({
                    // A place is resolved now; a temporary is computed now.
                    true  => lo.place_of(e).try().match({
                        Ok(place) => { out.set(i, Source.Located(place)); },
                        None      => { out.set(i, Source.Computed(lo.expr_as(e, ty).try())); },
                    }),
                    false => { out.set(i, Source.Computed(lo.expr_as(e, ty).try())); },
                });
            });
        });
    });
    Ok(out)
}

field_index = (fields: Vec<FieldAt>, name: str) Res<usize> {
    found: Res<usize> = loop<usize>((h) {
        fields.loop((fh, i, f) { f.name.eq(name).then(() { h.break(i); }); });
        h.break();
    });
    found
}

source_index = (sources: Vec<Source>, e: ExprId) Res<usize> {
    found: Res<usize> = loop<usize>((h) {
        sources.loop((sh, i, s) {
            s.match({ Given(g) => (g == e).then(() { h.break(i); }), _ => Ok(()) });
        });
        h.break();
    });
    found
}

// A callee taking a closure is inlined so the closure's `.try()` and
// `h.break()` keep their meaning.
higher_order = (lo :: Native, f: Function) bool {
    f.params.find((p) {
        p.type.match({
            Ok(t) => lo.tree.type_at(t).kind.match({ Fn(_) => true, _ => false }),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

param_type* = (lo :: Native, callee: Callee, i: usize) Res<TyId, LowerError> {
    p = callee.f.params.get(i).ok_or(unsupported(nowhere(), "a missing parameter")).try();
    t = p.type.ok_or(unsupported(p.span, "an inferred parameter type")).try();
    lo.callee_type(callee, t)
}

result_type* = (lo :: Native, callee: Callee) Res<TyId, LowerError> {
    callee.f.ret.match({
        None    => Ok(lo.unit_ty),
        Ok(t)   => lo.callee_type(callee, t),
    })
}

// Evaluate one argument for a by-value parameter.
argument_value* = (lo :: Native, source: Source, ty: TyId, span: Span) Res<Value, LowerError> {
    source.match({
        Given(e)    => lo.expr_as(e, ty),
        Absent      => lo.variant_value(ty, "None", None, span),
        Computed(v) => lo.coerce(v, ty),
        Located(p)  => lo.coerce(lo.read(p).try(), ty),
    })
}

// A mutable parameter aliases the caller's place; a temporary gets one.
argument_place* = (lo :: Native, source: Source, ty: TyId, span: Span) Res<Place, LowerError> {
    source.match({
        Computed(v) => Ok(lo.spill(lo.copy_value(v).try())),
        Located(p)  => Ok(p),
        Absent      => Err(unsupported(span, "an omitted mutable argument")),
        Given(e)    => lo.place_of(e).try().match({
            Ok(place) => Ok(place),
            None      => {
                value = lo.expr_as(e, ty).try();
                Ok(lo.spill(value))
            },
        }),
    })
}

real_call* = (lo :: Native, callee: Callee, sources: Vec<Source>, span: Span)
             Res<Value, LowerError> {
    index = lo.enqueue(callee).try();
    args ::= lo.alloc.Vec<usize>();
    callee.f.params.loop((h, i, p) {
        ty = lo.param_type(callee, i).try();
        source = sources.get(i).value_or(Source.Absent);
        slot = p.mutable.match({
            true  => lo.address(lo.argument_place(source, ty, span).try()).try(),
            false => lo.argument_value(source, ty, span).try().slot,
        });
        args.add(slot).try(LowerError.OutOfMemory);
    });
    ret = lo.result_type(callee).try();
    out = lo.temp(ret).try();
    lo.add(Instruction.Invoke(Invocation(out: out.slot, function: index, args: args))).try();
    Ok(out)
}

// Inline a callee body: closure parameters bind the caller's lambdas,
// mutable parameters alias the caller's places.
inline_call* = (lo :: Native, callee: Callee, sources: Vec<Source>, span: Span)
               Res<Value, LowerError> {
    (lo.depth < 24).ensure(unsupported(span, "recursion through closure-taking functions")).try();
    body = callee.f.body.ok_or(unsupported(span, "a bodiless callee")).try();
    kinds ::= lo.alloc.Vec<LocalKind>();
    callee.f.params.loop((h, i, p) {
        ty = lo.param_type(callee, i).try();
        source = sources.get(i).value_or(Source.Absent);
        kind = lo.is_fn_type(ty).match({
            true  => LocalKind.Closure(lo.closure_of(source, span).try()),
            false => lo.is_capability(ty).match({
                true  => LocalKind.Capability(ty),
                false => p.mutable.match({
                    true  => LocalKind.Ref(lo.argument_place(source, ty, span).try()),
                    false => {
                        value = lo.argument_value(source, ty, span).try();
                        LocalKind.Direct(lo.copy_value(value).try())
                    },
                }),
            }),
        });
        kinds.add(kind).try(LowerError.OutOfMemory);
    });
    ret = lo.result_type(callee).try();
    frame = lo.push_frame(callee.inst, callee.module, ret, callee.self_ty, Ok(callee)).try();
    saved = lo.use_frame(frame);
    lo.deeper();
    mark = lo.locals.len;
    callee.f.params.loop((h, i, p) {
        kinds.get(i).when_ok((k) { lo.bind_local(p.name.text, k).try(); });
    });
    value = lo.block(body).try();
    here = lo.here();
    coerced = lo.coerce(value, ret).try();
    lo.add(Instruction.Copy(Move(out: here.ret_slot, source: coerced.slot))).try();
    lo.enter(here.ret_block).try();
    lo.release_locals(mark);
    lo.shallower();
    lo.use_frame(saved);
    result = Value(slot: here.ret_slot, ty: ret);
    lo.copy_value(result)
}

is_fn_type = (lo :: Native, ty: TyId) bool {
    lo.check.types.at(ty).match({ Fn(_) => true, _ => false })
}

closure_of = (lo :: Native, source: Source, span: Span) Res<LambdaRef, LowerError> {
    e = source.match({ Given(e) => Ok(e), _ => None })
        .ok_or(unsupported(span, "an omitted closure argument")).try();
    node = lo.stripped(e);
    node.kind.match({
        Lambda(_) => Ok(LambdaRef(expr: e.unparen(lo), frame: lo.frame)),
        Name(n)   => lo.lookup(n.text).match({
            Ok(Closure(l)) => Ok(l),
            _              => Err(unsupported(node.span, "a named function passed as a closure")),
        }),
        _         => Err(unsupported(node.span, "a computed closure argument")),
    })
}

unparen = (id: ExprId, lo :: Native) ExprId {
    lo.tree.expr_at(id).kind.match({ Paren(p) => p.inner.unparen(lo), _ => id })
}

// ---------------------------------------------------------------------
// constructions
// ---------------------------------------------------------------------

// `Record(name: value, ..)` with written defaults for omitted fields.
construct_named* = (lo :: Native, ty: TyId, c: Call, span: Span) Res<Value, LowerError> {
    out = lo.temp(ty).try();
    s = lo.shape(ty).try();
    fields = s.form.match({ Record(f) => Ok(f), _ => None })
        .ok_or(unsupported(span, "a construction of a non-record type")).try();
    decl = lo.struct_decl(ty).try();
    base = lo.slot_of(Scalar.Ptr).try();
    // Arguments evaluate in written order; omitted fields then take their
    // defaults in declaration order.
    given ::= lo.alloc.Vec<Res<Value>>();
    fields.loop((_) { given.add(None).try(LowerError.OutOfMemory); });
    c.args.loop((h, i, a) {
        index = a.name.match({
            Ok(n) => field_index(fields, n.text),
            None  => Ok(i),
        }).ok_or(unsupported(a.span, "an argument naming no field")).try();
        field = fields.get(index).ok_or(unsupported(a.span, "more arguments than fields")).try();
        given.set(index, Ok(lo.expr_as(a.value, field.ty).try()));
    });
    fields.loop((h, i, field) {
        value = given.get(i).value_or(None).match({
            Ok(v) => v,
            None  => lo.field_default(decl, ty, field, span).try(),
        });
        lo.add(Instruction.AddressOf(Address(out: base, slot: out.slot))).try();
        lo.add(Instruction.StoreValue(Store(base: base, offset: field.offset, value: value.slot))).try();
    });
    Ok(out)
}

StructDecl = { id: DeclId, s: Struct }

struct_decl = (lo :: Native, ty: TyId) Res<StructDecl, LowerError> {
    lo.check.types.at(ty).match({
        Named(n) => decl_at(lo.tree, n.decl).match({
            Ok(d) => d.kind.match({
                Struct(s) => Ok(StructDecl(id: n.decl, s: s)),
                _         => Err(unsupported(nowhere(), "a construction of a non-struct")),
            }),
            None  => Err(unsupported(nowhere(), "a missing struct declaration")),
        }),
        _        => Err(unsupported(nowhere(), "a construction of a non-named type")),
    })
}

// An omitted field takes its written default, evaluated in the declaring
// module; an omitted Res field is None.
field_default = (lo :: Native, decl: StructDecl, ty: TyId, field: FieldAt, span: Span)
                Res<Value, LowerError> {
    written: Res<ExprId> = decl.s.members.find((m) { m.named(field.name) }).match({
        Ok(m) => m.kind.match({ Field(f) => f.value, _ => None }),
        None  => None,
    });
    written.match({
        Ok(e) => {
            inst = lo.check.types.at(ty).match({
                Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
                _        => lo.alloc.Inst(),
            });
            frame = lo.push_frame(inst, decl.id.module.to_usize(), lo.unit_ty, Ok(ty), None).try();
            saved = lo.use_frame(frame);
            value = lo.expr_as(e, field.ty);
            lo.use_frame(saved);
            value
        },
        None  => lo.variant_value(field.ty, "None", None, span),
    })
}

// ---------------------------------------------------------------------
// compiler-provided operations
// ---------------------------------------------------------------------

intrinsic = (lo :: Native, id: ExprId, callee: Callee, sources: Vec<Source>, c: Call, span: Span)
            Res<Value, LowerError> {
    decl = callee.owner;
    module = lo.check.world.module_name(decl);
    name = callee.f.name.text;
    // Numeric operations are free functions validated by declaration.
    numeric = callee.member.match({ None => true, Ok(_) => false });
    conversion = numeric.match({ true => lo.check.numeric_conversions.get(decl), false => None });
    bits = numeric.match({ true => lo.check.integer_bits.get(decl), false => None });
    conversion.match({
        Ok(_) => lo.conversion(id, sources, span),
        None  => bits.match({
            Ok(b) => lo.bit_operation(id, b.name, sources, span),
            None  => module.match({
                "std.core.loop.loop_iter"   => lo.loop_call(id, callee.f, sources, span),
                "std.mem.mem_ptr"           => lo.pointer_call(id, name, sources, span),
                "std.env.env"               => lo.env_call(id, name, c, sources, span),
                "std.mem.mem_arena"         => lo.mem_call(id, name, sources, span),
                _                           => Err(unsupported(span, lo.alloc.String("the compiler-provided operation `{}.{}`", module, name).match({ Ok(t) => t.view(), Err(_) => "a compiler-provided operation" }))),
            }),
        }),
    })
}

source_expr* = (sources: Vec<Source>, i: usize, span: Span) Res<ExprId, LowerError> {
    sources.get(i).value_or(Source.Absent).match({
        Given(e) => Ok(e),
        _        => Err(unsupported(span, "an omitted argument")),
    })
}

conversion = (lo :: Native, id: ExprId, sources: Vec<Source>, span: Span) Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    arg = lo.expr(sources.source_expr(0, span).try()).try();
    lo.check.types.at(ty).match({
        Res(r) => {
            target = lo.concrete(r.value).try();
            converted = lo.temp(target).try();
            lo.add(Instruction.Cast(Convert(out: converted.slot, input: arg.slot))).try();
            // Checked: the value fits when converting back reproduces it.
            back = lo.temp(arg.ty).try();
            lo.add(Instruction.Cast(Convert(out: back.slot, input: converted.slot))).try();
            fits = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: fits, left: back.slot, right: arg.slot, op: Op.Equal, span: nowhere()))).try();
            same_sign = lo.sign_agrees(arg, converted).try();
            both = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: both, left: fits, right: same_sign, op: Op.And, span: nowhere()))).try();
            out = lo.temp(ty).try();
            yes  = lo.label().try();
            no   = lo.label().try();
            done = lo.label().try();
            lo.branch_to(both, yes, no).try();
            lo.start(yes);
            ok = lo.variant_value(ty, "Ok", Ok(converted), span).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: ok.slot))).try();
            lo.jump(done).try();
            lo.start(no);
            none = lo.variant_value(ty, "None", None, span).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: none.slot))).try();
            lo.enter(done).try();
            Ok(out)
        },
        _      => {
            out = lo.temp(ty).try();
            lo.add(Instruction.Cast(Convert(out: out.slot, input: arg.slot))).try();
            Ok(out)
        },
    })
}

// A signed negative never fits an unsigned target and an unsigned value
// above the signed maximum never fits a signed one; comparing the signs of
// source and result catches both after a round trip.
sign_agrees = (lo :: Native, from: Value, to: Value) Res<usize, LowerError> {
    from_signed = signed(lo.class_of(from.ty).try());
    to_signed = signed(lo.class_of(to.ty).try());
    (from_signed == to_signed).match({
        true  => lo.word_const(Scalar.Bool, 1),
        false => {
            // The source must be non-negative when read as signed.
            zero_from = lo.temp(from.ty).try();
            lo.add(Instruction.Constant(Const(out: zero_from.slot, value: 0))).try();
            signed_value = from_signed.match({ true => from, false => to });
            zero = lo.temp(signed_value.ty).try();
            lo.add(Instruction.Constant(Const(out: zero.slot, value: 0))).try();
            test = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: test, left: signed_value.slot, right: zero.slot, op: Op.GreaterEqual, span: nowhere()))).try();
            Ok(test)
        },
    })
}

bit_operation = (lo :: Native, id: ExprId, name: str, sources: Vec<Source>, span: Span)
                Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    left = lo.expr_as(sources.source_expr(0, span).try(), ty).try();
    count_ty = name.is_in(["bit_xor", "bit_and"]).match({ true => ty, false => lo.prim("usize").try() });
    right = lo.expr_as(sources.source_expr(1, span).try(), count_ty).try();
    op = name.match({
        "bit_xor"      => Op.Xor,
        "bit_and"      => Op.And,
        "rotate_right" => Op.Rotr,
        _              => Op.Shr,
    });
    out = lo.temp(ty).try();
    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: left.slot, right: right.slot, op: op, span: span))).try();
    Ok(out)
}

// Ptr<T> operations. Element sizes come from T at this instantiation.
pointer_call = (lo :: Native, id: ExprId, name: str, sources: Vec<Source>, span: Span)
               Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    name.match({
        "null_ptr" => lo.constant(ty, 0),
        _          => {
            receiver = lo.expr(sources.source_expr(0, span).try()).try();
            elem = lo.pointee(receiver.ty).try();
            stride = lo.element_size(elem).try();
            name.match({
                "read"      => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    lo.read(Place(base: Base.Through(at), offset: 0, ty: elem))
                },
                "write"     => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    value = lo.expr_as(sources.source_expr(2, span).try(), elem).try();
                    lo.write(Place(base: Base.Through(at), offset: 0, ty: elem), value).try();
                    lo.unit()
                },
                "offset"    => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    Ok(Value(slot: at, ty: ty))
                },
                "back"      => {
                    count = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: bytes, op: Op.WrapSub, span: nowhere()))).try();
                    Ok(out)
                },
                "bytes"     => {
                    count = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    Ok(Value(slot: bytes, ty: ty))
                },
                "copy_from" => {
                    source = lo.expr(sources.source_expr(1, span).try()).try();
                    count = lo.expr_as(sources.source_expr(2, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    lo.add(Instruction.CopyBytes(CopyMem(dest: receiver.slot, source: source.slot, bytes: bytes))).try();
                    lo.unit()
                },
                "to"        => Ok(Value(slot: receiver.slot, ty: ty)),
                "is_null"   => {
                    zero = lo.word_const(Scalar.Ptr, 0).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: zero, op: Op.Equal, span: nowhere()))).try();
                    Ok(out)
                },
                "same"      => {
                    other = lo.expr(sources.source_expr(1, span).try()).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: other.slot, op: Op.Equal, span: nowhere()))).try();
                    Ok(out)
                },
                _           => Err(unsupported(span, "this pointer operation")),
            })
        },
    })
}

pointee = (lo :: Native, ty: TyId) Res<TyId, LowerError> {
    lo.check.types.at(ty).match({
        Named(n) => n.args.get(0).ok_or(unsupported(nowhere(), "a Ptr without an element type")),
        _        => Err(unsupported(nowhere(), "a pointer operation on a non-pointer")),
    })
}

element_size = (lo :: Native, ty: TyId) Res<usize, LowerError> {
    class = lo.class_of(ty).try();
    Ok(size_of(class))
}

scaled = (lo :: Native, count: usize, stride: usize) Res<usize, LowerError> {
    (stride == 1).match({
        true  => Ok(count),
        false => {
            factor = lo.word_const(Scalar.U64, stride.to_i64_bits()).try();
            out = lo.slot_of(Scalar.U64).try();
            lo.add(Instruction.BinaryValue(Binary(out: out, left: count, right: factor, op: Op.WrapMul, span: nowhere()))).try();
            Ok(out)
        },
    })
}

element_at = (lo :: Native, pointer: Value, sources: Vec<Source>, stride: usize, span: Span)
             Res<usize, LowerError> {
    index = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
    bytes = lo.scaled(index.slot, stride).try();
    out = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.BinaryValue(Binary(out: out, left: pointer.slot, right: bytes, op: Op.WrapAdd, span: nowhere()))).try();
    Ok(out)
}

// Console and environment operations supplied by the runtime.
env_call = (lo :: Native, id: ExprId, name: str, c: Call, sources: Vec<Source>, span: Span)
           Res<Value, LowerError> {
    name.match({
        "println" => lo.print_call(c.args, 0, true, Stream.Out, span),
        "error"   => lo.print_call(c.args, 0, false, Stream.Err, span),
        "errorln" => lo.print_call(c.args, 0, true, Stream.Err, span),
        "flush"   => {
            ty = lo.type_of(id).try();
            lo.variant_value(ty, "Ok", Ok(lo.unit().try()), span)
        },
        _         => Err(unsupported(span, "this environment operation")),
    })
}

// ---------------------------------------------------------------------
// loops
// ---------------------------------------------------------------------

// The loop overloads: the body's parameter list selects the form.
loop_call = (lo :: Native, id: ExprId, f: Function, sources: Vec<Source>, span: Span)
            Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    result = lo.temp(ty).try();
    none = lo.variant_value(ty, "None", None, span).try();
    lo.add(Instruction.Copy(Move(out: result.slot, source: none.slot))).try();
    body_index = f.params.len - 1;
    body = lo.closure_of(sources.get(body_index).value_or(Source.Absent), span).try();
    body_params = lo.lambda_params(body).try();
    brk  = lo.label().try();
    next = lo.label().try();
    top  = lo.label().try();
    loop_id = lo.loops.len;
    lo.loops.add(LoopTarget(brk: brk, next: next, result: Ok(result))).try(LowerError.OutOfMemory);
    first = f.params.get(0).ok_or(unsupported(span, "a loop without parameters")).try();
    first_name = first.name.text;
    (f.params.len < 3).ensure(unsupported(span, "folding loops")).try();
    (f.params.len == 1).match({
        // loop((h) {..}) or loop((h, index) {..})
        true  => {
            index = lo.word_const(Scalar.U64, 0).try();
            lo.enter(top).try();
            args ::= lo.alloc.Vec<Value>();
            (body_params > 1).then(() {
                args.add(Value(slot: index, ty: lo.prim("usize").try())).try(LowerError.OutOfMemory);
            });
            lo.run_body(body, loop_id, args).try();
            lo.enter(next).try();
            one = lo.word_const(Scalar.U64, 1).try();
            lo.add(Instruction.BinaryValue(Binary(out: index, left: index, right: one, op: Op.WrapAdd, span: nowhere()))).try();
            lo.jump(top).try();
        },
        false => first_name.match({
            "cond"  => {
                lo.enter(top).try();
                condition = lo.condition(sources.get(0).value_or(Source.Absent), span).try();
                pass = lo.label().try();
                lo.branch_to(condition, pass, brk).try();
                lo.start(pass);
                lo.run_body(body, loop_id, lo.alloc.Vec<Value>()).try();
                lo.enter(next).try();
                lo.jump(top).try();
            },
            _       => lo.range_loop(sources, body, body_params, loop_id, top, next, brk, span).try(),
        }),
    });
    lo.start(brk);
    lo.loops.take(lo.loops.len - 1);
    Ok(result)
}

lambda_params = (lo :: Native, lambda: LambdaRef) Res<usize, LowerError> {
    lo.tree.expr_at(lambda.expr).kind.match({
        Lambda(l) => Ok(l.params.len),
        _         => Err(unsupported(nowhere(), "a loop body that is not a lambda")),
    })
}

// `cond` is a closure evaluated each pass, or a boolean place re-read.
condition = (lo :: Native, source: Source, span: Span) Res<usize, LowerError> {
    e = source.match({ Given(e) => Ok(e), _ => None }).ok_or(unsupported(span, "a loop without a condition")).try();
    node = lo.stripped(e);
    bool_ty = lo.prim("bool").try();
    node.kind.match({
        Lambda(_) => Ok(lo.inline_lambda(LambdaRef(expr: e.unparen(lo), frame: lo.frame), lo.alloc.Vec<Value>(), bool_ty).try().slot),
        _         => Ok(lo.expr_as(e, bool_ty).try().slot),
    })
}

// The body runs with its handle bound to this loop.
run_body = (lo :: Native, body: LambdaRef, loop_id: usize, values: Vec<Value>)
           Res<(), LowerError> {
    l = lo.tree.expr_at(body.expr).kind.match({ Lambda(l) => Ok(l), _ => None })
        .ok_or(unsupported(nowhere(), "a loop body that is not a lambda")).try();
    saved = lo.use_frame(body.frame);
    mark = lo.locals.len;
    // The first parameter is the handle unless the form passes values only.
    handles = l.params.len > values.len;
    l.params.loop((h, i, p) {
        (handles && i == 0).match({
            true  => lo.bind_local(p.name.text, LocalKind.Handle(loop_id)).try(),
            false => {
                at = handles.match({ true => i - 1, false => i });
                values.get(at).when_ok((v) {
                    copy = lo.copy_value(v).try();
                    lo.bind_local(p.name.text, LocalKind.Direct(copy)).try();
                });
            },
        });
    });
    lo.block(l.body).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    Ok(())
}

// Walk [start, end) of a Range, a fixed array, or a type implementing
// Range whose `at` supplies each value.
range_loop = (lo :: Native, sources: Vec<Source>, body: LambdaRef, body_params: usize,
              loop_id: usize, top: usize, next: usize, brk: usize, span: Span)
             Res<(), LowerError> {
    range_expr = sources.source_expr(0, span).try();
    range = lo.expr(range_expr).try();
    usize_ty = lo.prim("usize").try();
    s = lo.shape(range.ty).try();
    walk: Walk = s.form.match({
        Array(elements) => Walk(
            start: lo.word_const(Scalar.U64, 0).try(),
            end: lo.word_const(Scalar.U64, elements.count.to_i64_bits()).try(),
            kind: WalkKind.Elements
        ),
        _               => lo.range_bounds(range, span).try(),
    });
    index = lo.copy_slot(walk.start).try();
    // The pass count starts at zero whatever the range's start.
    count = lo.word_const(Scalar.U64, 0).try();
    pass = lo.label().try();
    lo.enter(top).try();
    more = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: more, left: index, right: walk.end, op: Op.Less, span: nowhere()))).try();
    lo.branch_to(more, pass, brk).try();
    lo.start(pass);
    position = Value(slot: index, ty: usize_ty);
    value = walk.kind.match({
        Elements  => {
            place = lo.element_place(range, index).try();
            lo.read(place).try()
        },
        Indices   => lo.copy_value(position).try(),
        At(at)    => lo.at_value(range, at, position, brk, span).try(),
    });
    args ::= lo.alloc.Vec<Value>();
    (body_params >= 3).then(() { args.add(Value(slot: count, ty: usize_ty)).try(LowerError.OutOfMemory); });
    args.add(value).try(LowerError.OutOfMemory);
    lo.run_body(body, loop_id, args).try();
    lo.enter(next).try();
    one = lo.word_const(Scalar.U64, 1).try();
    lo.add(Instruction.BinaryValue(Binary(out: index, left: index, right: one, op: Op.WrapAdd, span: nowhere()))).try();
    lo.add(Instruction.BinaryValue(Binary(out: count, left: count, right: one, op: Op.WrapAdd, span: nowhere()))).try();
    lo.jump(top)
}

WalkKind = Elements | Indices | At(AtHook)
AtHook = { decl: DeclId, f: Function, impl_module: usize }
Walk = { start: usize, end: usize, kind: WalkKind }

copy_slot = (lo :: Native, slot: usize) Res<usize, LowerError> {
    out = lo.slot_of(lo.slots.get(slot).value_or(Scalar.U64)).try();
    lo.add(Instruction.Copy(Move(out: out, source: slot))).try();
    Ok(out)
}

element_place = (lo :: Native, array: Value, index: usize) Res<Place, LowerError> {
    s = lo.shape(array.ty).try();
    elements = s.form.match({ Array(e) => Ok(e), _ => None }).ok_or(unsupported(nowhere(), "an array walk")).try();
    base = lo.address(lo.spill(array)).try();
    stride = lo.word_const(Scalar.U64, elements.stride.to_i64_bits()).try();
    offset = lo.slot_of(Scalar.U64).try();
    lo.add(Instruction.BinaryValue(Binary(out: offset, left: index, right: stride, op: Op.WrapMul, span: nowhere()))).try();
    at = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.BinaryValue(Binary(out: at, left: base, right: offset, op: Op.WrapAdd, span: nowhere()))).try();
    Ok(Place(base: Base.Through(at), offset: 0, ty: elements.elem))
}

// A Range record reads its fields; another type supplies start/end/at
// through its Range impl.
range_bounds = (lo :: Native, range: Value, span: Span) Res<Walk, LowerError> {
    qualified = lo.qualified_name(range.ty);
    qualified.eq("std.core.range.Range").match({
        true  => {
            place = lo.spill(range);
            start = lo.read(lo.field_place(place, "start", span).try()).try();
            end   = lo.read(lo.field_place(place, "end", span).try()).try();
            Ok(Walk(start: start.slot, end: end.slot, kind: WalkKind.Indices))
        },
        false => lo.impl_bounds(range, span),
    })
}

qualified_name* = (lo :: Native, ty: TyId) str {
    lo.check.types.at(ty).match({
        Named(n) => lo.alloc.String("{}.{}", lo.check.world.module_name(n.decl), n.name).match({
            Ok(s)  => s.view(),
            Err(_) => "",
        }),
        _        => "",
    })
}

impl_bounds = (lo :: Native, range: Value, span: Span) Res<Walk, LowerError> {
    target = lo.type_name(range.ty);
    ids ::= lo.alloc.Vec<ImplId>();
    lo.check.world.impls_named(lo.tree, target, ids).try(LowerError.OutOfMemory);
    found: Res<Impl> = loop<Impl>((h) {
        ids.loop((id) {
            lo.check.world.impl_at(lo.tree, id).when_ok((i) {
                bound = lo.tree.type_at(i.bound).kind.match({ Named(n) => n.name.text, _ => "" });
                bound.eq("Range").then(() { h.break(i); });
            });
        });
        h.break();
    });
    impl = found.ok_or(unsupported(span, "a loop over a type without a Range impl")).try();
    start_expr = impl.field_value("start").ok_or(unsupported(span, "a Range impl without start")).try();
    end_expr = impl.field_value("end").ok_or(unsupported(span, "a Range impl without end")).try();
    at = impl.bodied_fn("at").ok_or(unsupported(span, "a Range impl without at")).try();
    impl_decl = ids.find((id) {
        lo.check.world.impl_at(lo.tree, id).match({
            Ok(i) => lo.tree.type_at(i.bound).kind.match({ Named(n) => n.name.text.eq("Range"), _ => false }),
            None  => false,
        })
    }).ok_or(unsupported(span, "a missing Range impl")).try();
    module = impl_decl.decl.module.to_usize();
    // The impl's field expressions read `self`.
    inst = lo.check.types.at(range.ty).match({
        Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
        _        => lo.alloc.Inst(),
    });
    frame = lo.push_frame(inst, module, lo.unit_ty, Ok(range.ty), None).try();
    saved = lo.use_frame(frame);
    mark = lo.locals.len;
    lo.bind_local("self", LocalKind.Direct(range)).try();
    usize_ty = lo.prim("usize").try();
    start = lo.expr_as(start_expr, usize_ty).try();
    end = lo.expr_as(end_expr, usize_ty).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    Ok(Walk(
        start: start.slot,
        end: end.slot,
        kind: WalkKind.At(AtHook(decl: impl_decl.decl, f: at, impl_module: module))
    ))
}

// One pass's value from the impl's `at`; None ends the walk.
at_value = (lo :: Native, range: Value, hook: AtHook, index: Value, brk: usize, span: Span)
           Res<Value, LowerError> {
    body = hook.f.body.ok_or(unsupported(span, "a bodiless at")).try();
    inst = lo.check.types.at(range.ty).match({
        Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
        _        => lo.alloc.Inst(),
    });
    ret = lo.at_result(hook, inst, range.ty).try();
    frame = lo.push_frame(inst, hook.impl_module, ret, Ok(range.ty), None).try();
    saved = lo.use_frame(frame);
    mark = lo.locals.len;
    hook.f.params.loop((h, i, p) {
        (i == 0).match({
            true  => lo.bind_local(p.name.text, LocalKind.Direct(lo.copy_value(range).try())).try(),
            false => lo.bind_local(p.name.text, LocalKind.Direct(lo.copy_value(index).try())).try(),
        });
    });
    value = lo.block(body).try();
    here = lo.here();
    coerced = lo.coerce(value, ret).try();
    lo.add(Instruction.Copy(Move(out: here.ret_slot, source: coerced.slot))).try();
    lo.enter(here.ret_block).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    produced = Value(slot: here.ret_slot, ty: ret);
    variants = lo.variants_of(ret).try();
    ok = variant_index(variants, "Ok").ok_or(unsupported(span, "an at result without Ok")).try();
    tag = lo.tag_of(produced).try();
    expected = lo.word_const(Scalar.U32, ok.to_i64_bits()).try();
    test = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: test, left: tag, right: expected, op: Op.Equal, span: nowhere()))).try();
    good = lo.label().try();
    lo.branch_to(test, good, brk).try();
    lo.start(good);
    lo.payload_of(produced, ok)
}

at_result = (lo :: Native, hook: AtHook, inst: Inst, self_ty: TyId) Res<TyId, LowerError> {
    t = hook.f.ret.ok_or(unsupported(nowhere(), "an at without a result type")).try();
    ctx = Ctx(module: hook.impl_module, ret: lo.unit_ty, has_ret: false, self_ty: self_ty, has_self: true);
    raw = lo.check.type_from_ast(t, ctx).try(LowerError.OutOfMemory);
    lo.check.subst(raw, inst).try(LowerError.OutOfMemory)
}

// `h.break()`, `h.break(value)` and `h.next()`.
handle_call = (lo :: Native, loop_id: usize, name: str, c: Call, span: Span)
              Res<Value, LowerError> {
    target = lo.loops.get(loop_id).ok_or(unsupported(span, "a loop handle outside its loop")).try();
    name.match({
        "next"  => {
            lo.jump(target.next).try();
            lo.unit()
        },
        "break" => {
            c.args.get(0).when_ok((arg) {
                target.result.when_ok((result) {
                    variants = lo.variants_of(result.ty).try();
                    ok = variant_index(variants, "Ok").ok_or(unsupported(span, "a loop result without Ok")).try();
                    payload_ty = variants.get(ok).ok_or(unsupported(span, "a missing variant")).try().payload.ok_or(unsupported(span, "a loop result without a payload")).try();
                    value = lo.expr_as(arg.value, payload_ty).try();
                    made = lo.variant_value(result.ty, "Ok", Ok(value), span).try();
                    lo.add(Instruction.Copy(Move(out: result.slot, source: made.slot))).try();
                });
            });
            lo.jump(target.brk).try();
            lo.unit()
        },
        _       => Err(unsupported(span, "this loop handle operation")),
    })
}

// ---------------------------------------------------------------------
// printing
// ---------------------------------------------------------------------

// `print`/`println` and Console output: a literal format string with
// positional and named holes, or plain values.
print_call* = (lo :: Native, args: Vec<Arg>, first: usize, newline: bool, stream: Stream,
               span: Span) Res<Value, LowerError> {
    raw: Res<str> = args.get(first).match({
        None    => None,
        Ok(arg) => lo.tree.expr_at(arg.value).kind.match({
            Literal(l) => l.kind.match({ Str => Ok(l.text), _ => None }),
            _          => None,
        }),
    });
    raw.match({
        Ok(text) => lo.format(args, first, text, stream, span),
        None     => {
            args.loop((h, i, arg) {
                (i >= first).then(() { lo.print_expr(arg.value, stream).try(); });
            });
            Ok(())
        },
    }).try();
    newline.then(() { lo.text("\n", stream).try(); });
    lo.unit()
}

text = (lo :: Native, bytes: str, stream: Stream) Res<(), LowerError> {
    (!bytes.is_empty()).then(() {
        stream.match({
            Out => lo.add(Instruction.Text(bytes)).try(),
            Err => {
                data = lo.slot_of(Scalar.Ptr).try();
                lo.add(Instruction.Bytes(StaticBytes(out: data, bytes: bytes))).try();
                len = lo.word_const(Scalar.U64, bytes.len.to_i64_bits()).try();
                lo.add(Instruction.WriteOut(Write(data: data, len: len, stream: Stream.Err))).try();
            },
        });
    });
    Ok(())
}

print_expr = (lo :: Native, id: ExprId, stream: Stream) Res<(), LowerError> {
    e = lo.tree.expr_at(id);
    raw: Res<str> = e.kind.match({
        Literal(l) => l.kind.match({ Str => Ok(l.text), _ => None }),
        _          => None,
    });
    raw.match({
        Ok(text) => {
            decoded = text.slice(1, text.len - 1).decode_literal(lo.alloc)
                .match({ Ok(t) => Ok(t), Err(_) => Err(unsupported(e.span, "a malformed literal escape")) }).try();
            lo.text(decoded, stream)
        },
        None     => {
            value = lo.expr(id).try();
            lo.print_value(value, stream, e.span)
        },
    })
}

print_value* = (lo :: Native, value: Value, stream: Stream, span: Span) Res<(), LowerError> {
    class = lo.class_of(value.ty).try();
    lo.prim_name(value.ty).eq("str").match({
        true  => {
            at = lo.address(lo.spill(value)).try();
            data = lo.slot_of(Scalar.Ptr).try();
            len = lo.slot_of(Scalar.U64).try();
            lo.add(Instruction.LoadValue(Load(out: data, base: at, offset: 0))).try();
            lo.add(Instruction.LoadValue(Load(out: len, base: at, offset: 8))).try();
            lo.add(Instruction.WriteOut(Write(data: data, len: len, stream: stream)))
        },
        false => (word(class) && lo.plain_word(value.ty)).match({
            true  => lo.add(Instruction.PrintValue(Print(value: value.slot, ty: class, stream: stream))),
            false => class.match({
                Unit => lo.text("()", stream),
                _    => Err(unsupported(span, "printing a value without a primitive printer (Display)")),
            }),
        }),
    })
}

// Integers and bool print directly; payload-free enums and pointers do not.
plain_word = (lo :: Native, ty: TyId) bool {
    lo.check.types.at(ty).match({ Prim(_) => true, _ => false })
}

format = (lo :: Native, args: Vec<Arg>, first: usize, raw: str, stream: Stream, span: Span)
         Res<(), LowerError> {
    end = raw.len - 1;
    start: usize ::= 1;
    i: usize     ::= 1;
    used: usize  ::= first + 1;
    loop(() { i < end }, (h) {
        at = raw.fmt_at(i, end);
        at.what.match({
            Byte        => { i = i + (raw[i] == '\\').match({ true => 2, false => 1 }); },
            Pair        => {
                lo.raw_text(raw.slice(start, at.keep), stream, span).try();
                i     = at.next;
                start = i;
            },
            Hole        => {
                lo.raw_text(raw.slice(start, i), stream, span).try();
                arg = args.get(used).ok_or(unsupported(span, "a format hole without an argument")).try();
                lo.print_expr(arg.value, stream).try();
                used  = used + 1;
                i     = at.next;
                start = i;
            },
            Named(name) => {
                lo.raw_text(raw.slice(start, i), stream, span).try();
                kind = lo.lookup(name).ok_or(unsupported(span, "a named hole without a local")).try();
                value = kind.match({
                    Direct(v) => Ok(v),
                    Ref(p)    => lo.read(p),
                    _         => Err(unsupported(span, "a named hole naming a closure or handle")),
                }).try();
                lo.print_value(value, stream, span).try();
                i     = at.next;
                start = i;
            },
            NoName      => { Err(unsupported(span, "an invalid format hole")).try(); },
        });
    });
    lo.raw_text(raw.slice(start, end), stream, span).try();
    (used == args.len).ensure(unsupported(span, "an argument without a format hole")).try();
    Ok(())
}

raw_text = (lo :: Native, raw: str, stream: Stream, span: Span) Res<(), LowerError> {
    decoded = raw.decode_literal(lo.alloc).match({
        Ok(t)  => Ok(t),
        Err(_) => Err(unsupported(span, "a malformed literal escape")),
    }).try();
    lo.text(decoded, stream)
}
