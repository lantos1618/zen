// GNU-syntax x86-64 Linux assembly for the native IR. The executable is
// freestanding: its own `_start`, raw `syscall` instructions and a small
// runtime emitted beside the program. No C library is linked.
//
// Homes: `gen_asm_regalloc` places each word slot in a register, as a
// constant, or in the frame below %rbp. Words hold their value extended to
// 64 bits wherever they live; aggregate slots take their rounded size in
// the frame. %rax, %rcx and %rdx are this renderer's scratch registers and
// are never allocated.
// Calls follow System V for words; an aggregate argument is passed as a
// pointer to the caller's copy, and an aggregate result is written through a
// hidden pointer passed in %rdi, as System V does for MEMORY-class values.

{ Alloc, AllocError } = std.mem
{ str, String } = std.text
{ Res, Ok, None, loop, Range } = std.core
{ Vec } = std.collections
{ Program, Func, BasicBlock, Instruction, Terminator, Unary, Binary, Invocation, Print } = gen.gen_ir
{ Scalar, Layout, Op, TrapKind, Fault } = gen.gen_ir
{ Convert, Load, Store, SysCall, Start, Stream } = gen.gen_ir
{ width, signed, word, trap_message } = gen.gen_ir
{ Span } = std.source
{ Target } = gen.gen_asm
{ Sys, linux_x86_64, constant_value, Platform } = gen.gen_sys
{ LINUX_X86_64_EXIT, LINUX_X86_64_ARCH_PRCTL } = gen.gen_sys
{ Update, Compare, IndirectCall } = gen.gen_ir
{ Plan, Home, Pool, Address, Modes, plan } = gen.gen_asm_regalloc
{ prepare } = gen.gen_asm_prepare
{ peephole, Dialect } = gen.gen_asm_peephole
{ NONE, SMALL_AGGREGATE, log2, low_mask, modulo, bit_width, scale_of } = gen.gen_asm_flow

// This target fixes the instruction set, object dialect, OS and calling ABI:
// x86-64, ELF with GNU assembler syntax, Linux system calls, System V calls.
X86_64Linux* = { alloc*: Alloc }

X86_64Linux.impl(Target, {
    emit = (self: @Self, original: Program) Res<String, AllocError> {
        program = prepare(self.alloc, original).try();
        writer ::= Assembly(
            alloc: self.alloc,
            program: program,
            out: self.alloc.String().try(),
            data: self.alloc.String().try(),
            scratch: self.alloc.String().try(),
            traps: self.alloc.Vec<TrapSite>(),
            offsets: self.alloc.Vec<usize>(),
            next_label: 0,
            plan: Plan(
                function: Func(
                    name: "",
                    parameters: 0,
                    slots: self.alloc.Vec<Scalar>(),
                    blocks: self.alloc.Vec<BasicBlock>(),
                    result: Scalar.Unit
                ),
                homes: self.alloc.Vec<Home>(),
                saved: self.alloc.Vec<usize>(),
                uses: self.alloc.Vec<usize>(),
                local: self.alloc.Vec<bool>()
            ),
            save_offsets: self.alloc.Vec<usize>(),
            addresses: self.alloc.Vec<Address>(),
            absorbed: self.alloc.Vec<bool>(),
            from_memory: self.alloc.Vec<bool>(),
            code: self.alloc.Vec<Instruction>()
        );
        writer.render().try();
        peephole(self.alloc, writer.out.view(), Dialect.Att)
    }
})

// An out-of-line trap: the check branches here only when it fails, so the
// location and message loads stay off the fast path.
TrapSite = { label: usize, location: usize, length: usize, what: TrapKind }

Assembly = {
    alloc: Alloc,
    program: Program,
    out :: String,
    // Read-only literals are collected and emitted once after the code.
    data :: String,
    scratch :: String,
    traps :: Vec<TrapSite>,
    // Per function: each slot's distance below %rbp.
    offsets :: Vec<usize>,
    next_label :: usize,
    function_id :: usize = 0,
    // Where the hidden aggregate-result pointer is saved, below %rbp.
    result_offset :: usize = 0,
    // The current function's allocation and where its callee-saved
    // registers are kept, below %rbp.
    plan :: Plan,
    save_offsets :: Vec<usize>,
    // The block being rendered, for falling through to the next one.
    block_id :: usize = 0,
    // Per instruction of that block: the address a memory access reads or
    // writes, and whether the instruction's work was absorbed into one.
    addresses :: Vec<Address>,
    absorbed :: Vec<bool>,
    // Per instruction: whether its right operand is read straight from
    // memory by the load just before it.
    from_memory :: Vec<bool>,
    // The instruction being rendered, and its block's instructions.
    at :: usize = 0,
    code :: Vec<Instruction>,

    render = (self :: @Self) Res<AllocError> {
        self.out.add(".text\n").try();
        self.program.functions.loop((h, i, function) {
            self.function(i, function).try();
        });
        // The kernel enters with %rsp at argc, 16-byte aligned; `call`
        // leaves the entry function its System V alignment.
        self.out.fmt(
            ".globl _start\n.type _start, @function\n_start:\n    xorl %ebp, %ebp\n    movq %rsp, za_start_sp(%rip)\n    andq $-16, %rsp\n    leaq za_main_tcb(%rip), %rsi\n    movq %rsi, (%rsi)\n    movl $0x1002, %edi\n    movl ${}, %eax\n    syscall\n    call za_fn_{}\n    movl %eax, %edi\n    jmp za_exit\n.size _start, .-_start\n",
            LINUX_X86_64_ARCH_PRCTL,
            self.program.entry
        ).try();
        self.runtime().try();
        self.out.add(".section .rodata\n").try();
        self.out.add(self.data.view()).try();
        self.out.add(
            ".bss\n.p2align 4\nza_out_buf:\n    .zero 65536\nza_out_len:\n    .zero 8\nza_start_sp:\n    .zero 8\nza_out_lock:\n    .zero 8\n.p2align 4\nza_globals:\n    .zero 256\nza_main_tcb:\n    .zero 64\n"
        ).try();
        self.out.add(".section .note.GNU-stack,\"\",@progbits\n")
    }

    slot_type = (self: @Self, slot: usize) Scalar {
        self.plan.function.slots.get(slot).value_or(Scalar.Unit)
    }

    offset = (self: @Self, slot: usize) usize {
        self.offsets.get(slot).value_or(0)
    }

    // Aggregates are laid out upward from their lowest address. Slots with
    // a register or constant home take no frame space.
    layout_frame = (self :: @Self, function: Func) usize {
        self.offsets.clear();
        self.save_offsets.clear();
        cursor :: usize = 8;
        self.result_offset = cursor;
        self.plan.saved.loop((_) {
            cursor = cursor + 8;
            self.save_offsets.add(cursor).ignore();
        });
        function.slots.loop((h, i, ty) {
            framed = self.plan.home(i).match({ Frame => true, _ => false });
            framed.match({
                true  => {
                    size   = round_up(at_least_word(stored_size(ty)), 8);
                    align  = ty.match({ Block(l) => (l.align > 8).match({ true => 16, false => 8 }), _ => 8 });
                    cursor = round_up(cursor + size, align);
                    self.offsets.add(cursor).ignore();
                },
                false => { self.offsets.add(0).ignore(); },
            });
        });
        round_up(cursor, 16)
    }

    function = (self :: @Self, id: usize, original: Func)
               Res<AllocError> {
        self.function_id = id;
        self.plan        = plan(
            self.alloc,
            original,
            Pool(caller: 6, callee: 5)
        ).try();
        function         = self.plan.function;
        frame            = self.layout_frame(function);
        self.out.fmt(
            ".type za_fn_{}, @function\nza_fn_{}:\n    pushq %rbp\n    movq %rsp, %rbp\n    subq ${}, %rsp\n",
            id,
            id,
            frame
        ).try();
        hidden = is_block(function.result);
        hidden.then(() {
            self.out.fmt("    movq %rdi, -{}(%rbp)\n", self.result_offset).try();
        });
        self.plan.saved.loop((sh, k, r) {
            self.out.fmt(
                "    movq {}, -{}(%rbp)\n",
                pool_register(r),
                self.save_offsets.get(k).value_or(0)
            ).try();
        });
        self.parameters(
            function,
            hidden.match({ true => 1, false => 0 })
        ).try();
        // An aggregate slot briefly holds the caller's pointer to its value.
        Range(0, function.parameters).loop((i) {
            ty = function.slots.get(i).value_or(Scalar.Unit);
            is_block(ty).then(() {
                self.out.fmt("    movq -{}(%rbp), %rcx\n", self.offset(
                    i
                )).try();
                self.copy_block(
                    self.frame_spot(i),
                    Spot(register: 1, above: 0, below: 0),
                    stored_size(ty)
                ).try();
            });
        });
        function.blocks.loop((h, block_id, block) {
            self.block_id = block_id;
            self.out.fmt(".Lza_f{}_b{}:\n", id, block_id).try();
            fused     = self.fused_compare(block);
            self.code = block.code;
            self.addressing(block).try();
            block.code.loop((ih, k, instruction) {
                self.at = k;
                (!(fused && k + 1 == block.code.len) && !self.absorbed.get(k).value_or(false)).then(() {
                    self.instruction(instruction).try();
                });
            });
            fused.match({
                true  => block.code.get(block.code.len - 1).when_ok((last) {
                    last.match({
                        BinaryValue(compare) => block.exit.match({
                            Branch(branch) => self.compare_branch(
                                compare,
                                branch.yes,
                                branch.no
                            ),
                            _              => Ok,
                        }),
                        _                    => Ok,
                    }).try();
                }),
                false => self.terminator(function, block.exit).try(),
            });
        });
        self.trap_stubs().try();
        self.out.fmt(".size za_fn_{}, .-za_fn_{}\n", id, id)
    }

    instruction = (self :: @Self, instruction: Instruction)
                  Res<AllocError> {
        instruction.match({
            // A fixed slot's constant is materialized where it is read.
            Constant(value)     => self.move(
                value.out,
                Operand.Imm(value.value)
            ),
            Copy(value)         => self.copy(value.out, value.source),
            UnaryValue(value)   => self.unary(value),
            BinaryValue(value)  => self.binary(value),
            Invoke(call)        => self.call(call),
            PrintValue(value)   => self.print(value),
            Text(bytes)         => self.text(bytes),
            Cast(value)         => {
                d = self.destination(value.out);
                self.into(d, self.operand(value.input)).try();
                self.convert(
                    self.slot_type(value.input),
                    self.slot_type(value.out),
                    d
                ).try();
                self.settle(value.out, d)
            },
            AddressOf(value)    => self.plan.home(value.out).match({
                Pointer(_) => Ok,
                _          => {
                self.slot_address(value.slot, "%rax").try();
                // The slot may now change through the pointer.
                self.store(value.out, "%rax")
                },
            }),
            LoadValue(value)    => self.load_memory(value),
            StoreValue(value)   => self.store_memory(value),
            CopyBytes(value)    => {
                self.load(value.dest, "%rdi").try();
                self.load(value.source, "%rsi").try();
                self.load(value.bytes, "%rcx").try();
                self.out.add("    rep movsb\n")
            },
            Bytes(value)        => {
                label = self.literal(value.bytes).try();
                d     = self.destination(value.out);
                self.out.fmt(
                    "    leaq .Lza_d{}(%rip), {}\n",
                    label,
                    register_name(d, 8)
                ).try();
                self.settle(value.out, d)
            },
            WriteOut(value)     => {
                self.load(value.data, "%rdi").try();
                self.load(value.len, "%rsi").try();
                self.out.fmt(
                    "    movl ${}, %edx\n    call za_emit\n",
                    descriptor(value.stream)
                )
            },
            System(call)        => self.system(call),
            MapPages(value)     => {
                self.load(value.bytes, "%rdi").try();
                self.out.add("    call za_map\n").try();
                self.store(value.out, "%rax")
            },
            UnmapPages(slot)    => {
                self.load(slot, "%rdi").try();
                self.out.add("    call za_unmap\n")
            },
            Flush               => {
                self.out.add("    call za_flush\n")
            },
            // JavaScript-host instructions; `refused_by_asm` rejects such
            // programs before any renderer runs.
            Host(_)             => Ok,
            Wait(_)             => Ok,
            SysConst(value)     => {
                self.out.fmt(
                    "    movq ${}, %rax\n",
                    constant_value(value.name, Platform.LinuxX86_64)
                ).try();
                self.store(value.out, "%rax")
            },
            Startup(value)      => {
                value.value.match({
                    Argc    => self.out.add(
                        "    movq za_start_sp(%rip), %rcx\n    movq (%rcx), %rax\n"
                    ),
                    Argv    => self.out.add(
                        "    movq za_start_sp(%rip), %rcx\n    leaq 8(%rcx), %rax\n"
                    ),
                    Envp    => self.out.add(
                        "    movq za_start_sp(%rip), %rcx\n    movq (%rcx), %rax\n    leaq 16(%rcx,%rax,8), %rax\n"
                    ),
                    Globals => self.out.add("    leaq za_globals(%rip), %rax\n"),
                }).try();
                self.store(value.out, "%rax")
            },
            // gen_verify rejects machine operations (gen_ir_machine) before
            // rendering; should one arrive anyway, the program faults here.
            Machine(_)          => self.out.add("    ud2\n"),
            AtomicLoad(value)   => self.atomic_load(value),
            AtomicStore(value)  => self.atomic_store(value),
            AtomicUpdate(value) => self.atomic_update(value),
            CompareSwap(value)  => self.compare_swap(value),
            CodeAddress(value)  => {
                self.out.fmt(
                    "    leaq za_fn_{}(%rip), %rax\n",
                    value.function
                ).try();
                self.store(value.out, "%rax")
            },
            InvokeAt(call)      => self.call_at(call),
        })
    }

    // Sequentially consistent atomics. A plain load is enough on x86-64;
    // every write is an implicitly locked `xchg` or a `lock`-prefixed update,
    // which also orders it before later loads.
    atomic_load = (self :: @Self, value: Load) Res<AllocError> {
        ty = self.slot_type(value.out);
        self.load(value.base, "%rcx").try();
        (width(ty) == 4).match({
            true  => self.out.fmt("    movl {}(%rcx), %eax\n", value.offset),
            false => self.out.fmt("    movq {}(%rcx), %rax\n", value.offset),
        }).try();
        self.canon(ty, 0).try();
        self.store(value.out, "%rax")
    }

    atomic_store = (self :: @Self, value: Store) Res<AllocError> {
        ty = self.slot_type(value.value);
        self.load(value.base, "%rcx").try();
        self.load(value.value, "%rax").try();
        (width(ty) == 4).match({
            true  => self.out.fmt("    xchgl %eax, {}(%rcx)\n", value.offset),
            false => self.out.fmt("    xchgq %rax, {}(%rcx)\n", value.offset),
        }).try();
    }

    atomic_update = (self :: @Self, value: Update) Res<AllocError> {
        ty = self.slot_type(value.out);
        self.load(value.base, "%rcx").try();
        self.load(value.value, "%rax").try();
        op = value.op.match({ Swap => "xchg", Add => "lock xadd" });
        (width(ty) == 4).match({
            true  => self.out.fmt("    {}l %eax, (%rcx)\n", op),
            false => self.out.fmt("    {}q %rax, (%rcx)\n", op),
        }).try();
        self.canon(ty, 0).try();
        self.store(value.out, "%rax")
    }

    compare_swap = (self :: @Self, value: Compare) Res<AllocError> {
        ty = self.slot_type(value.out);
        self.load(value.base, "%rcx").try();
        self.load(value.desired, "%rdx").try();
        self.load(value.expected, "%rax").try();
        (width(ty) == 4).match({
            true  => self.out.add("    lock cmpxchgl %edx, (%rcx)\n"),
            false => self.out.add("    lock cmpxchgq %rdx, (%rcx)\n"),
        }).try();
        self.canon(ty, 0).try();
        self.store(value.out, "%rax")
    }

    // A call through a code address: word arguments in registers only.
    call_at = (self :: @Self, call: IndirectCall) Res<AllocError> {
        call.args.loop(
            (h, i, slot) { self.load(slot, argument_register(i)).try(); }
        );
        self.load(call.target, "%r11").try();
        self.out.add("    call *%r11\n").try();
        self.store(call.out, "%rax")
    }

    terminator = (self :: @Self, function: Func,
                  exit: Terminator) Res<AllocError> {
        exit.match({
            Return(value)  => {
                is_block(function.result).match({
                    true  => {
                        self.out.fmt(
                            "    movq -{}(%rbp), %rcx\n",
                            self.result_offset
                        ).try();
                        self.copy_block(
                            Spot(register: 1, above: 0, below: 0),
                            self.frame_spot(value),
                            stored_size(function.result)
                        ).try();
                        self.out.fmt(
                            "    movq -{}(%rbp), %rax\n",
                            self.result_offset
                        )
                    },
                    false => self.load(value, "%rax"),
                }).try();
                self.plan.saved.loop((sh, k, r) {
                    self.out.fmt(
                        "    movq -{}(%rbp), {}\n",
                        self.save_offsets.get(k).value_or(0),
                        pool_register(r)
                    ).try();
                });
                self.out.add("    leave\n    ret\n")
            },
            Jump(block)    => self.jump(block),
            Branch(branch) => self.operand(branch.value).match({
                Imm(v)   => self.jump(
                    (v != 0).match({ true => branch.yes, false => branch.no })
                ),
                Reg(n)   => {
                    self.out.fmt(
                        "    testq {}, {}\n",
                        register_name(n, 8),
                        register_name(n, 8)
                    ).try();
                    self.branch("ne", branch.yes, branch.no)
                },
                Mem(off) => {
                    self.out.fmt("    cmpq $0, -{}(%rbp)\n", off).try();
                    self.branch("ne", branch.yes, branch.no)
                },
                // A frame address is never null.
                Addr(_)  => self.jump(branch.yes),
            }),
            Trap(fault)    => self.trap_if("mp", fault.span, fault.what),
        })
    }

    copy = (self :: @Self, out: usize, source: usize) Res<AllocError> {
        ty = self.slot_type(out);
        is_block(ty).match({
            true  => self.copy_block(
                self.frame_spot(out),
                self.frame_spot(source),
                stored_size(ty)
            ),
            false => self.move(out, self.operand(source)),
        })
    }

    // Instruction selection works on operands: each slot's home as a
    // register, a frame slot or an immediate. A result is computed in the
    // register that is its home when it has one, else in %rax, and
    // `settle` puts it home.

    operand = (self: @Self, slot: usize) Operand {
        self.plan.home(slot).match({
            Register(r)  => Operand.Reg(register_number(r)),
            Fixed(value) => Operand.Imm(value),
            Pointer(s)   => Operand.Addr(self.offset(s)),
            Frame        => Operand.Mem(self.offset(slot)),
        })
    }

    // The register a result for `slot` is computed in.
    destination = (self: @Self, slot: usize) usize {
        self.plan.home(slot).match({
            Register(r) => register_number(r),
            _           => 0,
        })
    }

    settle = (self :: @Self, slot: usize, register: usize) Res<AllocError> {
        self.plan.home(slot).match({
            Register(r) => (register_number(r) != register).match({
                true  => self.out.fmt(
                    "    movq {}, {}\n",
                    register_name(register, 8),
                    pool_register(r)
                ),
                false => Ok,
            }),
            Fixed(_)    => Ok,
            Pointer(_)  => Ok,
            Frame       => self.out.fmt(
                "    movq {}, -{}(%rbp)\n",
                register_name(register, 8),
                self.offset(slot)
            ),
        })
    }

    // The whole 64-bit value of an operand into a register.
    into = (self :: @Self, register: usize, source: Operand) Res<AllocError> {
        source.match({
            Reg(n)    => (n != register).match({
                true  => self.out.fmt(
                    "    movq {}, {}\n",
                    register_name(n, 8),
                    register_name(register, 8)
                ),
                false => Ok,
            }),
            Mem(off)  => self.out.fmt(
                "    movq -{}(%rbp), {}\n",
                off,
                register_name(register, 8)
            ),
            Imm(v)    => self.immediate(v, register_name(register, 8)),
            Addr(off) => self.out.fmt(
                "    leaq -{}(%rbp), {}\n",
                off,
                register_name(register, 8)
            ),
        })
    }

    // Append an operand as `size` bytes.
    put = (self :: @Self, value: Operand, size: usize) Res<AllocError> {
        value.match({
            Reg(n)    => self.out.add(register_name(n, size)),
            Mem(off)  => self.out.fmt("-{}(%rbp)", off),
            Imm(v)    => self.out.fmt("${}", v),
            // Callers materialize addresses first (see `source`).
            Addr(off) => self.out.fmt("-{}(%rbp)", off),
        })
    }

    // `mnemonic source, dest` on `size`-byte operands.
    op2 = (self :: @Self, mnemonic: str, size: usize, source: Operand, dest: Operand)
          Res<AllocError> {
        self.out.fmt("    {}{} ", mnemonic, suffix(size)).try();
        self.put(source, size).try();
        self.out.add(", ").try();
        self.put(dest, size).try();
        self.out.add("\n")
    }

    // An operand usable as the source of a `size`-byte instruction: an
    // immediate that does not fit, or a frame address, goes through %rcx.
    source = (self :: @Self, value: Operand, size: usize) Res<Operand, AllocError> {
        value.match({
            Addr(_) => {
                self.into(1, value).try();
                Ok(Operand.Reg(1))
            },
            Imm(v)  => fits_immediate(v, size).match({
                true  => Ok(value),
                false => {
                    self.immediate(v, "%rcx").try();
                    Ok(Operand.Reg(1))
                },
            }),
            _       => Ok(value),
        })
    }

    move = (self :: @Self, out: usize, from: Operand) Res<AllocError> {
        self.plan.home(out).match({
            Register(r) => self.into(register_number(r), from),
            Fixed(_)    => Ok,
            Pointer(_)  => Ok,
            Frame       => from.match({
                Reg(n)   => self.out.fmt(
                    "    movq {}, -{}(%rbp)\n",
                    register_name(n, 8),
                    self.offset(out)
                ),
                Addr(_)  => {
                    self.into(0, from).try();
                    self.out.fmt("    movq %rax, -{}(%rbp)\n", self.offset(out))
                },
                Imm(v)   => fits_immediate(v, 8).match({
                    true  => self.out.fmt(
                        "    movq ${}, -{}(%rbp)\n",
                        v,
                        self.offset(out)
                    ),
                    false => {
                        self.immediate(v, "%rax").try();
                        self.out.fmt(
                            "    movq %rax, -{}(%rbp)\n",
                            self.offset(out)
                        )
                    },
                }),
                Mem(off) => self.out.fmt(
                    "    movq -{}(%rbp), %rax\n    movq %rax, -{}(%rbp)\n",
                    off,
                    self.offset(out)
                ),
            }),
        })
    }

    unary = (self :: @Self, value: Unary) Res<AllocError> {
        ty = self.slot_type(value.input);
        d  = self.destination(value.out);
        self.into(d, self.operand(value.input)).try();
        value.op.match({
            Neg => {
                self.out.fmt("    negq {}\n", register_name(d, 8)).try();
                (width(ty) == 8).match({
                    true  => self.trap_if("o", value.span, TrapKind.Overflow),
                    false => self.range_check(ty, value.span, d),
                })
            },
            Not => self.out.fmt("    xorq $1, {}\n", register_name(d, 8)),
        }).try();
        self.settle(value.out, d)
    }

    // Compare the 64-bit result with its value re-extended from the type's
    // width; any difference is an overflow.
    range_check = (self :: @Self, ty: Scalar, span: Span, register: usize) Res<AllocError> {
        self.out.fmt("    movq {}, %rdx\n", register_name(register, 8)).try();
        self.canon(ty, 2).try();
        self.out.fmt("    cmpq %rdx, {}\n", register_name(register, 8)).try();
        self.trap_if("ne", span, TrapKind.Overflow)
    }

    // Truncate a register to `ty`'s width and extend it back to 64 bits.
    canon = (self :: @Self, ty: Scalar, n: usize) Res<AllocError> {
        full  = register_name(n, 8);
        dword = register_name(n, 4);
        ty.match({
            I8   => self.out.fmt("    movsbq {}, {}\n", register_name(
                n,
                1
            ), full),
            U8   => self.out.fmt(
                "    movzbl {}, {}\n",
                register_name(n, 1),
                dword
            ),
            Bool => self.out.fmt(
                "    movzbl {}, {}\n",
                register_name(n, 1),
                dword
            ),
            I16  => self.out.fmt("    movswq {}, {}\n", register_name(
                n,
                2
            ), full),
            U16  => self.out.fmt(
                "    movzwl {}, {}\n",
                register_name(n, 2),
                dword
            ),
            I32  => self.out.fmt("    movslq {}, {}\n", dword, full),
            U32  => self.out.fmt("    movl {}, {}\n", dword, dword),
            _    => Ok,
        })
    }

    convert = (self :: @Self, from: Scalar, to: Scalar, n: usize) Res<AllocError> {
        to.match({
            Bool => (width(from) == 1 && !signed(from)).match({
                true  => Ok,
                false => self.out.fmt(
                    "    testq {}, {}\n    setne {}\n    movzbl {}, {}\n",
                    register_name(n, 8),
                    register_name(n, 8),
                    register_name(n, 1),
                    register_name(n, 1),
                    register_name(n, 4)
                ),
            }),
            _    => self.canon(to, n),
        })
    }

    binary = (self :: @Self, value: Binary) Res<AllocError> {
        ty = self.slot_type(value.left);
        value.op.match({
            Div          => self.divide_op(value, ty, false),
            Rem          => self.divide_op(value, ty, true),
            Equal        => self.compare_op(value, ty),
            NotEqual     => self.compare_op(value, ty),
            Less         => self.compare_op(value, ty),
            LessEqual    => self.compare_op(value, ty),
            Greater      => self.compare_op(value, ty),
            GreaterEqual => self.compare_op(value, ty),
            Shl          => self.shift_op(value, ty),
            Shr          => self.shift_op(value, ty),
            Rotr         => self.shift_op(value, ty),
            Mul          => (width(ty) == 8 && !signed(ty)).match({
                true  => self.operand(value.right).match({
                    Imm(c) => (log2(c) != NONE).match({
                        true  => self.shift_checked(value, log2(c)),
                        false => self.multiply_wide(value),
                    }),
                    _      => self.multiply_wide(value),
                }),
                false => self.arithmetic(value, ty),
            }),
            _            => self.arithmetic(value, ty),
        })
    }

    // An unsigned 64-bit product by 2^k overflows exactly when any of the
    // top k bits is set.
    shift_checked = (self :: @Self, value: Binary, power: usize) Res<AllocError> {
        d = self.destination(value.out);
        self.into(d, self.operand(value.left)).try();
        (power > 0).then(() {
            self.out.fmt(
                "    movq {}, %rdx\n    shrq ${}, %rdx\n",
                register_name(d, 8),
                64 - power
            ).try();
            self.trap_if("nz", value.span, TrapKind.Overflow).try();
            self.out.fmt("    shlq ${}, {}\n", power, register_name(
                d,
                8
            )).try();
        });
        self.settle(value.out, d)
    }

    multiply_wide = (self :: @Self, value: Binary) Res<AllocError> {
        self.load(value.left, "%rax").try();
        self.load(value.right, "%rcx").try();
        self.out.add("    mulq %rcx\n").try();
        self.trap_if("o", value.span, TrapKind.Overflow).try();
        self.store(value.out, "%rax")
    }

    // Two-operand arithmetic and bit operations. Operands keep their
    // extension to 64 bits, so 32-bit instructions serve 32-bit classes
    // (writing a 32-bit register clears the upper half) and flags check
    // 32- and 64-bit overflow directly; narrower classes compute in 64 bits
    // and compare against the re-extended result.
    arithmetic = (self :: @Self, value: Binary, ty: Scalar) Res<AllocError> {
        w        = width(ty);
        size     = operation_size(value.op, ty);
        mnemonic = value.op.match({
            Add     => "add",
            WrapAdd => "add",
            Sub     => "sub",
            WrapSub => "sub",
            Mul     => "imul",
            WrapMul => "imul",
            And     => "and",
            Or      => "or",
            _       => "xor",
        });
        d     ::= self.destination(value.out);
        left  ::= self.operand(value.left);
        right ::= self.operand(value.right);
        self.from_memory.get(self.at).value_or(false).match({
            true  => {
                // The loaded value is the memory operand; the other one
                // goes to the destination first, which must not be a
                // register the address still needs.
                loaded = self.at - 1;
                load   = self.loaded(loaded);
                other  = (load.out == value.right).match({ true => left, false => right });
                place  = self.locate(
                    self.access_at(loaded, load.base),
                    load.offset
                ).try();
                (d == place.base || d == place.index).then(() { d = 0; });
                self.into(d, other).try();
                self.out.fmt("    {}{} ", mnemonic, suffix(size)).try();
                self.put_place(place).try();
                self.out.fmt(", {}\n", register_name(d, size)).try();
            },
            false => {
                (same_register(right, d) && !same_register(left, d)).then(() {
                    commutative(value.op).match({
                        true  => {
                            swap  = left;
                            left  = right;
                            right = swap;
                        },
                        false => { d = 0; },
                    });
                });
                self.into(d, left).try();
                rhs = self.source(right, size).try();
                self.op2(mnemonic, size, rhs, Operand.Reg(d)).try();
            },
        });
        value.op.match({
            Add     => self.checked(ty, value.span, d),
            Sub     => self.checked(ty, value.span, d),
            Mul     => (w == 8).match({
                true  => self.trap_if("o", value.span, TrapKind.Overflow),
                // Extended operands of at most 32 bits multiply exactly.
                false => self.range_check(ty, value.span, d),
            }),
            WrapAdd => self.wrapped(ty, d),
            WrapSub => self.wrapped(ty, d),
            WrapMul => self.wrapped(ty, d),
            _       => Ok,
        }).try();
        self.settle(value.out, d)
    }

    // Checked add/sub: flags for 32- and 64-bit words, range for narrower
    // ones.
    checked = (self :: @Self, ty: Scalar, span: Span, d: usize) Res<AllocError> {
        w = width(ty);
        (w >= 4).match({
            true  => {
                self.trap_if(
                    signed(ty).match({ true => "o", false => "c" }),
                    span,
                    TrapKind.Overflow
                ).try();
                (w == 4 && signed(ty)).match({
                    true  => self.canon(ty, d),
                    false => Ok,
                })
            },
            false => self.range_check(ty, span, d),
        })
    }

    // A wrapped result re-extended from its class width. A 32-bit
    // instruction already truncated an unsigned 32-bit result.
    wrapped = (self :: @Self, ty: Scalar, d: usize) Res<AllocError> {
        ty.match({
            U32 => Ok,
            _   => self.canon(ty, d),
        })
    }

    // Counts at or beyond the width produce zero, as the std contract says;
    // rotation counts are taken modulo the width.
    shift_op = (self :: @Self, value: Binary, ty: Scalar) Res<AllocError> {
        w = width(ty);
        d = self.destination(value.out);
        self.operand(value.right).match({
            Imm(k) => {
                self.into(d, self.operand(value.left)).try();
                value.op.match({
                    Rotr => (w == 8).match({
                        true  => self.out.fmt(
                            "    rorq ${}, {}\n",
                            modulo(k, 64),
                            register_name(d, 8)
                        ),
                        false => {
                            self.out.fmt(
                                "    ror{} ${}, {}\n",
                                suffix(w),
                                modulo(k, 32),
                                register_name(d, w)
                            ).try();
                            w.match({
                                1 => self.out.fmt(
                                    "    movzbl {}, {}\n",
                                    register_name(d, 1),
                                    register_name(d, 4)
                                ),
                                2 => self.out.fmt(
                                    "    movzwl {}, {}\n",
                                    register_name(d, 2),
                                    register_name(d, 4)
                                ),
                                _ => Ok,
                            })
                        },
                    }),
                    _    => (k < 0 || k >= bit_width(w)).match({
                        true  => self.out.fmt(
                            "    xorl {}, {}\n",
                            register_name(d, 4),
                            register_name(d, 4)
                        ),
                        false => {
                            mnemonic = value.op.match({ Shl => "shlq", _ => "shrq" });
                            self.out.fmt(
                                "    {} ${}, {}\n",
                                mnemonic,
                                k,
                                register_name(d, 8)
                            ).try();
                            value.op.match({
                                Shl => self.canon(ty, d),
                                _   => signed(ty).match({ true => self.canon(ty, d), false => Ok }),
                            })
                        },
                    }),
                }).try();
            },
            count  => {
                // The count goes to %cl before the left operand is placed, as
                // the destination may be the count's own register.
                self.into(1, count).try();
                self.into(d, self.operand(value.left)).try();
                value.op.match({
                    Rotr => self.out.fmt(
                        "    ror{} %cl, {}\n",
                        suffix(w),
                        register_name(d, w)
                    ).try(),
                    _    => {
                        label    = self.label();
                        mnemonic = value.op.match({ Shl => "shlq", _ => "shrq" });
                        self.out.fmt(
                            "    xorl %edx, %edx\n    cmpq ${}, %rcx\n    cmovaeq %rdx, {}\n    jae .Lza_t{}\n    {} %cl, {}\n.Lza_t{}:\n",
                            w * 8,
                            register_name(d, 8),
                            label,
                            mnemonic,
                            register_name(d, 8),
                            label
                        ).try();
                    },
                });
                value.op.match({
                    Rotr => w.match({
                        1 => self.out.fmt(
                            "    movzbl {}, {}\n",
                            register_name(d, 1),
                            register_name(d, 4)
                        ),
                        2 => self.out.fmt(
                            "    movzwl {}, {}\n",
                            register_name(d, 2),
                            register_name(d, 4)
                        ),
                        _ => Ok,
                    }),
                    _    => self.canon(ty, d),
                }).try();
            },
        });
        self.settle(value.out, d)
    }

    divide_op = (self :: @Self, value: Binary, ty: Scalar, remainder: bool) Res<AllocError> {
        power = self.operand(value.right).match({ Imm(c) => log2(c), _ => NONE });
        (power != NONE && power < 31 && !signed(ty)).match({
            // An unsigned division by a power of two is a shift and its
            // remainder a mask; the divisor is not zero.
            true  => {
                d = self.destination(value.out);
                self.into(d, self.operand(value.left)).try();
                remainder.match({
                    true  => self.out.fmt(
                        "    andq ${}, {}\n",
                        low_mask(power),
                        register_name(d, 8)
                    ),
                    false => (power > 0).match({
                        true  => self.out.fmt(
                            "    shrq ${}, {}\n",
                            power,
                            register_name(d, 8)
                        ),
                        false => Ok,
                    }),
                }).try();
                self.settle(value.out, d)
            },
            false => self.divide_general(value, ty, remainder),
        })
    }

    divide_general = (self :: @Self, value: Binary, ty: Scalar, remainder: bool) Res<AllocError> {
        self.load(value.left, "%rax").try();
        self.load(value.right, "%rcx").try();
        self.divide(ty, value.span, remainder).try();
        self.store(value.out, "%rax")
    }

    // Set flags for `left op right`. Returns true when the operands were
    // exchanged, so the condition must be mirrored.
    compare_flags = (self :: @Self, left: usize, right: usize) Res<bool, AllocError> {
        a       ::= self.operand(left);
        b       ::= self.operand(right);
        swapped ::= false;
        is_immediate(a).then(() {
            swap    = a;
            a       = b;
            b       = swap;
            swapped = true;
        });
        // Both constant, both in memory, or a frame address: the first goes
        // to %rax.
        (is_immediate(a) || is_address(a) || (is_memory(a) && is_memory(b))).then(() {
            self.into(0, a).try();
            a = Operand.Reg(0);
        });
        zero = b.match({ Imm(v) => v == 0, _ => false });
        (zero && is_register(a)).match({
            true  => self.op2("test", 8, a, a),
            false => {
                rhs = self.source(b, 8).try();
                self.op2("cmp", 8, rhs, a)
            },
        }).try();
        Ok(swapped)
    }

    compare_op = (self :: @Self, value: Binary, ty: Scalar) Res<AllocError> {
        swapped = self.compare_flags(value.left, value.right).try();
        d       = self.destination(value.out);
        self.out.fmt(
            "    set{} {}\n    movzbl {}, {}\n",
            condition(value.op, signed(ty), swapped),
            register_name(d, 1),
            register_name(d, 1),
            register_name(d, 4)
        ).try();
        self.settle(value.out, d)
    }

    // A block ending in a comparison read only by its branch compares and
    // branches without materializing the boolean.
    fused_compare = (self: @Self, block: BasicBlock) bool {
        (block.code.len > 0).match({
            false => false,
            true  => self.fusable(block),
        })
    }

    fusable = (self: @Self, block: BasicBlock) bool {
        block.exit.match({
            Branch(branch) => block.code.get(block.code.len - 1).match({
                Ok(last) => last.match({
                    BinaryValue(compare) => compare.out == branch.value
                        && self.plan.reads_of(compare.out) == 1
                        && self.plan.is_local(compare.out)
                        && compare.op.match({
                            Equal => true, NotEqual => true, Less => true, LessEqual => true,
                            Greater => true, GreaterEqual => true, _ => false,
                        }),
                    _                    => false,
                }),
                None     => false,
            }),
            _              => false,
        })
    }

    compare_branch = (self :: @Self, compare: Binary, yes: usize, no: usize) Res<AllocError> {
        swapped = self.compare_flags(compare.left, compare.right).try();
        self.branch(
            condition(
                compare.op,
                signed(self.slot_type(compare.left)),
                swapped
            ),
            yes,
            no
        )
    }

    // Branch on `cc` to `yes`, else to `no`, falling through to whichever
    // is the next block.
    branch = (self :: @Self, cc: str, yes: usize, no: usize) Res<AllocError> {
        next = self.block_id + 1;
        (no == next).match({
            true  => self.out.fmt(
                "    j{} .Lza_f{}_b{}\n",
                cc,
                self.function_id,
                yes
            ),
            false => (yes == next).match({
                true  => self.out.fmt(
                    "    j{} .Lza_f{}_b{}\n",
                    inverse(cc),
                    self.function_id,
                    no
                ),
                false => self.out.fmt(
                    "    j{} .Lza_f{}_b{}\n    jmp .Lza_f{}_b{}\n",
                    cc,
                    self.function_id,
                    yes,
                    self.function_id,
                    no
                ),
            }),
        })
    }

    jump = (self :: @Self, block: usize) Res<AllocError> {
        (block == self.block_id + 1).match({
            true  => Ok,
            false => self.out.fmt(
                "    jmp .Lza_f{}_b{}\n",
                self.function_id,
                block
            ),
        })
    }

    // Zero divisors and MIN / -1 trap at the operator; idiv would fault.
    divide = (self :: @Self, ty: Scalar, span: Span, remainder: bool)
             Res<AllocError> {
        self.out.add("    testq %rcx, %rcx\n").try();
        self.trap_if("z", span, TrapKind.DivideByZero).try();
        signed(ty).match({
            true  => {
                label = self.label();
                self.out.fmt(
                    "    cmpq $-1, %rcx\n    jne .Lza_t{}\n    movabsq ${}, %rdx\n    cmpq %rdx, %rax\n",
                    label,
                    minimum(ty)
                ).try();
                self.trap_if("e", span, TrapKind.Overflow).try();
                self.out.fmt(".Lza_t{}:\n    cqto\n    idivq %rcx\n", label)
            },
            false => self.out.add("    xorl %edx, %edx\n    divq %rcx\n"),
        }).try();
        remainder.then(() { self.out.add("    movq %rdx, %rax\n").try(); });
        Ok
    }

    load_memory = (self :: @Self, value: Load) Res<AllocError> {
        ty = self.slot_type(value.out);
        is_block(ty).match({
            true  => {
                from = self.pointer_spot(value.base, value.offset).try();
                self.copy_block(
                    self.frame_spot(value.out),
                    from,
                    stored_size(ty)
                )
            },
            false => {
                op   = ty.match({
                    I8   => "movsbq",
                    U8   => "movzbl",
                    Bool => "movzbl",
                    I16  => "movswq",
                    U16  => "movzwl",
                    I32  => "movslq",
                    U32  => "movl",
                    _    => "movq",
                });
                dest = ty.match({
                    U8 => "%eax", Bool => "%eax", U16 => "%eax", U32 => "%eax", _ => "%rax",
                });
                d    = self.destination(value.out);
                ty.match({
                    Unit => self.out.fmt(
                        "    xorl {}, {}\n",
                        register_name(d, 4),
                        register_name(d, 4)
                    ),
                    _    => {
                        place = self.locate(
                            self.access(value.base),
                            value.offset
                        ).try();
                        self.out.fmt("    {} ", op).try();
                        self.put_place(place).try();
                        self.out.fmt(
                            ", {}\n",
                            register_name(
                                d,
                                dest.match({ "%eax" => 4, _ => 8 })
                            )
                        )
                    },
                }).try();
                self.settle(value.out, d)
            },
        })
    }

    store_memory = (self :: @Self, value: Store) Res<AllocError> {
        ty = self.slot_type(value.value);
        is_block(ty).match({
            true  => {
                to = self.pointer_spot(value.base, value.offset).try();
                self.copy_block(
                    to,
                    self.frame_spot(value.value),
                    stored_size(ty)
                ).try();
            },
            false => {
                w = width(ty);
                (w > 0).then(() {
                    place = self.locate(
                        self.access(value.base),
                        value.offset
                    ).try();
                    stored ::= self.operand(value.value);
                    stored.match({
                        Mem(_)  => {
                            self.into(0, stored).try();
                            stored = Operand.Reg(0);
                        },
                        Addr(_) => {
                            self.into(0, stored).try();
                            stored = Operand.Reg(0);
                        },
                        Imm(v)  => {
                            (!fits_immediate(v, w)).then(() {
                                self.into(0, stored).try();
                                stored = Operand.Reg(0);
                            });
                        },
                        _       => (),
                    });
                    self.out.fmt("    mov{} ", suffix(w)).try();
                    self.put(stored, w).try();
                    self.out.add(", ").try();
                    self.put_place(place).try();
                    self.out.add("\n").try();
                });
            },
        });
        // The store may have written any slot whose address was taken.
        Ok
    }

    // Copy `size` bytes between two spots. Up to SMALL_AGGREGATE bytes the
    // data goes through %rdx alone; a larger copy is `rep movsb`, which
    // needs %rdi, %rsi and %rcx, and is a clobbering instruction for the
    // allocator (see `gen_asm_flow.clobbers`).
    copy_block = (self :: @Self, dest: Spot, source: Spot, size: usize)
                 Res<AllocError> {
        (size > SMALL_AGGREGATE).match({
            true  => {
                self.out.add("    leaq ").try();
                self.put_spot(dest, 0).try();
                self.out.add(", %rdi\n    leaq ").try();
                self.put_spot(source, 0).try();
                self.out.fmt(
                    ", %rsi\n    movq ${}, %rcx\n    rep movsb\n",
                    size
                ).try();
            },
            false => {
                at :: usize = 0;
                loop(() { at < size }, (h) {
                    step: usize = (at + 8 <= size).match({ true => 8, false => 1 });
                    self.out.fmt("    mov{} ", suffix(step)).try();
                    self.put_spot(source, at).try();
                    self.out.fmt(
                        ", {}\n    mov{} {}, ",
                        register_name(2, step),
                        suffix(step),
                        register_name(2, step)
                    ).try();
                    self.put_spot(dest, at).try();
                    self.out.add("\n").try();
                    at = at + step;
                });
            },
        });
    }

    // A frame slot's storage.
    frame_spot = (self: @Self, slot: usize) Spot {
        Spot(register: 5, above: 0, below: self.offset(slot))
    }

    // `offset` bytes past a pointer slot's value: its frame target when it
    // is a frame address, else through %rcx.
    pointer_spot = (self :: @Self, slot: usize, offset: usize) Res<Spot, AllocError> {
        self.plan.home(slot).match({
            Pointer(s) => Ok(Spot(
                register: 5,
                above: offset,
                below: self.offset(s)
            )),
            _          => {
                self.into(1, self.operand(slot)).try();
                Ok(Spot(register: 1, above: offset, below: 0))
            },
        })
    }

    put_spot = (self :: @Self, spot: Spot, at: usize) Res<AllocError> {
        self.out.fmt(
            "{}+{}-{}({})",
            spot.above,
            at,
            spot.below,
            register_name(spot.register, 8)
        )
    }

    call = (self :: @Self, call: Invocation) Res<AllocError> {
        callee  = self.program.functions.get(call.function).match({
            Ok(f) => Ok(f),
            None  => None,
        });
        hidden  = callee.match({ Ok(f) => is_block(f.result), None => false });
        first   = hidden.match({ true => 1, false => 0 });
        total   = call.args.len + first;
        stacked = (total > REGISTER_ARGUMENTS).match({
            true  => total - REGISTER_ARGUMENTS,
            false => 0,
        });
        padding = stacked % 2;
        (padding > 0).then(() { self.out.add("    subq $8, %rsp\n").try(); });
        // Stack arguments occupy eight-byte ABI slots, rightmost first.
        Range(0, stacked).loop((k) {
            index = total - k - 1 - first;
            call.args.get(index).when_ok((slot) {
                self.argument(slot, "%rax").try();
                self.out.add("    pushq %rax\n").try();
            });
        });
        hidden.then(() { self.slot_address(call.out, "%rdi").try(); });
        call.args.loop((h, i, slot) {
            (i + first >= REGISTER_ARGUMENTS).then(() { h.break(); });
            self.argument(slot, argument_register(i + first)).try();
        });
        self.out.fmt("    call za_fn_{}\n", call.function).try();
        (stacked > 0).then(() {
            self.out.fmt("    addq ${}, %rsp\n", (stacked + padding) * 8).try();
        });
        hidden.match({
            true  => Ok,
            false => self.store(call.out, "%rax"),
        })
    }

    // A word travels by value; an aggregate by the address of its slot.
    argument = (self :: @Self, slot: usize, register: str) Res<AllocError> {
        is_block(self.slot_type(slot)).match({
            true  => self.slot_address(slot, register),
            false => self.load(slot, register),
        })
    }

    system = (self :: @Self, call: SysCall) Res<AllocError> {
        call.args.loop((h, i, slot) {
            self.load(slot, system_register(i)).try();
        });
        call.call.match({
            // The first word of every thread control block is its own
            // address, and %fs points at the running thread's block.
            ThreadSelf  => self.out.add("    movq %fs:0, %rax\n"),
            CloneThread => self.out.add("    call za_clone\n"),
            _           => linux_x86_64(call.call).match({
                Ok(number) => self.out.fmt(
                    "    movl ${}, %eax\n    syscall\n",
                    number
                ),
                // The kernel has no such call: answer -ENOSYS without trapping.
                None       => self.out.add("    movq $-38, %rax\n"),
            }),
        }).try();
        self.store(call.out, "%rax")
    }

    print = (self :: @Self, value: Print) Res<AllocError> {
        fd = descriptor(value.stream);
        value.ty.match({
            Bool => {
                self.load(value.value, "%rax").try();
                self.out.fmt(
                    "    leaq za_false(%rip), %rdi\n    leaq za_true(%rip), %rdx\n    xorl %esi, %esi\n    testq %rax, %rax\n    cmovneq %rdx, %rdi\n    setz %sil\n    addl $4, %esi\n    movl ${}, %edx\n    call za_emit\n",
                    fd
                )
            },
            Unit => {
                label = self.literal("()").try();
                self.out.fmt(
                    "    leaq .Lza_d{}(%rip), %rdi\n    movl $2, %esi\n    movl ${}, %edx\n    call za_emit\n",
                    label,
                    fd
                )
            },
            _    => {
                self.load(value.value, "%rdi").try();
                self.out.fmt("    movl ${}, %esi\n", fd).try();
                signed(value.ty).match({
                    true  => self.out.add("    call za_print_i64\n"),
                    false => self.out.add("    call za_print_u64\n"),
                })
            },
        }).try();
    }

    text = (self :: @Self, bytes: str) Res<AllocError> {
        (!bytes.is_empty()).then(() {
            label = self.literal(bytes).try();
            self.out.fmt(
                "    leaq .Lza_d{}(%rip), %rdi\n    movl ${}, %esi\n    call za_out\n",
                label,
                bytes.len
            ).try();
        });
        Ok
    }

    // Numeric bytes preserve quotes, backslashes, embedded NULs and UTF-8
    // without introducing an assembler string-escaping dialect.
    literal = (self :: @Self, bytes: str) Res<usize, AllocError> {
        label = self.label();
        self.data.fmt(".Lza_d{}:\n", label).try();
        self.data_bytes(bytes).try();
        Ok(label)
    }

    data_bytes = (self :: @Self, bytes: str) Res<AllocError> {
        bytes.loop((h, i, byte) {
            (i % 32 == 0).then(() {
                (i > 0).then(() { self.data.add("\n").try(); });
                self.data.add("    .byte ").try();
            });
            (i % 32 > 0).then(() { self.data.add(",").try(); });
            self.data.fmt("{}", byte).try();
        });
        (!bytes.is_empty()).then(() { self.data.add("\n").try(); });
        Ok
    }

    label = (self :: @Self) usize {
        label           = self.next_label;
        self.next_label = label + 1;
        label
    }

    slot_address = (self :: @Self, slot: usize, register: str)
                   Res<AllocError> {
        self.out.fmt("    leaq -{}(%rbp), {}\n", self.offset(slot), register)
    }

    // Find the memory operand of every word access in `block` and mark the
    // pointer arithmetic it absorbs.
    addressing = (self :: @Self, block: BasicBlock) Res<AllocError> {
        self.addresses.clear();
        self.absorbed.clear();
        block.code.loop((_) {
            self.addresses.add(Address(
                base: NONE,
                index: NONE,
                scale: 1,
                displacement: 0,
                absorbed: 0
            )).try();
            self.absorbed.add(false).try();
        });
        modes = Modes(any_scale: true);
        block.code.loop((h, k, instruction) {
            found = instruction.match({
                LoadValue(v)  => {
                    w = width(self.slot_type(v.out));
                    (w > 0 && !is_block(self.slot_type(v.out))).match({
                        true  => Ok(self.plan.address(
                            block,
                            k,
                            v.base,
                            w,
                            modes
                        )),
                        false => None,
                    })
                },
                StoreValue(v) => {
                    w = width(self.slot_type(v.value));
                    (w > 0 && !is_block(self.slot_type(v.value))).match({
                        true  => Ok(self.plan.address(
                            block,
                            k,
                            v.base,
                            w,
                            modes
                        )),
                        false => None,
                    })
                },
                _             => None,
            });
            found.when_ok((address) {
                self.addresses.set(k, address);
                Range(0, address.absorbed).loop((i) { self.absorbed.set(k - 1 - i, true); });
            });
        });
        // A load read only by the arithmetic right after it becomes that
        // instruction's memory operand.
        self.from_memory.clear();
        block.code.loop((h, k, instruction) {
            // Neither instruction may already be part of an address.
            fold = (k > 0 && !self.absorbed.get(k - 1).value_or(true) && !self.absorbed.get(k).value_or(true)).match({
                false => false,
                true  => instruction.match({
                    BinaryValue(v) => block.code.get(k - 1).match({
                        Ok(before) => before.match({
                            LoadValue(l) => self.plan.single(
                                l.out
                            ) && v.left != v.right
                                && (v.right == l.out || (v.left == l.out && commutative(
                                    v.op
                                )))
                                && operation_size(v.op, self.slot_type(v.left)) == width(self.slot_type(l.out))
                                && foldable(v.op, self.slot_type(v.left)),
                            _            => false,
                        }),
                        None       => false,
                    }),
                    _              => false,
                }),
            });
            self.from_memory.add(fold).try();
            fold.then(() { self.absorbed.set(k - 1, true); });
        });
        Ok
    }

    // The load at `k` in the block being rendered.
    loaded = (self: @Self, k: usize) Load {
        self.code.get(k).value_or(Instruction.Flush).match({
            LoadValue(l) => l,
            _            => Load(out: 0, base: 0, offset: 0),
        })
    }

    // The address of the access being rendered; `base` when none was found.
    access = (self: @Self, base: usize) Address {
        self.access_at(self.at, base)
    }

    access_at = (self: @Self, at: usize, base: usize) Address {
        self.addresses.get(at).match({
            Ok(a) => (a.base == NONE).match({
                true  => Address(
                    base: base,
                    index: NONE,
                    scale: 1,
                    displacement: 0,
                    absorbed: 0
                ),
                false => a,
            }),
            None  => Address(
                base: base,
                index: NONE,
                scale: 1,
                displacement: 0,
                absorbed: 0
            ),
        })
    }

    // Registers for an address, `offset` bytes further on: the base and
    // index in their home registers, the frame address as %rbp, others
    // through %rcx (base) and %rdx (index).
    locate = (self :: @Self, address: Address, offset: usize) Res<Place, AllocError> {
        displacement ::= address.displacement;
        below        :: usize = 0;
        base         :: usize = 1;
        self.operand(address.base).match({
            Reg(n)    => { base = n; },
            Addr(off) => {
                base  = 5;
                below = off;
            },
            other     => { self.into(1, other).try(); },
        });
        index ::= NONE;
        (address.index != NONE).then(() {
            self.operand(address.index).match({
                Reg(n) => { index = n; },
                Imm(c) => (c > -268435456 && c < 268435456).match({
                    true  => { displacement = displacement + c * scale_of(
                        address.scale
                    ); },
                    false => {
                        self.into(2, Operand.Imm(c)).try();
                        index = 2;
                    },
                }),
                other  => {
                    self.into(2, other).try();
                    index = 2;
                },
            });
        });
        Ok(Place(
            base: base,
            index: index,
            scale: address.scale,
            displacement: displacement,
            above: offset,
            below: below
        ))
    }

    // The displacement is written as a sum the assembler folds.
    put_place = (self :: @Self, place: Place) Res<AllocError> {
        self.out.fmt(
            "{}+{}-{}",
            place.displacement,
            place.above,
            place.below
        ).try();
        (place.index == NONE).match({
            true  => self.out.fmt("({})", register_name(place.base, 8)),
            false => self.out.fmt(
                "({},{},{})",
                register_name(place.base, 8),
                register_name(place.index, 8),
                place.scale
            ),
        })
    }

    load = (self :: @Self, slot: usize, register: str) Res<AllocError> {
        self.plan.home(slot).match({
            Register(r)  => (!register.eq(pool_register(r))).match({
                true  => self.out.fmt(
                    "    movq {}, {}\n",
                    pool_register(r),
                    register
                ),
                false => Ok,
            }),
            Fixed(value) => self.immediate(value, register),
            Pointer(s)   => self.slot_address(s, register),
            Frame        => self.out.fmt(
                "    movq -{}(%rbp), {}\n",
                self.offset(slot),
                register
            ),
        })
    }

    store = (self :: @Self, slot: usize, register: str) Res<AllocError> {
        self.plan.home(slot).match({
            Register(r) => (!register.eq(pool_register(r))).then(() {
                self.out.fmt(
                    "    movq {}, {}\n",
                    register,
                    pool_register(r)
                ).try();
            }),
            // Only the defining `Constant` or `AddressOf` writes a fixed
            // or pointer slot, and it emits nothing.
            Fixed(_)    => (),
            Pointer(_)  => (),
            Frame       => self.out.fmt(
                "    movq {}, -{}(%rbp)\n",
                register,
                self.offset(slot)
            ).try(),
        });
        Ok
    }

    immediate = (self :: @Self, value: i64, register: str) Res<AllocError> {
        (value == 0).match({
            true  => self.out.fmt(
                "    xorl {}, {}\n",
                low32(register),
                low32(register)
            ),
            false => (value >= -2147483648 && value <= 2147483647).match({
                true  => self.out.fmt("    movq ${}, {}\n", value, register),
                false => self.out.fmt("    movabsq ${}, {}\n", value, register),
            }),
        })
    }

    // Move incoming arguments to their homes. Register-to-register moves
    // form a parallel assignment (a home may be another argument's incoming
    // register), ordered so no source is overwritten before it is read and
    // with %rax breaking any cycle.
    parameters = (self :: @Self, function: Func, first: usize) Res<AllocError> {
        sources ::= self.alloc.Vec<usize>();
        targets ::= self.alloc.Vec<usize>();
        Range(0, function.parameters).loop((i) {
            position = i + first;
            (position < REGISTER_ARGUMENTS).then(() {
                incoming = argument_number(position);
                self.plan.home(i).match({
                    Register(r) => {
                        sources.add(incoming).try();
                        targets.add(register_number(r)).try();
                    },
                    Frame       => self.out.fmt(
                        "    movq {}, -{}(%rbp)\n",
                        hardware_name(incoming),
                        self.offset(i)
                    ).try(),
                    // A parameter is never a constant or an address.
                    _           => (),
                });
            });
        });
        parallel_moves(self.alloc, self.out, sources, targets).try();
        Range(0, function.parameters).loop((i) {
            position = i + first;
            (position >= REGISTER_ARGUMENTS).then(() {
                self.plan.home(i).match({
                    Register(r) => self.out.fmt(
                        "    movq {}(%rbp), {}\n",
                        16 + (position - REGISTER_ARGUMENTS) * 8,
                        pool_register(r)
                    ).try(),
                    Frame       => self.out.fmt(
                        "    movq {}(%rbp), %rax\n    movq %rax, -{}(%rbp)\n",
                        16 + (position - REGISTER_ARGUMENTS) * 8,
                        self.offset(i)
                    ).try(),
                    _           => (),
                });
            });
        });
        Ok
    }

    // Branch to an out-of-line trap when `condition` holds after a check;
    // "mp" makes the branch unconditional.
    trap_if = (self :: @Self, condition: str, span: Span, what: TrapKind)
              Res<AllocError> {
        label = self.label();
        site  = self.location(label, span, what).try();
        self.traps.add(site).try();
        self.out.fmt("    j{} .Lza_trap{}\n", condition, label)
    }

    location = (self :: @Self, label: usize, span: Span, what: TrapKind)
               Res<TrapSite, AllocError> {
        data = self.label();
        self.scratch.clear();
        self.scratch.add(span.file).try();
        self.scratch.fmt(
            ":{}:{}: trap: {}\n",
            span.start.line,
            span.start.col,
            trap_message(what)
        ).try();
        self.data.fmt(".Lza_d{}:\n", data).try();
        self.data_bytes(self.scratch.view()).try();
        Ok(TrapSite(
            label: label,
            location: data,
            length: self.scratch.view().len,
            what: what
        ))
    }

    trap_stubs = (self :: @Self) Res<AllocError> {
        self.traps.loop((site) {
            self.out.fmt(
                ".Lza_trap{}:\n    leaq .Lza_d{}(%rip), %rdi\n    movl ${}, %esi\n    jmp za_trap\n",
                site.label,
                site.location,
                site.length
            ).try();
        });
        self.traps.clear();
    }

    // The runtime: buffered standard output, decimal integers, traps and
    // process exit, all through raw Linux system calls. Every routine may
    // clobber caller-saved registers; generated code keeps no value live in
    // a register across these calls.
    runtime = (self :: @Self) Res<AllocError> {
        write = linux_x86_64(Sys.Write).value_or(0);
        exit  = linux_x86_64(Sys.ExitGroup).value_or(0);
        // exit(edi status): run the exit hook installed in za_globals, if
        // any, then flush standard output and end the process.
        self.out.fmt(
            "za_exit:\n    pushq %rdi\n    subq $8, %rsp\n    movq za_globals(%rip), %rax\n    testq %rax, %rax\n    jz 1f\n    call *%rax\n1:\n    call za_flush\n    addq $8, %rsp\n    popq %rdi\n    movl ${}, %eax\n    syscall\n    ud2\n",
            exit
        ).try();
        // write_all(edi fd, rsi bytes, rdx length): retry EINTR and short
        // writes; any other failure abandons the remaining bytes.
        self.out.fmt(
            "za_write_all:\n0:\n    testq %rdx, %rdx\n    jz 2f\n    movl ${}, %eax\n    syscall\n    cmpq $-4, %rax\n    je 0b\n    testq %rax, %rax\n    jle 2f\n    addq %rax, %rsi\n    subq %rax, %rdx\n    jmp 0b\n2:\n    ret\n",
            write
        ).try();
        // Standard output is one buffer shared by every thread. `za_out_lock`
        // is a futex word (0 free, 1 held, 2 held with waiters); `_held`
        // routines run with it taken.
        self.out.add(
            "za_lock_out:\n    movl $1, %ecx\n    xorl %eax, %eax\n    lock cmpxchgl %ecx, za_out_lock(%rip)\n    jnz 1f\n    ret\n1:\n    movl $2, %eax\n    xchgl %eax, za_out_lock(%rip)\n    testl %eax, %eax\n    jz 2f\n    leaq za_out_lock(%rip), %rdi\n    movl $128, %esi\n    movl $2, %edx\n    xorl %r10d, %r10d\n    movl $202, %eax\n    syscall\n    jmp 1b\n2:\n    ret\nza_unlock_out:\n    xorl %eax, %eax\n    xchgl %eax, za_out_lock(%rip)\n    cmpl $2, %eax\n    jne 1f\n    leaq za_out_lock(%rip), %rdi\n    movl $129, %esi\n    movl $1, %edx\n    movl $202, %eax\n    syscall\n1:\n    ret\n"
        ).try();
        self.out.add(
            "za_flush:\n    subq $8, %rsp\n    call za_lock_out\n    call za_flush_held\n    call za_unlock_out\n    addq $8, %rsp\n    ret\nza_out:\n    pushq %rdi\n    pushq %rsi\n    subq $8, %rsp\n    call za_lock_out\n    movq 8(%rsp), %rsi\n    movq 16(%rsp), %rdi\n    call za_out_held\n    call za_unlock_out\n    addq $24, %rsp\n    ret\n"
        ).try();
        self.out.add(
            "za_flush_held:\n    movq za_out_len(%rip), %rdx\n    testq %rdx, %rdx\n    jz 1f\n    movl $1, %edi\n    leaq za_out_buf(%rip), %rsi\n    call za_write_all\n    movq $0, za_out_len(%rip)\n1:\n    ret\n"
        ).try();
        // out_held(rdi bytes, rsi length) appends to the stdout buffer. A
        // run larger than the buffer is written through after a flush.
        self.out.add(
            "za_out_held:\n    movq za_out_len(%rip), %rax\n    leaq (%rax,%rsi), %rcx\n    cmpq $65536, %rcx\n    jbe 1f\n    pushq %rdi\n    pushq %rsi\n    call za_flush_held\n    popq %rsi\n    popq %rdi\n    cmpq $65536, %rsi\n    jbe 0f\n    movq %rsi, %rdx\n    movq %rdi, %rsi\n    movl $1, %edi\n    jmp za_write_all\n0:\n    xorl %eax, %eax\n1:\n    leaq za_out_buf(%rip), %rcx\n    addq %rax, %rcx\n    addq %rsi, %rax\n    movq %rax, za_out_len(%rip)\n    movq %rdi, %r8\n    movq %rcx, %rdi\n    movq %rsi, %rcx\n    movq %r8, %rsi\n    rep movsb\n    ret\n"
        ).try();
        // map(rdi bytes) -> rax: anonymous pages behind a 16-byte header
        // holding the mapping's length; null on failure. unmap(rdi).
        self.out.fmt(
            "za_map:\n    leaq 16(%rdi), %rsi\n    pushq %rsi\n    xorl %edi, %edi\n    movl $3, %edx\n    movl $34, %r10d\n    movq $-1, %r8\n    xorl %r9d, %r9d\n    movl ${}, %eax\n    syscall\n    popq %rsi\n    cmpq $-4096, %rax\n    ja 1f\n    movq %rsi, (%rax)\n    addq $16, %rax\n    ret\n1:\n    xorl %eax, %eax\n    ret\nza_unmap:\n    testq %rdi, %rdi\n    jz 1f\n    subq $16, %rdi\n    movq (%rdi), %rsi\n    movl ${}, %eax\n    syscall\n1:\n    ret\n",
            linux_x86_64(Sys.Mmap).value_or(0),
            linux_x86_64(Sys.Munmap).value_or(0)
        ).try();
        // emit(rdi bytes, rsi length, edx descriptor): buffered stdout,
        // written-through stderr.
        self.out.add(
            "za_emit:\n    cmpl $1, %edx\n    je za_out\n    movq %rsi, %rdx\n    movq %rdi, %rsi\n    movl $2, %edi\n    jmp za_write_all\n"
        ).try();
        // print_i64(rdi, esi descriptor) / print_u64: digits are produced
        // backwards into a stack buffer. Negation of the minimum is exact as
        // unsigned.
        self.out.add(
            "za_print_u64:\n    xorl %r9d, %r9d\n    movq %rdi, %rax\n    jmp 1f\nza_print_i64:\n    movq %rdi, %r9\n    movq %rdi, %rax\n    testq %rax, %rax\n    jns 1f\n    negq %rax\n1:\n    movl %esi, %r10d\n    subq $40, %rsp\n    leaq 32(%rsp), %rsi\n    movl $10, %ecx\n2:\n    xorl %edx, %edx\n    divq %rcx\n    addb $48, %dl\n    decq %rsi\n    movb %dl, (%rsi)\n    testq %rax, %rax\n    jnz 2b\n    testq %r9, %r9\n    jns 3f\n    decq %rsi\n    movb $45, (%rsi)\n3:\n    leaq 32(%rsp), %rdx\n    subq %rsi, %rdx\n    movq %rsi, %rdi\n    movq %rdx, %rsi\n    movl %r10d, %edx\n    call za_emit\n    addq $40, %rsp\n    ret\n"
        ).try();
        // clone(rdi flags, rsi stack top, rdx control block): start a thread
        // sharing this process on the given stack. The kernel stores the new
        // thread's id in the block's word at 24 and clears it (waking futex
        // waiters) when the thread exits; %fs of the new thread points at
        // the block. The child calls block.entry(block.arg) and then leaves
        // with exit, ending only itself. %r9 carries the block across the
        // system call into the child.
        self.out.fmt(
            "za_clone:\n    movq %rdx, %r9\n    leaq 24(%r9), %rdx\n    leaq 24(%r9), %r10\n    movq %r9, %r8\n    movl ${}, %eax\n    syscall\n    testq %rax, %rax\n    jz 1f\n    ret\n1:\n    xorl %ebp, %ebp\n    movq 8(%r9), %rax\n    movq 16(%r9), %rdi\n    call *%rax\n    xorl %edi, %edi\n    movl ${}, %eax\n    syscall\n    ud2\n",
            linux_x86_64(Sys.Clone).value_or(0),
            LINUX_X86_64_EXIT
        ).try();
        // trap(rdi/rsi report): flush stdout first so output preceding the
        // fault is not lost, then report on stderr and exit 134.
        self.out.fmt(
            "za_trap:\n    movq %rdi, %r12\n    movq %rsi, %r13\n    call za_flush\n    movl $2, %edi\n    movq %r12, %rsi\n    movq %r13, %rdx\n    call za_write_all\n    movl $134, %edi\n    movl ${}, %eax\n    syscall\n    ud2\n",
            exit
        ).try();
        self.data.add(
            "za_true:\n    .ascii \"true\"\nza_false:\n    .ascii \"false\"\n"
        )
    }
}

descriptor = (stream: Stream) usize { stream.match({ Out => 1, Err => 2 }) }

is_block = (ty: Scalar) bool { ty.match({ Block(_) => true, _ => false }) }

stored_size = (ty: Scalar) usize {
    ty.match({ Block(l) => l.size, _ => 8 })
}

at_least_word = (
    size : usize
) usize { (size < 8).match({ true => 8, false => size }) }

round_up = (value: usize, align: usize) usize {
    ((value + align - 1) / align) * align
}

// The most negative value of a signed class, as a 64-bit immediate.
minimum = (ty: Scalar) i64 {
    ty.match({
        I8  => -128,
        I16 => -32768,
        I32 => -2147483648,
        _   => i64.MIN,
    })
}

REGISTER_ARGUMENTS: usize = 6

// Allocatable registers in pool order: caller-saved %rsi %rdi %r8-%r11,
// then callee-saved %rbx %r12-%r15. Numbers are hardware encodings.
register_number = (r: usize) usize {
    r.match({
        0 => 6,
        1 => 7,
        2 => 8,
        3 => 9,
        4 => 10,
        5 => 11,
        6 => 3,
        7 => 12,
        8 => 13,
        9 => 14,
        _ => 15,
    })
}

pool_register = (r: usize) str { hardware_name(register_number(r)) }

hardware_name = (n: usize) str {
    n.match({
        0  => "%rax",
        1  => "%rcx",
        2  => "%rdx",
        3  => "%rbx",
        4  => "%rsp",
        5  => "%rbp",
        6  => "%rsi",
        7  => "%rdi",
        8  => "%r8",
        9  => "%r9",
        10 => "%r10",
        11 => "%r11",
        12 => "%r12",
        13 => "%r13",
        14 => "%r14",
        _  => "%r15",
    })
}

// The 32-bit name of a 64-bit register.
low32 = (register: str) str {
    register.match({
        "%rax" => "%eax",
        "%rcx" => "%ecx",
        "%rdx" => "%edx",
        "%rbx" => "%ebx",
        "%rsi" => "%esi",
        "%rdi" => "%edi",
        "%r8"  => "%r8d",
        "%r9"  => "%r9d",
        "%r10" => "%r10d",
        "%r11" => "%r11d",
        "%r12" => "%r12d",
        "%r13" => "%r13d",
        "%r14" => "%r14d",
        _      => "%r15d",
    })
}

argument_number = (index: usize) usize {
    index.match({ 0 => 7, 1 => 6, 2 => 2, 3 => 1, 4 => 8, _ => 9 })
}

// Emit `targets[i] = sources[i]` for every i at once. Targets are
// distinct and no target is %rax.
parallel_moves = (
    alloc   : Alloc,
    out     :: String,
    sources :: Vec<usize>,
    targets :: Vec<usize>
)
                 Res<AllocError> {
    done ::= alloc.Vec<bool>();
    sources.loop(
        (h, i, s) { done.add(s == targets.get(i).value_or(s)).try(); }
    );
    pending ::= 0;
    done.loop((d) { (!d).then(() { pending = pending + 1; }); });
    loop(() { pending > 0 }, (h) {
        progressed ::= false;
        Range(0, sources.len).loop((i) {
            (!done.get(i).value_or(true)).then(() {
                target = targets.get(i).value_or(0);
                blocked ::= false;
                Range(0, sources.len).loop((j) {
                    (j != i && !done.get(j).value_or(true) && sources.get(j).value_or(0) == target)
                        .then(() { blocked = true; });
                });
                (!blocked).then(() {
                    out.fmt(
                        "    movq {}, {}\n",
                        hardware_name(sources.get(i).value_or(0)),
                        hardware_name(target)
                    ).try();
                    done.set(i, true);
                    pending    = pending - 1;
                    progressed = true;
                });
            });
        });
        (!progressed).then(() {
            // Every pending target is still to be read: park one in %rax.
            Range(0, sources.len).loop((ih, i) {
                (!done.get(i).value_or(true)).then(() {
                    target = targets.get(i).value_or(0);
                    out.fmt("    movq {}, %rax\n", hardware_name(target)).try();
                    Range(0, sources.len).loop((j) {
                        (!done.get(j).value_or(true) && sources.get(j).value_or(0) == target)
                            .then(() { sources.set(j, 0); });
                    });
                    ih.break();
                });
            });
        });
    });
    Ok
}

// Called only for the register prefix; later arguments use the stack.
argument_register = (index: usize) str {
    index.match({
        0 => "%rdi",
        1 => "%rsi",
        2 => "%rdx",
        3 => "%rcx",
        4 => "%r8",
        _ => "%r9",
    })
}

// The Linux system-call convention replaces %rcx with %r10.
system_register = (index: usize) str {
    index.match({
        0 => "%rdi",
        1 => "%rsi",
        2 => "%rdx",
        3 => "%r10",
        4 => "%r8",
        _ => "%r9",
    })
}

// An instruction operand: a hardware register (by encoding), a frame slot
// (its distance below %rbp), an immediate, or the address of a frame slot.
Operand = { Reg: usize | Mem: usize | Imm: i64 | Addr: usize }

is_immediate = (
    value : Operand
) bool { value.match({ Imm(_) => true, _ => false }) }
is_memory = (
    value : Operand
) bool { value.match({ Mem(_) => true, _ => false }) }
is_register = (
    value : Operand
) bool { value.match({ Reg(_) => true, _ => false }) }

same_register = (value: Operand, register: usize) bool {
    value.match({ Reg(n) => n == register, _ => false })
}

suffix = (size: usize) str {
    size.match({ 1 => "b", 2 => "w", 4 => "l", _ => "q" })
}

// Whether an immediate encodes in a `size`-byte instruction: 64-bit
// instructions sign-extend a 32-bit immediate.
fits_immediate = (value: i64, size: usize) bool {
    size.match({
        8 => value >= -2147483648 && value <= 2147483647,
        4 => value >= -2147483648 && value <= 4294967295,
        2 => value >= -32768 && value <= 65535,
        _ => value >= -128 && value <= 255,
    })
}

// The condition code for `left op right`, mirrored when the operands were
// exchanged.
condition = (op: Op, is_signed: bool, swapped: bool) str {
    op.match({
        Equal     => "e",
        NotEqual  => "ne",
        Less      => swapped.match({ false => is_signed.match({ true => "l", false => "b" }), true => is_signed.match({ true => "g", false => "a" }) }),
        LessEqual => swapped.match({ false => is_signed.match({ true => "le", false => "be" }), true => is_signed.match({ true => "ge", false => "ae" }) }),
        Greater   => swapped.match({ false => is_signed.match({ true => "g", false => "a" }), true => is_signed.match({ true => "l", false => "b" }) }),
        _         => swapped.match({ false => is_signed.match({ true => "ge", false => "ae" }), true => is_signed.match({ true => "le", false => "be" }) }),
    })
}

inverse = (cc: str) str {
    cc.match({
        "e"  => "ne",
        "ne" => "e",
        "l"  => "ge",
        "ge" => "l",
        "le" => "g",
        "g"  => "le",
        "b"  => "ae",
        "ae" => "b",
        "be" => "a",
        _    => "be",
    })
}

register_name = (n: usize, size: usize) str {
    size.match({
        8 => hardware_name(n),
        4 => n.match({
            0 => "%eax", 1 => "%ecx", 2 => "%edx", 3 => "%ebx", 4 => "%esp", 5 => "%ebp",
            6 => "%esi", 7 => "%edi", 8 => "%r8d", 9 => "%r9d", 10 => "%r10d", 11 => "%r11d",
            12 => "%r12d", 13 => "%r13d", 14 => "%r14d", _ => "%r15d",
        }),
        2 => n.match({
            0 => "%ax", 1 => "%cx", 2 => "%dx", 3 => "%bx", 4 => "%sp", 5 => "%bp",
            6 => "%si", 7 => "%di", 8 => "%r8w", 9 => "%r9w", 10 => "%r10w", 11 => "%r11w",
            12 => "%r12w", 13 => "%r13w", 14 => "%r14w", _ => "%r15w",
        }),
        _ => n.match({
            0 => "%al", 1 => "%cl", 2 => "%dl", 3 => "%bl", 4 => "%spl", 5 => "%bpl",
            6 => "%sil", 7 => "%dil", 8 => "%r8b", 9 => "%r9b", 10 => "%r10b", 11 => "%r11b",
            12 => "%r12b", 13 => "%r13b", 14 => "%r14b", _ => "%r15b",
        }),
    })
}

is_address = (
    value : Operand
) bool { value.match({ Addr(_) => true, _ => false }) }

// A place in memory: a register plus `above` minus `below` bytes.
Spot = { register: usize, above: usize, below: usize }

// A memory operand in hardware registers; `index` is NONE when absent.
// The displacement is `displacement + above - below`.
Place = { base: usize, index: usize, scale: usize, displacement: i64, above: usize, below: usize }

commutative = (op: Op) bool {
    op.match({ Sub => false, WrapSub => false, _ => true })
}

// The operand size of an arithmetic or bit instruction on class `ty`: 32-bit
// classes use 32-bit instructions except for signed bit operations (which
// must keep the sign extension) and checked multiplies (which check the
// 64-bit product).
operation_size = (op: Op, ty: Scalar) usize {
    w = width(ty);
    op.match({
        And => (signed(ty) || w == 8).match({ true => 8, false => 4 }),
        Or  => (signed(ty) || w == 8).match({ true => 8, false => 4 }),
        Xor => (signed(ty) || w == 8).match({ true => 8, false => 4 }),
        Mul => 8,
        _   => (w == 4).match({ true => 4, false => 8 }),
    })
}

// Operations `arithmetic` renders, on classes whose width is the operand
// size, so a memory operand of that width reads exactly the value.
foldable = (op: Op, ty: Scalar) bool {
    applies = op.match({
        Add => true, Sub => true, WrapAdd => true, WrapSub => true, WrapMul => true,
        And => true, Or => true, Xor => true,
        Mul => width(ty) == 8 && signed(ty),
        _   => false,
    });
    applies && (width(ty) == 4 || width(ty) == 8)
}
