// GNU-syntax x86-64 Linux assembly for the scalar IR. The executable is
// freestanding: its own `_start`, raw `syscall` instructions and a small
// runtime emitted beside the program. No C library is linked. Each value
// has an eight-byte stack slot; calls preserve those slots without spilling.

Alloc, AllocError = std.mem
str, String = std.text
Range = std.core
Vec = std.collections
Program, Func, Instruction, Terminator, Unary, Binary, Invocation, Print = gen.gen_ir
Span = std.ast
Target = gen.gen_asm
Sys, linux_x86_64 = gen.gen_asm_sys

// This target fixes the instruction set, object dialect, OS and calling ABI:
// x86-64, ELF with GNU assembler syntax, Linux system calls, System V calls.
X86_64Linux* = { alloc*: Alloc }

X86_64Linux.impl(Target, {
    emit = (self: @Self, program: Program) Res<String, AllocError> {
        writer ::= Assembly(
            out: self.alloc.String().try(),
            data: self.alloc.String().try(),
            traps: self.alloc.Vec<TrapSite>(),
            next_label: 0
        );
        writer.program(program).try();
        Ok(writer.out)
    }
})

// An out-of-line trap: the check branches here only when it fails, so the
// location and message loads stay off the fast path.
TrapSite = { label: usize, location: usize, message: str }

Assembly = {
    out :: String,
    // Read-only literals are collected and emitted once after the code.
    data :: String,
    traps :: Vec<TrapSite>,
    next_label :: usize,
    // Stack slots remain authoritative. This fact holds only within one
    // basic block and is discarded across calls that do not store a result.
    eax_slot :: Res<usize> = None,

    program = (self :: @Self, program: Program) Res<(), AllocError> {
        self.out.add(".text\n").try();
        program.functions.loop((h, i, function) {
            self.function(i, function).try();
        });
        // The kernel enters with an aligned stack holding argc; `call`
        // leaves the entry function its System V alignment.
        self.out.fmt(
            ".globl _start\n.type _start, @function\n_start:\n    xorl %ebp, %ebp\n    andq $-16, %rsp\n    call za_fn_{}\n    movl %eax, %edi\n    jmp za_exit\n.size _start, .-_start\n",
            program.entry
        ).try();
        self.runtime().try();
        self.out.add(".section .rodata\n").try();
        self.out.add(self.data.view()).try();
        self.out.add(
            ".bss\n.p2align 4\nza_out_buf:\n    .zero 65536\nza_out_len:\n    .zero 8\n"
        ).try();
        self.out.add(".section .note.GNU-stack,\"\",@progbits\n")
    }

    function = (self :: @Self, id: usize, function: Func)
               Res<(), AllocError> {
        frame = ((function.slots.len * 8 + 15) / 16) * 16;
        self.out.fmt(
            ".type za_fn_{}, @function\nza_fn_{}:\n    pushq %rbp\n    movq %rsp, %rbp\n",
            id,
            id
        ).try();
        (frame > 0).then(() {
            self.out.fmt("    subq ${}, %rsp\n", frame).try();
        });
        Range(0, function.parameters).loop((i) {
            (i < REGISTER_ARGUMENTS).match({
                true  => self.store(i, argument_register(i)),
                false => {
                    self.out.fmt(
                        "    movl {}(%rbp), %eax\n",
                        16 + (i - REGISTER_ARGUMENTS) * 8
                    ).try();
                    self.store(i, "%eax")
                },
            }).try();
        });
        function.blocks.loop((h, block_id, block) {
            self.eax_slot = None;
            self.out.fmt(".Lza_f{}_b{}:\n", id, block_id).try();
            block.code.loop(
                (instruction) { self.instruction(instruction).try(); }
            );
            self.terminator(id, block.exit).try();
        });
        self.trap_stubs().try();
        self.out.fmt(".size za_fn_{}, .-za_fn_{}\n", id, id)
    }

    instruction = (self :: @Self, instruction: Instruction)
                  Res<(), AllocError> {
        instruction.match({
            Constant(value)    => {
                self.eax_slot.when_ok((slot) {
                    (slot == value.out).then(() { self.eax_slot = None; });
                });
                self.out.fmt(
                    "    movl ${}, -{}(%rbp)\n",
                    value.value,
                    slot_offset(value.out)
                )
            },
            Copy(value)        => {
                self.load(value.source, "%eax").try();
                self.store(value.out, "%eax")
            },
            UnaryValue(value)  => self.unary(value),
            BinaryValue(value) => self.binary(value),
            Invoke(call)       => self.call(call),
            PrintValue(value)  => self.print(value),
            Text(bytes)        => self.text(bytes),
        })
    }

    terminator = (self :: @Self, function: usize, exit: Terminator)
                 Res<(), AllocError> {
        exit.match({
            Return(value)  => {
                self.load(value, "%eax").try();
                self.out.add("    leave\n    ret\n")
            },
            Jump(block)    => self.out.fmt(
                "    jmp .Lza_f{}_b{}\n",
                function,
                block
            ),
            Branch(branch) => {
                self.load(branch.value, "%eax").try();
                self.out.fmt(
                    "    testl %eax, %eax\n    jnz .Lza_f{}_b{}\n    jmp .Lza_f{}_b{}\n",
                    function,
                    branch.yes,
                    function,
                    branch.no
                )
            },
        })
    }

    unary = (self :: @Self, value: Unary) Res<(), AllocError> {
        self.load(value.input, "%eax").try();
        value.op.match({
            Neg => {
                self.out.add("    negl %eax\n").try();
                self.trap_if("o", value.span, OVERFLOW)
            },
            Not => self.out.add(
                "    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n"
            ),
        }).try();
        self.store(value.out, "%eax")
    }

    binary = (self :: @Self, value: Binary) Res<(), AllocError> {
        self.load(value.left, "%eax").try();
        self.load(value.right, "%ecx").try();
        value.op.match({
            Add          => {
                self.out.add("    addl %ecx, %eax\n").try();
                self.trap_if("o", value.span, OVERFLOW)
            },
            Sub          => {
                self.out.add("    subl %ecx, %eax\n").try();
                self.trap_if("o", value.span, OVERFLOW)
            },
            Mul          => {
                self.out.add("    imull %ecx, %eax\n").try();
                self.trap_if("o", value.span, OVERFLOW)
            },
            Div          => self.divide(value.span, "%eax"),
            Rem          => self.divide(value.span, "%edx"),
            Equal        => self.compare("e"),
            NotEqual     => self.compare("ne"),
            Less         => self.compare("l"),
            LessEqual    => self.compare("le"),
            Greater      => self.compare("g"),
            GreaterEqual => self.compare("ge"),
        }).try();
        self.store(value.out, "%eax")
    }

    compare = (self :: @Self, condition: str) Res<(), AllocError> {
        self.out.fmt(
            "    cmpl %ecx, %eax\n    set{} %al\n    movzbl %al, %eax\n",
            condition
        )
    }

    // Zero divisors and MIN / -1 trap at the operator; idiv would fault.
    divide = (self :: @Self, span: Span, result_register: str)
             Res<(), AllocError> {
        self.out.add("    testl %ecx, %ecx\n").try();
        self.trap_if("z", span, DIVIDE_BY_ZERO).try();
        label = self.label();
        self.out.fmt(
            "    cmpl $-1, %ecx\n    jne .Lza_t{}\n    cmpl $-2147483648, %eax\n",
            label
        ).try();
        self.trap_if("e", span, OVERFLOW).try();
        self.out.fmt(".Lza_t{}:\n    cltd\n    idivl %ecx\n", label).try();
        (!result_register.eq("%eax")).then(() {
            self.out.fmt("    movl {}, %eax\n", result_register).try();
        });
        Ok(())
    }

    call = (self :: @Self, call: Invocation) Res<(), AllocError> {
        stacked = (call.args.len > REGISTER_ARGUMENTS).match({
            true  => call.args.len - REGISTER_ARGUMENTS,
            false => 0,
        });
        padding = stacked % 2;
        (padding > 0).then(() { self.out.add("    subq $8, %rsp\n").try(); });
        // Stack arguments occupy eight-byte ABI slots, rightmost first. The
        // padding precedes them so the first stacked argument remains at rsp.
        Range(0, stacked).loop((offset) {
            call.args.get(call.args.len - offset - 1).when_ok((value) {
                self.load(value, "%eax").try();
                self.out.add("    cltq\n    pushq %rax\n").try();
            });
        });
        call.args.loop((h, i, value) {
            (i == REGISTER_ARGUMENTS).then(() { h.break(); });
            self.load(value, argument_register(i)).try();
        });
        self.out.fmt("    call za_fn_{}\n", call.function).try();
        (stacked > 0).then(() {
            self.out.fmt("    addq ${}, %rsp\n", (stacked + padding) * 8).try();
        });
        self.store(call.out, "%eax")
    }

    print = (self :: @Self, value: Print) Res<(), AllocError> {
        value.ty.match({
            I32  => {
                self.load(value.value, "%eax").try();
                self.out.add("    movslq %eax, %rdi\n    call za_print_i64\n")
            },
            Bool => {
                self.load(value.value, "%eax").try();
                self.out.add(
                    "    leaq za_false(%rip), %rdi\n    leaq za_true(%rip), %rdx\n    xorl %esi, %esi\n    testl %eax, %eax\n    cmovneq %rdx, %rdi\n    setz %sil\n    addl $4, %esi\n    call za_out\n"
                )
            },
            Unit => self.text("()"),
        }).try();
        self.eax_slot = None;
        Ok(())
    }

    text = (self :: @Self, bytes: str) Res<(), AllocError> {
        (!bytes.is_empty()).then(() {
            label = self.literal(bytes).try();
            self.out.fmt(
                "    leaq .Lza_d{}(%rip), %rdi\n    movl ${}, %esi\n    call za_out\n",
                label,
                bytes.len
            ).try();
        });
        self.eax_slot = None;
        Ok(())
    }

    // Numeric bytes preserve quotes, backslashes, embedded NULs and UTF-8
    // without introducing an assembler string-escaping dialect.
    literal = (self :: @Self, bytes: str) Res<usize, AllocError> {
        label = self.label();
        self.data.fmt(".Lza_d{}:\n", label).try();
        self.data_bytes(bytes).try();
        Ok(label)
    }

    data_bytes = (self :: @Self, bytes: str) Res<(), AllocError> {
        (!bytes.is_empty()).then(() {
            self.data.add("    .byte ").try();
            bytes.loop((h, i, byte) {
                (i > 0).then(() { self.data.add(",").try(); });
                self.data.fmt("{}", byte).try();
            });
            self.data.add("\n").try();
        });
        Ok(())
    }

    label = (self :: @Self) usize {
        label           = self.next_label;
        self.next_label = label + 1;
        label
    }

    load = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        cached = self.eax_slot.match({ Ok(value) => value == slot, None => false });
        cached.match({
            true  => {
                (!register.eq("%eax")).then(() {
                    self.out.fmt("    movl %eax, {}\n", register).try();
                });
            },
            false => {
                self.out.fmt(
                    "    movl -{}(%rbp), {}\n",
                    slot_offset(slot),
                    register
                ).try();
                register.eq("%eax").then(() { self.eax_slot = Ok(slot); });
            },
        });
        Ok(())
    }

    store = (self :: @Self, slot: usize, register: str) Res<(), AllocError> {
        self.out.fmt(
            "    movl {}, -{}(%rbp)\n",
            register,
            slot_offset(slot)
        ).try();
        self.eax_slot = register.eq("%eax").match({ true => Ok(slot), false => None });
        Ok(())
    }

    // Branch to an out-of-line trap when `condition` holds after a check.
    trap_if = (self :: @Self, condition: str, span: Span, message: str)
              Res<(), AllocError> {
        label    = self.label();
        location = self.location(span).try();
        self.traps.add(TrapSite(
            label: label,
            location: location,
            message: message
        )).try();
        self.out.fmt("    j{} .Lza_trap{}\n", condition, label)
    }

    location = (self :: @Self, span: Span) Res<usize, AllocError> {
        label = self.label();
        self.data.fmt(".Lza_d{}:\n", label).try();
        self.data_bytes(span.file).try();
        self.data.fmt(
            "    .ascii \":{}:{}: trap: \"\n.Lza_d{}_end:\n",
            span.start.line,
            span.start.col,
            label
        ).try();
        Ok(label)
    }

    trap_stubs = (self :: @Self) Res<(), AllocError> {
        self.traps.loop((site) {
            self.out.fmt(
                ".Lza_trap{}:\n    leaq .Lza_d{}(%rip), %rdi\n    movl $(.Lza_d{}_end - .Lza_d{}), %esi\n    leaq za_{}(%rip), %rdx\n    movl $(za_{}_end - za_{}), %ecx\n    jmp za_trap\n",
                site.label,
                site.location,
                site.location,
                site.location,
                site.message,
                site.message,
                site.message
            ).try();
        });
        self.traps.clear();
        Ok(())
    }

    // The runtime: buffered standard output, decimal integers, traps and
    // process exit, all through raw Linux system calls. Every routine may
    // clobber caller-saved registers; generated code keeps no value live in
    // a register across these calls.
    runtime = (self :: @Self) Res<(), AllocError> {
        write     = linux_x86_64(Sys.Write).value_or(0);
        exit      = linux_x86_64(Sys.ExitGroup).value_or(0);
        self.out.fmt(
            "za_exit:\n    pushq %rdi\n    call za_flush\n    popq %rdi\n    movl ${}, %eax\n    syscall\n    ud2\n",
            exit
        ).try();
        // write_all(edi fd, rsi bytes, rdx length): retry EINTR and short
        // writes; any other failure abandons the remaining bytes.
        self.out.fmt(
            "za_write_all:\n0:\n    testq %rdx, %rdx\n    jz 2f\n    movl ${}, %eax\n    syscall\n    cmpq $-4, %rax\n    je 0b\n    testq %rax, %rax\n    jle 2f\n    addq %rax, %rsi\n    subq %rax, %rdx\n    jmp 0b\n2:\n    ret\n",
            write
        ).try();
        self.out.add(
            "za_flush:\n    movq za_out_len(%rip), %rdx\n    testq %rdx, %rdx\n    jz 1f\n    movl $1, %edi\n    leaq za_out_buf(%rip), %rsi\n    call za_write_all\n    movq $0, za_out_len(%rip)\n1:\n    ret\n"
        ).try();
        // out(rdi bytes, rsi length) appends to the stdout buffer. A run
        // larger than the buffer is written through after a flush.
        self.out.add(
            "za_out:\n    movq za_out_len(%rip), %rax\n    leaq (%rax,%rsi), %rcx\n    cmpq $65536, %rcx\n    jbe 1f\n    pushq %rdi\n    pushq %rsi\n    call za_flush\n    popq %rsi\n    popq %rdi\n    cmpq $65536, %rsi\n    jbe 0f\n    movq %rsi, %rdx\n    movq %rdi, %rsi\n    movl $1, %edi\n    jmp za_write_all\n0:\n    xorl %eax, %eax\n1:\n    leaq za_out_buf(%rip), %rcx\n    addq %rax, %rcx\n    addq %rsi, %rax\n    movq %rax, za_out_len(%rip)\n    movq %rdi, %r8\n    movq %rcx, %rdi\n    movq %rsi, %rcx\n    movq %r8, %rsi\n    rep movsb\n    ret\n"
        ).try();
        // print_i64(rdi) / print_u64(rdi): digits are produced backwards
        // into a stack buffer. Negation of the minimum is exact as unsigned.
        self.out.add(
            "za_print_u64:\n    xorl %r9d, %r9d\n    movq %rdi, %rax\n    jmp 1f\nza_print_i64:\n    movq %rdi, %r9\n    movq %rdi, %rax\n    testq %rax, %rax\n    jns 1f\n    negq %rax\n1:\n    subq $40, %rsp\n    leaq 32(%rsp), %rsi\n    movl $10, %ecx\n2:\n    xorl %edx, %edx\n    divq %rcx\n    addb $48, %dl\n    decq %rsi\n    movb %dl, (%rsi)\n    testq %rax, %rax\n    jnz 2b\n    testq %r9, %r9\n    jns 3f\n    decq %rsi\n    movb $45, (%rsi)\n3:\n    leaq 32(%rsp), %rdx\n    subq %rsi, %rdx\n    movq %rsi, %rdi\n    movq %rdx, %rsi\n    call za_out\n    addq $40, %rsp\n    ret\n"
        ).try();
        // trap(rdi/rsi location, rdx/rcx message): flush stdout first so
        // output preceding the fault is not lost, then exit 134.
        self.out.fmt(
            "za_trap:\n    movq %rdi, %r12\n    movq %rsi, %r13\n    movq %rdx, %r14\n    movq %rcx, %r15\n    call za_flush\n    movl $2, %edi\n    movq %r12, %rsi\n    movq %r13, %rdx\n    call za_write_all\n    movl $2, %edi\n    movq %r14, %rsi\n    movq %r15, %rdx\n    call za_write_all\n    movl $134, %edi\n    movl ${}, %eax\n    syscall\n    ud2\n",
            exit
        ).try();
        self.data.add(
            "za_true:\n    .ascii \"true\"\nza_false:\n    .ascii \"false\"\nza_overflow:\n    .ascii \"integer overflow\\n\"\nza_overflow_end:\nza_divzero:\n    .ascii \"divide by zero\\n\"\nza_divzero_end:\n"
        )
    }
}

OVERFLOW: str = "overflow"
DIVIDE_BY_ZERO: str = "divzero"

slot_offset = (slot: usize) usize { (slot + 1) * 8 }

REGISTER_ARGUMENTS: usize = 6

// Called only for the register prefix; later scalar arguments use the stack.
argument_register = (index: usize) str {
    index.match({
        0 => "%edi",
        1 => "%esi",
        2 => "%edx",
        3 => "%ecx",
        4 => "%r8d",
        _ => "%r9d",
    })
}
