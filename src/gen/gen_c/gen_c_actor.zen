// C lowering for std.actor, over the Zen runtime in std.actor.actor_runtime
// (compiled into the program like any other std module). What depends on
// the actor's type is generated here: the record the runtime keeps after
// its own header (the state, the Context every turn receives, the Arena
// behind Context.alloc), one turn entry per behaviour send site, and the
// started and stopped entries. Each entry is `(record, payload)`, called
// by the runtime through its code address on whichever worker runs the
// actor; only that worker enters the state, so a turn never overlaps
// another.

{ AllocError } = std.mem
{ Vec } = std.collections
{ Res, Ok, Err, None, Range } = std.core
{ str, String } = std.text
{ ExprId, Access, Call, Function, Member } = std.ast
{ Def } = sema.sema_def
{ ImplId } = sema.sema_id
{ TyId, TyNamed } = sema.sema_ty
{ Ctx } = sema.sema_check
{ Inst } = sema.sema_inst
{ Emit } = gen.gen_emit
{ sym_gen, sym_member, sym_variant, RES_PATH } = gen.gen_name
{ CBackend } = gen.gen_c.gen_c_state
{ Site, site_of, method_sig, member_symbol } = gen.gen_c.gen_c_member
{ has_body, decl_name, impl_member } = gen.gen_c.gen_c_impl
{ impl_bound_type } = sema.sema_supply
{ ctype, field_of, pointee, request_type } = gen.gen_c.gen_c_type
{ expr, ty_of } = gen.gen_c.gen_c_expr
{ recv_inst, sub } = gen.gen_c.gen_c_mono
{ temp, payload_type, write_assign_ok, write_assign_err } = gen.gen_c.gen_c_flow
{ call_symbol } = gen.gen_c.gen_c_sink
{ write_assign_ok_unit } = gen.gen_c.gen_c_flow
{ passes_address } = gen.gen_c.gen_c_borrow
{ ty_at } = sema.sema_cand
{ fat_value } = gen.gen_c.gen_c_fat
{ arg_text } = gen.gen_c.gen_c_arg
{ def_type, type_of } = sema.sema_type
{ unsupported } = gen.gen_c.gen_c_report

BehaviorHit* = {
    site*: Site,
    f*: Function,
    mi*: usize,
}

// Source and inferred facts for one resolved Env.spawn call. They become
// available as one set when Ref<A> has been recognised and remain fixed until
// the result expression is delivered.
ActorSpawn = {
    id: ExprId,
    call: Call,
    access: Access,
    receiver_ty: TyId,
    result_ty: TyId,
    ref_ty: TyId,
    actor_ty: TyId,
    ctx: Ctx,
}

// Runtime layout types are discovered together before actor records or
// lifecycle callbacks can be emitted. This snapshot is the input to both.
ActorSpawnLayout = {
    spawn: ActorSpawn,
    context_ty: TyId,
    arena_ty: TyId,
    state_ty: TyId,
    alloc_ty: TyId,
}

// Generated names born at one actor site and consumed together while its
// value is emitted. Their backing strings live in the backend allocator.
ActorLifecycle = {
    layout: ActorSpawnLayout,
    record: str,
    started: str,
    stopped: str,
    receive: str,
}

// Recognition uses declaration ownership as well as spelling. A user-defined
// Ref or Actor is an ordinary type.
ref_of_actor* = (be :: CBackend, ty: TyId) Res<Res<TyId>, AllocError> {
    be.types().at(ty).match({
        Named(n) => be.actor_ref(n),
        _        => Ok(None),
    })
}

actor_ref = (be :: CBackend, n: TyNamed) Res<Res<TyId>, AllocError> {
    (n.name.eq("Ref")
        && be.world().module_name(n.decl).eq("std.actor.actor_core")).match({
        false => Ok(None),
        true  => Ok(n.args.get(0)),
    })
}

actor_named_type = (be :: CBackend, name: str) Res<Res<TyId>, AllocError> {
    be.named_type_at(name, actor_path(name))
}

named_type_at = (be :: CBackend, name: str, qname: str)
                Res<Res<TyId>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.world().exported_named(name, defs).try();
    found ::= be.alloc.Vec<TyId>();
    defs.loop((h, d) {
        (d.name.eq(name) && d.qname.eq(qname)).then(() {
            found.add(be.check.def_type(d).try()).try();
            h.break();
        });
    });
    Ok(found.get(0))
}

actor_path = (name: str) str {
    name.match({
        "Actor"           => "std.actor.actor_core.Actor",
        "ActorError"      => "std.actor.actor_core.ActorError",
        "ActorStartError" => "std.actor.actor_core.ActorStartError",
        "Context"         => "std.actor.actor_context.Context",
        _                 => "",
    })
}

behavior_of* = (be :: CBackend, actor: TyId, name: str)
               Res<Res<BehaviorHit>, AllocError> {
    found ::= be.alloc.Vec<BehaviorHit>();
    site_of(be, actor).try().match({
        None  => Ok,
        Ok(s) => be.behavior_at(s, name, found),
    }).try();
    Ok(found.get(0))
}

// The sends that reach `receive`, the runtime entry each calls, and how
// many arguments come before the message (send_after's delay).
send_verb = (name: str) bool { name.is_in(["send", "try_send", "send_after"]) }

send_entry = (name: str) str {
    name.match({ "try_send" => "actor_offer", "send_after" => "actor_after", _ => "actor_send" })
}

leading_args = (name: str) usize { name.eq(
    "send_after"
).match({ true => 1, false => 0 }) }

// The behavior a send through a Ref names: a send verb without a behavior
// of that name reaches the actor's `receive`.
message_behavior = (be :: CBackend, actor: TyId, name: str)
                   Res<Res<BehaviorHit>, AllocError> {
    be.behavior_of(actor, name).try().match({
        Ok(hit) => Ok(Ok(hit)),
        None    => send_verb(name).match({
            true  => be.behavior_of(actor, "receive"),
            false => Ok(None),
        }),
    })
}

behavior_at = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    found :: Vec<BehaviorHit>
) Res<AllocError> {
    ids ::= be.alloc.Vec<ImplId>();
    be.world().impls_named(be.tree, be.decl_name_at(s), ids).try();
    ids.loop((h, id) { be.behavior_in(s, name, id, found).try() });
    Ok
}

decl_name_at = (be: CBackend, s: Site) str {
    decl_name(be, s.decl)
}

behavior_in = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    id    : ImplId,
    found :: Vec<BehaviorHit>
) Res<AllocError> {
    ((id.decl.module == s.decl.module) && (found.len == 0)).match({
        false => Ok,
        true  => be.world().impl_at(be.tree, id).match({
            None   => Ok,
            Ok(im) => be.behavior_members(s, name, im.members, found),
        }),
    })
}

behavior_members = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    ms    : Vec<Member>,
    found :: Vec<BehaviorHit>
) Res<AllocError> {
    ms.loop((h, m) {
        m.kind.match({
            Function(f) => (f.name.text.eq(name) && has_body(f)).then(() {
                found.add(BehaviorHit(
                    site: s,
                    f: f,
                    mi: s.decl.module.to_usize(),
                )).try();
                h.break();
            }),
            _           => (),
        });
    });
    Ok
}

// The runtime's slice descriptor (std.actor.actor_runtime.SLICE_WORDS): one
// str or byte-buffer argument copied after the payload record, and where
// its pointer and length go in the copy.
emit_actor_floor* = (be :: CBackend, out :: Emit) Res<AllocError> {
    be.uses_actor().match({
        false => Ok,
        true  => {
            out.say(
                "typedef struct zg_actor_slice { size_t data_offset; size_t len_offset; const unsigned char *data; size_t len; } zg_actor_slice;"
            ).try();
            out.line()
        },
    })
}

emit_actor_defs* = (be :: CBackend, out :: Emit) Res<AllocError> {
    Range(0, be.actor_def_count()).loop((h, i) {
        be.actor_def_at(i).match({
            None    => Ok,
            Ok(def) => out.say(def.view()),
        }).try();
    });
    (be.actor_def_count() > 0).then(() { out.line().try() });
    Ok
}

// The C symbol of a std.actor.actor_runtime entry point, queued so its body
// (and everything it reaches) is emitted.
runtime_symbol = (be :: CBackend, name: str) Res<String, AllocError> {
    be.std_symbol("std.actor.actor_runtime", name)
}

std_symbol = (be :: CBackend, module: str, name: str) Res<String, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.world().exported_named(name, defs).try();
    sym   ::= be.alloc.String().try();
    qname ::= be.alloc.String("{module}.{name}").try();
    defs.find((d) { d.qname.eq(qname.view()) }).match({
        None    => Err(AllocError.OutOfMemory),
        Ok(def) => be.call_symbol(def, sym),
    }).try();
    Ok(sym)
}

// Ref.stop only closes admission: the actor drains what it accepted, runs
// stopped, and is freed.
lower_actor_stop* = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    be.lower_ref_call("actor_stop", a, rty, ctx, out)
}

lower_actor_join* = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    be.lower_ref_call("actor_join", a, rty, ctx, out)
}

lower_ref_call = (
    be      :: CBackend,
    runtime : str,
    a       : Access,
    rty     : TyId,
    ctx     : Ctx,
    out     :: String
) Res<AllocError> {
    be.need_actor();
    symbol = be.runtime_symbol(runtime).try();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    id ::= be.alloc.String().try();
    id.sym_member("id").try();
    be.fmt("{}(({}).{});\n", symbol.view(), recv.view(), id.view()).try();
    out.add("0")
}

// A behavior call on Ref<A> becomes one copied mailbox record and returns as
// soon as that record is accepted. The generated turn function is the only
// code that enters a: it reads state/context from the runtime header and calls
// the statically resolved behavior body on the actor's worker.
ActorSend = {
    id: ExprId,
    call: Call,
    access: Access,
    receiver_ty: TyId,
    actor_ty: TyId,
    hit: BehaviorHit,
    ctx: Ctx,

    lower = (self: @Self, be :: CBackend, out :: String)
            Res<AllocError> {
        be.need_actor();
        // In a generic body the call's sema type still names type variables.
        ret = be.sub(be.check.type_of(self.id, self.ctx).try()).try();
        be.request_type(ret).try();
        inst = be.recv_inst(self.actor_ty).try();
        sig ::= be.alloc.Vec<TyId>();
        be.method_sig(
            self.actor_ty,
            self.hit.site.decl,
            self.hit.f,
            self.hit.mi,
            inst,
            sig
        ).try();
        self.transferable(be, sig).try().match({
            false => be.unsupported(
                self.id,
                "an actor payload without a concrete mailbox transfer",
                out
            ),
            true  => self.write_message(be, ret, sig, out),
        })
    }

    // The destination representation matters too. An implicit union or bound
    // conversion must not hide a direct buffer/slice from mailbox descriptors.
    transferable = (self: @Self, be :: CBackend, sig: Vec<TyId>)
                   Res<bool, AllocError> {
        safe ::= true;
        skip = leading_args(self.access.name.text);
        self.call.args.loop((h, i, arg) {
            (i >= skip).then(() {
                formal = sig.get(i - skip + 2).ok_or(AllocError.OutOfMemory).try();
                actual = be.ty_of(arg.value, self.ctx, formal).try();
                buffer = be.check.actor_byte_buffer(formal);
                safe   = safe && (buffer == be.check.actor_byte_buffer(actual))
                    && (is_direct_str(be, formal) == is_direct_str(be, actual))
                    && (buffer || !be.check.actor_payload_unsafe(formal).try());
            });
        });
        Ok(safe)
    }

    write_message = (self: @Self, be :: CBackend, ret: TyId, sig: Vec<TyId>, out :: String)
                    Res<AllocError> {
        n       = be.next_actor_site();
        payload = be.write_message_record(n, sig).try();
        turn    = be.write_turn(
            self.actor_ty,
            self.hit,
            n,
            payload.view(),
            sig
        ).try();
        entry ::= be.alloc.String().try();
        entry.fmt("&{}", turn.view()).try();
        ActorSendEmission(
            id: self.id,
            call: self.call,
            access: self.access,
            ctx: self.ctx,
            receiver_ty: self.receiver_ty,
            result_ty: ret,
            signature: sig,
            payload: payload.view(),
            turn: entry.view(),
        ).write(be, out)
    }
}

// The turn entry for a send site, or for the receive turn an actor starts
// with: find the state and Context in the
// record, move byte buffers into the actor's allocator, call the
// behaviour. The record's first two fields are the same at every spawn
// site of the actor type, so a view of them is enough here.
write_turn = (
    be       :: CBackend,
    actor_ty : TyId,
    hit      : BehaviorHit,
    n        : usize,
    payload  : str,
    sig      : Vec<TyId>
) Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_turn", n).try();
    sym        = be.behavior_symbol(actor_ty, hit).try();
    context_ty = sig.get(1).match({
        Ok(t) => t,
        None  => TyId(index: 0),
    });
    view       = be.write_record_view(n, actor_ty).try();
    context    = be.context_helper(context_ty).try();
    proto ::= be.alloc.String().try();
    proto.fmt(
        "{}void {}(uint8_t *zg_rec, uint8_t *zg_raw)",
        be.linkage(),
        name.view()
    ).try();
    body ::= be.alloc.String().try();
    body.fmt("    {} *zg_self = ({} *)zg_rec;\n", view.view(), view.view()).try();
    body.fmt("    {payload} *zg_msg = ({payload} *)zg_raw;\n").try();
    context_c ::= be.alloc.String().try();
    be.ctype(context_ty, context_c).try();
    body.fmt(
        "    {} *zg_ctx = {}((uint8_t *)&zg_self->zg_arena);\n",
        context_c.view(),
        context.view()
    ).try();
    Range(2, sig.len).loop((h, i) {
        be.check.actor_byte_buffer(sig.ty_at(i)).then(() {
            be.write_buffer_move(i - 2, sig.ty_at(i), context_ty, body).try();
        });
    });
    // The context and message live for the whole call, so a borrowed
    // parameter (gen_c_borrow.zen) takes them by address exactly as a
    // `::` one does.
    context_by_address = be.passes_address(hit.f, 1, sig.ty_at(1)).try();
    body.fmt("    (void)({}(&zg_self->zg_state, ", sym.view()).try();
    context_by_address.match({
        true  => body.add("zg_ctx"),
        false => body.add("*zg_ctx"),
    }).try();
    Range(2, sig.len).loop((h, i) {
        body.add(", ").try();
        be.passes_address(hit.f, i, sig.ty_at(i)).try().then(() {
            body.add("&").try()
        });
        body.add("zg_msg->zg_arg").try();
        body.write_usize(i - 2).try();
    });
    body.add("));\n").try();
    be.add_function(name, proto, body).try();
    be.name_turn(name.view(), actor_ty, hit.f.name.text).try();
    Ok(name)
}

// The trace names a turn `Type.behaviour`: one line of the name lister.
name_turn = (be :: CBackend, turn: str, actor: TyId, behavior: str)
            Res<AllocError> {
    named = be.runtime_symbol("actor_name").try();
    owner ::= be.alloc.String().try();
    site_of(be, actor).try().match({
        None  => owner.add("actor"),
        Ok(s) => owner.add(be.decl_name_at(s)),
    }).try();
    line ::= be.alloc.String().try();
    line.fmt(
        "    {}((size_t)&{}, (size_t)\"{}.{}\", {});\n",
        named.view(),
        turn,
        owner.view(),
        behavior,
        owner.len() + 1 + behavior.len
    ).try();
    be.add_actor_name(line)
}

// The program's name lister, passed to actor_new: the runtime calls it
// once, when the trace opens. Emitted only when an actor is spawned.
NAMES_SYMBOL: str = "zg_actor_names"

write_actor_names* = (be :: CBackend) Res<AllocError> {
    be.uses_actor_names().then(() {
        name ::= be.alloc.String().try();
        name.add(NAMES_SYMBOL).try();
        proto ::= be.alloc.String().try();
        proto.fmt(
            "{}void {}(uint8_t *zg_a, uint8_t *zg_b)",
            be.linkage(),
            NAMES_SYMBOL
        ).try();
        body ::= be.alloc.String().try();
        body.add("    (void)zg_a;\n    (void)zg_b;\n").try();
        Range(0, be.actor_name_count()).loop((h, i) {
            be.actor_name_at(i).match({
                None     => Ok,
                Ok(line) => body.add(line.view()),
            }).try();
        });
        be.add_function(name, proto, body).try();
    });
    Ok
}

ActorSendEmission = {
    id: ExprId,
    call: Call,
    access: Access,
    ctx: Ctx,
    receiver_ty: TyId,
    result_ty: TyId,
    signature: Vec<TyId>,
    payload: str,
    turn: str,

    write = (self: @Self, be :: CBackend, out :: String)
            Res<AllocError> {
        recv_code ::= be.alloc.String().try();
        expr(be, self.access.base, self.ctx, self.receiver_ty, recv_code).try();
        recv = be.temp(self.receiver_ty, "actor_ref").try();
        be.set_line(recv.view(), recv_code.view()).try();
        message ::= be.fresh_name("actor_payload").try();
        be.fmt(
            "{} {} = ({}){{0}};\n",
            self.payload,
            message.view(),
            self.payload
        ).try();
        slices = direct_str_count(be, self.signature);
        slice_name ::= be.fresh_name("actor_slices").try();
        (slices > 0).then(() {
            count ::= be.alloc.String().try();
            count.write_usize(slices).try();
            be.fmt(
                "zg_actor_slice {}[{}];\n",
                slice_name.view(),
                count.view()
            ).try();
        });
        slice :: usize = 0;
        skip = leading_args(self.access.name.text);
        delay ::= be.alloc.String().try();
        self.call.args.loop((h, i, arg) {
            (i < skip).then(() {
                ms ::= be.alloc.String().try();
                expr(
                    be,
                    arg.value,
                    self.ctx,
                    be.check.types.prim("u64").try(),
                    ms
                ).try();
                delay.fmt("(uint64_t)({}), ", ms.view()).try();
            });
            (i >= skip).then(() {
                j  = i - skip;
                ty = self.signature.get(j + 2).match({
                    Ok(t) => t,
                    None  => TyId(index: 0),
                });
                value ::= be.alloc.String().try();
                expr(be, arg.value, self.ctx, ty, value).try();
                line ::= be.alloc.String().try();
                line.fmt("{}.zg_arg", message.view()).try();
                line.write_usize(j).try();
                line.fmt(" = {};\n", value.view()).try();
                be.write(line.view()).try();
                (is_direct_str(be, ty) || be.check.actor_byte_buffer(ty)).then(() {
                    be.write_slice_descriptor(
                        slice_name.view(),
                        slice,
                        message.view(),
                        j,
                        be.check.actor_byte_buffer(ty)
                    ).try();
                    slice = slice + 1;
                });
            });
        });
        id ::= be.alloc.String().try();
        id.sym_member("id").try();
        status ::= be.fresh_name("actor_send").try();
        descriptors = (slices > 0).match({
            true  => slice_name.view(),
            false => "NULL",
        });
        count ::= be.alloc.String().try();
        count.write_usize(slices).try();
        send = be.runtime_symbol(send_entry(self.access.name.text)).try();
        be.fmt(
            "int {} = {}({}.{}, {}(size_t){}, (uint8_t *)&{}, sizeof({}), (uint8_t *){}, {});\n",
            status.view(),
            send.view(),
            recv.view(),
            id.view(),
            delay.view(),
            self.turn,
            message.view(),
            message.view(),
            descriptors,
            count.view()
        ).try();
        dst = be.temp(self.result_ty, "actor_result").try();
        be.fmt("if ({} == 0) {{\n", status.view()).try();
        be.indent();
        be.write_assign_ok_unit(self.result_ty, dst.view()).try();
        be.dedent();
        be.fmt("}} else if ({} == 1) {{\n", status.view()).try();
        be.indent();
        be.write_assign_err(self.result_ty, "Closed", dst.view()).try();
        be.dedent();
        be.writeln("} else {").try();
        be.indent();
        be.write_assign_err(self.result_ty, "Full", dst.view()).try();
        be.dedent();
        be.writeln("}").try();
        out.add(dst.view())
    }
}

lower_actor_send* = (
    be       :: CBackend,
    id       : ExprId,
    c        : Call,
    a        : Access,
    rty      : TyId,
    actor_ty : TyId,
    ctx      : Ctx,
    out      :: String
) Res<AllocError> {
    be.message_behavior(actor_ty, a.name.text).try().match({
        None    => send_verb(a.name.text).match({
            true  => be.lower_message_send(id, c, a, rty, actor_ty, ctx, out),
            false => be.unsupported(id, "an unresolved actor behavior", out),
        }),
        Ok(hit) => ActorSend(
            id: id,
            call: c,
            access: a,
            receiver_ty: rty,
            actor_ty: actor_ty,
            hit: hit,
            ctx: ctx,
        ).lower(be, out),
    })
}

// `send` on a message-typed Ref: the payload is the one message and the
// turn is 0, so the actor runs the receive turn it started with.
lower_message_send = (
    be      :: CBackend,
    id      : ExprId,
    c       : Call,
    a       : Access,
    rty     : TyId,
    message : TyId,
    ctx     : Ctx,
    out     :: String
) Res<AllocError> {
    be.need_actor();
    ret = be.sub(be.check.type_of(id, ctx).try()).try();
    be.request_type(ret).try();
    sig ::= be.alloc.Vec<TyId>();
    [message, message, message].loop((h, ty) { sig.add(ty).try() });
    be.check.actor_payload_unsafe(message).try().match({
        true  => be.unsupported(
            id,
            "an actor payload without a concrete mailbox transfer",
            out
        ),
        false => {
            n       = be.next_actor_site();
            payload = be.write_message_record(n, sig).try();
            ActorSendEmission(
                id: id,
                call: c,
                access: a,
                ctx: ctx,
                receiver_ty: rty,
                result_ty: ret,
                signature: sig,
                payload: payload.view(),
                turn: "0",
            ).write(be, out)
        },
    })
}

// `r.watch(to, done, failed)`: both messages are copied into runtime blocks
// now, so nothing is built while r ends; actor_watch takes them with the
// two Refs and answers Ok, or Full when memory ran out.
lower_actor_watch* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    be.need_actor();
    ret = be.sub(be.check.type_of(id, ctx).try()).try();
    be.request_type(ret).try();
    to      = c.args.get(0).ok_or(AllocError.OutOfMemory).try();
    done    = c.args.get(1).ok_or(AllocError.OutOfMemory).try();
    failed  = c.args.get(2).ok_or(AllocError.OutOfMemory).try();
    message = be.sub(be.check.type_of(done.value, ctx).try()).try();
    be.check.actor_payload_unsafe(message).try().match({
        true  => be.unsupported(
            id,
            "an actor payload without a concrete mailbox transfer",
            out
        ),
        false => {
            recv_code ::= be.alloc.String().try();
            expr(be, a.base, ctx, rty, recv_code).try();
            recv = be.temp(rty, "actor_ref").try();
            be.set_line(recv.view(), recv_code.view()).try();
            to_ty = be.sub(be.check.type_of(to.value, ctx).try()).try();
            to_code ::= be.alloc.String().try();
            expr(be, to.value, ctx, to_ty, to_code).try();
            watcher = be.temp(to_ty, "actor_ref").try();
            be.set_line(watcher.view(), to_code.view()).try();
            sig ::= be.alloc.Vec<TyId>();
            [message, message, message].loop((h, ty) { sig.add(ty).try() });
            n       = be.next_actor_site();
            payload = be.write_message_record(n, sig).try();
            first   = be.message_block(
                payload.view(),
                message,
                done.value,
                ctx
            ).try();
            second  = be.message_block(
                payload.view(),
                message,
                failed.value,
                ctx
            ).try();
            field ::= be.alloc.String().try();
            field.sym_member("id").try();
            status ::= be.fresh_name("actor_watch").try();
            watch = be.runtime_symbol("actor_watch").try();
            be.fmt(
                "int {} = {}({}.{}, {}.{}, {}, {});\n",
                status.view(),
                watch.view(),
                recv.view(),
                field.view(),
                watcher.view(),
                field.view(),
                first.view(),
                second.view()
            ).try();
            dst = be.temp(ret, "actor_result").try();
            be.fmt("if ({} == 0) {{\n", status.view()).try();
            be.indent();
            be.write_assign_ok_unit(ret, dst.view()).try();
            be.dedent();
            be.fmt("}} else if ({} == 1) {{\n", status.view()).try();
            be.indent();
            be.write_assign_err(ret, "Closed", dst.view()).try();
            be.dedent();
            be.writeln("} else {").try();
            be.indent();
            be.write_assign_err(ret, "Full", dst.view()).try();
            be.dedent();
            be.writeln("}").try();
            out.add(dst.view())
        },
    })
}

// One message of type `ty` copied into a runtime block by actor_message;
// the C name of the block's address.
message_block = (
    be      :: CBackend,
    payload : str,
    ty      : TyId,
    value   : ExprId,
    ctx     : Ctx
)
                Res<String, AllocError> {
    record ::= be.fresh_name("actor_payload").try();
    be.fmt("{} {} = ({}){{0}};\n", payload, record.view(), payload).try();
    code ::= be.alloc.String().try();
    expr(be, value, ctx, ty, code).try();
    be.fmt("{}.zg_arg0 = {};\n", record.view(), code.view()).try();
    buffer = be.check.actor_byte_buffer(ty);
    copied = buffer || is_direct_str(be, ty);
    slices ::= be.fresh_name("actor_slices").try();
    copied.then(() {
        be.fmt("zg_actor_slice {}[1];\n", slices.view()).try();
        be.write_slice_descriptor(
            slices.view(),
            0,
            record.view(),
            0,
            buffer
        ).try();
    });
    block ::= be.fresh_name("actor_block").try();
    make = be.runtime_symbol("actor_message").try();
    be.fmt(
        "size_t {} = {}((size_t)0, (uint8_t *)&{}, sizeof({}), (uint8_t *){}, {});\n",
        block.view(),
        make.view(),
        record.view(),
        record.view(),
        copied.match({ true => slices.view(), false => "NULL" }),
        copied.match({ true => "1", false => "0" })
    ).try();
    Ok(block)
}

write_message_record = (be :: CBackend, n: usize, sig: Vec<TyId>)
                       Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_message", n).try();
    text ::= be.alloc.String().try();
    text.fmt("typedef struct {} {{\n", name.view()).try();
    (sig.len <= 2).then(() {
        text.add("    unsigned char zg_unit;\n").try();
    });
    Range(2, sig.len).loop((h, i) {
        ty = sig.get(i).match({
            Ok(t) => t,
            None  => TyId(index: 0),
        });
        be.request_type(ty).try();
        text.add("    ").try();
        be.ctype(ty, text).try();
        text.add(" zg_arg").try();
        text.write_usize(i - 2).try();
        text.add(";\n").try();
    });
    text.fmt("}} {};", name.view()).try();
    be.add_actor_def(text).try();
    Ok(name)
}

direct_str_count = (be: CBackend, sig: Vec<TyId>) usize {
    count ::= 0;
    Range(2, sig.len).loop((h, i) {
        sig.get(i).match({
            None   => (),
            Ok(ty) => (is_direct_str(be, ty) || be.check.actor_byte_buffer(ty)).then(() { count = count + 1; }),
        });
    });
    count
}

is_direct_str = (be: CBackend, ty: TyId) bool {
    be.types().at(ty).match({
        Prim(p) => p.name.eq("str"),
        _       => false,
    })
}

write_slice_descriptor = (
    be      :: CBackend,
    slices  : str,
    at      : usize,
    message : str,
    arg     : usize,
    buffer  : bool
) Res<AllocError> {
    data_field = buffer.match({ true => be.actor_field(
        "data"
    ).try(), false => "data" });
    len_field  = buffer.match({ true => be.actor_field(
        "len"
    ).try(), false => "len" });
    s_at ::= be.alloc.String().try();
    s_at.write_usize(at).try();
    a_at ::= be.alloc.String().try();
    a_at.write_usize(arg).try();
    be.fmt(
        "{}[{}].data_offset = (size_t)((unsigned char *)&{}.zg_arg{}.{} - (unsigned char *)&{});\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        data_field,
        message
    ).try();
    be.fmt(
        "{}[{}].len_offset = (size_t)((unsigned char *)&{}.zg_arg{}.{} - (unsigned char *)&{});\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        len_field,
        message
    ).try();
    be.fmt(
        "{}[{}].data = {}.zg_arg{}.{};\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        data_field
    ).try();
    be.fmt(
        "{}[{}].len = {}.zg_arg{}.{};\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        len_field
    )
}

// Env.spawn creates the concrete actor record, the actor-owned arena and the
// Context handed to every turn. The worker is started only after all fields
// are initialized, so started observes a complete actor.
lower_actor_spawn* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    // Substitute the instantiation being lowered: a spawn inside a generic
    // function must record the concrete actor state type.
    ret = be.sub(be.check.type_of(id, ctx).try()).try();
    be.payload_type(ret, "Ok").match({
        None       => be.unsupported(id, "Env.spawn without a Ref result", out),
        Ok(ref_ty) => be.ref_of_actor(ref_ty).try().match({
            None         => be.unsupported(
                id,
                "Env.spawn returning a non-actor Ref",
                out
            ),
            Ok(actor_ty) => be.resolve_actor_spawn(
                ActorSpawn(
                    id: id,
                    call: c,
                    access: a,
                    receiver_ty: rty,
                    result_ty: ret,
                    ref_ty: ref_ty,
                    actor_ty: actor_ty,
                    ctx: ctx,
                ),
                out
            ),
        }),
    })
}

// `env.actor_mem(mem)`, as gen_lower_actor's `use_actor_mem`: the
// implementor copied into memory the runtime never hands back, and the
// runtime given a Mem on that copy.
lower_actor_mem* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    be.need_actor();
    ret = be.sub(be.check.type_of(id, ctx).try()).try();
    be.named_type_at("Mem", "std.mem.mem_arena.Mem").try().match({
        None       => be.unsupported(id, "std.mem.Mem", out),
        Ok(mem_ty) => c.args.get(0).match({
            None      => be.unsupported(id, "env.actor_mem without a Mem", out),
            Ok(first) => {
                given = be.sub(be.check.type_of(first.value, ctx).try()).try();
                [ret, mem_ty, given].loop((h, ty) { be.request_type(ty).try() });
                value = be.temp(given, "actor_mem").try();
                text ::= be.alloc.String().try();
                be.arg_text(c, 0, given, ctx, text).try();
                be.set_line(value.view(), text.view()).try();
                dst    = be.temp(ret, "t").try();
                handle = be.temp(mem_ty, "actor_mem").try();
                (given == mem_ty).match({
                    true  => {
                        be.set_line(handle.view(), value.view()).try();
                        be.write_use_mem(ret, handle.view(), dst.view()).try();
                    },
                    false => be.write_kept_mem(
                        KeptMem(
                            ret: ret,
                            mem_ty: mem_ty,
                            given: given,
                            value: value.view(),
                            handle: handle.view(),
                            dst: dst.view(),
                        )
                    ).try(),
                });
                out.add(dst.view())
            },
        }),
    })
}

KeptMem = {
    ret: TyId,
    mem_ty: TyId,
    given: TyId,
    value: str,
    handle: str,
    dst: str,
}

write_kept_mem = (be :: CBackend, k: KeptMem) Res<AllocError> {
    keep = be.runtime_symbol("actor_keep").try();
    kept ::= be.fresh_name("actor_kept").try();
    g    ::= be.alloc.String().try();
    be.ctype(k.given, g).try();
    be.fmt(
        "{} *{} = ({} *){}(sizeof({}));\n",
        g.view(),
        kept.view(),
        g.view(),
        keep.view(),
        g.view()
    ).try();
    be.fmt("if (!{}) {{\n", kept.view()).try();
    be.indent();
    be.write_assign_err(k.ret, "OutOfMemory", k.dst).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.fmt("*{} = {};\n", kept.view(), k.value).try();
    fat ::= be.alloc.String().try();
    be.fat_value(kept.view(), k.given, k.mem_ty, fat).try();
    be.set_line(k.handle, fat.view()).try();
    be.write_use_mem(k.ret, k.handle, k.dst).try();
    be.dedent();
    be.writeln("}")
}

write_use_mem = (be :: CBackend, ret: TyId, handle: str, dst: str)
                Res<AllocError> {
    take = be.runtime_symbol("actor_use_mem").try();
    be.fmt(
        "if ({}(sizeof({}), (uint8_t *)&{})) {{\n",
        take.view(),
        handle,
        handle
    ).try();
    be.indent();
    be.write_assign_ok_unit(ret, dst).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.write_assign_err(ret, "Unavailable", dst).try();
    be.dedent();
    be.writeln("}")
}

resolve_actor_spawn = (be :: CBackend, spawn: ActorSpawn, out :: String)
                      Res<AllocError> {
    be.actor_named_type("Context").try().match({
        None           => be.unsupported(spawn.id, "std.actor.Context", out),
        Ok(context_ty) => be.named_type_at(
            "Arena",
            "std.mem.mem_arena.Arena"
        ).try().match({
            None         => be.unsupported(spawn.id, "std.mem.Arena", out),
            Ok(arena_ty) => be.field_of(arena_ty, "state").try().match({
                None          => be.unsupported(
                    spawn.id,
                    "Arena without state",
                    out
                ),
                Ok(state_ptr) => pointee(be, state_ptr).match({
                    None         => be.unsupported(
                        spawn.id,
                        "Arena state that is not a pointer",
                        out
                    ),
                    Ok(state_ty) => be.field_of(context_ty, "alloc")
                        .try().match({
                        None         => be.unsupported(
                            spawn.id,
                            "Context without Alloc",
                            out
                        ),
                        Ok(alloc_ty) => {
                            value = be.write_actor_spawn(ActorSpawnLayout(
                                spawn: spawn,
                                context_ty: context_ty,
                                arena_ty: arena_ty,
                                state_ty: state_ty,
                                alloc_ty: alloc_ty,
                            )).try();
                            out.add(value.view())
                        },
                    }),
                }),
            }),
        }),
    })
}

write_actor_spawn = (be :: CBackend, layout: ActorSpawnLayout)
                    Res<String, AllocError> {
    be.need_actor();
    [
        layout.spawn.result_ty,
        layout.spawn.ref_ty,
        layout.spawn.actor_ty,
        layout.context_ty,
        layout.arena_ty,
        layout.state_ty,
        layout.alloc_ty,
    ].loop((h, ty) { be.request_type(ty).try() });
    n = be.next_actor_site();
    rec ::= be.alloc.String().try();
    sym_gen(rec, "actor", n).try();
    be.write_actor_record(layout, rec.view()).try();
    started = be.write_started_callback(
        n,
        rec.view(),
        layout.spawn.actor_ty
    ).try();
    stopped = be.write_stopped_callback(
        n,
        rec.view(),
        layout.spawn.actor_ty,
        layout.arena_ty
    ).try();
    receive = be.write_receive_turn(n, layout.spawn.actor_ty).try();
    be.write_spawn_value(ActorLifecycle(
        layout: layout,
        record: rec.view(),
        started: started.view(),
        stopped: stopped.view(),
        receive: receive.view(),
    ))
}

// The record after the runtime's header: the state, the Arena behind
// Context.alloc, and that Arena's state. A turn builds its Context from the
// Arena (`context_helper`), so the record holds no copy of the Env.
write_actor_record = (
    be     :: CBackend,
    layout : ActorSpawnLayout,
    name   : str
) Res<AllocError> {
    a ::= be.alloc.String().try();
    be.ctype(layout.spawn.actor_ty, a).try();
    ar ::= be.alloc.String().try();
    be.ctype(layout.arena_ty, ar).try();
    st ::= be.alloc.String().try();
    be.ctype(layout.state_ty, st).try();
    text ::= be.alloc.String().try();
    text.fmt(
        "typedef struct {name} {{ {} zg_state; {} zg_arena; {} zg_arena_state; }} {name};",
        a.view(),
        ar.view(),
        st.view()
    ).try();
    be.add_actor_def(text)
}

// What a turn entry sees of the record: its first two fields, laid out as
// in every record of the actor type.
write_record_view = (be :: CBackend, n: usize, actor: TyId)
                    Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_view", n).try();
    arena_ty = be.named_type_at("Arena", "std.mem.mem_arena.Arena").try().ok_or(AllocError.OutOfMemory).try();
    be.request_type(actor).try();
    be.request_type(arena_ty).try();
    a ::= be.alloc.String().try();
    be.ctype(actor, a).try();
    ar ::= be.alloc.String().try();
    be.ctype(arena_ty, ar).try();
    text ::= be.alloc.String().try();
    text.fmt(
        "typedef struct {} {{ {} zg_state; {} zg_arena; }} {};",
        name.view(),
        a.view(),
        ar.view(),
        name.view()
    ).try();
    be.add_actor_def(text).try();
    Ok(name)
}

// The Context a turn receives, built per thread instead of stored in every
// actor: the process Env (one copy, kept by the runtime, copied into the
// thread's Context once) and the running actor's allocator. Only one turn
// runs on a thread at a time and the Context is borrowed for the call, so
// one per thread is enough.
context_helper = (be :: CBackend, context: TyId) Res<String, AllocError> {
    name ::= be.alloc.String("zg_actor_context").try();
    be.need_thunk(name.view()).try().then(() {
        env_ty   = be.field_of(context, "env").try().ok_or(AllocError.OutOfMemory).try();
        alloc_ty = be.field_of(context, "alloc").try().ok_or(AllocError.OutOfMemory).try();
        arena_ty = be.named_type_at("Arena", "std.mem.mem_arena.Arena").try().ok_or(AllocError.OutOfMemory).try();
        [context, env_ty, alloc_ty, arena_ty].loop((h, ty) { be.request_type(ty).try() });
        shared = be.runtime_symbol("actor_env").try();
        c ::= be.alloc.String().try();
        be.ctype(context, c).try();
        e ::= be.alloc.String().try();
        be.ctype(env_ty, e).try();
        ar ::= be.alloc.String().try();
        be.ctype(arena_ty, ar).try();
        env_field   = be.actor_field("env").try();
        alloc_field = be.actor_field("alloc").try();
        handle ::= be.alloc.String().try();
        be.fat_value("arena", arena_ty, alloc_ty, handle).try();
        proto ::= be.alloc.String().try();
        proto.fmt(
            "{}{} *{}(uint8_t *raw)",
            be.linkage(),
            c.view(),
            name.view()
        ).try();
        body ::= be.alloc.String().try();
        body.fmt(
            "    static __thread {} ctx;\n    static __thread int ready;\n",
            c.view()
        ).try();
        body.fmt("    {} *arena = ({} *)raw;\n", ar.view(), ar.view()).try();
        body.fmt(
            "    if (!ready) {{ ctx.{} = *({} *){}(0, NULL); ready = 1; }}\n",
            env_field,
            e.view(),
            shared.view()
        ).try();
        me_field = be.actor_field("me").try();
        id_field = be.actor_field("id").try();
        mine     = be.runtime_symbol("actor_me").try();
        body.fmt("    ctx.{}.{} = {}();\n", me_field, id_field, mine.view()).try();
        body.fmt(
            "    ctx.{} = {};\n    return &ctx;\n",
            alloc_field,
            handle.view()
        ).try();
        be.add_function(name, proto, body).try();
    });
    Ok(name)
}

// `zg_ctx`, the Context a lifecycle entry passes, from the record's Arena.
write_context = (be :: CBackend, body :: String) Res<AllocError> {
    context = be.named_type_at("Context", "std.actor.actor_context.Context").try().ok_or(AllocError.OutOfMemory).try();
    helper  = be.context_helper(context).try();
    c ::= be.alloc.String().try();
    be.ctype(context, c).try();
    body.fmt(
        "    {} *zg_ctx = {}((uint8_t *)&zg_self->zg_arena);\n",
        c.view(),
        helper.view()
    )
}

// A byte buffer arrives as bytes copied into the message. Before the
// behaviour runs, the turn moves them into the actor's own allocator, so
// the behaviour may keep and grow the buffer; the memory lives until the
// actor's allocator is dropped after `stopped`. Out of memory there traps.
write_buffer_move = (
    be      :: CBackend,
    arg     : usize,
    vec_ty  : TyId,
    context : TyId,
    body    :: String
) Res<AllocError> {
    alloc_ty  = be.field_of(context, "alloc").try().ok_or(AllocError.OutOfMemory).try();
    ptr_ty    = be.field_of(vec_ty, "data").try().ok_or(AllocError.OutOfMemory).try();
    error_ty  = be.named_type_at("AllocError", "std.mem.mem_alloc.AllocError").try().ok_or(AllocError.OutOfMemory).try();
    result_ty = be.check.types.res_failure(ptr_ty, error_ty).try();
    be.request_type(result_ty).try();
    result_c ::= be.alloc.String().try();
    be.ctype(result_ty, result_c).try();
    data      = be.actor_field("data").try();
    len       = be.actor_field("len").try();
    capacity  = be.actor_field("capacity").try();
    allocator = be.actor_field("alloc").try();
    raw       = be.actor_field("raw").try();
    ok        = be.actor_field("Ok").try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(RES_PATH, "Ok").try();
    field ::= be.alloc.String("zg_msg->zg_arg").try();
    field.write_usize(arg).try();
    body.add("    {\n        unsigned char *bytes = NULL;\n").try();
    body.fmt("        if ({}.{len}) {{\n", field.view()).try();
    body.fmt(
        "            {} result = zg_ctx->{allocator}.{raw}(zg_ctx->{allocator}.zg_self, {}.{len}, 1);\n",
        result_c.view(),
        field.view()
    ).try();
    body.fmt("            if (result.zg_tag != {}) abort();\n", tag.view()).try();
    body.fmt("            bytes = result.zg_data.{ok};\n").try();
    body.fmt(
        "            memcpy(bytes, {}.{data}, {}.{len});\n        }}\n",
        field.view(),
        field.view()
    ).try();
    body.fmt(
        "        {}.{data} = bytes; {}.{capacity} = {}.{len}; {}.{allocator} = zg_ctx->{allocator};\n    }}\n",
        field.view(),
        field.view(),
        field.view(),
        field.view()
    )
}

// The turn a message sent through a message-typed Ref runs: the actor's
// `receive` with its one message as the payload record, or 0.
write_receive_turn = (be :: CBackend, n: usize, actor: TyId)
                     Res<String, AllocError> {
    name ::= be.alloc.String().try();
    name.add("0").try();
    hit: Res<BehaviorHit> = be.behavior_of(actor, "receive").try();
    hit.match({
        None    => (),
        Ok(hit) => {
            inst = be.recv_inst(actor).try();
            sig ::= be.alloc.Vec<TyId>();
            be.method_sig(actor, hit.site.decl, hit.f, hit.mi, inst, sig).try();
            (sig.len == 3).then(() {
                payload = be.write_message_record(n, sig).try();
                turn    = be.write_turn(
                    actor,
                    hit,
                    n,
                    payload.view(),
                    sig
                ).try();
                entry ::= be.alloc.String().try();
                entry.fmt("(size_t)&{}", turn.view()).try();
                name = entry;
            });
            ()
        },
    });
    Ok(name)
}

write_started_callback = (be :: CBackend, n: usize, rec: str, actor: TyId)
                         Res<String, AllocError> {
    name ::= be.alloc.String().try();
    name.add("0").try();
    hit: Res<BehaviorHit> = be.behavior_of(actor, "started").try();
    hit.match({
        None    => (),
        Ok(hit) => {
            callback ::= be.alloc.String().try();
            sym_gen(callback, "actor_started", n).try();
            be.add_lifecycle_callback(callback, rec, actor, hit).try();
            be.name_turn(callback.view(), actor, "started").try();
            entry ::= be.alloc.String().try();
            entry.fmt("(size_t)&{}", callback.view()).try();
            name = entry;
            ()
        },
    });
    Ok(name)
}

add_lifecycle_callback = (
    be    :: CBackend,
    name  : String,
    rec   : str,
    actor : TyId,
    hit   : BehaviorHit
)
                         Res<AllocError> {
    sym = be.behavior_symbol(actor, hit).try();
    proto ::= be.alloc.String().try();
    proto.fmt(
        "{}void {}(uint8_t *zg_rec, uint8_t *zg_raw)",
        be.linkage(),
        name.view()
    ).try();
    body ::= be.alloc.String().try();
    body.fmt("    {rec} *zg_self = ({rec} *)zg_rec;\n    (void)zg_raw;\n").try();
    be.write_context(body).try();
    body.fmt(
        "    (void)({}(&zg_self->zg_state, {}));\n",
        sym.view(),
        be.context_arg(actor, hit).try()
    ).try();
    be.add_function(name, proto, body)
}

// A lifecycle behavior's context argument. The thread's Context outlives
// the call, so a borrowed context parameter (gen_c_borrow.zen) receives its
// address.
context_arg = (
    be    :: CBackend,
    actor : TyId,
    hit   : BehaviorHit
) Res<str, AllocError> {
    inst = be.recv_inst(actor).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(actor, hit.site.decl, hit.f, hit.mi, inst, sig).try();
    be.passes_address(hit.f, 1, sig.ty_at(1)).try().match({
        true  => Ok("zg_ctx"),
        false => Ok("*zg_ctx"),
    })
}

behavior_symbol = (be :: CBackend, actor: TyId, hit: BehaviorHit)
                  Res<String, AllocError> {
    inst = be.recv_inst(actor).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(actor, hit.site.decl, hit.f, hit.mi, inst, sig).try();
    be.member_symbol(actor, hit.site, hit.f.name.text, sig, inst)
}

// The stopped entry: the actor's own `stopped`, then Drop for its state, then
// every page its Arena allocated.
write_stopped_callback = (
    be    :: CBackend,
    n     : usize,
    rec   : str,
    actor : TyId,
    arena : TyId
)
                         Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_stopped", n).try();
    proto ::= be.alloc.String().try();
    proto.fmt(
        "{}void {}(uint8_t *zg_rec, uint8_t *zg_raw)",
        be.linkage(),
        name.view()
    ).try();
    body ::= be.alloc.String().try();
    body.fmt("    {rec} *zg_self = ({rec} *)zg_rec;\n    (void)zg_raw;\n").try();
    be.behavior_of(actor, "stopped").try().match({
        None    => Ok,
        Ok(hit) => {
            // A non-null second argument marks an actor a trap ended: its
            // `stopped` does not run.
            body.add("    if (!zg_raw) {\n").try();
            be.write_context(body).try();
            sym = be.behavior_symbol(actor, hit).try();
            body.fmt(
                "    (void)({}(&zg_self->zg_state, {}));\n    }}\n",
                sym.view(),
                be.context_arg(actor, hit).try()
            )
        },
    }).try();
    be.drop_symbol(actor).try().match({
        None    => Ok,
        Ok(sym) => body.fmt("    (void)({}(&zg_self->zg_state));\n", sym.view()),
    }).try();
    // The Arena's state lives in the record, which the runtime frees: give
    // back the pages only.
    release = be.std_symbol("std.mem.mem_arena", "release_pages").try();
    body.fmt("    {}(&zg_self->zg_arena_state);\n", release.view()).try();
    be.add_function(name, proto, body).try();
    Ok(name)
}

drop_symbol = (be :: CBackend, ty: TyId) Res<Res<String>, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(None),
        Ok(s) => be.impl_member(s.decl, "drop").try().match({
            None  => Ok(None),
            Ok(f) => {
                hit = BehaviorHit(site: s, f: f, mi: s.decl.module.to_usize());
                Ok(Ok(be.behavior_symbol(ty, hit).try()))
            },
        }),
    })
}

// `env.spawn(actor)`: a body from the runtime with the record filled in,
// then the started turn queued. OutOfMemory when the body or the Arena's
// state cannot be had; Unavailable when the runtime cannot take another
// actor. Either failure drops the actor value as an ordinary owner.
write_spawn_value = (be :: CBackend, lifecycle: ActorLifecycle)
                    Res<String, AllocError> {
    layout = lifecycle.layout;
    spawn  = layout.spawn;
    env_code ::= be.alloc.String().try();
    expr(be, spawn.access.base, spawn.ctx, spawn.receiver_ty, env_code).try();
    env = be.temp(spawn.receiver_ty, "env").try();
    be.set_line(env.view(), env_code.view()).try();
    actor_code ::= be.alloc.String().try();
    spawn.call.args.get(0).match({
        None      => actor_code.add("0"),
        Ok(value) => expr(
            be,
            value.value,
            spawn.ctx,
            spawn.actor_ty,
            actor_code
        ),
    }).try();
    actor = be.temp(spawn.actor_ty, "actor_value").try();
    be.set_line(actor.view(), actor_code.view()).try();
    state_c ::= be.alloc.String().try();
    be.ctype(layout.state_ty, state_c).try();
    new = be.runtime_symbol("actor_new").try();
    be.need_actor_names();
    record    = be.runtime_symbol("actor_record").try();
    discard   = be.runtime_symbol("actor_discard").try();
    start     = be.runtime_symbol("actor_start").try();
    reference = be.runtime_symbol("actor_ref").try();
    thread    = be.runtime_symbol("actor_thread").try();
    shutdown  = be.runtime_symbol("actor_shutdown").try();
    cell        ::= be.fresh_name("actor_instance").try();
    rec         ::= be.fresh_name("actor_record").try();
    arena_state ::= be.fresh_name("actor_state").try();
    status      ::= be.fresh_name("actor_status").try();
    be.fmt(
        "uint8_t *{} = {}(sizeof({}), (size_t)&{}, (size_t)&{}, (size_t)&{});\n",
        cell.view(),
        new.view(),
        lifecycle.record,
        thread.view(),
        shutdown.view(),
        NAMES_SYMBOL
    ).try();
    dst = be.temp(spawn.result_ty, "t").try();
    be.fmt("if (!{}) {{\n", cell.view()).try();
    be.indent();
    be.drop_symbol(spawn.actor_ty).try().match({
        None       => Ok,
        Ok(symbol) => be.fmt("(void)({}(&{}));\n", symbol.view(), actor.view()),
    }).try();
    be.write_assign_err(spawn.result_ty, "OutOfMemory", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.fmt(
        "{} *{} = ({} *){}({});\n",
        lifecycle.record,
        rec.view(),
        lifecycle.record,
        record.view(),
        cell.view()
    ).try();
    // The process Env, kept once for every turn's Context.
    shared = be.runtime_symbol("actor_env").try();
    be.fmt(
        "(void){}(sizeof({}), (uint8_t *)&{});\n",
        shared.view(),
        env.view(),
        env.view()
    ).try();
    be.fmt(
        "{} *{} = &{}->zg_arena_state;\n",
        state_c.view(),
        arena_state.view(),
        rec.view()
    ).try();
    be.init_actor_fields(
        lifecycle,
        rec.view(),
        arena_state.view(),
        env.view(),
        actor.view()
    ).try();
    be.fmt(
        "int {} = {}({}, {}, (size_t)&{}, {});\n",
        status.view(),
        start.view(),
        cell.view(),
        lifecycle.started,
        lifecycle.stopped,
        lifecycle.receive
    ).try();
    be.fmt("if ({} != 0) {{\n", status.view()).try();
    be.indent();
    // No turn will ever run: drop the state. The Arena has allocated
    // nothing yet, and its state goes with the body.
    be.write_failed_spawn_drop(layout, rec.view()).try();
    be.fmt("{}({});\n", discard.view(), cell.view()).try();
    be.write_assign_err(spawn.result_ty, "Unavailable", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    ref_value ::= be.alloc.String().try();
    be.write_ref_value(
        spawn.ref_ty,
        reference.view(),
        cell.view(),
        ref_value
    ).try();
    be.write_assign_ok(spawn.result_ty, ref_value.view(), dst.view()).try();
    be.dedent();
    be.writeln("}").try();
    be.dedent();
    be.writeln("}").try();
    Ok(dst)
}

write_failed_spawn_drop = (
    be     :: CBackend,
    layout : ActorSpawnLayout,
    rec    : str
) Res<AllocError> {
    be.drop_symbol(layout.spawn.actor_ty).try().match({
        None       => Ok,
        Ok(symbol) => be.fmt(
            "(void)({}(&{}->zg_state));\n",
            symbol.view(),
            rec
        ),
    })
}

init_actor_fields = (
    be          :: CBackend,
    lifecycle   : ActorLifecycle,
    rec         : str,
    arena_state : str,
    env         : str,
    actor       : str
) Res<AllocError> {
    layout = lifecycle.layout;
    mem ::= be.alloc.String().try();
    mem.sym_member("mem").try();
    head ::= be.alloc.String().try();
    head.sym_member("head").try();
    next ::= be.alloc.String().try();
    next.sym_member("next").try();
    env_mem ::= be.alloc.String().try();
    env_mem.sym_member("mem").try();
    be.fmt("{arena_state}->{} = {env}.{};\n", mem.view(), env_mem.view()).try();
    be.fmt("{arena_state}->{} = NULL;\n", head.view()).try();
    be.fmt("{arena_state}->{} = 0;\n", next.view()).try();
    arena_c ::= be.alloc.String().try();
    be.ctype(layout.arena_ty, arena_c).try();
    arena_field ::= be.alloc.String().try();
    arena_field.sym_member("state").try();
    be.fmt(
        "{rec}->zg_arena = (({}){{ .{} = {arena_state} }});\n",
        arena_c.view(),
        arena_field.view()
    ).try();
    be.fmt("{rec}->zg_state = {actor};\n").try();
}

write_ref_value = (
    be        :: CBackend,
    ref_ty    : TyId,
    reference : str,
    cell      : str,
    out       :: String
) Res<AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ref_ty, cty).try();
    id ::= be.alloc.String().try();
    id.sym_member("id").try();
    out.fmt("(({}){{ .{} = {}({}) }})", cty.view(), id.view(), reference, cell)
}

actor_field = (be: CBackend, name: str) Res<str, AllocError> {
    field ::= be.alloc.String().try();
    field.sym_member(name).try();
    Ok(field.view())
}
