{ HEADER_BYTES } = std.mem.mem_pool
{ MAX_MESSAGES, MAX_MESSAGE_BYTES } = std.actor.actor_limits
// C lowering for std.actor. Each actor owns one worker thread and one
// bounded mailbox. Senders only enqueue; the worker is the sole caller of
// lifecycle and behavior methods, so actor state is never entered twice.

{ AllocError } = std.mem
{ Vec } = std.collections
{ Res, Ok, Err, None, Range } = std.core
{ str, String } = std.text
{ ExprId, Access, Call, Function, Member } = std.ast
{ Def } = sema.sema_def
{ ImplId } = sema.sema_id
{ TyId, TyNamed } = sema.sema_ty
{ Ctx } = sema.sema_check
{ Inst } = sema.sema_inst
{ Emit } = gen.gen_emit
{ sym_gen, sym_member, sym_variant, RES_PATH } = gen.gen_name
{ CBackend } = gen.gen_c.gen_c_state
{ Site, site_of, method_sig, member_symbol } = gen.gen_c.gen_c_member
{ has_body, decl_name, impl_member } = gen.gen_c.gen_c_impl
{ impl_bound_type } = sema.sema_supply
{ ctype, field_of, pointee, request_type } = gen.gen_c.gen_c_type
{ expr, ty_of } = gen.gen_c.gen_c_expr
{ recv_inst, sub } = gen.gen_c.gen_c_mono
{ temp, payload_type, write_assign_ok, write_assign_err } = gen.gen_c.gen_c_flow
{ write_assign_ok_unit } = gen.gen_c.gen_c_flow
{ passes_address } = gen.gen_c.gen_c_borrow
{ ty_at } = sema.sema_cand
{ fat_value } = gen.gen_c.gen_c_fat
{ def_type, type_of } = sema.sema_type
{ unsupported } = gen.gen_c.gen_c_report

BehaviorHit* = {
    site*: Site,
    f*: Function,
    mi*: usize,
}

// Source and inferred facts for one resolved Env.spawn call. They become
// available as one set when Ref<A> has been recognised and remain fixed until
// the result expression is delivered.
ActorSpawn = {
    id: ExprId,
    call: Call,
    access: Access,
    receiver_ty: TyId,
    result_ty: TyId,
    ref_ty: TyId,
    actor_ty: TyId,
    ctx: Ctx,
}

// Runtime layout types are discovered together before actor records or
// lifecycle callbacks can be emitted. This snapshot is the input to both.
ActorSpawnLayout = {
    spawn: ActorSpawn,
    context_ty: TyId,
    arena_ty: TyId,
    state_ty: TyId,
    alloc_ty: TyId,
}

// Generated names born at one actor site and consumed together while its
// value is emitted. Their backing strings live in the backend allocator.
ActorLifecycle = {
    layout: ActorSpawnLayout,
    record: str,
    started: str,
    stopped: str,
}

// Recognition uses declaration ownership as well as spelling. A user-defined
// Ref or Actor is an ordinary type.
ref_of_actor* = (be :: CBackend, ty: TyId) Res<Res<TyId>, AllocError> {
    be.types().at(ty).match({
        Named(n) => be.actor_ref(n),
        _        => Ok(None),
    })
}

actor_ref = (be :: CBackend, n: TyNamed) Res<Res<TyId>, AllocError> {
    (n.name.eq("Ref")
        && be.world().module_name(n.decl).eq("std.actor.actor_core")).match({
        false => Ok(None),
        true  => Ok(n.args.get(0)),
    })
}

actor_named_type = (be :: CBackend, name: str) Res<Res<TyId>, AllocError> {
    be.named_type_at(name, actor_path(name))
}

named_type_at = (be :: CBackend, name: str, qname: str)
                Res<Res<TyId>, AllocError> {
    defs ::= be.alloc.Vec<Def>();
    be.world().exported_named(name, defs).try();
    found ::= be.alloc.Vec<TyId>();
    defs.loop((h, d) {
        (d.name.eq(name) && d.qname.eq(qname)).then(() {
            found.add(be.check.def_type(d).try()).try();
            h.break();
        });
    });
    Ok(found.get(0))
}

actor_path = (name: str) str {
    name.match({
        "Actor"           => "std.actor.actor_core.Actor",
        "ActorError"      => "std.actor.actor_core.ActorError",
        "ActorStartError" => "std.actor.actor_core.ActorStartError",
        "Context"         => "std.actor.actor_context.Context",
        _                 => "",
    })
}

behavior_of* = (be :: CBackend, actor: TyId, name: str)
               Res<Res<BehaviorHit>, AllocError> {
    found ::= be.alloc.Vec<BehaviorHit>();
    site_of(be, actor).try().match({
        None  => Ok(()),
        Ok(s) => be.behavior_at(s, name, found),
    }).try();
    Ok(found.get(0))
}

behavior_at = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    found :: Vec<BehaviorHit>
) Res<(), AllocError> {
    ids ::= be.alloc.Vec<ImplId>();
    be.world().impls_named(be.tree, be.decl_name_at(s), ids).try();
    ids.loop((h, id) { be.behavior_in(s, name, id, found).try() });
    Ok(())
}

decl_name_at = (be: CBackend, s: Site) str {
    decl_name(be, s.decl)
}

behavior_in = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    id    : ImplId,
    found :: Vec<BehaviorHit>
) Res<(), AllocError> {
    ((id.decl.module == s.decl.module) && (found.len == 0)).match({
        false => Ok(()),
        true  => be.world().impl_at(be.tree, id).match({
            None   => Ok(()),
            Ok(im) => be.behavior_members(s, name, im.members, found),
        }),
    })
}

behavior_members = (
    be    :: CBackend,
    s     : Site,
    name  : str,
    ms    : Vec<Member>,
    found :: Vec<BehaviorHit>
) Res<(), AllocError> {
    ms.loop((h, m) {
        m.kind.match({
            Function(f) => (f.name.text.eq(name) && has_body(f)).then(() {
                found.add(BehaviorHit(
                    site: s,
                    f: f,
                    mi: s.decl.module.to_usize(),
                )).try();
                h.break();
            }),
            _           => (),
        });
    });
    Ok(())
}

// Runtime records are independent of Zen layouts. Concrete actor/message
// records are emitted later, after the Zen type definitions they contain.
emit_actor_floor* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_actor().match({
        false => Ok(()),
        true  => be.write_actor_floor(out),
    })
}

write_actor_floor = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    out.say("#undef _POSIX_C_SOURCE").try();
    out.say("#define _POSIX_C_SOURCE 200809L").try();
    out.say("#if defined(__GLIBC__)").try();
    out.say("#undef _FEATURES_H").try();
    out.say("#include <features.h>").try();
    out.say("#endif").try();
    out.say("#include <pthread.h>").try();
    out.line().try();
    out.bytes("#define ZG_ACTOR_CAPACITY ").try();
    out.number(MAX_MESSAGES).try();
    out.say("u").try();
    out.bytes("#define ZG_ACTOR_BYTE_CAPACITY ").try();
    out.number(MAX_MESSAGE_BYTES).try();
    out.say("u").try();
    out.bytes("#define ZG_ACTOR_STORAGE_OVERHEAD ").try();
    out.number(HEADER_BYTES).try();
    out.say("u").try();
    out.say("typedef struct zg_actor zg_actor;").try();
    out.say("typedef struct zg_actor_msg zg_actor_msg;").try();
    out.say("typedef struct zg_actor_slice zg_actor_slice;").try();
    out.say("typedef struct zg_actor_owned zg_actor_owned;").try();
    out.say(
        "struct zg_actor_owned { zg_actor_owned *next; void (*drop)(zg_actor_owned *); };"
    ).try();
    out.say("static void zg_actor_release_owned(zg_actor_owned *list) {").try();
    out.say(
        "    while (list) { zg_actor_owned *next = list->next; list->drop(list); list = next; }"
    ).try();
    out.say("}").try();
    out.say("typedef void (*zg_actor_turn)(zg_actor *, void *);").try();
    out.say("struct zg_actor_msg {").try();
    out.say("    zg_actor_msg *next;").try();
    out.say("    zg_actor_turn turn;").try();
    out.say("    size_t bytes;").try();
    out.say(
        "    unsigned char padding[16 - ((2 * sizeof(void *) + sizeof(size_t)) % 16)];"
    ).try();
    out.say("    unsigned char data[];").try();
    out.say("};").try();
    out.say(
        "typedef char zg_actor_payload_aligned[(offsetof(zg_actor_msg, data) % 16 == 0) ? 1 : -1];"
    ).try();
    out.say("struct zg_actor_slice {").try();
    out.say("    size_t data_offset;").try();
    out.say("    size_t len_offset;").try();
    out.say("    const unsigned char *data;").try();
    out.say("    size_t len;").try();
    out.say("};").try();
    out.say("struct zg_actor {").try();
    out.say("    pthread_t thread;").try();
    out.say("    pthread_mutex_t lock;").try();
    out.say("    pthread_cond_t wake;").try();
    out.say("    pthread_cond_t joined_wake;").try();
    out.say("    zg_actor_msg *head;").try();
    out.say("    zg_actor_msg *tail;").try();
    out.say("    size_t count;").try();
    out.say("    size_t preparing;").try();
    out.say("    size_t bytes;").try();
    out.say("    int open;").try();
    out.say("    int joined;").try();
    out.say("    int joining;").try();
    out.say("    zg_actor_owned *owned;").try();
    out.say("    void *storage;").try();
    out.say("    void *(*take)(void *, size_t);").try();
    out.say("    void (*give)(void *, void *);").try();
    out.say("    void *state;").try();
    out.say("    void *context;").try();
    out.say("    void (*started)(zg_actor *);").try();
    out.say("    void (*stopped)(zg_actor *);").try();
    out.say("    zg_actor *next;").try();
    out.say("};").try();
    out.say("extern pthread_mutex_t zg_actor_registry_lock;").try();
    out.say("extern pthread_cond_t zg_actor_registry_idle;").try();
    out.say("extern zg_actor *zg_actor_registry;").try();
    out.say("extern int zg_actor_shutting_down;").try();
    out.say("extern size_t zg_actor_pending;").try();
    out.say("extern size_t zg_actor_borrowers;").try();
    out.say("static int zg_actor_registered(zg_actor *target) {").try();
    out.say(
        "    for (zg_actor *a = zg_actor_registry; a; a = a->next) if (a == target) return 1;"
    ).try();
    out.say("    return 0;").try();
    out.say("}").try();
    out.line().try();
    write_actor_worker(out).try();
    write_actor_send_floor(out).try();
    write_actor_start_floor(out).try();
    write_actor_stop_floor(out).try();
    Ok(())
}

write_actor_worker = (out :: Emit) Res<(), AllocError> {
    out.say("static void *zg_actor_worker(void *raw) {").try();
    out.say("    zg_actor *a = (zg_actor *)raw;").try();
    out.say("    if (a->started) a->started(a);").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("    zg_actor_pending--;").try();
    out.say(
        "    if (!zg_actor_pending) pthread_cond_broadcast(&zg_actor_registry_idle);"
    ).try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    for (;;) {").try();
    out.say("        pthread_mutex_lock(&a->lock);").try();
    out.say(
        "        while (!a->head && (a->open || a->preparing)) pthread_cond_wait(&a->wake, &a->lock);"
    ).try();
    out.say("        if (!a->head && !a->open) {").try();
    out.say("            pthread_mutex_unlock(&a->lock);").try();
    out.say("            break;").try();
    out.say("        }").try();
    out.say("        zg_actor_msg *m = a->head;").try();
    out.say("        a->head = m->next;").try();
    out.say("        if (!a->head) a->tail = NULL;").try();

    out.say("        pthread_mutex_unlock(&a->lock);").try();
    out.say("        m->turn(a, m->data);").try();
    out.say("        pthread_mutex_lock(&a->lock);").try();
    out.say("        a->count--; a->bytes -= m->bytes;").try();
    out.say("        a->give(a->storage, m);").try();
    out.say("        pthread_mutex_unlock(&a->lock);").try();
    out.say("        pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("        zg_actor_pending--;").try();
    out.say(
        "        if (!zg_actor_pending) pthread_cond_broadcast(&zg_actor_registry_idle);"
    ).try();
    out.say("        pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    }").try();
    out.say("    if (a->stopped) a->stopped(a);").try();
    out.say("    zg_actor_release_owned(a->owned); a->owned = NULL;").try();
    out.say("    return NULL;").try();
    out.say("}").try();
    out.line().try();
    Ok(())
}

// 0 accepted, 1 closed, 2 full (including allocation refusal).
write_actor_send_floor = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static int zg_actor_send_owned(zg_actor *a, zg_actor_turn turn, const void *data, size_t size, const zg_actor_slice *slices, size_t slice_count, int (*prepare)(zg_actor *, void *, zg_actor_owned **)) {"
    ).try();
    // Registry membership and mailbox admission share one lock order. A
    // buffer preparation reserves its lifetime before leaving those locks.
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say(
        "    if (!zg_actor_registered(a)) { pthread_mutex_unlock(&zg_actor_registry_lock); return 1; }"
    ).try();
    out.say("    pthread_mutex_lock(&a->lock);").try();
    out.say("    int result = 2;").try();
    out.say("    if (!a->open) { result = 1; goto reject; }").try();
    out.say(
        "    if (a->count >= ZG_ACTOR_CAPACITY || zg_actor_pending == SIZE_MAX) goto reject;"
    ).try();
    out.say("    size_t total = sizeof(zg_actor_msg);").try();
    out.say("    if (size > ZG_ACTOR_BYTE_CAPACITY - total) goto reject;").try();
    out.say("    total += size;").try();
    out.say("    for (size_t i = 0; i < slice_count; i++) {").try();
    out.say(
        "        if (slices[i].len > ZG_ACTOR_BYTE_CAPACITY - total) goto reject;"
    ).try();
    out.say("        total += slices[i].len;").try();
    out.say("    }").try();
    out.say(
        "    if (total > ZG_ACTOR_BYTE_CAPACITY - ZG_ACTOR_STORAGE_OVERHEAD) goto reject;"
    ).try();
    out.say("    size_t charged = total + ZG_ACTOR_STORAGE_OVERHEAD;").try();
    out.say(
        "    if (charged > ZG_ACTOR_BYTE_CAPACITY - a->bytes) goto reject;"
    ).try();
    out.say(
        "    zg_actor_msg *m = (zg_actor_msg *)a->take(a->storage, total);"
    ).try();
    out.say("    if (!m) goto reject;").try();
    out.say("    m->bytes = charged;").try();
    out.say("    m->next = NULL;").try();
    out.say("    m->turn = turn;").try();
    out.say("    if (size) memcpy(m->data, data, size);").try();
    out.say("    unsigned char *tail = m->data + size;").try();
    out.say("    for (size_t i = 0; i < slice_count; i++) {").try();
    out.say(
        "        if (slices[i].len) memcpy(tail, slices[i].data, slices[i].len);"
    ).try();
    out.say("        unsigned char *bytes = tail;").try();
    out.say(
        "        memcpy(m->data + slices[i].data_offset, &bytes, sizeof(bytes));"
    ).try();
    out.say(
        "        memcpy(m->data + slices[i].len_offset, &slices[i].len, sizeof(slices[i].len));"
    ).try();
    out.say("        tail += slices[i].len;").try();
    out.say("    }").try();
    // Reserve count/bytes and pending work before invoking the receiver's Mem
    // authority. Allocation and rollback callbacks run without runtime locks;
    // the reservation keeps shutdown and stopped from reclaiming their context.
    out.say("    zg_actor_owned *owned = NULL;").try();
    out.say("    if (prepare) {").try();
    out.say(
        "        a->preparing++; a->count++; a->bytes += charged; zg_actor_pending++;"
    ).try();
    out.say("        pthread_mutex_unlock(&a->lock);").try();
    out.say("        pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("        int ready = prepare(a, m->data, &owned);").try();
    out.say(
        "        if (!ready) { zg_actor_release_owned(owned); owned = NULL; }"
    ).try();
    out.say("        pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("        pthread_mutex_lock(&a->lock);").try();
    out.say("        if (!ready || !a->open) {").try();
    out.say("            result = a->open ? 2 : 1;").try();
    out.say("            pthread_mutex_unlock(&a->lock);").try();
    out.say("            pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("            zg_actor_release_owned(owned);").try();
    out.say("            pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("            pthread_mutex_lock(&a->lock);").try();
    out.say("            a->preparing--; a->count--; a->bytes -= charged;").try();
    out.say("            a->give(a->storage, m);").try();
    out.say("            zg_actor_pending--;").try();
    out.say(
        "            if (!zg_actor_pending) pthread_cond_broadcast(&zg_actor_registry_idle);"
    ).try();
    out.say("            pthread_cond_signal(&a->wake);").try();
    out.say("            goto reject;").try();
    out.say("        }").try();
    out.say("        a->preparing--;").try();
    out.say("    }").try();
    out.say(
        "    while (owned) { zg_actor_owned *next = owned->next; owned->next = a->owned; a->owned = owned; owned = next; }"
    ).try();
    // The mailbox lock makes empty-to-nonempty publication atomic with wait.
    // Queued work already keeps the worker runnable; signal only the transition.
    out.say("    int was_empty = (a->head == NULL);").try();
    out.say("    if (a->tail) a->tail->next = m; else a->head = m;").try();
    out.say("    a->tail = m;").try();
    out.say(
        "    if (!prepare) { a->count++; a->bytes += charged; zg_actor_pending++; }"
    ).try();
    out.say("    if (was_empty) pthread_cond_signal(&a->wake);").try();
    out.say("    pthread_mutex_unlock(&a->lock);").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    return 0;").try();
    out.say("reject:").try();
    out.say("    pthread_mutex_unlock(&a->lock);").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    return result;").try();
    out.say("}").try();
    out.say(
        "static int zg_actor_send(zg_actor *a, zg_actor_turn turn, const void *data, size_t size, const zg_actor_slice *slices, size_t slice_count) {"
    ).try();
    out.say(
        "    return zg_actor_send_owned(a, turn, data, size, slices, slice_count, NULL);"
    ).try();
    out.say("}").try();
    out.line().try();
    Ok(())
}

// 0 started, 1 allocation/setup failure, 2 worker unavailable.
write_actor_start_floor = (out :: Emit) Res<(), AllocError> {
    out.say("static int zg_actor_start(zg_actor *a) {").try();
    out.say("    if (pthread_mutex_init(&a->lock, NULL) != 0) return 1;").try();
    out.say(
        "    if (pthread_cond_init(&a->wake, NULL) != 0) { pthread_mutex_destroy(&a->lock); return 1; }"
    ).try();
    out.say(
        "    if (pthread_cond_init(&a->joined_wake, NULL) != 0) { pthread_cond_destroy(&a->wake); pthread_mutex_destroy(&a->lock); return 1; }"
    ).try();
    out.say(
        "    a->head = NULL; a->tail = NULL; a->count = 0; a->bytes = 0; a->preparing = 0; a->open = 1; a->owned = NULL;"
    ).try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say(
        "    if (zg_actor_shutting_down || zg_actor_pending == SIZE_MAX) { pthread_mutex_unlock(&zg_actor_registry_lock); pthread_cond_destroy(&a->joined_wake); pthread_cond_destroy(&a->wake); pthread_mutex_destroy(&a->lock); return 2; }"
    ).try();
    out.say("    zg_actor_pending++;").try();
    out.say(
        "    if (pthread_create(&a->thread, NULL, zg_actor_worker, a) != 0) { zg_actor_pending--; pthread_mutex_unlock(&zg_actor_registry_lock); pthread_cond_destroy(&a->joined_wake); pthread_cond_destroy(&a->wake); pthread_mutex_destroy(&a->lock); return 2; }"
    ).try();
    out.say("    a->next = zg_actor_registry;").try();
    out.say("    zg_actor_registry = a;").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    return 0;").try();
    out.say("}").try();
    out.line().try();
    Ok(())
}

write_actor_stop_floor = (out :: Emit) Res<(), AllocError> {
    out.say("static void zg_actor_stop_worker(zg_actor *a) {").try();
    out.say("    if (!a) return;").try();
    out.say("    pthread_mutex_lock(&a->lock);").try();
    out.say("    a->open = 0;").try();
    out.say("    pthread_cond_signal(&a->wake);").try();
    out.say("    pthread_mutex_unlock(&a->lock);").try();
    out.say("}").try();
    // Join has multiple callers but exactly one pthread_join owner. The
    // worker cannot wait for itself: self-join returns without marking joined.
    // Join waiters have a separate condition so they cannot steal worker wakeups.
    out.say("static void zg_actor_join_worker(zg_actor *a) {").try();
    out.say("    if (!a) return;").try();
    out.say("    pthread_mutex_lock(&a->lock);").try();
    out.say(
        "    if (a->joined || pthread_equal(pthread_self(), a->thread)) {"
    ).try();
    out.say("        pthread_mutex_unlock(&a->lock); return;").try();
    out.say("    }").try();
    out.say(
        "    while (a->joining && !a->joined) pthread_cond_wait(&a->joined_wake, &a->lock);"
    ).try();
    out.say(
        "    if (a->joined) { pthread_mutex_unlock(&a->lock); return; }"
    ).try();
    out.say("    a->joining = 1;").try();
    out.say("    pthread_mutex_unlock(&a->lock);").try();
    out.say("    int result = pthread_join(a->thread, NULL);").try();
    out.say("    pthread_mutex_lock(&a->lock);").try();
    out.say("    if (result == 0) a->joined = 1;").try();
    out.say("    a->joining = 0;").try();
    out.say("    pthread_cond_broadcast(&a->joined_wake);").try();
    out.say("    pthread_mutex_unlock(&a->lock);").try();
    out.say("}").try();
    // Registry membership is checked before dereferencing an address. A join
    // pins its record across the blocking native call; shutdown closes workers,
    // waits for pins, and detaches the registry before reclaiming any record.
    out.say("static void zg_actor_stop(zg_actor *a) {").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("    if (zg_actor_registered(a)) zg_actor_stop_worker(a);").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("}").try();
    out.say("static void zg_actor_join(zg_actor *a) {").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say(
        "    if (!zg_actor_registered(a)) { pthread_mutex_unlock(&zg_actor_registry_lock); return; }"
    ).try();
    out.say("    if (zg_actor_borrowers == SIZE_MAX) abort();").try();
    out.say("    zg_actor_borrowers++;").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    zg_actor_join_worker(a);").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("    zg_actor_borrowers--;").try();
    out.say(
        "    if (!zg_actor_borrowers) pthread_cond_broadcast(&zg_actor_registry_idle);"
    ).try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("}").try();
    out.say("static void zg_actor_shutdown(void) {").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("    if (zg_actor_shutting_down) {").try();
    out.say(
        "        while (zg_actor_shutting_down != 2) pthread_cond_wait(&zg_actor_registry_idle, &zg_actor_registry_lock);"
    ).try();
    out.say("        pthread_mutex_unlock(&zg_actor_registry_lock); return;").try();
    out.say("    }").try();
    out.say("    zg_actor_shutting_down = 1;").try();
    out.say(
        "    while (zg_actor_pending) pthread_cond_wait(&zg_actor_registry_idle, &zg_actor_registry_lock);"
    ).try();
    out.say(
        "    for (zg_actor *a = zg_actor_registry; a; a = a->next) zg_actor_stop_worker(a);"
    ).try();
    out.say(
        "    while (zg_actor_borrowers) pthread_cond_wait(&zg_actor_registry_idle, &zg_actor_registry_lock);"
    ).try();
    out.say("    zg_actor *list = zg_actor_registry;").try();
    out.say("    zg_actor_registry = NULL;").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("    while (list) {").try();
    out.say("        zg_actor *next = list->next;").try();
    out.say("        zg_actor_join_worker(list);").try();
    out.say("        if (!list->joined) abort();").try();
    out.say("        pthread_cond_destroy(&list->joined_wake);").try();
    out.say("        pthread_cond_destroy(&list->wake);").try();
    out.say("        pthread_mutex_destroy(&list->lock);").try();
    out.say("        free(list);").try();
    out.say("        list = next;").try();
    out.say("    }").try();
    out.say("    pthread_mutex_lock(&zg_actor_registry_lock);").try();
    out.say("    zg_actor_shutting_down = 2;").try();
    out.say("    pthread_cond_broadcast(&zg_actor_registry_idle);").try();
    out.say("    pthread_mutex_unlock(&zg_actor_registry_lock);").try();
    out.say("}").try();
    out.line().try();
    Ok(())
}

emit_actor_defs* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.actor_defs_loop(out)
}

actor_defs_loop = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    Range(0, be.actor_def_count()).loop((h, i) {
        be.actor_def_at(i).match({
            None    => Ok(()),
            Ok(def) => out.say(def.view()),
        }).try();
    });
    (be.actor_def_count() > 0).then(() { out.line().try() });
    Ok(())
}

emit_actor_globals* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_actor().match({
        false => Ok(()),
        true  => {
            out.say(
                "pthread_mutex_t zg_actor_registry_lock = PTHREAD_MUTEX_INITIALIZER;"
            ).try();
            out.say(
                "pthread_cond_t zg_actor_registry_idle = PTHREAD_COND_INITIALIZER;"
            ).try();
            out.say("zg_actor *zg_actor_registry = NULL;").try();
            out.say("int zg_actor_shutting_down = 0;").try();
            out.say("size_t zg_actor_pending = 0;").try();
            out.say("size_t zg_actor_borrowers = 0;").try();
            out.line()
        },
    })
}

write_actor_shutdown* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_actor().match({
        false => Ok(()),
        true  => out.say("zg_actor_shutdown();"),
    })
}

// Ref.stop only closes admission. The worker drains messages already in the
// mailbox, then runs stopped and exits.
lower_actor_stop* = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_actor();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    id ::= be.alloc.String().try();
    id.sym_member("id").try();
    be.fmt(
        "zg_actor_stop((zg_actor *)(uintptr_t)({}.{}));\n",
        recv.view(),
        id.view()
    ).try();
    out.add("0")
}

lower_actor_join* = (
    be  :: CBackend,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    be.need_actor();
    recv ::= be.alloc.String().try();
    expr(be, a.base, ctx, rty, recv).try();
    id ::= be.alloc.String().try();
    id.sym_member("id").try();
    be.fmt(
        "zg_actor_join((zg_actor *)(uintptr_t)({}.{}));\n",
        recv.view(),
        id.view()
    ).try();
    out.add("0")
}

// A behavior call on Ref<A> becomes one copied mailbox record and returns as
// soon as that record is accepted. The generated turn function is the only
// code that enters a: it reads state/context from the runtime header and calls
// the statically resolved behavior body on the actor's worker.
ActorSend = {
    id: ExprId,
    call: Call,
    access: Access,
    receiver_ty: TyId,
    actor_ty: TyId,
    hit: BehaviorHit,
    ctx: Ctx,

    lower = (self: @Self, be :: CBackend, out :: String)
            Res<(), AllocError> {
        be.need_actor();
        // In a generic body the call's sema type still names type variables.
        ret = be.sub(be.check.type_of(self.id, self.ctx).try()).try();
        be.request_type(ret).try();
        inst = be.recv_inst(self.actor_ty).try();
        sig ::= be.alloc.Vec<TyId>();
        be.method_sig(
            self.actor_ty,
            self.hit.site.decl,
            self.hit.f,
            self.hit.mi,
            inst,
            sig
        ).try();
        self.transferable(be, sig).try().match({
            false => be.unsupported(
                self.id,
                "an actor payload without a concrete mailbox transfer",
                out
            ),
            true  => self.write_message(be, ret, sig, out),
        })
    }

    // The destination representation matters too. An implicit union or bound
    // conversion must not hide a direct buffer/slice from mailbox descriptors.
    transferable = (self: @Self, be :: CBackend, sig: Vec<TyId>)
                   Res<bool, AllocError> {
        safe ::= true;
        self.call.args.loop((h, i, arg) {
            formal = sig.get(i + 2).ok_or(AllocError.OutOfMemory).try();
            actual = be.ty_of(arg.value, self.ctx, formal).try();
            buffer = be.check.actor_byte_buffer(formal);
            safe   = safe && (buffer == be.check.actor_byte_buffer(actual))
                && (is_direct_str(be, formal) == is_direct_str(be, actual))
                && (buffer || !be.check.actor_payload_unsafe(formal).try());
        });
        Ok(safe)
    }

    write_message = (self: @Self, be :: CBackend, ret: TyId, sig: Vec<TyId>, out :: String)
                    Res<(), AllocError> {
        n       = be.next_actor_site();
        payload = be.write_message_record(n, sig).try();
        turn    = self.write_turn(be, n, payload.view(), sig).try();
        prepare = be.write_buffer_transfer(n, payload.view(), sig).try();
        ActorSendEmission(
            send: self,
            result_ty: ret,
            signature: sig,
            payload: payload.view(),
            turn: turn.view(),
            prepare: prepare,
        ).write(be, out)
    }

    write_turn = (
        self    : @Self,
        be      :: CBackend,
        n       : usize,
        payload : str,
        sig     : Vec<TyId>
    ) Res<String, AllocError> {
        name ::= be.alloc.String().try();
        sym_gen(name, "actor_turn", n).try();
        sym = be.behavior_symbol(self.actor_ty, self.hit).try();
        actor_c ::= be.alloc.String().try();
        be.ctype(self.actor_ty, actor_c).try();
        context_ty = sig.get(1).match({
            Ok(t) => t,
            None  => TyId(index: 0),
        });
        context_c ::= be.alloc.String().try();
        be.ctype(context_ty, context_c).try();
        proto ::= be.alloc.String().try();
        proto.fmt(
            "{}void {}(zg_actor *zg_base, void *zg_raw)",
            be.linkage(),
            name.view()
        ).try();
        body ::= be.alloc.String().try();
        body.fmt(
            "    {} *zg_state = ({} *)zg_base->state;\n",
            actor_c.view(),
            actor_c.view()
        ).try();
        body.fmt(
            "    {} *zg_ctx = ({} *)zg_base->context;\n",
            context_c.view(),
            context_c.view()
        ).try();
        body.fmt("    {payload} *zg_msg = ({payload} *)zg_raw;\n").try();
        // The context and message live in the actor record for the whole
        // call, so a borrowed parameter (gen_c_borrow.zen) takes them by
        // address exactly as a `::` one does.
        context_by_address = be.passes_address(
            self.hit.f,
            1,
            sig.ty_at(1)
        ).try();
        body.fmt("    (void)({}(zg_state, ", sym.view()).try();
        context_by_address.match({
            true  => body.add("zg_ctx"),
            false => body.add("*zg_ctx"),
        }).try();
        Range(2, sig.len).loop((h, i) {
            body.add(", ").try();
            be.passes_address(self.hit.f, i, sig.ty_at(i)).try().then(() {
                body.add("&").try()
            });
            body.add("zg_msg->zg_arg").try();
            body.write_usize(i - 2).try();
        });
        body.add("));\n").try();
        be.add_function(name, proto, body).try();
        Ok(name)
    }
}

ActorSendEmission = {
    send: ActorSend,
    result_ty: TyId,
    signature: Vec<TyId>,
    payload: str,
    turn: str,
    prepare: str,

    write = (self: @Self, be :: CBackend, out :: String)
            Res<(), AllocError> {
        recv_code ::= be.alloc.String().try();
        expr(
            be,
            self.send.access.base,
            self.send.ctx,
            self.send.receiver_ty,
            recv_code
        ).try();
        recv = be.temp(self.send.receiver_ty, "actor_ref").try();
        be.set_line(recv.view(), recv_code.view()).try();
        message ::= be.fresh_name("actor_payload").try();
        be.fmt(
            "{} {} = ({}){{0}};\n",
            self.payload,
            message.view(),
            self.payload
        ).try();
        slices = direct_str_count(be, self.signature);
        slice_name ::= be.fresh_name("actor_slices").try();
        (slices > 0).then(() {
            count ::= be.alloc.String().try();
            count.write_usize(slices).try();
            be.fmt(
                "zg_actor_slice {}[{}];\n",
                slice_name.view(),
                count.view()
            ).try();
        });
        slice :: usize = 0;
        self.send.call.args.loop((h, i, arg) {
            ty = self.signature.get(i + 2).match({
                Ok(t) => t,
                None  => TyId(index: 0),
            });
            value ::= be.alloc.String().try();
            expr(be, arg.value, self.send.ctx, ty, value).try();
            line ::= be.alloc.String().try();
            line.fmt("{}.zg_arg", message.view()).try();
            line.write_usize(i).try();
            line.fmt(" = {};\n", value.view()).try();
            be.write(line.view()).try();
            (is_direct_str(be, ty) || be.check.actor_byte_buffer(ty)).then(() {
                be.write_slice_descriptor(
                    slice_name.view(),
                    slice,
                    message.view(),
                    i,
                    be.check.actor_byte_buffer(ty)
                ).try();
                slice = slice + 1;
            });
        });
        id ::= be.alloc.String().try();
        id.sym_member("id").try();
        status ::= be.fresh_name("actor_send").try();
        descriptors = (slices > 0).match({
            true  => slice_name.view(),
            false => "NULL",
        });
        count ::= be.alloc.String().try();
        count.write_usize(slices).try();
        suffix = self.prepare.eq(
            "NULL"
        ).match({ true => "", false => "_owned" });
        extra ::= be.alloc.String().try();
        (!self.prepare.eq("NULL")).then(() { extra.fmt(", {}", self.prepare).try(); });
        be.fmt(
            "int {} = zg_actor_send{}((zg_actor *)(uintptr_t)({}.{}), {}, &{}, sizeof({}), {}, {}{});\n",
            status.view(),
            suffix,
            recv.view(),
            id.view(),
            self.turn,
            message.view(),
            message.view(),
            descriptors,
            count.view(),
            extra.view()
        ).try();
        dst = be.temp(self.result_ty, "actor_result").try();
        be.fmt("if ({} == 0) {{\n", status.view()).try();
        be.indent();
        be.write_assign_ok_unit(self.result_ty, dst.view()).try();
        be.dedent();
        be.fmt("}} else if ({} == 1) {{\n", status.view()).try();
        be.indent();
        be.write_assign_err(self.result_ty, "Closed", dst.view()).try();
        be.dedent();
        be.writeln("} else {").try();
        be.indent();
        be.write_assign_err(self.result_ty, "Full", dst.view()).try();
        be.dedent();
        be.writeln("}").try();
        out.add(dst.view())
    }
}

lower_actor_send* = (
    be       :: CBackend,
    id       : ExprId,
    c        : Call,
    a        : Access,
    rty      : TyId,
    actor_ty : TyId,
    ctx      : Ctx,
    out      :: String
) Res<(), AllocError> {
    be.behavior_of(actor_ty, a.name.text).try().match({
        None    => be.unsupported(id, "an unresolved actor behavior", out),
        Ok(hit) => ActorSend(
            id: id,
            call: c,
            access: a,
            receiver_ty: rty,
            actor_ty: actor_ty,
            hit: hit,
            ctx: ctx,
        ).lower(be, out),
    })
}

write_message_record = (be :: CBackend, n: usize, sig: Vec<TyId>)
                       Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_message", n).try();
    text ::= be.alloc.String().try();
    text.fmt("typedef struct {} {{\n", name.view()).try();
    (sig.len <= 2).then(() {
        text.add("    unsigned char zg_unit;\n").try();
    });
    Range(2, sig.len).loop((h, i) {
        ty = sig.get(i).match({
            Ok(t) => t,
            None  => TyId(index: 0),
        });
        be.request_type(ty).try();
        text.add("    ").try();
        be.ctype(ty, text).try();
        text.add(" zg_arg").try();
        text.write_usize(i - 2).try();
        text.add(";\n").try();
    });
    text.fmt("}} {};", name.view()).try();
    be.add_actor_def(text).try();
    Ok(name)
}

direct_str_count = (be: CBackend, sig: Vec<TyId>) usize {
    count ::= 0;
    Range(2, sig.len).loop((h, i) {
        sig.get(i).match({
            None   => (),
            Ok(ty) => (is_direct_str(be, ty) || be.check.actor_byte_buffer(ty)).then(() { count = count + 1; }),
        });
    });
    count
}

is_direct_str = (be: CBackend, ty: TyId) bool {
    be.types().at(ty).match({
        Prim(p) => p.name.eq("str"),
        _       => false,
    })
}

write_slice_descriptor = (
    be      :: CBackend,
    slices  : str,
    at      : usize,
    message : str,
    arg     : usize,
    buffer  : bool
) Res<(), AllocError> {
    data_field = buffer.match({ true => be.actor_field(
        "data"
    ).try(), false => "data" });
    len_field  = buffer.match({ true => be.actor_field(
        "len"
    ).try(), false => "len" });
    s_at ::= be.alloc.String().try();
    s_at.write_usize(at).try();
    a_at ::= be.alloc.String().try();
    a_at.write_usize(arg).try();
    be.fmt(
        "{}[{}].data_offset = (size_t)((unsigned char *)&{}.zg_arg{}.{} - (unsigned char *)&{});\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        data_field,
        message
    ).try();
    be.fmt(
        "{}[{}].len_offset = (size_t)((unsigned char *)&{}.zg_arg{}.{} - (unsigned char *)&{});\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        len_field,
        message
    ).try();
    be.fmt(
        "{}[{}].data = {}.zg_arg{}.{};\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        data_field
    ).try();
    be.fmt(
        "{}[{}].len = {}.zg_arg{}.{};\n",
        slices,
        s_at.view(),
        message,
        a_at.view(),
        len_field
    )
}

// Env.spawn creates the concrete actor record, the actor-owned arena and the
// Context handed to every turn. The worker is started only after all fields
// are initialized, so started observes a complete actor.
lower_actor_spawn* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    a   : Access,
    rty : TyId,
    ctx : Ctx,
    out :: String
) Res<(), AllocError> {
    // Substitute the instantiation being lowered: a spawn inside a generic
    // function must record the concrete actor state type.
    ret = be.sub(be.check.type_of(id, ctx).try()).try();
    be.payload_type(ret, "Ok").match({
        None       => be.unsupported(id, "Env.spawn without a Ref result", out),
        Ok(ref_ty) => be.ref_of_actor(ref_ty).try().match({
            None         => be.unsupported(
                id,
                "Env.spawn returning a non-actor Ref",
                out
            ),
            Ok(actor_ty) => be.resolve_actor_spawn(
                ActorSpawn(
                    id: id,
                    call: c,
                    access: a,
                    receiver_ty: rty,
                    result_ty: ret,
                    ref_ty: ref_ty,
                    actor_ty: actor_ty,
                    ctx: ctx,
                ),
                out
            ),
        }),
    })
}

resolve_actor_spawn = (be :: CBackend, spawn: ActorSpawn, out :: String)
                      Res<(), AllocError> {
    be.actor_named_type("Context").try().match({
        None           => be.unsupported(spawn.id, "std.actor.Context", out),
        Ok(context_ty) => be.named_type_at(
            "Arena",
            "std.mem.mem_arena.Arena"
        ).try().match({
            None         => be.unsupported(spawn.id, "std.mem.Arena", out),
            Ok(arena_ty) => be.field_of(arena_ty, "state").try().match({
                None          => be.unsupported(
                    spawn.id,
                    "Arena without state",
                    out
                ),
                Ok(state_ptr) => pointee(be, state_ptr).match({
                    None         => be.unsupported(
                        spawn.id,
                        "Arena state that is not a pointer",
                        out
                    ),
                    Ok(state_ty) => be.field_of(context_ty, "alloc")
                        .try().match({
                        None         => be.unsupported(
                            spawn.id,
                            "Context without Alloc",
                            out
                        ),
                        Ok(alloc_ty) => {
                            value = be.write_actor_spawn(ActorSpawnLayout(
                                spawn: spawn,
                                context_ty: context_ty,
                                arena_ty: arena_ty,
                                state_ty: state_ty,
                                alloc_ty: alloc_ty,
                            )).try();
                            out.add(value.view())
                        },
                    }),
                }),
            }),
        }),
    })
}

write_actor_spawn = (be :: CBackend, layout: ActorSpawnLayout)
                    Res<String, AllocError> {
    be.need_actor();
    [
        layout.spawn.result_ty,
        layout.spawn.ref_ty,
        layout.spawn.actor_ty,
        layout.context_ty,
        layout.arena_ty,
        layout.state_ty,
        layout.alloc_ty,
    ].loop((h, ty) { be.request_type(ty).try() });
    n = be.next_actor_site();
    rec ::= be.alloc.String().try();
    sym_gen(rec, "actor", n).try();
    be.write_actor_record(layout, rec.view()).try();
    started = be.write_started_callback(
        n,
        rec.view(),
        layout.spawn.actor_ty
    ).try();
    stopped = be.write_stopped_callback(
        n,
        rec.view(),
        layout.spawn.actor_ty,
        layout.arena_ty
    ).try();
    be.write_spawn_value(ActorLifecycle(
        layout: layout,
        record: rec.view(),
        started: started.view(),
        stopped: stopped.view(),
    ))
}

write_actor_record = (
    be     :: CBackend,
    layout : ActorSpawnLayout,
    name   : str
) Res<(), AllocError> {
    a ::= be.alloc.String().try();
    be.ctype(layout.spawn.actor_ty, a).try();
    c ::= be.alloc.String().try();
    be.ctype(layout.context_ty, c).try();
    ar ::= be.alloc.String().try();
    be.ctype(layout.arena_ty, ar).try();
    storage = be.mailbox_type().try();
    be.request_type(storage).try();
    storage_c ::= be.alloc.String().try();
    be.ctype(storage, storage_c).try();
    text ::= be.alloc.String().try();
    text.fmt(
        "typedef struct {name} {{ zg_actor zg_base; {} zg_state; {} zg_ctx; {} zg_arena; {} zg_storage; }} {name};",
        a.view(),
        c.view(),
        ar.view(),
        storage_c.view()
    ).try();
    be.add_actor_def(text).try();
    be.write_mailbox_bridge(name, storage, storage_c.view())
}

mailbox_type = (be :: CBackend) Res<TyId, AllocError> {
    be.named_type_at(
        "MailboxStorage",
        "std.actor.actor_storage.MailboxStorage"
    ).try().match({
        Ok(ty) => Ok(ty),
        None   => Err(AllocError.OutOfMemory),
    })
}
mailbox_symbol = (
    be      :: CBackend,
    storage : TyId,
    name    : str
) Res<String, AllocError> {
    be.behavior_of(storage, name).try().match({
        Ok(hit) => be.behavior_symbol(storage, hit),
        None    => Err(AllocError.OutOfMemory),
    })
}
write_mailbox_bridge = (
    be        :: CBackend,
    record    : str,
    storage   : TyId,
    storage_c : str
) Res<(), AllocError> {
    ["take", "give"].loop((h, operation) {
        symbol = be.mailbox_symbol(storage, operation).try();
        name  ::= be.alloc.String("{record}_storage_{operation}").try();
        proto ::= be.alloc.String().try();
        body  ::= be.alloc.String().try();
        operation.eq("take").match({
            true  => {
                proto.fmt(
                    "{}void *{}(void *raw, size_t bytes)",
                    be.linkage(),
                    name.view()
                ).try();
                body.fmt(
                    "    return (void *){}(({} *)raw, bytes);\n",
                    symbol.view(),
                    storage_c
                ).try();
            },
            false => {
                proto.fmt(
                    "{}void {}(void *raw, void *block)",
                    be.linkage(),
                    name.view()
                ).try();
                body.fmt(
                    "    {}(({} *)raw, (unsigned char *)block);\n",
                    symbol.view(),
                    storage_c
                ).try();
            },
        });
        be.add_function(name, proto, body).try();
    });
    Ok(())
}

write_started_callback = (be :: CBackend, n: usize, rec: str, actor: TyId)
                         Res<String, AllocError> {
    name ::= be.alloc.String().try();
    name.add("NULL").try();
    hit: Res<BehaviorHit> = be.behavior_of(actor, "started").try();
    hit.match({
        None    => (),
        Ok(hit) => {
            callback ::= be.alloc.String().try();
            sym_gen(callback, "actor_started", n).try();
            be.add_lifecycle_callback(callback, rec, actor, hit, true).try();
            name = callback;
            ()
        },
    });
    Ok(name)
}

add_lifecycle_callback = (
    be      :: CBackend,
    name    : String,
    rec     : str,
    actor   : TyId,
    hit     : BehaviorHit,
    context : bool
)
                         Res<(), AllocError> {
    sym = be.behavior_symbol(actor, hit).try();
    proto ::= be.alloc.String().try();
    proto.fmt("{}void {}(zg_actor *zg_base)", be.linkage(), name.view()).try();
    body ::= be.alloc.String().try();
    body.fmt("    {rec} *zg_self = ({rec} *)zg_base;\n").try();
    ctx = be.context_arg(actor, hit).try();
    context.match({
        true  => body.fmt(
            "    (void)({}(&zg_self->zg_state, {}));\n",
            sym.view(),
            ctx
        ),
        false => body.fmt("    (void)({}(&zg_self->zg_state));\n", sym.view()),
    }).try();
    be.add_function(name, proto, body)
}

// A lifecycle behavior's context argument. The context lives in the actor
// record for the whole call, so a borrowed context parameter
// (gen_c_borrow.zen) receives its address.
context_arg = (
    be    :: CBackend,
    actor : TyId,
    hit   : BehaviorHit
) Res<str, AllocError> {
    inst = be.recv_inst(actor).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(actor, hit.site.decl, hit.f, hit.mi, inst, sig).try();
    be.passes_address(hit.f, 1, sig.ty_at(1)).try().match({
        true  => Ok("&zg_self->zg_ctx"),
        false => Ok("zg_self->zg_ctx"),
    })
}

behavior_symbol = (be :: CBackend, actor: TyId, hit: BehaviorHit)
                  Res<String, AllocError> {
    inst = be.recv_inst(actor).try();
    sig ::= be.alloc.Vec<TyId>();
    be.method_sig(actor, hit.site.decl, hit.f, hit.mi, inst, sig).try();
    be.member_symbol(actor, hit.site, hit.f.name.text, sig, inst)
}

write_stopped_callback = (
    be    :: CBackend,
    n     : usize,
    rec   : str,
    actor : TyId,
    arena : TyId
)
                         Res<String, AllocError> {
    name ::= be.alloc.String().try();
    sym_gen(name, "actor_stopped", n).try();
    proto ::= be.alloc.String().try();
    proto.fmt("{}void {}(zg_actor *zg_base)", be.linkage(), name.view()).try();
    body ::= be.alloc.String().try();
    body.fmt("    {rec} *zg_self = ({rec} *)zg_base;\n").try();
    be.behavior_of(actor, "stopped").try().match({
        None    => Ok(()),
        Ok(hit) => {
            sym = be.behavior_symbol(actor, hit).try();
            body.fmt(
                "    (void)({}(&zg_self->zg_state, {}));\n",
                sym.view(),
                be.context_arg(actor, hit).try()
            )
        },
    }).try();
    be.drop_symbol(actor).try().match({
        None    => Ok(()),
        Ok(sym) => body.fmt("    (void)({}(&zg_self->zg_state));\n", sym.view()),
    }).try();
    storage       = be.mailbox_type().try();
    close_storage = be.mailbox_symbol(storage, "close").try();
    body.fmt(
        "    (void)({}(&zg_self->zg_storage));\n",
        close_storage.view()
    ).try();
    be.drop_symbol(arena).try().match({
        None    => Ok(()),
        Ok(sym) => body.fmt("    (void)({}(&zg_self->zg_arena));\n", sym.view()),
    }).try();
    be.add_function(name, proto, body).try();
    Ok(name)
}

drop_symbol = (be :: CBackend, ty: TyId) Res<Res<String>, AllocError> {
    site_of(be, ty).try().match({
        None  => Ok(None),
        Ok(s) => be.impl_member(s.decl, "drop").try().match({
            None  => Ok(None),
            Ok(f) => {
                hit = BehaviorHit(site: s, f: f, mi: s.decl.module.to_usize());
                Ok(Ok(be.behavior_symbol(ty, hit).try()))
            },
        }),
    })
}

write_spawn_value = (be :: CBackend, lifecycle: ActorLifecycle)
                    Res<String, AllocError> {
    layout = lifecycle.layout;
    spawn  = layout.spawn;
    env_code ::= be.alloc.String().try();
    expr(be, spawn.access.base, spawn.ctx, spawn.receiver_ty, env_code).try();
    env = be.temp(spawn.receiver_ty, "env").try();
    be.set_line(env.view(), env_code.view()).try();
    actor_code ::= be.alloc.String().try();
    spawn.call.args.get(0).match({
        None      => actor_code.add("0"),
        Ok(value) => expr(
            be,
            value.value,
            spawn.ctx,
            spawn.actor_ty,
            actor_code
        ),
    }).try();
    actor = be.temp(spawn.actor_ty, "actor_value").try();
    be.set_line(actor.view(), actor_code.view()).try();
    state_c ::= be.alloc.String().try();
    be.ctype(layout.state_ty, state_c).try();
    cell        ::= be.fresh_name("actor_instance").try();
    arena_state ::= be.fresh_name("actor_state").try();
    status      ::= be.fresh_name("actor_status").try();
    be.fmt(
        "{} *{} = ({} *)malloc(sizeof({}));\n",
        lifecycle.record,
        cell.view(),
        lifecycle.record,
        lifecycle.record
    ).try();
    be.fmt(
        "{} *{} = ({} *)malloc(sizeof({}));\n",
        state_c.view(),
        arena_state.view(),
        state_c.view(),
        state_c.view()
    ).try();
    dst = be.temp(spawn.result_ty, "t").try();
    be.fmt("if (!{} || !{}) {{\n", cell.view(), arena_state.view()).try();
    be.indent();
    be.fmt("free({});\nfree({});\n", cell.view(), arena_state.view()).try();
    be.drop_symbol(spawn.actor_ty).try().match({
        None       => Ok(()),
        Ok(symbol) => be.fmt("(void)({}(&{}));\n", symbol.view(), actor.view()),
    }).try();
    be.write_assign_err(spawn.result_ty, "OutOfMemory", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.init_actor_fields(
        lifecycle,
        cell.view(),
        arena_state.view(),
        env.view(),
        actor.view()
    ).try();
    be.fmt(
        "int {} = zg_actor_start(&{}->zg_base);\n",
        status.view(),
        cell.view()
    ).try();
    be.fmt("if ({} != 0) {{\n", status.view()).try();
    be.indent();
    // No worker owns the value when startup fails. Run ordinary Drop for
    // the actor and let Arena.drop release both its pages and state cell.
    be.write_failed_spawn_drop(layout, cell.view()).try();
    be.fmt("free({});\n", cell.view()).try();
    be.write_assign_err(spawn.result_ty, "Unavailable", dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    ref_value ::= be.alloc.String().try();
    be.write_ref_value(spawn.ref_ty, cell.view(), ref_value).try();
    be.write_assign_ok(spawn.result_ty, ref_value.view(), dst.view()).try();
    be.dedent();
    be.writeln("}").try();
    be.dedent();
    be.writeln("}").try();
    Ok(dst)
}

write_failed_spawn_drop = (
    be     :: CBackend,
    layout : ActorSpawnLayout,
    cell   : str
) Res<(), AllocError> {
    be.drop_symbol(layout.spawn.actor_ty).try().match({
        None       => Ok(()),
        Ok(symbol) => be.fmt(
            "(void)({}(&{}->zg_state));\n",
            symbol.view(),
            cell
        ),
    }).try();
    be.drop_symbol(layout.arena_ty).try().match({
        None       => Ok(()),
        Ok(symbol) => be.fmt(
            "(void)({}(&{}->zg_arena));\n",
            symbol.view(),
            cell
        ),
    })
}

init_actor_fields = (
    be          :: CBackend,
    lifecycle   : ActorLifecycle,
    cell        : str,
    arena_state : str,
    env         : str,
    actor       : str
) Res<(), AllocError> {
    layout = lifecycle.layout;
    mem ::= be.alloc.String().try();
    mem.sym_member("mem").try();
    head ::= be.alloc.String().try();
    head.sym_member("head").try();
    next ::= be.alloc.String().try();
    next.sym_member("next").try();
    env_mem ::= be.alloc.String().try();
    env_mem.sym_member("mem").try();
    be.fmt("{arena_state}->{} = {env}.{};\n", mem.view(), env_mem.view()).try();
    be.fmt("{arena_state}->{} = NULL;\n", head.view()).try();
    be.fmt("{arena_state}->{} = 0;\n", next.view()).try();
    arena_c ::= be.alloc.String().try();
    be.ctype(layout.arena_ty, arena_c).try();
    arena_field ::= be.alloc.String().try();
    arena_field.sym_member("state").try();
    be.fmt(
        "{cell}->zg_arena = (({}){{ .{} = {arena_state} }});\n",
        arena_c.view(),
        arena_field.view()
    ).try();
    alloc_value ::= be.alloc.String().try();
    addr        ::= be.alloc.String().try();
    addr.fmt("&{cell}->zg_arena").try();
    be.fat_value(
        addr.view(),
        layout.arena_ty,
        layout.alloc_ty,
        alloc_value
    ).try();
    context_c ::= be.alloc.String().try();
    be.ctype(layout.context_ty, context_c).try();
    context_env ::= be.alloc.String().try();
    context_env.sym_member("env").try();
    context_alloc ::= be.alloc.String().try();
    context_alloc.sym_member("alloc").try();
    be.fmt(
        "{cell}->zg_ctx = (({}){{ .{} = {env}, .{} = {} }});\n",
        context_c.view(),
        context_env.view(),
        context_alloc.view(),
        alloc_value.view()
    ).try();
    storage = be.mailbox_type().try();
    storage_c ::= be.alloc.String().try();
    be.ctype(storage, storage_c).try();
    be.fmt("{cell}->zg_storage = ({}){{0}};\n", storage_c.view()).try();
    be.fmt("{cell}->zg_base.storage = &{cell}->zg_storage;\n").try();
    be.fmt("{cell}->zg_base.take = {}_storage_take;\n", lifecycle.record).try();
    be.fmt("{cell}->zg_base.give = {}_storage_give;\n", lifecycle.record).try();
    be.fmt("{cell}->zg_state = {actor};\n").try();
    be.fmt("{cell}->zg_base.state = &{cell}->zg_state;\n").try();
    be.fmt("{cell}->zg_base.context = &{cell}->zg_ctx;\n").try();
    be.fmt("{cell}->zg_base.started = {};\n", lifecycle.started).try();
    be.fmt("{cell}->zg_base.stopped = {};\n", lifecycle.stopped).try();
    be.fmt("{cell}->zg_base.joined = 0;\n").try();
    be.fmt("{cell}->zg_base.joining = 0;\n").try();
    Ok(())
}

write_ref_value = (
    be     :: CBackend,
    ref_ty : TyId,
    cell   : str,
    out    :: String
) Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(ref_ty, cty).try();
    id ::= be.alloc.String().try();
    id.sym_member("id").try();
    out.fmt(
        "(({}){{ .{} = (uint64_t)(uintptr_t){} }})",
        cty.view(),
        id.view(),
        cell
    )
}

actor_field = (be: CBackend, name: str) Res<str, AllocError> {
    field ::= be.alloc.String().try();
    field.sym_member(name).try();
    Ok(field.view())
}

// Each accepted byte-buffer message owns a separate receiver-backed arena.
// Admission constructs it privately; only the worker mutates it afterward.
// Its stable Alloc handle remains valid for retained/grown vectors until the
// actor's stopped hook and destructor finish. Failed admission drops it here.
write_buffer_transfer = (be :: CBackend, n: usize, payload: str, sig: Vec<TyId>)
                        Res<str, AllocError> {
    buffers ::= be.alloc.Vec<usize>();
    Range(2, sig.len).loop((h, i) {
        ty = sig.get(i).ok_or(AllocError.OutOfMemory).try();
        be.check.actor_byte_buffer(ty).then(() { buffers.add(i).try(); });
    });
    (buffers.len == 0).match({
        true  => Ok("NULL"),
        false => be.buffer_transfer(n, payload, sig, buffers),
    })
}

buffer_transfer = (
    be      :: CBackend,
    n       : usize,
    payload : str,
    sig     : Vec<TyId>,
    buffers : Vec<usize>
)
                  Res<str, AllocError> {
    arena_ty   = be.named_type_at("Arena", "std.mem.mem_arena.Arena").try().ok_or(AllocError.OutOfMemory).try();
    state_ptr  = be.field_of(arena_ty, "state").try().ok_or(AllocError.OutOfMemory).try();
    state_ty   = pointee(be, state_ptr).ok_or(AllocError.OutOfMemory).try();
    context_ty = sig.get(1).ok_or(AllocError.OutOfMemory).try();
    alloc_ty   = be.field_of(context_ty, "alloc").try().ok_or(AllocError.OutOfMemory).try();
    first      = buffers.get(0).ok_or(AllocError.OutOfMemory).try();
    vec_ty     = sig.get(first).ok_or(AllocError.OutOfMemory).try();
    ptr_ty     = be.field_of(vec_ty, "data").try().ok_or(AllocError.OutOfMemory).try();
    error_ty   = be.named_type_at("AllocError", "std.mem.mem_alloc.AllocError").try().ok_or(AllocError.OutOfMemory).try();
    result_ty  = be.check.types.res_failure(ptr_ty, error_ty).try();
    arena_c   ::= be.alloc.String().try();
    state_c   ::= be.alloc.String().try();
    context_c ::= be.alloc.String().try();
    alloc_c   ::= be.alloc.String().try();
    result_c  ::= be.alloc.String().try();
    be.ctype(arena_ty, arena_c).try();
    be.ctype(state_ty, state_c).try();
    be.ctype(context_ty, context_c).try();
    be.ctype(alloc_ty, alloc_c).try();
    be.request_type(result_ty).try();
    be.ctype(result_ty, result_c).try();
    name ::= be.alloc.String().try();
    name.sym_gen("actor_buffer", n).try();
    record ::= be.alloc.String().try();
    record.fmt("{}_owner", name.view()).try();
    definition ::= be.alloc.String().try();
    definition.fmt(
        "typedef struct {} {{ zg_actor_owned base; {} arena; }} {};",
        record.view(),
        arena_c.view(),
        record.view()
    ).try();
    be.add_actor_def(definition).try();
    drop_name ::= be.alloc.String().try();
    drop_name.fmt("{}_drop", name.view()).try();
    drop_proto ::= be.alloc.String().try();
    drop_proto.fmt(
        "{}void {}(zg_actor_owned *raw)",
        be.linkage(),
        drop_name.view()
    ).try();
    drop_body ::= be.alloc.String().try();
    drop_body.fmt(
        "    {} *owned = ({} *)raw;\n",
        record.view(),
        record.view()
    ).try();
    drop_sym = be.drop_symbol(arena_ty).try().ok_or(AllocError.OutOfMemory).try();
    drop_body.fmt(
        "    (void){}(&owned->arena);\n    free(owned);\n",
        drop_sym.view()
    ).try();
    be.add_function(drop_name, drop_proto, drop_body).try();
    proto ::= be.alloc.String().try();
    proto.fmt(
        "{}int {}(zg_actor *actor, void *raw, zg_actor_owned **pending)",
        be.linkage(),
        name.view()
    ).try();
    body ::= be.alloc.String().try();
    body.fmt("    {payload} *msg = ({payload} *)raw;\n").try();
    body.fmt(
        "    {} *ctx = ({} *)actor->context;\n",
        context_c.view(),
        context_c.view()
    ).try();
    body.fmt(
        "    {} *owned = ({} *)malloc(sizeof(*owned));\n",
        record.view(),
        record.view()
    ).try();
    body.fmt(
        "    {} *state = ({} *)malloc(sizeof(*state));\n",
        state_c.view(),
        state_c.view()
    ).try();
    body.add(
        "    if (!owned || !state) { free(owned); free(state); return 0; }\n"
    ).try();
    mem   = be.actor_field("mem").try();
    env   = be.actor_field("env").try();
    head  = be.actor_field("head").try();
    next  = be.actor_field("next").try();
    state = be.actor_field("state").try();
    body.fmt(
        "    state->{mem} = ctx->{env}.{mem}; state->{head} = NULL; state->{next} = 0;\n"
    ).try();
    body.fmt("    owned->arena.{state} = state;\n").try();
    body.fmt(
        "    owned->base.drop = {}; owned->base.next = *pending; *pending = &owned->base;\n",
        drop_name.view()
    ).try();
    alloc_value ::= be.alloc.String().try();
    be.fat_value("&owned->arena", arena_ty, alloc_ty, alloc_value).try();
    body.fmt("    {} alloc = {};\n", alloc_c.view(), alloc_value.view()).try();
    data      = be.actor_field("data").try();
    len       = be.actor_field("len").try();
    capacity  = be.actor_field("capacity").try();
    allocator = be.actor_field("alloc").try();
    raw       = be.actor_field("raw").try();
    ok        = be.actor_field("Ok").try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(RES_PATH, "Ok").try();
    buffers.loop((h, i) {
        arg ::= be.alloc.String("msg->zg_arg").try();
        arg.write_usize(i - 2).try();
        body.add("    {\n        unsigned char *bytes = NULL;\n").try();
        body.fmt("        if ({}.{len}) {{\n", arg.view()).try();
        body.fmt(
            "            {} result = alloc.{raw}(alloc.zg_self, {}.{len}, 1);\n",
            result_c.view(),
            arg.view()
        ).try();
        body.fmt("            if (result.zg_tag != {}) return 0;\n", tag.view()).try();
        body.fmt("            bytes = result.zg_data.{ok};\n").try();
        body.fmt(
            "            memcpy(bytes, {}.{data}, {}.{len});\n        }}\n",
            arg.view(),
            arg.view()
        ).try();
        body.fmt(
            "        {}.{data} = bytes; {}.{capacity} = {}.{len}; {}.{allocator} = alloc;\n    }}\n",
            arg.view(),
            arg.view(),
            arg.view(),
            arg.view()
        ).try();
    });
    body.add("    return 1;\n").try();
    be.add_function(name, proto, body).try();
    Ok(name.view())
}
