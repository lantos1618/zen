// Type-directed lowering for std.cli's `outcome<T>(env, a, argv)`. The type
// is concrete at the call site, so its fields and variants are walked here,
// at compile time, into calls of std.cli.cli_derive's helpers: one
// declaration per field or variant, one scan, then one conversion per field.
// A struct is one command and an enum is its subcommands; a payload that is
// itself an enum nests. Every helper that can stop answers `Res<_, Stop>`,
// and a stop is copied into the answer and ends the call.

{ Struct, Enum, Variant, Member, Function, ExprId, Call, Impl } = std.ast
{ type_from_ast } = sema.sema_denote
{ AllocError } = std.mem
{ Vec, vararg } = std.collections
{ str, String } = std.text
{ Res, Ok, None, Range } = std.core
{ TyId, TyNamed, is_failure } = sema.sema_ty
{ Def, decl_at } = sema.sema_def
{ Ctx } = sema.sema_check
{ Inst } = sema.sema_inst
{ LocalImpl, local_impls } = sema.sema_supply
{ GenFault } = gen.gen_diag
{ CBackend } = gen.gen_c.gen_c_state
{ expr, res_type_of, ty_of } = gen.gen_c.gen_c_expr
{ declare_temp, payload_type, enum_path, write_assign_ok } = gen.gen_c.gen_c_flow
{ write_goto, write_done, call_symbol, bodyless } = gen.gen_c.gen_c_sink
{ field_type, variant_type, decl_ctx, decl_inst } = gen.gen_c.gen_c_type
{ write_zero, write_none, ctype, request_type } = gen.gen_c.gen_c_type
{ enter_struct_tparams, leave_tparams } = gen.gen_c.gen_c_mono
{ sym_member, sym_variant, RES_PATH } = gen.gen_name
{ unsupported } = gen.gen_c.gen_c_report
{ passes_address } = gen.gen_c.gen_c_borrow
{ signature_of } = gen.gen_c.gen_c_call

CLI_MODULE: str = "std.cli.cli_derive"

is_cli_door* = (d: Def, f: Function) bool {
    d.name.eq("outcome") && d.qname.eq("std.cli.cli_derive.outcome") && bodyless(f)
}

// What one word of a field becomes.
Word = { Text | Location | Unsigned: TyId | Signed: TyId | Choice: TyId }

// How a field takes its words: a switch, one word, an optional word, every
// repetition (Vec<str>), or the words after `--`.
Form = { Switch | One: Word | Maybe: Word | Many | Rest | Unfit }

// One field of a derived struct. `entry` is its Spec in the Cli table.
Slot = {
    id: usize,
    name: str,
    ty: TyId,
    form: Form,
    positional: bool,
    default: Res<ExprId>,
    entry: Res<ExprId>,
}

lower_cli_door* = (
    be  :: CBackend,
    id  : ExprId,
    c   : Call,
    d   : Def,
    ctx : Ctx,
    out :: String
) Res<AllocError> {
    ret = be.res_type_of(id, ctx).try();
    be.payload_type(ret, "Ok").match({
        None    => be.unsupported(id, "outcome with nothing to parse", out),
        Ok(top) => {
            lower = CliLower(
                id: id,
                ret: ret,
                dst: be.fresh_name("cli").try(),
                env: be.fresh_name("cli_env").try(),
                alloc: be.fresh_name("cli_alloc").try(),
                argv: be.fresh_name("cli_argv").try(),
                program: be.fresh_name("cli_program").try(),
                done: be.next_tmp()
            );
            lower.start(be, c, d, ctx).try();
            value = lower.root(be, top).try();
            be.write_assign_ok(ret, value.view(), lower.dst.view()).try();
            be.write_done(lower.done).try();
            out.add(lower.dst.view())
        },
    })
}

// The answer, the door's arguments held in temporaries, and the one exit
// every stop jumps to.
CliLower = {
    id: ExprId,
    ret: TyId,
    dst: String,
    env: String,
    alloc: String,
    argv: String,
    program: String,
    done: usize,

    // The answer's storage, then the door's arguments in order.
    start = (self: @Self, be :: CBackend, c: Call, d: Def, ctx: Ctx)
            Res<AllocError> {
        be.request_type(self.ret).try();
        be.declare_temp(self.ret, self.dst.view()).try();
        sig  ::= be.alloc.Vec<TyId>();
        inst ::= be.alloc.Inst();
        be.signature_of(d, inst, sig).try();
        self.argument(be, c, sig, 0, self.env.view(), ctx).try();
        self.argument(be, c, sig, 1, self.alloc.view(), ctx).try();
        self.argument(be, c, sig, 2, self.argv.view(), ctx).try();
        str_ty = be.check.types.prim("str").try();
        be.declare_temp(str_ty, self.program.view())
    }

    argument = (self: @Self, be :: CBackend, c: Call, sig: Vec<TyId>, i: usize,
                name: str, ctx: Ctx) Res<AllocError> {
        ty = sig.get(i).ok_or(AllocError.OutOfMemory).try();
        be.request_type(ty).try();
        be.declare_temp(ty, name).try();
        c.args.get(i).match({
            None    => Ok,
            Ok(arg) => {
                rendered ::= be.alloc.String().try();
                expr(be, arg.value, ctx, ty, rendered).try();
                be.set_line(name, rendered.view())
            },
        })
    }

    // The type named at the door, as the program's own command.
    root = (self: @Self, be :: CBackend, top: TyId) Res<String, AllocError> {
        name = self.table_str(be, top, "name").try();
        self.call_into(be, self.program.view(), "program", self.argv.view(), name.view()).try();
        self.command(be, top, self.program.view(), "1", "0")
    }

    // A command of type `ty` whose usage path is `path`, parsing from word
    // `start`; `help` is C text saying whether only its help is wanted. The
    // answer names a temporary holding the parsed value.
    command = (self: @Self, be :: CBackend, ty: TyId, path: str, start: str,
               help: str) Res<String, AllocError> {
        value = be.fresh_name("cli_value").try();
        be.request_type(ty).try();
        be.declare_temp(ty, value.view()).try();
        be.check.types.at(ty).match({
            Named(n) => decl_at(be.tree, n.decl).match({
                Ok(decl) => decl.kind.match({
                    Struct(record) => self.fields(be, ty, n, record, value.view(), path, start, help),
                    Enum(choice)   => self.variants(be, ty, n, choice, value.view(), path, start, help),
                    _              => self.refuse(be, "a command line type that is not a struct or an enum"),
                }),
                None     => self.refuse(be, "a command line type without a declaration"),
            }),
            _        => self.refuse(be, "a command line type that is not a struct or an enum"),
        }).try();
        Ok(value)
    }

    refuse = (self: @Self, be :: CBackend, what: str) Res<AllocError> {
        be.report_expr(self.id, GenFault.Unsupported(what))
    }

    // One struct: declare each field, scan, then fill each field.
    fields = (
        self   : @Self,
        be     :: CBackend,
        ty     : TyId,
        n      : TyNamed,
        record : Struct,
        value  : str,
        path   : str,
        start  : str,
        help   : str
    ) Res<AllocError> {
        cmd   = self.model(be, ty, path).try();
        inst  = be.decl_inst(n).try();
        dctx  = be.decl_ctx(n);
        mark  = be.enter_struct_tparams(n.decl).try();
        table = self.table(be, ty).try();
        slots ::= be.alloc.Vec<Slot>();
        record.members.loop((h, member) {
            member.kind.match({
                Field(f) => be.field_type(member, dctx, inst).match({
                    None      => Ok,
                    Ok(fty)   => {
                        entry = be.spec_entry(table, f.name.text, dctx).try();
                        slots.add(Slot(
                            id: slots.len,
                            name: f.name.text,
                            ty: fty,
                            form: be.form_of(fty, be.trailing_in(entry)),
                            positional: !f.mutable,
                            default: f.value,
                            entry: entry
                        ))
                    },
                }).try(),
                _        => (),
            });
        });
        slots.loop((slot) { self.declare(be, ty, cmd.view(), slot).try(); });
        scanned = self.checked(be, "scan_fields", self.alloc.view(), cmd.view(),
                               self.env.view(), self.argv.view(), start,
                               self.program.view(), help).try();
        matches = ok_of(be, scanned.view()).try();
        zero ::= be.alloc.String().try();
        be.write_zero(ty, zero).try();
        be.set_line(value, zero.view()).try();
        slots.loop((slot) { self.fill(be, slot, value, matches.view(), dctx).try(); });
        be.leave_tparams(mark)
    }

    // `cmd = derived(a, path, about, note)`, from the type's Cli table.
    model = (self: @Self, be :: CBackend, ty: TyId, path: str)
            Res<String, AllocError> {
        about = self.table_str(be, ty, "about").try();
        note  = self.table_str(be, ty, "note").try();
        self.call(be, "derived", self.alloc.view(), path, about.view(), note.view())
    }

    // The type's impl of std.cli's Cli, which holds its table.
    table = (self: @Self, be :: CBackend, ty: TyId) Res<Res<Impl>, AllocError> {
        be.check.types.at(ty).match({
            Named(n) => {
                impls ::= be.alloc.Vec<LocalImpl>();
                be.check.local_impls(n, impls).try();
                Ok(impls.find((li) { be.is_cli_bound(li.bound) }).match({
                    Ok(li) => Ok(li.im),
                    None   => None,
                }))
            },
            _        => Ok(None),
        })
    }

    table_ctx = (self: @Self, be :: CBackend, ty: TyId) Ctx {
        be.check.types.at(ty).match({
            Named(n) => be.decl_ctx(n),
            _        => Ctx(0, ty),
        })
    }

    // A `str` entry of the type's table, held in a temporary; the empty
    // string when the table has no such entry.
    table_str = (self: @Self, be :: CBackend, ty: TyId, key: str)
                Res<String, AllocError> {
        str_ty = be.check.types.prim("str").try();
        held = be.fresh_name("cli_text").try();
        be.declare_temp(str_ty, held.view()).try();
        rendered ::= be.alloc.String().try();
        be.str_entry(self.table(be, ty).try(), key, self.table_ctx(be, ty)).try().match({
            None    => lit(be, "", rendered).try(),
            Ok(eid) => expr(be, eid, self.table_ctx(be, ty), str_ty, rendered).try(),
        });
        be.set_line(held.view(), rendered.view()).try();
        Ok(held)
    }

    // A table entry's Spec, held in a temporary; a plain Spec without one.
    spec = (self: @Self, be :: CBackend, ty: TyId, entry: Res<ExprId>)
           Res<String, AllocError> {
        entry.match({
            None    => self.call(be, "plain"),
            Ok(eid) => {
                spec_ty = be.helper_ret("plain").try();
                be.request_type(spec_ty).try();
                held = be.fresh_name("cli_spec").try();
                be.declare_temp(spec_ty, held.view()).try();
                rendered ::= be.alloc.String().try();
                expr(be, eid, self.table_ctx(be, ty), spec_ty, rendered).try();
                be.set_line(held.view(), rendered.view()).try();
                Ok(held)
            },
        })
    }

    declare = (self: @Self, be :: CBackend, ty: TyId, cmd: str, slot: Slot)
              Res<AllocError> {
        spec = self.spec(be, ty, slot.entry).try();
        id ::= be.alloc.String("{}u", slot.id).try();
        long ::= be.alloc.String().try();
        lit(be, flag_of(be, slot.name).try().view(), long).try();
        upper ::= be.alloc.String().try();
        lit(be, upper_of(be, slot.name).try().view(), upper).try();
        default ::= be.alloc.String().try();
        shown = default_text(be, slot.form, slot.default).try();
        shown.match({
            Ok(text) => lit(be, text.view(), default),
            None     => lit(be, "", default),
        }).try();
        has = shown.match({ Ok(_) => true, None => false });
        site = Site(
            cmd: cmd,
            id: id.view(),
            long: long.view(),
            upper: upper.view(),
            spec: spec.view(),
            positional: slot.positional,
            default: default.view(),
            has: has
        );
        slot.form.match({
            Switch      => self.checked_unit(be, "switch_field", cmd, id.view(), long.view(), spec.view()),
            Rest        => self.call_into(be, "", "trailing_field", cmd),
            Many        => self.word_field(be, site, Word.Text, slot.positional, true),
            One(word)   => self.word_field(be, site, word, slot.default.match({ Ok(_) => false, None => true }), false),
            Maybe(word) => self.word_field(be, site, word, false, false),
            Unfit       => self.refuse(be, "a field std.cli cannot parse"),
        })
    }

    word_field = (self: @Self, be :: CBackend, site: Site, word: Word,
                  required: bool, many: bool) Res<AllocError> {
        args ::= be.alloc.Vec<str>();
        args.add(site.cmd).try();
        args.add(site.id).try();
        args.add(site.long).try();
        args.add(site.upper).try();
        args.add(site.spec).try();
        args.add(bool_text(site.positional)).try();
        args.add(bool_text(required)).try();
        args.add(bool_text(many)).try();
        args.add(site.default).try();
        args.add(bool_text(site.has)).try();
        limits  ::= be.alloc.String().try();
        choices ::= be.alloc.String().try();
        helper = word.match({
            Text        => "text_field",
            Location    => "text_field",
            Unsigned(p) => { be.limits_into(p, limits).try(); "number_field" },
            Signed(p)   => { be.limits_into(p, limits).try(); "number_field" },
            Choice(e)   => { lit(be, choices_of(be, e).try().view(), choices).try(); "choice_field" },
        });
        (!limits.view().is_empty()).then(() {
            limits.view().split('|').loop((part) { args.add(part).try(); });
        });
        (!choices.view().is_empty()).then(() { args.add(choices.view()).try(); });
        tmp = self.call_list(be, helper, args).try();
        self.stop_unless_ok(be, tmp.view())
    }

    // Each field lands in the value: from its words, else its default.
    fill = (self: @Self, be :: CBackend, slot: Slot, value: str, matches: str,
            dctx: Ctx) Res<AllocError> {
        place ::= be.alloc.String("{}.", value).try();
        place.sym_member(slot.name).try();
        id ::= be.alloc.String("{}u", slot.id).try();
        slot.form.match({
            Switch      => {
                got = self.call(be, "switch_of", matches, id.view()).try();
                slot.default.match({
                    None    => be.set_line(place.view(), got.view()),
                    Ok(eid) => {
                        rendered ::= be.alloc.String().try();
                        expr(be, eid, dctx, slot.ty, rendered).try();
                        both ::= be.alloc.String("({} || {})", got.view(), rendered.view()).try();
                        be.set_line(place.view(), both.view())
                    },
                })
            },
            Many        => {
                got = self.checked(be, "texts_of", self.alloc.view(), matches, id.view()).try();
                be.set_line(place.view(), ok_of(be, got.view()).try().view())
            },
            Rest        => {
                got = self.checked(be, "rest_of", self.alloc.view(), self.argv.view(), matches).try();
                be.set_line(place.view(), ok_of(be, got.view()).try().view())
            },
            One(word)   => {
                got = self.word_of(be, word, matches, id.view()).try();
                open_absent(be, got.view()).try();
                slot.default.match({
                    Ok(eid) => {
                        rendered ::= be.alloc.String().try();
                        expr(be, eid, dctx, slot.ty, rendered).try();
                        be.set_line(place.view(), rendered.view()).try();
                    },
                    // The engine refuses a required field that is absent.
                    None    => (),
                });
                open_else(be).try();
                self.convert(be, word, slot.ty, got.view(), place.view()).try();
                close(be)
            },
            Maybe(word) => {
                got = self.word_of(be, word, matches, id.view()).try();
                open_absent(be, got.view()).try();
                none ::= be.alloc.String().try();
                be.write_none(slot.ty, none).try();
                be.set_line(place.view(), none.view()).try();
                open_else(be).try();
                inner = be.res_inner(slot.ty);
                held = be.fresh_name("cli_word").try();
                be.request_type(inner).try();
                be.declare_temp(inner, held.view()).try();
                self.convert(be, word, inner, got.view(), held.view()).try();
                be.write_assign_ok(slot.ty, held.view(), place.view()).try();
                close(be)
            },
            Unfit       => Ok,
        })
    }

    // The helper answering one word's value: Res<str>, Res<Path>, Res<u64>,
    // Res<i64>, or the Res<usize> position of a choice.
    word_of = (self: @Self, be :: CBackend, word: Word, matches: str, id: str)
              Res<String, AllocError> {
        word.match({
            Text        => self.call(be, "text_of", matches, id),
            Location    => self.call(be, "path_of", matches, id),
            Unsigned(_) => self.call(be, "unsigned_of", matches, id),
            Signed(_)   => self.call(be, "signed_of", matches, id),
            Choice(e)   => {
                choices ::= be.alloc.String().try();
                lit(be, choices_of(be, e).try().view(), choices).try();
                self.call(be, "choice_of", matches, id, choices.view())
            },
        })
    }

    // `place = <the Ok payload of got>`, as the field's type: a number is
    // narrowed (the engine checked its range) and a choice picks a variant.
    convert = (self: @Self, be :: CBackend, word: Word, ty: TyId, got: str,
               place: str) Res<AllocError> {
        payload = ok_of(be, got).try();
        cty ::= be.alloc.String().try();
        be.ctype(ty, cty).try();
        cast ::= be.alloc.String("(({}){})", cty.view(), payload.view()).try();
        word.match({
            Choice(e)   => self.choose(be, e, payload.view(), place),
            Unsigned(_) => be.set_line(place, cast.view()),
            Signed(_)   => be.set_line(place, cast.view()),
            _           => be.set_line(place, payload.view()),
        })
    }

    // `switch (position) { case i: place = <variant i>; }`.
    choose = (self: @Self, be :: CBackend, e: TyId, position: str, place: str)
             Res<AllocError> {
        be.fmt("switch ({}) {{\n", position).try();
        variants_of(be, e).loop((h, i, v) {
            value = enum_value(be, e, v.name.text, "").try();
            line ::= be.alloc.String("case {}u: ", i).try();
            line.fmt("{} = {}; break;\n", place, value.view()).try();
            be.fmt("{}", line.view()).try();
        });
        be.writeln("default: break;\n}")
    }

    // One enum: each variant a subcommand, then `help` and maybe
    // `--version`, then the chosen variant's own command.
    variants = (
        self   : @Self,
        be     :: CBackend,
        ty     : TyId,
        n      : TyNamed,
        choice : Enum,
        value  : str,
        path   : str,
        start  : str,
        help   : str
    ) Res<AllocError> {
        cmd   = self.model(be, ty, path).try();
        inst  = be.decl_inst(n).try();
        dctx  = be.decl_ctx(n);
        mark  = be.enter_struct_tparams(n.decl).try();
        table = self.table(be, ty).try();
        choice.variants.loop((h, i, v) {
            id ::= be.alloc.String("{}u", i).try();
            name ::= be.alloc.String().try();
            lit(be, kebab(be, v.name.text).try().view(), name).try();
            about = self.variant_about(be, ty, n, v, table, dctx, inst).try();
            self.checked_unit(be, "command_field", cmd.view(), id.view(), name.view(), about.view()).try();
        });
        count ::= be.alloc.String("{}u", choice.variants.len).try();
        self.checked_unit(be, "help_field", self.alloc.view(), cmd.view(), count.view(), self.program.view()).try();
        version = self.table_str(be, ty, "version").try();
        be.str_entry(table, "version", dctx).try().when_ok((_) {
            after ::= be.alloc.String("{}u", choice.variants.len + 1).try();
            self.checked_unit(be, "version_field", cmd.view(), after.view()).try();
        });
        picked = self.checked(be, "scan_commands", self.alloc.view(), cmd.view(),
                              self.env.view(), self.argv.view(), start,
                              self.program.view(), help, count.view(),
                              version.view()).try();
        pick = ok_of(be, picked.view()).try();
        variant ::= be.alloc.String("{}.", pick.view()).try();
        variant.sym_member("variant").try();
        next ::= be.alloc.String("{}.", pick.view()).try();
        next.sym_member("next").try();
        asked ::= be.alloc.String("{}.", pick.view()).try();
        asked.sym_member("help").try();
        be.fmt("switch ({}) {{\n", variant.view()).try();
        choice.variants.loop((h, i, v) {
            label ::= be.alloc.String("case {}u: {{\n", i).try();
            be.fmt("{}", label.view()).try();
            be.indent();
            self.chosen(be, ty, n, v, table, dctx, inst, value, path, next.view(), asked.view()).try();
            be.writeln("break;").try();
            be.dedent();
            be.writeln("}").try();
        });
        be.writeln("default: break;\n}").try();
        be.leave_tparams(mark)
    }

    // The chosen variant: its payload's command, or an argument-less one.
    chosen = (
        self  : @Self,
        be    :: CBackend,
        ty    : TyId,
        n     : TyNamed,
        v     : Variant,
        table : Res<Impl>,
        dctx  : Ctx,
        inst  : Inst,
        value : str,
        path  : str,
        next  : str,
        asked : str
    ) Res<AllocError> {
        sub ::= be.alloc.String().try();
        lit(be, kebab(be, v.name.text).try().view(), sub).try();
        joined = self.checked(be, "joined", self.alloc.view(), path, sub.view()).try();
        sub_path = self.call(be, "spelled", ok_of(be, joined.view()).try().view()).try();
        built = be.variant_type(n, v, dctx, inst).match({
            Ok(pty) => {
                inner = self.command(be, pty, sub_path.view(), next, asked).try();
                enum_value(be, ty, v.name.text, inner.view()).try()
            },
            None    => {
                about ::= be.alloc.String().try();
                self.entry_help(be, ty, v.name.text, table, about).try().match({
                    true  => (),
                    false => lit(be, "", about).try(),
                });
                note ::= be.alloc.String().try();
                lit(be, "", note).try();
                cmd = self.call(be, "derived", self.alloc.view(), sub_path.view(), about.view(), note.view()).try();
                self.checked(be, "scan_fields", self.alloc.view(), cmd.view(),
                             self.env.view(), self.argv.view(), next,
                             self.program.view(), asked).try();
                enum_value(be, ty, v.name.text, "").try()
            },
        });
        be.set_line(value, built.view())
    }

    // A subcommand's line in its parent's help: the parent table's entry
    // for the variant, else the payload's own `about`.
    variant_about = (self: @Self, be :: CBackend, ty: TyId, n: TyNamed, v: Variant,
                     table: Res<Impl>, dctx: Ctx, inst: Inst)
                    Res<String, AllocError> {
        out ::= be.alloc.String().try();
        self.entry_help(be, ty, v.name.text, table, out).try().match({
            true  => Ok(out),
            false => be.variant_type(n, v, dctx, inst).match({
                Ok(pty) => self.table_str(be, pty, "about"),
                None    => {
                    lit(be, "", out).try();
                    Ok(out)
                },
            }),
        })
    }

    // The `help` of a variant's Spec entry in the table, when there is one.
    entry_help = (self: @Self, be :: CBackend, ty: TyId, name: str, table: Res<Impl>,
                  out :: String) Res<bool, AllocError> {
        entry = be.spec_entry(table, name, self.table_ctx(be, ty)).try();
        entry.match({
            None    => Ok(false),
            Ok(_)   => {
                held = self.spec(be, ty, entry).try();
                out.add(held.view()).try();
                out.add(".").try();
                out.sym_member("help").try();
                Ok(true)
            },
        })
    }

    // `<tmp> = <helper>(<args>);`, answering the temporary.
    call = (self: @Self, be :: CBackend, name: str, args: vararg<str>)
           Res<String, AllocError> {
        list ::= be.alloc.Vec<str>();
        args.loop((a) { list.add(a).try(); });
        self.call_list(be, name, list)
    }

    call_list = (self: @Self, be :: CBackend, name: str, args: Vec<str>)
                Res<String, AllocError> {
        ty = be.helper_ret(name).try();
        be.request_type(ty).try();
        tmp = be.fresh_name("cli_got").try();
        be.declare_temp(ty, tmp.view()).try();
        be.invoke(tmp.view(), name, args).try();
        Ok(tmp)
    }

    // `<dst> = <helper>(<args>);`, or the bare call when `dst` is empty.
    call_into = (self: @Self, be :: CBackend, dst: str, name: str, args: vararg<str>)
                Res<AllocError> {
        list ::= be.alloc.Vec<str>();
        args.loop((a) { list.add(a).try(); });
        be.invoke(dst, name, list)
    }

    // A helper answering Res<_, Stop>, and the jump out when it stopped.
    checked = (self: @Self, be :: CBackend, name: str, args: vararg<str>)
              Res<String, AllocError> {
        list ::= be.alloc.Vec<str>();
        args.loop((a) { list.add(a).try(); });
        tmp = self.call_list(be, name, list).try();
        self.stop_unless_ok(be, tmp.view()).try();
        Ok(tmp)
    }

    checked_unit = (self: @Self, be :: CBackend, name: str, args: vararg<str>)
                   Res<AllocError> {
        list ::= be.alloc.Vec<str>();
        args.loop((a) { list.add(a).try(); });
        tmp = self.call_list(be, name, list).try();
        self.stop_unless_ok(be, tmp.view())
    }

    // `if (<res> is not Ok) { answer = Err(<its Stop>); goto done; }`.
    stop_unless_ok = (self: @Self, be :: CBackend, res: str) Res<AllocError> {
        ok ::= be.alloc.String().try();
        ok.sym_variant(RES_PATH, "Ok").try();
        err ::= be.alloc.String().try();
        err.sym_variant(RES_PATH, "Err").try();
        member ::= be.alloc.String().try();
        member.sym_member("Err").try();
        cty ::= be.alloc.String().try();
        be.ctype(self.ret, cty).try();
        be.fmt("if ({}.zg_tag != {}) {{\n", res, ok.view()).try();
        be.indent();
        be.fmt(
            "{} = (({}){{ .zg_tag = {}, .zg_data.{} = {}.zg_data.{} }});\n",
            self.dst.view(),
            cty.view(),
            err.view(),
            member.view(),
            res,
            member.view()
        ).try();
        be.write_goto(self.done).try();
        be.dedent();
        be.writeln("}")
    }
}

// What a field declaration passes to its helper, as C text.
Site = {
    cmd: str,
    id: str,
    long: str,
    upper: str,
    spec: str,
    positional: bool,
    default: str,
    has: bool,
}

// A table entry is a command setting when it is a `str`, and configures the
// field or variant of its name when it is a Spec; one name can be only one.
str_entry = (be :: CBackend, table: Res<Impl>, key: str, ctx: Ctx)
            Res<Res<ExprId>, AllocError> {
    be.entry_typed(table, key, ctx, false)
}

spec_entry = (be :: CBackend, table: Res<Impl>, key: str, ctx: Ctx)
             Res<Res<ExprId>, AllocError> {
    be.entry_typed(table, key, ctx, true)
}

entry_typed = (be :: CBackend, table: Res<Impl>, key: str, ctx: Ctx, spec: bool)
              Res<Res<ExprId>, AllocError> {
    entry = table.match({
        Ok(im) => im.field_value(key),
        None   => None,
    });
    entry.match({
        None      => Ok(None),
        Ok(eid)   => {
            unknown = be.check.types.unknown().try();
            ty = be.ty_of(eid, ctx, unknown).try();
            is_spec = be.check.types.at(ty).match({
                Named(n) => n.name.eq("Spec") && be.check.world.module_name(n.decl).eq("std.cli.cli"),
                _        => false,
            });
            Ok((is_spec == spec).match({ true => Ok(eid), false => None }))
        },
    })
}

// Whether the bound is std.cli's Cli.
is_cli_bound = (be :: CBackend, bound: TyId) bool {
    be.check.types.at(bound).match({
        Named(n) => n.name.eq("Cli") && be.check.world.module_name(n.decl).eq(CLI_MODULE),
        _        => false,
    })
}

// Whether a table entry is a Spec call that sets `trailing: true`.
trailing_in = (be :: CBackend, entry: Res<ExprId>) bool {
    entry.match({
        None    => false,
        Ok(eid) => be.tree.expr_at(eid).kind.match({
            Call(c) => c.args.find((a) {
                a.name.match({ Ok(n) => n.text.eq("trailing"), None => false })
                    && be.tree.expr_at(a.value).kind.match({
                        Literal(l) => l.text.eq("true"),
                        _          => false,
                    })
            }).match({ Ok(_) => true, None => false }),
            _       => false,
        }),
    })
}

// The form a field's type gives it.
form_of = (be :: CBackend, ty: TyId, trailing: bool) Form {
    be.check.types.at(ty).match({
        Prim(p)  => p.name.eq("bool").match({
            true  => Form.Switch,
            false => be.word_of_type(ty).match({ Ok(w) => Form.One(w), None => Form.Unfit }),
        }),
        Res(r)   => is_failure(r.form).match({
            true  => Form.Unfit,
            false => be.word_of_type(r.value).match({ Ok(w) => Form.Maybe(w), None => Form.Unfit }),
        }),
        Named(n) => be.is_str_vec(n).match({
            true  => trailing.match({ true => Form.Rest, false => Form.Many }),
            false => be.word_of_type(ty).match({ Ok(w) => Form.One(w), None => Form.Unfit }),
        }),
        _        => Form.Unfit,
    })
}

is_str_vec = (be :: CBackend, n: TyNamed) bool {
    n.name.eq("Vec") && n.args.get(0).match({
        Ok(arg) => be.check.types.at(arg).match({ Prim(p) => p.name.eq("str"), _ => false }),
        None    => false,
    })
}

word_of_type = (be :: CBackend, ty: TyId) Res<Word> {
    be.check.types.at(ty).match({
        Prim(p)  => p.name.match({
            "str"   => Ok(Word.Text),
            "u8"    => Ok(Word.Unsigned(ty)),
            "u16"   => Ok(Word.Unsigned(ty)),
            "u32"   => Ok(Word.Unsigned(ty)),
            "u64"   => Ok(Word.Unsigned(ty)),
            "usize" => Ok(Word.Unsigned(ty)),
            "i8"    => Ok(Word.Signed(ty)),
            "i16"   => Ok(Word.Signed(ty)),
            "i32"   => Ok(Word.Signed(ty)),
            "i64"   => Ok(Word.Signed(ty)),
            _       => None,
        }),
        Named(n) => (n.name.eq("Path") && be.check.world.module_name(n.decl).eq("std.core.path")).match({
            true  => Ok(Word.Location),
            false => be.unit_enum(n).match({ true => Ok(Word.Choice(ty)), false => None }),
        }),
        _        => None,
    })
}

// An enum every variant of which is bare: its names are the choices.
unit_enum = (be :: CBackend, n: TyNamed) bool {
    decl_at(be.tree, n.decl).match({
        Ok(decl) => decl.kind.match({
            Enum(e) => e.variants.len > 0 && e.variants.find((v) {
                v.payload.match({ Ok(_) => true, None => false })
            }).match({ Ok(_) => false, None => true }),
            _       => false,
        }),
        None     => false,
    })
}

variants_of = (be :: CBackend, ty: TyId) Vec<Variant> {
    be.check.types.at(ty).match({
        Named(n) => decl_at(be.tree, n.decl).match({
            Ok(decl) => decl.kind.match({
                Enum(e) => e.variants,
                _       => be.alloc.Vec<Variant>(),
            }),
            None     => be.alloc.Vec<Variant>(),
        }),
        _        => be.alloc.Vec<Variant>(),
    })
}

// `debug|release|small` for `{ Debug | Release | Small }`.
choices_of = (be :: CBackend, ty: TyId) Res<String, AllocError> {
    out ::= be.alloc.String().try();
    variants_of(be, ty).loop((h, i, v) {
        (i > 0).then(() { out.add('|').try(); });
        out.add(kebab(be, v.name.text).try().view()).try();
    });
    Ok(out)
}

// `dry-run` for `DryRun`.
kebab = (be :: CBackend, name: str) Res<String, AllocError> {
    out ::= be.alloc.String().try();
    Range(0, name.len).loop((h, i) {
        b = name.index(i);
        upper = b >= 'A' && b <= 'Z';
        (upper && i > 0).then(() { out.add('-').try(); });
        out.add(upper.match({ true => b + 32, false => b })).try();
    });
    Ok(out)
}

// `--emit-c-dir` for `emit_c_dir`.
flag_of = (be :: CBackend, field: str) Res<String, AllocError> {
    out ::= be.alloc.String("--").try();
    Range(0, field.len).loop((h, i) {
        b = field.index(i);
        out.add((b == '_').match({ true => '-', false => b })).try();
    });
    Ok(out)
}

// `EMIT_DIR` for `emit_dir`: how help names a field's value.
upper_of = (be :: CBackend, field: str) Res<String, AllocError> {
    out ::= be.alloc.String().try();
    Range(0, field.len).loop((h, i) {
        b = field.index(i);
        out.add((b >= 'a' && b <= 'z').match({ true => b - 32, false => b })).try();
    });
    Ok(out)
}

// A default help can show: a literal number, string or bool, or a variant
// of a choice. Anything else is applied without being shown.
default_text = (be :: CBackend, form: Form, default: Res<ExprId>)
               Res<Res<String>, AllocError> {
    form.match({
        One(w) => default.match({
            Ok(eid) => be.tree.expr_at(eid).kind.match({
                Literal(l) => l.kind.match({
                    Int => w.match({
                        Unsigned(_) => Ok(Ok(be.alloc.String(l.text).try())),
                        Signed(_)   => Ok(Ok(be.alloc.String(l.text).try())),
                        _           => Ok(None),
                    }),
                    Str => w.match({
                        Text     => quoted(be, l.text),
                        Location => quoted(be, l.text),
                        _        => Ok(None),
                    }),
                    _   => Ok(None),
                }),
                Access(a)  => w.match({
                    Choice(_) => Ok(Ok(kebab(be, a.name.text).try())),
                    _         => Ok(None),
                }),
                _          => Ok(None),
            }),
            None    => Ok(None),
        }),
        _      => Ok(None),
    })
}

// A string literal's text, when it has no escapes to undo.
quoted = (be :: CBackend, text: str) Res<Res<String>, AllocError> {
    text.find('\\').match({
        Ok(_) => Ok(None),
        None  => Ok(Ok(be.alloc.String(text.slice(1, text.len - 1)).try())),
    })
}

bool_text = (b: bool) str { b.match({ true => "1", false => "0" }) }

// `signed|min|max` as C literals for an integer type.
limits_into = (be :: CBackend, ty: TyId, out :: String) Res<AllocError> {
    name = be.check.types.at(ty).match({ Prim(p) => p.name, _ => "" });
    out.add(name.match({
        "u8"    => "0|INT64_C(0)|UINT64_C(255)",
        "u16"   => "0|INT64_C(0)|UINT64_C(65535)",
        "u32"   => "0|INT64_C(0)|UINT64_C(4294967295)",
        "u64"   => "0|INT64_C(0)|UINT64_C(18446744073709551615)",
        "usize" => "0|INT64_C(0)|(uint64_t)SIZE_MAX",
        "i8"    => "1|INT64_C(-128)|UINT64_C(127)",
        "i16"   => "1|INT64_C(-32768)|UINT64_C(32767)",
        "i32"   => "1|INT64_C(-2147483648)|UINT64_C(2147483647)",
        _       => "1|(INT64_C(-9223372036854775807) - 1)|UINT64_C(9223372036854775807)",
    }))
}

// `(<C type>){ .zg_tag = <variant> }`, with the payload when there is one.
enum_value = (be :: CBackend, ty: TyId, variant: str, payload: str)
             Res<String, AllocError> {
    path ::= be.alloc.String().try();
    be.enum_path(ty, path).try();
    out ::= be.alloc.String("((").try();
    be.ctype(ty, out).try();
    out.add("){ .zg_tag = ").try();
    out.sym_variant(path.view(), variant).try();
    (!payload.is_empty()).then(() {
        out.add(", .zg_data.").try();
        out.sym_member(variant).try();
        out.fmt(" = {}", payload).try();
    });
    out.add(" })").try();
    Ok(out)
}

res_inner = (be :: CBackend, ty: TyId) TyId {
    be.check.types.at(ty).match({ Res(r) => r.value, _ => ty })
}

// A C string literal. Field and variant names are identifiers, and a
// default shown in help has no escapes, so only `"` and `\` could need
// escaping; the length is the byte count regardless.
lit = (be :: CBackend, text: str, out :: String) Res<AllocError> {
    out.add("(zg_str){ (unsigned char *)\"").try();
    Range(0, text.len).loop((h, i) {
        b = text.index(i);
        (b == '"' || b == '\\').then(() { out.add('\\').try(); });
        out.add(b).try();
    });
    out.fmt("\", {}u }", text.len)
}

ok_of = (be :: CBackend, res: str) Res<String, AllocError> {
    out ::= be.alloc.String("{}.zg_data.", res).try();
    out.sym_member("Ok").try();
    Ok(out)
}

open_absent = (be :: CBackend, res: str) Res<AllocError> {
    ok ::= be.alloc.String().try();
    ok.sym_variant(RES_PATH, "Ok").try();
    be.fmt("if ({}.zg_tag != {}) {{\n", res, ok.view()).try();
    be.indent();
}

open_else = (be :: CBackend) Res<AllocError> {
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
}

close = (be :: CBackend) Res<AllocError> {
    be.dedent();
    be.writeln("}")
}

// `<dst> = <helper>(<args>);`, or the bare call when `dst` is empty. A
// parameter the helper receives by address (`::`, or a wide `:`) gets the
// address of its argument, which is therefore always a place.
invoke = (be :: CBackend, dst: str, name: str, args: Vec<str>) Res<AllocError> {
    be.cli_helper(name).try().match({
        None    => be.report_expr(
            ExprId(index: 0),
            GenFault.Unsupported("std.cli without its derive helpers")
        ),
        Ok(def) => decl_at(be.tree, def.id).match({
            None    => Ok,
            Ok(dcl) => dcl.kind.match({
                Function(f) => be.invoke_fn(dst, def, f, args),
                _           => Ok,
            }),
        }),
    })
}

invoke_fn = (be :: CBackend, dst: str, def: Def, f: Function, args: Vec<str>)
            Res<AllocError> {
    sig  ::= be.alloc.Vec<TyId>();
    inst ::= be.alloc.Inst();
    be.signature_of(def, inst, sig).try();
    call ::= be.alloc.String().try();
    be.call_symbol(def, call).try();
    call.add("(").try();
    unknown = be.check.types.unknown().try();
    args.loop((h, i, arg) {
        (i > 0).then(() { call.add(", ").try(); });
        ty = sig.get(i).value_or(unknown);
        be.passes_address(f, i, ty).try().then(() { call.add("&").try(); });
        call.add(arg).try();
    });
    call.add(")").try();
    dst.is_empty().match({
        true  => be.fmt("(void){};\n", call.view()),
        false => be.set_line(dst, call.view()),
    })
}

cli_helper = (be :: CBackend, name: str) Res<Res<Def>, AllocError> {
    found ::= be.alloc.Vec<Def>();
    be.check.world.exported_named(name, found).try();
    Ok(found.find((d) {
        d.name.eq(name) && be.check.world.module_name(d.id).eq(CLI_MODULE)
    }))
}

helper_ret = (be :: CBackend, name: str) Res<TyId, AllocError> {
    be.cli_helper(name).try().match({
        None  => be.check.types.unknown(),
        Ok(d) => decl_at(be.tree, d.id).match({
            None     => be.check.types.unknown(),
            Ok(decl) => decl.kind.match({
                Function(f) => f.ret.match({
                    None    => be.check.types.prim("()"),
                    Ok(ret) => be.check.type_from_ast(
                        ret,
                        Ctx(d.id.module.to_usize(), TyId(index: 0))
                    ),
                }),
                _           => be.check.types.unknown(),
            }),
        }),
    })
}
