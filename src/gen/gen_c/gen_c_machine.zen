// C floor and lowering for machine-level primitives: the u128 type, wide
// multiplication, add with carry, explicit truncation, std.simd vectors and
// the multi-limb products. The floor is
// emitted only when a reachable program spells one of them.
// The C backend targets 64-bit GCC/Clang, which provide unsigned __int128
// and vector extensions; another toolchain is refused with #error rather
// than silently narrowed or scalarized.

Call, ExprId, ArrayLit, Function = std.ast
AllocError = std.mem
Vec = std.collections
String, str = std.text
Range = std.core
Primitive, unsigned_width, is_capability, vector_bytes = sema.sema_prim
Ctx = sema.sema_check
TyId = sema.sema_ty
vector_lanes, vector_lane = sema.sema_ty
const_int = sema.sema_const
Emit, order = gen.gen_emit
CBackend = gen.gen_c.gen_c_state
comment = gen.gen_c.gen_c_runtime
c_prim = gen.gen_c.gen_c_type
expr = gen.gen_c.gen_c_expr
temp = gen.gen_c.gen_c_flow
recv_arg, arg_value = gen.gen_c.gen_c_arg
write_position = gen.gen_c.gen_c_op
ELEMS = gen.gen_c.gen_c_array

emit_machine* = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    be.uses_machine().match({
        false => Ok(()),
        true  => be.write_machine(out),
    })
}

write_machine = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    comment(out, "machine floor: wide integers and vectors").try();
    out.say("#if defined(__SIZEOF_INT128__)").try();
    out.say("__extension__ typedef unsigned __int128 zg_u128;").try();
    out.say("#else").try();
    out.say(
        "#error \"Zen u128 requires a C compiler with unsigned __int128\""
    ).try();
    out.say("#endif").try();
    out.say("#define ZG_U128_MAX (~(zg_u128)0)").try();
    out.say("#if !defined(__GNUC__)").try();
    out.say(
        "#error \"Zen vectors require GCC or Clang vector extensions\""
    ).try();
    out.say("#endif").try();
    // Vector values may live in arena storage, whose alignment is 16.
    out.say("typedef uint8_t zg_u8x16 __attribute__((vector_size(16)));").try();
    out.say(
        "typedef uint8_t zg_u8x32 __attribute__((vector_size(32), aligned(16)));"
    ).try();
    out.say(
        "typedef uint32_t zg_u32x4 __attribute__((vector_size(16)));"
    ).try();
    out.say(
        "typedef uint32_t zg_u32x8 __attribute__((vector_size(32), aligned(16)));"
    ).try();
    out.say(
        "typedef uint64_t zg_u64x2 __attribute__((vector_size(16)));"
    ).try();
    out.say(
        "typedef uint64_t zg_u64x4 __attribute__((vector_size(32), aligned(16)));"
    ).try();
    // A ctgrind build (-DZEN_CT_GRIND) tells valgrind's memcheck where the
    // program declassifies, as the asm marker tells tools/ct: the value is
    // marked defined, so only undeclared uses of secrets are reported.
    out.say("#if defined(ZEN_CT_GRIND)").try();
    out.say("#include <valgrind/memcheck.h>").try();
    out.say(
        "#define ZG_CT_PUBLIC(x) ((void)VALGRIND_MAKE_MEM_DEFINED(&(x), sizeof(x)))"
    ).try();
    out.say("#else").try();
    out.say("#define ZG_CT_PUBLIC(x) ((void)0)").try();
    out.say("#endif").try();
    // Full products of the low 32 bits of each 64-bit lane: PMULUDQ on x86
    // (matched from the widening form), UMULL on arm64 (spelled directly:
    // the widening form is scalarized when an operand is a splat).
    out.say("#if defined(__aarch64__)").try();
    out.say(
        "#define ZG_MUL_LOW32_2(a, b) ((zg_u64x2)vmull_u32(vmovn_u64((uint64x2_t)(a)), vmovn_u64((uint64x2_t)(b))))"
    ).try();
    out.say(
        "#define ZG_MUL_LOW32_4(a, b) __builtin_shufflevector(ZG_MUL_LOW32_2(__builtin_shufflevector(a, a, 0, 1), __builtin_shufflevector(b, b, 0, 1)), ZG_MUL_LOW32_2(__builtin_shufflevector(a, a, 2, 3), __builtin_shufflevector(b, b, 2, 3)), 0, 1, 2, 3)"
    ).try();
    out.say("#else").try();
    out.say(
        "#define ZG_MUL_LOW32_2(a, b) (__builtin_convertvector(__builtin_shufflevector((zg_u32x4)(a), (zg_u32x4)(a), 0, 2), zg_u64x2) * __builtin_convertvector(__builtin_shufflevector((zg_u32x4)(b), (zg_u32x4)(b), 0, 2), zg_u64x2))"
    ).try();
    out.say(
        "#define ZG_MUL_LOW32_4(a, b) (__builtin_convertvector(__builtin_shufflevector((zg_u32x8)(a), (zg_u32x8)(a), 0, 2, 4, 6), zg_u64x4) * __builtin_convertvector(__builtin_shufflevector((zg_u32x8)(b), (zg_u32x8)(b), 0, 2, 4, 6), zg_u64x4))"
    ).try();
    out.say("#endif").try();
    // Rotation of u32 lanes by 16: a 16-bit lane swap is one REV32 on
    // arm64, while x86 lowers the shift form to one PSHUFB with SSSE3.
    out.say("#if defined(__aarch64__)").try();
    out.say(
        "#define ZG_ROT16_U32X4(v) ((zg_u32x4)__builtin_shufflevector((zg_u16x8)(v), (zg_u16x8)(v), 1, 0, 3, 2, 5, 4, 7, 6))"
    ).try();
    out.say(
        "#define ZG_ROT16_U32X8(v) ((zg_u32x8)__builtin_shufflevector((zg_u16x16)(v), (zg_u16x16)(v), 1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 11, 10, 13, 12, 15, 14))"
    ).try();
    out.say("#else").try();
    out.say("#define ZG_ROT16_U32X4(v) (((v) << 16) | ((v) >> 16))").try();
    out.say("#define ZG_ROT16_U32X8(v) (((v) << 16) | ((v) >> 16))").try();
    out.say("#endif").try();
    // Lowering-internal views for 16-bit lane swaps.
    out.say(
        "typedef uint16_t zg_u16x8 __attribute__((vector_size(16)));"
    ).try();
    out.say(
        "typedef uint16_t zg_u16x16 __attribute__((vector_size(32), aligned(16)));"
    ).try();
    // Clang and GCC 12+ take constant indices; older GCC takes a mask vector.
    out.say("#if defined(__clang__) || __GNUC__ >= 12").try();
    out.say(
        "#define ZG_SHUFFLE(V, a, b, ...) __builtin_shufflevector(a, b, __VA_ARGS__)"
    ).try();
    out.say("#else").try();
    out.say(
        "#define ZG_SHUFFLE(V, a, b, ...) __builtin_shuffle(a, b, (V){__VA_ARGS__})"
    ).try();
    out.say("#endif").try();
    out.line().try();
    write_features(out).try();
    write_carries(out).try();
    be.write_sha(out).try();
    be.write_target_sets(out).try();
    Ok(())
}

// Runtime CPU detection and the instructions capabilities unlock. x86 asks
// the compiler runtime (cpuid, including OS AVX state) and reads CPUID leaf
// 7 for the SHA extensions, which not every compiler's
// __builtin_cpu_supports names; arm64 Linux reads AT_HWCAP and macOS reads
// hw.optional sysctls. NEON is baseline on arm64. A capability cannot be
// obtained on another architecture, so there the instruction helpers are
// unreachable and abort.
write_features = (out :: Emit) Res<(), AllocError> {
    comment(out, "machine floor: CPU features").try();
    out.say("#if defined(__x86_64__) || defined(__i386__)").try();
    out.say("#define ZG_X86 1").try();
    out.say("#include <immintrin.h>").try();
    out.say("#include <cpuid.h>").try();
    out.say("#elif defined(__aarch64__)").try();
    out.say("#include <arm_neon.h>").try();
    out.say("#if defined(__APPLE__)").try();
    out.say("#include <sys/sysctl.h>").try();
    out.say("#elif defined(__linux__)").try();
    out.say("#include <sys/auxv.h>").try();
    out.say("#endif").try();
    out.say("#if defined(__clang__)").try();
    out.say("#define ZG_ARM_CRYPTO __attribute__((target(\"aes\")))").try();
    out.say("#define ZG_ARM_SHA2 __attribute__((target(\"sha2\")))").try();
    out.say(
        "#define ZG_ARM_SHA512 __attribute__((target(\"sha2,sha3\")))"
    ).try();
    out.say("#else").try();
    out.say("#define ZG_ARM_CRYPTO __attribute__((target(\"+crypto\")))").try();
    out.say("#define ZG_ARM_SHA2 __attribute__((target(\"+sha2\")))").try();
    out.say("#define ZG_ARM_SHA512 __attribute__((target(\"+sha3\")))").try();
    out.say("#endif").try();
    out.say("#endif").try();
    out.say("#if defined(ZG_X86)").try();
    out.say(
        "static int zg_cpu_has(int avx2, int ssse3, int aes, int clmul) {"
    ).try();
    out.say("    __builtin_cpu_init();").try();
    out.say("    if (avx2 && !__builtin_cpu_supports(\"avx2\")) return 0;").try();
    out.say(
        "    if ((ssse3 || aes || clmul) && !__builtin_cpu_supports(\"ssse3\")) return 0;"
    ).try();
    out.say(
        "    if ((aes || clmul) && !__builtin_cpu_supports(\"sse4.1\")) return 0;"
    ).try();
    out.say("    if (aes && !__builtin_cpu_supports(\"aes\")) return 0;").try();
    out.say(
        "    if (clmul && !__builtin_cpu_supports(\"pclmul\")) return 0;"
    ).try();
    out.say("    return 1;").try();
    out.say("}").try();
    out.say("#define zg_cpu_probe_avx2() zg_cpu_has(1, 0, 0, 0)").try();
    out.say("#define zg_cpu_probe_ssse3() zg_cpu_has(0, 1, 0, 0)").try();
    out.say(
        "#define zg_cpu_probe_bmi2() (__builtin_cpu_supports(\"bmi\") && __builtin_cpu_supports(\"bmi2\"))"
    ).try();
    out.say("#define zg_cpu_probe_aes() zg_cpu_has(0, 0, 1, 0)").try();
    out.say("#define zg_cpu_probe_clmul() zg_cpu_has(0, 0, 0, 1)").try();
    out.say("#define zg_cpu_probe_neon() 0").try();
    out.say("static int zg_cpu_probe_sha_ni(void) {").try();
    out.say("    unsigned int a, b, c, d;").try();
    out.say("    __builtin_cpu_init();").try();
    out.say(
        "    if (!__builtin_cpu_supports(\"ssse3\") || !__builtin_cpu_supports(\"sse4.1\")) return 0;"
    ).try();
    out.say("    if (!__get_cpuid_count(7, 0, &a, &b, &c, &d)) return 0;").try();
    out.say("    return (b >> 29) & 1;").try();
    out.say("}").try();
    out.say("static int zg_cpu_probe_adx(void) {").try();
    out.say("    unsigned int a, b, c, d;").try();
    out.say("    if (!__get_cpuid_count(7, 0, &a, &b, &c, &d)) return 0;").try();
    out.say("    return (b >> 19) & 1;").try();
    out.say("}").try();
    out.say("#define zg_cpu_probe_arm_sha2() 0").try();
    out.say("#define zg_cpu_probe_arm_sha512() 0").try();
    out.say(
        "static inline __attribute__((target(\"aes,ssse3,sse4.1\"))) zg_u8x16 zg_aes_round(zg_u8x16 s, zg_u8x16 k) {"
    ).try();
    out.say(
        "    return (zg_u8x16)_mm_aesenc_si128((__m128i)s, (__m128i)k);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((target(\"aes,ssse3,sse4.1\"))) zg_u8x16 zg_aes_round_last(zg_u8x16 s, zg_u8x16 k) {"
    ).try();
    out.say(
        "    return (zg_u8x16)_mm_aesenclast_si128((__m128i)s, (__m128i)k);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((target(\"pclmul,ssse3,sse4.1\"))) zg_u64x2 zg_clmul_low(zg_u64x2 a, zg_u64x2 b) {"
    ).try();
    out.say(
        "    return (zg_u64x2)_mm_clmulepi64_si128((__m128i)a, (__m128i)b, 0x00);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((target(\"pclmul,ssse3,sse4.1\"))) zg_u64x2 zg_clmul_high(zg_u64x2 a, zg_u64x2 b) {"
    ).try();
    out.say(
        "    return (zg_u64x2)_mm_clmulepi64_si128((__m128i)a, (__m128i)b, 0x11);"
    ).try();
    out.say("}").try();
    out.say("#elif defined(__aarch64__)").try();
    out.say("#if defined(__APPLE__)").try();
    out.say("static int zg_cpu_sysctl(const char *name) {").try();
    out.say("    int value = 0;").try();
    out.say("    size_t size = sizeof value;").try();
    out.say(
        "    return sysctlbyname(name, &value, &size, NULL, 0) == 0 && value != 0;"
    ).try();
    out.say("}").try();
    out.say(
        "#define zg_cpu_probe_aes() zg_cpu_sysctl(\"hw.optional.arm.FEAT_AES\")"
    ).try();
    out.say(
        "#define zg_cpu_probe_clmul() zg_cpu_sysctl(\"hw.optional.arm.FEAT_PMULL\")"
    ).try();
    out.say(
        "#define zg_cpu_probe_arm_sha2() zg_cpu_sysctl(\"hw.optional.arm.FEAT_SHA256\")"
    ).try();
    out.say(
        "#define zg_cpu_probe_arm_sha512() zg_cpu_sysctl(\"hw.optional.arm.FEAT_SHA512\")"
    ).try();
    out.say("#elif defined(__linux__)").try();
    out.say(
        "#define zg_cpu_probe_aes() ((getauxval(AT_HWCAP) & (1UL << 3)) != 0)"
    ).try();
    out.say(
        "#define zg_cpu_probe_clmul() ((getauxval(AT_HWCAP) & (1UL << 4)) != 0)"
    ).try();
    out.say(
        "#define zg_cpu_probe_arm_sha2() ((getauxval(AT_HWCAP) & (1UL << 6)) != 0)"
    ).try();
    out.say(
        "#define zg_cpu_probe_arm_sha512() ((getauxval(AT_HWCAP) & (1UL << 21)) != 0)"
    ).try();
    out.say("#else").try();
    out.say("#define zg_cpu_probe_aes() 0").try();
    out.say("#define zg_cpu_probe_clmul() 0").try();
    out.say("#define zg_cpu_probe_arm_sha2() 0").try();
    out.say("#define zg_cpu_probe_arm_sha512() 0").try();
    out.say("#endif").try();
    out.say("#define zg_cpu_probe_avx2() 0").try();
    out.say("#define zg_cpu_probe_ssse3() 0").try();
    out.say("#define zg_cpu_probe_bmi2() 0").try();
    out.say("#define zg_cpu_probe_adx() 0").try();
    out.say("#define zg_cpu_probe_neon() 1").try();
    out.say("#define zg_cpu_probe_sha_ni() 0").try();
    out.say(
        "static inline ZG_ARM_CRYPTO zg_u8x16 zg_aes_round(zg_u8x16 s, zg_u8x16 k) {"
    ).try();
    out.say(
        "    return (zg_u8x16)vaesmcq_u8(vaeseq_u8((uint8x16_t)s, vdupq_n_u8(0))) ^ k;"
    ).try();
    out.say("}").try();
    out.say(
        "static inline ZG_ARM_CRYPTO zg_u8x16 zg_aes_round_last(zg_u8x16 s, zg_u8x16 k) {"
    ).try();
    out.say(
        "    return (zg_u8x16)vaeseq_u8((uint8x16_t)s, vdupq_n_u8(0)) ^ k;"
    ).try();
    out.say("}").try();
    out.say(
        "static inline ZG_ARM_CRYPTO zg_u64x2 zg_clmul_low(zg_u64x2 a, zg_u64x2 b) {"
    ).try();
    out.say(
        "    return (zg_u64x2)vmull_p64((poly64_t)a[0], (poly64_t)b[0]);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline ZG_ARM_CRYPTO zg_u64x2 zg_clmul_high(zg_u64x2 a, zg_u64x2 b) {"
    ).try();
    out.say(
        "    return (zg_u64x2)vmull_high_p64((poly64x2_t)a, (poly64x2_t)b);"
    ).try();
    out.say("}").try();
    out.say("#else").try();
    out.say("#define zg_cpu_probe_avx2() 0").try();
    out.say("#define zg_cpu_probe_ssse3() 0").try();
    out.say("#define zg_cpu_probe_bmi2() 0").try();
    out.say("#define zg_cpu_probe_adx() 0").try();
    out.say("#define zg_cpu_probe_aes() 0").try();
    out.say("#define zg_cpu_probe_clmul() 0").try();
    out.say("#define zg_cpu_probe_neon() 0").try();
    out.say("#define zg_cpu_probe_sha_ni() 0").try();
    out.say("#define zg_cpu_probe_arm_sha2() 0").try();
    out.say("#define zg_cpu_probe_arm_sha512() 0").try();
    out.say(
        "static zg_u8x16 zg_aes_round(zg_u8x16 s, zg_u8x16 k) { (void)s; (void)k; abort(); }"
    ).try();
    out.say(
        "static zg_u8x16 zg_aes_round_last(zg_u8x16 s, zg_u8x16 k) { (void)s; (void)k; abort(); }"
    ).try();
    out.say(
        "static zg_u64x2 zg_clmul_low(zg_u64x2 a, zg_u64x2 b) { (void)a; (void)b; abort(); }"
    ).try();
    out.say(
        "static zg_u64x2 zg_clmul_high(zg_u64x2 a, zg_u64x2 b) { (void)a; (void)b; abort(); }"
    ).try();
    out.say("#endif").try();
    // Detection runs once per feature; sysctl and cpuid are not free.
    // ZEN_CPU_DISABLE lists features (avx2, ssse3, bmi2, adx, aes, clmul,
    // neon, sha, sha512, or all) that detection reports absent, as OPENSSL_ia32cap
    // masks OpenSSL's dispatch: every portable path can be exercised on one
    // machine. It can only remove features, never claim one the CPU lacks.
    // `sha` masks the SHA-256 instructions of both architectures.
    out.say(
        "static __attribute__((unused)) int zg_cpu_masked(const char *feature) {"
    ).try();
    out.say("    const char *list = getenv(\"ZEN_CPU_DISABLE\");").try();
    out.say("    size_t n = strlen(feature);").try();
    out.say("    while (list != NULL && *list != 0) {").try();
    out.say("        const char *end = strchr(list, ',');").try();
    out.say(
        "        size_t len = end != NULL ? (size_t)(end - list) : strlen(list);"
    ).try();
    out.say(
        "        if ((len == n && strncmp(list, feature, n) == 0) || (len == 3 && strncmp(list, \"all\", 3) == 0)) return 1;"
    ).try();
    out.say("        list = end != NULL ? end + 1 : NULL;").try();
    out.say("    }").try();
    out.say("    return 0;").try();
    out.say("}").try();
    out.say(
        "#define ZG_CPU_CACHED(name, feature, probe) static __attribute__((unused)) int name(void) { \\"
    ).try();
    out.say(
        "    static int known; int v = __atomic_load_n(&known, __ATOMIC_RELAXED); \\"
    ).try();
    out.say(
        "    if (v == 0) { v = (!zg_cpu_masked(feature) && (probe)) ? 2 : 1; __atomic_store_n(&known, v, __ATOMIC_RELAXED); } \\"
    ).try();
    out.say("    return v == 2; }").try();
    out.say("ZG_CPU_CACHED(zg_cpu_avx2, \"avx2\", zg_cpu_probe_avx2())").try();
    out.say(
        "ZG_CPU_CACHED(zg_cpu_ssse3, \"ssse3\", zg_cpu_probe_ssse3())"
    ).try();
    out.say("ZG_CPU_CACHED(zg_cpu_bmi2, \"bmi2\", zg_cpu_probe_bmi2())").try();
    out.say("ZG_CPU_CACHED(zg_cpu_adx, \"adx\", zg_cpu_probe_adx())").try();
    out.say("ZG_CPU_CACHED(zg_cpu_aes, \"aes\", zg_cpu_probe_aes())").try();
    out.say(
        "ZG_CPU_CACHED(zg_cpu_clmul, \"clmul\", zg_cpu_probe_clmul())"
    ).try();
    out.say("ZG_CPU_CACHED(zg_cpu_neon, \"neon\", zg_cpu_probe_neon())").try();
    out.say(
        "ZG_CPU_CACHED(zg_cpu_sha_ni, \"sha\", zg_cpu_probe_sha_ni())"
    ).try();
    out.say(
        "ZG_CPU_CACHED(zg_cpu_arm_sha2, \"sha\", zg_cpu_probe_arm_sha2())"
    ).try();
    out.say(
        "ZG_CPU_CACHED(zg_cpu_arm_sha512, \"sha512\", zg_cpu_probe_arm_sha512())"
    ).try();
    out.line().try();
    Ok(())
}

// Add with carry and subtract with borrow, and the two-chain multi-limb
// products. The carry helpers use Clang's (and GCC 14's) __builtin_addcll
// family, whose chains Clang keeps in the flags; older GCC uses the x86
// _addcarry_u64 intrinsics, and anything else u128 arithmetic. Only the low
// bit of an incoming carry is read.
//
// The products follow OpenSSL's x25519_fe64_mul and x25519_fe64_sqr
// (crypto/ec/asm/x25519-x86_64.pl, OpenSSL 3.5.4, Apache-2.0): MULX leaves
// the flags alone, so the low halves of the partial products accumulate on
// CF through ADCX while the high halves accumulate on OF through ADOX. No
// branch, and every memory operand is a fixed offset from a factor's
// address. Both flags are clear after each row, so mul_limbs is two asm
// blocks split between the second and third rows: each needs at most
// twelve registers, which leaves room for the frame pointer and for -O0.
// Elsewhere the Adx capability is never detected and the helpers abort.
write_carries = (out :: Emit) Res<(), AllocError> {
    comment(out, "machine floor: carries and multi-limb products").try();
    out.say("#if defined(__has_builtin)").try();
    out.say(
        "#if __has_builtin(__builtin_addcll) && __has_builtin(__builtin_subcll)"
    ).try();
    out.say("#define ZG_ADDC_BUILTIN 1").try();
    out.say("#endif").try();
    out.say("#endif").try();
    out.say(
        "static inline uint64_t zg_add_carry(uint64_t a, uint64_t b, uint64_t c, uint64_t *carry) {"
    ).try();
    out.say("#if defined(ZG_ADDC_BUILTIN)").try();
    out.say("    unsigned long long out;").try();
    out.say("    uint64_t s = __builtin_addcll(a, b, c & 1, &out);").try();
    out.say("    *carry = out;").try();
    out.say("    return s;").try();
    out.say("#elif defined(__x86_64__)").try();
    out.say("    unsigned long long s;").try();
    out.say("    *carry = _addcarry_u64((unsigned char)(c & 1), a, b, &s);").try();
    out.say("    return s;").try();
    out.say("#else").try();
    out.say("    zg_u128 t = (zg_u128)a + b + (c & 1);").try();
    out.say("    *carry = (uint64_t)(t >> 64);").try();
    out.say("    return (uint64_t)t;").try();
    out.say("#endif").try();
    out.say("}").try();
    out.say(
        "static inline uint64_t zg_sub_borrow(uint64_t a, uint64_t b, uint64_t c, uint64_t *borrow) {"
    ).try();
    out.say("#if defined(ZG_ADDC_BUILTIN)").try();
    out.say("    unsigned long long out;").try();
    out.say("    uint64_t s = __builtin_subcll(a, b, c & 1, &out);").try();
    out.say("    *borrow = out;").try();
    out.say("    return s;").try();
    out.say("#elif defined(__x86_64__)").try();
    out.say("    unsigned long long s;").try();
    out.say(
        "    *borrow = _subborrow_u64((unsigned char)(c & 1), a, b, &s);"
    ).try();
    out.say("    return s;").try();
    out.say("#else").try();
    out.say("    zg_u128 t = (zg_u128)a - b - (c & 1);").try();
    out.say("    *borrow = (uint64_t)(t >> 64) & 1;").try();
    out.say("    return (uint64_t)t;").try();
    out.say("#endif").try();
    out.say("}").try();
    out.say("#if defined(__x86_64__)").try();
    out.say(
        "static inline __attribute__((always_inline)) void zg_mul_limbs(const uint64_t *a, const uint64_t *b, uint64_t *r) {"
    ).try();
    out.say("    uint64_t x0, x1, x2, x3, x4, x5, x6, x7, t0, t1, z;").try();
    out.say("    __asm__(").try();
    out.say("        \"movq 0(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"mulx 0(%[b]), %[x0], %[t0]\\n\\t\"").try();
    out.say("        \"xorl %k[z], %k[z]\\n\\t\"").try();
    out.say("        \"mulx 8(%[b]), %[x1], %[t1]\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x1]\\n\\t\"").try();
    out.say("        \"mulx 16(%[b]), %[x2], %[t0]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x2]\\n\\t\"").try();
    out.say("        \"mulx 24(%[b]), %[x3], %[x4]\\n\\t\"").try();
    out.say("        \"movq 8(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x3]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 0(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x1]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x2]\\n\\t\"").try();
    out.say("        \"mulx 8(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x2]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x3]\\n\\t\"").try();
    out.say("        \"mulx 16(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x3]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 24(%[b]), %[t0], %[x5]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x4]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x5]\\n\\t\"").try();
    out.say("        \"adox %[z], %[x5]\\n\\t\"").try();
    out.say(
        "        : [x0] \"=&r\"(x0), [x1] \"=&r\"(x1), [x2] \"=&r\"(x2), [x3] \"=&r\"(x3),"
    ).try();
    out.say(
        "          [x4] \"=&r\"(x4), [x5] \"=&r\"(x5), [t0] \"=&r\"(t0), [t1] \"=&r\"(t1), [z] \"=&r\"(z)"
    ).try();
    out.say("        : [a] \"r\"(a), \"m\"(*(const uint64_t (*)[4])a),").try();
    out.say("          [b] \"r\"(b), \"m\"(*(const uint64_t (*)[4])b)").try();
    out.say("        : \"cc\", \"rdx\");").try();
    out.say("    __asm__(").try();
    out.say("        \"movq 16(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"xorl %k[z], %k[z]\\n\\t\"").try();
    out.say("        \"mulx 0(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x2]\\n\\t\"").try();
    out.say("        \"adox %[t1], %[x3]\\n\\t\"").try();
    out.say("        \"mulx 8(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x3]\\n\\t\"").try();
    out.say("        \"adox %[t1], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 16(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x4]\\n\\t\"").try();
    out.say("        \"adox %[t1], %[x5]\\n\\t\"").try();
    out.say("        \"mulx 24(%[b]), %[t0], %[x6]\\n\\t\"").try();
    out.say("        \"movq 24(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x5]\\n\\t\"").try();
    out.say("        \"adox %[z], %[x6]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x6]\\n\\t\"").try();
    out.say("        \"mulx 0(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x3]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 8(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x4]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x5]\\n\\t\"").try();
    out.say("        \"mulx 16(%[b]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x5]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x6]\\n\\t\"").try();
    out.say("        \"mulx 24(%[b]), %[t0], %[x7]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x6]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x7]\\n\\t\"").try();
    out.say("        \"adox %[z], %[x7]\\n\\t\"").try();
    out.say(
        "        : [x2] \"+&r\"(x2), [x3] \"+&r\"(x3), [x4] \"+&r\"(x4), [x5] \"+&r\"(x5),"
    ).try();
    out.say(
        "          [x6] \"=&r\"(x6), [x7] \"=&r\"(x7), [t0] \"=&r\"(t0), [t1] \"=&r\"(t1), [z] \"=&r\"(z)"
    ).try();
    out.say("        : [a] \"r\"(a), \"m\"(*(const uint64_t (*)[4])a),").try();
    out.say("          [b] \"r\"(b), \"m\"(*(const uint64_t (*)[4])b)").try();
    out.say("        : \"cc\", \"rdx\");").try();
    out.say("    r[0] = x0; r[1] = x1; r[2] = x2; r[3] = x3;").try();
    out.say("    r[4] = x4; r[5] = x5; r[6] = x6; r[7] = x7;").try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((always_inline)) void zg_square_limbs(const uint64_t *a, uint64_t *r) {"
    ).try();
    out.say("    uint64_t x0, x1, x2, x3, x4, x5, x6, x7, t0, t1, z;").try();
    out.say("    __asm__(").try();
    out.say("        \"movq 0(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"mulx %%rdx, %[x0], %[x7]\\n\\t\"").try();
    out.say("        \"mulx 8(%[a]), %[x1], %[t0]\\n\\t\"").try();
    out.say("        \"xorl %k[z], %k[z]\\n\\t\"").try();
    out.say("        \"mulx 16(%[a]), %[x2], %[t1]\\n\\t\"").try();
    out.say("        \"adcx %[t0], %[x2]\\n\\t\"").try();
    out.say("        \"mulx 24(%[a]), %[x3], %[x4]\\n\\t\"").try();
    out.say("        \"movq 8(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x3]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 16(%[a]), %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x3]\\n\\t\"").try();
    out.say("        \"adcx %[t1], %[x4]\\n\\t\"").try();
    out.say("        \"mulx 24(%[a]), %[t0], %[x5]\\n\\t\"").try();
    out.say("        \"movq 16(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x4]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x5]\\n\\t\"").try();
    out.say("        \"mulx 24(%[a]), %[t0], %[x6]\\n\\t\"").try();
    out.say("        \"movq 8(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x5]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x6]\\n\\t\"").try();
    out.say("        \"adox %[z], %[x6]\\n\\t\"").try();
    out.say("        \"adcx %[x1], %[x1]\\n\\t\"").try();
    out.say("        \"adox %[x7], %[x1]\\n\\t\"").try();
    out.say("        \"adcx %[x2], %[x2]\\n\\t\"").try();
    out.say("        \"mulx %%rdx, %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"movq 16(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adcx %[x3], %[x3]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x2]\\n\\t\"").try();
    out.say("        \"adcx %[x4], %[x4]\\n\\t\"").try();
    out.say("        \"adox %[t1], %[x3]\\n\\t\"").try();
    out.say("        \"mulx %%rdx, %[t0], %[t1]\\n\\t\"").try();
    out.say("        \"movq 24(%[a]), %%rdx\\n\\t\"").try();
    out.say("        \"adcx %[x5], %[x5]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x4]\\n\\t\"").try();
    out.say("        \"adcx %[x6], %[x6]\\n\\t\"").try();
    out.say("        \"adox %[t1], %[x5]\\n\\t\"").try();
    out.say("        \"mulx %%rdx, %[t0], %[x7]\\n\\t\"").try();
    out.say("        \"adox %[t0], %[x6]\\n\\t\"").try();
    out.say("        \"adcx %[z], %[x7]\\n\\t\"").try();
    out.say("        \"adox %[z], %[x7]\\n\\t\"").try();
    out.say(
        "        : [x0] \"=&r\"(x0), [x1] \"=&r\"(x1), [x2] \"=&r\"(x2), [x3] \"=&r\"(x3),"
    ).try();
    out.say(
        "          [x4] \"=&r\"(x4), [x5] \"=&r\"(x5), [x6] \"=&r\"(x6), [x7] \"=&r\"(x7),"
    ).try();
    out.say("          [t0] \"=&r\"(t0), [t1] \"=&r\"(t1), [z] \"=&r\"(z)").try();
    out.say("        : [a] \"r\"(a), \"m\"(*(const uint64_t (*)[4])a)").try();
    out.say("        : \"cc\", \"rdx\");").try();
    out.say("    r[0] = x0; r[1] = x1; r[2] = x2; r[3] = x3;").try();
    out.say("    r[4] = x4; r[5] = x5; r[6] = x6; r[7] = x7;").try();
    out.say("}").try();
    out.say("#else").try();
    out.say(
        "static inline void zg_mul_limbs(const uint64_t *a, const uint64_t *b, uint64_t *r) { (void)a; (void)b; (void)r; abort(); }"
    ).try();
    out.say(
        "static inline void zg_square_limbs(const uint64_t *a, uint64_t *r) { (void)a; (void)r; abort(); }"
    ).try();
    out.say("#endif").try();
    out.line().try();
    Ok(())
}

// The SHA instructions. Each architecture implements its own set; the other
// architecture's set is unreachable there, since its capability is never
// detected, and aborts.
write_sha = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    comment(out, "machine floor: SHA instructions").try();
    out.say("#if defined(ZG_X86)").try();
    write_x86_sha(out).try();
    be.sha_stubs(out, false, true).try();
    out.say("#elif defined(__aarch64__)").try();
    be.sha_stubs(out, true, false).try();
    write_arm_sha(out).try();
    out.say("#else").try();
    be.sha_stubs(out, true, true).try();
    out.say("#endif").try();
    out.line().try();
    Ok(())
}

write_x86_sha = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static inline __attribute__((target(\"sha,ssse3,sse4.1\"))) zg_u32x4 zg_sha256_rnds2(zg_u32x4 cdgh, zg_u32x4 abef, zg_u32x4 wk) {"
    ).try();
    out.say(
        "    return (zg_u32x4)_mm_sha256rnds2_epu32((__m128i)cdgh, (__m128i)abef, (__m128i)wk);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((target(\"sha,ssse3,sse4.1\"))) zg_u32x4 zg_sha256_msg1(zg_u32x4 a, zg_u32x4 b) {"
    ).try();
    out.say(
        "    return (zg_u32x4)_mm_sha256msg1_epu32((__m128i)a, (__m128i)b);"
    ).try();
    out.say("}").try();
    out.say(
        "static inline __attribute__((target(\"sha,ssse3,sse4.1\"))) zg_u32x4 zg_sha256_msg2(zg_u32x4 a, zg_u32x4 b) {"
    ).try();
    out.say(
        "    return (zg_u32x4)_mm_sha256msg2_epu32((__m128i)a, (__m128i)b);"
    ).try();
    out.say("}").try();
    Ok(())
}

// ACLE intrinsics in the instruction's operand order: the destination's
// incoming value first.
write_arm_sha = (out :: Emit) Res<(), AllocError> {
    out.say(
        "static inline ZG_ARM_SHA2 zg_u32x4 zg_sha256h(zg_u32x4 a, zg_u32x4 b, zg_u32x4 c) { return (zg_u32x4)vsha256hq_u32((uint32x4_t)a, (uint32x4_t)b, (uint32x4_t)c); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA2 zg_u32x4 zg_sha256h2(zg_u32x4 a, zg_u32x4 b, zg_u32x4 c) { return (zg_u32x4)vsha256h2q_u32((uint32x4_t)a, (uint32x4_t)b, (uint32x4_t)c); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA2 zg_u32x4 zg_sha256su0(zg_u32x4 a, zg_u32x4 b) { return (zg_u32x4)vsha256su0q_u32((uint32x4_t)a, (uint32x4_t)b); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA2 zg_u32x4 zg_sha256su1(zg_u32x4 a, zg_u32x4 b, zg_u32x4 c) { return (zg_u32x4)vsha256su1q_u32((uint32x4_t)a, (uint32x4_t)b, (uint32x4_t)c); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA512 zg_u64x2 zg_sha512h(zg_u64x2 a, zg_u64x2 b, zg_u64x2 c) { return (zg_u64x2)vsha512hq_u64((uint64x2_t)a, (uint64x2_t)b, (uint64x2_t)c); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA512 zg_u64x2 zg_sha512h2(zg_u64x2 a, zg_u64x2 b, zg_u64x2 c) { return (zg_u64x2)vsha512h2q_u64((uint64x2_t)a, (uint64x2_t)b, (uint64x2_t)c); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA512 zg_u64x2 zg_sha512su0(zg_u64x2 a, zg_u64x2 b) { return (zg_u64x2)vsha512su0q_u64((uint64x2_t)a, (uint64x2_t)b); }"
    ).try();
    out.say(
        "static inline ZG_ARM_SHA512 zg_u64x2 zg_sha512su1(zg_u64x2 a, zg_u64x2 b, zg_u64x2 c) { return (zg_u64x2)vsha512su1q_u64((uint64x2_t)a, (uint64x2_t)b, (uint64x2_t)c); }"
    ).try();
    Ok(())
}

// Aborting definitions of the x86 set, the arm64 set, or both.
sha_stubs = (be :: CBackend, out :: Emit, x86: bool, arm: bool)
            Res<(), AllocError> {
    x86.then(() {
        be.sha_stub(out, "sha256_rnds2", "u32x4", 3).try();
        be.sha_stub(out, "sha256_msg1", "u32x4", 2).try();
        be.sha_stub(out, "sha256_msg2", "u32x4", 2).try();
    });
    arm.then(() {
        be.sha_stub(out, "sha256h", "u32x4", 3).try();
        be.sha_stub(out, "sha256h2", "u32x4", 3).try();
        be.sha_stub(out, "sha256su0", "u32x4", 2).try();
        be.sha_stub(out, "sha256su1", "u32x4", 3).try();
        be.sha_stub(out, "sha512h", "u64x2", 3).try();
        be.sha_stub(out, "sha512h2", "u64x2", 3).try();
        be.sha_stub(out, "sha512su0", "u64x2", 2).try();
        be.sha_stub(out, "sha512su1", "u64x2", 3).try();
    });
    Ok(())
}

sha_stub = (be :: CBackend, out :: Emit, name: str, v: str, arity: usize)
           Res<(), AllocError> {
    line ::= be.alloc.String().try();
    (arity == 3).match({
        true  => line.fmt(
            "static zg_{} zg_{}(zg_{} a, zg_{} b, zg_{} c) { (void)a; (void)b; (void)c; abort(); }",
            v,
            name,
            v,
            v,
            v
        ),
        false => line.fmt(
            "static zg_{} zg_{}(zg_{} a, zg_{} b) { (void)a; (void)b; abort(); }",
            v,
            name,
            v,
            v
        ),
    }).try();
    out.say(line.view())
}

// One attribute macro per feature set a function asks for. Clang honours a
// single target attribute, so each set is spelled as one combined list.
write_target_sets = (be :: CBackend, out :: Emit) Res<(), AllocError> {
    seq = order(be.alloc, be.target_sets).try();
    seq.loop((h, i) {
        be.target_sets.get(i).match({
            None    => Ok(()),
            Ok(set) => be.write_target_set(out, set.view()),
        }).try();
    });
    out.line().try();
    Ok(())
}

write_target_set = (be :: CBackend, out :: Emit, set: str)
                   Res<(), AllocError> {
    x86 ::= be.alloc.String().try();
    x86.add_feature(set, "_AVX2", "avx2").try();
    x86.add_feature(set, "_SSSE3", "ssse3").try();
    x86.add_feature(set, "_BMI2", "bmi,bmi2").try();
    x86.add_feature(set, "_ADX", "adx").try();
    x86.add_feature(set, "_AES", "aes,ssse3,sse4.1").try();
    x86.add_feature(set, "_CLMUL", "pclmul,ssse3,sse4.1").try();
    x86.add_feature(set, "_SHANI", "sha,ssse3,sse4.1").try();
    // arm64 feature names differ between Clang and GCC.
    clang ::= be.alloc.String().try();
    gcc   ::= be.alloc.String().try();
    crypto = set.contains("_AES") || set.contains("_CLMUL");
    crypto.then(() {
        clang.add("aes").try();
        gcc.add("+crypto").try();
    });
    set.contains("_ARMSHA2").then(() {
        clang.add(
            (clang.len() > 0).match({ true => ",sha2", false => "sha2" })
        ).try();
        gcc.add("+sha2").try();
    });
    set.contains("_ARMSHA512").then(() {
        clang.add(
            (clang.len() > 0).match({ true => ",sha2,sha3", false => "sha2,sha3" })
        ).try();
        gcc.add("+sha3").try();
    });
    line ::= be.alloc.String().try();
    out.say("#if defined(ZG_X86)").try();
    (x86.len() > 0).match({
        true  => line.fmt(
            "#define ZG_TARGET{} __attribute__((target(\"{}\")))",
            set,
            x86.view()
        ),
        false => line.fmt("#define ZG_TARGET{}", set),
    }).try();
    out.say(line.view()).try();
    out.say("#elif defined(__aarch64__) && defined(__clang__)").try();
    line.clear();
    (clang.len() > 0).match({
        true  => line.fmt(
            "#define ZG_TARGET{} __attribute__((target(\"{}\")))",
            set,
            clang.view()
        ),
        false => line.fmt("#define ZG_TARGET{}", set),
    }).try();
    out.say(line.view()).try();
    out.say("#elif defined(__aarch64__)").try();
    line.clear();
    (gcc.len() > 0).match({
        true  => line.fmt(
            "#define ZG_TARGET{} __attribute__((target(\"{}\")))",
            set,
            gcc.view()
        ),
        false => line.fmt("#define ZG_TARGET{}", set),
    }).try();
    out.say(line.view()).try();
    out.say("#else").try();
    line.clear();
    line.fmt("#define ZG_TARGET{}", set).try();
    out.say(line.view()).try();
    out.say("#endif").try();
    Ok(())
}

add_feature = (list :: String, set: str, token: str, features: str)
              Res<(), AllocError> {
    set.contains(token).match({
        false => Ok(()),
        true  => {
            (list.len() > 0).then(() { list.add(",").try() });
            list.add(features)
        },
    })
}

// One lowered call: the site's arguments in parameter order, receiver first.
PrimSite = {
    c: Call,
    recv: Res<ExprId>,
    p: Primitive,
    ctx: Ctx,

    value_at = (self: @Self, i: usize) Res<ExprId> {
        shift: usize = self.recv.match({ Ok(_) => 1, None => 0 });
        (i < shift).match({
            true  => recv_arg(self.c, self.recv),
            false => arg_value(self.c, i - shift),
        })
    }
}

// Evaluate every operand once, receiver first, into a temporary of its
// declared type; then render the operation over those names. A shuffle
// pattern written as literal indices is read at compile time instead.
lower_primitive* = (
    be   :: CBackend,
    c    : Call,
    recv : Res<ExprId>,
    p    : Primitive,
    ctx  : Ctx,
    out  :: String
) Res<(), AllocError> {
    be.need_machine();
    site = PrimSite(c: c, recv: recv, p: p, ctx: ctx);
    held    ::= be.alloc.Vec<String>();
    literal ::= false;
    Range(0, p.params.len).loop((i) {
        ty    = p.params.get(i).ok_or(AllocError.OutOfMemory).try();
        value = site.value_at(i).ok_or(AllocError.OutOfMemory).try();
        code ::= be.alloc.String().try();
        fixed   = be.literal_pattern(site, i, value, code).try();
        literal = literal || fixed;
        fixed.match({
            true  => held.add(code).try(),
            false => {
                be.expr(value, site.ctx, ty, code).try();
                name = be.temp(ty, "prim").try();
                be.set_line(name.view(), code.view()).try();
                held.add(name).try();
            },
        });
    });
    be.render_primitive(site, held, literal, out)
}

// The last argument of a shuffle, when every index is an integer literal,
// becomes the comma-separated constant list; indices are reduced modulo the
// selectable lane count exactly as the dynamic path reduces them.
literal_pattern = (
    be    :: CBackend,
    site  : PrimSite,
    i     : usize,
    value : ExprId,
    code  :: String
) Res<bool, AllocError> {
    shuffling = site.p.name.eq("shuffle") || site.p.name.eq("shuffle2");
    (shuffling && i + 1 == site.p.params.len).match({
        false => Ok(false),
        true  => be.tree.expr_at(value).kind.match({
            Array(a) => be.constant_indices(a, site.p, code),
            _        => Ok(false),
        }),
    })
}

constant_indices = (be :: CBackend, a: ArrayLit, p: Primitive, code :: String)
                   Res<bool, AllocError> {
    lanes = vector_lanes(be.check.prim_name(p.result));
    mask  = p.name.eq(
        "shuffle2"
    ).match({ true => 2 * lanes - 1, false => lanes - 1 });
    ok ::= a.elems.len == lanes;
    a.elems.loop((e) {
        be.check.const_int(e).match({
            None    => { ok = false; },
            Ok(raw) => (raw >= 0).match({
                false => { ok = false; },
                true  => {
                    (code.len() > 0).then(() { code.add(", ").try() });
                    code.write_usize(raw.to_usize().match({ Ok(n) => n, None => 0 }).bit_and(
                        mask
                    )).try();
                },
            }),
        });
    });
    Ok(ok)
}

render_primitive = (
    be      :: CBackend,
    site    : PrimSite,
    held    : Vec<String>,
    literal : bool,
    out     :: String
) Res<(), AllocError> {
    site.p.name.match({
        "compiler_barrier"   => {
            // An empty asm with a memory clobber: no memory access moves
            // across it and no preceding store is treated as dead.
            be.writeln("__asm__ __volatile__(\"\" ::: \"memory\");").try();
            out.add("((void)0)")
        },
        "value_barrier"      => be.value_barrier(
            site,
            operand(held, 0),
            "",
            out
        ),
        "declassify_barrier" => be.value_barrier(
            site,
            operand(held, 0),
            "/* zen:declassify",
            out
        ),
        _                    => be.render_feature(site, held, literal, out),
    })
}

render_feature = (
    be      :: CBackend,
    site    : PrimSite,
    held    : Vec<String>,
    literal : bool,
    out     :: String
) Res<(), AllocError> {
    name = site.p.name;
    a    = operand(held, 0);
    b    = operand(held, 1);
    name.starts_with("cpu_").match({
        true  => out.fmt("(zg_{}() != 0)", name),
        false => instruction_operands(name).match({
            2 => out.fmt("zg_{}({}, {})", name, a, b),
            3 => out.fmt("zg_{}({}, {}, {})", name, a, b, operand(held, 2)),
            _ => name.starts_with("cast_").match({
                true  => out.fmt(
                    "((zg_{}){})",
                    be.check.prim_name(site.p.result),
                    a
                ),
                false => be.render_scalar(site, held, literal, out),
            }),
        }),
    })
}

// BoringSSL's value_barrier_w: an empty asm that claims to rewrite its
// register operand. The value is unchanged, but the optimizer can no longer
// prove anything about it (that it is 0 or 1, or came from a comparison), so
// masks built from it are not folded back into branches or conditional
// moves chosen by value. The operand is already a fresh temporary. A u128 is
// passed as its two 64-bit halves, since a 128-bit "r" operand is not
// accepted on every target. A declassification writes `/* zen:declassify
// <register>... */` as the asm text: still no instruction, but the assembly
// names the register whose value the program made public.
value_barrier = (
    be     :: CBackend,
    site   : PrimSite,
    held   : str,
    marker : str,
    out    :: String
) Res<(), AllocError> {
    wide     = be.check.prim_name(site.p.result).eq("u128");
    template = marker.is_empty().match({
        true  => "",
        false => wide.match({ true => " %0 %1 */", false => " %0 */" }),
    });
    // ZG_CT_PUBLIC lives in the machine floor.
    be.need_machine();
    wide.match({
        false => be.fmt(
            "__asm__(\"{}{}\" : \"+r\"({}));\n",
            marker,
            template,
            held
        ).try(),
        true  => be.fmt(
            "{ uint64_t zg_lo = (uint64_t){}, zg_hi = (uint64_t)({} >> 64); __asm__(\"{}{}\" : \"+r\"(zg_lo), \"+r\"(zg_hi)); {} = ((zg_u128)zg_hi << 64) | zg_lo; }\n",
            held,
            held,
            marker,
            template,
            held
        ).try(),
    });
    (!marker.is_empty()).then(
        () { be.fmt("ZG_CT_PUBLIC({});\n", held).try(); }
    );
    out.add(held)
}

// Vector operands of a capability-gated instruction, which lowers to the
// floor helper of the same name (the capability is not passed); 0 for any
// other primitive.
instruction_operands = (name: str) usize {
    name.is_in([
        "aes_round", "aes_round_last", "clmul_low", "clmul_high", "sha256_msg1",
        "sha256_msg2", "sha256su0", "sha512su0"
    ]).match({
        true  => 2,
        false => name.is_in([
            "sha256_rnds2", "sha256h", "sha256h2", "sha256su1", "sha512h",
            "sha512h2", "sha512su1"
        ]).match({ true => 3, false => 0 }),
    })
}

render_scalar = (
    be      :: CBackend,
    site    : PrimSite,
    held    : Vec<String>,
    literal : bool,
    out     :: String
) Res<(), AllocError> {
    p = site.p;
    a = operand(held, 0);
    b = operand(held, 1);
    p.name.match({
        "add_carry"    => be.carry_pair(site, held, "zg_add_carry", out),
        "sub_borrow"   => be.carry_pair(site, held, "zg_sub_borrow", out),
        "mul_limbs"    => be.limb_product(site, held, true, out),
        "square_limbs" => be.limb_product(site, held, false, out),
        _              => be.render_wide(site, held, literal, out),
    })
}

// [sum, carry]: the floor helper returns the word and stores the carry.
carry_pair = (
    be     :: CBackend,
    site   : PrimSite,
    held   : Vec<String>,
    helper : str,
    out    :: String
) Res<(), AllocError> {
    pair = be.temp(site.p.result, "carry").try();
    be.fmt(
        "{}.{}[0] = {}({}, {}, {}, &{}.{}[1]);\n",
        pair.view(),
        ELEMS,
        helper,
        operand(held, 0),
        operand(held, 1),
        operand(held, 2),
        pair.view(),
        ELEMS
    ).try();
    out.add(pair.view())
}

// The eight product limbs, written by the floor's two-chain sequence. The
// capability operands carry no data.
limb_product = (
    be   :: CBackend,
    site : PrimSite,
    held : Vec<String>,
    two  : bool,
    out  :: String
) Res<(), AllocError> {
    limbs = be.temp(site.p.result, "limbs").try();
    two.match({
        true  => be.fmt(
            "zg_mul_limbs({}.{}, {}.{}, {}.{});\n",
            operand(held, 0),
            ELEMS,
            operand(held, 1),
            ELEMS,
            limbs.view(),
            ELEMS
        ),
        false => be.fmt(
            "zg_square_limbs({}.{}, {}.{});\n",
            operand(held, 0),
            ELEMS,
            limbs.view(),
            ELEMS
        ),
    }).try();
    out.add(limbs.view())
}

render_wide = (
    be      :: CBackend,
    site    : PrimSite,
    held    : Vec<String>,
    literal : bool,
    out     :: String
) Res<(), AllocError> {
    p = site.p;
    a = operand(held, 0);
    p.name.eq("mul_wide").match({
        true  => out.fmt("((zg_u128){} * (zg_u128){})", a, operand(held, 1)),
        false => p.name.starts_with("truncate_").match({
            true  => out.fmt(
                "(({}){})",
                c_prim(be.check.prim_name(p.result)),
                a
            ),
            false => be.render_vector(site, held, literal, out),
        }),
    })
}

operand = (held: Vec<String>, i: usize) str {
    held.get(i).match({ Ok(s) => s.view(), None => "" })
}

render_vector = (
    be      :: CBackend,
    site    : PrimSite,
    held    : Vec<String>,
    literal : bool,
    out     :: String
) Res<(), AllocError> {
    p = site.p;
    v = be.check.prim_name(p.result);
    a = operand(held, 0);
    b = operand(held, 1);
    p.name.match({
        "add_wrap"     => out.fmt("({} + {})", a, b),
        "sub_wrap"     => out.fmt("({} - {})", a, b),
        "mul_wrap"     => out.fmt("({} * {})", a, b),
        "mul_low32"    => out.fmt(
            "ZG_MUL_LOW32_{}({}, {})",
            vector_lanes(v),
            a,
            b
        ),
        "bit_xor"      => out.fmt("({} ^ {})", a, b),
        "bit_and"      => out.fmt("({} & {})", a, b),
        "bit_or"       => out.fmt("({} | {})", a, b),
        "shift_left"   => be.vector_shift(v, a, b, "<<", out),
        "shift_right"  => be.vector_shift(v, a, b, ">>", out),
        "rotate_left"  => be.rotate_or_swap(site, v, a, b, "<<", ">>", out),
        "rotate_right" => be.rotate_or_swap(site, v, a, b, ">>", "<<", out),
        "store"        => out.fmt(
            "((void)memcpy({} + {}, &{}, sizeof {}))",
            b,
            operand(held, 2),
            a,
            a
        ),
        "lane"         => be.vector_lane_read(site, a, b, out),
        "with_lane"    => be.vector_lane_write(site, held, out),
        "shuffle"      => be.vector_shuffle(v, a, a, b, literal, false, out),
        "shuffle2"     => be.vector_shuffle(
            v,
            a,
            b,
            operand(held, 2),
            literal,
            true,
            out
        ),
        _              => be.vector_constructor(site, held, out),
    })
}

// A count at or beyond the lane width yields zero; C's vector shift by such
// a count is undefined, so the guard selects the zero vector instead.
vector_shift = (be :: CBackend, v: str, a: str, n: str, op: str, out :: String)
               Res<(), AllocError> {
    lane  = vector_lane(v);
    width = unsigned_width(lane);
    out.fmt(
        "({} >= {}u ? (zg_{}){0} : ({} {} ({}){}))",
        n,
        width,
        v,
        a,
        op,
        c_prim(lane),
        n
    )
}

// A constant rotation of u32 lanes by 16 swaps their 16-bit halves; the
// floor's ZG_ROT16 picks the best spelling per architecture.
rotate_or_swap = (
    be   :: CBackend,
    site : PrimSite,
    v    : str,
    a    : str,
    n    : str,
    near : str,
    far  : str,
    out  :: String
) Res<(), AllocError> {
    count  = site.value_at(1).match({
        Ok(e) => be.check.const_int(e),
        None  => None,
    });
    halves = vector_lane(v).eq("u32") && count.match({
        Ok(k) => k == 16,
        None  => false,
    });
    halves.match({
        false => be.vector_rotate(v, a, n, near, far, out),
        true  => out.fmt("ZG_ROT16_U32X{}({})", vector_lanes(v), a),
    })
}

vector_rotate = (
    be   :: CBackend,
    v    : str,
    a    : str,
    n    : str,
    near : str,
    far  : str,
    out  :: String
) Res<(), AllocError> {
    lane  = vector_lane(v);
    width = unsigned_width(lane);
    ct    = c_prim(lane);
    out.fmt(
        "(({} {} ({})({} & {}u)) | ({} {} ({})(({}u - ({} & {}u)) & {}u)))",
        a,
        near,
        ct,
        n,
        width - 1,
        a,
        far,
        ct,
        width,
        n,
        width - 1,
        width - 1
    )
}

// Lane access traps at the index argument, like fixed-array indexing.
lane_index = (
    be    :: CBackend,
    site  : PrimSite,
    index : str,
    lanes : usize,
    out   :: String
) Res<(), AllocError> {
    at   = site.value_at(1).ok_or(AllocError.OutOfMemory).try();
    span = be.tree.expr_at(at).span;
    pos ::= be.alloc.String().try();
    be.write_position(span.file, span, pos).try();
    out.fmt("zg_idx_u({}, {}, {})", index, lanes, pos.view())
}

vector_lane_read = (
    be    :: CBackend,
    site  : PrimSite,
    a     : str,
    index : str,
    out   :: String
) Res<(), AllocError> {
    lanes = vector_lanes(be.check.prim_name(site.p.params.get(0).match({
        Ok(t) => t,
        None  => site.p.result,
    })));
    idx ::= be.alloc.String().try();
    be.lane_index(site, index, lanes, idx).try();
    out.fmt("{}[{}]", a, idx.view())
}

vector_lane_write = (
    be   :: CBackend,
    site : PrimSite,
    held : Vec<String>,
    out  :: String
) Res<(), AllocError> {
    v     = be.check.prim_name(site.p.result);
    lanes = vector_lanes(v);
    copy  = be.temp(site.p.result, "lanes").try();
    be.set_line(copy.view(), operand(held, 0)).try();
    idx ::= be.alloc.String().try();
    be.lane_index(site, operand(held, 1), lanes, idx).try();
    be.fmt("{}[{}] = {};\n", copy.view(), idx.view(), operand(held, 2)).try();
    out.add(copy.view())
}

// `pattern` is either the literal index list or a held fixed array.
vector_shuffle = (
    be      :: CBackend,
    v       : str,
    a       : str,
    b       : str,
    pattern : str,
    literal : bool,
    two     : bool,
    out     :: String
) Res<(), AllocError> {
    literal.match({
        true  => out.fmt("ZG_SHUFFLE(zg_{}, {}, {}, {})", v, a, b, pattern),
        false => {
            lanes = vector_lanes(v);
            out.fmt("((zg_{}){", v).try();
            Range(0, lanes).loop((i) {
                (i > 0).then(() { out.add(", ").try() });
                two.match({
                    true  => out.fmt(
                        "(({}.{}[{}] & {}u) < {}u ? {}[{}.{}[{}] & {}u] : {}[{}.{}[{}] & {}u])",
                        pattern,
                        ELEMS,
                        i,
                        2 * lanes - 1,
                        lanes,
                        a,
                        pattern,
                        ELEMS,
                        i,
                        lanes - 1,
                        b,
                        pattern,
                        ELEMS,
                        i,
                        lanes - 1
                    ),
                    false => out.fmt(
                        "{}[{}.{}[{}] & {}u]",
                        a,
                        pattern,
                        ELEMS,
                        i,
                        lanes - 1
                    ),
                }).try();
            });
            out.add("})")
        },
    })
}

// splat_V, lanes_V and load_V construct the result vector.
vector_constructor = (
    be   :: CBackend,
    site : PrimSite,
    held : Vec<String>,
    out  :: String
) Res<(), AllocError> {
    v     = be.check.prim_name(site.p.result);
    lanes = vector_lanes(v);
    site.p.name.starts_with("load_").match({
        true  => {
            loaded = be.temp(site.p.result, "load").try();
            be.fmt(
                "memcpy(&{}, {} + {}, sizeof {});\n",
                loaded.view(),
                operand(held, 0),
                operand(held, 1),
                loaded.view()
            ).try();
            out.add(loaded.view())
        },
        false => {
            splat = site.p.name.starts_with("splat_");
            out.fmt("((zg_{}){", v).try();
            Range(0, lanes).loop((i) {
                (i > 0).then(() { out.add(", ").try() });
                out.add(operand(
                    held,
                    splat.match({ true => 0, false => i })
                )).try();
            });
            out.add("})")
        },
    })
}

// Attributes between linkage and return type, on prototype and definition
// alike. `inline` functions are always inlined within one translation unit;
// split output gives functions external linkage and calls cross files, so
// there the request is dropped rather than turned into a C error.
//
// A parameter of a capability type compiles the function for that feature
// (`ZG_TARGET_AVX2` and friends).
function_attributes* = (
    be  :: CBackend,
    f   : Function,
    sig : Vec<TyId>,
    ret : TyId,
    out :: String
) Res<(), AllocError> {
    set ::= be.alloc.String().try();
    be.add_capability(sig, "Adx", "_ADX", set).try();
    be.add_capability(sig, "Aes", "_AES", set).try();
    be.add_capability(sig, "ArmSha2", "_ARMSHA2", set).try();
    be.add_capability(sig, "ArmSha512", "_ARMSHA512", set).try();
    be.add_capability(sig, "Avx2", "_AVX2", set).try();
    be.add_capability(sig, "Bmi2", "_BMI2", set).try();
    be.add_capability(sig, "Clmul", "_CLMUL", set).try();
    be.add_capability(sig, "Neon", "_NEON", set).try();
    be.add_capability(sig, "ShaNi", "_SHANI", set).try();
    be.add_capability(sig, "Ssse3", "_SSSE3", set).try();
    be.set_lowering_avx2(set.view().contains("_AVX2"));
    (set.len() > 0).then(() {
        be.need_target(set.view()).try();
        out.fmt("ZG_TARGET{} ", set.view()).try();
    });
    (f.inline && be.linkage().eq("static ")).then(() {
        out.add("ZG_INLINE ").try();
    });
    Ok(())
}

// A call exchanging a 32-byte vector must not cross between AVX2 and
// baseline code: x86 passes it in a YMM register only when AVX is enabled,
// which is a Clang error and a silent GCC miscompile. Both sides must hold
// the Avx2 capability, or neither.
avx2_boundary* = (be :: CBackend, sig: Vec<TyId>, result: TyId) bool {
    wide ::= be.wide_vector(result);
    avx  ::= false;
    sig.loop((t) {
        wide = wide || be.wide_vector(t);
        avx  = avx || be.capability(t).eq("Avx2");
    });
    wide && avx != be.lowering_avx2
}

add_capability = (
    be   :: CBackend,
    sig  : Vec<TyId>,
    name : str,
    tag  : str,
    set  :: String
) Res<(), AllocError> {
    found ::= false;
    sig.loop((t) { found = found || be.capability(t).eq(name); });
    found.match({ true => set.add(tag), false => Ok(()) })
}

capability = (be :: CBackend, t: TyId) str {
    be.check.types.at(t).match({
        Named(n) => (be.check.world.module_name(n.decl).eq("std.simd")
            && is_capability(n.name)).match({ true => n.name, false => "" }),
        _        => "",
    })
}

wide_vector = (be :: CBackend, t: TyId) bool {
    vector_bytes(be.check.prim_name(t)) == 32
}
