// Render sema-validated numeric operations. Widening preserves every value;
// checked conversion evaluates its operand once and returns None on overflow.
{ ExprId } = std.ast
{ AllocError } = std.mem
{ String, str } = std.text
{ NumericConversion, NarrowTarget, IntegerBitOperation } = sema.sema_numeric
{ Ctx } = sema.sema_check
{ CBackend } = gen.gen_c.gen_c_state
{ expr } = gen.gen_c.gen_c_expr
{ c_prim, request_type } = gen.gen_c.gen_c_type
{ temp, write_assign_none, write_assign_ok } = gen.gen_c.gen_c_flow

lower_numeric* = (
    be        :: CBackend,
    value     : ExprId,
    operation : NumericConversion,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    target = be.check.prim_name(operation.target);
    operation.kind.match({
        Widen          => {
            out.fmt("({})(", c_prim(target)).try();
            be.expr(value, ctx, operation.source, out).try();
            out.add(")")
        },
        Checked(range) => be.checked_numeric(value, operation, range, ctx, out),
    })
}

checked_numeric = (
    be        :: CBackend,
    value     : ExprId,
    operation : NumericConversion,
    range     : NarrowTarget,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    be.request_type(operation.result).try();
    code ::= be.alloc.String().try();
    be.expr(value, ctx, operation.source, code).try();
    held = be.temp(operation.source, "n").try();
    be.set_line(held.view(), code.view()).try();
    dst    = be.temp(operation.result, "t").try();
    target = be.check.prim_name(operation.target);
    source = be.check.prim_name(operation.source);
    be.write("if (").try();
    be.numeric_fits(held.view(), source, range).try();
    be.writeln(") {").try();
    be.indent();
    cast ::= be.alloc.String().try();
    cast.fmt("({}){}", c_prim(target), held.view()).try();
    be.write_assign_ok(operation.result, cast.view(), dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.write_assign_none(operation.result, dst.view()).try();
    be.dedent();
    be.writeln("}").try();
    out.add(dst.view())
}

numeric_fits = (be :: CBackend, value: str, source: str, target: NarrowTarget)
               Res<(), AllocError> {
    signed  = source.is_in(["i64", "i32", "c_int"]);
    minimum = target.match({ I32 => "INT32_MIN", CInt => "INT_MIN", U8 => "0", U16 => "0", Usize => "0" });
    maximum = target.match({
        U8 => "UINT8_MAX", U16 => "UINT16_MAX", Usize => "SIZE_MAX",
        I32 => "INT32_MAX", CInt => "INT_MAX",
    });
    signed.match({
        true  => be.fmt(
            "(intmax_t){} >= {} && (intmax_t){} <= {}",
            value,
            minimum,
            value,
            maximum
        ),
        false => be.fmt("(uintmax_t){} <= (uintmax_t){}", value, maximum),
    })
}

// Hold both inputs in source order: rotation references each more than once.
// Mask both shift counts so zero and width multiples never shift by the word width.
lower_integer_bits* = (
    be        :: CBackend,
    left      : ExprId,
    right     : ExprId,
    operation : IntegerBitOperation,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    lt           = operation.word;
    word         = be.check.prim_name(lt);
    width: usize = word.eq("u32").match({true => 32, false => 64});
    rt           = be.check.types.prim(
        operation.name.is_in([
            "bit_xor", "bit_and"
        ]).match({true => word, false => "usize"})
    ).try();
    lc ::= be.alloc.String().try();
    be.expr(left, ctx, lt, lc).try();
    lv = be.temp(lt, "bits").try();
    be.set_line(lv.view(), lc.view()).try();
    rc ::= be.alloc.String().try();
    be.expr(right, ctx, rt, rc).try();
    rv = be.temp(rt, "bits").try();
    be.set_line(rv.view(), rc.view()).try();
    operation.name.match({
        "bit_xor"     => out.fmt("({} ^ {})", lv.view(), rv.view()),
        "bit_and"     => out.fmt("({} & {})", lv.view(), rv.view()),
        // A logical shift by the width or more yields zero. Guard the C shift.
        "shift_right" => out.fmt(
            "({} >= {}u ? 0 : ({} >> {}))",
            rv.view(),
            width,
            lv.view(),
            rv.view()
        ),
        _             => out.fmt(
            "(({} >> ({} & {}u)) | ({} << (({}u - ({} & {}u)) & {}u)))",
            lv.view(),
            rv.view(),
            width - 1,
            lv.view(),
            width,
            rv.view(),
            width - 1,
            width - 1
        ),
    })
}
