// Render sema-validated numeric operations. Widening preserves every value;
// checked conversion evaluates its operand once and returns None on overflow;
// exact integer/float conversion returns None unless the value survives;
// rounding conversion always produces the nearest representable value.
ExprId = std.ast
AllocError = std.mem
String, str = std.text
NumericConversion, NarrowTarget, ConversionKind, signed_shift_word = sema.sema_numeric
IntegerBitOperation = sema.sema_numeric
Ctx = sema.sema_check
CBackend = gen.gen_c.gen_c_state
expr = gen.gen_c.gen_c_expr
c_prim = gen.gen_c.gen_c_type
temp, write_assign_none, write_assign_ok = gen.gen_c.gen_c_flow
lower_bits = gen.gen_c.gen_c_op
unsigned_width = sema.sema_prim

lower_numeric* = (
    be        :: CBackend,
    value     : ExprId,
    operation : NumericConversion,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    target = be.check.prim_name(operation.target);
    operation.kind.match({
        Widen      => {
            out.fmt("({})(", c_prim(target)).try();
            be.expr(value, ctx, operation.source, out).try();
            out.add(")")
        },
        Checked(_) => be.checked_numeric(value, operation, ctx, out),
        Exact      => be.checked_numeric(value, operation, ctx, out),
        Round      => be.rounded_numeric(value, operation, ctx, out),
    })
}

checked_numeric = (
    be        :: CBackend,
    value     : ExprId,
    operation : NumericConversion,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    be.request_type(operation.result).try();
    code ::= be.alloc.String().try();
    be.expr(value, ctx, operation.source, code).try();
    held = be.temp(operation.source, "n").try();
    be.set_line(held.view(), code.view()).try();
    dst    = be.temp(operation.result, "t").try();
    target = be.check.prim_name(operation.target);
    source = be.check.prim_name(operation.source);
    be.write("if (").try();
    operation.kind.match({
        Checked(range) => be.numeric_fits(held.view(), source, range),
        _              => be.exact_fits(held.view(), source, target),
    }).try();
    be.writeln(") {").try();
    be.indent();
    cast ::= be.alloc.String().try();
    cast.fmt("({}){}", c_prim(target), held.view()).try();
    be.write_assign_ok(operation.result, cast.view(), dst.view()).try();
    be.dedent();
    be.writeln("} else {").try();
    be.indent();
    be.write_assign_none(operation.result, dst.view()).try();
    be.dedent();
    be.writeln("}").try();
    out.add(dst.view())
}

numeric_fits = (be :: CBackend, value: str, source: str, target: NarrowTarget)
               Res<(), AllocError> {
    signed  = source.is_in(["i64", "i32", "c_int"]);
    minimum = target.match({ I32 => "INT32_MIN", CInt => "INT_MIN", U8 => "0", U16 => "0", U64 => "0", Usize => "0" });
    maximum = target.match({
        U8 => "UINT8_MAX", U16 => "UINT16_MAX", U64 => "UINT64_MAX",
        Usize => "SIZE_MAX", I32 => "INT32_MAX", CInt => "INT_MAX",
    });
    // uintmax_t is narrower than u128, so a u128 compares in its own type.
    signed.match({
        true  => be.fmt(
            "(intmax_t){} >= {} && (intmax_t){} <= {}",
            value,
            minimum,
            value,
            maximum
        ),
        false => source.eq("u128").match({
            true  => be.fmt("{} <= (zg_u128){}", value, maximum),
            false => be.fmt("(uintmax_t){} <= (uintmax_t){}", value, maximum),
        }),
    })
}

// Whether an integer/float conversion is exact. Every cast below runs only
// after the range test has passed, so no C conversion leaves its defined
// range: a NaN fails every comparison, and the round trip then rejects a
// fractional f64 or an integer that has no f64 of its own.
exact_fits = (be :: CBackend, value: str, source: str, target: str)
             Res<(), AllocError> {
    source.match({
        "f64" => target.eq("i32").match({
            true  => be.fmt(
                "{} >= -2147483648.0 && {} <= 2147483647.0 && (double)(int32_t){} == {}",
                value,
                value,
                value,
                value
            ),
            false => be.fmt(
                "{} >= -0x1p63 && {} < 0x1p63 && (double)(int64_t){} == {}",
                value,
                value,
                value,
                value
            ),
        }),
        "u64" => be.fmt(
            "(double){} < 0x1p64 && (uint64_t)(double){} == {}",
            value,
            value,
            value
        ),
        _     => be.fmt(
            "(double){} < 0x1p63 && (int64_t)(double){} == {}",
            value,
            value,
            value
        ),
    })
}

// `narrow_f32` and `narrow_f64`. An integer always lies inside the f64
// range, so its cast is defined and rounds to nearest. An f64 is compared
// first because C leaves converting an out-of-range double to float
// undefined: at or beyond FLT_MAX plus half an ulp (0x1.ffffffp127) IEEE
// rounding gives infinity, spelled from its bit pattern because C99 has no
// infinity constant outside <math.h>; between FLT_MAX and that bound it
// gives FLT_MAX. What remains (in range, or NaN) converts with the cast.
rounded_numeric = (
    be        :: CBackend,
    value     : ExprId,
    operation : NumericConversion,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    target = be.check.prim_name(operation.target);
    code ::= be.alloc.String().try();
    be.expr(value, ctx, operation.source, code).try();
    target.eq("f32").match({
        false => out.fmt("({})({})", c_prim(target), code.view()),
        true  => {
            held = be.temp(operation.source, "n").try();
            be.set_line(held.view(), code.view()).try();
            dst = be.temp(operation.result, "t").try();
            n   = held.view();
            t   = dst.view();
            be.fmt(
                "if ({} >= 0x1.ffffffp127 || {} <= -0x1.ffffffp127) {{\n",
                n,
                n
            ).try();
            be.indent();
            be.fmt(
                "uint32_t {}_bits = {} > 0 ? 0x7f800000u : 0xff800000u;\n",
                t,
                n
            ).try();
            be.fmt("memcpy(&{}, &{}_bits, sizeof {});\n", t, t, t).try();
            be.dedent();
            be.fmt("}} else if ({} > 0x1.fffffep127) {{\n", n).try();
            be.indent();
            be.fmt("{} = 0x1.fffffep127f;\n", t).try();
            be.dedent();
            be.fmt("}} else if ({} < -0x1.fffffep127) {{\n", n).try();
            be.indent();
            be.fmt("{} = -0x1.fffffep127f;\n", t).try();
            be.dedent();
            be.writeln("} else {").try();
            be.indent();
            be.fmt("{} = (float){};\n", t, n).try();
            be.dedent();
            be.writeln("}").try();
            out.add(t)
        },
    })
}

// A named bit operation, and every bit operator, lowers through `lower_bits`,
// which holds both inputs in source order: rotation references each more than
// once.
lower_integer_bits* = (
    be        :: CBackend,
    left      : ExprId,
    right     : ExprId,
    operation : IntegerBitOperation,
    ctx       : Ctx,
    out       :: String
) Res<(), AllocError> {
    word  = be.check.prim_name(operation.word);
    count = be.check.types.prim(
        operation.name.starts_with(
            "bit_"
        ).match({true => word, false => "usize"})
    ).try();
    be.lower_bits(left, right, operation.name, operation.word, count, ctx, out)
}

// The C for one bit operation over held operands `l` and `r`. Rotation counts
// are masked so zero and width multiples never shift by the word width;
// shifts are guarded, since a count at or above the width yields zero. The
// result is cast back because C promotes u8 and u16 operands to int.
write_bits* = (name: str, word: str, l: str, r: str, out :: String)
              Res<(), AllocError> {
    ct    = c_prim(word);
    width = word_width(word);
    mask  = width - 1;
    name.match({
        "bit_xor"     => out.fmt("(({})({} ^ {}))", ct, l, r),
        "bit_and"     => out.fmt("(({})({} & {}))", ct, l, r),
        "bit_or"      => out.fmt("(({})({} | {}))", ct, l, r),
        "shift_right" => signed_shift_word(word).match({
            true  => arithmetic_shift(l, r, word, width, out),
            // A logical shift by the width or more yields zero. Guard the C shift.
            false => out.fmt(
                "({} >= {}u ? ({})0 : ({})({} >> {}))",
                r,
                width,
                ct,
                ct,
                l,
                r
            ),
        }),
        "shift_left"  => out.fmt(
            "({} >= {}u ? ({})0 : ({})({} << {}))",
            r,
            width,
            ct,
            ct,
            l,
            r
        ),
        "rotate_left" => out.fmt(
            "(({})(({} << ({} & {}u)) | ({} >> (({}u - ({} & {}u)) & {}u))))",
            ct,
            l,
            r,
            mask,
            l,
            width,
            r,
            mask,
            mask
        ),
        _             => out.fmt(
            "(({})(({} >> ({} & {}u)) | ({} << (({}u - ({} & {}u)) & {}u))))",
            ct,
            l,
            r,
            mask,
            l,
            width,
            r,
            mask,
            mask
        ),
    })
}

// Bit width of an integer word, signed (signed shift_right) or unsigned.
word_width = (word: str) usize {
    word.match({
        "i8"  => 8,
        "i16" => 16,
        "i32" => 32,
        "i64" => 64,
        _     => (unsigned_width(word) == 0).match({ true => 64, false => unsigned_width(word) }),
    })
}

// C leaves `>>` of a negative value implementation-defined, so a negative
// input shifts its complement, which is non-negative, and complements back.
// Clamping the count to width - 1 gives the sign fill for larger counts.
arithmetic_shift = (
    value : str,
    count : str,
    word  : str,
    width : usize,
    out   :: String
) Res<(), AllocError> {
    ct  = c_prim(word);
    top = width - 1;
    out.fmt(
        "({} < 0 ? ({})~(~{} >> ({} >= {}u ? {}u : {})) : ({})({} >> ({} >= {}u ? {}u : {})))",
        value,
        ct,
        value,
        count,
        top,
        top,
        count,
        ct,
        value,
        count,
        top,
        top,
        count
    )
}
