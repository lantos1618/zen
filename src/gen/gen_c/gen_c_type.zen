// C spelling and worklist ownership for Zen types. `gen_c_layout` emits each
// queued definition once. Structural `Res` and union types are queued like
// named types and use the same tag-and-payload representation.

Decl, Struct, Enum, Variant, Member = std.ast
COpaque, CTypeBinding = std.ast
Function, TypeId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
TyId, TyNamed, TyRes, Types, c_integer, is_failure, is_vector = sema.sema_ty
DeclId = sema.sema_id
Def, decl_at = sema.sema_def
Ctx = sema.sema_check
type_from_ast = sema.sema_denote
union_reading = sema.sema_union
sym_type, sym_variant, RES_PATH = gen.gen_name
CBackend = gen.gen_c.gen_c_state
GenFault = gen.gen_diag
Inst = sema.sema_inst
sub_with, enter_struct_tparams, leave_tparams = gen.gen_c.gen_c_mono
intern_named = gen.gen_c.gen_c_mono
request_slots = gen.gen_c.gen_c_fat

// spelling

// The C spelling of a type, written into `out`. Requests the type as a
// side effect, because anything spelled is something that needs a
// definition.
// Ordinary types are checked by `spellable` at their use site. Native
// records also validate their explicit header contract here. Invalid
// types fall back to `int` so C remains parseable around the diagnostic.
ctype* = (be :: CBackend, id: TyId, out :: String) Res<(), AllocError> {
    be.types().at(id).match({
        Prim(p)  => {
            machine_prim(p.name).then(() { be.need_machine() });
            out.add(c_prim(p.name))
        },
        Named(n) => be.maybe_ptr(id, n, out),
        Res(_)   => be.named_ctype(id, out),
        Union(_) => be.named_ctype(id, out),
        Array(_) => be.named_ctype(id, out),
        _        => out.add("int"),
    }).try();
    Ok(());
}

// The zero value used for a compiler-synthesised argument or field.
write_zero* = (be :: CBackend, t: TyId, out :: String) Res<(), AllocError> {
    be.check.types.at(t).match({
        Prim(p) => is_vector(p.name).match({
            true  => be.write_zero_struct(t, out),
            false => out.add("0"),
        }),
        _       => be.write_zero_struct(t, out),
    })
}

write_zero_struct = (be :: CBackend, t: TyId, out :: String)
                    Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(t, cty).try();
    out.fmt("({}){0}", cty.view())
}

write_none* = (be :: CBackend, t: TyId, out :: String)
              Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(t, cty).try();
    tag ::= be.alloc.String().try();
    tag.sym_variant(RES_PATH, "None").try();
    out.fmt("({}){ .zg_tag = {} }", cty.view(), tag.view())
}

// A `Ptr<T>` is a `T *` and not a struct. `mem_ptr.zen` says the whole
// of it — "a Ptr<T> is one machine word, the address of a run of T" —
// and its `addr` field is unexported precisely because nothing outside
// std.mem may see the representation. Emitting the declaration's struct
// instead would make `str`'s own `data` field a struct where the runtime
// floor has a pointer, and the two spellings of `str` would disagree.
// This is where the asterisk goes, and it is the one place: `declarator`
// writes the spelling, a space and the name, which is `uint8_t *p` — a
// legal C declarator with the `*` bound to the name.
maybe_ptr = (be :: CBackend, id: TyId, n: TyNamed, out :: String)
            Res<(), AllocError> {
    is_ptr_named(be.types(), n).match({
        true  => be.ptr_ctype(n, out),
        false => be.maybe_scope(id, n, out),
    })
}

// A `Scope` is a `zg_scope *` and not a struct, for exactly the reason
// a `Ptr<T>` is a `T *`: `@scope` is the enclosing block, and a value
// naming a block is the address of that block's record. Emitting the
// declaration's struct instead would give `Scope` a `defer` field —
// storage for a member that has no body and never will, since
// `gen_c_scope.zen` is its body.
maybe_scope = (be :: CBackend, id: TyId, n: TyNamed, out :: String)
              Res<(), AllocError> {
    is_scope_named(be.types(), n).match({
        true  => out.add("zg_scope *"),
        false => be.maybe_named_ctype(id, n, out),
    })
}

// A header-owned opaque only has a C representation behind `Ptr<T>`.
// If an unsupported by-value use reaches here after its diagnostic, keep
// the surrounding C parseable without inventing a struct definition.
maybe_named_ctype = (be :: CBackend, id: TyId, n: TyNamed, out :: String)
                    Res<(), AllocError> {
    be.native_record_decl(n).match({
        Ok(s) => be.write_native_record(n, s, out),
        None  => be.foreign_binding(n).match({
            Ok(_) => out.add("int"),
            None  => be.named_ctype(id, out),
        }),
    })
}

// Header-owned records use the platform compiler's layout and field spelling.
native_record_decl = (be: CBackend, n: TyNamed) Res<Struct> {
    be.struct_decl(n.decl).match({
        Ok(s) => s.native_record.match({ true => Ok(s), false => None }),
        None  => None,
    })
}

is_native_record* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Named(n) => be.native_record_decl(
            n
        ).match({ Ok(_) => true, None => false }),
        _        => false,
    })
}

native_record_spelling = (name: str) bool {
    name.is_identifier() || (name.starts_with("struct ")
        && name.slice(7, name.len).is_identifier())
}

write_native_record = (be :: CBackend, n: TyNamed, s: Struct, out :: String)
                      Res<(), AllocError> {
    spelling = s.native_symbol.value_or("");
    header   = s.native_header.value_or("");
    valid ::= native_record_spelling(spelling) && s.tparams.len == 0;
    (!be.need_c_header(header, true).try()).then(() { valid = false; });
    ctx  = be.decl_ctx(n);
    inst = be.decl_inst(n).try();
    s.members.loop((h, m) {
        field_ok = be.field_type(m, ctx, inst).match({
            Ok(t) => be.native_record_field(t),
            None  => false,
        });
        (!field_ok).then(() { valid = false; });
    });
    valid.match({
        true  => {
            be.native_record_contract(s, ctx, inst, spelling).try();
            out.add(spelling)
        },
        false => {
            be.report(
                s.name.span.file,
                s.name.span,
                GenFault.Unspellable(
                    "invalid native record: expected a safe header type and scalar or pointer fields"
                )
            ).try();
            out.add("int")
        },
    })
}

// A wrong scalar annotation can turn a field borrow into an oversized write.
// Ask the target compiler to prove exact scalar type compatibility before any
// generated Zen function may take that address. Pointer pointee contracts stay
// explicit FFI responsibilities; walking them here would recurse on self links.
native_record_contract = (
    be       :: CBackend,
    s        : Struct,
    ctx      : Ctx,
    inst     : Inst,
    spelling : str
) Res<(), AllocError> {
    be.need_c_header("stdint.h", true).try();
    be.need_c_header("stddef.h", true).try();
    be.need_c_header("stdbool.h", true).try();
    s.members.loop((h, m) {
        be.field_type(m, ctx, inst).match({
            Ok(t) => be.types().at(t).match({
                Prim(p) => be.native_scalar_contract(
                    spelling,
                    m.name().text,
                    c_prim(p.name)
                ),
                _       => Ok(()),
            }),
            None  => Ok(()),
        }).try();
    });
    Ok(())
}

native_scalar_contract = (
    be       :: CBackend,
    spelling : str,
    field    : str,
    scalar   : str
) Res<(), AllocError> {
    line ::= be.alloc.String().try();
    line.fmt(
        "extern char zg_native_scalar_field_type_mismatch[__builtin_types_compatible_p(__typeof__((({} *)0)->{}), {}) ? 1 : -1];",
        spelling,
        field,
        scalar
    ).try();
    be.c_headers.find((item) { item.view().eq(line.view()) }).match({
        Ok(_) => Ok(()),
        None  => be.c_headers.add(line),
    })
}

native_record_field = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Prim(p)  => c_prim_known(p.name) && !p.name.eq("str") && !p.name.eq("()"),
        Named(n) => is_ptr_named(be.types(), n),
        _        => false,
    })
}

foreign_binding = (be: CBackend, n: TyNamed) Res<COpaque> {
    be.tree.c_type_at(n.decl.module, n.decl.decl).match({
        Ok(binding) => binding.match({ Opaque(raw) => Ok(raw) }),
        None        => None,
    })
}

// The prelude's `Ptr`, by declaration: a module's own `Ptr` is an ordinary
// struct.
is_ptr_named* = (types: Types, n: TyNamed) bool { types.is_ptr(n) }

// Beside `is_ptr_named` because it is the same question: the two named
// types the runtime floor represents its own way, not their declaration's.
is_scope_named* = (types: Types, n: TyNamed) bool { types.is_scope(n) }

// The element named by Ptr<T>. Pointer representation is owned here, so
// lowerings do not need to reopen TyNamed independently.
pointee* = (be :: CBackend, id: TyId) Res<TyId> {
    be.types().at(id).match({
        Named(n) => n.args.get(0),
        _        => None,
    })
}

// The success type carried by Res<T, ...>, when this is a Res type.
res_value* = (be :: CBackend, id: TyId) Res<TyId> {
    be.types().at(id).match({
        Res(r) => Ok(r.value),
        _      => None,
    })
}

is_res* = (be :: CBackend, id: TyId) bool {
    be.types().at(id).match({ Res(_) => true, _ => false })
}

ptr_ctype = (be :: CBackend, n: TyNamed, out :: String)
            Res<(), AllocError> {
    n.args.get(0).match({
        Ok(t) => be.elem_ctype(t, out),
        None  => out.add("void *"),
    })
}

elem_ctype = (be :: CBackend, t: TyId, out :: String) Res<(), AllocError> {
    be.types().at(t).match({
        Named(n) => be.foreign_binding(n).match({
            Ok(raw) => write_opaque_ptr(raw, out),
            None    => be.write_elem_ctype(t, out),
        }),
        _        => be.write_elem_ctype(t, out),
    })
}

write_opaque_ptr = (raw: COpaque, out :: String)
                   Res<(), AllocError> {
    raw.spelling.is_identifier().match({
        true  => out.add(raw.spelling),
        false => out.add("int"),
    }).try();
    out.add(" *")
}

write_elem_ctype = (be :: CBackend, t: TyId, out :: String)
                   Res<(), AllocError> {
    be.request_type(t).try();
    be.ctype(t, out).try();
    out.add(" *")
}

named_ctype = (be :: CBackend, id: TyId, out :: String) Res<(), AllocError> {
    be.request_type(id).try();
    sym_type(out, be.alloc, be.types(), be.world(), id)
}

// A declarator: the spelling, a space, the name. A pointer type's
// asterisk is part of the spelling `ctype` writes — see `maybe_ptr`.
declarator* = (be :: CBackend, id: TyId, name: str, out :: String)
              Res<(), AllocError> {
    cty ::= be.alloc.String().try();
    be.ctype(id, cty).try();
    out.fmt("{} {name}", cty.view())
}

// A `_` binding is still declared so its initializer runs; the cast says
// the value is dropped on purpose.
void_discard* = (be :: CBackend, name: str, cname: str) Res<(), AllocError> {
    name.eq("_").match({
        true  => be.fmt("(void){cname};\n"),
        false => Ok(()),
    })
}

// Whether the type can be spelled at all, asked wherever a diagnostic
// has a position to point at.
spellable* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Prim(p)  => c_prim_known(p.name),
        Named(n) => be.named_spellable(n),
        Res(_)   => true,
        Union(_) => true,
        Array(_) => true,
        _        => false,
    })
}

named_spellable = (be: CBackend, n: TyNamed) bool {
    is_ptr_named(be.types(), n).match({
        true  => n.args.get(0).match({
            Ok(t) => be.pointer_element_spellable(t),
            None  => true,
        }),
        false => be.foreign_binding(n).match({ Ok(_) => false, None => true }),
    })
}

pointer_element_spellable = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Named(n) => be.foreign_binding(n).match({
            Ok(raw) => raw.spelling.is_identifier(),
            None    => be.spellable(id),
        }),
        _        => be.spellable(id),
    })
}

// Whether a resolved type occupies a C declaration, argument or field seat.
has_storage* = (be: CBackend, id: TyId) bool { be.is_unit(id) == false }

// A type with no bytes. `()` is `void` only in a return position.
is_unit* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Prim(p) => p.name.eq("()"),
        _       => false,
    })
}

// The C scalar behind a Zen primitive.
// `int` and `float` are sema's literal types — "an integer literal is
// its own type until a context settles it". Reaching here means nothing
// settled it, which is legal (`x = 5;` with no written type), so the
// widest of the family is the honest answer and the same one every
// time.
c_prim* = (name: str) str {
    name.match({
        "i8"          => "int8_t",
        "i16"         => "int16_t",
        "i32"         => "int32_t",
        "i64"         => "int64_t",
        "int"         => "int64_t",
        "u8"          => "uint8_t",
        "u16"         => "uint16_t",
        "u32"         => "uint32_t",
        "u64"         => "uint64_t",
        "u128"        => "zg_u128",
        "u8x16"       => "zg_u8x16",
        "u8x32"       => "zg_u8x32",
        "u32x4"       => "zg_u32x4",
        "u32x8"       => "zg_u32x8",
        "u64x2"       => "zg_u64x2",
        "u64x4"       => "zg_u64x4",
        "usize"       => "size_t",
        "c_char"      => "char",
        "c_schar"     => "signed char",
        "c_uchar"     => "unsigned char",
        "c_short"     => "short",
        "c_ushort"    => "unsigned short",
        "c_int"       => "int",
        "c_uint"      => "unsigned int",
        "c_long"      => "long",
        "c_ulong"     => "unsigned long",
        "c_longlong"  => "long long",
        "c_ulonglong" => "unsigned long long",
        "f32"         => "float",
        "f64"         => "double",
        "float"       => "double",
        "bool"        => "bool",
        "str"         => "zg_str",
        "()"          => "void",
        _             => "int",
    })
}

// Types spelled by the machine floor's typedefs rather than a C header.
machine_prim* = (name: str) bool {
    name.eq("u128") || is_vector(name)
}

// `int` is the spelling an unspellable type falls back to, so it
// cannot double as the answer for a Zen type that really is `int`.
// The list is asked directly.
c_prim_known* = (name: str) bool {
    is_c_integer(name)
        || c_integer(name)
        || is_vector(name)
        || name.is_in(["c_char", "f32", "f64", "float", "bool", "str", "()"])
}

// The integer types a trapping operation can be emitted for.
is_c_integer* = (name: str) bool {
    name.is_in([
        "i8", "i16", "i32", "i64", "int", "u8", "u16", "u32", "u64", "u128",
        "usize"
    ])
}

is_signed* = (name: str) bool {
    name.is_in(["i8", "i16", "i32", "i64", "int"])
}

// the worklist

// Register a type for definition, keyed by the mangled name that is
// its identity (see the header).
request_type* = (be :: CBackend, id: TyId) Res<(), AllocError> {
    ptr_element(be, id).match({
        Ok(et) => be.request_type(et),
        None   => be.request_defined(id),
    })
}

// Runtime scopes and header-owned native types already have definitions.
// Queueing them would synthesize a competing Zen storage layout.
request_defined = (be :: CBackend, id: TyId) Res<(), AllocError> {
    (be.is_scope_type(id) || be.is_foreign_opaque(id) || be.is_native_record(id)).match({
        true  => Ok(()),
        false => be.queue_definition(id),
    })
}

is_foreign_opaque* = (be: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Named(n) => be.foreign_binding(
            n
        ).match({ Ok(_) => true, None => false }),
        _        => false,
    })
}

is_scope_type* = (be :: CBackend, id: TyId) bool {
    be.types().at(id).match({
        Named(n) => is_scope_named(be.types(), n),
        _        => false,
    })
}

// A `Ptr<T>` needs no definition of its own — it is spelled `T *`
// wherever it appears — but the run it points at does, and a `T *`
// member still needs `T`'s typedef above it. So a request for the
// pointer is a request for the element, and the worklist's fixpoint
// reaches through it the way it reaches through a field.
ptr_element = (be :: CBackend, id: TyId) Res<TyId> {
    be.types().at(id).match({
        Named(n) => named_element(be.types(), n),
        _        => None,
    })
}

named_element = (types: Types, n: TyNamed) Res<TyId> {
    is_ptr_named(types, n).match({
        false => None,
        true  => n.args.get(0),
    })
}

queue_definition = (be :: CBackend, id: TyId) Res<(), AllocError> {
    name ::= be.alloc.String().try();
    sym_type(name, be.alloc, be.types(), be.world(), id).try();
    be.type_index(name.view()).match({
        None  => be.queue_type(name, id),
        Ok(_) => Ok(()),
    })
}

close_types* = (be :: CBackend) Res<(), AllocError> {
    cursor ::= 0;
    loop(cursor < be.type_queue.len, (h) {
        be.request_children(cursor).try();
        cursor = cursor + 1;
    });
    Ok(());
}

request_children = (be :: CBackend, i: usize) Res<(), AllocError> {
    be.type_id_at(i).match({
        None   => Ok(()),
        Ok(id) => be.request_members(id),
    }).try();
    Ok(());
}

request_members = (be :: CBackend, id: TyId) Res<(), AllocError> {
    be.types().at(id).match({
        Named(n) => be.request_named_members(n, id),
        Res(r)   => be.request_res_members(r),
        Union(u) => be.request_union_members(u.members),
        Array(a) => be.request_if_composite(a.elem),
        _        => Ok(()),
    }).try();
    Ok(());
}

request_union_members = (be :: CBackend, members: Vec<TyId>)
                        Res<(), AllocError> {
    members.loop((h, m) { be.request_if_composite(m).try() });
    Ok(());
}

// A bound's slots need definitions too, and they are requested here
// rather than ordered in `gen_c_layout.by_value_deps`: a slot is a
// function pointer, so nothing in a record is by-value containment.
// Feeding them to the dependency walk would record `Eq -> Eq` and
// report a cycle that is not there.
request_named_members = (be :: CBackend, n: TyNamed, id: TyId)
                        Res<(), AllocError> {
    be.request_decl_members(n).try();
    be.request_slots(id).try();
    Ok(());
}

request_res_members = (be :: CBackend, r: TyRes) Res<(), AllocError> {
    be.request_if_composite(r.value).try();
    is_failure(r.form).then(() { be.request_if_composite(r.error).try() });
    Ok(());
}

request_if_composite = (be :: CBackend, id: TyId) Res<(), AllocError> {
    be.is_unit(id).match({
        true  => Ok(()),
        false => be.request_if_named(id),
    })
}

request_if_named = (be :: CBackend, id: TyId) Res<(), AllocError> {
    be.types().at(id).match({
        Named(_) => be.request_type(id),
        Res(_)   => be.request_type(id),
        Union(_) => be.request_type(id),
        Array(_) => be.request_type(id),
        _        => Ok(()),
    })
}

request_decl_members = (be :: CBackend, n: TyNamed) Res<(), AllocError> {
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => be.request_from_decl(n, d),
    }).try();
    Ok(());
}

// A declaration's member types are read at the type's own arguments.
// `Vec<u8>`'s `data` is a `Ptr<u8>` and not a `Ptr<T>`, so its parameters
// go back in scope for the read and its arguments are substituted into
// the answer — the same two steps every other reader of a generic
// declaration takes, and `decl_inst` is the second one.
request_from_decl = (be :: CBackend, n: TyNamed, d: Decl)
                    Res<(), AllocError> {
    ctx  = be.decl_ctx(n);
    inst = be.decl_inst(n).try();
    mark = be.enter_struct_tparams(n.decl).try();
    d.kind.match({
        Struct(s) => be.request_fields(s.members, ctx, inst),
        Enum(e)   => be.request_variants(n, e.variants, ctx, inst),
        _         => Ok(()),
    }).try();
    be.leave_tparams(mark).try();
    Ok(());
}

// What a type's own arguments bound its declaration's parameters to.
decl_inst* = (be :: CBackend, n: TyNamed) Res<Inst, AllocError> {
    be.check.inst_of_named(n)
}

request_fields = (
    be      :: CBackend,
    members : Vec<Member>,
    ctx     : Ctx,
    inst    : Inst
) Res<(), AllocError> {
    members.loop((h, m) {
        be.field_type(m, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => be.request_if_composite(t),
        }).try();
    });
    Ok(());
}

request_variants = (
    be       :: CBackend,
    n        : TyNamed,
    variants : Vec<Variant>,
    ctx      : Ctx,
    inst     : Inst
) Res<(), AllocError> {
    variants.loop((h, v) {
        variant_type(be, n, v, ctx, inst).match({
            None  => Ok(()),
            Ok(t) => be.request_if_composite(t),
        }).try();
    });
    Ok(());
}

// The struct a declaration is, when it is one — the DeclId→Decl→Struct
// unwrap every member search starts with.
struct_decl* = (be: CBackend, decl: DeclId) Res<Struct> {
    decl_at(be.tree, decl).match({
        None  => None,
        Ok(d) => d.kind.match({ Struct(s) => Ok(s), _ => None }),
    })
}

// The context a declaration's own member types are read in: its module,
// and no `@Self` — a member type naming `@Self` by value would be a
// type of infinite size, and one behind a `Ptr` is out of this subset.
decl_ctx* = (be :: CBackend, n: TyNamed) Ctx {
    Ctx(
        module: n.decl.module.to_usize(),
        ret: TyId(index: 0),
        has_ret: false,
        self_ty: TyId(index: 0),
        has_self: false
    )
}

// The return type as written, and `()` when nothing was written — a
// function that declares no return type returns unit, it does not
// return "unknown". Eight lowerings each re-read `f.ret` this way and
// then substituted their own instantiation over the answer; the reading
// is one rule and the substituting is theirs.
declared_ret* = (be :: CBackend, f: Function, ctx: Ctx)
                Res<TyId, AllocError> {
    f.ret.match({
        Ok(t) => be.check.type_from_ast(t, ctx),
        None  => be.check.types.prim("()"),
    })
}

// A struct member's storage type, or nothing when the member is not
// storage. A method is a function and a struct-body constant is one
// value per type; neither takes a field.
field_type* = (be :: CBackend, m: Member, ctx: Ctx, inst: Inst)
              Res<TyId> {
    m.kind.match({
        Field(fld) => fld.type.match({
            None  => None,
            Ok(t) => be.resolved(t, ctx, inst),
        }),
        _          => None,
    })
}

// A variant's payload type. Nominal enums carry only an explicitly written
// payload; error unions carry the type named by each variant.
variant_type* = (
    be   :: CBackend,
    n    : TyNamed,
    v    : Variant,
    ctx  : Ctx,
    inst : Inst
) Res<TyId> {
    v.payload.match({
        Ok(t) => be.resolved(t, ctx, inst),
        None  => be.union_member_type(n, v),
    })
}

// The union reading belongs to the whole declaration. `A | B` carries values
// only when every variant names a type; otherwise the whole declaration is
// nominal. Deciding per variant would let a coincidental visible type name
// silently change one tag's layout.
union_member_type = (be :: CBackend, n: TyNamed, v: Variant) Res<TyId> {
    union_reading(be.check, n.decl).match({
        false => None,
        true  => bare_variant_type(be, n, v),
    })
}

bare_variant_type = (be :: CBackend, n: TyNamed, v: Variant) Res<TyId> {
    found ::= be.alloc.Vec<Def>();
    be.world().defs_of(n.decl.module.to_usize(), v.name.text, found).match({
        Err(_) => None,
        Ok(_)  => be.named_of(found),
    })
}

named_of = (be :: CBackend, found: Vec<Def>) Res<TyId> {
    found.get(0).match({
        None  => None,
        Ok(d) => be.interned_named(d),
    })
}

interned_named = (be :: CBackend, d: Def) Res<TyId> {
    empty ::= be.alloc.Vec<TyId>();
    intern_named(be.check, d, empty).match({
        Err(_) => None,
        Ok(id) => Ok(id),
    })
}

resolved = (be :: CBackend, t: TypeId, ctx: Ctx, inst: Inst) Res<TyId> {
    be.check.type_from_ast(t, ctx).match({
        Err(_) => None,
        Ok(id) => be.substituted(id, inst),
    })
}

substituted = (be :: CBackend, id: TyId, inst: Inst) Res<TyId> {
    be.sub_with(id, inst).match({
        Err(_) => None,
        Ok(t)  => Ok(t),
    })
}

// The declared type of a storage field, read at the named type's own
// arguments. This is a type query, independent of expression lowering.
field_of* = (be :: CBackend, ty: TyId, name: str)
            Res<Res<TyId>, AllocError> {
    be.check.types.at(ty).match({
        Named(n) => be.named_field_of(n, name),
        _        => Ok(None),
    })
}

named_field_of = (be :: CBackend, n: TyNamed, name: str)
                 Res<Res<TyId>, AllocError> {
    inst = be.decl_inst(n).try();
    ctx  = be.decl_ctx(n);
    mark = be.enter_struct_tparams(n.decl).try();
    found ::= be.alloc.Vec<TyId>();
    decl_at(be.tree, n.decl).match({
        None  => Ok(()),
        Ok(d) => be.collect_field(d, name, ctx, inst, found),
    }).try();
    be.leave_tparams(mark).try();
    Ok(found.get(0));
}

collect_field = (
    be   :: CBackend,
    d    : Decl,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    d.kind.match({
        Struct(s) => be.keep_fields(s, name, ctx, inst, out),
        _         => Ok(()),
    })
}

keep_fields = (
    be   :: CBackend,
    s    : Struct,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    s.members.loop((h, m) {
        be.keep_named_field(m, name, ctx, inst, out).try();
    });
    Ok(());
}

keep_named_field = (
    be   :: CBackend,
    m    : Member,
    name : str,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    m.named(name).match({
        false => Ok(()),
        true  => be.add_field_type(m, ctx, inst, out),
    })
}

add_field_type = (
    be   :: CBackend,
    m    : Member,
    ctx  : Ctx,
    inst : Inst,
    out  :: Vec<TyId>
) Res<(), AllocError> {
    be.field_type(m, ctx, inst).match({
        None  => Ok(()),
        Ok(t) => out.add(t),
    })
}
