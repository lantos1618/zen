// C rendering of the one IR. Every slot is a C local of its class's type
// (aggregates are aligned byte arrays), every function a static C function,
// and every block a label. The runtime below provides buffered standard
// output, traps, exit hooks, page mapping and threads; kernel calls go
// through libc's `syscall` on Linux and libSystem symbols on macOS. Threads,
// locks and conditions always use pthreads (`PthreadThreads` is 1). The
// caller verifies the program and checks `c_supports` before rendering.
{ Alloc, AllocError } = std.mem
{ String, str } = std.text
{ Vec } = std.collections
{ Res, Ok, None, loop, Range } = std.core
{ Span } = std.source
{ Program, Func, Instruction, Terminator, Unary, Binary, Invocation, Print, Move } = gen.gen_ir
{ Scalar, Layout, Stream, Convert, SysCall, SysValue, Start, IndirectCall, TrapKind } = gen.gen_ir
{ ForeignCall, NativeValue } = gen.gen_ir
{ trap_message, width, signed, integer, float, same } = gen.gen_ir
{ IrFeature } = gen.gen_ir_feature
{ Sys, SysConstant, Platform, DarwinResult } = gen.gen_sys
{ linux_x86_64, linux_arm64, darwin_symbol, darwin_result, constant_value } = gen.gen_sys

c_supports* = (feature: IrFeature) bool {
    feature.match({ Host => false, _ => true })
}

emit_c* = (a: Alloc, program: Program) Res<String, AllocError> {
    writer ::= C(
        out: a.String().try(),
        head: a.String().try(),
        location: a.String().try(),
        labels: a.Vec<bool>(),
        operands: a.Vec<usize>(),
        layouts: a.Vec<Layout>(),
        symbols: a.Vec<str>(),
        first: a.Vec<usize>(),
        borrowed: a.Vec<bool>(),
        taken: a.Vec<bool>(),
        outward: a.Vec<bool>(),
        names: a.Vec<str>(),
        declared: a.Vec<str>(),
        included: a.Vec<str>(),
        origin: a.Vec<usize>(),
        escaped: a.Vec<bool>(),
        stored: a.Vec<bool>(),
        direct: a.Vec<bool>(),
        writes: a.Vec<usize>(),
        aliased: a.Vec<bool>(),
        reads: a.Vec<usize>(),
        addressed: a.Vec<bool>(),
        home: a.Vec<usize>(),
        earliest: a.Vec<usize>(),
        latest: a.Vec<usize>(),
        scattered: a.Vec<bool>(),
        target: a.Vec<usize>(),
        named: a.Vec<bool>(),
        lent: a.Vec<bool>(),
        pure: a.Vec<bool>(),
        dirty: a.Vec<bool>(),
        calls: a.Vec<usize>(),
        pool: a.Vec<usize>(),
        compact: a.Vec<usize>(),
        members: a.Vec<usize>(),
        blocked: a.Vec<bool>(),
        gen: a.Vec<bool>(),
        kill: a.Vec<bool>(),
        live_in: a.Vec<bool>(),
        live_out: a.Vec<bool>(),
        lo: a.Vec<usize>(),
        hi: a.Vec<usize>(),
        heads: a.Vec<usize>(),
        chain: a.Vec<usize>(),
        ends: a.Vec<usize>(),
        sizes: a.Vec<usize>(),
        next: a.Vec<usize>(),
        ret_slot: 0,
        ret_ptr: false,
        copies: 0
    );
    writer.program(program).try();
    text ::= a.String().try();
    text.runtime().try();
    text.add(writer.head.view()).try();
    text.add(writer.out.view()).try();
    Ok(text)
}

C = {
    out :: String,
    // Aggregate typedefs and macOS symbol declarations, which must precede
    // the functions that use them.
    head :: String,
    location :: String,
    labels :: Vec<bool>,
    operands :: Vec<usize>,
    layouts :: Vec<Layout>,
    symbols :: Vec<str>,
    // From `plan`: each function's first parameter in `borrowed`, where a
    // borrowed parameter is an aggregate the callee only reads, passed by
    // pointer instead of copied.
    first :: Vec<usize>,
    borrowed :: Vec<bool>,
    taken :: Vec<bool>,
    // From `plan`, per function: its aggregate result is written through
    // the caller's pointer `zr_ret` instead of returned by value.
    outward :: Vec<bool>,
    // From `plan`, per function: neither it nor anything it calls writes
    // storage older than its own frame, so memory it is lent stays put until
    // it returns.
    pure :: Vec<bool>,
    // Per parameter, laid out as `borrowed`: a store reaches through it.
    dirty :: Vec<bool>,
    // Four words per call argument not addressing the caller's frame, and per
    // call: caller, callee, argument position plus one (zero for the whole
    // call) and the caller's parameter it is plus one (zero for none).
    calls :: Vec<usize>,
    names :: Vec<str>,
    // C symbols declared and headers included, in first-use order.
    declared :: Vec<str>,
    included :: Vec<str>,
    // From `survey`, per slot of one function: the slot an address slot
    // points at (plus one; zero for none), whether that slot's address
    // leaves loads (`escaped`), is stored through (`stored`), and whether an
    // instruction writes the slot itself (`direct`, `writes` times), and
    // whether the slot is another one renamed (`aliased`, see `same`).
    origin :: Vec<usize>,
    escaped :: Vec<bool>,
    stored :: Vec<bool>,
    direct :: Vec<bool>,
    writes :: Vec<usize>,
    aliased :: Vec<bool>,
    // From `places`, per slot: operand reads, whether its address is taken,
    // the one block that mentions it (plus one) unless `scattered`, and its
    // first and last instruction there. An aliased slot names `target` (plus
    // one); a `named` slot is some alias's target.
    reads :: Vec<usize>,
    addressed :: Vec<bool>,
    home :: Vec<usize>,
    earliest :: Vec<usize>,
    latest :: Vec<usize>,
    scattered :: Vec<bool>,
    target :: Vec<usize>,
    named :: Vec<bool>,
    // Block loads lent in place through a checked local address.
    lent :: Vec<bool>,
    // From `share`, per slot: the union (plus one) a block local shares
    // with others whose live ranges never meet it, zero for its own storage.
    pool :: Vec<usize>,
    // Scratch for `share`: each candidate's index (plus one) and slot, the
    // roots ruled out, per-block liveness over candidates, each candidate's
    // live range, a bucket list ordering them by start, and per union the
    // end of its last member's range and its largest member's size.
    compact :: Vec<usize>,
    members :: Vec<usize>,
    blocked :: Vec<bool>,
    gen :: Vec<bool>,
    kill :: Vec<bool>,
    live_in :: Vec<bool>,
    live_out :: Vec<bool>,
    lo :: Vec<usize>,
    hi :: Vec<usize>,
    heads :: Vec<usize>,
    chain :: Vec<usize>,
    ends :: Vec<usize>,
    sizes :: Vec<usize>,
    next :: Vec<usize>,
    // `zc` copies made for borrowed arguments in the current function.
    copies :: usize,
    // The current function's result local (plus one) that names `*zr_ret`,
    // and whether it returns through `zr_ret` at all.
    ret_slot :: usize,
    ret_ptr :: bool,

    program = (self :: @Self, program: Program) Res<(), AllocError> {
        self.plan(program).try();
        program.functions.loop((h, index, function) {
            self.signature(index, function).try();
            self.out.add(";\n").try();
        });
        program.functions.loop((h, index, function) {
            self.function(index, function).try();
        });
        unit_entry = program.functions.get(program.entry).match({
            Ok(f) => f.result.match({ Unit => true, _ => false }),
            None  => true,
        });
        self.out.add(
            "int main(int argc, char **argv, char **envp) {\n  zr_argc = (uint64_t)argc;\n  zr_argv = (uint64_t)(uintptr_t)argv;\n  zr_envp = (uint64_t)(uintptr_t)envp;\n"
        ).try();
        self.out.add(
            unit_entry.match({ true => "  ", false => "  zr_exit((int)" })
        ).try();
        self.callee_name(program.entry).try();
        self.out.add(unit_entry.match({
            true  => "();\n  zr_exit(0);\n}\n",
            false => "());\n}\n",
        }))
    }

    signature = (self :: @Self, index: usize, function: Func) Res<(), AllocError> {
        self.need(function.result).try();
        self.out.add("static ZR_U ").try();
        // Inlined into its callers, a function's block locals widen every
        // caller's frame, and in recursive lowering every level's frame.
        heavy(function).then(() {
            self.out.add("__attribute__((noinline)) ").try();
        });
        outward = self.outward.get(index).value_or(false);
        outward.match({
            true  => self.out.add("void"),
            false => self.out.ctype(function.result),
        }).try();
        self.out.add(" ").try();
        self.callee_name(index).try();
        self.out.add("(").try();
        outward.then(() {
            self.out.add("ZR_U ").try();
            self.out.ctype(function.result).try();
            self.out.add(" *zr_ret").try();
        });
        (function.parameters == 0 && !outward).then(
            () { self.out.add("void").try(); }
        );
        // A body lowered to traps alone never reads its parameters, though
        // the source did, and a unit parameter carries nothing to read; only
        // a returning body's unused data parameter is a warning.
        stub = function.blocks.find((block) {
            block.exit.match({ Return(_) => true, _ => false })
        }).match({ Ok(_) => false, None => true });
        Range(0, function.parameters).loop((i) {
            ty = slot_ty(function, i);
            self.need(ty).try();
            (i > 0 || outward).then(() { self.out.add(", ").try(); });
            (stub || ty.match({ Unit => true, _ => false })).then(() {
                self.out.add("ZR_U ").try();
            });
            self.by_pointer(index, i).then(() { self.out.add("const ").try(); });
            self.out.ctype(ty).try();
            borrowed = self.by_pointer(index, i);
            self.out.add(borrowed.match({ true => " *", false => " " })).try();
            local = param_name(function, i);
            (local.len > 0).match({
                true  => self.out.add(local),
                false => {
                    self.out.add(
                        borrowed.match({ true => "zp", false => "v" })
                    ).try();
                    self.out.fmt("{}", i)
                },
            }).try();
        });
        self.out.add(')')
    }

    callee_name = (self :: @Self, index: usize) Res<(), AllocError> {
        symbol = self.names.get(index).value_or("");
        (symbol.len > 0).match({
            true  => self.out.add(symbol),
            false => self.out.fmt("zf{}", index),
        })
    }

    // Which aggregate parameters travel by pointer. A function whose address
    // is taken keeps by-value parameters, since its indirect callers cannot
    // tell.
    plan = (self :: @Self, program: Program) Res<(), AllocError> {
        program.functions.loop((_) { self.taken.add(false).try(); });
        program.functions.loop((function) {
            function.blocks.loop((block) {
                block.code.loop((instruction) {
                    instruction.match({
                        CodeAddress(v) => { self.taken.set(v.function, true); },
                        _              => (),
                    });
                });
            });
        });
        self.taken.set(program.entry, true);
        program.functions.loop((h, index, function) {
            self.outward.add(!self.taken.get(index).value_or(true) && large(function.result)).try();
        });
        program.functions.loop(
            (function) { self.names.add(function.symbol).try(); }
        );
        program.functions.loop((h, index, function) {
            self.first.add(self.borrowed.len).try();
            self.survey(function).try();
            self.effects(index, function).try();
            Range(0, function.parameters).loop((i) {
                self.borrowed.add(
                    !self.taken.get(index).value_or(true)
                        && large(slot_ty(function, i))
                        && !self.escaped.get(i).value_or(true)
                        && !self.stored.get(i).value_or(true)
                        && !self.direct.get(i).value_or(true)
                ).try();
            });
        });
        changed ::= true;
        loop(() { changed }, (h) {
            changed = false;
            Range(0, self.calls.len / 4).loop((e) {
                caller = self.calls.get(4 * e).value_or(0);
                callee = self.calls.get(4 * e + 1).value_or(0);
                at     = self.calls.get(4 * e + 2).value_or(0);
                param  = self.calls.get(4 * e + 3).value_or(0);
                hit    = (at == 0).match({
                    true  => !self.pure.get(callee).value_or(false),
                    false => self.dirty.get(self.first.get(callee).value_or(0) + at - 1).value_or(true),
                });
                (hit && param == 0 && self.pure.get(caller).value_or(false))
                    .then(() {
                    self.pure.set(caller, false);
                    changed = true;
                });
                (hit && param > 0).then(() {
                    k = self.first.get(caller).value_or(0) + param - 1;
                    (!self.dirty.get(k).value_or(true)).then(() {
                        self.dirty.set(k, true);
                        changed = true;
                    });
                });
            });
        });
        program.functions.loop((g, index, function) {
            steady ::= self.pure.get(index).value_or(false);
            Range(0, function.parameters).loop((i) {
                steady = steady && !self.dirty.get(self.first.get(index).value_or(0) + i).value_or(true);
            });
            self.pure.set(index, steady);
        });
        Ok
    }

    // How `f` writes memory, before its calls are settled: a store through
    // one of its own slots' addresses stays in its frame, one through a
    // parameter marks that parameter, and its calls become `calls` entries.
    effects = (self :: @Self, index: usize, f: Func) Res<(), AllocError> {
        only ::= true;
        Range(0, f.parameters).loop((i) { self.dirty.add(false).try(); });
        f.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    StoreValue(v)   => { only = only && self.reach(
                        f,
                        index,
                        v.base
                    ); },
                    CopyBytes(v)    => { only = only && self.reach(
                        f,
                        index,
                        v.dest
                    ); },
                    AtomicStore(v)  => { only = only && self.reach(
                        f,
                        index,
                        v.base
                    ); },
                    AtomicUpdate(v) => { only = only && self.reach(
                        f,
                        index,
                        v.base
                    ); },
                    CompareSwap(v)  => { only = only && self.reach(
                        f,
                        index,
                        v.base
                    ); },
                    Invoke(call)    => {
                        self.calls.add(index).try();
                        self.calls.add(call.function).try();
                        self.calls.add(0).try();
                        self.calls.add(0).try();
                        call.args.loop((h, i, slot) {
                            (!self.own(slot)).then(() {
                                self.calls.add(index).try();
                                self.calls.add(call.function).try();
                                self.calls.add(i + 1).try();
                                self.calls.add(self.parameter(f, slot)).try();
                            });
                        });
                    },
                    _               => { only = only && !self.writes_memory(
                        instruction
                    ); },
                });
            });
        });
        self.pure.add(only).try();
        Ok
    }

    // A store through `base` stays in the frame, or marks the parameter it is.
    reach = (self :: @Self, f: Func, index: usize, base: usize) bool {
        at = self.parameter(f, base);
        (at > 0).then(() {
            self.dirty.set(self.first.get(index).value_or(0) + at - 1, true);
        });
        at > 0 || self.own(base)
    }

    // The never reassigned parameter `slot` is, plus one; zero for none.
    parameter = (self: @Self, f: Func, slot: usize) usize {
        (slot < f.parameters && self.writes.get(slot).value_or(1) == 0).match({
            true  => slot + 1,
            false => 0,
        })
    }

    own = (self: @Self, base: usize) bool {
        self.origin.get(base).value_or(0) != 0
            && self.writes.get(base).value_or(0) == 1
    }

    writes_memory = (self: @Self, instruction: Instruction) bool {
        instruction.match({
            Invoke(call)    => !self.pure.get(call.function).value_or(false),
            StoreValue(_)   => true,
            CopyBytes(_)    => true,
            Text(_)         => true,
            System(_)       => true,
            MapPages(_)     => true,
            UnmapPages(_)   => true,
            Machine(_)      => true,
            Host(_)         => true,
            Foreign(_)      => true,
            Wait(_)         => true,
            AtomicStore(_)  => true,
            AtomicUpdate(_) => true,
            CompareSwap(_)  => true,
            InvokeAt(_)     => true,
            _               => false,
        })
    }

    by_pointer = (self: @Self, function: usize, param: usize) bool {
        self.borrowed.get(self.first.get(function).value_or(0) + param).value_or(false)
    }

    survey = (self :: @Self, function: Func) Res<(), AllocError> {
        count = function.slots.len;
        self.origin.clear();
        self.escaped.clear();
        self.stored.clear();
        self.direct.clear();
        self.writes.clear();
        self.aliased.clear();
        self.reads.clear();
        self.addressed.clear();
        self.home.clear();
        self.earliest.clear();
        self.latest.clear();
        self.scattered.clear();
        self.target.clear();
        self.named.clear();
        self.lent.clear();
        Range(0, count).loop((_) {
            self.origin.add(0).try();
            self.escaped.add(false).try();
            self.stored.add(false).try();
            self.direct.add(false).try();
            self.writes.add(0).try();
            self.aliased.add(false).try();
            self.reads.add(0).try();
            self.addressed.add(false).try();
            self.home.add(0).try();
            self.earliest.add(0).try();
            self.latest.add(0).try();
            self.scattered.add(false).try();
            self.target.add(0).try();
            self.named.add(false).try();
            self.lent.add(false).try();
        });
        function.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    AddressOf(v) => self.points(v.out, v.slot),
                    _            => (),
                });
            });
        });
        function.blocks.loop((block) {
            block.code.loop((instruction) { self.uses(instruction); });
            block.exit.match({
                Return(slot)   => self.escape(slot),
                Branch(branch) => self.escape(branch.value),
                _              => (),
            });
        });
        Ok
    }

    // An address slot naming two slots leaves both unproven.
    points = (self :: @Self, out: usize, slot: usize) {
        previous = self.origin.get(out).value_or(0);
        (previous != 0 && previous != slot + 1).then(() {
            self.escaped.set(previous - 1, true);
            self.escaped.set(slot, true);
        });
        self.origin.set(out, slot + 1);
        self.addressed.set(slot, true);
    }

    // A load base or copy source only reads through an address; any other
    // read of an address slot lets the address go anywhere.
    uses = (self :: @Self, instruction: Instruction) {
        instruction.match({
            Constant(v)      => self.wrote(v.out),
            Copy(v)          => {
                self.wrote(v.out);
                self.escape(v.source);
            },
            UnaryValue(v)    => {
                self.wrote(v.out);
                self.escape(v.input);
            },
            BinaryValue(v)   => {
                self.wrote(v.out);
                self.escape(v.left);
                self.escape(v.right);
            },
            Invoke(v)        => {
                self.wrote(v.out);
                self.escapes(v.args);
            },
            PrintValue(v)    => self.escape(v.value),
            Text(_)          => (),
            Cast(v)          => {
                self.wrote(v.out);
                self.escape(v.input);
            },
            AddressOf(v)     => self.wrote(v.out),
            LoadValue(v)     => self.wrote(v.out),
            StoreValue(v)    => {
                self.through(v.base);
                self.escape(v.value);
            },
            CopyBytes(v)     => {
                self.through(v.dest);
                self.escape(v.bytes);
            },
            Bytes(v)         => self.wrote(v.out),
            WriteOut(v)      => {
                self.escape(v.data);
                self.escape(v.len);
            },
            System(v)        => {
                self.wrote(v.out);
                self.escapes(v.args);
            },
            Startup(v)       => self.wrote(v.out),
            MapPages(v)      => {
                self.wrote(v.out);
                self.escape(v.bytes);
            },
            UnmapPages(s)    => self.escape(s),
            SysConst(v)      => self.wrote(v.out),
            Flush            => (),
            FormatFloat(v)   => {
                self.wrote(v.out);
                self.through(v.dest);
                self.escape(v.value);
            },
            Machine(v)       => {
                v.outs.loop((s) { self.wrote(s); });
                self.escapes(v.args);
            },
            Host(v)          => {
                self.wrote(v.out);
                self.escapes(v.args);
            },
            Foreign(v)       => {
                self.wrote(v.out);
                self.escapes(v.args);
            },
            NativeConst(v)   => self.wrote(v.out),
            Wait(s)          => self.wrote(s),
            VolatileLoad(v)  => self.wrote(v.out),
            VolatileStore(v) => {
                self.through(v.base);
                self.escape(v.value);
            },
            Barrier          => (),
            AtomicLoad(v)    => self.wrote(v.out),
            AtomicStore(v)   => {
                self.through(v.base);
                self.escape(v.value);
            },
            AtomicUpdate(v)  => {
                self.wrote(v.out);
                self.through(v.base);
                self.escape(v.value);
            },
            CompareSwap(v)   => {
                self.wrote(v.out);
                self.through(v.base);
                self.escape(v.expected);
                self.escape(v.desired);
            },
            CodeAddress(v)   => self.wrote(v.out),
            InvokeAt(v)      => {
                self.wrote(v.out);
                self.escape(v.target);
                self.escapes(v.args);
            },
        })
    }

    escape = (self :: @Self, slot: usize) {
        at = self.origin.get(slot).value_or(0);
        (at != 0).then(() { self.escaped.set(at - 1, true); });
    }

    escapes = (self :: @Self, slots: Vec<usize>) {
        slots.loop((slot) { self.escape(slot); });
    }

    through = (self :: @Self, slot: usize) {
        at = self.origin.get(slot).value_or(0);
        (at != 0).then(() { self.stored.set(at - 1, true); });
    }

    wrote = (self :: @Self, slot: usize) {
        self.direct.set(slot, true);
        self.writes.set(slot, self.writes.get(slot).value_or(0) + 1);
    }

    // A slot copied from a slot that never changes again, into a slot only
    // that copy writes, holds the source's value wherever it is read: the
    // verifier puts the copy before every read, and the source before it.
    same = (self: @Self, f: Func, copy: Move) bool {
        alike(slot_ty(f, copy.out), slot_ty(f, copy.source))
            && copy.out != copy.source
            && copy.out >= f.parameters
            && self.writes.get(copy.out).value_or(2) == 1
            && self.fixed(copy.out)
            && self.fixed(copy.source)
            && self.once(f, copy.source)
    }


    // The copy's source, a block local no alias has claimed whose address
    // stays put, is read only by the copy, so its storage can be the
    // destination's.
    plain = (self: @Self, f: Func, copy: Move) bool {
        is_block(slot_ty(f, copy.out)) && copy.out != copy.source
            && copy.source >= f.parameters
            && copy.out >= f.parameters
            && self.target.get(copy.source).value_or(1) == 0
            && !self.named.get(copy.source).value_or(true)
            && !self.escaped.get(copy.source).value_or(true)
            && self.reads.get(copy.source).value_or(0) == 1
    }

    // Nothing runs between a copy into the returned slot and the return.
    returned = (self: @Self, f: Func, b: usize, k: usize, copy: Move) bool {
        f.blocks.get(b).match({
            Ok(block) => k + 1 == block.code.len && self.plain(f, copy)
                && self.target.get(copy.out).value_or(1) == 0
                && !self.named.get(copy.out).value_or(true)
                && !self.addressed.get(copy.out).value_or(true)
                && self.reads.get(copy.out).value_or(0) == 1
                && self.writes.get(copy.out).value_or(0) == 1
                && returns(f, block.exit, copy.out),
            None      => false,
        })
    }


    // A source mentioned only in the copy's block, up to the copy, is built
    // in the destination if nothing in between touches the destination.
    into = (self: @Self, f: Func, b: usize, k: usize, copy: Move) bool {
        dest = self.root(copy.out);
        self.plain(f, copy)
            && !self.scattered.get(copy.source).value_or(true)
            && self.home.get(copy.source).value_or(0) == b + 1
            && self.latest.get(copy.source).value_or(0) == k
            && !self.escaped.get(dest).value_or(true)
            && self.untouched(
                f,
                b,
                self.earliest.get(copy.source).value_or(0),
                k,
                dest
            )
    }

    // A single-use block load can pass its local source to a read-only callee.
    viewed = (self: @Self, f: Func, b: usize, k: usize, call: Invocation,
              slot: usize) bool {
        j = self.earliest.get(slot).value_or(0);
        (is_block(slot_ty(f, slot)) && slot >= f.parameters
            && self.writes.get(slot).value_or(2) == 1
            && self.reads.get(slot).value_or(0) == 1
            && self.target.get(slot).value_or(1) == 0
            && !self.named.get(slot).value_or(true)
            && !self.addressed.get(slot).value_or(true)
            && !self.scattered.get(slot).value_or(true)
            && self.home.get(slot).value_or(0) == b + 1
            && self.latest.get(slot).value_or(0) == k).match({
            true  => f.blocks.get(b).match({
                Ok(block) => block.code.get(j).match({
                    Ok(instruction) => instruction.match({
                        LoadValue(load) => load.out == slot
                            && self.lends(f, b, j, k, call, load.base),
                        _               => false,
                    }),
                    None            => false,
                }),
                None      => false,
            }),
            false => false,
        })
    }

    lends = (self: @Self, f: Func, b: usize, j: usize, k: usize,
             call: Invocation, base: usize) bool {
        // A `::` parameter may change through another alias during the call.
        // A local AddressOf origin has storage this pass can prove stable;
        // storage behind any other pointer stays put only while nothing
        // writes memory between the load and the callee's return.
        at = self.origin.get(base).value_or(0);
        (at > f.parameters && self.writes.get(base).value_or(0) == 1).match({
            true  => {
                dest = self.root(at - 1);
                dest >= f.parameters
                    && self.fixed(at - 1) && self.fixed(dest)
                    && self.root(call.out) != dest
                    && self.untouched(f, b, j + 1, k, dest)
            },
            false => at == 0 && self.pure.get(call.function).value_or(false)
                && self.quiet(f, b, j + 1, k, base),
        })
    }

    // No instruction from `from` up to `to` writes memory or `base`.
    quiet = (self: @Self, f: Func, b: usize, from: usize, to: usize,
             base: usize) bool {
        clear ::= true;
        f.blocks.get(b).match({
            Ok(block) => Range(from, to).loop((k) {
                block.code.get(k).match({
                    Ok(instruction) => {
                        self.writes_memory(instruction).then(() {
                            clear = false;
                        });
                        mentions(instruction, (slot, read) {
                            (!read && self.root(slot) == self.root(base)).then(() { clear = false; });
                        });
                    },
                    None            => (),
                });
            }),
            None      => { clear = false; },
        });
        clear
    }

    // The local place a lent load would have copied from.
    lend = (self :: @Self, f: Func, slot: usize) Res<(), AllocError> {
        f.blocks.get(self.home.get(slot).value_or(1) - 1).match({
            Ok(block) => block.code.get(self.earliest.get(slot).value_or(0))
                .match({
                Ok(instruction) => instruction.match({
                    LoadValue(load) => {
                        self.out.add("(const void *)").try();
                        self.place(load.base, load.offset, "const ")
                    },
                    _               => self.out.fmt("&v{}", slot),
                }),
                None            => self.out.fmt("&v{}", slot),
            }),
            None      => self.out.fmt("&v{}", slot),
        })
    }

    untouched = (self: @Self, f: Func, b: usize, from: usize, to: usize,
                 dest: usize) bool {
        clear ::= true;
        f.blocks.get(b).match({
            Ok(block) => Range(from, to).loop((k) {
                block.code.get(k).match({
                    Ok(instruction) => mentions(instruction, (slot, read) {
                        self.touches(slot, dest).then(() { clear = false; });
                    }),
                    None            => (),
                });
            }),
            None      => { clear = false; },
        });
        clear
    }

    touches = (self: @Self, slot: usize, dest: usize) bool {
        at = self.origin.get(slot).value_or(0);
        self.root(slot) == dest || (at != 0 && self.root(at - 1) == dest)
    }

    root = (self: @Self, slot: usize) usize {
        to = self.target.get(slot).value_or(0);
        (to == 0).match({ true => slot, false => self.root(to - 1) })
    }

    rename = (self :: @Self, from: usize, to: usize) Res<(), AllocError> {
        self.target.set(from, to + 1);
        self.named.set(to, true);
        self.out.fmt("#define v{} v{}\n", from, to)
    }

    places = (self :: @Self, function: Func) {
        function.blocks.loop((h, b, block) {
            block.code.loop((g, k, instruction) {
                mentions(
                    instruction,
                    (slot, read) { self.mention(slot, read, b, k); }
                );
            });
            block.exit.match({
                Return(slot)   => self.mention(slot, true, b, block.code.len),
                Branch(branch) => self.mention(
                    branch.value,
                    true,
                    b,
                    block.code.len
                ),
                _              => (),
            });
        });
    }

    mention = (self :: @Self, slot: usize, read: bool, b: usize, k: usize) {
        read.then(() {
            self.reads.set(slot, self.reads.get(slot).value_or(0) + 1);
        });
        self.mark(slot, b, k);
        at = self.origin.get(slot).value_or(0);
        (at != 0).then(() { self.mark(at - 1, b, k); });
    }

    mark = (self :: @Self, slot: usize, b: usize, k: usize) {
        (self.home.get(slot).value_or(0) == 0).match({
            true  => {
                self.home.set(slot, b + 1);
                self.earliest.set(slot, k);
                self.latest.set(slot, k);
            },
            false => (self.home.get(slot).value_or(0) == b + 1).match({
                true  => { self.latest.set(slot, k); },
                false => { self.scattered.set(slot, true); },
            }),
        });
    }

    once = (self: @Self, f: Func, slot: usize) bool {
        self.writes.get(slot).value_or(2)
            + (slot < f.parameters).match({ true => 1, false => 0 })
            <= 1
    }

    // No address of the slot is stored through or leaves loads.
    fixed = (self: @Self, slot: usize) bool {
        !self.escaped.get(slot).value_or(true)
            && !self.stored.get(slot).value_or(true)
    }

    // The typedef for an aggregate class, once per layout.
    need = (self :: @Self, ty: Scalar) Res<(), AllocError> {
        ty.match({
            Block(layout) => {
                known ::= false;
                self.layouts.loop((seen) {
                    (seen.size == layout.size && seen.align == layout.align)
                        .then(() { known = true; });
                });
                known.match({
                    true  => Ok,
                    false => {
                        self.layouts.add(layout).try();
                        // One field per line, as gen_c spells records, so
                        // tools/ct can lay out the parameters it audits.
                        self.head.fmt(
                            "struct zb{}_{} {{\n    unsigned char b[{}];\n}} __attribute__((aligned({})));\ntypedef struct zb{}_{} zb{}_{};\n",
                            layout.size,
                            layout.align,
                            at_least_one(layout.size),
                            at_least_one(layout.align),
                            layout.size,
                            layout.align,
                            layout.size,
                            layout.align
                        )
                    },
                })
            },
            _             => Ok,
        })
    }

    function = (self :: @Self, index: usize, function: Func) Res<(), AllocError> {
        self.signature(index, function).try();
        self.out.add(" {\n").try();
        // A borrowed parameter's reads go through its pointer.
        Range(0, function.parameters).loop((i) {
            local    = param_name(function, i);
            borrowed = self.by_pointer(index, i);
            (local.len > 0).match({
                true  => borrowed.match({
                    true  => self.out.fmt("#define v{} (*{})\n", i, local),
                    false => self.out.fmt("#define v{} {}\n", i, local),
                }),
                false => borrowed.match({
                    true  => self.out.fmt("#define v{} (*zp{})\n", i, i),
                    false => Ok,
                }),
            }).try();
        });
        self.survey(function).try();
        self.copies = 0;
        function.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    Copy(copy) => self.same(function, copy).then(() {
                        self.aliased.set(copy.out, true);
                        self.target.set(copy.out, copy.source + 1);
                        self.named.set(copy.source, true);
                        self.out.fmt("#define v{} v{}\n", copy.out, copy.source)
                            .try();
                    }),
                    _          => (),
                });
            });
        });
        self.places(function);
        function.blocks.loop((h, b, block) {
            block.code.loop((g, k, instruction) {
                instruction.match({
                    Copy(copy) => (self.returned(function, b, k, copy)
                        || self.into(function, b, k, copy)).then(() {
                        self.rename(copy.source, copy.out).try();
                    }),
                    _          => (),
                });
            });
        });
        function.blocks.loop((h, b, block) {
            block.code.loop((g, k, instruction) {
                instruction.match({
                    Invoke(call) => call.args.loop((h, i, slot) {
                        (self.by_pointer(call.function, i)
                            && self.viewed(function, b, k, call, slot)).then(() {
                            self.lent.set(slot, true);
                        });
                    }),
                    _            => (),
                });
            });
        });
        self.result_slot(index, function);
        self.share(function).try();
        // A sanitizer pads every addressable local and re-marks it at every
        // label, so under one the block slots share a single frame instead.
        frame ::= false;
        Range(function.parameters, function.slots.len).loop((i) {
            ty = slot_ty(function, i);
            self.need(ty).try();
            self.own_storage(function, i).then(() {
                (!frame).then(() {
                    self.out.add("#ifdef ZR_ASAN\n  ZR_U struct {").try();
                });
                frame = true;
                self.out.add(" ").try();
                self.out.ctype(ty).try();
                self.out.fmt(" v{};", i).try();
            });
        });
        frame.then(() {
            self.out.add(
                " } *const zr_fr = __builtin_alloca_with_align(sizeof *zr_fr, 8 * __alignof__(*zr_fr));\n"
            ).try();
            Range(function.parameters, function.slots.len).loop((i) {
                self.own_storage(function, i).then(() {
                    self.out.fmt("#define v{} zr_fr->v{}\n", i, i).try();
                });
            });
            self.out.add("#else\n").try();
            Range(function.parameters, function.slots.len).loop((i) {
                self.own_storage(function, i).then(() {
                    self.out.add("  ZR_U ").try();
                    self.out.ctype(slot_ty(function, i)).try();
                    self.out.fmt(" v{};\n", i).try();
                });
            });
            self.out.add("#endif\n").try();
        });
        (self.ret_slot > 0).then(() {
            self.out.fmt("#define v{} (*zr_ret)\n", self.ret_slot - 1).try();
        });
        // The verifier has proved every read follows a write, so zeroing is
        // only a hint: an optimizer folds the zeroed scalars well, while an
        // unoptimized build would store each one on every call (ZR_Z).
        Range(function.parameters, function.slots.len).loop((i) {
            (self.target.get(i).value_or(0) == 0 && !self.framed(function, i))
                .then(() {
                    self.out.add("  ZR_U ").try();
                    self.out.ctype(slot_ty(function, i)).try();
                    self.out.fmt(" v{} ZR_Z;\n", i).try();
                });
        });
        self.labels.clear();
        function.blocks.loop((_) { self.labels.add(false).try(); });
        function.blocks.loop((h, b, block) {
            block.exit.match({
                Jump(to)       => {
                    (to != b + 1).then(() { self.labels.set(to, true); });
                },
                Branch(branch) => {
                    (branch.yes != b + 1).then(
                        () { self.labels.set(branch.yes, true); }
                    );
                    (branch.no != b + 1 || branch.yes == b + 1).then(
                        () { self.labels.set(branch.no, true); }
                    );
                },
                _              => (),
            });
        });
        function.blocks.loop((h, block_id, block) {
            self.labels.get(block_id).value_or(false).then(() {
                self.out.fmt("b{}:;\n", block_id).try();
            });
            block.code.loop(
                (instruction) { self.instruction(function, instruction).try(); }
            );
            self.terminator(block.exit, block_id + 1).try();
        });
        self.out.add("}\n").try();
        Range(0, function.parameters).loop((i) {
            (self.by_pointer(index, i) || param_name(function, i).len > 0).then(() {
                self.out.fmt("#undef v{}\n", i).try();
            });
        });
        Range(function.parameters, function.slots.len).loop((i) {
            (self.target.get(i).value_or(0) != 0 || self.framed(function, i))
                .then(() { self.out.fmt("#undef v{}\n", i).try(); });
        });
        Ok
    }

    framed = (self: @Self, f: Func, slot: usize) bool {
        self.target.get(slot).value_or(0) == 0 && is_block(slot_ty(f, slot))
    }

    own_storage = (self: @Self, f: Func, slot: usize) bool {
        self.framed(f, slot) && self.pool.get(slot).value_or(0) == 0
            && self.ret_slot != slot + 1
    }

    // When every return of an outward function names one block local whose
    // address stays in the function, that local is the caller's storage, so
    // returning copies nothing.
    result_slot = (self :: @Self, index: usize, f: Func) {
        self.ret_ptr  = self.outward.get(index).value_or(false);
        self.ret_slot = 0;
        found :: usize = 0;
        agree ::= true;
        f.blocks.loop((block) {
            block.exit.match({
                Return(slot) => {
                    s = self.root(slot) + 1;
                    (found != 0 && found != s).then(() { agree = false; });
                    found = s;
                },
                _            => (),
            });
        });
        (self.ret_ptr && agree && found > f.parameters
            && self.framed(f, found - 1)
            && !self.escaped.get(found - 1).value_or(true)
            && !self.lent.get(found - 1).value_or(true)).then(() {
            self.ret_slot = found;
        });
    }

    // A block local whose address the IR never takes is a plain value: its
    // only C address is one lent to a call for that call alone. Two such
    // locals whose live ranges never meet share one union's storage, which
    // keeps a function's frame near its widest point instead of the sum of
    // every temporary. A range spans every position its local is live at,
    // so it covers the true live set and sharing never overlaps values.
    share = (self :: @Self, f: Func) Res<(), AllocError> {
        count = f.slots.len;
        self.pool.clear();
        self.compact.clear();
        self.members.clear();
        self.blocked.clear();
        Range(0, count).loop((_) {
            self.pool.add(0).try();
            self.compact.add(0).try();
            self.blocked.add(false).try();
        });
        Range(0, count).loop((s) {
            (s < f.parameters || self.escaped.get(s).value_or(true)
                || self.lent.get(s).value_or(true)
                || self.ret_slot == s + 1).then(() {
                self.blocked.set(self.root(s), true);
            });
        });
        // A lent load reads its local at the call, not where it loads.
        f.blocks.loop((block) {
            block.code.loop((instruction) {
                instruction.match({
                    LoadValue(v) => (self.lent.get(v.out).value_or(false)
                        && self.origin.get(v.base).value_or(0) != 0).then(() {
                        at = self.origin.get(v.base).value_or(0) - 1;
                        self.blocked.set(self.root(at), true);
                    }),
                    _            => (),
                });
            });
        });
        // Small values stay apart: the C compiler keeps those in registers,
        // which it cannot do for one member of a union.
        Range(f.parameters, count).loop((s) {
            (self.framed(f, s) && block_size(slot_ty(f, s)) > SHARED_FROM
                && !self.blocked.get(s).value_or(true)).then(() {
                self.members.add(s).try();
                self.compact.set(s, self.members.len);
            });
        });
        k = self.members.len;
        bytes :: usize = 0;
        self.members.loop(
            (slot) { bytes = bytes + block_size(slot_ty(f, slot)); }
        );
        // Sharing costs a liveness pass; a frame this small is not worth it.
        (k >= 2 && bytes >= SHARED_FRAME).then(() {
            self.liveness(f, k).try();
            self.ranges(f, k).try();
            self.pack(f).try();
            self.declare_pools(f).try();
        });
        Ok
    }

    // The candidate index (plus one) a slot's storage belongs to.
    candidate = (self: @Self, slot: usize) usize {
        self.compact.get(self.root(slot)).value_or(0)
    }

    // The candidate a mention reaches: the slot's own, or the one an
    // address slot points at, whose address only ever loads or stores, so
    // every access to that local is a mention of one of the two.
    reached = (self: @Self, slot: usize) usize {
        c  = self.candidate(slot);
        at = self.origin.get(slot).value_or(0);
        (c == 0 && at != 0).match({
            true  => self.candidate(at - 1),
            false => c,
        })
    }

    liveness = (self :: @Self, f: Func, k: usize) Res<(), AllocError> {
        blocks = f.blocks.len;
        self.gen.clear();
        self.kill.clear();
        self.live_in.clear();
        self.live_out.clear();
        self.gen.reserve(blocks * k).try();
        self.kill.reserve(blocks * k).try();
        self.live_in.reserve(blocks * k).try();
        self.live_out.reserve(blocks * k).try();
        Range(0, blocks * k).loop((_) {
            self.gen.add(false).try();
            self.kill.add(false).try();
            self.live_in.add(false).try();
            self.live_out.add(false).try();
        });
        f.blocks.loop((h, b, block) {
            base = b * k;
            exit_value(block.exit).when_ok((r) {
                c = self.reached(r);
                (c != 0).then(() { self.gen.set(base + c - 1, true); });
            });
            n = block.code.len;
            Range(0, n).loop((i) {
                instruction = block.code.get(n - 1 - i).value_or(Instruction.Flush);
                whole       = replaces(instruction);
                mentions(instruction, (slot, read) {
                    c = self.candidate(slot);
                    (!read && whole && c != 0).then(() {
                        self.kill.set(base + c - 1, true);
                        self.gen.set(base + c - 1, false);
                    });
                });
                mentions(instruction, (slot, read) {
                    c   = self.reached(slot);
                    own = self.candidate(slot) != 0;
                    ((read || !own || !whole) && c != 0).then(() {
                        self.gen.set(base + c - 1, true);
                    });
                });
            });
        });
        changed ::= true;
        loop(() { changed }, (h) {
            changed = false;
            Range(0, blocks).loop((j) {
                b = blocks - 1 - j;
                self.next.clear();
                f.blocks.get(b).when_ok((block) {
                    block.exit.match({
                        Jump(to)       => { self.next.add(to).try(); },
                        Branch(branch) => {
                            self.next.add(branch.yes).try();
                            self.next.add(branch.no).try();
                        },
                        _              => (),
                    });
                });
                Range(0, k).loop((s) {
                    out ::= false;
                    self.next.loop((x) {
                        self.live_in.get(x * k + s).value_or(false)
                            .then(() { out = true; });
                    });
                    self.live_out.set(b * k + s, out);
                    into = self.gen.get(b * k + s).value_or(false)
                        || (out && !self.kill.get(b * k + s).value_or(false));
                    (into != self.live_in.get(b * k + s).value_or(false)).then(() {
                        self.live_in.set(b * k + s, into);
                        changed = true;
                    });
                });
            });
        });
        Ok
    }

    // Positions number each block's instructions and then its exit, block
    // after block.
    ranges = (self :: @Self, f: Func, k: usize) Res<(), AllocError> {
        total :: usize = 0;
        f.blocks.loop((block) { total = total + block.code.len + 1; });
        self.lo.clear();
        self.hi.clear();
        Range(0, k).loop((_) {
            self.lo.add(total).try();
            self.hi.add(0).try();
        });
        at :: usize = 0;
        f.blocks.loop((h, b, block) {
            start = at;
            end   = at + block.code.len;
            Range(0, k).loop((s) {
                self.live_in.get(b * k + s).value_or(false)
                    .then(() { self.cover(s, start); });
                self.live_out.get(b * k + s).value_or(false)
                    .then(() { self.cover(s, end); });
            });
            block.code.loop((g, i, instruction) {
                mentions(instruction, (slot, read) {
                    c = self.reached(slot);
                    (c != 0).then(() { self.cover(c - 1, start + i); });
                });
            });
            exit_value(block.exit).when_ok((r) {
                c = self.reached(r);
                (c != 0).then(() { self.cover(c - 1, end); });
            });
            at = end + 1;
        });
        self.heads.clear();
        Range(0, total + 1).loop((_) { self.heads.add(0).try(); });
        self.chain.clear();
        Range(0, k).loop((s) {
            first = self.lo.get(s).value_or(total);
            self.chain.add(self.heads.get(first).value_or(0)).try();
            self.heads.set(first, s + 1);
        });
        Ok
    }

    cover = (self :: @Self, s: usize, position: usize) {
        (position < self.lo.get(s).value_or(0)).then(() { self.lo.set(s, position); });
        (position > self.hi.get(s).value_or(0)).then(() { self.hi.set(s, position); });
    }

    // Candidates in order of where their ranges start each join a union
    // whose last range has ended: the smallest one at least their size, or
    // else the largest, so a union grows as little as it can.
    pack = (self :: @Self, f: Func) Res<(), AllocError> {
        self.ends.clear();
        self.sizes.clear();
        total = self.heads.len - 1;
        Range(0, total).loop((p) {
            s ::= self.heads.get(p).value_or(0);
            loop(() { s != 0 }, (h) {
                c    = s - 1;
                slot = self.members.get(c).value_or(0);
                size = block_size(slot_ty(f, slot));
                best :: usize = 0;
                fits ::= false;
                Range(0, self.ends.len).loop((j) {
                    (self.ends.get(j).value_or(total) < p).then(() {
                        have   = self.sizes.get(j).value_or(0);
                        better = (best == 0).match({
                            true  => true,
                            false => {
                                held = self.sizes.get(best - 1).value_or(0);
                                (have >= size).match({
                                    true  => !fits || have < held,
                                    false => !fits && have > held,
                                })
                            },
                        });
                        better.then(() {
                            best = j + 1;
                            fits = have >= size;
                        });
                    });
                });
                (best == 0).then(() {
                    self.ends.add(0).try();
                    self.sizes.add(0).try();
                    best = self.ends.len;
                });
                self.pool.set(slot, best);
                self.ends.set(best - 1, self.hi.get(c).value_or(total));
                (size > self.sizes.get(best - 1).value_or(0)).then(() {
                    self.sizes.set(best - 1, size);
                });
                s = self.chain.get(c).value_or(0);
            });
        });
        Ok
    }

    // A union of one member is just that local: it keeps its own storage.
    declare_pools = (self :: @Self, f: Func) Res<(), AllocError> {
        self.ends.clear();
        Range(0, self.sizes.len).loop((_) { self.ends.add(0).try(); });
        self.members.loop((slot) {
            j = self.pool.get(slot).value_or(0);
            (j != 0).then(() {
                self.ends.set(j - 1, self.ends.get(j - 1).value_or(0) + 1);
            });
        });
        self.members.loop((slot) {
            j = self.pool.get(slot).value_or(0);
            (j != 0 && self.ends.get(j - 1).value_or(0) < 2).then(() {
                self.pool.set(slot, 0);
            });
        });
        Range(0, self.sizes.len).loop((j) {
            (self.ends.get(j).value_or(0) >= 2).then(() {
                self.out.add("  ZR_U union {").try();
                self.members.loop((slot) {
                    (self.pool.get(slot).value_or(0) == j + 1).then(() {
                        self.out.add(" ").try();
                        self.out.ctype(slot_ty(f, slot)).try();
                        self.out.fmt(" m{};", slot).try();
                    });
                });
                self.out.fmt(" }} zs{};\n", j).try();
                self.members.loop((slot) {
                    (self.pool.get(slot).value_or(0) == j + 1).then(() {
                        self.out.fmt(
                            "#define v{} zs{}.m{}\n",
                            slot,
                            j,
                            slot
                        ).try();
                    });
                });
            });
        });
        Ok
    }

    // `next` is the block rendered after this one; a jump to it falls through.
    terminator = (self :: @Self, exit: Terminator, next: usize)
                 Res<(), AllocError> {
        exit.match({
            Return(value)  => self.ret_ptr.match({
                true  => (self.root(value) + 1 == self.ret_slot).match({
                    true  => self.out.add("  return;\n"),
                    false => self.out.fmt("  *zr_ret = v{};\n  return;\n", value),
                }),
                false => self.out.fmt("  return v{};\n", value),
            }),
            Jump(to)       => (to == next).match({
                true  => Ok,
                false => self.out.fmt("  goto b{};\n", to),
            }),
            Branch(branch) => (branch.no == next && branch.yes != next).match({
                true  => self.out.fmt(
                    "  if (v{}) goto b{};\n",
                    branch.value,
                    branch.yes
                ),
                false => (branch.yes == next).match({
                    true  => self.out.fmt(
                        "  if (!v{}) goto b{};\n",
                        branch.value,
                        branch.no
                    ),
                    false => self.out.fmt(
                        "  if (v{}) goto b{}; else goto b{};\n",
                        branch.value,
                        branch.yes,
                        branch.no
                    ),
                }),
            }),
            Trap(fault)    => {
                self.out.add("  ").try();
                self.trap(fault.span, fault.what)
            },
        })
    }

    // Zen's trap report: `file:line:col: trap: message`.
    trap = (self :: @Self, span: Span, what: TrapKind) Res<(), AllocError> {
        self.location.clear();
        self.location.fmt(
            "{}:{}:{}: trap: {}\n",
            span.file,
            span.start.line,
            span.start.col,
            trap_message(what)
        ).try();
        self.out.add("zr_trap(").try();
        self.out.bytes(self.location.view()).try();
        self.out.fmt(", {});\n", self.location.view().len)
    }

    instruction = (self :: @Self, f: Func, instruction: Instruction)
                  Res<(), AllocError> {
        instruction.match({
            Constant(value)      => self.constant(f, value.out, value.value),
            Copy(value)          => (self.root(value.source)
                == self.root(value.out)).match({
                true  => Ok,
                false => self.out.fmt("  v{} = v{};\n", value.out, value.source),
            }),
            UnaryValue(value)    => self.unary(f, value),
            BinaryValue(value)   => self.binary(f, value),
            Invoke(value)        => self.invoke(f, value),
            PrintValue(value)    => self.print(f, value),
            Text(text)           => {
                self.out.add("  zr_text(1, ").try();
                self.out.bytes(text).try();
                self.out.fmt(", {});\n", text.len)
            },
            Cast(value)          => self.convert(f, value),
            AddressOf(value)     => self.out.fmt(
                "  v{} = (uint64_t)(uintptr_t)&v{};\n",
                value.out,
                value.slot
            ),
            LoadValue(value)     => self.lent.get(value.out).value_or(false).match({
                true  => Ok,
                false => is_block(slot_ty(f, value.out)).match({
                    true  => {
                        self.out.fmt("  memcpy(&v{}, ", value.out).try();
                        self.place(value.base, value.offset, "const ").try();
                        self.out.fmt(", sizeof v{});\n", value.out)
                    },
                    false => {
                        self.out.fmt("  v{} = *(const za_", value.out).try();
                        ctype(self.out, slot_ty(f, value.out)).try();
                        self.out.add(" *)").try();
                        self.place(value.base, value.offset, "const ").try();
                        self.out.add(";\n")
                    },
                }),
            }),
            StoreValue(value)    => is_block(slot_ty(f, value.value)).match({
                true  => {
                    self.out.add("  memcpy(").try();
                    self.place(value.base, value.offset, "").try();
                    self.out.fmt(
                        ", &v{}, sizeof v{});\n",
                        value.value,
                        value.value
                    )
                },
                false => {
                    self.out.add("  *(za_").try();
                    ctype(self.out, slot_ty(f, value.value)).try();
                    self.out.add(" *)").try();
                    self.place(value.base, value.offset, "").try();
                    self.out.fmt(" = v{};\n", value.value)
                },
            }),
            CopyBytes(value)     => self.out.fmt(
                "  memmove((void *)(uintptr_t)v{}, (const void *)(uintptr_t)v{}, (size_t)v{});\n",
                value.dest,
                value.source,
                value.bytes
            ),
            Bytes(value)         => {
                self.out.fmt("  v{} = (uint64_t)(uintptr_t)", value.out).try();
                self.out.bytes(value.bytes).try();
                self.out.add(";\n")
            },
            WriteOut(value)      => self.out.fmt(
                "  zr_write({}, v{}, v{});\n",
                descriptor(value.stream),
                value.data,
                value.len
            ),
            System(value)        => self.system(f, value),
            Startup(value)       => self.startup(f, value),
            MapPages(value)      => self.out.fmt(
                "  v{} = zr_map(v{});\n",
                value.out,
                value.bytes
            ),
            UnmapPages(slot)     => self.out.fmt("  zr_unmap(v{});\n", slot),
            SysConst(value)      => self.sys_const(f, value),
            Flush                => self.out.add("  zr_flush();\n"),
            FormatFloat(v)       => self.out.fmt(
                "  v{} = zr_ftext((char *)(uintptr_t)v{}, v{});\n",
                v.out,
                v.dest,
                v.value
            ),
            Machine(_)           => self.out.add("  __builtin_trap();\n"),
            // Through a volatile-qualified lvalue, so cc performs the access exactly
            // once and keeps a store whose memory is never read again (`wipe`).
            VolatileLoad(value)  => {
                self.out.fmt("  v{} = *(volatile const za_", value.out).try();
                ctype(self.out, slot_ty(f, value.out)).try();
                self.out.add(" *)").try();
                self.place(value.base, value.offset, "const ").try();
                self.out.add(";\n")
            },
            VolatileStore(value) => {
                self.out.add("  *(volatile za_").try();
                ctype(self.out, slot_ty(f, value.value)).try();
                self.out.add(" *)").try();
                self.place(value.base, value.offset, "").try();
                self.out.fmt(" = v{};\n", value.value)
            },
            Barrier              => self.out.add(
                "  __asm__ __volatile__(\"\" ::: \"memory\");\n"
            ),
            AtomicLoad(value)    => {
                self.out.fmt("  v{} = __atomic_load_n((", value.out).try();
                self.out.ctype(slot_ty(f, value.out)).try();
                self.out.fmt(
                    " *)(uintptr_t)(v{} + {}u), __ATOMIC_SEQ_CST);\n",
                    value.base,
                    value.offset
                )
            },
            AtomicStore(value)   => {
                self.out.add("  __atomic_store_n((").try();
                self.out.ctype(slot_ty(f, value.value)).try();
                self.out.fmt(
                    " *)(uintptr_t)(v{} + {}u), v{}, __ATOMIC_SEQ_CST);\n",
                    value.base,
                    value.offset,
                    value.value
                )
            },
            AtomicUpdate(value)  => {
                op = value.op.match({
                    Swap => "__atomic_exchange_n",
                    Add  => "__atomic_fetch_add",
                });
                self.out.fmt("  v{} = {}((", value.out, op).try();
                self.out.ctype(slot_ty(f, value.out)).try();
                self.out.fmt(
                    " *)(uintptr_t)v{}, v{}, __ATOMIC_SEQ_CST);\n",
                    value.base,
                    value.value
                )
            },
            CompareSwap(value)   => {
                ty = slot_ty(f, value.out);
                self.out.add("  {\n    ").try();
                self.out.ctype(ty).try();
                self.out.fmt(
                    " zr_e = v{};\n    __atomic_compare_exchange_n((",
                    value.expected
                ).try();
                self.out.ctype(ty).try();
                self.out.fmt(
                    " *)(uintptr_t)v{}, &zr_e, v{}, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n    v{} = zr_e;\n  }}\n",
                    value.base,
                    value.desired,
                    value.out
                )
            },
            CodeAddress(value)   => {
                self.out.fmt("  v{} = (uint64_t)(uintptr_t)&", value.out).try();
                self.callee_name(value.function).try();
                self.out.add(";\n")
            },
            InvokeAt(value)      => self.indirect(f, value),
            Foreign(value)       => self.foreign(f, value),
            NativeConst(value)   => self.native_const(f, value),
            // Outside `supports`; the driver refuses it before rendering.
            _                    => self.out.add(OUTSIDE),
        })
    }

    // A C function. Without a header it is declared under a private name
    // bound to the symbol's assembler label, so the declaration cannot
    // conflict with a header the runtime includes.
    foreign = (self :: @Self, f: Func, call: ForeignCall) Res<(), AllocError> {
        headed = call.header.len > 0;
        headed.match({
            true  => self.include(call.header).try(),
            false => self.declare_foreign(f, call).try(),
        });
        result = slot_ty(f, call.out);
        result.match({
            Unit => self.out.add("  ").try(),
            _    => {
                self.out.fmt("  v{} = (", call.out).try();
                self.out.ctype(result).try();
                self.out.add(")").try();
                same(result, Scalar.Ptr).then(() { self.out.add("(uintptr_t)").try(); });
            },
        });
        (headed && call.typed).match({
            true  => self.typed_callee(f, call).try(),
            false => headed.match({
                true  => self.out.add(call.symbol).try(),
                false => self.out.fmt("zr_ffi_{}", call.symbol).try(),
            }),
        });
        self.out.add("(").try();
        call.args.loop((h, i, slot) {
            (i > 0).then(() { self.out.add(", ").try(); });
            same(slot_ty(f, slot), Scalar.Ptr).match({
                true  => self.out.fmt("(void *)(uintptr_t)v{}", slot).try(),
                false => self.out.fmt("v{}", slot).try(),
            });
        });
        self.out.add(");\n").try();
        // A unit result is still a slot a match arm may answer with.
        same(result, Scalar.Unit).match({
            true  => self.out.fmt("  v{} = 0;\n", call.out),
            false => Ok,
        })
    }

    // `((R (*)(A, B))symbol)`: the call keeps the declared signature.
    typed_callee = (self :: @Self, f: Func, call: ForeignCall)
                   Res<(), AllocError> {
        self.out.add("((").try();
        self.c_word(slot_ty(f, call.out)).try();
        self.out.add(" (*)(").try();
        call.args.loop((h, i, slot) {
            (i > 0).then(() { self.out.add(", ").try(); });
            self.c_word(slot_ty(f, slot)).try();
        });
        (call.args.len == 0).then(() { self.out.add("void").try(); });
        self.out.fmt(")){})", call.symbol)
    }

    c_word = (self :: @Self, ty: Scalar) Res<(), AllocError> {
        ty.match({
            Unit => self.out.add("void"),
            Ptr  => self.out.add("void *"),
            _    => self.out.ctype(ty),
        })
    }

    declare_foreign = (self :: @Self, f: Func, call: ForeignCall)
                      Res<(), AllocError> {
        known = self.declared.find(
            (s) { s.eq(call.symbol) }
        ).match({ Ok(_) => true, None => false });
        known.match({
            true  => Ok,
            false => {
                self.declared.add(call.symbol).try();
                self.head.add("extern ").try();
                foreign_type(self.head, slot_ty(f, call.out)).try();
                self.head.fmt(" zr_ffi_{}(", call.symbol).try();
                (call.args.len == 0).then(() { self.head.add("void").try(); });
                call.args.loop((h, i, slot) {
                    (i > 0).then(() { self.head.add(", ").try(); });
                    foreign_type(self.head, slot_ty(f, slot)).try();
                });
                self.head.fmt(") __asm__(ZR_LABEL \"{}\");\n", call.symbol)
            },
        })
    }

    include = (self :: @Self, header: str) Res<(), AllocError> {
        known = self.included.find(
            (h) { h.eq(header) }
        ).match({ Ok(_) => true, None => false });
        known.match({
            true  => Ok,
            false => {
                self.included.add(header).try();
                self.head.fmt("#include <{}>\n", header)
            },
        })
    }

    // A header's constant, or its fallback where the header leaves it
    // undefined.
    native_const = (self :: @Self, f: Func, value: NativeValue)
                   Res<(), AllocError> {
        self.include(value.header).try();
        ty = slot_ty(f, value.out);
        value.fallback.match({
            None     => self.native_read(value.out, ty, value.name),
            Ok(bits) => {
                self.out.fmt("#ifdef {}\n", value.name).try();
                self.native_read(value.out, ty, value.name).try();
                self.out.add("#else\n").try();
                // A fallback the class cannot hold is refused by the C compiler.
                (c_min(ty).len > 0).then(() {
                    self.out.fmt(
                        "  typedef char {}_range_v{}[({}LL >= {} && {}LL <= {}) ? 1 : -1];\n",
                        value.name,
                        value.out,
                        bits,
                        c_min(ty),
                        bits,
                        c_max(ty)
                    ).try();
                });
                self.out.fmt("  v{} = (", value.out).try();
                self.out.ctype(ty).try();
                self.out.fmt(")({}LL);\n#endif\n", bits)
            },
        })
    }

    native_read = (self :: @Self, out: usize, ty: Scalar, name: str)
                  Res<(), AllocError> {
        self.out.fmt("  v{} = (", out).try();
        self.out.ctype(ty).try();
        self.out.fmt(")({});\n", name)
    }

    // `base + offset` as a byte pointer. A base whose one write takes a
    // local's address names that local, so the C compiler sees which object
    // the access reaches instead of an integer it cannot trace.
    place = (self :: @Self, base: usize, offset: usize, qualifier: str)
            Res<(), AllocError> {
        at = self.origin.get(base).value_or(0);
        (at != 0 && self.writes.get(base).value_or(0) == 1).match({
            true  => self.out.fmt(
                "(({}unsigned char *)&v{} + {}u)",
                qualifier,
                at - 1,
                offset
            ),
            false => self.out.fmt(
                "(({}unsigned char *)(uintptr_t)v{} + {}u)",
                qualifier,
                base,
                offset
            ),
        })
    }

    // A borrowed argument travels as its slot's address. A slot whose
    // address has left the frame, or that the call also writes, is copied
    // first, so the callee still reads the value it had at the call.
    invoke = (self :: @Self, f: Func, call: Invocation) Res<(), AllocError> {
        first = self.copies;
        call.args.loop((h, i, slot) {
            self.copied(call, i, slot).then(() {
                self.out.add("  ZR_U ").try();
                self.out.ctype(slot_ty(f, slot)).try();
                self.out.fmt(" zc{} = v{};\n", self.copies, slot).try();
                self.copies = self.copies + 1;
            });
        });
        copy ::= first;
        // An outward callee writes its result as it runs, so it gets the
        // destination only where no argument can reach that storage.
        outward = self.outward.get(call.function).value_or(false);
        dest    = self.root(call.out);
        direct  = dest >= f.parameters
            && self.pool.get(dest).value_or(0) == 0
            && !self.escaped.get(dest).value_or(true);
        spare   = self.copies;
        (outward && !direct).then(() {
            self.out.add("  ZR_U ").try();
            self.out.ctype(slot_ty(f, call.out)).try();
            self.out.fmt(" zc{};\n", spare).try();
            self.copies = self.copies + 1;
        });
        outward.match({
            true  => self.out.add("  "),
            false => self.out.fmt("  v{} = ", call.out),
        }).try();
        self.callee_name(call.function).try();
        self.out.add("(").try();
        outward.then(() {
            direct.match({
                true  => self.out.fmt("&v{}", call.out),
                false => self.out.fmt("&zc{}", spare),
            }).try();
        });
        call.args.loop((h, i, slot) {
            (i > 0 || outward).then(() { self.out.add(", ").try(); });
            self.copied(call, i, slot).match({
                true  => {
                    self.out.fmt("&zc{}", copy).try();
                    copy = copy + 1;
                },
                false => self.by_pointer(call.function, i).match({
                    true  => self.lent.get(slot).value_or(false).match({
                        true  => self.lend(f, slot),
                        false => self.out.fmt("&v{}", slot),
                    }),
                    false => self.out.fmt("v{}", slot),
                }).try(),
            });
        });
        self.out.add(");\n").try();
        (outward && !direct).match({
            true  => self.out.fmt("  v{} = zc{};\n", call.out, spare),
            false => Ok,
        })
    }

    copied = (self: @Self, call: Invocation, i: usize, slot: usize) bool {
        self.by_pointer(call.function, i)
            && !self.lent.get(slot).value_or(false)
            && (self.escaped.get(self.root(slot)).value_or(true)
                || self.root(slot) == self.root(call.out))
    }

    args = (self :: @Self, args: Vec<usize>) Res<(), AllocError> {
        args.loop((h, index, slot) {
            (index > 0).then(() { self.out.add(", ").try(); });
            self.out.fmt("v{}", slot).try();
        });
        Ok
    }

    // `(T)` for the class of `slot`, after `  v<slot> = `.
    assign = (self :: @Self, f: Func, slot: usize) Res<(), AllocError> {
        self.out.fmt("  v{} = (", slot).try();
        self.out.ctype(slot_ty(f, slot)).try();
        self.out.add(')')
    }

    constant = (self :: @Self, f: Func, out: usize, value: i64)
               Res<(), AllocError> {
        self.assign(f, out).try();
        slot_ty(f, out).match({
            F64  => {
                self.out.add("zr_f64((uint64_t)").try();
                self.out.literal(value).try();
                self.out.add(");\n")
            },
            F32  => {
                self.out.add("zr_f32((uint32_t)").try();
                self.out.literal(value).try();
                self.out.add(");\n")
            },
            U128 => {
                self.out.add("(zr_u128)(uint64_t)").try();
                self.out.literal(value).try();
                self.out.add(";\n")
            },
            _    => {
                self.out.literal(value).try();
                self.out.add(";\n")
            },
        })
    }

    unary = (self :: @Self, f: Func, value: Unary) Res<(), AllocError> {
        ty = slot_ty(f, value.input);
        value.op.match({
            Not => integer(ty).match({
                true  => {
                    self.assign(f, value.out).try();
                    self.out.fmt("~v{};\n", value.input)
                },
                false => self.out.fmt("  v{} = !v{};\n", value.out, value.input),
            }),
            Neg => float(ty).match({
                true  => self.out.fmt("  v{} = -v{};\n", value.out, value.input),
                false => {
                    self.out.fmt(
                        "  if (__builtin_sub_overflow(0, v{}, &v{})) ",
                        value.input,
                        value.out
                    ).try();
                    self.trap(value.span, TrapKind.Overflow)
                },
            }),
        })
    }

    binary = (self :: @Self, f: Func, value: Binary) Res<(), AllocError> {
        ty = slot_ty(f, value.left);
        value.op.match({
            Add          => self.checked(ty, value, "add", "+"),
            Sub          => self.checked(ty, value, "sub", "-"),
            Mul          => self.checked(ty, value, "mul", "*"),
            Div          => self.divide(f, ty, value, false),
            Rem          => self.divide(f, ty, value, true),
            Equal        => self.compare(ty, value, "=="),
            NotEqual     => self.compare(ty, value, "!="),
            Less         => self.compare(ty, value, "<"),
            LessEqual    => self.compare(ty, value, "<="),
            Greater      => self.compare(ty, value, ">"),
            GreaterEqual => self.compare(ty, value, ">="),
            WrapAdd      => self.wrap(f, ty, value, "+"),
            WrapSub      => self.wrap(f, ty, value, "-"),
            WrapMul      => self.wrap(f, ty, value, "*"),
            And          => self.bitwise(f, value, "&"),
            Or           => self.bitwise(f, value, "|"),
            Xor          => self.bitwise(f, value, "^"),
            Shl          => self.shift(f, ty, value, "zr_shl"),
            Shr          => self.shift(f, ty, value, "zr_shr"),
            Rotr         => self.shift(f, ty, value, "zr_rotr"),
        })
    }

    checked = (self :: @Self, ty: Scalar, value: Binary, name: str, op: str)
              Res<(), AllocError> {
        float(ty).match({
            true  => self.out.fmt(
                "  v{} = v{} {} v{};\n",
                value.out,
                value.left,
                op,
                value.right
            ),
            false => {
                self.out.fmt(
                    "  if (__builtin_{}_overflow(v{}, v{}, &v{})) ",
                    name,
                    value.left,
                    value.right,
                    value.out
                ).try();
                self.trap(value.span, TrapKind.Overflow)
            },
        })
    }

    divide = (self :: @Self, f: Func, ty: Scalar, value: Binary, rem: bool)
             Res<(), AllocError> {
        float(ty).match({
            true  => rem.match({
                true  => self.out.fmt(
                    "  v{} = fmod(v{}, v{});\n",
                    value.out,
                    value.left,
                    value.right
                ),
                false => self.out.fmt(
                    "  v{} = v{} / v{};\n",
                    value.out,
                    value.left,
                    value.right
                ),
            }),
            false => {
                self.out.fmt("  if (v{} == 0) ", value.right).try();
                self.trap(value.span, TrapKind.DivideByZero).try();
                signed(ty).then(() {
                    self.out.fmt(
                        "  if (v{} == {} && v{} == -1) ",
                        value.left,
                        min_of(ty),
                        value.right
                    ).try();
                    self.trap(value.span, TrapKind.Overflow).try();
                });
                self.assign(f, value.out).try();
                self.out.fmt(
                    "(v{} {} v{});\n",
                    value.left,
                    rem.match({ true => "%", false => "/" }),
                    value.right
                )
            },
        })
    }

    // Unit values compare equal: there is only one.
    compare = (self :: @Self, ty: Scalar, value: Binary, op: str)
              Res<(), AllocError> {
        ty.match({
            Unit => self.out.fmt(
                "  v{} = {};\n",
                value.out,
                (op == "==").match({ true => 1, false => 0 })
            ),
            _    => self.out.fmt(
                "  v{} = v{} {} v{};\n",
                value.out,
                value.left,
                op,
                value.right
            ),
        })
    }

    // Wrapping arithmetic runs on 64-bit unsigned words, so no narrow
    // operand is promoted to a signed int that could overflow.
    wrap = (self :: @Self, f: Func, ty: Scalar, value: Binary, op: str)
           Res<(), AllocError> {
        self.assign(f, value.out).try();
        wide = same(
            ty,
            Scalar.U128
        ).match({ true => "zr_u128", false => "uint64_t" });
        self.out.fmt(
            "(({})({})v{} {} ({})({})v{});\n",
            wide,
            unsigned_type(ty),
            value.left,
            op,
            wide,
            unsigned_type(slot_ty(f, value.right)),
            value.right
        )
    }

    bitwise = (self :: @Self, f: Func, value: Binary, op: str)
              Res<(), AllocError> {
        self.assign(f, value.out).try();
        self.out.fmt("(v{} {} v{});\n", value.left, op, value.right)
    }

    shift = (self :: @Self, f: Func, ty: Scalar, value: Binary, helper: str)
            Res<(), AllocError> {
        self.assign(f, value.out).try();
        same(ty, Scalar.U128).match({
            true  => self.out.fmt(
                "{}128(v{}, v{});\n",
                helper,
                value.left,
                value.right
            ),
            false => self.out.fmt(
                "{}((uint64_t)({})v{}, v{}, {}u);\n",
                helper,
                unsigned_type(ty),
                value.left,
                value.right,
                width(ty) * 8
            ),
        })
    }

    convert = (self :: @Self, f: Func, value: Convert) Res<(), AllocError> {
        slot_ty(f, value.out).match({
            Bool => self.out.fmt("  v{} = v{} != 0;\n", value.out, value.input),
            _    => {
                self.assign(f, value.out).try();
                self.out.fmt("v{};\n", value.input)
            },
        })
    }

    print = (self :: @Self, f: Func, value: Print) Res<(), AllocError> {
        fd = descriptor(value.stream);
        value.ty.match({
            Unit => self.out.fmt("  zr_text({}, \"()\", 2);\n", fd),
            Bool => self.out.fmt(
                "  zr_text({}, v{} ? \"true\" : \"false\", v{} ? 4u : 5u);\n",
                fd,
                value.value,
                value.value
            ),
            F64  => self.out.fmt("  zr_print_f({}, v{});\n", fd, value.value),
            F32  => self.out.fmt(
                "  zr_print_f({}, (double)v{});\n",
                fd,
                value.value
            ),
            _    => signed(value.ty).match({
                true  => self.out.fmt(
                    "  zr_print_i({}, (int64_t)v{});\n",
                    fd,
                    value.value
                ),
                false => self.out.fmt(
                    "  zr_print_u({}, (uint64_t)v{});\n",
                    fd,
                    value.value
                ),
            }),
        })
    }

    startup = (self :: @Self, f: Func, value: Start) Res<(), AllocError> {
        self.assign(f, value.out).try();
        value.value.match({
            Argc    => self.out.add("zr_argc;\n"),
            Argv    => self.out.add("zr_argv;\n"),
            Envp    => self.out.add("zr_envp;\n"),
            Globals => self.out.add("(uintptr_t)zr_globals;\n"),
        })
    }

    sys_const = (self :: @Self, f: Func, value: SysValue) Res<(), AllocError> {
        value.name.match({
            PthreadThreads => {
                self.assign(f, value.out).try();
                self.out.add("1;\n")
            },
            _              => {
                self.out.add("#if defined(__APPLE__)\n").try();
                self.constant(
                    f,
                    value.out,
                    constant_value(value.name, Platform.Darwin)
                ).try();
                self.out.add("#elif defined(__x86_64__)\n").try();
                self.constant(
                    f,
                    value.out,
                    constant_value(value.name, Platform.LinuxX86_64)
                ).try();
                self.out.add("#else\n").try();
                self.constant(
                    f,
                    value.out,
                    constant_value(value.name, Platform.LinuxArm64)
                ).try();
                self.out.add("#endif\n")
            },
        })
    }

    system = (self :: @Self, f: Func, call: SysCall) Res<(), AllocError> {
        call.call.match({
            ThreadSelf    => self.runtime_call(f, call, "zr_thread_self"),
            PthreadStart  => self.runtime_call(f, call, "zr_pthread_start"),
            PthreadJoin   => self.runtime_call(f, call, "zr_pthread_join"),
            MutexInit     => self.runtime_call(f, call, "zr_mutex_init"),
            MutexLock     => self.runtime_call(f, call, "zr_mutex_lock"),
            MutexUnlock   => self.runtime_call(f, call, "zr_mutex_unlock"),
            MutexDestroy  => self.runtime_call(f, call, "zr_mutex_destroy"),
            CondInit      => self.runtime_call(f, call, "zr_cond_init"),
            CondWait      => self.runtime_call(f, call, "zr_cond_wait"),
            CondSignal    => self.runtime_call(f, call, "zr_cond_signal"),
            CondBroadcast => self.runtime_call(f, call, "zr_cond_broadcast"),
            CondDestroy   => self.runtime_call(f, call, "zr_cond_destroy"),
            ThreadWordGet => self.runtime_call(f, call, "zr_word_get"),
            ThreadWordSet => self.runtime_call(f, call, "zr_word_set"),
            GuardedCall   => self.runtime_call(f, call, "zr_guarded"),
            _             => self.kernel(f, call),
        })
    }

    runtime_call = (self :: @Self, f: Func, call: SysCall, name: str)
                   Res<(), AllocError> {
        self.assign(f, call.out).try();
        self.out.fmt("{}(", name).try();
        self.word_args(call.args, "uint64_t").try();
        self.out.add(");\n")
    }

    word_args = (self :: @Self, args: Vec<usize>, cast: str)
                Res<(), AllocError> {
        args.loop((h, index, slot) {
            (index > 0).then(() { self.out.add(", ").try(); });
            self.out.fmt("({})v{}", cast, slot).try();
        });
        Ok
    }

    // A kernel call in the -errno convention: libc's `syscall` on Linux,
    // the libSystem symbol the asm backend calls on macOS.
    kernel = (self :: @Self, f: Func, call: SysCall) Res<(), AllocError> {
        self.out.add("#if defined(__APPLE__)\n").try();
        self.darwin(f, call).try();
        self.out.add("#elif defined(__x86_64__)\n").try();
        self.linux(f, call, linux_x86_64(call.call)).try();
        self.out.add("#else\n").try();
        self.linux(f, call, linux_arm64(call.call)).try();
        self.out.add("#endif\n")
    }

    linux = (self :: @Self, f: Func, call: SysCall, number: Res<usize>)
            Res<(), AllocError> {
        self.assign(f, call.out).try();
        number.match({
            Ok(n) => {
                self.out.fmt("zr_lerr(syscall({}", n).try();
                call.args.loop(
                    (slot) { self.out.fmt(", (long)v{}", slot).try(); }
                );
                self.out.add("));\n")
            },
            None  => self.out.add("-(int64_t)ENOSYS;\n"),
        })
    }

    darwin = (self :: @Self, f: Func, call: SysCall) Res<(), AllocError> {
        self.assign(f, call.out).try();
        darwin_symbol(call.call).match({
            Ok(name) => {
                self.declare(call, name).try();
                darwin_result(call.call).match({
                    Errno    => self.out.add("zr_derr((int64_t)"),
                    Returned => self.out.add("-(int64_t)"),
                    Handle   => self.out.add("(int64_t)"),
                }).try();
                self.out.fmt("zr_d_{}(", name).try();
                self.word_args(call.args, "uint64_t").try();
                darwin_result(call.call).match({
                    Errno => self.out.add("));\n"),
                    _     => self.out.add(");\n"),
                })
            },
            None     => self.out.add("-(int64_t)ENOSYS;\n"),
        })
    }

    // One declaration per libSystem symbol, named through an asm label so
    // it cannot clash with the system headers' prototypes. `openat` and
    // `ioctl` are variadic, which arm64 macOS passes on the stack.
    declare = (self :: @Self, call: SysCall, name: str) Res<(), AllocError> {
        known ::= false;
        self.symbols.loop((seen) { seen.eq(name).then(() { known = true; }); });
        known.match({
            true  => Ok,
            false => {
                self.symbols.add(name).try();
                wide  = call.call.match({
                    Read => true, Write => true, Mmap => true, Getcwd => true,
                    Sysconf => true, _ => false,
                });
                fixed = call.call.match({
                    Openat => 3,
                    Ioctl  => 2,
                    _      => call.args.len,
                });
                result :: str = wide.match({ true => "int64_t", false => "int" });
                self.head.fmt(
                    "#if defined(__APPLE__)\nextern {} zr_d_{}(",
                    result,
                    name
                ).try();
                (fixed == 0).then(() { self.head.add("void").try(); });
                Range(0, fixed).loop((i) {
                    (i > 0).then(() { self.head.add(", ").try(); });
                    self.head.add("uint64_t").try();
                });
                (fixed < call.args.len).then(
                    () { self.head.add(", ...").try(); }
                );
                self.head.fmt(") __asm__(\"_{}\");\n#endif\n", name)
            },
        })
    }

    indirect = (self :: @Self, f: Func, call: IndirectCall)
               Res<(), AllocError> {
        self.out.fmt("  v{} = ((", call.out).try();
        self.out.ctype(slot_ty(f, call.out)).try();
        self.out.add(" (*)(").try();
        (call.args.len == 0).then(() { self.out.add("void").try(); });
        call.args.loop((h, index, slot) {
            (index > 0).then(() { self.out.add(", ").try(); });
            self.out.ctype(slot_ty(f, slot)).try();
        });
        self.out.fmt("))(uintptr_t)v{})(", call.target).try();
        self.args(call.args).try();
        self.out.add(");\n")
    }
}

// The C limits of an integer class; empty for a class with no check.
c_min = (ty: Scalar) str {
    ty.match({
        I8  => "INT8_MIN",
        I16 => "INT16_MIN",
        I32 => "INT32_MIN",
        I64 => "INT64_MIN",
        U8  => "0",
        U16 => "0",
        U32 => "0",
        U64 => "0",
        _   => "",
    })
}

c_max = (ty: Scalar) str {
    ty.match({
        I8  => "INT8_MAX",
        I16 => "INT16_MAX",
        I32 => "INT32_MAX",
        I64 => "INT64_MAX",
        U8  => "UINT8_MAX",
        U16 => "UINT16_MAX",
        U32 => "UINT32_MAX",
        U64 => "UINT64_MAX",
        _   => "",
    })
}

slot_ty = (f: Func, slot: usize) Scalar {
    f.slots.get(slot).value_or(Scalar.Unit)
}

is_block = (ty: Scalar) bool { ty.match({ Block(_) => true, _ => false }) }

// Larger than the two words a C ABI passes in registers.
large = (ty: Scalar) bool { ty.match({ Block(l) => l.size > 16, _ => false }) }

at_least_one = (n: usize) usize { (n == 0).match({ true => 1, false => n }) }

descriptor = (stream: Stream) usize {
    stream.match({ Out => 1, Err => 2 })
}

ctype = (out :: String, ty: Scalar) Res<(), AllocError> {
    ty.match({
        Block(l) => out.fmt("zb{}_{}", l.size, l.align),
        I32      => out.add("int32_t"),
        I8       => out.add("int8_t"),
        I16      => out.add("int16_t"),
        I64      => out.add("int64_t"),
        U16      => out.add("uint16_t"),
        U32      => out.add("uint32_t"),
        U64      => out.add("uint64_t"),
        U128     => out.add("zr_u128"),
        Ptr      => out.add("uint64_t"),
        F32      => out.add("float"),
        F64      => out.add("double"),
        _        => out.add("uint8_t"),
    })
}

// A C prototype's spelling of a slot class: pointers are `void *`.
foreign_type = (out :: String, ty: Scalar) Res<(), AllocError> {
    ty.match({
        Unit => out.add("void"),
        Ptr  => out.add("void *"),
        _    => out.ctype(ty),
    })
}

unsigned_type = (ty: Scalar) str {
    w = width(ty);
    (w == 1).match({
        true  => "uint8_t",
        false => (w == 2).match({
            true  => "uint16_t",
            false => (w == 4).match({
                true  => "uint32_t",
                false => (w == 16).match({ true => "zr_u128", false => "uint64_t" }),
            }),
        }),
    })
}

min_of = (ty: Scalar) str {
    ty.match({
        I8  => "INT8_MIN",
        I16 => "INT16_MIN",
        I32 => "INT32_MIN",
        _   => "INT64_MIN",
    })
}

// An i64 literal; the most negative value has no positive spelling.
literal = (out :: String, value: i64) Res<(), AllocError> {
    (value < -9223372036854775807).match({
        true  => out.add("INT64_MIN"),
        false => out.fmt("INT64_C({})", value),
    })
}

// Printable ASCII stays as is; every other byte, and `"`, `\` and `?`
// (trigraphs), becomes a three-digit octal escape, which cannot run into
// the byte after it. Explicit lengths preserve embedded NUL and invalid
// UTF-8.
bytes = (out :: String, text: str) Res<(), AllocError> {
    out.add('"').try();
    text.loop((byte) {
        plain = byte >= 32 && byte < 127 && byte != 34 && byte != 92 && byte != 63;
        plain.match({
            true  => out.add(byte).try(),
            false => out.fmt(
                "\\{}{}{}",
                byte / 64,
                byte / 8 % 8,
                byte % 8
            ).try(),
        });
    });
    out.add('"')
}

OUTSIDE: str = "  #error native-surface IR\n"

// The C runtime every rendered program starts with. Helpers are static
// inline so a program that does not use one compiles without warnings.
runtime = (out :: String) Res<(), AllocError> {
    out.add("#define _GNU_SOURCE\n").try();
    out.add("#include <stdint.h>\n").try();
    out.add("#include <inttypes.h>\n").try();
    out.add("#include <stddef.h>\n").try();
    out.add("#include <string.h>\n").try();
    out.add("#include <stdio.h>\n").try();
    out.add("#include <math.h>\n").try();
    out.add("#include <errno.h>\n").try();
    out.add("#include <unistd.h>\n").try();
    out.add("#include <setjmp.h>\n").try();
    out.add("#include <pthread.h>\n").try();
    out.add("#include <sys/mman.h>\n").try();
    out.add("#if defined(__linux__)\n").try();
    out.add("#include <sys/syscall.h>\n").try();
    out.add("#endif\n").try();
    out.add("#define ZR_U __attribute__((unused))\n").try();
    out.add(
        "#define ZR_STR2(x) #x\n#define ZR_STR(x) ZR_STR2(x)\n#define ZR_LABEL ZR_STR(__USER_LABEL_PREFIX__)\n"
    ).try();
    out.add(
        "#if defined(__SANITIZE_ADDRESS__)\n#define ZR_ASAN 1\n#elif defined(__has_feature)\n#if __has_feature(address_sanitizer)\n#define ZR_ASAN 1\n#endif\n#endif\n"
    ).try();
    // Scalar loads and stores through an address use these may_alias,
    // byte-aligned spellings: a plain move even unoptimized, and still
    // defined under strict aliasing. GCC ignores may_alias on a typedef of
    // an already defined struct, so blocks keep memcpy.
    out.add("__extension__ typedef unsigned __int128 zr_u128;\n").try();
    ["int8_t", "uint8_t", "int16_t", "uint16_t", "int32_t", "uint32_t", "int64_t", "uint64_t", "zr_u128", "float", "double"].loop((name) {
        out.fmt(
            "typedef {} __attribute__((may_alias, aligned(1))) za_{};\n",
            name,
            name
        ).try();
    });
    out.add(
        "#ifdef __OPTIMIZE__\n#define ZR_Z = 0\n#else\n#define ZR_Z\n#endif\n"
    ).try();
    out.add("static uint64_t zr_argc, zr_argv, zr_envp;\n").try();
    out.add(
        "static uint64_t zr_globals[32] __attribute__((aligned(16)));\n"
    ).try();
    out.add("static unsigned char zr_out_buf[65536];\n").try();
    out.add("static size_t zr_out_len;\n").try();
    out.add(
        "static pthread_mutex_t zr_out_lock = PTHREAD_MUTEX_INITIALIZER;\n"
    ).try();
    out.add("static __thread uint64_t zr_word;\n").try();
    out.add("static __thread jmp_buf *zr_guard;\n").try();
    out.add(
        "static inline ZR_U void zr_write_all(int fd, const unsigned char *p, size_t n) {\n"
    ).try();
    out.add("  while (n > 0) {\n").try();
    out.add("    ssize_t w = write(fd, p, n);\n").try();
    out.add("    if (w < 0 && errno == EINTR) continue;\n").try();
    out.add("    if (w <= 0) return;\n").try();
    out.add("    p += w; n -= (size_t)w;\n").try();
    out.add("  }\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U void zr_flush_held(void) { zr_write_all(1, zr_out_buf, zr_out_len); zr_out_len = 0; }\n"
    ).try();
    out.add(
        "static inline ZR_U void zr_flush(void) { pthread_mutex_lock(&zr_out_lock); zr_flush_held(); pthread_mutex_unlock(&zr_out_lock); }\n"
    ).try();
    out.add(
        "static inline ZR_U void zr_write(int fd, uint64_t data, uint64_t len) {\n"
    ).try();
    out.add(
        "  const unsigned char *p = (const unsigned char *)(uintptr_t)data;\n"
    ).try();
    out.add(
        "  if (fd != 1) { zr_write_all(fd, p, (size_t)len); return; }\n"
    ).try();
    out.add("  pthread_mutex_lock(&zr_out_lock);\n").try();
    out.add(
        "  if (zr_out_len + len > sizeof zr_out_buf) zr_flush_held();\n"
    ).try();
    out.add(
        "  if (len > sizeof zr_out_buf) zr_write_all(1, p, (size_t)len);\n"
    ).try();
    out.add(
        "  else { memcpy(zr_out_buf + zr_out_len, p, (size_t)len); zr_out_len += (size_t)len; }\n"
    ).try();
    out.add("  pthread_mutex_unlock(&zr_out_lock);\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U void zr_text(int fd, const char *s, size_t n) { zr_write(fd, (uint64_t)(uintptr_t)s, n); }\n"
    ).try();
    out.add(
        "static inline ZR_U void zr_print_i(int fd, int64_t v) { char b[32]; int n = snprintf(b, sizeof b, \"%\" PRId64, v); zr_text(fd, b, (size_t)n); }\n"
    ).try();
    out.add(
        "static inline ZR_U void zr_print_u(int fd, uint64_t v) { char b[32]; int n = snprintf(b, sizeof b, \"%\" PRIu64, v); zr_text(fd, b, (size_t)n); }\n"
    ).try();
    out.add(
        "static inline ZR_U ZR_U void zr_print_f(int fd, double v) {\n"
    ).try();
    out.add("  char b[64];\n").try();
    out.add("  if (isnan(v)) { zr_text(fd, \"nan\", 3); return; }\n").try();
    out.add(
        "  if (isinf(v)) { zr_text(fd, v < 0 ? \"-inf\" : \"inf\", v < 0 ? 4u : 3u); return; }\n"
    ).try();
    out.add("  int n = snprintf(b, sizeof b, \"%g\", v);\n").try();
    out.add("  zr_text(fd, b, (size_t)n);\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U uint64_t zr_ftext(char *b, double v) {\n"
    ).try();
    out.add("  if (isnan(v)) { memcpy(b, \"nan\", 3); return 3; }\n").try();
    out.add(
        "  if (isinf(v)) { memcpy(b, v < 0 ? \"-inf\" : \"inf\", v < 0 ? 4u : 3u); return v < 0 ? 4u : 3u; }\n"
    ).try();
    out.add("  char t[32];\n").try();
    out.add("  int n = snprintf(t, sizeof t, \"%g\", v);\n").try();
    out.add("  memcpy(b, t, (size_t)n);\n").try();
    out.add("  return (uint64_t)n;\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U __attribute__((noreturn)) void zr_trap(const char *where, size_t n) {\n"
    ).try();
    out.add("  zr_flush();\n").try();
    out.add("  zr_write_all(2, (const unsigned char *)where, n);\n").try();
    out.add("  if (zr_guard) longjmp(*zr_guard, 1);\n").try();
    out.add("  _exit(134);\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U __attribute__((noreturn)) void zr_exit(int status) {\n"
    ).try();
    out.add(
        "  if (zr_globals[0]) ((void (*)(void))(uintptr_t)zr_globals[0])();\n"
    ).try();
    out.add("  zr_flush();\n").try();
    out.add("  _exit(status);\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U ZR_U uint64_t zr_map(uint64_t bytes) {\n"
    ).try();
    out.add("  if (bytes > SIZE_MAX - 16) return 0;\n").try();
    out.add(
        "  void *p = mmap(0, (size_t)bytes + 16, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\n"
    ).try();
    out.add("  if (p == MAP_FAILED) return 0;\n").try();
    out.add("  *(uint64_t *)p = bytes + 16;\n").try();
    out.add("  return (uint64_t)(uintptr_t)p + 16;\n").try();
    out.add("}\n").try();
    out.add("static inline ZR_U ZR_U void zr_unmap(uint64_t at) {\n").try();
    out.add("  if (!at) return;\n").try();
    out.add("  void *p = (void *)(uintptr_t)(at - 16);\n").try();
    out.add("  munmap(p, (size_t)*(uint64_t *)p);\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U int64_t zr_lerr(long r) { return r == -1 ? -(int64_t)errno : (int64_t)r; }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_derr(int64_t r) { return r == -1 ? -(int64_t)errno : r; }\n"
    ).try();
    out.add(
        "static inline ZR_U double zr_f64(uint64_t bits) { double d; memcpy(&d, &bits, sizeof d); return d; }\n"
    ).try();
    out.add(
        "static inline ZR_U float zr_f32(uint32_t bits) { float d; memcpy(&d, &bits, sizeof d); return d; }\n"
    ).try();
    out.add(
        "static inline ZR_U zr_u128 zr_shl128(zr_u128 a, uint64_t c) { return c >= 128 ? 0 : a << c; }\n"
    ).try();
    out.add(
        "static inline ZR_U zr_u128 zr_shr128(zr_u128 a, uint64_t c) { return c >= 128 ? 0 : a >> c; }\n"
    ).try();
    out.add(
        "static inline ZR_U zr_u128 zr_rotr128(zr_u128 a, uint64_t c) { c %= 128; return c == 0 ? a : (a >> c) | (a << (128 - c)); }\n"
    ).try();
    out.add(
        "static inline ZR_U uint64_t zr_shl(uint64_t a, uint64_t c, unsigned bits) { return c >= bits ? 0 : a << c; }\n"
    ).try();
    out.add(
        "static inline ZR_U uint64_t zr_shr(uint64_t a, uint64_t c, unsigned bits) { return c >= bits ? 0 : a >> c; }\n"
    ).try();
    out.add(
        "static inline ZR_U uint64_t zr_rotr(uint64_t a, uint64_t c, unsigned bits) {\n"
    ).try();
    out.add("  c %= bits;\n").try();
    out.add("  if (c == 0) return a;\n").try();
    out.add("  return (a >> c) | (a << (bits - c));\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U ZR_U void *zr_thread_main(void *block) {\n"
    ).try();
    out.add("  uint64_t *w = block;\n").try();
    out.add("  ((void (*)(uint64_t))(uintptr_t)w[1])(w[2]);\n").try();
    out.add("  return 0;\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U int64_t zr_thread_self(void) { pthread_t t = pthread_self(); uint64_t w = 0; memcpy(&w, &t, sizeof t); return (int64_t)w; }\n"
    ).try();
    out.add(
        "static inline ZR_U ZR_U int64_t zr_pthread_start(uint64_t block) {\n"
    ).try();
    out.add("  pthread_t t;\n").try();
    out.add(
        "  int r = pthread_create(&t, 0, zr_thread_main, (void *)(uintptr_t)block);\n"
    ).try();
    out.add("  if (r) return -(int64_t)r;\n").try();
    out.add(
        "  memcpy((unsigned char *)(uintptr_t)block + 32, &t, sizeof t);\n"
    ).try();
    out.add("  return 0;\n").try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U int64_t zr_pthread_join(uint64_t thread, uint64_t result) {\n"
    ).try();
    out.add("  pthread_t t; memcpy(&t, &thread, sizeof t);\n").try();
    out.add(
        "  return -(int64_t)pthread_join(t, (void **)(uintptr_t)result);\n"
    ).try();
    out.add("}\n").try();
    out.add(
        "static inline ZR_U int64_t zr_mutex_init(uint64_t m, uint64_t a) { return -(int64_t)pthread_mutex_init((pthread_mutex_t *)(uintptr_t)m, (const pthread_mutexattr_t *)(uintptr_t)a); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_mutex_lock(uint64_t m) { return -(int64_t)pthread_mutex_lock((pthread_mutex_t *)(uintptr_t)m); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_mutex_unlock(uint64_t m) { return -(int64_t)pthread_mutex_unlock((pthread_mutex_t *)(uintptr_t)m); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_mutex_destroy(uint64_t m) { return -(int64_t)pthread_mutex_destroy((pthread_mutex_t *)(uintptr_t)m); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_cond_init(uint64_t c, uint64_t a) { return -(int64_t)pthread_cond_init((pthread_cond_t *)(uintptr_t)c, (const pthread_condattr_t *)(uintptr_t)a); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_cond_wait(uint64_t c, uint64_t m) { return -(int64_t)pthread_cond_wait((pthread_cond_t *)(uintptr_t)c, (pthread_mutex_t *)(uintptr_t)m); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_cond_signal(uint64_t c) { return -(int64_t)pthread_cond_signal((pthread_cond_t *)(uintptr_t)c); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_cond_broadcast(uint64_t c) { return -(int64_t)pthread_cond_broadcast((pthread_cond_t *)(uintptr_t)c); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_cond_destroy(uint64_t c) { return -(int64_t)pthread_cond_destroy((pthread_cond_t *)(uintptr_t)c); }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_word_get(void) { return (int64_t)zr_word; }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_word_set(uint64_t value) { zr_word = value; return 0; }\n"
    ).try();
    out.add(
        "static inline ZR_U int64_t zr_guarded(uint64_t code, uint64_t first, uint64_t second) {\n"
    ).try();
    out.add("  jmp_buf here;\n").try();
    out.add("  jmp_buf *volatile outer = zr_guard;\n").try();
    out.add("  if (setjmp(here)) { zr_guard = outer; return 1; }\n").try();
    out.add("  zr_guard = &here;\n").try();
    out.add(
        "  ((void (*)(uint64_t, uint64_t))(uintptr_t)code)(first, second);\n"
    ).try();
    out.add("  zr_guard = outer;\n").try();
    out.add("  return 0;\n").try();
    out.add("}\n").try();
    Ok
}

// Every slot an instruction names, and whether it reads that slot.
mentions = (instruction: Instruction, visit: (slot: usize, read: bool) ()) {
    instruction.match({
        Constant(v)      => visit(v.out, false),
        Copy(v)          => {
            visit(v.out, false);
            visit(v.source, true);
        },
        UnaryValue(v)    => {
            visit(v.out, false);
            visit(v.input, true);
        },
        BinaryValue(v)   => {
            visit(v.out, false);
            visit(v.left, true);
            visit(v.right, true);
        },
        Invoke(v)        => {
            visit(v.out, false);
            v.args.loop((slot) { visit(slot, true); });
        },
        PrintValue(v)    => visit(v.value, true),
        Text(_)          => (),
        Cast(v)          => {
            visit(v.out, false);
            visit(v.input, true);
        },
        AddressOf(v)     => {
            visit(v.out, false);
            visit(v.slot, false);
        },
        LoadValue(v)     => {
            visit(v.out, false);
            visit(v.base, true);
        },
        StoreValue(v)    => {
            visit(v.base, true);
            visit(v.value, true);
        },
        CopyBytes(v)     => {
            visit(v.dest, true);
            visit(v.source, true);
            visit(v.bytes, true);
        },
        Bytes(v)         => visit(v.out, false),
        WriteOut(v)      => {
            visit(v.data, true);
            visit(v.len, true);
        },
        System(v)        => {
            visit(v.out, false);
            v.args.loop((slot) { visit(slot, true); });
        },
        Startup(v)       => visit(v.out, false),
        MapPages(v)      => {
            visit(v.out, false);
            visit(v.bytes, true);
        },
        UnmapPages(s)    => visit(s, true),
        SysConst(v)      => visit(v.out, false),
        Flush            => (),
        FormatFloat(v)   => {
            visit(v.out, false);
            visit(v.dest, true);
            visit(v.value, true);
        },
        Machine(v)       => {
            v.outs.loop((slot) { visit(slot, false); });
            v.args.loop((slot) { visit(slot, true); });
        },
        Host(v)          => {
            visit(v.out, false);
            v.args.loop((slot) { visit(slot, true); });
        },
        Foreign(v)       => {
            visit(v.out, false);
            v.args.loop((slot) { visit(slot, true); });
        },
        NativeConst(v)   => visit(v.out, false),
        Wait(s)          => visit(s, false),
        VolatileLoad(v)  => {
            visit(v.out, false);
            visit(v.base, true);
        },
        VolatileStore(v) => {
            visit(v.base, true);
            visit(v.value, true);
        },
        Barrier          => (),
        AtomicLoad(v)    => {
            visit(v.out, false);
            visit(v.base, true);
        },
        AtomicStore(v)   => {
            visit(v.base, true);
            visit(v.value, true);
        },
        AtomicUpdate(v)  => {
            visit(v.out, false);
            visit(v.base, true);
            visit(v.value, true);
        },
        CompareSwap(v)   => {
            visit(v.out, false);
            visit(v.base, true);
            visit(v.expected, true);
            visit(v.desired, true);
        },
        CodeAddress(v)   => visit(v.out, false),
        InvokeAt(v)      => {
            visit(v.out, false);
            visit(v.target, true);
            v.args.loop((slot) { visit(slot, true); });
        },
    })
}

// A named write replaces the whole value; taking an address and writing
// through one change nothing or only part of it.
replaces = (instruction: Instruction) bool {
    instruction.match({ AddressOf(_) => false, _ => true })
}

exit_value = (exit: Terminator) Res<usize> {
    exit.match({
        Return(slot)   => Ok(slot),
        Branch(branch) => Ok(branch.value),
        _              => None,
    })
}

// Bytes above which a block local may share storage.
SHARED_FROM: usize = 64

// Bytes of such locals below which a function keeps them all apart.
SHARED_FRAME: usize = 8192

// Bytes of block locals above which a function is never inlined.
HEAVY_FRAME: usize = 2048

heavy = (f: Func) bool {
    bytes :: usize = 0;
    Range(f.parameters, f.slots.len).loop((s) {
        bytes = bytes + block_size(slot_ty(f, s));
    });
    bytes > HEAVY_FRAME
}

block_size = (ty: Scalar) usize { ty.match({ Block(l) => l.size, _ => 0 }) }

returns = (f: Func, exit: Terminator, slot: usize) bool {
    exit.match({
        Return(value) => value == slot,
        Jump(to)      => f.blocks.get(to).match({
            Ok(next) => next.code.len == 0
                && next.exit.match({
                    Return(value) => value == slot,
                    _             => false,
                }),
            None     => false,
        }),
        _             => false,
    })
}

alike = (a: Scalar, b: Scalar) bool {
    a.match({
        Block(x) => b.match({
            Block(y) => x.size == y.size && x.align == y.align,
            _        => false,
        }),
        _        => class_of(a) == class_of(b),
    })
}

class_of = (ty: Scalar) usize {
    ty.match({
        I32      => 0,
        Bool     => 1,
        Unit     => 2,
        I8       => 3,
        U8       => 4,
        I16      => 5,
        U16      => 6,
        U32      => 7,
        I64      => 8,
        U64      => 9,
        Ptr      => 10,
        F64      => 11,
        Block(_) => 12,
        U128     => 13,
        F32      => 14,
    })
}

// The parameter's gen_c name, or "" for the renderer's own.
param_name = (function: Func, i: usize) str {
    function.locals.match({ Ok(names) => names.get(i).value_or(""), None => "" })
}
