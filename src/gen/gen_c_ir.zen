// C rendering of the one IR, for the part `supports` declares: i32, bool and
// unit values, checked i32 arithmetic, calls, standard output and traps. The
// caller verifies the program and checks `supports` before rendering; this
// experimental path does not define Zen's foreign or aggregate ABI.
{ Alloc, AllocError } = std.mem
{ String, str } = std.text
{ Vec } = std.collections
{ Res, Ok, Range } = std.core
{ Span } = std.source
{ Program, Func, Instruction, Terminator, Unary, Binary, Invocation, Print } = gen.gen_ir
{ trap_message } = gen.gen_ir
{ IrFeature } = gen.gen_ir_feature
{ simplify } = gen.gen_asm_regalloc
{ reachable_only, ordered } = gen.gen_asm_prepare
{ reads, written, exit_read } = gen.gen_asm_flow

supports* = (feature: IrFeature) bool {
    feature.match({ Traps => true, _ => false })
}

// Each function is first cleaned up by the passes the native renderers use:
// unreachable blocks dropped, copies propagated, unread pure values removed,
// and blocks ordered so most jumps fall through.
emit_c* = (a: Alloc, program: Program) Res<String, AllocError> {
    writer ::= C(
        out: a.String().try(),
        location: a.String().try(),
        labels: a.Vec<bool>(),
        read: a.Vec<bool>(),
        declared: a.Vec<bool>(),
        operands: a.Vec<usize>()
    );
    simple ::= a.Vec<Func>();
    program.functions.loop((function) {
        simple.add(
            ordered(
                a,
                simplify(a, reachable_only(a, function).try()).try()
            ).try()
        ).try();
    });
    writer.program(Program(functions: simple, entry: program.entry)).try();
    Ok(writer.out)
}

C = {
    out :: String,
    location :: String,
    labels :: Vec<bool>,
    // Per slot of the function being rendered: whether anything reads it,
    // and whether it needs a declaration (read or written).
    read :: Vec<bool>,
    declared :: Vec<bool>,
    operands :: Vec<usize>,

    program = (self :: @Self, program: Program) Res<(), AllocError> {
        self.out.runtime().try();
        program.functions.loop((h, index, function) {
            self.signature(index, function).try();
            self.out.add(";\n").try();
        });
        program.functions.loop((h, index, function) {
            self.function(index, function).try();
        });
        self.out.fmt(
            "int main(void) {{ return (int)(zg_ir_f{}() & 255); }}\n",
            program.entry
        )
    }

    // All three scalar types have a private i32 carrier in this renderer.
    // Unit arguments still evaluate and occupy their ordered signature slots.
    signature = (self :: @Self, index: usize, function: Func) Res<(), AllocError> {
        self.out.fmt("int32_t zg_ir_f{}(", index).try();
        (function.parameters == 0).then(() { self.out.add("void").try(); });
        Range(0, function.parameters).loop((i) {
            (i > 0).then(() { self.out.add(", ").try(); });
            self.out.fmt("int32_t v{}", i).try();
        });
        self.out.add(')')
    }

    function = (self :: @Self, index: usize, function: Func) Res<(), AllocError> {
        self.signature(index, function).try();
        self.out.add(" {\n").try();
        self.slot_uses(function).try();
        Range(function.parameters, function.slots.len).loop((i) {
            self.declared.get(i).value_or(false).then(() {
                self.out.fmt("  int32_t v{};\n", i).try();
            });
        });
        Range(0, function.parameters).loop((i) {
            (!self.read.get(i).value_or(false)).then(() {
                self.out.fmt("  (void)v{};\n", i).try();
            });
        });
        self.labels.clear();
        function.blocks.loop((_) { self.labels.add(false).try(); });
        function.blocks.loop((h, b, block) {
            block.exit.match({
                Jump(to)       => {
                    (to != b + 1).then(() { self.labels.set(to, true); });
                },
                Branch(branch) => {
                    (branch.yes != b + 1).then(
                        () { self.labels.set(branch.yes, true); }
                    );
                    (branch.no != b + 1 || branch.yes == b + 1).then(
                        () { self.labels.set(branch.no, true); }
                    );
                },
                _              => (),
            });
        });
        function.blocks.loop((h, block_id, block) {
            self.labels.get(block_id).value_or(false).then(() {
                self.out.fmt("b{}:\n", block_id).try();
            });
            block.code.loop(
                (instruction) { self.instruction(instruction).try(); }
            );
            self.terminator(block.exit, block_id + 1).try();
        });
        self.out.add("}\n")
    }

    slot_uses = (self :: @Self, function: Func) Res<(), AllocError> {
        self.read.clear();
        self.declared.clear();
        function.slots.loop((_) {
            self.read.add(false).try();
            self.declared.add(false).try();
        });
        function.blocks.loop((block) {
            block.code.loop((instruction) {
                self.operands.clear();
                reads(instruction, self.operands).try();
                self.operands.loop((slot) {
                    self.read.set(slot, true);
                    self.declared.set(slot, true);
                });
            });
            exit_read(block.exit).when_ok((slot) {
                self.read.set(slot, true);
                self.declared.set(slot, true);
            });
        });
        Ok
    }

    unread = (self :: @Self, slot: usize) bool {
        !self.read.get(slot).value_or(false)
    }

    // The left side for a value written to `slot`: an assignment, or a
    // discarded expression statement when nothing reads the slot.
    target = (self :: @Self, slot: usize) Res<(), AllocError> {
        self.read.get(slot).value_or(false).match({
            true  => self.out.fmt("  v{} = ", slot),
            false => self.out.add("  (void)"),
        })
    }

    // `next` is the block rendered after this one; a jump to it falls through.
    terminator = (self :: @Self, exit: Terminator, next: usize)
                 Res<(), AllocError> {
        exit.match({
            Return(value)  => self.out.fmt("  return v{};\n", value),
            Jump(to)       => (to == next).match({
                true  => Ok,
                false => self.out.fmt("  goto b{};\n", to),
            }),
            Branch(branch) => (branch.no == next && branch.yes != next).match({
                true  => self.out.fmt(
                    "  if (v{}) goto b{};\n",
                    branch.value,
                    branch.yes
                ),
                false => (branch.yes == next).match({
                    true  => self.out.fmt(
                        "  if (!v{}) goto b{};\n",
                        branch.value,
                        branch.no
                    ),
                    false => self.out.fmt(
                        "  if (v{}) goto b{}; else goto b{};\n",
                        branch.value,
                        branch.yes,
                        branch.no
                    ),
                }),
            }),
            Trap(fault)    => {
                self.out.add("  zg_ir_trap(").try();
                self.position(fault.span).try();
                self.out.fmt(", \"{}\");\n", trap_message(fault.what))
            },
        })
    }

    instruction = (self :: @Self, instruction: Instruction) Res<(), AllocError> {
        instruction.match({
            Constant(value)    => self.unread(value.out).match({
                true  => Ok,
                false => self.out.fmt("  v{} = {};\n", value.out, value.value),
            }),
            Copy(value)        => self.unread(value.out).match({
                true  => Ok,
                false => self.out.fmt("  v{} = v{};\n", value.out, value.source),
            }),
            UnaryValue(value)  => self.unary(value),
            BinaryValue(value) => self.binary(value),
            Invoke(value)      => self.call(value),
            PrintValue(value)  => self.print(value),
            Text(text)         => {
                self.out.add("  fwrite(").try();
                self.out.bytes(text).try();
                self.out.fmt(", 1, {}, stdout);\n", text.len)
            },
            // Outside `supports`; the driver refuses it before rendering.
            _                  => self.out.add(OUTSIDE),
        })
    }

    position = (self :: @Self, span: Span) Res<(), AllocError> {
        self.location.clear();
        self.location.fmt(
            "{}:{}:{}: ",
            span.file,
            span.start.line,
            span.start.col
        ).try();
        self.out.bytes(self.location.view())
    }

    unary = (self :: @Self, value: Unary) Res<(), AllocError> {
        value.op.match({
            Not => self.unread(value.out).match({
                true  => Ok,
                false => self.out.fmt("  v{} = !v{};\n", value.out, value.input),
            }),
            Neg => {
                self.target(value.out).try();
                self.out.fmt("zg_ir_i32(-(int64_t)v{}, ", value.input).try();
                self.position(value.span).try();
                self.out.add(");\n")
            },
        })
    }

    binary = (self :: @Self, value: Binary) Res<(), AllocError> {
        self.target(value.out).try();
        value.op.match({
            Add          => self.out.fmt(
                "zg_ir_i32((int64_t)v{} + v{}",
                value.left,
                value.right
            ),
            Sub          => self.out.fmt(
                "zg_ir_i32((int64_t)v{} - v{}",
                value.left,
                value.right
            ),
            Mul          => self.out.fmt(
                "zg_ir_i32((int64_t)v{} * v{}",
                value.left,
                value.right
            ),
            Div          => self.out.fmt(
                "zg_ir_div(v{}, v{}",
                value.left,
                value.right
            ),
            Rem          => self.out.fmt(
                "zg_ir_rem(v{}, v{}",
                value.left,
                value.right
            ),
            Equal        => self.out.fmt("v{} == v{}", value.left, value.right),
            NotEqual     => self.out.fmt("v{} != v{}", value.left, value.right),
            Less         => self.out.fmt("v{} < v{}", value.left, value.right),
            LessEqual    => self.out.fmt("v{} <= v{}", value.left, value.right),
            Greater      => self.out.fmt("v{} > v{}", value.left, value.right),
            GreaterEqual => self.out.fmt("v{} >= v{}", value.left, value.right),
            _            => self.out.add("zg_outside("),
        }).try();
        checked = value.op.match({ Add => true, Sub => true, Mul => true, Div => true, Rem => true, _ => false });
        checked.then(() {
            self.out.add(", ").try();
            self.position(value.span).try();
            self.out.add(')').try();
        });
        self.out.add(";\n")
    }

    call = (self :: @Self, call: Invocation) Res<(), AllocError> {
        self.target(call.out).try();
        self.out.fmt("zg_ir_f{}(", call.function).try();
        call.args.loop((h, index, slot) {
            (index > 0).then(() { self.out.add(", ").try(); });
            self.out.fmt("v{}", slot).try();
        });
        self.out.add(");\n")
    }

    print = (self :: @Self, value: Print) Res<(), AllocError> {
        value.ty.match({
            I32  => self.out.fmt("  printf(\"%\" PRId32, v{});\n", value.value),
            Bool => self.out.fmt(
                "  fputs(v{} != 0 ? \"true\" : \"false\", stdout);\n",
                value.value
            ),
            Unit => self.out.add("  fputs(\"()\", stdout);\n"),
            _    => self.out.add(OUTSIDE),
        })
    }
}

// Printable ASCII stays as is; every other byte, and `"`, `\` and `?`
// (trigraphs), becomes a three-digit octal escape, which cannot run into
// the byte after it. Explicit fwrite lengths preserve embedded NUL and
// invalid UTF-8.
bytes = (out :: String, text: str) Res<(), AllocError> {
    out.add('"').try();
    text.loop((byte) {
        plain = byte >= 32 && byte < 127 && byte != 34 && byte != 92 && byte != 63;
        plain.match({
            true  => out.add(byte).try(),
            false => out.fmt(
                "\\{}{}{}",
                byte / 64,
                byte / 8 % 8,
                byte % 8
            ).try(),
        });
    });
    out.add('"')
}

OUTSIDE: str = "  #error native-surface IR\n"

runtime = (out :: String) Res<(), AllocError> {
    out.add(
        "#include <stdint.h>\n#include <inttypes.h>\n#include <stdio.h>\n#include <stdlib.h>\n"
    ).try();
    out.add(
        "static inline _Noreturn void zg_ir_trap(const char *where, const char *message) {\n"
    ).try();
    out.add(
        "  fflush(stdout); fputs(where, stderr); fputs(\"trap: \", stderr); fputs(message, stderr); fputc('\\n', stderr); exit(134);\n}\n"
    ).try();
    out.add(
        "static inline int32_t zg_ir_i32(int64_t value, const char *where) {\n"
    ).try();
    out.add(
        "  if (value < INT32_MIN || value > INT32_MAX) zg_ir_trap(where, \"integer overflow\");\n  return (int32_t)value;\n}\n"
    ).try();
    out.add(
        "static inline void zg_ir_divisor(int32_t left, int32_t right, const char *where) {\n"
    ).try();
    out.add(
        "  if (right == 0) zg_ir_trap(where, \"divide by zero\");\n  if (left == INT32_MIN && right == -1) zg_ir_trap(where, \"integer overflow\");\n}\n"
    ).try();
    out.add(
        "static inline int32_t zg_ir_div(int32_t left, int32_t right, const char *where) { zg_ir_divisor(left, right, where); return left / right; }\n"
    ).try();
    out.add(
        "static inline int32_t zg_ir_rem(int32_t left, int32_t right, const char *where) { zg_ir_divisor(left, right, where); return left % right; }\n"
    )
}
