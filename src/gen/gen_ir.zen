// The one executable IR: gen_lower produces it, gen_verify checks it, and
// every renderer (C, JavaScript, assembly) consumes it with a Target.
// The caller owns every vector and text buffer. Renderers consume a verified
// program synchronously; retaining a view does not extend that allocation.
//
// It holds typed mutable slots in basic blocks: integer words of every
// width, f64 values, pointers, aggregates held in frame memory, memory
// access, system calls, JavaScript host calls and traps. A renderer that
// implements only part of it declares that part through `supports`
// (gen_ir_feature) or refuses it before rendering; there is no second IR.
Vec, OutOfBounds = std.collections
str = std.text
Span = std.source
Sys, SysConstant = gen.gen_sys
MachineCall = gen.gen_ir_machine
Res, None = std.core
Ptr = std.mem

// Size and alignment of an aggregate slot, in bytes.
Layout* = { size*: usize, align*: usize }

// A slot's machine class. Integer slots hold their value extended to the
// full machine word (signed types sign-extend, unsigned types, `Bool` and
// `Ptr` zero-extend). `F64` is an IEEE-754 binary64 value; a `Constant`
// into an `F64` slot holds its bit pattern. `Block` is an aggregate stored
// in frame memory; it is copied by value and never held in a register.
Scalar* = I32
    | Bool
    | Unit
    | I8
    | U8
    | I16
    | U16
    | U32
    | I64
    | U64
    | Ptr
    | F64
    | Block(Layout)

// Arithmetic `Add`/`Sub`/`Mul`/`Div`/`Rem` and unary `Neg` trap on overflow
// and on a zero divisor; on `F64` they are IEEE operations and never trap
// (`Rem` is C's fmod). `Wrap*` operations wrap at the slot width. Bit
// operations act on unsigned words; a shift or rotate count is a `U64`
// operand. Comparisons are signed or unsigned according to the operands.
Op* = Add
    | Sub
    | Mul
    | Div
    | Rem
    | Equal
    | NotEqual
    | Less
    | LessEqual
    | Greater
    | GreaterEqual
    | WrapAdd
    | WrapSub
    | WrapMul
    | And
    | Or
    | Xor
    | Shl
    | Shr
    | Rotr
UnaryOp* = Neg | Not

// `value` holds the constant's bits as a signed 64-bit number; a `U64`
// above `i64.MAX` is stored in two's complement.
Const* = { out*: usize, value*: i64 }
Move* = { out*: usize, source*: usize }
Unary* = { out*: usize, input*: usize, op*: UnaryOp, span*: Span }
Binary* = { out*: usize, left*: usize, right*: usize, op*: Op, span*: Span }
Invocation* = { out*: usize, function*: usize, args*: Vec<usize> }
// Standard output is buffered and flushed at exit and before a trap report;
// standard error is written through.
Stream* = Out | Err
Print* = { value*: usize, ty*: Scalar, stream* :: Stream = Stream.Out }
Branch* = { value*: usize, yes*: usize, no*: usize }

// Native surface. `Convert` truncates or extends an integer, bool or pointer
// to the output slot's class. `Address` yields a pointer to a slot's storage;
// taking it makes the slot's contents initialized for verification, because
// stores through the pointer may fill it. `Load`/`Store` move the value
// class of `out`/`value` at `base + offset`.
Convert* = { out*: usize, input*: usize }
Address* = { out*: usize, slot*: usize }
Load* = { out*: usize, base*: usize, offset*: usize }
Store* = { base*: usize, offset*: usize, value*: usize }
// Copy `bytes` (a U64 slot) bytes between non-overlapping regions.
CopyMem* = { dest*: usize, source*: usize, bytes*: usize }
// A pointer to read-only bytes emitted with the program.
StaticBytes* = { out*: usize, bytes*: str }
// Write `len` bytes at `data` to a standard stream.
Write* = { data*: usize, len*: usize, stream*: Stream }
// A kernel operation; the result is a word, negative for `-errno`.
SysCall* = { out*: usize, call*: Sys, args*: Vec<usize> }
// A kernel constant at its target's value, as an I32/I64 word.
SysValue* = { out*: usize, name*: SysConstant }
// Process start values: `argc`, `argv` and `envp`. `Globals` is the address
// of a zeroed, 256-byte, 16-byte aligned block of process-wide runtime state.
// Its first word is the exit hook: when non-zero it is the code address of a
// function taking no arguments, which the runtime calls on the main thread
// after the entry function returns and before standard output is flushed.
// The rest belongs to std.sys (see `std.sys.sys_actor`).
StartValue* = Argc | Argv | Envp | Globals
Start* = { out*: usize, value*: StartValue }
// Anonymous zeroed memory of at least `bytes` (a U64 slot) bytes, 16-byte
// aligned; the pointer is null when the kernel refuses. `UnmapPages`
// returns such a region by its pointer.
Pages* = { out*: usize, bytes*: usize }

// How a value crosses into the JavaScript host (`js.bind`, see std.js):
// `Number` an integer or f64 word, `Flag` a Bool, `Text` a `str` aggregate
// (pointer and length, decoded to a JavaScript string at the boundary),
// `Bytes` a `std.js.Bytes` aggregate of the same shape passed as a
// Uint8Array view of those heap bytes (no copy, valid for the call only),
// `Handle` a U32 id in the host's object table, `Handler` a U32 event
// handler id, `Nothing` no value (results only).
Marshal* = Number | Flag | Text | Bytes | Handle | Handler | Nothing

// A call of a `js.bind` member. `object` is the binding's object path; with
// `receiver` the first argument is the object and the path after its first
// segment is followed from it. A `member` spelled `set_x`/`get_x` assigns or
// reads property `x`; any other member is a method call.
//
// With `runtime` the call is one of std.js's own operations instead
// (`Ref.release`, `copy`): `member` names it, `object` is empty, and the
// renderer calls its runtime's implementation with the same marshalling.
HostCall* = {
    out*: usize,
    object*: str,
    member*: str,
    receiver*: bool,
    runtime*: bool,
    args*: Vec<usize>,
    marshal*: Vec<Marshal>,
    result*: Marshal,
}

// Atomic memory operations. Each is sequentially consistent and acts on the
// naturally aligned 4- or 8-byte word at `base + offset` (`base` a Ptr slot);
// the word's width is the class of the value slot (`out`, or `value` for a
// store). `AtomicUpdate` and `CompareSwap` leave the previous contents in
// `out`; `CompareSwap` writes `desired` only when they equal `expected`.
UpdateOp* = Swap | Add
Update* = { out*: usize, base*: usize, value*: usize, op*: UpdateOp }
Compare* = { out*: usize, base*: usize, expected*: usize, desired*: usize }

// The machine address of one of the program's functions, as a Ptr word, and
// a call through such an address. The target must take word arguments only
// and return a word or unit; the call follows the same convention as
// `Invoke`, so the address may also be handed to the runtime as a thread
// entry.
CodeRef* = { out*: usize, function*: usize }
IndirectCall* = { out*: usize, target*: usize, args*: Vec<usize> }

Instruction* = Constant(Const)
    | Copy(Move)
    | UnaryValue(Unary)
    | BinaryValue(Binary)
    | Invoke(Invocation)
    | PrintValue(Print)
    | Text(str)
    | Cast(Convert)
    | AddressOf(Address)
    | LoadValue(Load)
    | StoreValue(Store)
    | CopyBytes(CopyMem)
    | Bytes(StaticBytes)
    | WriteOut(Write)
    | System(SysCall)
    | Startup(Start)
    | MapPages(Pages)
    | UnmapPages(usize)
    | SysConst(SysValue)
    // Write out buffered standard output now (before blocking on input).
    | Flush
    // A validated machine primitive (gen_ir_machine). Not yet produced:
    // its operands need slot types beyond Scalar, so the verifier rejects it.
    | Machine(MachineCall)
    // JavaScript host only: a `js.bind` call, and a suspension until a
    // registered event handler fires (its id into the U32 slot).
    | Host(HostCall)
    | Wait(usize)
    | AtomicLoad(Load)
    | AtomicStore(Store)
    | AtomicUpdate(Update)
    | CompareSwap(Compare)
    | CodeAddress(CodeRef)
    | InvokeAt(IndirectCall)

// A terminator that ends the process with Zen's trap report.
TrapKind* = Overflow | DivideByZero | OutOfBounds | Unreachable | OutOfMemory
Fault* = { what*: TrapKind, span*: Span }

Terminator* = Return(usize) | Jump(usize) | Branch(Branch) | Trap(Fault)

// Every block has exactly one terminator; its targets index Func.blocks.
BasicBlock* = {
    code*: Vec<Instruction>,
    exit*: Terminator,
}

Func* = {
    name*: str,
    parameters*: usize,
    // The first `parameters` slots describe the ordered argument types.
    slots*: Vec<Scalar>,
    // Execution starts at block zero. Slots are mutable within one invocation.
    blocks*: Vec<BasicBlock>,
    result*: Scalar,
    // The lowering's claims about tagged values, which the verifier checks
    // (see `Guards`). Renderers ignore them. None for hand-built IR.
    guards* :: Res<Guards> = None,
}

// A payload is only meaningful for the alternative a tagged value holds, and
// reading it as another alternative reinterprets bytes. The lowering says
// where it tests a tag and where it reads a payload; the verifier requires
// every read to sit behind a test of that same slot for that same
// alternative on every path, with no write to the slot in between.
//
// `block` ends in a Branch on `Equal(Load(AddressOf(subject), 0),
// Const(variant))`; its yes edge proves `subject` holds `variant`, and its no
// edge proves `otherwise` when the value has exactly two alternatives.
TagGuard* = { block*: usize, subject*: usize, variant*: usize, otherwise*: Res<usize> }
// A read of `subject`'s payload as `variant`, in `block` before instruction
// `at`.
PayloadRead* = { block*: usize, at*: usize, subject*: usize, variant*: usize }
Guards* = { tests*: Vec<TagGuard>, reads*: Vec<PayloadRead> }

Program* = {
    functions*: Vec<Func>,
    // The entry function takes no arguments.
    entry*: usize,
}

// The trap report's `what`, as the C backend spells it.
trap_message* = (what: TrapKind) str {
    what.match({
        Overflow     => "integer overflow",
        DivideByZero => "divide by zero",
        OutOfBounds  => "index out of bounds",
        Unreachable  => "unreachable match arm",
        OutOfMemory  => "out of memory",
    })
}

// Integer classes: width in bytes and signedness. Bool and Ptr are unsigned
// one- and eight-byte words; Unit and Block are not integers.
width* = (ty: Scalar) usize {
    ty.match({
        I8       => 1,
        U8       => 1,
        Bool     => 1,
        I16      => 2,
        U16      => 2,
        I32      => 4,
        U32      => 4,
        I64      => 8,
        U64      => 8,
        Ptr      => 8,
        F64      => 8,
        Unit     => 0,
        Block(l) => l.size,
    })
}

signed* = (ty: Scalar) bool {
    ty.match({ I8 => true, I16 => true, I32 => true, I64 => true, _ => false })
}

integer* = (ty: Scalar) bool {
    ty.match({
        I8 => true, U8 => true, I16 => true, U16 => true, I32 => true,
        U32 => true, I64 => true, U64 => true, _ => false,
    })
}

// Floating-point classes.
float* = (ty: Scalar) bool { ty.match({ F64 => true, _ => false }) }

// Machine word classes: integers, Bool, Ptr and F64.
word* = (ty: Scalar) bool {
    ty.match({ Unit => false, Block(_) => false, _ => true })
}

same* = (left: Scalar, right: Scalar) bool {
    left.match({
        I32      => right.match({ I32 => true, _ => false }),
        Bool     => right.match({ Bool => true, _ => false }),
        Unit     => right.match({ Unit => true, _ => false }),
        I8       => right.match({ I8 => true, _ => false }),
        U8       => right.match({ U8 => true, _ => false }),
        I16      => right.match({ I16 => true, _ => false }),
        U16      => right.match({ U16 => true, _ => false }),
        U32      => right.match({ U32 => true, _ => false }),
        I64      => right.match({ I64 => true, _ => false }),
        U64      => right.match({ U64 => true, _ => false }),
        Ptr      => right.match({ Ptr => true, _ => false }),
        F64      => right.match({ F64 => true, _ => false }),
        Block(l) => right.match({
            Block(r) => l.size == r.size && l.align == r.align,
            _        => false,
        }),
    })
}
