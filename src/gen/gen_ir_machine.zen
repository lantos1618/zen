// Machine operations shared by every backend: the semantic operations that
// sema_prim and sema_numeric validate (wide multiply, truncation, unsigned
// bit operations, add with carry, std.simd vectors, volatile access, compiler
// barriers, CPU capabilities and the AES, carry-less, SHA and multi-limb
// instructions they unlock). The C backend lowers them from checked facts
// today. The scalar IR carries them as `Instruction.Machine` so assembly
// targets implement one vocabulary; until IR slots can hold u64, u128,
// vectors and pointers, lowering refuses every call to one with a diagnostic
// naming the operation, and the verifier rejects a Machine instruction.
Vec = std.collections
str = std.text
Span = std.ast
Res, Ok, None = std.core

MachineOp* = MulWide
    | AddCarry
    | SubBorrow
    | Truncate
    | BitXor
    | BitAnd
    | BitOr
    | ShiftLeft
    | ShiftRight
    | RotateLeft
    | RotateRight
    | VectorAdd
    | VectorSub
    | VectorMul
    | VectorMulLow32
    | VectorSplat
    | VectorLanes
    | VectorLoad
    | VectorStore
    | VectorLane
    | VectorWithLane
    | VectorShuffle
    | VectorShuffle2
    | VectorCast
    | VolatileLoad
    | VolatileStore
    | CompilerBarrier
    | CpuHas
    | AesRound
    | AesRoundLast
    | ClmulLow
    | ClmulHigh
    | Sha256Rnds2
    | Sha256Msg1
    | Sha256Msg2
    | Sha256H
    | Sha256H2
    | Sha256Su0
    | Sha256Su1
    | Sha512H
    | Sha512H2
    | Sha512Su0
    | Sha512Su1
    | MulLimbs
    | SquareLimbs

// `outs` and `args` index Func.slots; `word` names the operand type as the
// primitive's source spelling (`u64`, `u32x8`, `avx2`, ...), so a target can
// select an instruction without consulting the checker.
MachineCall* = {
    op*: MachineOp,
    word*: str,
    outs*: Vec<usize>,
    args*: Vec<usize>,
    span*: Span,
}

// The operation a validated primitive name denotes. Vector lane operations
// share the scalar names; the operand type tells them apart where it matters.
machine_op* = (name: str) Res<MachineOp> {
    name.match({
        "mul_wide"         => Ok(MachineOp.MulWide),
        "add_carry"        => Ok(MachineOp.AddCarry),
        "sub_borrow"       => Ok(MachineOp.SubBorrow),
        "bit_xor"          => Ok(MachineOp.BitXor),
        "bit_and"          => Ok(MachineOp.BitAnd),
        "bit_or"           => Ok(MachineOp.BitOr),
        "shift_left"       => Ok(MachineOp.ShiftLeft),
        "shift_right"      => Ok(MachineOp.ShiftRight),
        "rotate_left"      => Ok(MachineOp.RotateLeft),
        "rotate_right"     => Ok(MachineOp.RotateRight),
        "add_wrap"         => Ok(MachineOp.VectorAdd),
        "sub_wrap"         => Ok(MachineOp.VectorSub),
        "mul_wrap"         => Ok(MachineOp.VectorMul),
        "mul_low32"        => Ok(MachineOp.VectorMulLow32),
        "store"            => Ok(MachineOp.VectorStore),
        "lane"             => Ok(MachineOp.VectorLane),
        "with_lane"        => Ok(MachineOp.VectorWithLane),
        "shuffle"          => Ok(MachineOp.VectorShuffle),
        "shuffle2"         => Ok(MachineOp.VectorShuffle2),
        "read_volatile"    => Ok(MachineOp.VolatileLoad),
        "write_volatile"   => Ok(MachineOp.VolatileStore),
        "compiler_barrier" => Ok(MachineOp.CompilerBarrier),
        "aes_round"        => Ok(MachineOp.AesRound),
        "aes_round_last"   => Ok(MachineOp.AesRoundLast),
        "clmul_low"        => Ok(MachineOp.ClmulLow),
        "clmul_high"       => Ok(MachineOp.ClmulHigh),
        "sha256_rnds2"     => Ok(MachineOp.Sha256Rnds2),
        "sha256_msg1"      => Ok(MachineOp.Sha256Msg1),
        "sha256_msg2"      => Ok(MachineOp.Sha256Msg2),
        "sha256h"          => Ok(MachineOp.Sha256H),
        "sha256h2"         => Ok(MachineOp.Sha256H2),
        "sha256su0"        => Ok(MachineOp.Sha256Su0),
        "sha256su1"        => Ok(MachineOp.Sha256Su1),
        "sha512h"          => Ok(MachineOp.Sha512H),
        "sha512h2"         => Ok(MachineOp.Sha512H2),
        "sha512su0"        => Ok(MachineOp.Sha512Su0),
        "sha512su1"        => Ok(MachineOp.Sha512Su1),
        "mul_limbs"        => Ok(MachineOp.MulLimbs),
        "square_limbs"     => Ok(MachineOp.SquareLimbs),
        _                  => prefixed_op(name),
    })
}

prefixed_op = (name: str) Res<MachineOp> {
    name.starts_with("truncate_").match({
        true  => Ok(MachineOp.Truncate),
        false => name.starts_with("splat_").match({
            true  => Ok(MachineOp.VectorSplat),
            false => name.starts_with("lanes_").match({
                true  => Ok(MachineOp.VectorLanes),
                false => name.starts_with("load_").match({
                    true  => Ok(MachineOp.VectorLoad),
                    false => name.starts_with("cast_").match({
                        true  => Ok(MachineOp.VectorCast),
                        false => name.starts_with("cpu_").match({
                            true  => Ok(MachineOp.CpuHas),
                            false => None,
                        }),
                    }),
                }),
            }),
        }),
    })
}

// The diagnostic a backend without machine-operation support reports.
machine_refusal* = (op: MachineOp) str {
    op.match({
        MulWide         => "the machine primitive mul_wide (64x64 -> 128)",
        AddCarry        => "the machine primitive add_carry",
        SubBorrow       => "the machine primitive sub_borrow",
        Truncate        => "the machine primitive truncate_*",
        BitXor          => "the machine primitive bit_xor",
        BitAnd          => "the machine primitive bit_and",
        BitOr           => "the machine primitive bit_or",
        ShiftLeft       => "the machine primitive shift_left",
        ShiftRight      => "the machine primitive shift_right",
        RotateLeft      => "the machine primitive rotate_left",
        RotateRight     => "the machine primitive rotate_right",
        VectorAdd       => "the std.simd operation add_wrap",
        VectorSub       => "the std.simd operation sub_wrap",
        VectorMul       => "the std.simd operation mul_wrap",
        VectorMulLow32  => "the std.simd operation mul_low32",
        VectorSplat     => "the std.simd operation splat_*",
        VectorLanes     => "the std.simd operation lanes_*",
        VectorLoad      => "the std.simd operation load_*",
        VectorStore     => "the std.simd operation store",
        VectorLane      => "the std.simd operation lane",
        VectorWithLane  => "the std.simd operation with_lane",
        VectorShuffle   => "the std.simd operation shuffle",
        VectorShuffle2  => "the std.simd operation shuffle2",
        VectorCast      => "the std.simd operation cast_*",
        VolatileLoad    => "the machine primitive read_volatile",
        VolatileStore   => "the machine primitive write_volatile",
        CompilerBarrier => "the machine primitive compiler_barrier",
        CpuHas          => "runtime CPU feature detection (std.simd cpu_*)",
        AesRound        => "the std.simd instruction aes_round",
        AesRoundLast    => "the std.simd instruction aes_round_last",
        ClmulLow        => "the std.simd instruction clmul_low",
        ClmulHigh       => "the std.simd instruction clmul_high",
        Sha256Rnds2     => "the std.simd instruction sha256_rnds2",
        Sha256Msg1      => "the std.simd instruction sha256_msg1",
        Sha256Msg2      => "the std.simd instruction sha256_msg2",
        Sha256H         => "the std.simd instruction sha256h",
        Sha256H2        => "the std.simd instruction sha256h2",
        Sha256Su0       => "the std.simd instruction sha256su0",
        Sha256Su1       => "the std.simd instruction sha256su1",
        Sha512H         => "the std.simd instruction sha512h",
        Sha512H2        => "the std.simd instruction sha512h2",
        Sha512Su0       => "the std.simd instruction sha512su0",
        Sha512Su1       => "the std.simd instruction sha512su1",
        MulLimbs        => "the std.simd instruction mul_limbs",
        SquareLimbs     => "the std.simd instruction square_limbs",
    })
}
