// The interpreter's form of a function: the IR decoded once into one flat
// run of operations whose operands are byte offsets into the frame, whose
// jumps are operation indices, and whose kind already says the width and
// signedness, so running one does no lookup, copy or type dispatch. What
// is rare or carries a payload (system calls, printing, startup values,
// atomics) stays an IR instruction behind `Slow`.

{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ Res, Ok, None, Range } = std.core
{ written } = gen.gen_asm_flow
{ pointer_at } = std.sys
{ Func, Scalar, Instruction, Terminator, Op, Fault, width, signed, integer, float } = gen.gen_ir

Kind* = { ConstWord
    | CopyWord
    | CopyBlock
    | AddressOf
    | Load
    | Store
    | AddSigned
    | SubSigned
    | MulSigned
    | AddUnsigned
    | SubUnsigned
    | MulUnsigned
    | DivUnsigned
    | RemUnsigned
    | Cast
    | CompareSigned
    | CompareUnsigned
    | Bits
    | Call
    | Jump
    | Branch
    | Return
    | Trap
    | Slow }

// `a`, `b` and `c` are cell offsets (or operation indices for jumps); `n`
// is a constant, a size, a function number or a side-table index; `w` is
// a width in bytes or an operator code; `ty` is the result's class.
// `slow` indexes the instruction itself in `Code.slow`, which a fast step
// falls back to when its fast path cannot finish (an overflow trap).
Step* = { kind*: Kind, a*: usize, b*: usize, c*: usize, n*: u64, w*: usize, ty*: Scalar, slow* :: usize = 0 }

Code* = {
    steps* :: Vec<Step>,
    // Argument cell offsets of every `Call`, `n` of them from `b`.
    args* :: Vec<usize>,
    // The instructions `Slow` steps run, and the faults `Trap` reports.
    slow* :: Vec<Instruction>,
    faults* :: Vec<Fault>,
    // Parameter cell offsets and sizes, for the caller's argument copies.
    params* :: Vec<usize>,
    sizes* :: Vec<usize>,
    // (offset, bits) pairs of the slots `decode` fills once per call.
    consts* :: Vec<u64>,
}

// Comparison operators as `w` codes.
operator* = (op: Op) usize {
    op.match({
        Equal => 0, NotEqual => 1, Less => 2, LessEqual => 3, Greater => 4,
        GreaterEqual => 5, WrapAdd => 6, WrapSub => 7, WrapMul => 8, And => 9,
        Or => 10, Xor => 11, Shl => 12, Shr => 13, Rotr => 14, _ => 15,
    })
}

decode* = (a: Alloc, f: Func, offsets: Vec<usize>, base: usize,
           scratch : usize)
          Res<Code, AllocError> {
    code ::= Code(
        steps: a.Vec<Step>(),
        args: a.Vec<usize>(),
        slow: a.Vec<Instruction>(),
        faults: a.Vec<Fault>(),
        params: a.Vec<usize>(),
        sizes: a.Vec<usize>(),
        consts: a.Vec<u64>()
    );
    Range(0, f.parameters).loop((i) {
        code.params.add(cell_of(offsets, base, i)).try();
        code.sizes.add(
            class_of(f, i).match({ Unit => 0, Block(l) => l.size, _ => 8 })
        ).try();
    });
    // Slots only ever set to one constant are filled once per call, from
    // the image after the parameter pairs, instead of by a step each time.
    sets  ::= a.Vec<usize>();
    value ::= a.Vec<i64>();
    fixed ::= a.Vec<bool>();
    Range(0, f.slots.len).loop((i) {
        sets.add(0).try();
        value.add(0).try();
        fixed.add(i >= f.parameters).try();
    });
    f.blocks.loop((block) {
        block.code.loop((instruction) {
            instruction.match({
                Constant(v)  => {
                    (sets.get(v.out).value_or(0) > 0 && value.get(v.out).value_or(0) != v.value).then(() { fixed.set(v.out, false); });
                    sets.set(v.out, sets.get(v.out).value_or(0) + 1);
                    value.set(v.out, v.value);
                },
                AddressOf(v) => { fixed.set(v.slot, false); fixed.set(v.out, false); },
                _            => written(instruction).match({
                    Ok(slot) => { fixed.set(slot, false); },
                    None     => (),
                }),
            });
        });
    });
    Range(0, f.slots.len).loop((i) {
        (fixed.get(i).value_or(false) && sets.get(i).value_or(0) > 0).match({
            true  => {
                code.consts.add(cell_of(offsets, base, i).to_u64()).try();
                code.consts.add(bits_of(
                    scratch,
                    value.get(i).value_or(0)
                )).try();
            },
            false => (),
        });
    });
    // Each block's first step, then jumps patched from block numbers.
    starts ::= a.Vec<usize>();
    f.blocks.loop((block) {
        starts.add(code.steps.len).try();
        block.code.loop((instruction) {
            pinned     = instruction.match({
                Constant(v) => fixed.get(v.out).value_or(false),
                _           => false,
            });
            step: Step = instruction.match({
                Constant(v)    => float(class_of(f, v.out)).match({
                    true  => Step(
                        kind: Kind.ConstWord,
                        a: cell_of(offsets, base, v.out),
                        b: 0,
                        c: 0,
                        n: bits_of(scratch, v.value),
                        w: 8,
                        ty: class_of(f, v.out)
                    ),
                    false => Step(
                        kind: Kind.ConstWord,
                        a: cell_of(offsets, base, v.out),
                        b: 0,
                        c: 0,
                        n: bits_of(scratch, v.value),
                        w: 8,
                        ty: class_of(f, v.out)
                    ),
                }),
                Copy(v)        => class_of(f, v.out).match({
                    Block(l) => Step(
                        kind: Kind.CopyBlock,
                        a: cell_of(offsets, base, v.out),
                        b: cell_of(offsets, base, v.source),
                        c: 0,
                        n: l.size.to_u64(),
                        w: 0,
                        ty: class_of(f, v.out)
                    ),
                    Unit     => Step(
                        kind: Kind.CopyBlock,
                        a: cell_of(offsets, base, v.out),
                        b: cell_of(offsets, base, v.source),
                        c: 0,
                        n: 0,
                        w: 0,
                        ty: Scalar.Unit
                    ),
                    _        => Step(
                        kind: Kind.CopyWord,
                        a: cell_of(offsets, base, v.out),
                        b: cell_of(offsets, base, v.source),
                        c: 0,
                        n: 0,
                        w: 8,
                        ty: class_of(f, v.out)
                    ),
                }),
                LoadValue(v)   => Step(
                    kind: Kind.Load,
                    a: cell_of(offsets, base, v.out),
                    b: cell_of(offsets, base, v.base),
                    c: v.offset,
                    n: 0,
                    w: moved(class_of(f, v.out)),
                    ty: class_of(f, v.out)
                ),
                StoreValue(v)  => Step(
                    kind: Kind.Store,
                    a: cell_of(offsets, base, v.base),
                    b: cell_of(offsets, base, v.value),
                    c: v.offset,
                    n: 0,
                    w: moved(class_of(f, v.value)),
                    ty: class_of(f, v.value)
                ),
                AddressOf(v)   => Step(
                    kind: Kind.AddressOf,
                    a: cell_of(offsets, base, v.out),
                    b: cell_of(offsets, base, v.slot),
                    c: 0,
                    n: 0,
                    w: 8,
                    ty: Scalar.Ptr
                ),
                BinaryValue(v) => arithmetic(v.op, class_of(f, v.left)).match({
                    Ok(kind) => { code.slow.add(instruction).try(); Step(kind: kind, a: cell_of(offsets, base, v.out), b: cell_of(offsets, base, v.left), c: cell_of(offsets, base, v.right), n: 0, slow: code.slow.len - 1, w: kind.match({
                        CompareSigned => operator(v.op), CompareUnsigned => operator(v.op), Bits => operator(v.op), _ => width(class_of(f, v.left)),
                    }), ty: class_of(f, v.out)) },
                    None     => { code.slow.add(instruction).try(); Step(kind: Kind.Slow, a: 0, b: 0, c: 0, n: (code.slow.len - 1).to_u64(), w: 0, ty: Scalar.Unit) },
                }),
                Invoke(v)      => {
                    first = code.args.len;
                    v.args.loop(
                        (slot) { code.args.add(cell_of(
                            offsets,
                            base,
                            slot
                        )).try(); }
                    );
                    Step(
                        kind: Kind.Call,
                        a: cell_of(offsets, base, v.out),
                        b: first,
                        c: v.args.len,
                        n: v.function.to_u64(),
                        w: 0,
                        ty: class_of(f, v.out)
                    )
                },
                Cast(v)        => (wordish(class_of(f, v.input)) && wordish(class_of(f, v.out))).match({
                    true  => Step(
                        kind: Kind.Cast,
                        a: cell_of(offsets, base, v.out),
                        b: cell_of(offsets, base, v.input),
                        c: 0,
                        n: 0,
                        w: 8,
                        ty: class_of(f, v.out)
                    ),
                    false => { code.slow.add(instruction).try(); Step(kind: Kind.Slow, a: 0, b: 0, c: 0, n: (code.slow.len - 1).to_u64(), w: 0, ty: Scalar.Unit) },
                }),
                _              => { code.slow.add(instruction).try(); Step(kind: Kind.Slow, a: 0, b: 0, c: 0, n: (code.slow.len - 1).to_u64(), w: 0, ty: Scalar.Unit) },
            });
            pinned.match({ true => (), false => { code.steps.add(
                step
            ).try(); } });
        });
        exit: Step = block.exit.match({
            Return(slot)   => Step(
                kind: Kind.Return,
                a: cell_of(offsets, base, slot),
                b: 0,
                c: 0,
                n: 0,
                w: 0,
                ty: f.result
            ),
            Jump(to)       => Step(
                kind: Kind.Jump,
                a: to,
                b: 0,
                c: 0,
                n: 0,
                w: 0,
                ty: Scalar.Unit
            ),
            Branch(branch) => Step(
                kind: Kind.Branch,
                a: cell_of(offsets, base, branch.value),
                b: branch.yes,
                c: branch.no,
                n: 0,
                w: 0,
                ty: Scalar.Unit
            ),
            Trap(fault)    => { code.faults.add(fault).try(); Step(kind: Kind.Trap, a: 0, b: 0, c: 0, n: (code.faults.len - 1).to_u64(), w: 0, ty: Scalar.Unit) },
        });
        code.steps.add(exit).try();
    });
    // Block numbers become step indices.
    Range(0, code.steps.len).loop((i) {
        s = code.steps.get(i).value_or(Step(kind: Kind.Jump, a: 0, b: 0, c: 0, n: 0, w: 0, ty: Scalar.Unit));
        s.kind.match({
            Jump   => code.steps.set(
                i,
                Step(
                    kind: s.kind,
                    a: starts.get(s.a).value_or(0),
                    b: 0,
                    c: 0,
                    n: 0,
                    w: 0,
                    ty: s.ty
                )
            ),
            Branch => code.steps.set(
                i,
                Step(
                    kind: s.kind,
                    a: s.a,
                    b: starts.get(s.b).value_or(0),
                    c: starts.get(s.c).value_or(0),
                    n: 0,
                    w: 0,
                    ty: s.ty
                )
            ),
            _      => (),
        });
    });
    Ok(code)
}

// The fast kind of an integer binary operation; None for what stays slow
// (floats, signed division, Unit comparisons).
arithmetic = (op: Op, ty: Scalar) Res<Kind> {
    (integer(ty) || ty.match({ Bool => true, Ptr => true, _ => false })).match({
        false => None,
        true  => op.match({
            Add          => Ok(
                signed(
                    ty
                ).match({ true => Kind.AddSigned, false => Kind.AddUnsigned })
            ),
            Sub          => Ok(
                signed(
                    ty
                ).match({ true => Kind.SubSigned, false => Kind.SubUnsigned })
            ),
            Mul          => Ok(
                signed(
                    ty
                ).match({ true => Kind.MulSigned, false => Kind.MulUnsigned })
            ),
            Div          => unsigned_integer(ty).match({ true => Ok(Kind.DivUnsigned), false => None }),
            Rem          => unsigned_integer(ty).match({ true => Ok(Kind.RemUnsigned), false => None }),
            Equal        => Ok(compare(ty)),
            NotEqual     => Ok(compare(ty)),
            Less         => Ok(compare(ty)),
            LessEqual    => Ok(compare(ty)),
            Greater      => Ok(compare(ty)),
            GreaterEqual => Ok(compare(ty)),
            _            => Ok(Kind.Bits),
        }),
    })
}

// A scalar that lives in one word without float bits.
wordish = (ty: Scalar) bool { integer(
    ty
) || ty.match({ Bool => true, Ptr => true, _ => false }) }

unsigned_integer = (ty: Scalar) bool { integer(ty) && !signed(ty) }

compare = (ty: Scalar) Kind { signed(
    ty
).match({ true => Kind.CompareSigned, false => Kind.CompareUnsigned }) }

cell_of = (offsets: Vec<usize>, base: usize, slot: usize) usize {
    offsets.get(base + slot).value_or(0)
}

class_of = (f: Func, slot: usize) Scalar { f.slots.get(slot).value_or(Scalar.Unit) }

// An i64's bit pattern, through the eight-byte cell at `scratch`.
bits_of = (scratch: usize, value: i64) u64 {
    pointer_at(scratch).to<i64>().write(0, value);
    pointer_at(scratch).to<u64>().read(0)
}

// Bytes a load or store moves: a word's width, or a block's size.
moved = (ty: Scalar) usize { ty.match({ Unit => 0, Block(l) => l.size, _ => width(
    ty
) }) }

// Extremes of a signed class and the ceiling of an unsigned one.
minimum* = (ty: Scalar) i64 {
    ty.match({ I8 => -128, I16 => -32768, I32 => -2147483648, _ => i64.MIN })
}

maximum* = (ty: Scalar) i64 {
    ty.match({ I8 => 127, I16 => 32767, I32 => 2147483647, _ => i64.MAX })
}

ceiling* = (ty: Scalar) u64 {
    ty.match({ U8 => 255, Bool => 255, U16 => 65535, U32 => 4294967295, _ => u64.MAX })
}

// The encoded form the interpreter runs: each step is eight words (op, a,
// b, c, n, w, slow, x) at a fixed stride, so fetching one is a load, not a
// checked lookup and a copy. `op` is a small integer that also fixes the
// width or the fused branch; `x` is the extension code of a narrow result,
// a narrow maximum, or a fused branch's false target. Call arguments and
// the parameter pairs (offset, size) follow the steps, then the constant
// image: a count and that many (offset, bits) pairs.
STEP: usize = 64

size_of* = (code: Code) usize {
    code.steps.len * STEP + code.args.len * 8 + code.params.len * 16 + 8 + code.consts.len * 8
}

// Writes `code` at `at` (`size_of` bytes); returns its parameter pairs.
encode* = (code: Code, at: usize) usize {
    args   = at + code.steps.len * STEP;
    params = args + code.args.len * 8;
    code.steps.loop((h, i, s) {
        out = at + i * STEP;
        put(out, 1, s.a);
        put(out, 2, s.b);
        put(out, 3, s.c);
        pointer_at(out).to<u64>().write(4, s.n);
        put(out, 5, s.w);
        put(out, 6, s.slow);
        put(out, 7, 0);
        op: usize = s.kind.match({
            ConstWord       => 0,
            CopyWord        => 1,
            CopyBlock       => 2,
            AddressOf       => 3,
            Load            => (s.w == 8).match({
                true  => 4,
                false => (s.w == 1 && widening(s.ty) == 2).match({
                    true  => 47,
                    false => (s.w == 4 && widening(s.ty) == 6).match({
                        true  => 48,
                        false => { put(out, 7, widening(s.ty)); 5 },
                    }),
                }),
            }),
            Store           => s.w.match({ 8 => 6, 1 => 49, 4 => 50, _ => 7 }),
            AddSigned       => narrow(out, s, 8),
            SubSigned       => narrow(out, s, 9),
            MulSigned       => narrow(out, s, 10),
            AddUnsigned     => { pointer_at(out).to<u64>().write(4, ceiling(s.ty)); 14 },
            SubUnsigned     => { pointer_at(out).to<u64>().write(4, ceiling(s.ty)); 15 },
            MulUnsigned     => { pointer_at(out).to<u64>().write(4, ceiling(s.ty)); 16 },
            Cast            => s.ty.match({
                Bool => 46,
                _    => widening(s.ty).match({
                    6 => 51,
                    2 => 52,
                    _ => { put(out, 7, widening(s.ty)); 45 },
                }),
            }),
            DivUnsigned     => 43,
            RemUnsigned     => 44,
            CompareSigned   => fused(out, s, code, i, 17),
            CompareUnsigned => fused(out, s, code, i, 18),
            Bits            => bit_step(out, s),
            Call            => { put(out, 2, args + s.b * 8); 20 },
            Jump            => 21,
            Branch          => 22,
            Return          => {
                put(
                    out,
                    4,
                    s.ty.match({ Unit => 0, Block(l) => l.size, _ => 8 })
                );
                23
            },
            Trap            => 24,
            Slow            => 25,
        });
        put(out, 0, op);
    });
    code.args.loop((h, i, v) { put(args, i, v); });
    Range(0, code.params.len).loop((i) {
        put(params, 2 * i, code.params.get(i).value_or(0));
        put(params, 2 * i + 1, code.sizes.get(i).value_or(0));
    });
    image = params + code.params.len * 16;
    put(image, 0, code.consts.len / 2);
    code.consts.loop(
        (h, i, v) { pointer_at(image).to<u64>().write(i + 1, v); }
    );
    params
}

// A bit step: and/or/xor read whole words; 64-bit and u32 wrapping
// arithmetic, shifts and rotates get their own opcodes; the rest take the
// general path with its width in n and extension code in x.
bit_step = (out: usize, s: Step) usize {
    plain = s.w == 6 || s.w == 7 || s.w == 8 || s.w >= 12 && s.w <= 14;
    lane  = s.w.match({ 6 => 0, 7 => 1, 8 => 2, 12 => 3, 13 => 4, _ => 5 });
    (s.w >= 9 && s.w <= 11).match({
        true  => s.w + 19,
        false => (plain && width(s.ty) == 8).match({
            true  => 31 + lane,
            false => (plain && s.ty.match({ U32 => true, _ => false })).match({
                true  => 37 + lane,
                false => {
                    put(out, 4, width(s.ty));
                    put(out, 7, widening(s.ty));
                    19
                },
            }),
        }),
    })
}

// A checked signed step: 64-bit, or narrow with its bounds in n and x.
narrow = (out: usize, s: Step, op: usize) usize {
    (s.w == 8).match({
        true  => op,
        false => {
            pointer_at(out).to<i64>().write(4, minimum(s.ty));
            pointer_at(out).to<i64>().write(7, maximum(s.ty));
            op + 3
        },
    })
}

// A comparison whose result the next step branches on is fused with it:
// it still writes its cell, then goes to n (true) or x (false).
fused = (out: usize, s: Step, code: Code, i: usize, op: usize) usize {
    code.steps.get(i + 1).match({
        None       => op,
        Ok(branch) => branch.kind.match({
            Branch => (branch.a == s.a).match({
                false => op,
                true  => { put(out, 4, branch.b); put(out, 7, branch.c); op + 9 },
            }),
            _      => op,
        }),
    })
}

// How a narrow result is re-extended to its word (gen_jit_interp
// `extend_code`): 0 none, then i8, u8 or bool, i16, u16, i32, u32.
widening = (ty: Scalar) usize {
    ty.match({ I8 => 1, U8 => 2, Bool => 2, I16 => 3, U16 => 4, I32 => 5, U32 => 6, _ => 0 })
}

put = (at: usize, k: usize, value: usize) { pointer_at(at).to<usize>().write(k, value); }
