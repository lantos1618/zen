// C functions for the jit. Each `Foreign` call's symbol is resolved with
// dlsym: first among the libraries the compiler process already has (the C
// library and libm), then in the library the call names (`library`), opened
// with dlopen. Calls go through a stub written into executable memory that
// follows the host's C ABI: it loads the argument registers and stack words
// from a frame, calls the symbol, and stores both result registers back.
// General calls use the x86-64 System V stub. The standard malloc/free
// signatures have typed host calls on every supported JIT platform.
//
// C calls back into the program through reverse stubs: a program that both
// calls C through the stub and takes a code address (`callback(f)`) gets one
// executable entry per function, and `CodeAddress` yields that entry. The
// entry saves the argument registers in a block on the C stack and hands it
// to the interpreter's trampoline, which runs the function and leaves both
// result registers in the block. The interpreter is only re-entered while it
// is parked in a C call; at any other moment (a signal during interpreted
// code) the entry records the arguments, marks the call pending and returns
// zero, and the interpreter runs it at its next safe point.
{ Alloc, AllocError, Ptr, null_ptr } = std.mem
{ Vec, Map } = std.collections
{ String, str, c_text } = std.text
{ Res, Ok, Err, None, loop, Range, truncate_u8, truncate_u32, shift_right } = std.core
{ mmap, mprotect, munmap, pointer_at, address_of, call_entry } = std.sys
{ Program, Func, Scalar, ForeignCall, float, same } = gen.gen_ir
{ Platform } = gen.gen_sys

Dl = c.bind("dlfcn.h", {
    RTLD_NOW: i32
    RTLD_GLOBAL: i32
    dlopen = (path: Ptr<u8>, flags: i32) Ptr<u8>
    dlsym = (handle: Ptr<u8>, symbol: Ptr<u8>) Ptr<u8>
})

Heap = c.bind("stdlib.h", {
    malloc = (bytes: usize) Ptr<u8>
    free = (pointer: Ptr<u8>) ()
})

// These exact signatures use the compiler's C ABI rather than an executable
// stub. The header, library and types distinguish them from symbol overrides.
HeapCall = { Allocate | Release,
    invoke = (self: @Self, value: u64) Returned {
        self.match({
            Allocate => Returned(
                word: address_of(Heap.malloc(value.to_usize().value_or(
                    0
                ))).to_u64(),
                float: 0
            ),
            Release  => {
                Heap.free(pointer_at(value.to_usize().value_or(0)));
                Returned(word: 0, float: 0)
            },
        })
    }
}

heap_call = (f: Func, call: ForeignCall) Res<HeapCall> {
    (call.header.eq(
        "stdlib.h"
    ) && call.library.is_empty() && !call.typed && call.args.len == 1).ensure().try();
    input  = f.slots.get(call.args.get(0).value_or(0)).value_or(Scalar.Unit);
    output = f.slots.get(call.out).value_or(Scalar.Unit);
    (call.symbol.eq("malloc") && same(input, Scalar.U64) && same(output, Scalar.Ptr)).match({
        true  => Ok(HeapCall.Allocate),
        false => (call.symbol.eq("free") && same(input, Scalar.Ptr) && same(output, Scalar.Unit)).match({
            true  => Ok(HeapCall.Release),
            false => None,
        }),
    })
}

// Each symbol's address, the stub, and the frame it reads: the function,
// the stack word count, six integer registers, eight SSE registers, the
// two results (rax, xmm0), then the stack words. `code` is the address of
// function 0's entry, `state` the reverse stubs' page (0 without them):
// the trampoline, the parked word, the interpreter's cell, the pending
// word, then one record per function from STATE_RECORDS.
Linked* = {
    symbols* : Map<str, usize>,
    stub*    : usize,
    frame*   : usize,
    code*    : usize,
    state*   : usize
}

// `Missing` names a symbol no library defines; `Refused` the function whose
// C call this host cannot make.
Linking* = { Ready: Linked | Missing: str | Refused: str }

// The two result registers of one call.
Returned* = { word*: u64, float*: u64 }

STACK_WORDS: usize = 16
FRAME_BYTES: usize = 4096
STUB_WORDS: usize = 18

// Without reverse stubs, code addresses are function entries above this
// base that only the interpreter can call.
CODE_BASE: usize = 1152921504606846976
ENTRY_BYTES: usize = 16
COMMON_WORDS: usize = 24
// Where the common reverse stub's immediate state address sits.
COMMON_STATE: usize = 95
STATE_PARKED: usize = 8
STATE_CELL: usize = 16
STATE_PENDING: usize = 24
STATE_RECORDS: usize = 64
RECORD_BYTES: usize = 256

// A reverse stub's block: the function, six integer registers, eight SSE
// registers, the two results (rax, xmm0), then the forward frame it saves.
BLOCK_INTS*: usize = 8
BLOCK_FLOATS*: usize = 56
BLOCK_WORD*: usize = 120
BLOCK_FLOAT*: usize = 128
BLOCK_SAVED*: usize = 144
SAVED_BYTES*: usize = 272

// Every C function the program calls, resolved; the stub mapped when there
// is one.
link* = (a: Alloc, program: Program, platform: Platform)
        Res<Linking, AllocError> {
    symbols    ::= a.Map<str, usize>();
    refused    :: Res<str> = None;
    missing    :: Res<str> = None;
    needs_stub ::= false;
    calls_back ::= false;
    program.functions.loop((f) {
        f.blocks.loop((block) {
            block.code.loop((i) {
                i.match({
                    Foreign(call)  => {
                        bridged    = heap_call(
                            f,
                            call
                        ).match({ Ok(_) => true, None => false });
                        needs_stub = needs_stub || !bridged;
                        (!bridged && (platform.match({ LinuxX86_64 => false, _ => true })
                            || stack_words(f, call) > STACK_WORDS)).then(() {
                            refused.match({ Ok(_) => (), None => { refused = Ok(
                                f.name
                            ); } });
                        });
                        symbols.get(call.symbol).match({
                            Ok(_) => (),
                            None  => {
                                at = resolve(a, call).try();
                                (at == 0).match({
                                    true  => missing.match({ Ok(_) => (), None => { missing = Ok(
                                        call.symbol
                                    ); } }),
                                    false => symbols.set(call.symbol, at).try(),
                                });
                            },
                        });
                    },
                    CodeAddress(_) => { calls_back = true; },
                    _              => (),
                });
            });
        });
    });
    refused.match({
        Ok(name) => Ok(Linking.Refused(name)),
        None     => missing.match({
            Ok(symbol) => Ok(Linking.Missing(symbol)),
            None       => needs_stub.match({
                false => Ok(Linking.Ready(Linked(
                    symbols: symbols,
                    stub: 0,
                    frame: 0,
                    code: CODE_BASE,
                    state: 0
                ))),
                true  => {
                    stub  = mapped(mmap(0, FRAME_BYTES, 3, 34, -1, 0));
                    frame = mapped(mmap(0, FRAME_BYTES, 3, 34, -1, 0));
                    executable ::= false;
                    (stub != 0 && frame != 0).then(() {
                        Range(0, STUB_WORDS).loop((i) { pointer_at(stub + i * 8).to<u64>().write(0, stub_word(i)); });
                        executable = mprotect(stub, FRAME_BYTES, 5) == 0;
                    });
                    executable.match({
                        false => {
                            (stub != 0).then(() { munmap(stub, FRAME_BYTES); });
                            (frame != 0).then(
                                () { munmap(frame, FRAME_BYTES); }
                            );
                            Ok(Linking.Refused(
                                "the stub for calls of C functions"
                            ))
                        },
                        true  => {
                            linked = Linked(
                                symbols: symbols,
                                stub: stub,
                                frame: frame,
                                code: CODE_BASE,
                                state: 0
                            );
                            calls_back.match({
                                false => Ok(Linking.Ready(linked)),
                                true  => reverse(
                                    linked,
                                    program.functions.len
                                ).match({
                                    Ok(entries) => Ok(Linking.Ready(entries)),
                                    None        => Ok(Linking.Refused(
                                        "the stubs for calls back from C"
                                    )),
                                }),
                            })
                        },
                    })
                },
            }),
        }),
    })
}

// `linked` with one reverse stub entry for each of `count` functions: entry
// k loads k into eax and jumps to the common stub after the entries, whose
// immediate is the state page.
reverse = (linked: Linked, count: usize) Res<Linked> {
    common = count * ENTRY_BYTES;
    size   = round_up(common + COMMON_WORDS * 8, FRAME_BYTES);
    pages  = round_up(STATE_RECORDS + count * RECORD_BYTES, FRAME_BYTES);
    code   = mapped(mmap(0, size, 3, 34, -1, 0));
    state  = mapped(mmap(0, pages, 3, 34, -1, 0));
    executable ::= false;
    (code != 0 && state != 0).then(() {
        Range(0, count).loop((k) {
            at   = code + k * ENTRY_BYTES;
            jump = common - k * ENTRY_BYTES - 10;
            pointer_at(at).write(0, 184);
            pointer_at(at + 1).to<u32>().write(0, k.truncate_u32());
            pointer_at(at + 5).write(0, 233);
            pointer_at(at + 6).to<u32>().write(0, jump.truncate_u32());
            Range(10, ENTRY_BYTES).loop((i) { pointer_at(at + i).write(0, 204); });
        });
        Range(0, COMMON_WORDS).loop((i) { put(code + common + i * 8, common_word(i)); });
        Range(COMMON_STATE, COMMON_STATE + 8).loop((i) {
            pointer_at(code + common + i).write(0, state.shift_right((i - COMMON_STATE) * 8).truncate_u8());
        });
        executable = mprotect(code, size, 5) == 0;
    });
    executable.match({
        true  => Ok(Linked(
            symbols: linked.symbols,
            stub: linked.stub,
            frame: linked.frame,
            code: code,
            state: state
        )),
        false => {
            (code != 0).then(() { munmap(code, size); });
            (state != 0).then(() { munmap(state, pages); });
            None
        },
    })
}

round_up = (n: usize, to: usize) usize { (n + to - 1) / to * to }

// The code address of function `index`.
entry_of* = (
    linked : Linked,
    index  : usize
) usize { linked.code + index * ENTRY_BYTES }

// The function whose code address is `code`; None for any other address.
function_of* = (linked: Linked, code: usize) Res<usize> {
    (code >= linked.code && (code - linked.code) % ENTRY_BYTES == 0).ensure().try();
    Ok((code - linked.code) / ENTRY_BYTES)
}

// Whether C may call back during this call: the stub makes it, and the
// reverse stubs exist. A heap call is never re-entered.
calls_back* = (linked: Linked, f: Func, call: ForeignCall) bool {
    linked.state != 0 && heap_call(
        f,
        call
    ).match({ Ok(_) => false, None => true })
}

// The trampoline the reverse stubs call, and the interpreter's cell.
install* = (linked: Linked, trampoline: usize, cell: usize) {
    put(linked.state, trampoline.to_u64());
    put(linked.state + STATE_CELL, cell.to_u64());
}

// The interpreter's cell, as `install` set it.
cell_of* = (state: usize) usize { pointer_at(state + STATE_CELL).to<usize>().read(0) }

// Whether a reverse stub may re-enter the interpreter now.
park* = (state: usize, parked: bool) {
    pointer_at(state + STATE_PARKED).to<u64>().write_volatile(0, parked.match({ true => 1, false => 0 }));
}

// Whether any call was deferred since the last look, claimed.
pending* = (linked: Linked) bool {
    word = pointer_at(linked.state + STATE_PENDING).to<u64>();
    (linked.state != 0 && word.read_volatile(0) != 0).match({
        true  => { word.write_volatile(0, 0); true },
        false => false,
    })
}

// The record of a deferred call of function `index`, claimed; 0 when none
// is pending.
claim* = (linked: Linked, index: usize) usize {
    record = linked.state + STATE_RECORDS + index * RECORD_BYTES;
    flag   = pointer_at(record).to<u64>();
    (flag.read_volatile(0) != 0).match({
        true  => { flag.write_volatile(0, 0); record },
        false => 0,
    })
}

// The symbol's address in the process, else in the call's library; 0 when
// neither defines it.
resolve = (a: Alloc, call: ForeignCall) Res<usize, AllocError> {
    name  = call.symbol.c_text(a).try();
    found = symbol_in(Dl.dlopen(null_ptr<u8>(), Dl.RTLD_NOW), name);
    (found != 0 || call.library.len == 0).match({
        true  => Ok(found),
        false => {
            at ::= 0;
            Range(0, 3).loop((k) {
                (at == 0).then(() {
                    path   = k.match({
                        0 => a.String("lib{}.so", call.library),
                        1 => a.String("lib{}.so.3", call.library),
                        _ => a.String("lib{}.so.6", call.library),
                    }).try();
                    file   = path.view().c_text(a).try();
                    handle = Dl.dlopen(
                        file.ptr(),
                        Dl.RTLD_NOW + Dl.RTLD_GLOBAL
                    );
                    at     = symbol_in(handle, name);
                });
            });
            Ok(at)
        },
    })
}

symbol_in = (handle: Ptr<u8>, name: Vec<u8>) usize {
    (address_of(handle) == 0).match({
        true  => 0,
        false => address_of(Dl.dlsym(handle, name.ptr())),
    })
}

mapped = (result: i64) usize { result.to_usize().value_or(0) }

// The stack words a call passes beyond its registers.
stack_words = (f: Func, call: ForeignCall) usize {
    ints   :: usize = 0;
    floats :: usize = 0;
    call.args.loop((slot) {
        float(f.slots.get(slot).value_or(Scalar.Unit)).match({
            true  => { floats = floats + 1; },
            false => { ints = ints + 1; },
        });
    });
    (ints > 6).match({ true => ints - 6, false => 0 }) + (floats > 8).match({ true => floats - 8, false => 0 })
}

// Call `address` with the argument cells `at` gives, classified as the
// System V ABI does: integers and pointers in the six integer registers,
// floats in the eight SSE registers (an f32 in the low four bytes), the rest
// on the stack in order. Small integers are already extended in their cells.
invoke* = (
    linked  : Linked,
    address : usize,
    f       : Func,
    call    : ForeignCall,
    at      : (slot: usize) usize
) Returned {
    heap_call(f, call).match({
        Ok(kind) => kind.invoke(pointer_at(at(call.args.get(0).value_or(0))).to<u64>().read(0)),
        None     => invoke_stub(linked, address, f, call, (slot) { at(slot) }),
    })
}

invoke_stub = (
    linked  : Linked,
    address : usize,
    f       : Func,
    call    : ForeignCall,
    at      : (slot: usize) usize
) Returned {
    fr = linked.frame;
    ints   :: usize = 0;
    floats :: usize = 0;
    stack  :: usize = 0;
    call.args.loop((slot) {
        word     = pointer_at(at(slot)).to<u64>().read(0);
        on_stack = float(f.slots.get(slot).value_or(Scalar.Unit)).match({
            true  => (floats < 8).match({
                true  => { put(
                    fr + 64 + floats * 8,
                    word
                ); floats = floats + 1; false },
                false => true,
            }),
            false => (ints < 6).match({
                true  => { put(
                    fr + 16 + ints * 8,
                    word
                ); ints = ints + 1; false },
                false => true,
            }),
        });
        on_stack.then(
            () { put(fr + 144 + stack * 8, word); stack = stack + 1; }
        );
    });
    put(fr, address.to_u64());
    put(fr + 8, stack.to_u64());
    call_entry(linked.stub, pointer_at(fr), null_ptr<u8>());
    Returned(
        word: pointer_at(fr + 128).to<u64>().read(0),
        float: pointer_at(fr + 136).to<u64>().read(0)
    )
}

put = (at: usize, value: u64) { pointer_at(at).to<u64>().write(0, value); }

// The x86-64 stub, little-endian words of its bytes:
//   push rbp; mov rbp, rsp; push rbx; push r12; mov rbx, rdi
//   mov rcx, [rbx+8]; test cl, 1; jz 1f; sub rsp, 8      (keep rsp 16-aligned)
//   1: test rcx, rcx; jz 2f; push [rbx+rcx*8+136]; dec rcx; jmp 1b
//   2: movq xmm0..7, [rbx+64..120]; mov rdi, rsi, rdx, rcx, r8, r9, [rbx+16..56]
//   mov r11, [rbx]; mov eax, 8; call r11
//   mov [rbx+128], rax; movq [rbx+136], xmm0
//   lea rsp, [rbp-16]; pop r12; pop rbx; pop rbp; ret
stub_word = (i: usize) u64 {
    i.match({
        0  => 5211862497363576917,
        1  => 13976367614143298441,
        2  => 5190658619137618945,
        3  => 9857171216949102981,
        4  => 17288133692853583872,
        5  => 9083746430765371379,
        6  => 17532605150251927627,
        7  => 7169185194654268943,
        8  => 1149377140795372384,
        9  => 8681671313660605310,
        10 => 1761905020862434120,
        11 => 2903567526666668872,
        12 => 4056489048720771916,
        13 => 37448551244,
        14 => 36173422674575169,
        15 => 38425552237232128,
        16 => 6647858843928231936,
        17 => 12803419,
        _  => 0,
    })
}

// The common reverse stub, little-endian words of its bytes:
//   push rbp; mov rbp, rsp; sub rsp, 416      (the block, 16-aligned)
//   mov [rsp], rax; mov [rsp+8..48], rdi, rsi, rdx, rcx, r8, r9
//   movq [rsp+56..112], xmm0..7; movabs r11, <state>
//   cmp qword [r11+8], 0; je 1f
//   mov rdi, rsp; mov rsi, r11; call [r11]
//   mov rax, [rsp+120]; movq xmm0, [rsp+128]; leave; ret
//   1: mov rcx, [rsp]; shl rcx, 8; lea rdi, [r11+rcx+64]
//   mov ecx, 14; 2: mov rdx, [rsp+rcx*8]; mov [rdi+rcx*8], rdx; dec rcx; jnz 2b
//   mov qword [rdi], 1; mov qword [r11+24], 1
//   xor eax, eax; pxor xmm0, xmm0; leave; ret
common_word = (i: usize) u64 {
    i.match({
        0  => 11595785290660792405,
        1  => 5198284857557385217,
        2  => 2626875425131101321,
        3  => 9892183125835466768,
        4  => 2892512217157084236,
        5  => 15424659605720697164,
        6  => 2615700845223224388,
        7  => 7370180736979002944,
        8  => 15424659743160718863,
        9  => 2624708044480062564,
        10 => 7379188073672697440,
        11 => 52716566642218511,
        12 => 5260204364768739328,
        13 => 9892184567526751107,
        14 => 5193775453659811047,
        15 => 9547085798439142539,
        16 => 5243255393026605092,
        17 => 5262704384837684363,
        18 => 16188806233229,
        19 => 1479793993923119104,
        20 => 14359995099096500431,
        21 => 4883952585255420167,
        22 => 7403971663466856728,
        23 => 14757395220261826319,
        _  => 0,
    })
}
