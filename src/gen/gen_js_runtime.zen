// The JavaScript backend's runtime, emitted ahead of every program by
// gen_js (or published as runtime.js for the `js-browser` layout). It is the
// machine half of the JS target: the linear heap, the canonical-word and
// 64-bit pair helpers, traps, buffered output, the system-call layer, the
// `js.bind` boundary (handle table, UTF-8 decoding, event queue, resuming
// suspended programs) and two hosts: Node, and a page with a DOM. The
// generated code for a program only calls these; docs/JS_BACKEND.md
// documents the model.
//
// The runtime is kept as JavaScript lines here because Zen has no file
// embedding; edit the JavaScript in place and keep one statement per line
// where practical so diffs stay readable.

{ String } = std.text
{ AllocError } = std.mem
{ Res, Ok } = std.core

write_runtime* = (out :: String) Res<(), AllocError> {
    LINES.loop((line) {
        out.add(line).try();
        out.add("\n").try();
    });
    Ok(())
}

LINES = [
    "\"use strict\";",
    "// Zen JavaScript runtime. Emitted ahead of every program by gen_js.",
    "// Memory is one little-endian linear heap: address 0 is reserved so that a",
    "// null Ptr faults; static bytes follow; the call stack grows down from",
    "// ZSTACK; pages mapped by the program live above it. JS numbers hold words",
    "// of 32 bits or fewer; 64-bit words are (lo, hi) uint32 pairs, and a helper",
    "// returning a 64-bit value leaves its high half in `zH`.",
    "const ZSTACK = 8 << 20;",
    "// The heap is a fixed-length ArrayBuffer that `zgrow` replaces with a longer",
    "// one: Web APIs (Blob, XMLHttpRequest.send, TextDecoder, getRandomValues)",
    "// refuse views of a resizable buffer, and V8 reads a fixed-length one about",
    "// twice as fast. Growing detaches the old buffer, so `zm` and `zb` are",
    "// rebuilt there, and no view of the heap may be kept across anything that",
    "// can allocate. A view given to JavaScript (`zview`) is valid for its call.",
    "const ZHEAPMAX = 2 ** 31;",
    "let zheap = new ArrayBuffer(ZSTACK + (1 << 20));",
    "let zm = new DataView(zheap);",
    "let zb = new Uint8Array(zheap);",
    "let zsp = ZSTACK;",
    "let zH = 0;",
    "let zdata = 16;",
    "let zbrk = ZSTACK;",
    "const zfree = new Map();",
    "class ZenTrap extends Error {}",
    "class ZenExit extends Error {}",
    "// `where` is the hex spelling of \"file:line:col: \", decoded only on failure.",
    "function zt(where, what) { const e = new ZenTrap(what); e.where = where; throw e; }",
    "function zunhex(hex) { const b = new Uint8Array(hex.length / 2); for (let i = 0; i < b.length; i++) b[i] = parseInt(hex.substr(i * 2, 2), 16); return b; }",
    "// Canonical forms of words of 32 bits or fewer.",
    "function zc_i8(x) { return x << 24 >> 24; }",
    "function zc_u8(x) { return x & 255; }",
    "function zc_i16(x) { return x << 16 >> 16; }",
    "function zc_u16(x) { return x & 65535; }",
    "function zc_i32(x) { return x | 0; }",
    "function zc_u32(x) { return x >>> 0; }",
    "// Little-endian stores of each width; a 64-bit store takes the low half,",
    "// then the high half (zero for a Ptr).",
    "function zst8(at, v) { zm.setUint8(at, v); }",
    "function zst16(at, v) { zm.setUint16(at, v, true); }",
    "function zst32(at, v) { zm.setUint32(at, v, true); }",
    "function zstf(at, v) { zm.setFloat64(at, v, true); }",
    "function zset64(at, lo, hi = 0) { zm.setUint32(at, lo, true); zm.setUint32(at + 4, hi, true); }",
    "function zstack() { zt(\"\", \"stack overflow\"); }",
    "// Static bytes are copied once into the data region; returns the address.",
    "function zstatic(hex) {",
    "  const at = zdata;",
    "  for (let i = 0; i < hex.length; i += 2) zb[zdata++] = parseInt(hex.substr(i, 2), 16);",
    "  zdata = (zdata + 15) & ~15;",
    "  return at;",
    "}",
    "// Anonymous zeroed memory, 16-byte aligned; 0 when the heap cannot grow.",
    "function zmap(bytes) {",
    "  const size = (bytes + 15) & ~15;",
    "  const list = zfree.get(size);",
    "  if (list && list.length) { const at = list.pop(); zb.fill(0, at, at + size); return at; }",
    "  const at = zbrk;",
    "  if (at + size > zheap.byteLength) {",
    "    if (at + size > ZHEAPMAX) return 0;",
    "    let want = zheap.byteLength;",
    "    while (at + size > want) want *= 2;",
    "    zgrow(Math.min(want, ZHEAPMAX));",
    "  }",
    "  zbrk = at + size;",
    "  return at;",
    "}",
    "// Move the heap into a zeroed buffer of `bytes`; `transfer` can extend the",
    "// allocation in place instead of copying.",
    "function zgrow(bytes) {",
    "  if (typeof zheap.transfer === \"function\") zheap = zheap.transfer(bytes);",
    "  else { const next = new ArrayBuffer(bytes); new Uint8Array(next).set(zb); zheap = next; }",
    "  zm = new DataView(zheap);",
    "  zb = new Uint8Array(zheap);",
    "}",
    "function zunmap(at, bytes) {",
    "  const size = (bytes + 15) & ~15;",
    "  if (!zfree.has(size)) zfree.set(size, []);",
    "  zfree.get(size).push(at);",
    "}",
    "// MapPages/UnmapPages: a 16-byte header before the region keeps its length.",
    "function zpages(bytes) { const at = zmap(bytes + 16); if (at === 0) return 0; zm.setUint32(at, bytes + 16, true); return at + 16; }",
    "function zunpages(p) { if (p !== 0) zunmap(p - 16, zm.getUint32(p - 16, true)); }",
    "function zcopy(dest, source, n) { zb.copyWithin(dest, source, source + n); }",
    "",
    "// ---- 32-bit and narrower checks: exact in float64, trap outside range.",
    "function zrange(v, lo, hi, where) { if (v < lo || v > hi) zt(where, \"integer overflow\"); return v; }",
    "function zdiv(a, b, min, where) {",
    "  if (b === 0) zt(where, \"divide by zero\");",
    "  if (a === min && b === -1) zt(where, \"integer overflow\");",
    "  return Math.trunc(a / b);",
    "}",
    "function zrem(a, b, min, where) {",
    "  if (b === 0) zt(where, \"divide by zero\");",
    "  if (a === min && b === -1) zt(where, \"integer overflow\");",
    "  return a % b;",
    "}",
    "function zshl(a, clo, chi, bits) { return (chi !== 0 || clo >= bits) ? 0 : (bits === 32 ? (a << clo) >>> 0 : a * 2 ** clo); }",
    "function zshr(a, clo, chi, bits) { return (chi !== 0 || clo >= bits) ? 0 : (a >>> clo); }",
    "function zrotr(a, c, bits) {",
    "  c %= bits;",
    "  if (c === 0) return a;",
    "  const mask = bits === 32 ? 0xffffffff : (1 << bits) - 1;",
    "  return ((a >>> c) | (a << (bits - c))) & mask;",
    "}",
    "",
    "// ---- 64-bit pairs. BigInt is used only where the pair arithmetic would be",
    "// long (division, full products, decimal printing).",
    "const Z64 = 0x100000000;",
    "function zbig(lo, hi) { return (BigInt(hi) << 32n) | BigInt(lo); }",
    "function zbigs(lo, hi) { return BigInt.asIntN(64, zbig(lo, hi)); }",
    "function zsplit(v) { v = BigInt.asUintN(64, v); zH = Number(v >> 32n); return Number(v & 0xffffffffn); }",
    "function zadd64(al, ah, bl, bh, signed, where) {",
    "  let lo = al + bl, carry = 0;",
    "  if (lo >= Z64) { lo -= Z64; carry = 1; }",
    "  let hi = ah + bh + carry;",
    "  if (signed) {",
    "    const r = hi % Z64, sa = ah >>> 31, sb = bh >>> 31, sr = r >>> 31;",
    "    if (sa === sb && sr !== sa) zt(where, \"integer overflow\");",
    "    hi = r;",
    "  } else if (hi >= Z64) zt(where, \"integer overflow\");",
    "  zH = hi >>> 0;",
    "  return lo;",
    "}",
    "function zsub64(al, ah, bl, bh, signed, where) {",
    "  let lo = al - bl, borrow = 0;",
    "  if (lo < 0) { lo += Z64; borrow = 1; }",
    "  let hi = ah - bh - borrow;",
    "  if (signed) {",
    "    const r = (hi + Z64) % Z64, sa = ah >>> 31, sb = bh >>> 31, sr = r >>> 31;",
    "    if (sa !== sb && sr !== sa) zt(where, \"integer overflow\");",
    "    hi = r;",
    "  } else if (hi < 0) zt(where, \"integer overflow\");",
    "  zH = hi >>> 0;",
    "  return lo;",
    "}",
    "function zmul64(al, ah, bl, bh, signed, where) {",
    "  if (ah === 0 && bh === 0 && al * bl < 2 ** 53) {",
    "    const p = al * bl;",
    "    if (signed && p >= 2 ** 63) zt(where, \"integer overflow\");",
    "    zH = Math.floor(p / Z64); return p % Z64;",
    "  }",
    "  const p = signed ? zbigs(al, ah) * zbigs(bl, bh) : zbig(al, ah) * zbig(bl, bh);",
    "  if (signed ? BigInt.asIntN(64, p) !== p : BigInt.asUintN(64, p) !== p) zt(where, \"integer overflow\");",
    "  return zsplit(p);",
    "}",
    "function zdiv64(al, ah, bl, bh, signed, rem, where) {",
    "  if (bl === 0 && bh === 0) zt(where, \"divide by zero\");",
    "  if (ah === 0 && bh === 0) { zH = 0; return rem ? al % bl : Math.floor(al / bl); }",
    "  const a = signed ? zbigs(al, ah) : zbig(al, ah), b = signed ? zbigs(bl, bh) : zbig(bl, bh);",
    "  if (signed && b === -1n && a === -(1n << 63n)) zt(where, \"integer overflow\");",
    "  return zsplit(rem ? a % b : a / b);",
    "}",
    "function zneg64(lo, hi, where) {",
    "  if (lo === 0 && hi === 0x80000000) zt(where, \"integer overflow\");",
    "  return zsplit(-zbigs(lo, hi));",
    "}",
    "function zwadd64(al, ah, bl, bh) { const lo = al + bl; zH = (ah + bh + (lo >= Z64 ? 1 : 0)) >>> 0; return lo >>> 0; }",
    "function zwsub64(al, ah, bl, bh) { const lo = al - bl; zH = (ah - bh - (lo < 0 ? 1 : 0)) >>> 0; return lo >>> 0; }",
    "function zwmul64(al, ah, bl, bh) {",
    "  // (ah*2^32 + al)(bh*2^32 + bl) mod 2^64 from 16-bit limbs of al and bl.",
    "  const a0 = al & 0xffff, a1 = al >>> 16, b0 = bl & 0xffff, b1 = bl >>> 16;",
    "  const low = a0 * b0, mid = a1 * b0 + a0 * b1;",
    "  const lo = low + (mid % 0x10000) * 0x10000;",
    "  const carry = Math.floor(lo / Z64) + Math.floor(mid / 0x10000);",
    "  zH = (a1 * b1 + carry + Math.imul(ah, bl) + Math.imul(al, bh)) >>> 0;",
    "  return lo >>> 0;",
    "}",
    "function zlt64(al, ah, bl, bh, signed) {",
    "  if (ah !== bh) return signed ? ((ah | 0) < (bh | 0)) : ah < bh;",
    "  return al < bl;",
    "}",
    "function zshl64(al, ah, c, ch) {",
    "  if (ch !== 0 || c >= 64) { zH = 0; return 0; }",
    "  if (c === 0) { zH = ah; return al; }",
    "  if (c >= 32) { zH = (al << (c - 32)) >>> 0; return 0; }",
    "  zH = ((ah << c) | (al >>> (32 - c))) >>> 0; return (al << c) >>> 0;",
    "}",
    "function zshr64(al, ah, c, ch) {",
    "  if (ch !== 0 || c >= 64) { zH = 0; return 0; }",
    "  if (c === 0) { zH = ah; return al; }",
    "  if (c >= 32) { zH = 0; return ah >>> (c - 32); }",
    "  zH = ah >>> c; return ((al >>> c) | (ah << (32 - c))) >>> 0;",
    "}",
    "function zrotr64(al, ah, c) {",
    "  c %= 64;",
    "  const rl = zshr64(al, ah, c, 0), rh = zH;",
    "  const ll = zshl64(al, ah, (64 - c) % 64 === 0 ? 64 : 64 - c, 0), lh = zH;",
    "  zH = (rh | lh) >>> 0; return (rl | ll) >>> 0;",
    "}",
    "// A 64-bit word as a JS number, for system-call arguments (exact below 2^53).",
    "function znum(lo, hi, signed) { return signed ? (hi | 0) * Z64 + lo : hi * Z64 + lo; }",
    "function zfromnum(v) { const hi = Math.floor(v / Z64); zH = hi >>> 0; return (v - hi * Z64) >>> 0; }",
    "function zfbits(lo, hi) { zm.setUint32(0, lo, true); zm.setUint32(4, hi, true); const v = zm.getFloat64(0, true); zm.setFloat64(0, 0, true); return v; }",
    "",
    "// ---- Output. Standard output is buffered and flushed at exit, before a",
    "// trap report and before blocking on input; standard error is written through.",
    "const zout = new Uint8Array(65536);",
    "let zoutn = 0;",
    "let zhost = null;",
    "function zflush() { if (zoutn > 0) { zhost.write(1, zout.slice(0, zoutn)); zoutn = 0; } }",
    "function zemit(fd, bytes) {",
    "  if (fd !== 1) { zflush(); zhost.write(fd, bytes); return; }",
    "  if (zoutn + bytes.length > zout.length) { zflush(); if (bytes.length > zout.length) { zhost.write(1, bytes.slice()); return; } }",
    "  zout.set(bytes, zoutn); zoutn += bytes.length;",
    "}",
    "const zenc = new TextEncoder();",
    "function zprint(fd, text) { zemit(fd, zenc.encode(text)); }",
    "function zwrite(fd, at, n) { zemit(fd, zb.subarray(at, at + n)); }",
    "function zprint64(fd, lo, hi, signed) { zprint(fd, (signed ? zbigs(lo, hi) : zbig(lo, hi)).toString()); }",
    "// C's printf(\"%g\").",
    "function zfmtg(v) {",
    "  if (Number.isNaN(v)) return \"nan\";",
    "  if (!Number.isFinite(v)) return v < 0 ? \"-inf\" : \"inf\";",
    "  if (v === 0) return Object.is(v, -0) ? \"-0\" : \"0\";",
    "  const e = Number(v.toExponential(5).split(\"e\")[1]);",
    "  if (e < -4 || e >= 6) {",
    "    let [m, x] = v.toExponential(5).split(\"e\");",
    "    if (m.includes(\".\")) m = m.replace(/0+$/, \"\").replace(/\\.$/, \"\");",
    "    const n = Number(x);",
    "    return m + \"e\" + (n < 0 ? \"-\" : \"+\") + String(Math.abs(n)).padStart(2, \"0\");",
    "  }",
    "  let s = v.toFixed(Math.max(0, 5 - e));",
    "  if (s.includes(\".\")) s = s.replace(/0+$/, \"\").replace(/\\.$/, \"\");",
    "  return s;",
    "}",
    "",
    "// ---- System calls: gen_sys operations in the -errno convention, with",
    "// Linux x86-64 constant values (SysConst renders those).",
    "const ENOSYS = 38, EBADF = 9, ENOENT = 2;",
    "function zsys(op, a) {",
    "  switch (op) {",
    "    case \"read\": { zflush(); const n = zhost.read(a[0], zb.subarray(a[1], a[1] + a[2])); return n; }",
    "    case \"write\": zemit(a[0], zb.slice(a[1], a[1] + a[2])); return a[2];",
    "    case \"openat\": return zhost.open ? zhost.open(zcstr(a[1]), a[2], a[3]) : -ENOSYS;",
    "    case \"close\": return zhost.close ? zhost.close(a[0]) : -EBADF;",
    "    case \"mmap\": { const at = zmap(a[1]); return at === 0 ? -12 : at; }",
    "    case \"munmap\": zunmap(a[0], a[1]); return 0;",
    "    case \"exit_group\": throw Object.assign(new ZenExit(\"exit\"), { code: a[0] & 255 });",
    "    case \"clock_gettime\": {",
    "      const ns = a[0] === 1 ? zhost.monotonic() : BigInt(Date.now()) * 1000000n;",
    "      const s = ns / 1000000000n, r = ns % 1000000000n;",
    "      zm.setBigInt64(a[1], s, true); zm.setBigInt64(a[1] + 8, r, true); return 0;",
    "    }",
    "    // getRandomValues fills at most 65536 bytes per call.",
    "    case \"getrandom\": for (let at = 0; at < a[1]; at += 65536) crypto.getRandomValues(zb.subarray(a[0] + at, a[0] + Math.min(a[1], at + 65536))); return a[1];",
    "    default: return -ENOSYS;",
    "  }",
    "}",
    "function zcstr(at) { let end = at; while (zb[end] !== 0) end++; return new TextDecoder().decode(zb.slice(at, end)); }",
    "// argv/envp as C arrays of 8-byte pointers to NUL-terminated strings.",
    "let zargc = 0, zargv = 0, zenvp = 0;",
    "function zcarray(list) {",
    "  const table = zmap((list.length + 1) * 8);",
    "  list.forEach((text, i) => {",
    "    const bytes = zenc.encode(text), at = zmap(bytes.length + 1);",
    "    zb.set(bytes, at); zm.setUint32(table + i * 8, at, true);",
    "  });",
    "  return table;",
    "}",
    "",
    "// ---- The JavaScript host (`js.bind`, std.js). Host objects cross as ids",
    "// into the handle table below (0 is null/undefined); `str` crosses as",
    "// UTF-8 bytes in the heap, decoded here; `Bytes` as a Uint8Array view of",
    "// the heap; a `Handler` becomes a listener that queues its id.",
    "// `std.js.wait` suspends the program (a generator) until an id is queued.",
    "//",
    "// Handle ids are slot + generation * 2^20. A live object always has the same",
    "// id, and every time a binding returns it counts one more reference",
    "// (`zrefn`); `Ref.release` (`zrelease`) gives one back, and at zero the slot",
    "// drops the object, advances its generation and goes on the free list. An",
    "// id from an older generation then traps rather than reaching whatever",
    "// object reuses the slot. A slot whose 12-bit generation is used up is",
    "// retired, so no id is ever issued twice.",
    "const ZSLOT = 0xfffff;",
    "const ZGENS = 1 << 12;",
    "const zrefs = [null];",
    "const zrefn = [1];",
    "const zrefgen = [0];",
    "const zreffree = [];",
    "const zrefids = new Map();",
    "const zdec = new TextDecoder();",
    "function zref(value) {",
    "  if (value === null || value === undefined) return 0;",
    "  let id = zrefids.get(value);",
    "  if (id !== undefined) { zrefn[id & ZSLOT]++; return id; }",
    "  let slot = zreffree.pop();",
    "  if (slot === undefined) {",
    "    slot = zrefs.length;",
    "    if (slot > ZSLOT) zt(\"\", \"js.Ref table full: release Refs that are no longer used\");",
    "    zrefs.push(null); zrefn.push(0); zrefgen.push(0);",
    "  }",
    "  zrefs[slot] = value;",
    "  zrefn[slot] = 1;",
    "  id = zrefgen[slot] * (ZSLOT + 1) + slot;",
    "  zrefids.set(value, id);",
    "  return id;",
    "}",
    "// The slot of a live id; `what` names the misuse when the id is not live.",
    "function zslot(id, what) {",
    "  const slot = id & ZSLOT;",
    "  if (zrefgen[slot] !== id >>> 20 || zrefn[slot] === 0) zt(\"\", what + \" (id \" + id + \")\");",
    "  return slot;",
    "}",
    "function zobj(id) { return zrefs[zslot(id, \"use of a released js.Ref\")]; }",
    "function zrelease(id) {",
    "  if (id === 0) return;",
    "  const slot = zslot(id, \"js.Ref released twice\");",
    "  if (--zrefn[slot] > 0) return;",
    "  zrefids.delete(zrefs[slot]);",
    "  zrefs[slot] = null;",
    "  const gen = zrefgen[slot] + 1;",
    "  zrefgen[slot] = gen;",
    "  if (gen < ZGENS) zreffree.push(slot);",
    "}",
    "// A `str` argument as a JavaScript string.",
    "function zstr(at) { const p = zm.getUint32(at, true), n = zm.getUint32(at + 8, true); return zdec.decode(zb.subarray(p, p + n)); }",
    "// A `Bytes` argument as a view of those heap bytes, checked to lie inside",
    "// the heap (a null pointer only with no bytes).",
    "function zview(at) {",
    "  const p = zm.getUint32(at, true), n = zm.getUint32(at + 8, true);",
    "  if (zm.getUint32(at + 4, true) !== 0 || zm.getUint32(at + 12, true) !== 0 || p + n > zb.length || (p === 0 && n !== 0)) zt(\"\", \"js.Bytes outside the heap\");",
    "  return zb.subarray(p, p + n);",
    "}",
    "// std.js.copy: bytes of an ArrayBuffer or typed array, from `offset`, into",
    "// a heap view, in one copy; answers how many were copied.",
    "function zcopyin(source, offset, into) {",
    "  if (source === null) return 0;",
    "  let bytes;",
    "  if (source instanceof ArrayBuffer || (typeof SharedArrayBuffer === \"function\" && source instanceof SharedArrayBuffer)) bytes = new Uint8Array(source);",
    "  else if (ArrayBuffer.isView(source)) bytes = new Uint8Array(source.buffer, source.byteOffset, source.byteLength);",
    "  else zt(\"\", \"std.js.copy: the source is not an ArrayBuffer or typed array\");",
    "  if (offset >= bytes.length) return 0;",
    "  const n = Math.min(bytes.length - offset, into.length);",
    "  into.set(bytes.subarray(offset, offset + n));",
    "  return n;",
    "}",
    "const zqueue = [];",
    "const zlisteners = new Map();",
    "let zresume = null;",
    "function zevent(id) { zqueue.push(id); if (zresume) { const resume = zresume; zresume = null; resume(); } }",
    "function zhandler(id) {",
    "  let listener = zlisteners.get(id);",
    "  if (!listener) { listener = () => zevent(id); zlisteners.set(id, listener); }",
    "  return listener;",
    "}",
    "",
    "// The exit status a thrown error stands for; reports traps like C.",
    "function zfault(host, error) {",
    "  if (error instanceof ZenExit) return error.code;",
    "  zflush();",
    "  if (!(error instanceof ZenTrap)) throw error;",
    "  host.write(2, zunhex(error.where));",
    "  host.write(2, zenc.encode(\"trap: \" + error.message + \"\\n\"));",
    "  return 134;",
    "}",
    "",
    "// Run the entry function and report its exit status to `done`. A program",
    "// that can reach `std.js.wait` is a generator: each time it suspends, a",
    "// queued event resumes it at once; otherwise a host with events resumes it",
    "// when one arrives, and a host without events answers 0.",
    "function zrun(host, entry, args, env, done) {",
    "  zhost = host;",
    "  zargc = args.length; zargv = zcarray(args); zenvp = zcarray(env);",
    "  const finish = (code) => { zflush(); done(code & 255); };",
    "  let first;",
    "  try { first = entry(); } catch (error) { return finish(zfault(host, error)); }",
    "  if (!(first && typeof first.next === \"function\")) return finish(first);",
    "  const step = (value) => {",
    "    for (;;) {",
    "      let state;",
    "      try { state = first.next(value); } catch (error) { return finish(zfault(host, error)); }",
    "      if (state.done) return finish(state.value);",
    "      if (zqueue.length > 0) { value = zqueue.shift(); continue; }",
    "      if (!host.events) { value = 0; continue; }",
    "      zflush();",
    "      zresume = () => step(zqueue.shift());",
    "      return;",
    "    }",
    "  };",
    "  step(undefined);",
    "}",
    "",
    "// ---- Hosts. Node runs the program as a process with the standard streams",
    "// and the file system; a page runs it on the page's thread with the DOM.",
    "const ZERRNO = { EPERM: 1, ENOENT: 2, EINTR: 4, EIO: 5, EBADF: 9, EAGAIN: 11, EACCES: 13,",
    "  EEXIST: 17, ENOTDIR: 20, EISDIR: 21, EINVAL: 22, ENOSPC: 28, ENAMETOOLONG: 36, ENOTEMPTY: 39, ELOOP: 40 };",
    "function znodehost() {",
    "  const fs = require(\"fs\");",
    "  const errno = (e) => -(ZERRNO[e.code] || 5);",
    "  const C = fs.constants;",
    "  return {",
    "    write(fd, bytes) {",
    "      let at = 0;",
    "      while (at < bytes.length) {",
    "        try { at += fs.writeSync(fd, bytes, at); }",
    "        catch (e) { if (e.code !== \"EAGAIN\") return; }",
    "      }",
    "    },",
    "    read(fd, buf) {",
    "      for (;;) {",
    "        try { return fs.readSync(fd, buf, 0, buf.length, null); }",
    "        catch (e) { if (e.code === \"EOF\") return 0; if (e.code !== \"EAGAIN\") return errno(e); }",
    "      }",
    "    },",
    "    // Flags arrive with Linux x86-64 values (SysConst) and are translated.",
    "    open(path, flags, mode) {",
    "      let f = flags & 3;",
    "      if (flags & 64) f |= C.O_CREAT;",
    "      if (flags & 512) f |= C.O_TRUNC;",
    "      if (flags & 1024) f |= C.O_APPEND;",
    "      if (flags & 65536) f |= C.O_DIRECTORY;",
    "      try { return fs.openSync(path, f, mode); } catch (e) { return errno(e); }",
    "    },",
    "    close(fd) { try { fs.closeSync(fd); return 0; } catch (e) { return errno(e); } },",
    "    monotonic() { return process.hrtime.bigint(); },",
    "  };",
    "}",
    "// A page with a DOM runs the program on its own thread: output goes to the",
    "// console and events come from js.bind listeners.",
    "function zpagehost() {",
    "  const lines = [\"\", \"\"];",
    "  const start = performance.now();",
    "  return {",
    "    events: true,",
    "    write(fd, bytes) {",
    "      const i = fd === 2 ? 1 : 0;",
    "      lines[i] += zdec.decode(bytes.slice());",
    "      const cut = lines[i].lastIndexOf(\"\\n\");",
    "      if (cut >= 0) { (i ? console.error : console.log)(lines[i].slice(0, cut)); lines[i] = lines[i].slice(cut + 1); }",
    "    },",
    "    read(fd, buf) { return 0; },",
    "    monotonic() { return BigInt(Math.round((performance.now() - start) * 1e6)); },",
    "  };",
    "}",
    "function zmain(entry) {",
    "  if (typeof document === \"object\") {",
    "    zrun(zpagehost(), entry, [\"app\"], [], (code) => { if (code !== 0) console.error(\"program exited with status \" + code); });",
    "  } else {",
    "    const env = Object.entries(process.env).map(([k, v]) => k + \"=\" + v);",
    "    zrun(znodehost(), entry, process.argv.slice(1), env, (code) => { process.exitCode = code; });",
    "  }",
    "}",
]
