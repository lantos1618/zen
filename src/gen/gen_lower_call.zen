// Calls for the native lowering: function instances, inlined higher-order
// calls, constructions, compiler-provided operations (loops, loop handles,
// pointers, numeric conversions and bit operations, console output) and
// formatted printing. Every other bodiless declaration is refused.

Alloc, AllocError = std.mem
Vec, Map = std.collections
String, str = std.text
Range = std.core
fmt_at = std.text.text_fmt
decode_literal = std.lex
Ast, ExprId, BlockId, TypeId, Span, Function, Literal, Call, Arg, Param = std.ast
Expr, Lambda, Access, Struct, Member, Impl = std.ast
ImplId = sema.sema
walk, WalkVisitor, WalkEvent, WalkNode = std.ast.ast_walk
nowhere = std.ast
Checker, DeclId, Def, TyId, Ctx, Inst, decl_at, CheckedCall, TyNamed = sema.sema
subst = sema.sema
Found, members_of = sema.sema_member
Scalar, Op, UnaryOp, Const, Move, Unary, Binary, Invocation, Print = gen.gen_ir
Instruction, Terminator, Convert, Address, Load, Store, CopyMem, StaticBytes = gen.gen_ir
Write, Stream, TrapKind, Marshal, HostCall = gen.gen_ir
word, integer, signed, same, float = gen.gen_ir
LowerError, unsupported = gen.gen_lower
machine_op, machine_refusal = gen.gen_ir_machine
Lowerer, Value, Place, Base, LocalKind, LambdaRef, LoopTarget, Frame, Callee = gen.gen_lower_core
DeferEntry, Local = gen.gen_lower_core
member_call, mem_call, sys_call, resolve, to_bound, handle_for_place = gen.gen_lower_member
bound_of, dispatch, Bound = gen.gen_lower_member
to_i64_bits = gen.gen_lower_core
Shape, Form, FieldAt, VariantAt, shape, class_of, field_types = gen.gen_lower_shape
variant_index, size_of = gen.gen_lower_shape

// One argument position after binding names and the receiver.
Source* = Given(ExprId) | Absent | Computed(Value) | Located(Place)

// ---------------------------------------------------------------------
// dispatch
// ---------------------------------------------------------------------

call* = (lo :: Lowerer, id: ExprId, c: Call, span: Span) Res<Value, LowerError> {
    callee = lo.stripped(c.callee);
    callee.kind.match({
        Name(n)   => lo.lookup(n.text).match({
            Ok(Closure(lambda)) => {
                args ::= lo.alloc.Vec<Value>();
                c.args.loop((a) { args.add(lo.expr(a.value).try()).try(LowerError.OutOfMemory); });
                lo.inline_lambda(lambda, args, lo.type_of(id).try())
            },
            _                   => lo.named_call(id, c, n.text, span),
        }),
        Access(a) => lo.dot_call(id, c, a, span),
        _         => Err(unsupported(span, "a call through an expression")),
    })
}

stripped = (lo :: Lowerer, id: ExprId) Expr {
    e = lo.tree.expr_at(id);
    e.kind.match({ Paren(p) => lo.stripped(p.inner), _ => e })
}

named_call = (lo :: Lowerer, id: ExprId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    selected = lo.check.checked_call(id);
    resolved = selected.match({
        Ok(checked) => checked.declaration.match({ Ok(_) => true, None => false }),
        None        => false,
    });
    sugar ::= name.is_in(["print", "println"]) && !resolved;
    sugar.then(() {
        defs ::= lo.alloc.Vec<Def>();
        lo.check.world.defs_of(lo.here().module, name, defs).try(LowerError.OutOfMemory);
        sugar = defs.len == 0;
    });
    sugar.match({
        true  => lo.print_call(c.args, 0, name.eq("println"), Stream.Out, span),
        false => selected.match({
            Ok(checked) => checked.declaration.match({
                Ok(_) => lo.checked_invoke(id, c, checked, None, span),
                None  => lo.construction(id, c, name, span),
            }),
            None        => lo.construction(id, c, name, span),
        }),
    })
}

// A call without a checked function: a struct construction or a variant.
construction = (lo :: Lowerer, id: ExprId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    ty = lo.settled_type(id).try();
    s  = lo.shape(ty).try();
    s.form.match({
        Record(_) => lo.construct_named(ty, c, span),
        _         => lo.variant_call(ty, c, name, span),
    })
}

variant_call = (lo :: Lowerer, ty: TyId, c: Call, name: str, span: Span) Res<Value, LowerError> {
    payload: Res<Value> = c.args.get(0).match({
        None    => None,
        Ok(arg) => {
            variants = lo.variants_of(ty).try();
            index = variant_index(variants, name).ok_or(unsupported(span, "an unknown variant")).try();
            expected = variants.get(index).ok_or(unsupported(span, "a missing variant")).try().payload.ok_or(unsupported(span, "a payload for a payload-free variant")).try();
            Ok(lo.expr_as(arg.value, expected).try())
        },
    });
    lo.variant_value(ty, name, payload, span)
}

dot_call = (lo :: Lowerer, id: ExprId, c: Call, a: Access, span: Span) Res<Value, LowerError> {
    base = lo.tree.expr_at(a.base);
    at_scope = base.kind.match({ Scope => true, _ => false });
    (at_scope && a.name.text.eq("defer")).match({
        true  => lo.defer(c, span),
        false => lo.dot_call_on(id, c, a, base, span),
    })
}

// `@scope.defer(closure)`: arm the closure for the innermost block's exit,
// with the locals it reads captured now.
defer = (lo :: Lowerer, c: Call, span: Span) Res<Value, LowerError> {
    arg = c.args.get(0).ok_or(unsupported(span, "a defer without a closure")).try();
    lambda = lo.closure_of(Source.Given(arg.value), span).try();
    // The flag starts clear on function entry and is set where this
    // registration runs; the block's exit runs the closure only if armed.
    armed = lo.slot_of(Scalar.Bool).try();
    lo.prologue.add(Instruction.Constant(Const(out: armed, value: 0))).try(LowerError.OutOfMemory);
    lo.add(Instruction.Constant(Const(out: armed, value: 1))).try();
    captures = lo.captures_of(lambda).try();
    lo.defers.add(DeferEntry(lambda: lambda, armed: armed, captures: captures)).try(LowerError.OutOfMemory);
    lo.unit()
}

dot_call_on = (lo :: Lowerer, id: ExprId, c: Call, a: Access, base: Expr, span: Span) Res<Value, LowerError> {
    handle: Res<usize> = base.kind.match({
        Name(n) => lo.lookup(n.text).match({ Ok(Handle(loop_id)) => Ok(loop_id), _ => None }),
        _       => None,
    });
    handle.match({
        Ok(loop_id) => lo.handle_call(loop_id, a.name.text, c, span),
        None        => {
            type_base = base.kind.match({
                Name(n) => lo.lookup(n.text).match({
                    Ok(_) => false,
                    None  => lo.names_type(n.text),
                }),
                _       => false,
            });
            selected = lo.check.checked_call(id);
            declared = selected.match({
                Ok(checked) => checked.declaration.match({ Ok(_) => true, None => false }),
                None        => false,
            });
            // A function declared inside a struct and called through the
            // type (`View.create(a, 16)`): sema records the member's body and
            // the type that provides it, and there is no receiver.
            member: Res<CheckedCall> = selected.match({
                Ok(checked) => checked.body.match({
                    None    => None,
                    Ok(_)   => checked.member_provider.match({ Ok(_) => Ok(checked), None => None }),
                }),
                None        => None,
            });
            host = selected.match({
                Ok(checked) => host_binding(lo, checked),
                None        => None,
            });
            (type_base && !declared).match({
                true  => host.match({
                  Ok(binding) => lo.host_call(id, c, binding, a.name.text, span),
                  None        => member.match({
                    Ok(checked) => {
                        owner = lo.concrete(checked.member_provider.value_or(lo.unit_ty)).try();
                        callee = lo.resolve(owner, a.name.text, checked.body, c.args.len, lo.call_inst(checked.inst).try(), None, span).try();
                        sources = lo.bind_sources(callee.f, c, None, span).try();
                        lo.invoke(id, callee, sources, c, span)
                    },
                    // `Type.Variant(payload)` or a construction through a type.
                    None        => {
                        ty = lo.settled_type(id).try();
                        s  = lo.shape(ty).try();
                        s.form.match({
                            Record(_) => lo.construct_named(ty, c, span),
                            _         => lo.variant_call(ty, c, a.name.text, span),
                        })
                    },
                  }),
                }),
                false => {
                    checked = selected.ok_or(unsupported(span, "a call without successful semantic checking")).try();
                    receiver: Res<ExprId> = type_base.match({ true => None, false => Ok(a.base) });
                    lo.checked_invoke(id, c, checked, receiver, span)
                },
            })
        },
    })
}

// ---------------------------------------------------------------------
// JavaScript host calls (`js.bind`, see std.js)
// ---------------------------------------------------------------------

// The `js.bind` namespace a checked member call goes through, if any.
host_binding = (lo :: Lowerer, checked: CheckedCall) Res<StructDecl> {
    checked.member_provider.match({
        None     => None,
        Ok(ty)   => lo.check.types.at(ty).match({
            Named(n) => decl_at(lo.tree, n.decl).match({
                Ok(d)  => d.kind.match({
                    Struct(s) => s.native_host.match({ true => Ok(StructDecl(id: n.decl, s: s)), false => None }),
                    _         => None,
                }),
                None   => None,
            }),
            _        => None,
        }),
    })
}

// How a value of `ty` crosses into the host; None when it cannot.
marshal_of = (lo :: Lowerer, ty: TyId) Res<Marshal> {
    name = lo.prim_name(ty);
    name.is_empty().match({
        false => name.match({
            "str"  => Ok(Marshal.Text),
            "bool" => Ok(Marshal.Flag),
            "()"   => Ok(Marshal.Nothing),
            _      => lo.class_of(ty).match({
                Ok(class) => (integer(class) || float(class)).match({ true => Ok(Marshal.Number), false => None }),
                Err(_)    => None,
            }),
        }),
        true  => lo.check.types.at(ty).match({
            Named(n) => lo.alloc.String("{}.{}", lo.check.world.module_name(n.decl), n.name).match({
                Ok(q)  => q.view().match({
                    "std.js.js.Ref"     => Ok(Marshal.Handle),
                    "std.js.js.Handler" => Ok(Marshal.Handler),
                    "std.js.js.Bytes"   => Ok(Marshal.Bytes),
                    _                   => None,
                }),
                Err(_) => None,
            }),
            _        => None,
        }),
    })
}

// `Object.member(args)`: arguments in written order, each converted to its
// declared parameter type and then to its boundary form. A `Ref` or
// `Handler` crosses as its u32 id; a returned `Ref` is rebuilt from one.
host_call = (lo :: Lowerer, id: ExprId, c: Call, binding: StructDecl, name: str, span: Span)
            Res<Value, LowerError> {
    found: Res<usize> ::= None;
    binding.s.members.loop((h, i, m) {
        m.kind.match({ Function(f) => f.name.text.eq(name), _ => false }).then(() { found = Ok(i); });
    });
    index = found.ok_or(unsupported(span, "a js.bind member that is not declared")).try();
    f = binding.s.members.get(index).ok_or(unsupported(span, "a js.bind member")).try().kind.match({
        Function(f) => Ok(f),
        _           => None,
    }).ok_or(unsupported(span, "a js.bind member that is not a function")).try();
    callee = Callee(
        f: f,
        owner: binding.id,
        member: Ok(index),
        module: binding.id.module.to_usize(),
        inst: lo.alloc.Inst(),
        self_ty: None,
        generic_owner: None
    );
    receiver = f.params.get(0).match({ Ok(p) => p.name.text.eq("this"), None => false });
    (c.args.len == f.params.len).ensure(unsupported(span, "a js.bind call with omitted or named arguments")).try();
    args ::= lo.alloc.Vec<usize>();
    kinds ::= lo.alloc.Vec<Marshal>();
    c.args.loop((h, i, a) {
        param = f.params.get(i).ok_or(unsupported(a.span, "more arguments than parameters")).try();
        written = param.type.ok_or(unsupported(a.span, "an untyped js.bind parameter")).try();
        ty = lo.callee_type(callee, written).try();
        kind = marshal_of(lo, ty).ok_or(unsupported(a.span, lo.described("a type that cannot cross into JavaScript", ty))).try();
        value = lo.expr_as(a.value, ty).try();
        slot = kind.match({
            Handle  => lo.read(lo.field_place(lo.spill(value), "id", a.span).try()).try().slot,
            Handler => lo.read(lo.field_place(lo.spill(value), "id", a.span).try()).try().slot,
            _       => value.slot,
        });
        args.add(slot).try(LowerError.OutOfMemory);
        kinds.add(kind).try(LowerError.OutOfMemory);
    });
    result_ty = lo.type_of(id).try();
    result = marshal_of(lo, result_ty).ok_or(unsupported(span, lo.described("a result that cannot cross from JavaScript", result_ty))).try();
    (result.match({ Text => false, Bytes => false, Handler => false, _ => true })).ensure(unsupported(span, "a js.bind result of this type")).try();
    host_out = result.match({
        Handle => lo.slot_of(Scalar.U32).try(),
        _      => lo.temp(result_ty).try().slot,
    });
    lo.add(Instruction.Host(HostCall(
        out: host_out,
        object: binding.s.native_header.value_or(""),
        member: name,
        receiver: receiver,
        runtime: false,
        args: args,
        marshal: kinds,
        result: result
    ))).try();
    result.match({
        Handle => {
            out = lo.temp(result_ty).try();
            at = lo.slot_of(Scalar.Ptr).try();
            lo.add(Instruction.AddressOf(Address(out: at, slot: out.slot))).try();
            lo.add(Instruction.StoreValue(Store(base: at, offset: 0, value: host_out))).try();
            Ok(out)
        },
        _      => Ok(Value(slot: host_out, ty: result_ty)),
    })
}

// std.js's own operations, which the JavaScript runtime implements. They
// cross the boundary exactly as a binding's arguments do, so they are host
// calls marked `runtime`:
//   `ref.release()`              -> zrelease(id)
//   `copy(source, offset, into)` -> zcopyin(object, offset, view), a count
js_runtime_call = (lo :: Lowerer, id: ExprId, name: str, sources: Vec<Source>, span: Span)
                  Res<Value, LowerError> {
    args ::= lo.alloc.Vec<usize>();
    kinds ::= lo.alloc.Vec<Marshal>();
    name.match({
        "release" => {
            // The id crosses as a number: the runtime needs the id itself,
            // not the object it names.
            receiver = lo.expr(sources.source_expr(0, span).try()).try();
            args.add(lo.read(lo.field_place(lo.spill(receiver), "id", span).try()).try().slot).try(LowerError.OutOfMemory);
            kinds.add(Marshal.Number).try(LowerError.OutOfMemory);
            Ok(())
        },
        "copy"    => {
            source = lo.expr(sources.source_expr(0, span).try()).try();
            args.add(lo.read(lo.field_place(lo.spill(source), "id", span).try()).try().slot).try(LowerError.OutOfMemory);
            kinds.add(Marshal.Handle).try(LowerError.OutOfMemory);
            offset = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
            args.add(offset.slot).try(LowerError.OutOfMemory);
            kinds.add(Marshal.Number).try(LowerError.OutOfMemory);
            into = lo.expr(sources.source_expr(2, span).try()).try();
            args.add(into.slot).try(LowerError.OutOfMemory);
            kinds.add(Marshal.Bytes).try(LowerError.OutOfMemory);
            Ok(())
        },
        _         => Err(unsupported(span, "this std.js operation")),
    }).try();
    result_ty = lo.type_of(id).try();
    result = name.eq("copy").match({ true => Marshal.Number, false => Marshal.Nothing });
    out = lo.temp(result_ty).try();
    lo.add(Instruction.Host(HostCall(
        out: out.slot,
        object: "",
        member: name,
        receiver: false,
        runtime: true,
        args: args,
        marshal: kinds,
        result: result
    ))).try();
    Ok(out)
}

// ---------------------------------------------------------------------
// checked calls
// ---------------------------------------------------------------------

checked_invoke = (lo :: Lowerer, id: ExprId, c: Call, checked: CheckedCall,
                  dot_receiver: Res<ExprId>, span: Span) Res<Value, LowerError> {
    signature_receiver: Res<ExprId> = checked.signature.match({
        Ok(sig) => sig.receiver,
        None    => None,
    });
    checked.declaration.match({
        Ok(decl_id) => {
            decl = decl_at(lo.tree, decl_id).ok_or(unsupported(span, "a missing callee")).try();
            decl.kind.match({
                Function(f) => {
                    // A dot call on a value passes that value first unless
                    // sema resolved it as a static member.
                    recv = signature_receiver.match({
                        Ok(r) => Ok(r),
                        None  => dot_receiver.match({
                            Ok(r) => (f.params.len == c.args.len + 1).match({ true => Ok(r), false => None }),
                            None  => None,
                        }),
                    });
                    callee = Callee(
                        f: f,
                        owner: decl_id,
                        member: None,
                        module: decl_id.module.to_usize(),
                        inst: lo.call_inst(checked.inst).try(),
                        self_ty: None,
                        generic_owner: None
                    );
                    sources = lo.bind_sources(f, c, recv, span).try();
                    lo.invoke(id, callee, sources, c, span)
                },
                Struct(_)   => {
                    ty = lo.settled_type(id).try();
                    lo.construct_named(ty, c, span)
                },
                _           => Err(unsupported(span, "a call to this kind of declaration")),
            })
        },
        None        => {
            receiver = signature_receiver.match({ Ok(r) => Ok(r), None => dot_receiver })
                .ok_or(unsupported(span, "a member call without a receiver")).try();
            name = lo.stripped(c.callee).kind.match({ Access(a) => a.name.text, _ => "" });
            lo.member_call(id, c, checked, receiver, name, span)
        },
    })
}

// Run a resolved callee: compiler-provided bodiless operations, inlined
// closure-taking bodies, or a call to a real function instance.
invoke* = (lo :: Lowerer, id: ExprId, open: Callee, written: Vec<Source>, c: Call, span: Span)
          Res<Value, LowerError> {
    callee = lo.settle_range(lo.settle_params(open, written).try()).try();
    sources = callee.f.body.match({
        None  => written,
        Ok(_) => lo.in_written_order(callee, written, c).try(),
    });
    callee.f.body.match({
        None    => lo.intrinsic(id, callee, sources, c, span),
        Ok(_)   => lo.higher_order(callee.f).match({
            true  => lo.inline_call(callee, sources, span),
            false => lo.real_call(callee, sources, span),
        }),
    })
}

// A parameter written as a bare type parameter (`range: R`) that the
// checked substitution left open takes its argument's checked type.
settle_params* = (lo :: Lowerer, callee: Callee, sources: Vec<Source>) Res<Callee, LowerError> {
    bare = Callee(
        f: callee.f,
        owner: callee.owner,
        member: callee.member,
        module: callee.module,
        inst: lo.alloc.Inst(),
        self_ty: callee.self_ty,
        generic_owner: callee.generic_owner
    );
    extra ::= lo.alloc.Inst();
    callee.f.params.loop((h, i, p) {
        p.type.when_ok((t) {
            raw = lo.callee_type(bare, t).try();
            actual: Res<TyId> = sources.get(i).value_or(Source.Absent).match({
                Given(e)    => lo.type_of(e).match({ Ok(a) => Ok(a), Err(_) => None }),
                Computed(v) => Ok(v.ty),
                Located(l)  => Ok(l.ty),
                Absent      => None,
            });
            actual.when_ok((a) { lo.unify(raw, a, callee.inst, extra).try(); });
        });
    });
    (extra.len() == 0).match({
        true  => Ok(callee),
        false => {
            inst ::= lo.alloc.Inst();
            // New bindings first: an Inst keeps the first binding of a var.
            [extra, callee.inst].loop((part) {
                Range(0, part.len()).loop((k) {
                    part.var_at(k).when_ok((v) {
                        part.arg_at(k).when_ok((a) { inst.bind(v, a).try(LowerError.OutOfMemory); });
                    });
                });
            });
            Ok(Callee(
                f: callee.f,
                owner: callee.owner,
                member: callee.member,
                module: callee.module,
                inst: inst,
                self_ty: callee.self_ty,
                generic_owner: callee.generic_owner
            ))
        },
    })
}

// Bind each type parameter in a parameter's written type that the checked
// substitution left open to the matching part of the argument's type.
unify = (lo :: Lowerer, raw: TyId, actual: TyId, known: Inst, extra :: Inst) Res<(), LowerError> {
    lo.check.types.at(raw).match({
        Var(_)   => (!lo.settled(lo.arg_for(known, raw)) && lo.settled(actual)).then(() {
            extra.bind(raw, actual).try(LowerError.OutOfMemory);
        }).ignore_none(),
        Named(r) => lo.check.types.at(actual).match({
            Named(a) => (r.decl == a.decl).then(() {
                r.args.loop((h, k, part) {
                    a.args.get(k).when_ok((other) { lo.unify(part, other, known, extra).try(); });
                });
            }).ignore_none(),
            _        => (),
        }),
        Res(r)   => lo.check.types.at(actual).match({
            Res(a) => {
                lo.unify(r.value, a.value, known, extra).try();
                lo.unify(r.error, a.error, known, extra).try();
            },
            _      => (),
        }),
        Array(r) => lo.check.types.at(actual).match({
            Array(a) => lo.unify(r.elem, a.elem, known, extra).try(),
            _        => (),
        }),
        _        => (),
    });
    Ok(())
}

// A traversal `<R: Seq<T>, T>` whose element type sema left open takes it
// from the range: an array's element, str's byte, a Range's bound type, or
// the argument of the range type's Seq impl.
settle_range = (lo :: Lowerer, callee: Callee) Res<Callee, LowerError> {
    range_var: Res<TyId> = lo.var_named(callee.inst, "R");
    elem_var: Res<TyId> = lo.var_named(callee.inst, "T");
    fix: Res<Pair> = range_var.match({
        None    => None,
        Ok(rv)  => elem_var.match({
            None    => None,
            Ok(tv)  => {
                range = lo.arg_for(callee.inst, rv);
                elem = lo.arg_for(callee.inst, tv);
                (lo.settled(range) && !lo.settled(elem)).match({
                    true  => lo.range_elem(range).try().match({
                        Ok(e) => Ok(Pair(var: tv, ty: e)),
                        None  => None,
                    }),
                    false => None,
                })
            },
        }),
    });
    fix.match({
        None    => Ok(callee),
        Ok(p)   => {
            inst ::= lo.alloc.Inst();
            inst.bind(p.var, p.ty).try(LowerError.OutOfMemory);
            Range(0, callee.inst.len()).loop((k) {
                callee.inst.var_at(k).when_ok((v) {
                    callee.inst.arg_at(k).when_ok((a) { inst.bind(v, a).try(LowerError.OutOfMemory); });
                });
            });
            Ok(Callee(
                f: callee.f,
                owner: callee.owner,
                member: callee.member,
                module: callee.module,
                inst: inst,
                self_ty: callee.self_ty,
                generic_owner: callee.generic_owner
            ))
        },
    })
}

Pair = { var: TyId, ty: TyId }

var_named = (lo :: Lowerer, inst: Inst, name: str) Res<TyId> {
    found: Res<TyId> = loop<TyId>((h) {
        Range(0, inst.len()).loop((k) {
            inst.var_at(k).when_ok((v) {
                lo.check.types.at(v).match({
                    Var(tv) => tv.name.eq(name).then(() { h.break(v); }).ignore_none(),
                    _       => (),
                });
            });
        });
        h.break();
    });
    found
}

arg_for = (lo :: Lowerer, inst: Inst, var: TyId) TyId {
    found: Res<TyId> = loop<TyId>((h) {
        Range(0, inst.len()).loop((k) {
            (inst.var_at(k).match({ Ok(v) => v == var, None => false })).then(() {
                inst.arg_at(k).when_ok((a) { h.break(a); });
            });
        });
        h.break();
    });
    found.value_or(var)
}

range_elem* = (lo :: Lowerer, range: TyId) Res<Res<TyId>, LowerError> {
    lo.check.types.at(range).match({
        Array(a) => Ok(Ok(a.elem)),
        Prim(p)  => Ok(p.name.eq("str").match({ true => Ok(lo.prim("u8").try()), false => None })),
        Named(n) => lo.qualified(range).eq("std.core.range.Range").match({
            true  => Ok(Ok(lo.range_bound(range).try())),
            false => lo.impl_range_elem(range, n),
        }),
        _        => Ok(None),
    })
}

// The type of a Range's bounds and values: the type its `start` holds.
range_bound = (lo :: Lowerer, range: TyId) Res<TyId, LowerError> {
    found ::= lo.alloc.Vec<Found>();
    lo.check.members_of(range, "start", found).try(LowerError.OutOfMemory);
    found.get(0).match({
        Ok(f) => Ok(f.ty),
        None  => lo.prim("usize"),
    })
}

impl_range_elem = (lo :: Lowerer, range: TyId, n: TyNamed) Res<Res<TyId>, LowerError> {
    ids ::= lo.alloc.Vec<ImplId>();
    lo.check.world.impls_named(lo.tree, n.name, ids).try(LowerError.OutOfMemory);
    inst = lo.check.inst_of_named(n).try(LowerError.OutOfMemory);
    found: Res<TyId> = loop<TyId>((h) {
        ids.loop((id) {
            lo.check.world.impl_at(lo.tree, id).when_ok((i) {
                lo.check.type_memo.get(i.bound).when_ok((bound) {
                    lo.check.types.at(bound).match({
                        Named(b) => (b.name.eq("Seq")).then(() {
                            b.args.get(0).when_ok((arg) {
                                h.break(lo.check.subst(arg, inst).try(LowerError.OutOfMemory));
                            });
                        }).ignore_none(),
                        _        => (),
                    });
                });
            });
        });
        h.break();
    });
    Ok(found)
}

// The call's substitution with the caller's own parameters resolved.
call_inst* = (lo :: Lowerer, raw: Inst) Res<Inst, LowerError> {
    inst ::= lo.alloc.Inst();
    Range(0, raw.len()).loop((i) {
        v = raw.var_at(i).ok_or(unsupported(nowhere(), "a malformed instantiation")).try();
        a = raw.arg_at(i).ok_or(unsupported(nowhere(), "a malformed instantiation")).try();
        inst.bind(v, lo.concrete(a).try()).try(LowerError.OutOfMemory);
    });
    Ok(inst)
}

// Arguments in parameter order: the receiver first, then positional
// arguments, named arguments by name; omitted trailing parameters stay
// Absent (a Res parameter then receives None).
bind_sources* = (lo :: Lowerer, f: Function, c: Call, receiver: Res<ExprId>, span: Span)
                Res<Vec<Source>, LowerError> {
    out ::= lo.alloc.Vec<Source>();
    f.params.loop((_) { out.add(Source.Absent).try(LowerError.OutOfMemory); });
    next: usize ::= 0;
    receiver.when_ok((r) {
        out.set(0, Source.Given(r));
        next = 1;
    });
    // A variadic tail (`args: ...`) is read from the call by the operations
    // that declare one.
    variadic = (f.params.len > 0) && f.params.get(f.params.len - 1).match({
        Ok(p) => p.type.match({
            Ok(t) => lo.tree.type_at(t).kind.match({ Variadic => true, _ => false }),
            None  => false,
        }),
        None  => false,
    });
    c.args.loop((a) {
        a.name.match({
            None    => {
                (next < out.len || variadic).ensure(unsupported(a.span, "more arguments than parameters")).try();
                (next < out.len).then(() { out.set(next, Source.Given(a.value)); });
                next = next + 1;
            },
            Ok(name) => {
                found: Res<usize> = loop<usize>((h) {
                    f.params.loop((ph, i, p) { p.name.text.eq(name.text).then(() { h.break(i); }); });
                    h.break();
                });
                index = found.ok_or(unsupported(a.span, "a named argument without a parameter")).try();
                out.set(index, Source.Given(a.value));
            },
        });
    });
    Ok(out)
}

// By-value arguments evaluate in the order they are written (the receiver
// first), whatever order their parameters have.
in_written_order = (lo :: Lowerer, callee: Callee, sources: Vec<Source>, c: Call)
                   Res<Vec<Source>, LowerError> {
    out ::= lo.alloc.Vec<Source>();
    sources.loop((s) { out.add(s).try(LowerError.OutOfMemory); });
    order ::= lo.alloc.Vec<ExprId>();
    // The receiver, when present, is the first argument not written in
    // the parentheses.
    sources.loop((s) {
        s.match({
            Given(e) => c.args.find((a) { a.value == e }).match({
                None    => order.add(e).try(LowerError.OutOfMemory),
                Ok(_)   => (),
            }),
            _        => (),
        });
    });
    c.args.loop((a) { order.add(a.value).try(LowerError.OutOfMemory); });
    order.loop((e) {
        source_index(sources, e).when_ok((i) {
            p = callee.f.params.get(i).ok_or(unsupported(nowhere(), "a missing parameter")).try();
            ty = lo.param_type(callee, i).try();
            special = lo.is_fn_type(ty) || lo.is_capability(ty);
            (!special).then(() {
                p.mutable.match({
                    // A place is resolved now; a temporary is computed now.
                    true  => lo.place_of(e).try().match({
                        Ok(place) => { out.set(i, Source.Located(place)); },
                        None      => { out.set(i, Source.Computed(lo.expr_as(e, ty).try())); },
                    }),
                    false => { out.set(i, Source.Computed(lo.expr_as(e, ty).try())); },
                });
            });
        });
    });
    Ok(out)
}

field_index = (fields: Vec<FieldAt>, name: str) Res<usize> {
    found: Res<usize> = loop<usize>((h) {
        fields.loop((fh, i, f) { f.name.eq(name).then(() { h.break(i); }); });
        h.break();
    });
    found
}

source_index = (sources: Vec<Source>, e: ExprId) Res<usize> {
    found: Res<usize> = loop<usize>((h) {
        sources.loop((sh, i, s) {
            s.match({ Given(g) => (g == e).then(() { h.break(i); }), _ => Ok(()) });
        });
        h.break();
    });
    found
}

// A callee taking a closure is inlined so the closure's `.try()` and
// `h.break()` keep their meaning.
higher_order = (lo :: Lowerer, f: Function) bool {
    f.params.find((p) {
        p.type.match({
            Ok(t) => lo.tree.type_at(t).kind.match({ Fn(_) => true, _ => false }),
            None  => false,
        })
    }).match({ Ok(_) => true, None => false })
}

param_type* = (lo :: Lowerer, callee: Callee, i: usize) Res<TyId, LowerError> {
    p = callee.f.params.get(i).ok_or(unsupported(nowhere(), "a missing parameter")).try();
    t = p.type.ok_or(unsupported(p.span, "an inferred parameter type")).try();
    lo.callee_type(callee, t)
}

result_type* = (lo :: Lowerer, callee: Callee) Res<TyId, LowerError> {
    callee.f.ret.match({
        None    => Ok(lo.unit_ty),
        Ok(t)   => lo.callee_type(callee, t),
    })
}

// Evaluate one argument for a by-value parameter.
argument_value* = (lo :: Lowerer, source: Source, ty: TyId, span: Span) Res<Value, LowerError> {
    source.match({
        Given(e)    => lo.expr_as(e, ty),
        Absent      => lo.variant_value(ty, "None", None, span),
        Computed(v) => lo.coerce(v, ty),
        Located(p)  => lo.coerce(lo.read(p).try(), ty),
    })
}

// A mutable parameter aliases the caller's place; a temporary gets one.
argument_place* = (lo :: Lowerer, source: Source, ty: TyId, span: Span) Res<Place, LowerError> {
    place = lo.source_place(source, ty, span).try();
    // An implementor's place passed as a mutable bound (`out :: Sink` given
    // a String) becomes a handle that points at it.
    (place.ty == ty || !lo.settled(ty)).match({
        true  => Ok(place),
        false => lo.handle_for_place(place, ty).try().match({
            Ok(handle) => Ok(lo.spill(handle)),
            None       => Ok(place),
        }),
    })
}

source_place = (lo :: Lowerer, source: Source, ty: TyId, span: Span) Res<Place, LowerError> {
    source.match({
        Computed(v) => Ok(lo.spill(lo.copy_value(v).try())),
        Located(p)  => Ok(p),
        Absent      => Err(unsupported(span, "an omitted mutable argument")),
        Given(e)    => lo.place_of(e).try().match({
            Ok(place) => Ok(place),
            None      => {
                value = lo.expr_as(e, ty).try();
                Ok(lo.spill(value))
            },
        }),
    })
}

real_call* = (lo :: Lowerer, callee: Callee, sources: Vec<Source>, span: Span)
             Res<Value, LowerError> {
    index = lo.enqueue(callee).try();
    args ::= lo.alloc.Vec<usize>();
    callee.f.params.loop((h, i, p) {
        ty = lo.param_type(callee, i).try();
        source = sources.get(i).value_or(Source.Absent);
        slot = p.mutable.match({
            true  => lo.address(lo.argument_place(source, ty, span).try()).try(),
            false => lo.argument_value(source, ty, span).try().slot,
        });
        args.add(slot).try(LowerError.OutOfMemory);
    });
    ret = lo.result_type(callee).try();
    out = lo.temp(ret).try();
    lo.add(Instruction.Invoke(Invocation(out: out.slot, function: index, args: args))).try();
    Ok(out)
}

// Inline a callee body: closure parameters bind the caller's lambdas,
// mutable parameters alias the caller's places.
inline_call* = (lo :: Lowerer, open: Callee, sources: Vec<Source>, span: Span)
               Res<Value, LowerError> {
    (lo.depth < 24).ensure(unsupported(span, "recursion through closure-taking functions")).try();
    callee = lo.settle_closures(open, sources, span).try();
    body = callee.f.body.ok_or(unsupported(span, "a bodiless callee")).try();
    kinds ::= lo.alloc.Vec<LocalKind>();
    callee.f.params.loop((h, i, p) {
        ty = lo.param_type(callee, i).try();
        source = sources.get(i).value_or(Source.Absent);
        kind = lo.is_fn_type(ty).match({
            true  => LocalKind.Closure(lo.closure_of(source, span).try()),
            false => lo.is_capability(ty).match({
                true  => LocalKind.Capability(ty),
                false => p.mutable.match({
                    true  => LocalKind.Ref(lo.argument_place(source, ty, span).try()),
                    false => {
                        value = lo.argument_value(source, ty, span).try();
                        LocalKind.Direct(lo.copy_value(value).try())
                    },
                }),
            }),
        });
        kinds.add(kind).try(LowerError.OutOfMemory);
    });
    ret = lo.result_type(callee).try();
    frame = lo.push_frame(callee.inst, callee.module, ret, callee.self_ty, Ok(callee)).try();
    saved = lo.use_frame(frame);
    lo.deeper();
    mark = lo.locals.len;
    callee.f.params.loop((h, i, p) {
        kinds.get(i).when_ok((k) { lo.bind_local(p.name.text, k).try(); });
    });
    value = lo.block(body).try();
    here = lo.here();
    coerced = lo.coerce(value, ret).try();
    lo.add(Instruction.Copy(Move(out: here.ret_slot, source: coerced.slot))).try();
    lo.enter(here.ret_block).try();
    lo.release_locals(mark);
    lo.shallower();
    lo.use_frame(saved);
    result = Value(slot: here.ret_slot, ty: ret);
    lo.copy_value(result)
}

// A type parameter that only a closure's result determines (`then<T>` with
// `() T`) takes the type of the lambda body written for it.
settle_closures = (lo :: Lowerer, callee: Callee, sources: Vec<Source>, span: Span)
                  Res<Callee, LowerError> {
    extra ::= lo.alloc.Inst();
    callee.f.params.loop((h, i, _) {
        ty = lo.param_type(callee, i).try();
        lo.check.types.at(ty).match({
            Fn(signature) => lo.check.types.at(signature.ret).match({
                Var(_) => sources.get(i).value_or(Source.Absent).match({
                    Given(e) => lo.lambda_result(e).try().when_ok((result) {
                        extra.bind(signature.ret, result).try(LowerError.OutOfMemory);
                    }).ignore_none(),
                    _        => (),
                }),
                _      => (),
            }),
            _             => (),
        });
    });
    (extra.len() == 0).match({
        true  => Ok(callee),
        false => {
            inst ::= lo.alloc.Inst();
            // New bindings first: an Inst keeps the first binding of a var.
            [extra, callee.inst].loop((part) {
                Range(0, part.len()).loop((k) {
                    part.var_at(k).when_ok((v) {
                        part.arg_at(k).when_ok((a) { inst.bind(v, a).try(LowerError.OutOfMemory); });
                    });
                });
            });
            Ok(Callee(
                f: callee.f,
                owner: callee.owner,
                member: callee.member,
                module: callee.module,
                inst: inst,
                self_ty: callee.self_ty,
                generic_owner: callee.generic_owner
            ))
        },
    })
}

// The checked type of a lambda body's value, when the argument is a lambda.
lambda_result = (lo :: Lowerer, e: ExprId) Res<Res<TyId>, LowerError> {
    lo.stripped(e).kind.match({
        Lambda(l) => {
            block = lo.tree.block_at(l.body);
            tail: Res<ExprId> = block.value.match({
                Ok(v) => Ok(v),
                None  => block.stmts.get(block.stmts.len - 1).match({
                    Ok(s) => s.kind.match({ Expr(x) => Ok(x.expr), _ => None }),
                    None  => None,
                }),
            });
            tail.match({
                None    => Ok(Ok(lo.unit_ty)),
                Ok(t)   => {
                    ty = lo.type_of(t).try();
                    Ok(lo.settled(ty).match({ true => Ok(ty), false => None }))
                },
            })
        },
        _         => Ok(None),
    })
}

is_fn_type = (lo :: Lowerer, ty: TyId) bool {
    lo.check.types.at(ty).match({ Fn(_) => true, _ => false })
}

closure_of = (lo :: Lowerer, source: Source, span: Span) Res<LambdaRef, LowerError> {
    e = source.match({ Given(e) => Ok(e), _ => None })
        .ok_or(unsupported(span, "an omitted closure argument")).try();
    node = lo.stripped(e);
    node.kind.match({
        Lambda(_) => Ok(LambdaRef(expr: e.unparen(lo), frame: lo.frame)),
        Name(n)   => lo.lookup(n.text).match({
            Ok(Closure(l)) => Ok(l),
            _              => Err(unsupported(node.span, "a named function passed as a closure")),
        }),
        _         => Err(unsupported(node.span, "a computed closure argument")),
    })
}

unparen = (id: ExprId, lo :: Lowerer) ExprId {
    lo.tree.expr_at(id).kind.match({ Paren(p) => p.inner.unparen(lo), _ => id })
}

// ---------------------------------------------------------------------
// constructions
// ---------------------------------------------------------------------

// `Record(name: value, ..)` with written defaults for omitted fields.
construct_named* = (lo :: Lowerer, ty: TyId, c: Call, span: Span) Res<Value, LowerError> {
    out = lo.temp(ty).try();
    // A record of no bytes is fully written by writing nothing.
    lo.is_unit(ty).then(() { lo.add(Instruction.Constant(Const(out: out.slot, value: 0))).try(); });
    s = lo.shape(ty).try();
    fields = s.form.match({ Record(f) => Ok(f), _ => None })
        .ok_or(unsupported(span, "a construction of a non-record type")).try();
    base = lo.slot_of(Scalar.Ptr).try();
    // Arguments evaluate in written order; omitted fields then take their
    // defaults in declaration order.
    given ::= lo.alloc.Vec<Res<Value>>();
    fields.loop((_) { given.add(None).try(LowerError.OutOfMemory); });
    c.args.loop((h, i, a) {
        index = a.name.match({
            Ok(n) => field_index(fields, n.text),
            None  => Ok(i),
        }).ok_or(unsupported(a.span, "an argument naming no field")).try();
        field = fields.get(index).ok_or(unsupported(a.span, "more arguments than fields")).try();
        given.set(index, Ok(lo.expr_as(a.value, field.ty).try()));
    });
    fields.loop((h, i, field) {
        value = given.get(i).value_or(None).match({
            Ok(v) => v,
            None  => lo.field_default(lo.struct_decl(ty).try(), ty, field, span).try(),
        });
        lo.add(Instruction.AddressOf(Address(out: base, slot: out.slot))).try();
        lo.add(Instruction.StoreValue(Store(base: base, offset: field.offset, value: value.slot))).try();
    });
    Ok(out)
}

StructDecl = { id: DeclId, s: Struct }

struct_decl = (lo :: Lowerer, ty: TyId) Res<StructDecl, LowerError> {
    lo.check.types.at(ty).match({
        Named(n) => decl_at(lo.tree, n.decl).match({
            Ok(d) => d.kind.match({
                Struct(s) => Ok(StructDecl(id: n.decl, s: s)),
                _         => Err(unsupported(nowhere(), "a construction of a non-struct")),
            }),
            None  => Err(unsupported(nowhere(), "a missing struct declaration")),
        }),
        _        => Err(unsupported(nowhere(), "a construction of a non-named type")),
    })
}

// An omitted field takes its written default, evaluated in the declaring
// module; an omitted Res field is None.
field_default = (lo :: Lowerer, decl: StructDecl, ty: TyId, field: FieldAt, span: Span)
                Res<Value, LowerError> {
    written: Res<ExprId> = decl.s.members.find((m) { m.named(field.name) }).match({
        Ok(m) => m.kind.match({ Field(f) => f.value, _ => None }),
        None  => None,
    });
    written.match({
        Ok(e) => {
            inst = lo.check.types.at(ty).match({
                Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
                _        => lo.alloc.Inst(),
            });
            frame = lo.push_frame(inst, decl.id.module.to_usize(), lo.unit_ty, Ok(ty), None).try();
            saved = lo.use_frame(frame);
            value = lo.expr_as(e, field.ty);
            lo.use_frame(saved);
            value
        },
        None  => lo.variant_value(field.ty, "None", None, span),
    })
}

// ---------------------------------------------------------------------
// compiler-provided operations
// ---------------------------------------------------------------------

intrinsic = (lo :: Lowerer, id: ExprId, callee: Callee, sources: Vec<Source>, c: Call, span: Span)
            Res<Value, LowerError> {
    decl = callee.owner;
    module = lo.check.world.module_name(decl);
    name = callee.f.name.text;
    // A machine primitive (std.simd, volatile access, u128 arithmetic) has
    // no native lowering yet; name the operation instead of its operands.
    lo.check.primitives.get(decl).match({
        Ok(p) => machine_op(p.name).match({
            Ok(op) => Err(unsupported(span, machine_refusal(op))),
            None   => Ok(()),
        }),
        None  => Ok(()),
    }).try();
    // Numeric operations are free functions validated by declaration.
    numeric = callee.member.match({ None => true, Ok(_) => false });
    conversion = numeric.match({ true => lo.check.numeric_conversions.get(decl), false => None });
    bits = numeric.match({ true => lo.check.integer_bits.get(decl), false => None });
    conversion.match({
        Ok(_) => lo.conversion(id, sources, span),
        None  => bits.match({
            Ok(b) => lo.bit_operation(id, b.name, sources, span),
            None  => module.match({
                "std.core.loop.loop_iter"   => lo.loop_call(id, callee.f, sources, span),
                "std.mem.mem_ptr"           => lo.pointer_call(id, name, sources, span),
                "std.env.env"               => lo.env_call(id, name, c, sources, span),
                "std.mem.mem_arena"         => lo.mem_call(id, name, sources, span),
                "std.sys.sys"               => lo.sys_call(id, name, sources, span),
                // `std.js.wait()`: suspend until an event handler fires.
                "std.js.js"                 => name.eq("wait").match({
                    true  => {
                        out = lo.temp(lo.type_of(id).try()).try();
                        lo.add(Instruction.Wait(out.slot)).try();
                        Ok(out)
                    },
                    false => js_runtime_call(lo, id, name, sources, span),
                }),
                "std.text.text_string"      => lo.string_call(id, name, c, sources, span),
                "std.text.text_fmt"         => name.eq("fmt").match({
                    // `fmt(out :: Sink, fmt, args..)`: formatting through a Sink.
                    true  => {
                        out_source = sources.get(0).value_or(Source.Absent);
                        out_ty = out_source.match({ Given(e) => lo.type_of(e), _ => Err(unsupported(span, "fmt without a sink")) }).try();
                        place = lo.argument_place(out_source, out_ty, span).try();
                        written_first = out_source.match({
                            Given(e) => c.args.get(0).match({ Ok(a) => a.value == e, None => false }),
                            _        => false,
                        });
                        lo.format_call(c.args, written_first.match({ true => 1, false => 0 }), false, FmtTo.Into(place), span).try();
                        lo.variant_value(lo.type_of(id).try(), "Ok", Ok(lo.unit().try()), span)
                    },
                    false => Err(unsupported(span, "this formatting operation")),
                }),
                _                           => Err(unsupported(span, lo.alloc.String("the compiler-provided operation `{}.{}`", module, name).match({ Ok(t) => t.view(), Err(_) => "a compiler-provided operation" }))),
            }),
        }),
    })
}

source_expr* = (sources: Vec<Source>, i: usize, span: Span) Res<ExprId, LowerError> {
    sources.get(i).value_or(Source.Absent).match({
        Given(e) => Ok(e),
        _        => Err(unsupported(span, "an omitted argument")),
    })
}

conversion = (lo :: Lowerer, id: ExprId, sources: Vec<Source>, span: Span) Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    arg = lo.expr(sources.source_expr(0, span).try()).try();
    lo.check.types.at(ty).match({
        Res(r) => {
            target = lo.concrete(r.value).try();
            converted = lo.temp(target).try();
            lo.add(Instruction.Cast(Convert(out: converted.slot, input: arg.slot))).try();
            // Checked: the value fits when converting back reproduces it.
            back = lo.temp(arg.ty).try();
            lo.add(Instruction.Cast(Convert(out: back.slot, input: converted.slot))).try();
            fits = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: fits, left: back.slot, right: arg.slot, op: Op.Equal, span: nowhere()))).try();
            same_sign = lo.sign_agrees(arg, converted).try();
            both = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: both, left: fits, right: same_sign, op: Op.And, span: nowhere()))).try();
            out = lo.temp(ty).try();
            yes  = lo.label().try();
            no   = lo.label().try();
            done = lo.label().try();
            lo.branch_to(both, yes, no).try();
            lo.start(yes);
            ok = lo.variant_value(ty, "Ok", Ok(converted), span).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: ok.slot))).try();
            lo.jump(done).try();
            lo.start(no);
            none = lo.variant_value(ty, "None", None, span).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: none.slot))).try();
            lo.enter(done).try();
            Ok(out)
        },
        _      => {
            out = lo.temp(ty).try();
            lo.add(Instruction.Cast(Convert(out: out.slot, input: arg.slot))).try();
            Ok(out)
        },
    })
}

// A signed negative never fits an unsigned target and an unsigned value
// above the signed maximum never fits a signed one; comparing the signs of
// source and result catches both after a round trip.
sign_agrees = (lo :: Lowerer, from: Value, to: Value) Res<usize, LowerError> {
    from_signed = signed(lo.class_of(from.ty).try());
    to_signed = signed(lo.class_of(to.ty).try());
    (from_signed == to_signed).match({
        true  => lo.word_const(Scalar.Bool, 1),
        false => {
            // The source must be non-negative when read as signed.
            zero_from = lo.temp(from.ty).try();
            lo.add(Instruction.Constant(Const(out: zero_from.slot, value: 0))).try();
            signed_value = from_signed.match({ true => from, false => to });
            zero = lo.temp(signed_value.ty).try();
            lo.add(Instruction.Constant(Const(out: zero.slot, value: 0))).try();
            test = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: test, left: signed_value.slot, right: zero.slot, op: Op.GreaterEqual, span: nowhere()))).try();
            Ok(test)
        },
    })
}

bit_operation = (lo :: Lowerer, id: ExprId, name: str, sources: Vec<Source>, span: Span)
                Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    // `shift_right` on a signed word is arithmetic; the IR's `Shr` is the
    // logical shift, so a signed receiver has no lowering yet.
    arithmetic = name.eq("shift_right") && signed(lo.class_of(ty).try());
    arithmetic.match({
        true  => Err(unsupported(span, "an arithmetic shift of a signed word")),
        false => Ok(()),
    }).try();
    left = lo.expr_as(sources.source_expr(0, span).try(), ty).try();
    count_ty = name.is_in(["bit_xor", "bit_and"]).match({ true => ty, false => lo.prim("usize").try() });
    right = lo.expr_as(sources.source_expr(1, span).try(), count_ty).try();
    op = name.match({
        "bit_xor"      => Op.Xor,
        "bit_and"      => Op.And,
        "rotate_right" => Op.Rotr,
        _              => Op.Shr,
    });
    out = lo.temp(ty).try();
    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: left.slot, right: right.slot, op: op, span: span))).try();
    Ok(out)
}

// Ptr<T> operations. Element sizes come from T at this instantiation.
pointer_call = (lo :: Lowerer, id: ExprId, name: str, sources: Vec<Source>, span: Span)
               Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    name.match({
        "null_ptr" => lo.constant(ty, 0),
        _          => {
            receiver = lo.expr(sources.source_expr(0, span).try()).try();
            elem = lo.pointee(receiver.ty).try();
            stride = lo.element_size(elem).try();
            name.match({
                "read"      => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    lo.read(Place(base: Base.Through(at), offset: 0, ty: elem))
                },
                // A take is a read whose source slot the caller retires;
                // the bytes move exactly as a read copies them.
                "take"      => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    lo.read(Place(base: Base.Through(at), offset: 0, ty: elem))
                },
                "write"     => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    value = lo.expr_as(sources.source_expr(2, span).try(), elem).try();
                    lo.write(Place(base: Base.Through(at), offset: 0, ty: elem), value).try();
                    lo.unit()
                },
                "offset"    => {
                    at = lo.element_at(receiver, sources, stride, span).try();
                    Ok(Value(slot: at, ty: ty))
                },
                "back"      => {
                    count = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: bytes, op: Op.WrapSub, span: nowhere()))).try();
                    Ok(out)
                },
                "bytes"     => {
                    count = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    Ok(Value(slot: bytes, ty: ty))
                },
                "copy_from" => {
                    source = lo.expr(sources.source_expr(1, span).try()).try();
                    count = lo.expr_as(sources.source_expr(2, span).try(), lo.prim("usize").try()).try();
                    bytes = lo.scaled(count.slot, stride).try();
                    lo.add(Instruction.CopyBytes(CopyMem(dest: receiver.slot, source: source.slot, bytes: bytes))).try();
                    lo.unit()
                },
                "to"        => Ok(Value(slot: receiver.slot, ty: ty)),
                "is_null"   => {
                    zero = lo.word_const(Scalar.Ptr, 0).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: zero, op: Op.Equal, span: nowhere()))).try();
                    Ok(out)
                },
                "same"      => {
                    other = lo.expr(sources.source_expr(1, span).try()).try();
                    out = lo.temp(ty).try();
                    lo.add(Instruction.BinaryValue(Binary(out: out.slot, left: receiver.slot, right: other.slot, op: Op.Equal, span: nowhere()))).try();
                    Ok(out)
                },
                _           => Err(unsupported(span, "this pointer operation")),
            })
        },
    })
}

pointee = (lo :: Lowerer, ty: TyId) Res<TyId, LowerError> {
    lo.check.types.at(ty).match({
        Named(n) => n.args.get(0).ok_or(unsupported(nowhere(), "a Ptr without an element type")),
        _        => Err(unsupported(nowhere(), "a pointer operation on a non-pointer")),
    })
}

element_size = (lo :: Lowerer, ty: TyId) Res<usize, LowerError> {
    class = lo.class_of(ty).try();
    Ok(size_of(class))
}

scaled = (lo :: Lowerer, count: usize, stride: usize) Res<usize, LowerError> {
    (stride == 1).match({
        true  => Ok(count),
        false => {
            factor = lo.word_const(Scalar.U64, stride.to_i64_bits()).try();
            out = lo.slot_of(Scalar.U64).try();
            lo.add(Instruction.BinaryValue(Binary(out: out, left: count, right: factor, op: Op.WrapMul, span: nowhere()))).try();
            Ok(out)
        },
    })
}

element_at = (lo :: Lowerer, pointer: Value, sources: Vec<Source>, stride: usize, span: Span)
             Res<usize, LowerError> {
    index = lo.expr_as(sources.source_expr(1, span).try(), lo.prim("usize").try()).try();
    bytes = lo.scaled(index.slot, stride).try();
    out = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.BinaryValue(Binary(out: out, left: pointer.slot, right: bytes, op: Op.WrapAdd, span: nowhere()))).try();
    Ok(out)
}

// Console and environment operations supplied by the runtime.
env_call = (lo :: Lowerer, id: ExprId, name: str, c: Call, sources: Vec<Source>, span: Span)
           Res<Value, LowerError> {
    name.match({
        "println" => lo.print_call(c.args, 0, true, Stream.Out, span),
        "error"   => lo.print_call(c.args, 0, false, Stream.Err, span),
        "errorln" => lo.print_call(c.args, 0, true, Stream.Err, span),
        "flush"   => {
            ty = lo.type_of(id).try();
            lo.variant_value(ty, "Ok", Ok(lo.unit().try()), span)
        },
        "read"    => lo.receiver_kind(sources).eq("Stdin").match({
            true  => lo.stdin_read(id, sources, span),
            false => lo.sys_env_call(id, "fs_read", lo.without_receiver(sources).try(), c, span),
        }),
        _         => {
            // The remaining capabilities are Zen functions over std.sys.
            target = name.match({
                "var"         => Ok("var"),
                "read"        => Ok("fs_read"),
                "write"       => Ok("fs_write"),
                "exists"      => Ok("fs_exists"),
                "is_dir"      => Ok("fs_is_dir"),
                "since_start" => Ok("since_start"),
                "unix"        => Ok("unix"),
                _             => None,
            }).ok_or(unsupported(span, "this environment operation")).try();
            lo.sys_env_call(id, target, lo.without_receiver(sources).try(), c, span)
        },
    })
}

without_receiver = (lo :: Lowerer, sources: Vec<Source>) Res<Vec<Source>, LowerError> {
    rest ::= lo.alloc.Vec<Source>();
    sources.loop((h, i, s) { (i > 0).then(() { rest.add(s).try(LowerError.OutOfMemory); }); });
    Ok(rest)
}

// `env.in.read(buf, n)`: at most `n` bytes onto the end of `buf`, within
// its reserved capacity (more is `Full`); `len` advances by the count read.
// This writes the Vec's fields, as the C backend's floor does.
stdin_read = (lo :: Lowerer, id: ExprId, sources: Vec<Source>, span: Span) Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    usize_ty = lo.prim("usize").try();
    buf_source = sources.get(1).value_or(Source.Absent);
    buf_ty = buf_source.match({ Given(e) => lo.type_of(e), _ => Err(unsupported(span, "a stdin read without a buffer")) }).try();
    buf = lo.argument_place(buf_source, buf_ty, span).try();
    n = lo.argument_value(sources.get(2).value_or(Source.Absent), usize_ty, span).try();
    len_place = lo.field_place(buf, "len", span).try();
    data = lo.read(lo.field_place(buf, "data", span).try()).try();
    len = lo.read(len_place).try();
    cap = lo.read(lo.field_place(buf, "capacity", span).try()).try();
    room = lo.slot_of(Scalar.U64).try();
    lo.add(Instruction.BinaryValue(Binary(out: room, left: cap.slot, right: len.slot, op: Op.WrapSub, span: nowhere()))).try();
    too_many = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: too_many, left: n.slot, right: room, op: Op.Greater, span: nowhere()))).try();
    out = lo.temp(ty).try();
    full = lo.label().try();
    go = lo.label().try();
    done = lo.label().try();
    lo.branch_to(too_many, full, go).try();
    lo.start(full);
    err_ty = lo.err_type(ty).try();
    refused = lo.variant_value(ty, "Err", Ok(lo.variant_value(err_ty, "Full", None, span).try()), span).try();
    lo.add(Instruction.Copy(Move(out: out.slot, source: refused.slot))).try();
    lo.jump(done).try();
    lo.start(go);
    // Pending output goes out before blocking on input.
    lo.add(Instruction.Flush).try();
    base = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.BinaryValue(Binary(out: base, left: data.slot, right: len.slot, op: Op.WrapAdd, span: nowhere()))).try();
    fd_ty = lo.prim("i32").try();
    fd = lo.constant(fd_ty, 0).try();
    args ::= lo.alloc.Vec<Value>();
    args.add(fd).try(LowerError.OutOfMemory);
    args.add(Value(slot: base, ty: lo.ptr_u8().try())).try(LowerError.OutOfMemory);
    args.add(n).try(LowerError.OutOfMemory);
    result = lo.std_call("std.sys.sys", "read_full", args, span).try();
    variants = lo.variants_of(result.ty).try();
    ok = variant_index(variants, "Ok").ok_or(unsupported(span, "read_full without Ok")).try();
    tag = lo.tag_of(result).try();
    expected = lo.word_const(Scalar.U32, ok.to_i64_bits()).try();
    good = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: good, left: tag, right: expected, op: Op.Equal, span: nowhere()))).try();
    read_ok = lo.label().try();
    read_bad = lo.label().try();
    lo.branch_to(good, read_ok, read_bad).try();
    lo.start(read_bad);
    closed = lo.variant_value(ty, "Err", Ok(lo.variant_value(err_ty, "Closed", None, span).try()), span).try();
    lo.add(Instruction.Copy(Move(out: out.slot, source: closed.slot))).try();
    lo.jump(done).try();
    lo.start(read_ok);
    got = lo.payload_of(result, ok).try();
    grown = lo.slot_of(Scalar.U64).try();
    lo.add(Instruction.BinaryValue(Binary(out: grown, left: len.slot, right: got.slot, op: Op.WrapAdd, span: nowhere()))).try();
    lo.write(len_place, Value(slot: grown, ty: usize_ty)).try();
    made = lo.variant_value(ty, "Ok", Ok(got), span).try();
    lo.add(Instruction.Copy(Move(out: out.slot, source: made.slot))).try();
    lo.enter(done).try();
    Ok(out)
}

// Call a function of a std module by name with evaluated arguments.
std_call* = (lo :: Lowerer, module_name: str, name: str, args: Vec<Value>, span: Span) Res<Value, LowerError> {
    module = lo.check.world.index_of(module_name).ok_or(unsupported(span, "a missing std module")).try();
    table = lo.check.world.table_at(module).ok_or(unsupported(span, "a missing std module table")).try();
    def = table.defs.find((d) { d.name.eq(name) }).ok_or(unsupported(span, "a missing std function")).try();
    decl = decl_at(lo.tree, def.id).ok_or(unsupported(span, "a missing std declaration")).try();
    f = decl.kind.match({ Function(f) => Ok(f), _ => None }).ok_or(unsupported(span, "a std non-function")).try();
    callee = Callee(f: f, owner: def.id, member: None, module: module, inst: lo.alloc.Inst(), self_ty: None, generic_owner: None);
    index = lo.enqueue(callee).try();
    slots ::= lo.alloc.Vec<usize>();
    f.params.loop((h, i, _) {
        want = lo.param_type(callee, i).try();
        value = args.get(i).ok_or(unsupported(span, "a missing std argument")).try();
        slots.add(lo.coerce(value, want).try().slot).try(LowerError.OutOfMemory);
    });
    ret = lo.result_type(callee).try();
    out = lo.temp(ret).try();
    lo.add(Instruction.Invoke(Invocation(out: out.slot, function: index, args: slots))).try();
    Ok(out)
}

// The receiver capability's type name (`Stdin`, `Fs`, ...).
receiver_kind = (lo :: Lowerer, sources: Vec<Source>) str {
    sources.get(0).value_or(Source.Absent).match({
        Given(e) => lo.type_of(e).match({ Ok(t) => lo.type_name(t), Err(_) => "" }),
        _        => "",
    })
}

// Call a function of std.sys.sys_env by name.
sys_env_call* = (lo :: Lowerer, id: ExprId, name: str, sources: Vec<Source>, c: Call, span: Span)
                Res<Value, LowerError> {
    module = lo.check.world.index_of("std.sys.sys_env").ok_or(unsupported(span, "the std.sys.sys_env module")).try();
    table = lo.check.world.table_at(module).ok_or(unsupported(span, "the std.sys.sys_env table")).try();
    def = table.defs.find((d) { d.name.eq(name) }).ok_or(unsupported(span, "a missing std.sys.sys_env function")).try();
    decl = decl_at(lo.tree, def.id).ok_or(unsupported(span, "a missing std.sys.sys_env declaration")).try();
    f = decl.kind.match({ Function(f) => Ok(f), _ => None }).ok_or(unsupported(span, "a std.sys.sys_env non-function")).try();
    callee = Callee(
        f: f,
        owner: def.id,
        member: None,
        module: module,
        inst: lo.alloc.Inst(),
        self_ty: None,
        generic_owner: None
    );
    lo.invoke(id, callee, sources, c, span)
}

// ---------------------------------------------------------------------
// loops
// ---------------------------------------------------------------------

// The loop overloads: the body's parameter list selects the form.
loop_call = (lo :: Lowerer, id: ExprId, f: Function, sources: Vec<Source>, span: Span)
            Res<Value, LowerError> {
    body_index = f.params.len - 1;
    body = lo.closure_of(sources.get(body_index).value_or(Source.Absent), span).try();
    ty = lo.loop_type(id, body).try();
    result = lo.temp(ty).try();
    none = lo.variant_value(ty, "None", None, span).try();
    lo.add(Instruction.Copy(Move(out: result.slot, source: none.slot))).try();
    body_params = lo.lambda_params(body).try();
    brk  = lo.label().try();
    next = lo.label().try();
    top  = lo.label().try();
    loop_id = lo.loops.len;
    lo.loops.add(LoopTarget(brk: brk, next: next, result: Ok(result), depth: lo.scopes.len)).try(LowerError.OutOfMemory);
    first = f.params.get(0).ok_or(unsupported(span, "a loop without parameters")).try();
    first_name = first.name.text;
    (f.params.len < 3).ensure(unsupported(span, "folding loops")).try();
    (f.params.len == 1).match({
        // loop((h) {..}) or loop((h, index) {..})
        true  => {
            index = lo.word_const(Scalar.U64, 0).try();
            lo.enter(top).try();
            args ::= lo.alloc.Vec<Value>();
            (body_params > 1).then(() {
                args.add(Value(slot: index, ty: lo.prim("usize").try())).try(LowerError.OutOfMemory);
            });
            lo.run_body(body, loop_id, args).try();
            lo.enter(next).try();
            one = lo.word_const(Scalar.U64, 1).try();
            lo.add(Instruction.BinaryValue(Binary(out: index, left: index, right: one, op: Op.WrapAdd, span: nowhere()))).try();
            lo.jump(top).try();
        },
        false => first_name.match({
            "cond"  => {
                lo.enter(top).try();
                condition = lo.condition(sources.get(0).value_or(Source.Absent), span).try();
                pass = lo.label().try();
                lo.branch_to(condition, pass, brk).try();
                lo.start(pass);
                lo.run_body(body, loop_id, lo.alloc.Vec<Value>()).try();
                lo.enter(next).try();
                lo.jump(top).try();
            },
            _       => lo.range_loop(sources, body, body_params, loop_id, top, next, brk, span).try(),
        }),
    });
    lo.start(brk);
    lo.loops.take(lo.loops.len - 1);
    Ok(result)
}

// A loop's Res<T> is settled by its context, else by the first
// `h.break(value)` its body writes.
loop_type = (lo :: Lowerer, id: ExprId, body: LambdaRef) Res<TyId, LowerError> {
    ty = lo.settled_type(id).try();
    lo.settled(ty).match({
        true  => Ok(ty),
        false => {
            l = lo.tree.expr_at(body.expr).kind.match({ Lambda(l) => Ok(l), _ => None })
                .ok_or(unsupported(nowhere(), "a loop body that is not a lambda")).try();
            handle = l.params.get(0).match({ Ok(p) => p.name.text, None => "" });
            finder ::= BreakFinder(tree: lo.tree, handle: handle);
            walk(lo.tree, lo.alloc, WalkNode.Block(l.body), finder).try(LowerError.OutOfMemory);
            finder.found.match({
                // Without a valued break the result is only ever None.
                None      => lo.check.types.res_open(lo.unit_ty).try(LowerError.OutOfMemory),
                Ok(value) => {
                    saved = lo.use_frame(body.frame);
                    payload = lo.type_of(value);
                    lo.use_frame(saved);
                    checked = payload.try();
                    settled = lo.settled(checked).match({
                        true  => checked,
                        false => lo.literal_type(value).try().value_or(checked),
                    });
                    open = lo.check.types.res_open(settled).try(LowerError.OutOfMemory);
                    Ok(open)
                },
            })
        },
    })
}

// The default type of a literal (or a negated one) whose checked type is
// still a parameter.
literal_type = (lo :: Lowerer, id: ExprId) Res<Res<TyId>, LowerError> {
    lo.tree.expr_at(id).kind.match({
        Literal(l) => l.kind.match({
            Int  => Ok(Ok(lo.prim("int").try())),
            Str  => Ok(Ok(lo.prim("str").try())),
            Bool => Ok(Ok(lo.prim("bool").try())),
            Char => Ok(Ok(lo.prim("u8").try())),
            _    => Ok(None),
        }),
        Unary(u)   => lo.literal_type(u.operand),
        Paren(p)   => lo.literal_type(p.inner),
        _          => Ok(None),
    })
}

// Finds the first `handle.break(value)` in a loop body.
BreakFinder = {
    tree: Ast,
    handle: str,
    found :: Res<ExprId> = None,
}

BreakFinder.impl(WalkVisitor, {
    visit = (self :: @Self, event: WalkEvent) Res<(), AllocError> {
        event.match({
            Enter(node) => node.match({
                Expr(id) => self.found.match({
                    Ok(_) => (),
                    None  => self.tree.expr_at(id).kind.match({
                        Call(c) => (c.args.len == 1).then(() {
                            self.tree.expr_at(c.callee).kind.match({
                                Access(a) => (a.name.text.eq("break") && self.tree.expr_at(a.base).kind.match({
                                    Name(n) => n.text.eq(self.handle),
                                    _       => false,
                                })).then(() {
                                    c.args.get(0).when_ok((arg) { self.found = Ok(arg.value); });
                                }).ignore_none(),
                                _         => (),
                            });
                        }).ignore_none(),
                        _       => (),
                    }),
                }),
                _        => (),
            }),
            Leave(_)    => (),
        });
        Ok(())
    }
})

ignore_none = <T>(r: Res<T>) { r.match({ Ok(_) => (), None => () }); }

lambda_params = (lo :: Lowerer, lambda: LambdaRef) Res<usize, LowerError> {
    lo.tree.expr_at(lambda.expr).kind.match({
        Lambda(l) => Ok(l.params.len),
        _         => Err(unsupported(nowhere(), "a loop body that is not a lambda")),
    })
}

// `cond` is a closure evaluated each pass, or a boolean place re-read.
condition = (lo :: Lowerer, source: Source, span: Span) Res<usize, LowerError> {
    e = source.match({ Given(e) => Ok(e), _ => None }).ok_or(unsupported(span, "a loop without a condition")).try();
    node = lo.stripped(e);
    bool_ty = lo.prim("bool").try();
    node.kind.match({
        Lambda(_) => Ok(lo.inline_lambda(LambdaRef(expr: e.unparen(lo), frame: lo.frame), lo.alloc.Vec<Value>(), bool_ty).try().slot),
        _         => Ok(lo.expr_as(e, bool_ty).try().slot),
    })
}

// The body runs with its handle bound to this loop.
run_body = (lo :: Lowerer, body: LambdaRef, loop_id: usize, values: Vec<Value>)
           Res<(), LowerError> {
    l = lo.tree.expr_at(body.expr).kind.match({ Lambda(l) => Ok(l), _ => None })
        .ok_or(unsupported(nowhere(), "a loop body that is not a lambda")).try();
    saved = lo.use_frame(body.frame);
    mark = lo.locals.len;
    // The first parameter is the handle unless the form passes values only.
    handles = l.params.len > values.len;
    l.params.loop((h, i, p) {
        (handles && i == 0).match({
            true  => lo.bind_local(p.name.text, LocalKind.Handle(loop_id)).try(),
            false => {
                at = handles.match({ true => i - 1, false => i });
                values.get(at).when_ok((v) {
                    copy = lo.copy_value(v).try();
                    lo.bind_local(p.name.text, LocalKind.Direct(copy)).try();
                });
            },
        });
    });
    lo.block(l.body).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    Ok(())
}

// Walk [start, end) of a Range, a fixed array, or a type implementing
// Seq whose `at` supplies each value. A Range's counter is its value, in the
// bounds' own type; `index` counts passes separately.
range_loop = (lo :: Lowerer, sources: Vec<Source>, body: LambdaRef, body_params: usize,
              loop_id: usize, top: usize, next: usize, brk: usize, span: Span)
             Res<(), LowerError> {
    range_expr = sources.source_expr(0, span).try();
    range = lo.expr(range_expr).try();
    usize_ty = lo.prim("usize").try();
    s = lo.shape(range.ty).try();
    walk: Walk = s.form.match({
        Array(elements) => Walk(
            start: lo.word_const(Scalar.U64, 0).try(),
            end: lo.word_const(Scalar.U64, elements.count.to_i64_bits()).try(),
            kind: WalkKind.Elements
        ),
        _               => lo.range_bounds(range, span).try(),
    });
    index = lo.copy_slot(walk.start).try();
    step  = lo.word_const(lo.slots.get(index).value_or(Scalar.U64), 1).try();
    // The pass count starts at zero whatever the range's start.
    count = lo.word_const(Scalar.U64, 0).try();
    pass = lo.label().try();
    lo.enter(top).try();
    more = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: more, left: index, right: walk.end, op: Op.Less, span: nowhere()))).try();
    lo.branch_to(more, pass, brk).try();
    lo.start(pass);
    position = Value(slot: index, ty: usize_ty);
    value = walk.kind.match({
        Elements  => {
            place = lo.element_place(range, index).try();
            lo.read(place).try()
        },
        Indices(t) => lo.copy_value(Value(slot: index, ty: t)).try(),
        At(at)    => lo.at_value(range, at, position, brk, span).try(),
    });
    args ::= lo.alloc.Vec<Value>();
    (body_params >= 3).then(() { args.add(Value(slot: count, ty: usize_ty)).try(LowerError.OutOfMemory); });
    args.add(value).try(LowerError.OutOfMemory);
    lo.run_body(body, loop_id, args).try();
    lo.enter(next).try();
    one = lo.word_const(Scalar.U64, 1).try();
    lo.add(Instruction.BinaryValue(Binary(out: index, left: index, right: step, op: Op.WrapAdd, span: nowhere()))).try();
    lo.add(Instruction.BinaryValue(Binary(out: count, left: count, right: one, op: Op.WrapAdd, span: nowhere()))).try();
    lo.jump(top)
}

WalkKind = Elements | Indices(TyId) | At(AtHook)
AtHook = { decl: DeclId, f: Function, impl_module: usize }
Walk = { start: usize, end: usize, kind: WalkKind }

copy_slot = (lo :: Lowerer, slot: usize) Res<usize, LowerError> {
    out = lo.slot_of(lo.slots.get(slot).value_or(Scalar.U64)).try();
    lo.add(Instruction.Copy(Move(out: out, source: slot))).try();
    Ok(out)
}

element_place = (lo :: Lowerer, array: Value, index: usize) Res<Place, LowerError> {
    s = lo.shape(array.ty).try();
    elements = s.form.match({ Array(e) => Ok(e), _ => None }).ok_or(unsupported(nowhere(), "an array walk")).try();
    base = lo.address(lo.spill(array)).try();
    stride = lo.word_const(Scalar.U64, elements.stride.to_i64_bits()).try();
    offset = lo.slot_of(Scalar.U64).try();
    lo.add(Instruction.BinaryValue(Binary(out: offset, left: index, right: stride, op: Op.WrapMul, span: nowhere()))).try();
    at = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.BinaryValue(Binary(out: at, left: base, right: offset, op: Op.WrapAdd, span: nowhere()))).try();
    Ok(Place(base: Base.Through(at), offset: 0, ty: elements.elem))
}

// A Range record reads its fields, and its values are its bounds' type;
// another type supplies start/end/at through its Seq impl.
range_bounds = (lo :: Lowerer, range: Value, span: Span) Res<Walk, LowerError> {
    qualified = lo.qualified_name(range.ty);
    qualified.eq("std.core.range.Range").match({
        true  => {
            place = lo.spill(range);
            start = lo.read(lo.field_place(place, "start", span).try()).try();
            end   = lo.read(lo.field_place(place, "end", span).try()).try();
            Ok(Walk(start: start.slot, end: end.slot, kind: WalkKind.Indices(start.ty)))
        },
        false => lo.impl_bounds(range, span),
    })
}

qualified_name* = (lo :: Lowerer, ty: TyId) str {
    lo.check.types.at(ty).match({
        Named(n) => lo.alloc.String("{}.{}", lo.check.world.module_name(n.decl), n.name).match({
            Ok(s)  => s.view(),
            Err(_) => "",
        }),
        _        => "",
    })
}

impl_bounds = (lo :: Lowerer, range: Value, span: Span) Res<Walk, LowerError> {
    target = lo.type_name(range.ty);
    ids ::= lo.alloc.Vec<ImplId>();
    lo.check.world.impls_named(lo.tree, target, ids).try(LowerError.OutOfMemory);
    found: Res<Impl> = loop<Impl>((h) {
        ids.loop((id) {
            lo.check.world.impl_at(lo.tree, id).when_ok((i) {
                bound = lo.tree.type_at(i.bound).kind.match({ Named(n) => n.name.text, _ => "" });
                bound.eq("Seq").then(() { h.break(i); });
            });
        });
        h.break();
    });
    impl = found.ok_or(unsupported(span, "a loop over a type without a Seq impl")).try();
    start_expr = impl.field_value("start").ok_or(unsupported(span, "a Seq impl without start")).try();
    end_expr = impl.field_value("end").ok_or(unsupported(span, "a Seq impl without end")).try();
    at = impl.bodied_fn("at").ok_or(unsupported(span, "a Seq impl without at")).try();
    impl_decl = ids.find((id) {
        lo.check.world.impl_at(lo.tree, id).match({
            Ok(i) => lo.tree.type_at(i.bound).kind.match({ Named(n) => n.name.text.eq("Seq"), _ => false }),
            None  => false,
        })
    }).ok_or(unsupported(span, "a missing Seq impl")).try();
    module = impl_decl.decl.module.to_usize();
    // The impl's field expressions read `self`.
    inst = lo.check.types.at(range.ty).match({
        Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
        _        => lo.alloc.Inst(),
    });
    frame = lo.push_frame(inst, module, lo.unit_ty, Ok(range.ty), None).try();
    saved = lo.use_frame(frame);
    mark = lo.locals.len;
    lo.bind_local("self", LocalKind.Direct(range)).try();
    usize_ty = lo.prim("usize").try();
    start = lo.expr_as(start_expr, usize_ty).try();
    end = lo.expr_as(end_expr, usize_ty).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    Ok(Walk(
        start: start.slot,
        end: end.slot,
        kind: WalkKind.At(AtHook(decl: impl_decl.decl, f: at, impl_module: module))
    ))
}

// One pass's value from the impl's `at`; None ends the walk.
at_value = (lo :: Lowerer, range: Value, hook: AtHook, index: Value, brk: usize, span: Span)
           Res<Value, LowerError> {
    body = hook.f.body.ok_or(unsupported(span, "a bodiless at")).try();
    inst = lo.check.types.at(range.ty).match({
        Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
        _        => lo.alloc.Inst(),
    });
    ret = lo.at_result(hook, inst, range.ty).try();
    owner: Res<DeclId> = lo.check.types.at(range.ty).match({ Named(n) => Ok(n.decl), _ => None });
    scope = Callee(
        f: hook.f,
        owner: hook.decl,
        member: None,
        module: hook.impl_module,
        inst: inst,
        self_ty: Ok(range.ty),
        generic_owner: owner
    );
    frame = lo.push_frame(inst, hook.impl_module, ret, Ok(range.ty), Ok(scope)).try();
    saved = lo.use_frame(frame);
    mark = lo.locals.len;
    hook.f.params.loop((h, i, p) {
        (i == 0).match({
            true  => lo.bind_local(p.name.text, LocalKind.Direct(lo.copy_value(range).try())).try(),
            false => lo.bind_local(p.name.text, LocalKind.Direct(lo.copy_value(index).try())).try(),
        });
    });
    value = lo.block(body).try();
    here = lo.here();
    coerced = lo.coerce(value, ret).try();
    lo.add(Instruction.Copy(Move(out: here.ret_slot, source: coerced.slot))).try();
    lo.enter(here.ret_block).try();
    lo.release_locals(mark);
    lo.use_frame(saved);
    produced = Value(slot: here.ret_slot, ty: ret);
    variants = lo.variants_of(ret).try();
    ok = variant_index(variants, "Ok").ok_or(unsupported(span, "an at result without Ok")).try();
    tag = lo.tag_of(produced).try();
    expected = lo.word_const(Scalar.U32, ok.to_i64_bits()).try();
    test = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(out: test, left: tag, right: expected, op: Op.Equal, span: nowhere()))).try();
    good = lo.label().try();
    lo.branch_to(test, good, brk).try();
    lo.start(good);
    lo.payload_of(produced, ok)
}

at_result = (lo :: Lowerer, hook: AtHook, inst: Inst, self_ty: TyId) Res<TyId, LowerError> {
    t = hook.f.ret.ok_or(unsupported(nowhere(), "an at without a result type")).try();
    owner: Res<DeclId> = lo.check.types.at(self_ty).match({ Named(n) => Ok(n.decl), _ => None });
    lo.callee_type(Callee(
        f: hook.f,
        owner: hook.decl,
        member: None,
        module: hook.impl_module,
        inst: inst,
        self_ty: Ok(self_ty),
        generic_owner: owner
    ), t)
}

// `h.break()`, `h.break(value)` and `h.next()`.
handle_call = (lo :: Lowerer, loop_id: usize, name: str, c: Call, span: Span)
              Res<Value, LowerError> {
    target = lo.loops.get(loop_id).ok_or(unsupported(span, "a loop handle outside its loop")).try();
    name.match({
        "next"  => {
            lo.unwind(target.depth).try();
            lo.jump(target.next).try();
            lo.unit()
        },
        "break" => {
            c.args.get(0).when_ok((arg) {
                target.result.when_ok((result) {
                    variants = lo.variants_of(result.ty).try();
                    ok = variant_index(variants, "Ok").ok_or(unsupported(span, "a loop result without Ok")).try();
                    payload_ty = variants.get(ok).ok_or(unsupported(span, "a missing variant")).try().payload.ok_or(unsupported(span, "a loop result without a payload")).try();
                    value = lo.expr_as(arg.value, payload_ty).try();
                    made = lo.variant_value(result.ty, "Ok", Ok(value), span).try();
                    lo.add(Instruction.Copy(Move(out: result.slot, source: made.slot))).try();
                });
            });
            lo.unwind(target.depth).try();
            lo.jump(target.brk).try();
            lo.unit()
        },
        _       => Err(unsupported(span, "this loop handle operation")),
    })
}

// ---------------------------------------------------------------------
// printing
// ---------------------------------------------------------------------

// `a.String(fmt, args..)` and `s.fmt(fmt, args..)`: formatting into text.
string_call = (lo :: Lowerer, id: ExprId, name: str, c: Call, sources: Vec<Source>, span: Span)
              Res<Value, LowerError> {
    ty = lo.type_of(id).try();
    name.match({
        "fmt"    => {
            receiver = sources.get(0).value_or(Source.Absent);
            string_ty = receiver.match({ Given(e) => lo.type_of(e), _ => Err(unsupported(span, "fmt without a String")) }).try();
            place = lo.argument_place(receiver, string_ty, span).try();
            written_first = receiver.match({
                Given(e) => c.args.get(0).match({ Ok(a) => a.value == e, None => false }),
                _        => false,
            });
            lo.format_call(c.args, written_first.match({ true => 1, false => 0 }), false, FmtTo.Into(place), span).try();
            lo.variant_value(ty, "Ok", Ok(lo.unit().try()), span)
        },
        "String" => {
            // The empty String from the one-argument constructor, then the
            // formatted text appended to it.
            alloc_source = sources.get(0).value_or(Source.Absent);
            empty_callee = lo.std_callee_arity("std.text.text_string", "String", 1, span).try();
            alloc_ty = lo.param_type(empty_callee, 0).try();
            alloc = lo.argument_value(alloc_source, alloc_ty, span).try();
            args ::= lo.alloc.Vec<Source>();
            args.add(Source.Computed(alloc)).try(LowerError.OutOfMemory);
            made = lo.real_call(empty_callee, args, span).try();
            variants = lo.variants_of(made.ty).try();
            ok = variant_index(variants, "Ok").ok_or(unsupported(span, "a String result without Ok")).try();
            tag = lo.tag_of(made).try();
            expected = lo.word_const(Scalar.U32, ok.to_i64_bits()).try();
            test = lo.slot_of(Scalar.Bool).try();
            lo.add(Instruction.BinaryValue(Binary(out: test, left: tag, right: expected, op: Op.Equal, span: nowhere()))).try();
            out = lo.temp(ty).try();
            good = lo.label().try();
            bad = lo.label().try();
            done = lo.label().try();
            lo.branch_to(test, good, bad).try();
            lo.start(bad);
            converted = lo.coerce(made, ty).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: converted.slot))).try();
            lo.jump(done).try();
            lo.start(good);
            text = lo.payload_of(made, ok).try();
            held = lo.copy_value(text).try();
            // `a.String(fmt, ..)` writes the allocator as the receiver;
            // `String(a, fmt, ..)` writes it first in the parentheses.
            written_first = alloc_source.match({
                Given(e) => c.args.get(0).match({ Ok(a) => a.value == e, None => false }),
                _        => false,
            });
            lo.format_call(c.args, written_first.match({ true => 1, false => 0 }), false, FmtTo.Into(lo.spill(held)), span).try();
            wrapped = lo.variant_value(ty, "Ok", Ok(held), span).try();
            lo.add(Instruction.Copy(Move(out: out.slot, source: wrapped.slot))).try();
            lo.enter(done).try();
            Ok(out)
        },
        _        => Err(unsupported(span, "this text operation")),
    })
}

std_callee_arity = (lo :: Lowerer, module_name: str, name: str, arity: usize, span: Span) Res<Callee, LowerError> {
    module = lo.check.world.index_of(module_name).ok_or(unsupported(span, "a missing std module")).try();
    table = lo.check.world.table_at(module).ok_or(unsupported(span, "a missing std module table")).try();
    found: Res<Callee> = loop<Callee>((h) {
        table.defs.loop((d) {
            (d.name.eq(name)).then(() {
                decl_at(lo.tree, d.id).when_ok((decl) {
                    decl.kind.match({
                        Function(f) => (f.params.len == arity && f.body.match({ Ok(_) => true, None => false })).then(() {
                            h.break(Callee(f: f, owner: d.id, member: None, module: module, inst: lo.alloc.Inst(), self_ty: None, generic_owner: None));
                        }).ignore_none(),
                        _           => (),
                    });
                });
            }).ignore_none();
        });
        h.break();
    });
    found.ok_or(unsupported(span, "a missing std function overload"))
}

// Where formatted text goes: a console stream, or the String at a place.
FmtTo* = Console(Stream) | Into(Place)

// `print`/`println` and Console output: a literal format string with
// positional and named holes, or plain values.
print_call* = (lo :: Lowerer, args: Vec<Arg>, first: usize, newline: bool, stream: Stream,
               span: Span) Res<Value, LowerError> {
    lo.format_call(args, first, newline, FmtTo.Console(stream), span).try();
    lo.unit()
}

format_call* = (lo :: Lowerer, args: Vec<Arg>, first: usize, newline: bool, to: FmtTo,
                span: Span) Res<(), LowerError> {
    raw: Res<str> = args.get(first).match({
        None    => None,
        Ok(arg) => lo.tree.expr_at(arg.value).kind.match({
            Literal(l) => l.kind.match({ Str => Ok(l.text), _ => None }),
            _          => None,
        }),
    });
    raw.match({
        Ok(text) => lo.format(args, first, text, to, span),
        None     => {
            args.loop((h, i, arg) {
                (i >= first).then(() { lo.print_expr(arg.value, to).try(); });
            });
            Ok(())
        },
    }).try();
    newline.then(() { lo.text("\n", to).try(); });
    Ok(())
}

text = (lo :: Lowerer, bytes: str, to: FmtTo) Res<(), LowerError> {
    (!bytes.is_empty()).then(() {
        to.match({
            Console(stream) => stream.match({
                Out => lo.add(Instruction.Text(bytes)).try(),
                Err => {
                    data = lo.slot_of(Scalar.Ptr).try();
                    lo.add(Instruction.Bytes(StaticBytes(out: data, bytes: bytes))).try();
                    len = lo.word_const(Scalar.U64, bytes.len.to_i64_bits()).try();
                    lo.add(Instruction.WriteOut(Write(data: data, len: len, stream: Stream.Err))).try();
                },
            }),
            Into(place)     => {
                value = lo.string(bytes, lo.prim("str").try()).try();
                lo.write_str(place, value).try();
            },
        });
    });
    Ok(())
}

print_expr = (lo :: Lowerer, id: ExprId, to: FmtTo) Res<(), LowerError> {
    e = lo.tree.expr_at(id);
    raw: Res<str> = e.kind.match({
        Literal(l) => l.kind.match({ Str => Ok(l.text), _ => None }),
        _          => None,
    });
    raw.match({
        Ok(text) => {
            decoded = text.slice(1, text.len - 1).decode_literal(lo.alloc)
                .match({ Ok(t) => Ok(t), Err(_) => Err(unsupported(e.span, "a malformed literal escape")) }).try();
            lo.text(decoded, to)
        },
        None     => {
            value = lo.expr(id).try();
            lo.print_value(value, to, e.span)
        },
    })
}

print_value* = (lo :: Lowerer, value: Value, to: FmtTo, span: Span) Res<(), LowerError> {
    class = lo.class_of(value.ty).try();
    is_str = lo.prim_name(value.ty).eq("str");
    primitive = word(class) && lo.plain_word(value.ty);
    to.match({
        Console(stream) => is_str.match({
            true  => {
                at = lo.address(lo.spill(value)).try();
                data = lo.slot_of(Scalar.Ptr).try();
                len = lo.slot_of(Scalar.U64).try();
                lo.add(Instruction.LoadValue(Load(out: data, base: at, offset: 0))).try();
                lo.add(Instruction.LoadValue(Load(out: len, base: at, offset: 8))).try();
                lo.add(Instruction.WriteOut(Write(data: data, len: len, stream: stream)))
            },
            false => primitive.match({
                true  => lo.add(Instruction.PrintValue(Print(value: value.slot, ty: class, stream: stream))),
                false => lo.is_unit(value.ty).match({
                    true  => lo.text("()", to),
                    false => {
                        sink = lo.stream_sink(stream, span).try();
                        lo.display(value, sink, span)
                    },
                }),
            }),
        }),
        Into(place)     => is_str.match({
            true  => lo.write_str(place, value),
            false => primitive.match({
                true  => {
                    // `add_f64` has no Zen body yet (C formats with %g).
                    (!float(class)).ensure(unsupported(span, "formatting an f64 into text")).try();
                    sink = lo.sink_for_place(place, span).try();
                    helper = class.match({
                        Bool => "add_bool",
                        _    => signed(class).match({ true => "add_i64", false => "add_u64" }),
                    });
                    lo.fmt_helper(helper, sink, value, span)
                },
                false => lo.is_unit(value.ty).match({
                    true  => lo.text("()", to),
                    false => {
                        sink = lo.sink_for_place(place, span).try();
                        lo.display(value, sink, span)
                    },
                }),
            }),
        }),
    })
}

// Integers and bool print directly; payload-free enums and pointers do not.
plain_word = (lo :: Lowerer, ty: TyId) bool {
    lo.check.types.at(ty).match({ Prim(_) => true, _ => false })
}

// `{}` of a non-primitive value: its Display `toString(out :: Sink)`.
display = (lo :: Lowerer, value: Value, sink: Value, span: Span) Res<(), LowerError> {
    callee = lo.resolve(value.ty, "toString", None, 2, lo.alloc.Inst(), None, span).try();
    sources ::= lo.alloc.Vec<Source>();
    sources.add(Source.Computed(value)).try(LowerError.OutOfMemory);
    sources.add(Source.Computed(sink)).try(LowerError.OutOfMemory);
    lo.real_call(callee, sources, span).try();
    Ok(())
}

// A Sink over a console stream (std.sys.StreamSink).
stream_sink = (lo :: Lowerer, stream: Stream, span: Span) Res<Value, LowerError> {
    sink_ty = lo.std_type("std.sys.sys", "StreamSink", span).try();
    fd_ty = lo.prim("i32").try();
    fd = lo.constant(fd_ty, stream.match({ Out => 1, Err => 2 })).try();
    record = lo.temp(sink_ty).try();
    at = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.AddressOf(Address(out: at, slot: record.slot))).try();
    lo.add(Instruction.StoreValue(Store(base: at, offset: 0, value: fd.slot))).try();
    lo.to_bound(record, lo.std_type("std.core.io", "Sink", span).try()).try()
        .ok_or(unsupported(span, "a StreamSink that is not a Sink"))
}

// A Sink whose receiver is the String at `place`, so writes land there; a
// place already holding a Sink handle is that handle.
sink_for_place = (lo :: Lowerer, place: Place, span: Span) Res<Value, LowerError> {
    sink_ty = lo.std_type("std.core.io", "Sink", span).try();
    (place.ty == sink_ty).match({
        true  => lo.read(place),
        false => lo.handle_for_place(place, sink_ty).try().ok_or(unsupported(span, "a String that is not a Sink")),
    })
}

// Append a str to the text at `place`: String.add, or Sink.write through a
// handle.
write_str = (lo :: Lowerer, place: Place, value: Value) Res<(), LowerError> {
    lo.bound_of(place.ty).try().match({
        None        => lo.string_add(place, value),
        Ok(bound)   => {
            handle = lo.read(place).try();
            args ::= lo.alloc.Vec<Source>();
            args.add(Source.Computed(value)).try(LowerError.OutOfMemory);
            result_ty = lo.std_result("write", bound, nowhere()).try();
            lo.dispatch(bound, handle, "write", args, lo.alloc.Inst(), result_ty, nowhere()).try();
            Ok(())
        },
    })
}

// A bound member's declared result type (for dispatching `write`).
std_result = (lo :: Lowerer, name: str, bound: Bound, span: Span) Res<TyId, LowerError> {
    decl = decl_at(lo.tree, bound.decl).ok_or(unsupported(span, "a missing bound")).try();
    s = decl.kind.match({ Struct(s) => Ok(s), _ => None }).ok_or(unsupported(span, "a bound that is not a struct")).try();
    member = s.members.find((m) { m.named(name) }).ok_or(unsupported(span, "a missing bound member")).try();
    f = member.kind.match({ Function(f) => Ok(f), _ => None }).ok_or(unsupported(span, "a bound member that is not a function")).try();
    callee = Callee(f: f, owner: bound.decl, member: None, module: bound.decl.module.to_usize(), inst: lo.alloc.Inst(), self_ty: Ok(bound.ty), generic_owner: Ok(bound.decl));
    lo.result_type(callee)
}

// One of std.text.text_fmt's `add_*(out :: Sink, v)` writers.
fmt_helper = (lo :: Lowerer, name: str, sink: Value, value: Value, span: Span) Res<(), LowerError> {
    callee = lo.std_callee("std.text.text_fmt", name, span).try();
    sources ::= lo.alloc.Vec<Source>();
    sources.add(Source.Computed(sink)).try(LowerError.OutOfMemory);
    sources.add(Source.Computed(value)).try(LowerError.OutOfMemory);
    lo.real_call(callee, sources, span).try();
    Ok(())
}

// `String.add(s: str)` on the String at `place`.
string_add = (lo :: Lowerer, place: Place, value: Value) Res<(), LowerError> {
    callee = lo.resolve(place.ty, "add", None, 2, lo.alloc.Inst(), None, nowhere()).try();
    sources ::= lo.alloc.Vec<Source>();
    sources.add(Source.Located(place)).try(LowerError.OutOfMemory);
    sources.add(Source.Computed(value)).try(LowerError.OutOfMemory);
    lo.real_call(callee, sources, nowhere()).try();
    Ok(())
}

// A non-generic type declared in a std module.
std_type* = (lo :: Lowerer, module_name: str, name: str, span: Span) Res<TyId, LowerError> {
    module = lo.check.world.index_of(module_name).ok_or(unsupported(span, "a missing std module")).try();
    table = lo.check.world.table_at(module).ok_or(unsupported(span, "a missing std module table")).try();
    def = table.defs.find((d) { d.name.eq(name) }).ok_or(unsupported(span, "a missing std type")).try();
    args ::= lo.alloc.Vec<TyId>();
    lo.check.types.named(def.id, def.qname, def.name, args).try(LowerError.OutOfMemory)
}

std_callee* = (lo :: Lowerer, module_name: str, name: str, span: Span) Res<Callee, LowerError> {
    module = lo.check.world.index_of(module_name).ok_or(unsupported(span, "a missing std module")).try();
    table = lo.check.world.table_at(module).ok_or(unsupported(span, "a missing std module table")).try();
    def = table.defs.find((d) { d.name.eq(name) && d.kind.match({ FunctionDef => true, _ => false }) })
        .ok_or(unsupported(span, "a missing std function")).try();
    decl = decl_at(lo.tree, def.id).ok_or(unsupported(span, "a missing std declaration")).try();
    f = decl.kind.match({ Function(f) => Ok(f), _ => None }).ok_or(unsupported(span, "a std non-function")).try();
    Ok(Callee(f: f, owner: def.id, member: None, module: module, inst: lo.alloc.Inst(), self_ty: None, generic_owner: None))
}

format = (lo :: Lowerer, args: Vec<Arg>, first: usize, raw: str, to: FmtTo, span: Span)
         Res<(), LowerError> {
    end = raw.len - 1;
    start: usize ::= 1;
    i: usize     ::= 1;
    used: usize  ::= first + 1;
    loop(() { i < end }, (h) {
        at = raw.fmt_at(i, end);
        at.what.match({
            Byte        => { i = i + (raw[i] == '\\').match({ true => 2, false => 1 }); },
            Pair        => {
                lo.raw_text(raw.slice(start, at.keep), to, span).try();
                i     = at.next;
                start = i;
            },
            Hole        => {
                lo.raw_text(raw.slice(start, i), to, span).try();
                arg = args.get(used).ok_or(unsupported(span, "a format hole without an argument")).try();
                lo.print_expr(arg.value, to).try();
                used  = used + 1;
                i     = at.next;
                start = i;
            },
            Named(name) => {
                lo.raw_text(raw.slice(start, i), to, span).try();
                kind = lo.lookup(name).ok_or(unsupported(span, "a named hole without a local")).try();
                value = kind.match({
                    Direct(v) => Ok(v),
                    Ref(p)    => lo.read(p),
                    _         => Err(unsupported(span, "a named hole naming a closure or handle")),
                }).try();
                lo.print_value(value, to, span).try();
                i     = at.next;
                start = i;
            },
            NoName      => { Err(unsupported(span, "an invalid format hole")).try(); },
        });
    });
    lo.raw_text(raw.slice(start, end), to, span).try();
    (used == args.len).ensure(unsupported(span, "an argument without a format hole")).try();
    Ok(())
}

raw_text = (lo :: Lowerer, raw: str, to: FmtTo, span: Span) Res<(), LowerError> {
    decoded = raw.decode_literal(lo.alloc).match({
        Ok(t)  => Ok(t),
        Err(_) => Err(unsupported(span, "a malformed literal escape")),
    }).try();
    lo.text(decoded, to)
}
