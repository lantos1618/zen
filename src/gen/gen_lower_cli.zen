// `outcome<T>(env, a, argv)`: T's command-line parser, written at the call
// from T's fields or variants and its Cli table as calls into
// std.cli.cli_derive, the same derivation the C backend writes.

{ Vec } = std.collections
{ String, str } = std.text
{ Res, Ok, Err, None, Range } = std.core
{ ExprId, Impl } = std.ast
{ Span, nowhere } = std.source
{ TyId, TyNamed, decl_at } = sema.sema
{ ImplId, Inst } = sema.sema
{ is_failure } = sema.sema_ty
{ inst_of_named } = sema.sema_inst
{ Scalar, Op, Binary, Instruction, Move, Address, Store } = gen.gen_ir
{ LowerError, unsupported } = gen.gen_lower
{ Lowerer, Value, Place } = gen.gen_lower_core
{ Source, source_expr, argument_value } = gen.gen_lower_call
{ std_call, succeeded, ok_payload } = gen.gen_lower_thread
{ VariantAt, FieldAt, variant_index, shape, size_of, class_of } = gen.gen_lower_shape

DERIVE: str = "std.cli.cli_derive"

Word = { Text | Location | Unsigned: TyId | Signed: TyId | Choice: TyId }

// How one field reads its words.
Ask = { Switch | Rest | Many | One: Word | Maybe: Word | Unfit }

// A type's Cli impl, and the module its entries are read in.
Table = { impl: Res<Impl>, module: usize, ty: TyId }

// The answer, the call's arguments, and the one exit every stop jumps to.
CliLower = {
    ret: TyId,
    result: Value,
    done: usize,
    env: Value,
    alloc: Value,
    argv: Value,
    program: Value,
    span: Span,
}

Slot = {
    id: i64,
    name: str,
    ty: TyId,
    ask: Ask,
    positional: bool,
    default: Res<ExprId>,
    entry: Res<ExprId>,
}

cli_call* = (
    lo      :: Lowerer,
    id      : ExprId,
    name    : str,
    sources : Vec<Source>,
    span    : Span
)
            Res<Value, LowerError> {
    name.eq("outcome").ensure(unsupported(span, "this std.cli operation")).try();
    ret      = lo.type_of(id).try();
    variants = lo.variants_of(ret).try();
    ok       = variant_index(variants, "Ok").ok_or(unsupported(span, "outcome without Ok")).try();
    top      = variants.get(ok).match({ Ok(v) => v.payload, None => None })
        .ok_or(unsupported(span, "outcome with nothing to parse")).try();
    env      = lo.cli_arg(sources, 0, span).try();
    alloc    = lo.cli_arg(sources, 1, span).try();
    argv     = lo.cli_arg(sources, 2, span).try();
    result   = lo.temp(ret).try();
    done     = lo.label().try();
    named    = lo.table_str(lo.table_of(top).try(), "name").try();
    names ::= lo.alloc.Vec<Source>();
    names.put(argv).try();
    names.put(named).try();
    program  = lo.std_call(DERIVE, "program", names, span).try();
    cl       = CliLower(
        ret: ret,
        result: result,
        done: done,
        env: env,
        alloc: alloc,
        argv: argv,
        program: program,
        span: span
    );
    value    = lo.command(
        cl,
        top,
        program,
        lo.number("usize", 1).try(),
        lo.number("bool", 0).try()
    ).try();
    finished = lo.variant_value(ret, "Ok", Ok(value), span).try();
    lo.add(Instruction.Copy(Move(
        out: result.slot,
        source: finished.slot
    ))).try();
    lo.jump(done).try();
    lo.start(done);
    Ok(result)
}

cli_arg = (lo :: Lowerer, sources: Vec<Source>, i: usize, span: Span)
          Res<Value, LowerError> {
    e = source_expr(sources, i, span).try();
    lo.argument_value(Source.Given(e), lo.type_of(e).try(), span)
}

put = (list :: Vec<Source>, v: Value) Res<LowerError> {
    list.add(Source.Computed(v)).try(LowerError.OutOfMemory);
    Ok
}

put_at = (list :: Vec<Source>, p: Place) Res<LowerError> {
    list.add(Source.Located(p)).try(LowerError.OutOfMemory);
    Ok
}

number = (lo :: Lowerer, prim: str, value: i64) Res<Value, LowerError> {
    lo.constant(lo.prim(prim).try(), value)
}

text = (lo :: Lowerer, t: str) Res<Value, LowerError> {
    lo.string(t, lo.prim("str").try())
}

flag = (lo :: Lowerer, b: bool) Res<Value, LowerError> {
    lo.number("bool", b.match({ true => 1, false => 0 }))
}

// A helper answering Res<_, Stop>: a stop becomes the answer's Err.
checked = (lo :: Lowerer, cl: CliLower, name: str, args: Vec<Source>)
          Res<Value, LowerError> {
    got  = lo.std_call(DERIVE, name, args, cl.span).try();
    good = lo.label().try();
    bad  = lo.label().try();
    lo.branch_to(lo.succeeded(got).try(), good, bad).try();
    lo.start(bad);
    err    = variant_index(lo.variants_of(got.ty).try(), "Err")
        .ok_or(unsupported(cl.span, "a std.cli helper without Err")).try();
    stop   = lo.payload_of(got, err).try();
    failed = lo.variant_value(cl.ret, "Err", Ok(stop), cl.span).try();
    lo.add(Instruction.Copy(Move(
        out: cl.result.slot,
        source: failed.slot
    ))).try();
    lo.jump(cl.done).try();
    lo.start(good);
    Ok(got)
}

// A command of type `ty` at usage path `path`, parsing from word `start`;
// `help` says whether only its help is wanted.
command = (
    lo    :: Lowerer,
    cl    : CliLower,
    ty    : TyId,
    path  : Value,
    start : Value,
    help  : Value
)
          Res<Value, LowerError> {
    unfit = unsupported(
        cl.span,
        "a command line type that is not a struct or an enum"
    );
    n     = lo.check.types.at(ty).match({ Named(n) => Ok(n), _ => None }).ok_or(unfit).try();
    decl  = decl_at(lo.tree, n.decl).ok_or(unfit).try();
    decl.kind.match({
        Struct(_) => lo.fields(cl, ty, n, path, start, help),
        Enum(_)   => lo.variants(cl, ty, path, start, help),
        _         => Err(unfit),
    })
}

table_of = (lo :: Lowerer, ty: TyId) Res<Table, LowerError> {
    ids ::= lo.alloc.Vec<ImplId>();
    lo.check.world.impls_named(
        lo.tree,
        lo.type_name(ty),
        ids
    ).try(LowerError.OutOfMemory);
    found: Res<ImplId> = ids.find((id) {
        lo.check.world.impl_at(lo.tree, id).match({
            Ok(i) => lo.tree.type_at(i.bound).kind.match({
                Named(b) => b.name.text.eq("Cli"),
                _        => false,
            }),
            None  => false,
        })
    });
    Ok(found.match({
        Ok(id) => Table(
            impl: lo.check.world.impl_at(lo.tree, id),
            module: id.decl.module.to_usize(),
            ty: ty
        ),
        None   => Table(impl: None, module: 0, ty: ty),
    }))
}

// An expression written in `ty`'s declaring module (a table entry or a
// field default), lowered there.
foreign = (lo :: Lowerer, ty: TyId, module: usize, e: ExprId, want: Res<TyId>)
          Res<Value, LowerError> {
    inst  = lo.check.types.at(ty).match({
        Named(n) => lo.check.inst_of_named(n).try(LowerError.OutOfMemory),
        _        => lo.alloc.Inst(),
    });
    frame = lo.push_frame(inst, module, lo.unit_ty, Ok(ty), None).try();
    saved = lo.use_frame(frame);
    value = want.match({ Ok(w) => lo.expr_as(e, w), None => lo.expr(e) });
    lo.use_frame(saved);
    value
}

entry = (t: Table, key: str) Res<ExprId> {
    t.impl.match({ Ok(i) => i.field_value(key), None => None })
}

named_is = (lo :: Lowerer, ty: TyId, name: str) bool {
    lo.check.types.at(ty).match({ Named(n) => n.name.eq(name), _ => false })
}

is_str = (lo :: Lowerer, ty: TyId) bool {
    lo.check.types.at(ty).match({ Prim(p) => p.name.eq("str"), _ => false })
}

// A `str` entry of the table; "" without one.
table_str = (lo :: Lowerer, t: Table, key: str) Res<Value, LowerError> {
    t.entry(key).match({
        Ok(e) => {
            v = lo.foreign(t.ty, t.module, e, None).try();
            lo.is_str(v.ty).match({ true => Ok(v), false => lo.text("") })
        },
        None  => lo.text(""),
    })
}

// The Spec an entry names, when it is one.
spec_of = (
    lo :: Lowerer,
    t  : Table,
    e  : Res<ExprId>
) Res<Res<Value>, LowerError> {
    e.match({
        Ok(id) => {
            v = lo.foreign(t.ty, t.module, id, None).try();
            Ok(
                lo.named_is(v.ty, "Spec").match({ true => Ok(v), false => None })
            )
        },
        None   => Ok(None),
    })
}

spec_or_plain = (lo :: Lowerer, cl: CliLower, t: Table, e: Res<ExprId>)
                Res<Value, LowerError> {
    lo.spec_of(t, e).try().match({
        Ok(v) => Ok(v),
        None  => lo.std_call(DERIVE, "plain", lo.alloc.Vec<Source>(), cl.span),
    })
}

// `cmd = derived(a, path, about, note)`, held where helpers can change it.
model = (lo :: Lowerer, cl: CliLower, t: Table, path: Value, about: Value)
        Res<Place, LowerError> {
    args ::= lo.alloc.Vec<Source>();
    args.put(cl.alloc).try();
    args.put(path).try();
    args.put(about).try();
    args.put(lo.table_str(t, "note").try()).try();
    Ok(lo.spill(lo.std_call(DERIVE, "derived", args, cl.span).try()))
}

// One struct: declare each field, scan, then fill each field.
fields = (
    lo    :: Lowerer,
    cl    : CliLower,
    ty    : TyId,
    n     : TyNamed,
    path  : Value,
    start : Value,
    help  : Value
)
         Res<Value, LowerError> {
    t                        = lo.table_of(ty).try();
    cmd                      = lo.model(
        cl,
        t,
        path,
        lo.table_str(t, "about").try()
    ).try();
    record                   = decl_at(lo.tree, n.decl).match({
        Ok(d) => d.kind.match({ Struct(s) => Ok(s), _ => None }),
        None  => None,
    }).ok_or(unsupported(
        cl.span,
        "a command line struct without a declaration"
    )).try();
    found: Res<Vec<FieldAt>> = lo.shape(ty).try().form.match({
        Record(f) => Ok(f),
        _         => None,
    });
    layout                   = found.ok_or(unsupported(
        cl.span,
        "a command line struct without a layout"
    )).try();
    slots ::= lo.alloc.Vec<Slot>();
    next  :: i64 = 0;
    record.members.loop((member) {
        member.kind.match({
            Field(f) => layout.find((at) { at.name.eq(f.name.text) }).when_ok((at) {
                e = t.entry(f.name.text);
                slots.add(Slot(
                    id: next,
                    name: f.name.text,
                    ty: at.ty,
                    ask: lo.ask_of(at.ty, lo.trailing_in(e)),
                    positional: !f.mutable,
                    default: f.value,
                    entry: e
                )).try(LowerError.OutOfMemory);
                next = next + 1;
            }),
            _        => (),
        });
    });
    slots.loop((slot) { lo.declare(cl, t, cmd, slot).try(); });
    args ::= lo.alloc.Vec<Source>();
    args.put(cl.alloc).try();
    args.put(lo.read(cmd).try()).try();
    args.put(cl.env).try();
    args.put(cl.argv).try();
    args.put(start).try();
    args.put(cl.program).try();
    args.put(help).try();
    matches = lo.ok_payload(lo.checked(cl, "scan_fields", args).try()).try();
    at      = lo.spill(lo.blank(ty).try());
    slots.loop((slot) { lo.fill(cl, t, at, matches, slot).try(); });
    lo.read(at)
}

declare = (lo :: Lowerer, cl: CliLower, t: Table, cmd: Place, slot: Slot)
          Res<LowerError> {
    spec  = lo.spec_or_plain(cl, t, slot.entry).try();
    id    = lo.number("usize", slot.id).try();
    long  = lo.text(long_of(lo, slot.name).try().view()).try();
    shown = default_text(lo, slot.ask, slot.default).try();
    args ::= lo.alloc.Vec<Source>();
    args.put_at(cmd).try();
    args.put(id).try();
    args.put(long).try();
    slot.ask.match({
        Switch      => {
            args.put(spec).try();
            lo.checked(cl, "switch_field", args).try();
            Ok
        },
        Rest        => {
            one ::= lo.alloc.Vec<Source>();
            one.put_at(cmd).try();
            lo.std_call(DERIVE, "trailing_field", one, cl.span).try();
            Ok
        },
        Many        => lo.word_field(
            cl,
            args,
            slot,
            spec,
            shown,
            Word.Text,
            slot.positional,
            true
        ),
        One(word)   => lo.word_field(
            cl,
            args,
            slot,
            spec,
            shown,
            word,
            slot.default.match({ Ok(_) => false, None => true }),
            false
        ),
        Maybe(word) => lo.word_field(
            cl,
            args,
            slot,
            spec,
            shown,
            word,
            false,
            false
        ),
        Unfit       => Err(unsupported(
            cl.span,
            "a field std.cli cannot parse"
        )),
    })
}

word_field = (
    lo       :: Lowerer,
    cl       : CliLower,
    args     :: Vec<Source>,
    slot     : Slot,
    spec     : Value,
    shown    : Res<String>,
    word     : Word,
    required : bool,
    many     : bool
)
             Res<LowerError> {
    args.put(lo.text(upper_of(lo, slot.name).try().view()).try()).try();
    args.put(spec).try();
    args.put(lo.flag(slot.positional).try()).try();
    args.put(lo.flag(required).try()).try();
    args.put(lo.flag(many).try()).try();
    has = shown.match({ Ok(_) => true, None => false });
    args.put(
        shown.match({ Ok(s) => lo.text(s.view()), None => lo.text("") }).try()
    ).try();
    args.put(lo.flag(has).try()).try();
    helper = word.match({
        Unsigned(p) => { lo.limits(args, p, false).try(); "number_field" },
        Signed(p)   => { lo.limits(args, p, true).try(); "number_field" },
        Choice(e)   => {
            args.put(lo.text(choices_of(lo, e).try().view()).try()).try();
            "choice_field"
        },
        _           => "text_field",
    });
    lo.checked(cl, helper, args).try();
    Ok
}

limits = (lo :: Lowerer, args :: Vec<Source>, ty: TyId, signed: bool)
         Res<LowerError> {
    name     = lo.prim_name(ty);
    min: i64 = name.match({
        "i8"  => -128,
        "i16" => -32768,
        "i32" => -2147483648,
        "i64" => -9223372036854775807 - 1,
        _     => 0,
    });
    // u64's bits, stored in two's complement.
    max: i64 = name.match({
        "u8"  => 255,
        "u16" => 65535,
        "u32" => 4294967295,
        "i8"  => 127,
        "i16" => 32767,
        "i32" => 2147483647,
        "i64" => 9223372036854775807,
        _     => -1,
    });
    args.put(lo.flag(signed).try()).try();
    args.put(lo.number("i64", min).try()).try();
    args.put(lo.number("u64", max).try()).try();
    Ok
}

// Each field lands in the value: from its words, else its default.
fill = (
    lo      :: Lowerer,
    cl      : CliLower,
    t       : Table,
    at      : Place,
    matches : Value,
    slot    : Slot
)
       Res<LowerError> {
    place = lo.field_place(at, slot.name, cl.span).try();
    id    = lo.number("usize", slot.id).try();
    args ::= lo.alloc.Vec<Source>();
    slot.ask.match({
        Switch      => {
            args.put(matches).try();
            args.put(id).try();
            got   = lo.std_call(DERIVE, "switch_of", args, cl.span).try();
            value = slot.default.match({
                Ok(e) => {
                    d   = lo.foreign(t.ty, t.module, e, Ok(slot.ty)).try();
                    out = lo.slot_of(Scalar.Bool).try();
                    lo.add(Instruction.BinaryValue(Binary(
                        out: out,
                        left: got.slot,
                        right: d.slot,
                        op: Op.Or,
                        span: cl.span
                    ))).try();
                    Value(slot: out, ty: got.ty)
                },
                None  => got,
            });
            lo.write(place, value)
        },
        Many        => {
            args.put(cl.alloc).try();
            args.put(matches).try();
            args.put(id).try();
            lo.write(
                place,
                lo.ok_payload(lo.checked(cl, "texts_of", args).try()).try()
            )
        },
        Rest        => {
            args.put(cl.alloc).try();
            args.put(cl.argv).try();
            args.put(matches).try();
            lo.write(
                place,
                lo.ok_payload(lo.checked(cl, "rest_of", args).try()).try()
            )
        },
        One(word)   => {
            got     = lo.word_of(cl, word, matches, id).try();
            present = lo.label().try();
            absent  = lo.label().try();
            after   = lo.label().try();
            lo.branch_to(lo.succeeded(got).try(), present, absent).try();
            lo.start(absent);
            slot.default.when_ok((e) {
                lo.write(
                    place,
                    lo.foreign(t.ty, t.module, e, Ok(slot.ty)).try()
                ).try();
            });
            lo.jump(after).try();
            lo.start(present);
            lo.write(
                place,
                lo.convert(word, slot.ty, lo.ok_payload(got).try()).try()
            ).try();
            lo.jump(after).try();
            lo.start(after);
            Ok
        },
        Maybe(word) => {
            got     = lo.word_of(cl, word, matches, id).try();
            present = lo.label().try();
            absent  = lo.label().try();
            after   = lo.label().try();
            lo.branch_to(lo.succeeded(got).try(), present, absent).try();
            lo.start(absent);
            lo.write(
                place,
                lo.variant_value(slot.ty, "None", None, cl.span).try()
            ).try();
            lo.jump(after).try();
            lo.start(present);
            inner = lo.check.types.at(
                slot.ty
            ).match({ Res(r) => r.value, _ => slot.ty });
            value = lo.convert(word, inner, lo.ok_payload(got).try()).try();
            lo.write(
                place,
                lo.variant_value(slot.ty, "Ok", Ok(value), cl.span).try()
            ).try();
            lo.jump(after).try();
            lo.start(after);
            Ok
        },
        Unfit       => Ok,
    })
}

// The helper answering one word's value: Res<str>, Res<Path>, Res<u64>,
// Res<i64>, or the Res<usize> position of a choice.
word_of = (lo :: Lowerer, cl: CliLower, word: Word, matches: Value, id: Value)
          Res<Value, LowerError> {
    args ::= lo.alloc.Vec<Source>();
    args.put(matches).try();
    args.put(id).try();
    helper = word.match({
        Text        => "text_of",
        Location    => "path_of",
        Unsigned(_) => "unsigned_of",
        Signed(_)   => "signed_of",
        Choice(e)   => {
            args.put(lo.text(choices_of(lo, e).try().view()).try()).try();
            "choice_of"
        },
    });
    lo.std_call(DERIVE, helper, args, cl.span)
}

// The word's value as the field's type: a number is narrowed (the engine
// checked its range) and a choice's position picks a variant.
convert = (
    lo   :: Lowerer,
    word : Word,
    ty   : TyId,
    got  : Value
) Res<Value, LowerError> {
    word.match({
        Choice(e)   => lo.choose(e, got),
        Unsigned(_) => lo.coerce(got, ty),
        Signed(_)   => lo.coerce(got, ty),
        _           => Ok(got),
    })
}

// The value equal to `position` among `ty`'s variants.
choose = (lo :: Lowerer, ty: TyId, position: Value) Res<Value, LowerError> {
    out   = lo.blank(ty).try();
    after = lo.label().try();
    at :: i64 = 0;
    lo.variants_of(ty).try().loop((v) {
        lo.when_equal(position, at, after, () {
            chosen = lo.variant_value(ty, v.name, None, nowhere()).try();
            lo.add(Instruction.Copy(Move(
                out: out.slot,
                source: chosen.slot
            ))).try();
            Ok
        }).try();
        at = at + 1;
    });
    lo.jump(after).try();
    lo.start(after);
    Ok(out)
}

// `if (value == n) { body; goto after; }`, continuing after the test.
when_equal = (
    lo    :: Lowerer,
    value : Value,
    n     : i64,
    after : usize,
    body  : () Res<LowerError>
) Res<LowerError> {
    k  = lo.constant(value.ty, n).try();
    eq = lo.slot_of(Scalar.Bool).try();
    lo.add(Instruction.BinaryValue(Binary(
        out: eq,
        left: value.slot,
        right: k.slot,
        op: Op.Equal,
        span: nowhere()
    ))).try();
    yes = lo.label().try();
    no  = lo.label().try();
    lo.branch_to(eq, yes, no).try();
    lo.start(yes);
    body().try();
    lo.jump(after).try();
    lo.start(no);
    Ok
}

// One enum: each variant a subcommand, then `help` and maybe `--version`,
// then the chosen variant's own command.
variants = (
    lo    :: Lowerer,
    cl    : CliLower,
    ty    : TyId,
    path  : Value,
    start : Value,
    help  : Value
)
           Res<Value, LowerError> {
    t    = lo.table_of(ty).try();
    cmd  = lo.model(cl, t, path, lo.table_str(t, "about").try()).try();
    alts = lo.variants_of(ty).try();
    at :: i64 = 0;
    alts.loop((v) {
        args ::= lo.alloc.Vec<Source>();
        args.put_at(cmd).try();
        args.put(lo.number("usize", at).try()).try();
        args.put(lo.text(kebab(lo, v.name).try().view()).try()).try();
        args.put(lo.variant_about(t, v).try()).try();
        lo.checked(cl, "command_field", args).try();
        at = at + 1;
    });
    count = lo.number("usize", at).try();
    helps ::= lo.alloc.Vec<Source>();
    helps.put(cl.alloc).try();
    helps.put_at(cmd).try();
    helps.put(count).try();
    helps.put(cl.program).try();
    lo.checked(cl, "help_field", helps).try();
    version = lo.table_str(t, "version").try();
    t.entry("version").when_ok((_) {
        args ::= lo.alloc.Vec<Source>();
        args.put_at(cmd).try();
        args.put(lo.number("usize", at + 1).try()).try();
        lo.checked(cl, "version_field", args).try();
    });
    scan ::= lo.alloc.Vec<Source>();
    scan.put(cl.alloc).try();
    scan.put(lo.read(cmd).try()).try();
    scan.put(cl.env).try();
    scan.put(cl.argv).try();
    scan.put(start).try();
    scan.put(cl.program).try();
    scan.put(help).try();
    scan.put(count).try();
    scan.put(version).try();
    pick    = lo.spill(
        lo.ok_payload(lo.checked(cl, "scan_commands", scan).try()).try()
    );
    variant = lo.read(lo.field_place(pick, "variant", cl.span).try()).try();
    next    = lo.read(lo.field_place(pick, "next", cl.span).try()).try();
    asked   = lo.read(lo.field_place(pick, "help", cl.span).try()).try();
    out     = lo.blank(ty).try();
    after   = lo.label().try();
    i :: i64 = 0;
    alts.loop((v) {
        lo.when_equal(variant, i, after, () {
            built = lo.chosen(cl, ty, v, path, next, asked).try();
            lo.add(Instruction.Copy(Move(
                out: out.slot,
                source: built.slot
            ))).try();
            Ok
        }).try();
        i = i + 1;
    });
    lo.jump(after).try();
    lo.start(after);
    Ok(out)
}

// The chosen variant: its payload's command, or an argument-less one.
chosen = (
    lo    :: Lowerer,
    cl    : CliLower,
    ty    : TyId,
    v     : VariantAt,
    path  : Value,
    next  : Value,
    asked : Value
)
         Res<Value, LowerError> {
    join ::= lo.alloc.Vec<Source>();
    join.put(cl.alloc).try();
    join.put(path).try();
    join.put(lo.text(kebab(lo, v.name).try().view()).try()).try();
    joined = lo.ok_payload(lo.checked(cl, "joined", join).try()).try();
    spell ::= lo.alloc.Vec<Source>();
    spell.put(joined).try();
    sub = lo.std_call(DERIVE, "spelled", spell, cl.span).try();
    v.payload.match({
        Ok(pty) => {
            inner = lo.command(cl, pty, sub, next, asked).try();
            lo.variant_value(ty, v.name, Ok(inner), cl.span)
        },
        None    => {
            t     = lo.table_of(ty).try();
            about = lo.entry_help(t, v.name).try().match({
                Ok(h) => h,
                None  => lo.text("").try(),
            });
            cmd   = lo.model(
                cl,
                Table(impl: None, module: 0, ty: ty),
                sub,
                about
            ).try();
            args ::= lo.alloc.Vec<Source>();
            args.put(cl.alloc).try();
            args.put(lo.read(cmd).try()).try();
            args.put(cl.env).try();
            args.put(cl.argv).try();
            args.put(next).try();
            args.put(cl.program).try();
            args.put(asked).try();
            lo.checked(cl, "scan_fields", args).try();
            lo.variant_value(ty, v.name, None, cl.span)
        },
    })
}

// A subcommand's line in its parent's help: the parent table's entry for
// the variant, else the payload's own `about`.
variant_about = (lo :: Lowerer, t: Table, v: VariantAt) Res<Value, LowerError> {
    lo.entry_help(t, v.name).try().match({
        Ok(h) => Ok(h),
        None  => v.payload.match({
            Ok(pty) => lo.table_str(lo.table_of(pty).try(), "about"),
            None    => lo.text(""),
        }),
    })
}

entry_help = (lo :: Lowerer, t: Table, name: str) Res<Res<Value>, LowerError> {
    lo.spec_of(t, t.entry(name)).try().match({
        Ok(spec) => Ok(Ok(
            lo.read(
                lo.field_place(lo.spill(spec), "help", nowhere()).try()
            ).try()
        )),
        None     => Ok(None),
    })
}

// ---------------------------------------------------------------------
// fields' shapes and spellings
// ---------------------------------------------------------------------

trailing_in = (lo :: Lowerer, entry: Res<ExprId>) bool {
    entry.match({
        None    => false,
        Ok(eid) => lo.tree.expr_at(eid).kind.match({
            Call(c) => c.args.find((a) {
                a.name.match({ Ok(n) => n.text.eq("trailing"), None => false })
                    && lo.tree.expr_at(a.value).kind.match({
                        Literal(l) => l.text.eq("true"),
                        _          => false,
                    })
            }).match({ Ok(_) => true, None => false }),
            _       => false,
        }),
    })
}

ask_of = (lo :: Lowerer, ty: TyId, trailing: bool) Ask {
    lo.check.types.at(ty).match({
        Prim(p)  => p.name.eq("bool").match({
            true  => Ask.Switch,
            false => lo.word_kind(ty).match({ Ok(w) => Ask.One(w), None => Ask.Unfit }),
        }),
        Res(r)   => is_failure(r.form).match({
            true  => Ask.Unfit,
            false => lo.word_kind(r.value).match({ Ok(w) => Ask.Maybe(w), None => Ask.Unfit }),
        }),
        Named(n) => lo.str_vec(n).match({
            true  => trailing.match({ true => Ask.Rest, false => Ask.Many }),
            false => lo.word_kind(ty).match({ Ok(w) => Ask.One(w), None => Ask.Unfit }),
        }),
        _        => Ask.Unfit,
    })
}

str_vec = (lo :: Lowerer, n: TyNamed) bool {
    n.name.eq("Vec") && n.args.get(0).match({
        Ok(arg) => lo.is_str(arg),
        None    => false,
    })
}

word_kind = (lo :: Lowerer, ty: TyId) Res<Word> {
    lo.check.types.at(ty).match({
        Prim(p)  => p.name.match({
            "str"   => Ok(Word.Text),
            "u8"    => Ok(Word.Unsigned(ty)),
            "u16"   => Ok(Word.Unsigned(ty)),
            "u32"   => Ok(Word.Unsigned(ty)),
            "u64"   => Ok(Word.Unsigned(ty)),
            "usize" => Ok(Word.Unsigned(ty)),
            "i8"    => Ok(Word.Signed(ty)),
            "i16"   => Ok(Word.Signed(ty)),
            "i32"   => Ok(Word.Signed(ty)),
            "i64"   => Ok(Word.Signed(ty)),
            _       => None,
        }),
        Named(n) => (n.name.eq("Path") && lo.check.world.module_name(n.decl).eq("std.core.path")).match({
            true  => Ok(Word.Location),
            false => lo.unit_enum(n).match({ true => Ok(Word.Choice(ty)), false => None }),
        }),
        _        => None,
    })
}

unit_enum = (lo :: Lowerer, n: TyNamed) bool {
    decl_at(lo.tree, n.decl).match({
        Ok(decl) => decl.kind.match({
            Enum(e) => e.variants.len > 0 && e.variants.find((v) {
                v.payload.match({ Ok(_) => true, None => false })
            }).match({ Ok(_) => false, None => true }),
            _       => false,
        }),
        None     => false,
    })
}

choices_of = (lo :: Lowerer, ty: TyId) Res<String, LowerError> {
    out ::= lo.alloc.String().try(LowerError.OutOfMemory);
    lo.variants_of(ty).try().loop((h, i, v) {
        (i > 0).then(() { out.add('|').try(LowerError.OutOfMemory); });
        out.add(kebab(lo, v.name).try().view()).try(LowerError.OutOfMemory);
    });
    Ok(out)
}

kebab = (lo :: Lowerer, name: str) Res<String, LowerError> {
    out ::= lo.alloc.String().try(LowerError.OutOfMemory);
    Range(0, name.len).loop((h, i) {
        b     = name.index(i);
        upper = b >= 'A' && b <= 'Z';
        (upper && i > 0).then(() { out.add('-').try(LowerError.OutOfMemory); });
        out.add(
            upper.match({ true => b + 32, false => b })
        ).try(LowerError.OutOfMemory);
    });
    Ok(out)
}

long_of = (lo :: Lowerer, field: str) Res<String, LowerError> {
    out ::= lo.alloc.String("--").try(LowerError.OutOfMemory);
    Range(0, field.len).loop((h, i) {
        b = field.index(i);
        out.add(
            (b == '_').match({ true => '-', false => b })
        ).try(LowerError.OutOfMemory);
    });
    Ok(out)
}

upper_of = (lo :: Lowerer, field: str) Res<String, LowerError> {
    out ::= lo.alloc.String().try(LowerError.OutOfMemory);
    Range(0, field.len).loop((h, i) {
        b = field.index(i);
        out.add(
            (b >= 'a' && b <= 'z').match({ true => b - 32, false => b })
        ).try(LowerError.OutOfMemory);
    });
    Ok(out)
}

// The default shown in help: a literal number, string or variant.
default_text = (lo :: Lowerer, ask: Ask, default: Res<ExprId>)
               Res<Res<String>, LowerError> {
    ask.match({
        One(w) => default.match({
            Ok(eid) => lo.tree.expr_at(eid).kind.match({
                Literal(l) => l.kind.match({
                    Int => w.match({
                        Unsigned(_) => Ok(Ok(
                            lo.alloc.String(l.text).try(LowerError.OutOfMemory)
                        )),
                        Signed(_)   => Ok(Ok(
                            lo.alloc.String(l.text).try(LowerError.OutOfMemory)
                        )),
                        _           => Ok(None),
                    }),
                    Str => w.match({
                        Text     => quoted(lo, l.text),
                        Location => quoted(lo, l.text),
                        _        => Ok(None),
                    }),
                    _   => Ok(None),
                }),
                Access(a)  => w.match({
                    Choice(_) => Ok(Ok(kebab(lo, a.name.text).try())),
                    _         => Ok(None),
                }),
                _          => Ok(None),
            }),
            None    => Ok(None),
        }),
        _      => Ok(None),
    })
}

quoted = (lo :: Lowerer, text: str) Res<Res<String>, LowerError> {
    text.find('\\').match({
        Ok(_) => Ok(None),
        None  => Ok(Ok(
            lo.alloc.String(text.slice(
                1,
                text.len - 1
            )).try(LowerError.OutOfMemory)
        )),
    })
}

// A zeroed value of `ty`: every path writes one before it is read, but the
// engine's guarantees (a required field, a known variant) are not visible to
// the IR's initialization check.
blank = (lo :: Lowerer, ty: TyId) Res<Value, LowerError> {
    out  = lo.temp(ty).try();
    size = size_of(lo.class_of(ty).try());
    at   = lo.slot_of(Scalar.Ptr).try();
    lo.add(Instruction.AddressOf(Address(out: at, slot: out.slot))).try();
    offset :: usize = 0;
    Range(0, size / 8).loop((_) {
        lo.zero_at(at, offset, Scalar.U64).try();
        offset = offset + 8;
    });
    Range(offset, size).loop((_) {
        lo.zero_at(at, offset, Scalar.U8).try();
        offset = offset + 1;
    });
    Ok(out)
}

zero_at = (
    lo     :: Lowerer,
    at     : usize,
    offset : usize,
    class  : Scalar
) Res<LowerError> {
    zero = lo.word_const(class, 0).try();
    lo.add(Instruction.StoreValue(Store(base: at, offset: offset, value: zero)))
}
