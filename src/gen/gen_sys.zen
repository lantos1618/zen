// The operating-system interface of the native targets. Each operation has
// one portable name; a target maps it to a Linux system-call number or, on
// Darwin, to the libSystem function that owns that call. Darwin's syscall
// numbers are not a stable ABI, so its targets link libSystem instead of
// trapping into the kernel directly.
//
// Every operation returns a machine word. A negative result is `-errno` on
// every target: Darwin wrappers translate libSystem's `-1` plus `errno` into
// that form, so code above this layer never inspects an OS-specific errno.
{ str } = std.text
{ Res, Ok, None } = std.core

Sys* = { Read
    | Write
    | Openat
    | Close
    | Mmap
    | Munmap
    | ExitGroup
    | ClockGettime
    | Getrandom
    | Socket
    | Bind
    | Listen
    | Accept4
    | Connect
    | EpollCreate1
    | EpollCtl
    | EpollPwait
    | Kqueue
    | Kevent
    | Futex
    | Clone
    | Nanosleep
    | Mprotect
    | Madvise
    | Flock
    | Getcwd
    | Mkdirat
    | Unlinkat
    // Threads. `ThreadSelf` reads the calling thread's pointer: the thread
    // control block the runtime installed as TLS on Linux, `pthread_self()`
    // on Darwin. `CloneThread` starts a Linux thread on a caller-built stack
    // and control block (see `std.sys.sys_thread`); `PthreadStart` is the
    // Darwin equivalent over libSystem.
    | ThreadSelf
    | CloneThread
    | PthreadStart
    | PthreadJoin
    // Darwin's lock and condition objects, in caller memory. Linux programs
    // build theirs on `Futex` instead.
    | MutexInit
    | MutexLock
    | MutexUnlock
    | MutexDestroy
    | CondInit
    | CondWait
    | CondSignal
    | CondBroadcast
    | CondDestroy
    // CPU discovery: Linux's affinity mask, Darwin's sysconf.
    | SchedGetaffinity
    | Sysconf
    // One runtime word per thread: Linux keeps it in the thread control
    // block at +56, Darwin in a pthread key made at startup.
    | ThreadWordGet
    | ThreadWordSet
    // A call (code, first, second) that a checked trap inside it returns
    // from with 1 instead of ending the process; 0 when it returns. The
    // renderers' runtimes keep the innermost guard per thread.
    | GuardedCall }

// Word arguments each operation consumes, in kernel order.
arity* = (call: Sys) usize {
    call.match({
        Read             => 3,
        Write            => 3,
        Openat           => 4,
        Close            => 1,
        Mmap             => 6,
        Munmap           => 2,
        ExitGroup        => 1,
        ClockGettime     => 2,
        Getrandom        => 3,
        Socket           => 3,
        Bind             => 3,
        Listen           => 2,
        Accept4          => 4,
        Connect          => 3,
        EpollCreate1     => 1,
        EpollCtl         => 4,
        EpollPwait       => 6,
        Kqueue           => 0,
        Kevent           => 6,
        Futex            => 6,
        Clone            => 5,
        Nanosleep        => 2,
        Mprotect         => 3,
        Madvise          => 3,
        Flock            => 2,
        Getcwd           => 2,
        Mkdirat          => 3,
        Unlinkat         => 3,
        ThreadSelf       => 0,
        CloneThread      => 3,
        PthreadStart     => 1,
        PthreadJoin      => 2,
        MutexInit        => 2,
        MutexLock        => 1,
        MutexUnlock      => 1,
        MutexDestroy     => 1,
        CondInit         => 2,
        CondWait         => 2,
        CondSignal       => 1,
        CondBroadcast    => 1,
        CondDestroy      => 1,
        SchedGetaffinity => 3,
        Sysconf          => 1,
        ThreadWordGet    => 0,
        ThreadWordSet    => 1,
        GuardedCall      => 3,
    })
}

// arch/x86/entry/syscalls/syscall_64.tbl. None: the kernel has no such call.
linux_x86_64* = (call: Sys) Res<usize> {
    call.match({
        Read             => Ok(0),
        Write            => Ok(1),
        Openat           => Ok(257),
        Close            => Ok(3),
        Mmap             => Ok(9),
        Munmap           => Ok(11),
        ExitGroup        => Ok(231),
        ClockGettime     => Ok(228),
        Getrandom        => Ok(318),
        Socket           => Ok(41),
        Bind             => Ok(49),
        Listen           => Ok(50),
        Accept4          => Ok(288),
        Connect          => Ok(42),
        EpollCreate1     => Ok(291),
        EpollCtl         => Ok(233),
        EpollPwait       => Ok(281),
        Kqueue           => None,
        Kevent           => None,
        Futex            => Ok(202),
        Clone            => Ok(56),
        Nanosleep        => Ok(35),
        Mprotect         => Ok(10),
        Madvise          => Ok(28),
        Flock            => Ok(73),
        Getcwd           => Ok(79),
        Mkdirat          => Ok(258),
        Unlinkat         => Ok(263),
        SchedGetaffinity => Ok(204),
        _                => None,
    })
}

// include/uapi/asm-generic/unistd.h, shared by arm64 and other new ports.
linux_arm64* = (call: Sys) Res<usize> {
    call.match({
        Read             => Ok(63),
        Write            => Ok(64),
        Openat           => Ok(56),
        Close            => Ok(57),
        Mmap             => Ok(222),
        Munmap           => Ok(215),
        ExitGroup        => Ok(94),
        ClockGettime     => Ok(113),
        Getrandom        => Ok(278),
        Socket           => Ok(198),
        Bind             => Ok(200),
        Listen           => Ok(201),
        Accept4          => Ok(242),
        Connect          => Ok(203),
        EpollCreate1     => Ok(20),
        EpollCtl         => Ok(21),
        EpollPwait       => Ok(22),
        Kqueue           => None,
        Kevent           => None,
        Futex            => Ok(98),
        Clone            => Ok(220),
        Nanosleep        => Ok(101),
        Mprotect         => Ok(226),
        Madvise          => Ok(233),
        Flock            => Ok(32),
        Getcwd           => Ok(17),
        Mkdirat          => Ok(34),
        Unlinkat         => Ok(35),
        SchedGetaffinity => Ok(123),
        _                => None,
    })
}

// Linux x86-64 and AArch64 numbers the renderers' runtimes use directly.
LINUX_X86_64_EXIT*: usize = 60
LINUX_X86_64_ARCH_PRCTL*: usize = 158
LINUX_ARM64_EXIT*: usize = 93

// libSystem exports, without the Mach-O underscore. Operations Darwin spells
// differently map to their closest public equivalent; epoll, futex and raw
// clone have none and are refused rather than emulated here.
darwin_symbol* = (call: Sys) Res<str> {
    call.match({
        Read             => Ok("read"),
        Write            => Ok("write"),
        Openat           => Ok("openat"),
        Close            => Ok("close"),
        Mmap             => Ok("mmap"),
        Munmap           => Ok("munmap"),
        ExitGroup        => Ok("_exit"),
        ClockGettime     => Ok("clock_gettime"),
        Getrandom        => Ok("getentropy"),
        Socket           => Ok("socket"),
        Bind             => Ok("bind"),
        Listen           => Ok("listen"),
        Accept4          => Ok("accept"),
        Connect          => Ok("connect"),
        EpollCreate1     => None,
        EpollCtl         => None,
        EpollPwait       => None,
        Kqueue           => Ok("kqueue"),
        Kevent           => Ok("kevent"),
        Futex            => None,
        Clone            => None,
        Nanosleep        => Ok("nanosleep"),
        Mprotect         => Ok("mprotect"),
        Madvise          => Ok("madvise"),
        Flock            => Ok("flock"),
        Getcwd           => Ok("getcwd"),
        Mkdirat          => Ok("mkdirat"),
        Unlinkat         => Ok("unlinkat"),
        ThreadSelf       => Ok("pthread_self"),
        CloneThread      => None,
        PthreadStart     => Ok("pthread_create"),
        PthreadJoin      => Ok("pthread_join"),
        MutexInit        => Ok("pthread_mutex_init"),
        MutexLock        => Ok("pthread_mutex_lock"),
        MutexUnlock      => Ok("pthread_mutex_unlock"),
        MutexDestroy     => Ok("pthread_mutex_destroy"),
        CondInit         => Ok("pthread_cond_init"),
        CondWait         => Ok("pthread_cond_wait"),
        CondSignal       => Ok("pthread_cond_signal"),
        CondBroadcast    => Ok("pthread_cond_broadcast"),
        CondDestroy      => Ok("pthread_cond_destroy"),
        SchedGetaffinity => None,
        Sysconf          => Ok("sysconf"),
        ThreadWordGet    => None,
        ThreadWordSet    => None,
        GuardedCall      => None,
    })
}

// How a Darwin call reports failure. Most libSystem calls return -1 and set
// errno; the pthread family returns the error number itself (0 on success);
// `pthread_self` cannot fail and returns a handle.
DarwinResult* = { Errno | Returned | Handle }

darwin_result* = (call: Sys) DarwinResult {
    call.match({
        ThreadSelf    => DarwinResult.Handle,
        PthreadStart  => DarwinResult.Returned,
        PthreadJoin   => DarwinResult.Returned,
        MutexInit     => DarwinResult.Returned,
        MutexLock     => DarwinResult.Returned,
        MutexUnlock   => DarwinResult.Returned,
        MutexDestroy  => DarwinResult.Returned,
        CondInit      => DarwinResult.Returned,
        CondWait      => DarwinResult.Returned,
        CondSignal    => DarwinResult.Returned,
        CondBroadcast => DarwinResult.Returned,
        CondDestroy   => DarwinResult.Returned,
        _             => DarwinResult.Errno,
    })
}

// Kernel constants whose values differ between the targets.
SysConstant* = { AtFdcwd
    | ORdonly
    | OWronly
    | ORdwr
    | OCreat
    | OTrunc
    | OAppend
    | OCloexec
    | ODirectory
    | ClockMonotonic
    | ClockRealtime
    | EIntr
    | EAgain
    | MapPrivateAnonymous
    // 1 on Darwin, 0 on Linux: which thread primitives std.sys builds on.
    | IsDarwin
    // 1 where threads go through pthreads (Darwin), 0 on native Linux.
    | PthreadThreads }

// The operating systems and architectures with constant tables.
Platform* = { LinuxX86_64 | LinuxArm64 | Darwin }

// Linux values come from the uapi headers (asm-generic for AArch64, whose
// O_DIRECTORY differs from x86-64); Darwin values from the macOS SDK.
constant_value* = (name: SysConstant, platform: Platform) i64 {
    linux = platform.match({ Darwin => false, _ => true });
    name.match({
        AtFdcwd             => linux.match({ true => -100, false => -2 }),
        ORdonly             => 0,
        OWronly             => 1,
        ORdwr               => 2,
        OCreat              => linux.match({ true => 64, false => 512 }),
        OTrunc              => linux.match({ true => 512, false => 1024 }),
        OAppend             => linux.match({ true => 1024, false => 8 }),
        OCloexec            => linux.match({ true => 524288, false => 16777216 }),
        ODirectory          => platform.match({ LinuxX86_64 => 65536, LinuxArm64 => 16384, Darwin => 1048576 }),
        ClockMonotonic      => linux.match({ true => 1, false => 6 }),
        ClockRealtime       => 0,
        EIntr               => 4,
        EAgain              => linux.match({ true => 11, false => 35 }),
        // MAP_PRIVATE | MAP_ANONYMOUS
        MapPrivateAnonymous => linux.match({ true => 34, false => 4098 }),
        IsDarwin            => linux.match({ true => 0, false => 1 }),
        PthreadThreads      => linux.match({ true => 0, false => 1 }),
    })
}

// The Sys operation a std.sys declaration names.
sys_named* = (name: str) Res<Sys> {
    name.match({
        "read"                   => Ok(Sys.Read),
        "write"                  => Ok(Sys.Write),
        "openat"                 => Ok(Sys.Openat),
        "close"                  => Ok(Sys.Close),
        "mmap"                   => Ok(Sys.Mmap),
        "munmap"                 => Ok(Sys.Munmap),
        "exit_group"             => Ok(Sys.ExitGroup),
        "clock_gettime"          => Ok(Sys.ClockGettime),
        "getrandom"              => Ok(Sys.Getrandom),
        "socket"                 => Ok(Sys.Socket),
        "bind"                   => Ok(Sys.Bind),
        "listen"                 => Ok(Sys.Listen),
        "accept4"                => Ok(Sys.Accept4),
        "connect"                => Ok(Sys.Connect),
        "epoll_create1"          => Ok(Sys.EpollCreate1),
        "epoll_ctl"              => Ok(Sys.EpollCtl),
        "epoll_pwait"            => Ok(Sys.EpollPwait),
        "kqueue"                 => Ok(Sys.Kqueue),
        "kevent"                 => Ok(Sys.Kevent),
        "futex"                  => Ok(Sys.Futex),
        "clone"                  => Ok(Sys.Clone),
        "nanosleep"              => Ok(Sys.Nanosleep),
        "mprotect"               => Ok(Sys.Mprotect),
        "madvise"                => Ok(Sys.Madvise),
        "flock"                  => Ok(Sys.Flock),
        "getcwd"                 => Ok(Sys.Getcwd),
        "mkdirat"                => Ok(Sys.Mkdirat),
        "unlinkat"               => Ok(Sys.Unlinkat),
        "thread_self"            => Ok(Sys.ThreadSelf),
        "clone_thread"           => Ok(Sys.CloneThread),
        "pthread_start"          => Ok(Sys.PthreadStart),
        "pthread_join"           => Ok(Sys.PthreadJoin),
        "pthread_mutex_init"     => Ok(Sys.MutexInit),
        "pthread_mutex_lock"     => Ok(Sys.MutexLock),
        "pthread_mutex_unlock"   => Ok(Sys.MutexUnlock),
        "pthread_mutex_destroy"  => Ok(Sys.MutexDestroy),
        "pthread_cond_init"      => Ok(Sys.CondInit),
        "pthread_cond_wait"      => Ok(Sys.CondWait),
        "pthread_cond_signal"    => Ok(Sys.CondSignal),
        "pthread_cond_broadcast" => Ok(Sys.CondBroadcast),
        "pthread_cond_destroy"   => Ok(Sys.CondDestroy),
        "sched_getaffinity"      => Ok(Sys.SchedGetaffinity),
        "sysconf"                => Ok(Sys.Sysconf),
        "thread_word"            => Ok(Sys.ThreadWordGet),
        "set_thread_word"        => Ok(Sys.ThreadWordSet),
        "guarded_call"           => Ok(Sys.GuardedCall),
        _                        => None,
    })
}

constant_named* = (name: str) Res<SysConstant> {
    name.match({
        "at_fdcwd"              => Ok(SysConstant.AtFdcwd),
        "o_rdonly"              => Ok(SysConstant.ORdonly),
        "o_wronly"              => Ok(SysConstant.OWronly),
        "o_rdwr"                => Ok(SysConstant.ORdwr),
        "o_creat"               => Ok(SysConstant.OCreat),
        "o_trunc"               => Ok(SysConstant.OTrunc),
        "o_append"              => Ok(SysConstant.OAppend),
        "o_cloexec"             => Ok(SysConstant.OCloexec),
        "o_directory"           => Ok(SysConstant.ODirectory),
        "clock_monotonic"       => Ok(SysConstant.ClockMonotonic),
        "clock_realtime"        => Ok(SysConstant.ClockRealtime),
        "eintr"                 => Ok(SysConstant.EIntr),
        "eagain"                => Ok(SysConstant.EAgain),
        "map_private_anonymous" => Ok(SysConstant.MapPrivateAnonymous),
        "platform_darwin"       => Ok(SysConstant.IsDarwin),
        "pthread_threads"       => Ok(SysConstant.PthreadThreads),
        _                       => None,
    })
}
