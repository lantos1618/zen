// Validate the one IR before any renderer sees it. There is a single rule
// set: what a particular backend can render is its `supports` declaration
// (gen_ir_feature), checked separately, not a second verifier. Structural
// checks cover every block. Definite assignment intersects the outgoing facts of reachable
// predecessors until stable, so a backedge cannot invent an initial value.
{ Alloc } = std.mem
{ Vec } = std.collections
{ Res, Ok, Err, None, loop, Range, Error } = std.core
{ str } = std.text
{ Program, Func, Scalar, Instruction, Terminator, Op, Marshal } = gen.gen_ir
{ Guards, TagGuard, PayloadRead, Binary } = gen.gen_ir
{ same, word, integer, signed, float, width } = gen.gen_ir
{ arity } = gen.gen_sys

IrReason* = { EntryFunction
    | EntryParameters
    | ParameterSlots
    | MissingBlock
    | Slot
    | Type
    | Constant
    | Callee
    | Arguments
    | Target
    | Uninitialized
    | Guard
    | UnguardedPayload }

message* = (reason: IrReason) str {
    reason.match({
        EntryFunction    => "entry function is missing",
        EntryParameters  => "entry function takes arguments",
        ParameterSlots   => "parameter count exceeds the slot signature",
        MissingBlock     => "function has no entry block",
        Slot             => "instruction refers to a missing slot",
        Type             => "instruction types do not agree",
        Constant         => "constant does not fit its scalar type",
        Callee           => "call refers to a missing function",
        Arguments        => "call argument count does not match its signature",
        Target           => "terminator refers to a missing block",
        Uninitialized    => "slot is read before initialization on a reachable path",
        Guard            => "a recorded tag guard does not branch on that slot's tag",
        UnguardedPayload => "a payload is read without a test for its alternative on every path",
    })
}

IrFault* = { function*: usize, block*: usize, reason*: IrReason }
VerifyError* = { OutOfMemory | Invalid: IrFault }
VerifyError.impl(Error, {})

// The most arguments an indirect call may pass: the smallest register
// argument count among the targets (System V has six).
INDIRECT_ARGUMENTS*: usize = 6

// Whether a constant's bits are a value of its slot class.
fits = (ty: Scalar, value: i64) bool {
    ty.match({
        I32      => value >= -2147483648 && value <= 2147483647,
        Bool     => value == 0 || value == 1,
        Unit     => value == 0,
        I8       => value >= -128 && value <= 127,
        U8       => value >= 0 && value <= 255,
        I16      => value >= -32768 && value <= 32767,
        U16      => value >= 0 && value <= 65535,
        U32      => value >= 0 && value <= 4294967295,
        I64      => true,
        U64      => true,
        // Zero-extended from 64 bits.
        U128     => true,
        Ptr      => true,
        // Any bit pattern is a float (NaNs included); an f32's is 32 bits.
        F32      => value >= 0 && value <= 4294967295,
        F64      => true,
        Block(_) => false,
    })
}

Check = {
    program: Program,
    function: Func,
    index: usize,
    block :: usize = 0,

    fault = (self: @Self, reason: IrReason) VerifyError {
        VerifyError.Invalid(IrFault(
            function: self.index,
            block: self.block,
            reason: reason
        ))
    }

    slot = (self: @Self, index: usize) Res<Scalar, VerifyError> {
        self.function.slots.get(index).ok_or(self.fault(IrReason.Slot))
    }

    expect = (self: @Self, index: usize, ty: Scalar) Res<VerifyError> {
        self.slot(index).try().same(ty).ensure(self.fault(IrReason.Type)).try();
    }

    target = (self: @Self, index: usize) Res<VerifyError> {
        (index < self.function.blocks.len).ensure(self.fault(
            IrReason.Target
        )).try();
    }

    word_slot = (self: @Self, index: usize) Res<Scalar, VerifyError> {
        ty = self.slot(index).try();
        word(ty).ensure(self.fault(IrReason.Type)).try();
        Ok(ty)
    }

    instruction = (self: @Self, instruction: Instruction) Res<VerifyError> {
        instruction.match({
            Constant(value)      => {
                ty = self.slot(value.out).try();
                fits(ty, value.value).ensure(self.fault(IrReason.Constant)).try();
                Ok
            },
            Copy(value)          => self.expect(
                value.out,
                self.slot(value.source).try()
            ),
            UnaryValue(value)    => {
                ty = self.slot(value.input).try();
                value.op.match({
                    Neg => signed(ty) || float(ty),
                    Not => same(ty, Scalar.Bool),
                }).ensure(self.fault(IrReason.Type)).try();
                self.expect(value.out, ty)
            },
            BinaryValue(value)   => self.binary(
                value.left,
                value.right,
                value.out,
                value.op
            ),
            Invoke(call)         => {
                callee = self.program.functions.get(call.function)
                    .ok_or(self.fault(IrReason.Callee)).try();
                (callee.parameters == call.args.len).ensure(self.fault(
                    IrReason.Arguments
                )).try();
                call.args.loop((h, index, slot) {
                    ty = callee.slots.get(index).ok_or(self.fault(IrReason.ParameterSlots)).try();
                    self.expect(slot, ty).try();
                });
                self.expect(call.out, callee.result)
            },
            PrintValue(value)    => {
                ((word(value.ty) && !same(value.ty, Scalar.U128)) || same(value.ty, Scalar.Unit))
                    .ensure(self.fault(IrReason.Type)).try();
                self.expect(value.value, value.ty)
            },
            Text(_)              => Ok,
            Cast(value)          => {
                self.word_slot(value.input).try();
                self.word_slot(value.out).try();
                Ok
            },
            AddressOf(value)     => {
                self.slot(value.slot).try();
                self.expect(value.out, Scalar.Ptr)
            },
            LoadValue(value)     => {
                self.slot(value.out).try();
                self.expect(value.base, Scalar.Ptr)
            },
            StoreValue(value)    => {
                self.slot(value.value).try();
                self.expect(value.base, Scalar.Ptr)
            },
            CopyBytes(value)     => {
                self.expect(value.dest, Scalar.Ptr).try();
                self.expect(value.source, Scalar.Ptr).try();
                self.expect(value.bytes, Scalar.U64)
            },
            Bytes(value)         => {
                self.expect(value.out, Scalar.Ptr)
            },
            WriteOut(value)      => {
                self.expect(value.data, Scalar.Ptr).try();
                self.expect(value.len, Scalar.U64)
            },
            System(call)         => {
                (call.args.len == arity(call.call)).ensure(self.fault(IrReason.Arguments)).try();
                call.args.loop((slot) { self.word_slot(slot).try(); });
                self.expect(call.out, Scalar.I64)
            },
            MapPages(value)      => {
                self.expect(value.bytes, Scalar.U64).try();
                self.expect(value.out, Scalar.Ptr)
            },
            UnmapPages(slot)     => {
                self.expect(slot, Scalar.Ptr)
            },
            Flush                => Ok,
            FormatFloat(value)   => {
                self.expect(value.dest, Scalar.Ptr).try();
                self.expect(value.value, Scalar.F64).try();
                self.expect(value.out, Scalar.U64)
            },
            Host(call)           => {
                (call.args.len == call.marshal.len).ensure(self.fault(
                    IrReason.Arguments
                )).try();
                call.args.loop((h, i, slot) {
                    ty   = self.slot(slot).try();
                    fits = call.marshal.get(i).value_or(Marshal.Nothing).match({
                        Number  => integer(ty) || float(ty),
                        Flag    => same(ty, Scalar.Bool),
                        Text    => ty.match({ Block(l) => l.size == 16, _ => false }),
                        Bytes   => ty.match({ Block(l) => l.size == 16, _ => false }),
                        Handle  => same(ty, Scalar.U32),
                        Handler => same(ty, Scalar.U32),
                        Nothing => false,
                    });
                    fits.ensure(self.fault(IrReason.Type)).try();
                });
                // A runtime operation names one the JavaScript runtime has.
                known = call.member.eq("release") || call.member.eq("copy");
                (!call.runtime || (known && call.object.is_empty())).ensure(self.fault(
                    IrReason.Arguments
                )).try();
                out = self.slot(call.out).try();
                call.result.match({
                    Number  => integer(out) || float(out),
                    Flag    => same(out, Scalar.Bool),
                    Handle  => same(out, Scalar.U32),
                    Nothing => same(out, Scalar.Unit),
                    _       => false,
                }).ensure(self.fault(IrReason.Type)).try();
                Ok
            },
            Wait(slot)           => {
                self.expect(slot, Scalar.U32)
            },
            Foreign(call)        => {
                call.args.loop((slot) {
                    native_word(self.slot(slot).try()).ensure(self.fault(IrReason.Type)).try();
                });
                out = self.slot(call.out).try();
                (native_word(out) || same(out, Scalar.Unit)).ensure(self.fault(IrReason.Type)).try();
                Ok
            },
            NativeConst(value)   => {
                out = self.slot(value.out).try();
                integer(out).ensure(self.fault(IrReason.Type))
            },
            SysConst(value)      => integer(self.slot(value.out).try()).ensure(self.fault(IrReason.Type)).try(),
            Startup(value)       => {
                ty = value.value.match({ Argc => Scalar.U64, _ => Scalar.Ptr });
                self.expect(value.out, ty)
            },
            VolatileLoad(value)  => {
                scalar_word(self.slot(value.out).try()).ensure(self.fault(IrReason.Type)).try();
                self.expect(value.base, Scalar.Ptr)
            },
            VolatileStore(value) => {
                scalar_word(self.slot(value.value).try()).ensure(self.fault(IrReason.Type)).try();
                self.expect(value.base, Scalar.Ptr)
            },
            Barrier              => Ok,
            AtomicLoad(value)    => {
                self.atomic_word(value.out).try();
                self.expect(value.base, Scalar.Ptr)
            },
            AtomicStore(value)   => {
                self.atomic_word(value.value).try();
                self.expect(value.base, Scalar.Ptr)
            },
            AtomicUpdate(value)  => {
                ty = self.atomic_word(value.out).try();
                value.op.match({ Add => integer(ty), Swap => true })
                    .ensure(self.fault(IrReason.Type)).try();
                self.expect(value.value, ty).try();
                self.expect(value.base, Scalar.Ptr)
            },
            CompareSwap(value)   => {
                ty = self.atomic_word(value.out).try();
                self.expect(value.expected, ty).try();
                self.expect(value.desired, ty).try();
                self.expect(value.base, Scalar.Ptr)
            },
            CodeAddress(value)   => {
                self.program.functions.get(value.function).ok_or(self.fault(IrReason.Callee)).try();
                self.expect(value.out, Scalar.Ptr)
            },
            InvokeAt(call)       => {
                self.expect(call.target, Scalar.Ptr).try();
                // Every renderer passes these in argument registers.
                (call.args.len <= INDIRECT_ARGUMENTS).ensure(self.fault(
                    IrReason.Arguments
                )).try();
                call.args.loop((slot) { self.word_slot(slot).try(); });
                out = self.slot(call.out).try();
                (word(out) || same(out, Scalar.Unit)).ensure(self.fault(IrReason.Type)).try();
                Ok
            },
        })
    }

    // Atomic operations act on whole 4- or 8-byte words.
    atomic_word = (self: @Self, index: usize) Res<Scalar, VerifyError> {
        ty = self.word_slot(index).try();
        (width(ty) == 4 || width(ty) == 8).ensure(self.fault(IrReason.Type)).try();
        Ok(ty)
    }

    binary = (self: @Self, left: usize, right: usize, out: usize, op: Op)
             Res<VerifyError> {
        input        = self.slot(left).try();
        rhs          = self.slot(right).try();
        pointer_step = same(input, Scalar.Ptr) && same(rhs, Scalar.U64)
            && op.match({ WrapAdd => true, WrapSub => true, _ => false });
        shift        = op.match({ Shl => true, Shr => true, Rotr => true, _ => false });
        (pointer_step || (shift && same(rhs, Scalar.U64)) || same(input, rhs))
            .ensure(self.fault(IrReason.Type)).try();
        // Unit values compare equal: there is only one.
        unit  = same(input, Scalar.Unit);
        valid = op.match({
            Equal        => word(input) || unit,
            NotEqual     => word(input) || unit,
            Less         => integer(input) || float(input) || same(input, Scalar.Ptr),
            LessEqual    => integer(input) || float(input) || same(input, Scalar.Ptr),
            Greater      => integer(input) || float(input) || same(input, Scalar.Ptr),
            GreaterEqual => integer(input) || float(input) || same(input, Scalar.Ptr),
            Add          => integer(input) || float(input),
            Sub          => integer(input) || float(input),
            Mul          => integer(input) || float(input),
            Div          => integer(input) || float(input),
            Rem          => integer(input) || float(input),
            WrapAdd      => integer(input) || pointer_step,
            WrapSub      => integer(input) || pointer_step,
            And          => integer(input) || same(input, Scalar.Bool),
            Or           => integer(input) || same(input, Scalar.Bool),
            Xor          => integer(input) || same(input, Scalar.Bool),
            _            => integer(input),
        });
        valid.ensure(self.fault(IrReason.Type)).try();
        result = op.match({
            Equal => Scalar.Bool, NotEqual => Scalar.Bool,
            Less => Scalar.Bool, LessEqual => Scalar.Bool,
            Greater => Scalar.Bool, GreaterEqual => Scalar.Bool,
            _ => input,
        });
        self.expect(out, result)
    }

    exit = (self: @Self, exit: Terminator) Res<VerifyError> {
        exit.match({
            Return(slot)   => self.expect(slot, self.function.result),
            Jump(target)   => self.target(target),
            Branch(branch) => {
                self.expect(branch.value, Scalar.Bool).try();
                self.target(branch.yes).try();
                self.target(branch.no)
            },
            Trap(_)        => Ok,
        })
    }

    structure = (self :: @Self) Res<VerifyError> {
        (self.function.parameters <= self.function.slots.len)
            .ensure(self.fault(IrReason.ParameterSlots)).try();
        (self.function.blocks.len > 0).ensure(self.fault(
            IrReason.MissingBlock
        )).try();
        self.function.blocks.loop((h, index, block) {
            self.block = index;
            block.code.loop(
                (instruction) { self.instruction(instruction).try(); }
            );
            self.exit(block.exit).try();
        });
        Ok
    }

    initialized = (self: @Self, flags :: Init, slot: usize) Res<VerifyError> {
        (self.empty(slot) || flags.has(slot)).ensure(self.fault(IrReason.Uninitialized)).try();
    }

    // A slot of no bytes holds nothing that could be read uninitialized.
    empty = (self: @Self, slot: usize) bool {
        self.function.slots.get(slot).match({
            Ok(ty) => ty.match({ Block(l) => l.size == 0, _ => false }),
            None   => false,
        })
    }

    reads = (self: @Self, flags :: Init, instruction: Instruction) Res<VerifyError> {
        instruction.match({
            Constant(_)          => Ok,
            Copy(value)          => self.initialized(flags, value.source),
            UnaryValue(value)    => self.initialized(flags, value.input),
            BinaryValue(value)   => {
                self.initialized(flags, value.left).try();
                self.initialized(flags, value.right)
            },
            Invoke(call)         => {
                call.args.loop((slot) { self.initialized(flags, slot).try(); });
                Ok
            },
            PrintValue(value)    => self.initialized(flags, value.value),
            Text(_)              => Ok,
            Cast(value)          => self.initialized(flags, value.input),
            AddressOf(_)         => Ok,
            LoadValue(value)     => self.initialized(flags, value.base),
            StoreValue(value)    => {
                self.initialized(flags, value.base).try();
                self.initialized(flags, value.value)
            },
            CopyBytes(value)     => {
                self.initialized(flags, value.dest).try();
                self.initialized(flags, value.source).try();
                self.initialized(flags, value.bytes)
            },
            Bytes(_)             => Ok,
            WriteOut(value)      => {
                self.initialized(flags, value.data).try();
                self.initialized(flags, value.len)
            },
            System(call)         => {
                call.args.loop((slot) { self.initialized(flags, slot).try(); });
                Ok
            },
            Startup(_)           => Ok,
            MapPages(value)      => self.initialized(flags, value.bytes),
            UnmapPages(slot)     => self.initialized(flags, slot),
            SysConst(_)          => Ok,
            Flush                => Ok,
            FormatFloat(value)   => {
                self.initialized(flags, value.dest).try();
                self.initialized(flags, value.value)
            },
            Host(call)           => {
                call.args.loop((slot) { self.initialized(flags, slot).try(); });
                Ok
            },
            Wait(_)              => Ok,
            Foreign(call)        => {
                call.args.loop((slot) { self.initialized(flags, slot).try(); });
                Ok
            },
            NativeConst(_)       => Ok,
            VolatileLoad(value)  => self.initialized(flags, value.base),
            VolatileStore(value) => {
                self.initialized(flags, value.base).try();
                self.initialized(flags, value.value)
            },
            Barrier              => Ok,
            AtomicLoad(value)    => self.initialized(flags, value.base),
            AtomicStore(value)   => {
                self.initialized(flags, value.base).try();
                self.initialized(flags, value.value)
            },
            AtomicUpdate(value)  => {
                self.initialized(flags, value.base).try();
                self.initialized(flags, value.value)
            },
            CompareSwap(value)   => {
                self.initialized(flags, value.base).try();
                self.initialized(flags, value.expected).try();
                self.initialized(flags, value.desired)
            },
            CodeAddress(_)       => Ok,
            InvokeAt(call)       => {
                self.initialized(flags, call.target).try();
                call.args.loop((slot) { self.initialized(flags, slot).try(); });
                Ok
            },
        })
    }

    exit_reads = (self: @Self, flags :: Init, exit: Terminator) Res<VerifyError> {
        exit.match({
            Return(slot)   => self.initialized(flags, slot),
            Branch(branch) => self.initialized(flags, branch.value),
            Jump(_)        => Ok,
            Trap(_)        => Ok,
        })
    }
}

refill = (flags :: Vec<bool>, count: usize, value: bool) Res<VerifyError> {
    flags.clear();
    Range(0, count).loop((_) { flags.add(value).try(VerifyError.OutOfMemory); });
    Ok
}

// Structural validation has established the bounds of every slot and edge.
write = (flags :: Init, instruction: Instruction) {
    instruction.match({
        Constant(value)     => { flags.note(value.out); },
        Copy(value)         => { flags.note(value.out); },
        UnaryValue(value)   => { flags.note(value.out); },
        BinaryValue(value)  => { flags.note(value.out); },
        Invoke(value)       => { flags.note(value.out); },
        Cast(value)         => { flags.note(value.out); },
        // Stores through the pointer may initialize the slot.
        AddressOf(value)    => {
            flags.note(value.out);
            flags.note(value.slot);
        },
        LoadValue(value)    => { flags.note(value.out); },
        Bytes(value)        => { flags.note(value.out); },
        System(value)       => { flags.note(value.out); },
        Startup(value)      => { flags.note(value.out); },
        MapPages(value)     => { flags.note(value.out); },
        SysConst(value)     => { flags.note(value.out); },
        Host(value)         => { flags.note(value.out); },
        Wait(slot)          => { flags.note(slot); },
        Foreign(value)      => { flags.note(value.out); },
        NativeConst(value)  => { flags.note(value.out); },
        VolatileLoad(value) => { flags.note(value.out); },
        AtomicLoad(value)   => { flags.note(value.out); },
        AtomicUpdate(value) => { flags.note(value.out); },
        CompareSwap(value)  => { flags.note(value.out); },
        CodeAddress(value)  => { flags.note(value.out); },
        InvokeAt(value)     => { flags.note(value.out); },
        FormatFloat(value)  => { flags.note(value.out); },
        _                   => (),
    });
}

// The initialization facts at one point of one block. A slot is initialized
// when the block wrote it earlier (its `stamp` is this walk's `mark`) or
// when it is initialized on entry. Only `cross` slots, those some block
// reads before writing, carry entry facts; while `probing`, a read before a
// write marks the slot as one of them instead.
Init = {
    stamp :: Vec<usize>,
    mark :: usize,
    probing :: bool,
    exposed :: Vec<bool>,
    cross :: Vec<usize>,
    entry :: Vec<bool>,
    made :: Vec<bool>,

    begin = (self :: @Self) { self.mark = self.mark + 1; }

    has = (self :: @Self, slot: usize) bool {
        (self.stamp.get(slot).value_or(0) == self.mark).match({
            true  => true,
            false => self.probing.match({
                true  => {
                    self.exposed.set(slot, true);
                    true
                },
                false => self.entry.get(self.cross.get(slot).value_or(NO_SLOT)).value_or(false),
            }),
        })
    }

    note = (self :: @Self, slot: usize) {
        self.stamp.set(slot, self.mark);
        at = self.cross.get(slot).value_or(NO_SLOT);
        (at != NO_SLOT).then(() { self.made.set(at, true); });
    }
}

// Facts flow only for `cross` slots, indexed by their position in `members`;
// a slot written and read within one block is checked by that block alone.
Flow = {
    alloc: Alloc,
    check :: Check,
    reachable :: Vec<bool>,
    predecessors :: Vec<Vec<usize>>,
    outgoing :: Vec<Vec<bool>>,
    made :: Vec<Vec<bool>>,
    scratch :: Vec<bool>,
    stamp :: Vec<usize>,
    exposed :: Vec<bool>,
    cross :: Vec<usize>,
    members :: Vec<usize>,

    connect = (self :: @Self, from: usize, to: usize) Res<VerifyError> {
        pred ::= self.predecessors.get(to).ok_or(self.check.fault(IrReason.Target)).try();
        pred.add(from).try(VerifyError.OutOfMemory);
        self.predecessors.set(to, pred);
        Ok
    }

    // The rows are reused from function to function, so the verifier holds
    // one function's graph at a time rather than the whole program's.
    reset = (self :: @Self, check: Check) Res<VerifyError> {
        self.check = check;
        slots      = check.function.slots.len;
        refill(self.reachable, check.function.blocks.len, false).try();
        refill_words(self.stamp, slots, 0).try();
        refill(self.exposed, slots, false).try();
        refill_words(self.cross, slots, NO_SLOT).try();
        self.members.clear();
        check.function.blocks.loop((h, index, _) {
            (index >= self.predecessors.len).then(() {
                self.predecessors.add(
                    self.alloc.Vec<usize>()
                ).try(VerifyError.OutOfMemory);
                self.outgoing.add(
                    self.alloc.Vec<bool>()
                ).try(VerifyError.OutOfMemory);
                self.made.add(
                    self.alloc.Vec<bool>()
                ).try(VerifyError.OutOfMemory);
            });
            pred ::= self.predecessors.get(index).ok_or(self.check.fault(IrReason.Target)).try();
            pred.clear();
            self.predecessors.set(index, pred);
        });
        Ok
    }

    graph = (self :: @Self) Res<VerifyError> {
        self.check.function.blocks.loop((h, index, block) {
            block.exit.match({
                Jump(to)       => self.connect(index, to),
                Branch(branch) => {
                    self.connect(index, branch.yes).try();
                    self.connect(index, branch.no)
                },
                Return(_)      => Ok,
                Trap(_)        => Ok,
            }).try();
        });
        self.reachable.set(0, true);
        work ::= self.alloc.Vec<usize>();
        work.add(0).try(VerifyError.OutOfMemory);
        at :: usize = 0;
        loop(() { at < work.len }, (h) {
            index = work.get(at).ok_or(self.check.fault(IrReason.Target)).try();
            self.check.function.blocks.get(index).ok_or(self.check.fault(IrReason.Target)).try().exit.match({
                Jump(to)       => self.visit(to, work),
                Branch(branch) => { self.visit(branch.yes, work).try(); self.visit(branch.no, work) },
                Return(_)      => Ok,
                Trap(_)        => Ok,
            }).try();
            at = at + 1;
        });
        Ok
    }

    visit = (self :: @Self, block: usize, work :: Vec<usize>) Res<VerifyError> {
        (!self.reachable.get(block).value_or(false)).then(() {
            self.reachable.set(block, true);
            work.add(block).try(VerifyError.OutOfMemory);
        });
        Ok
    }

    incoming = (self: @Self, block: usize, incoming :: Vec<bool>) Res<VerifyError> {
        parameters = self.check.function.parameters;
        self.members.loop((h, at, slot) {
            incoming.set(at, block != 0 || slot < parameters);
        });
        predecessors = self.predecessors.get(block).ok_or(self.check.fault(IrReason.Target)).try();
        predecessors.loop((predecessor) {
            self.reachable.get(predecessor).value_or(false).then(() {
                previous = self.outgoing.get(predecessor).ok_or(self.check.fault(IrReason.Target)).try();
                Range(0, incoming.len).loop((at) {
                    (!previous.get(at).value_or(false)).then(() { incoming.set(at, false); });
                });
            });
        });
        Ok
    }

    // Walk every reachable block once with `init`, checking its reads.
    walk = (self :: @Self, init :: Init) Res<VerifyError> {
        self.check.function.blocks.loop((h, index, block) {
            self.reachable.get(index).value_or(false).then(() {
                self.check.block = index;
                (!init.probing).then(() {
                    self.incoming(index, self.scratch).try();
                });
                init.begin();
                block.code.loop((instruction) {
                    self.check.reads(init, instruction).try();
                    init.write(instruction);
                });
                self.check.exit_reads(init, block.exit).try();
            });
        });
        Ok
    }

    solve = (self :: @Self) Res<VerifyError> {
        init ::= Init(
            stamp: self.stamp,
            mark: 0,
            probing: true,
            exposed: self.exposed,
            cross: self.cross,
            entry: self.scratch,
            made: self.scratch
        );
        self.walk(init).try();
        Range(0, self.exposed.len).loop((slot) {
            self.exposed.get(slot).value_or(false).then(() {
                self.cross.set(slot, self.members.len);
                self.members.add(slot).try(VerifyError.OutOfMemory);
            });
        });
        count = self.members.len;
        refill(self.scratch, count, false).try();
        init.entry = self.scratch;
        self.check.function.blocks.loop((h, index, block) {
            row ::= self.outgoing.get(index).ok_or(self.check.fault(IrReason.Target)).try();
            refill(row, count, true).try();
            self.outgoing.set(index, row);
            made ::= self.made.get(index).ok_or(self.check.fault(IrReason.Target)).try();
            refill(made, count, false).try();
            self.made.set(index, made);
            init.made = made;
            init.begin();
            block.code.loop((instruction) { init.write(instruction); });
        });
        changed ::= true;
        loop(() { changed }, (h) {
            changed = false;
            self.check.function.blocks.loop((bh, index, block) {
                self.reachable.get(index).value_or(false).then(() {
                    next ::= self.scratch;
                    self.incoming(index, next).try();
                    made = self.made.get(index).ok_or(self.check.fault(IrReason.Target)).try();
                    old ::= self.outgoing.get(index).ok_or(self.check.fault(IrReason.Target)).try();
                    Range(0, count).loop((at) {
                        bit = next.get(at).value_or(false) || made.get(at).value_or(false);
                        (old.get(at).value_or(false) != bit).then(() {
                            changed = true;
                            old.set(at, bit);
                        });
                    });
                });
            });
        });
        init.probing = false;
        init.made    = self.alloc.Vec<bool>();
        self.walk(init)
    }
}

// The one verifier. A program that passes it is well formed for every
// renderer; whether a renderer implements each construct is its `supports`.
verify* = (program: Program, alloc: Alloc) Res<VerifyError> {
    checked(program, alloc)
}

checked = (program: Program, alloc: Alloc) Res<VerifyError> {
    entry = program.functions.get(program.entry).ok_or(VerifyError.Invalid(IrFault(function: program.entry, block: 0, reason: IrReason.EntryFunction))).try();
    (entry.parameters == 0).ensure(VerifyError.Invalid(IrFault(
        function: program.entry,
        block: 0,
        reason: IrReason.EntryParameters
    ))).try();
    program.functions.loop((h, index, function) {
        check ::= Check(program: program, function: function, index: index);
        check.structure().try();
    });
    flow ::= Flow(
        alloc: alloc,
        check: Check(program: program, function: entry, index: program.entry),
        reachable: alloc.Vec<bool>(),
        predecessors: alloc.Vec<Vec<usize>>(),
        outgoing: alloc.Vec<Vec<bool>>(),
        made: alloc.Vec<Vec<bool>>(),
        scratch: alloc.Vec<bool>(),
        stamp: alloc.Vec<usize>(),
        exposed: alloc.Vec<bool>(),
        cross: alloc.Vec<usize>(),
        members: alloc.Vec<usize>()
    );
    program.functions.loop((h, index, function) {
        flow.reset(Check(
            program: program,
            function: function,
            index: index
        )).try();
        flow.graph().try();
        flow.solve().try();
    });
    payloads ::= Payloads(
        alloc: alloc,
        function: entry,
        index: program.entry,
        guards: Guards(
            tests: alloc.Vec<TagGuard>(),
            reads: alloc.Vec<PayloadRead>()
        ),
        entry: alloc.Vec<Vec<usize>>(),
        state: alloc.Vec<usize>(),
        yes: alloc.Vec<usize>(),
        no: alloc.Vec<usize>(),
        defs: alloc.Vec<usize>(),
        def_block: alloc.Vec<usize>(),
        def_index: alloc.Vec<usize>(),
        member: alloc.Vec<usize>(),
        block: 0
    );
    program.functions.loop((h, index, function) {
        function.guards.when_ok((guards) {
            payloads.reset(function, index, guards).try();
            payloads.check().try();
        });
    });
    Ok
}

// Rule 3 of docs/IR_ARCHITECTURE.md §4.1: a payload read sits behind a test
// of the same slot for the same alternative on every path to it, with no
// write to the slot in between. The lowering records its tests and reads
// (gen_ir.Guards); each test is first checked to be what it claims, a
// branch on `Equal(Load(AddressOf(subject), 0), Const(variant))`, so the
// record cannot vouch for a read the code does not guard.
//
// Facts are one known alternative per slot: KNOWN_NONE when nothing is
// known, UNREACHED before any path arrives. A write to the slot forgets its
// fact, and so does a store or call through a pointer to it; a store
// through a pointer of unknown origin forgets every fact.
// Alternative indices are small; these two never name one.
UNREACHED: usize = 4294967295
KNOWN_NONE: usize = 4294967294
// No slot or alternative has this index.
NO_SLOT: usize = 4294967293

// The fact rows and the three working states are reused from function to
// function and from pass to pass; their length is the function's slot count.
Payloads = {
    alloc: Alloc,
    function :: Func,
    index :: usize,
    guards :: Guards,
    entry :: Vec<Vec<usize>>,
    state :: Vec<usize>,
    yes :: Vec<usize>,
    no :: Vec<usize>,
    defs :: Vec<usize>,
    def_block :: Vec<usize>,
    def_index :: Vec<usize>,
    member :: Vec<usize>,
    block :: usize,

    reset = (self :: @Self, function: Func, index: usize, guards: Guards) Res<VerifyError> {
        self.function = function;
        self.index    = index;
        self.guards   = guards;
        self.block    = 0;
        refill_words(self.member, function.slots.len, NO_SLOT).try();
        facts :: usize = 0;
        guards.tests.loop((g) {
            (self.fact(g.subject) == NO_SLOT).then(() {
                self.member.set(g.subject, facts);
                facts = facts + 1;
            });
        });
        guards.reads.loop((r) {
            (self.fact(r.subject) == NO_SLOT).then(() {
                self.member.set(r.subject, facts);
                facts = facts + 1;
            });
        });
        slots = facts;
        refill_words(self.state, slots, KNOWN_NONE).try();
        refill_words(self.yes, slots, KNOWN_NONE).try();
        refill_words(self.no, slots, KNOWN_NONE).try();
        function.blocks.loop((h, at, _) {
            (at >= self.entry.len).then(() {
                self.entry.add(
                    self.alloc.Vec<usize>()
                ).try(VerifyError.OutOfMemory);
            });
            row ::= self.entry.get(at).ok_or(VerifyError.OutOfMemory).try();
            refill_words(
                row,
                slots,
                (at == 0).match({ true => KNOWN_NONE, false => UNREACHED })
            ).try();
            self.entry.set(at, row);
        });
        refill_words(self.defs, function.slots.len, 0).try();
        refill_words(self.def_block, function.slots.len, NO_SLOT).try();
        refill_words(self.def_index, function.slots.len, NO_SLOT).try();
        function.blocks.loop((h, at, block) {
            block.code.loop((ih, i, instruction) {
                written(instruction).match({
                    Ok(slot) => {
                        self.defs.set(
                            slot,
                            self.defs.get(slot).value_or(0) + 1
                        );
                        self.def_block.set(slot, at);
                        self.def_index.set(slot, i);
                    },
                    None     => (),
                });
            });
        });
        Ok
    }

    fault = (self: @Self, reason: IrReason) VerifyError {
        VerifyError.Invalid(IrFault(
            function: self.index,
            block: self.block,
            reason: reason
        ))
    }

    check = (self :: @Self) Res<VerifyError> {
        self.guards.tests.loop((g) {
            self.block = g.block;
            self.genuine(g).ensure(self.fault(IrReason.Guard)).try();
        });
        // Facts are kept only for the slots guards test; a function without
        // payload reads has nothing to prove.
        (self.guards.reads.len > 0).then(() {
            self.solve().try();
            self.guards.reads.loop((r) {
                self.block = r.block;
                state ::= self.state;
                self.state_at(r.block, r.at, state).try();
                known = state.get(self.fact(r.subject)).value_or(KNOWN_NONE);
                (known == UNREACHED || known == r.variant)
                    .ensure(self.fault(IrReason.UnguardedPayload)).try();
            });
        });
        Ok
    }

    // The only instruction writing `slot`, when exactly one does.
    only_def = (self: @Self, slot: usize) Res<Instruction> {
        (self.defs.get(slot).value_or(0) == 1).match({
            false => None,
            true  => self.function.blocks.get(self.def_block.get(slot).value_or(NO_SLOT)).try().code.get(self.def_index.get(slot).value_or(NO_SLOT)),
        })
    }

    genuine = (self: @Self, g: TagGuard) bool {
        branch: Res<usize>     = self.function.blocks.get(g.block).match({
            None  => None,
            Ok(b) => b.exit.match({ Branch(br) => Ok(br.value), _ => None }),
        });
        test: Res<Instruction> = branch.match({ Ok(v) => self.only_def(
            v
        ), None => None });
        compare: Res<Binary>   = test.match({
            Ok(i) => i.match({ BinaryValue(b) => b.op.match({ Equal => Ok(
                b
            ), _ => None }), _ => None }),
            None  => None,
        });
        compare.match({
            None  => false,
            Ok(b) => self.constant_is(b.right, g.variant) && self.loads_tag_of(b.left, g.subject),
        })
    }

    constant_is = (self: @Self, slot: usize, variant: usize) bool {
        self.only_def(slot).match({
            Ok(i) => i.match({ Constant(c) => c.value.to_usize().value_or(
                NO_SLOT
            ) == variant, _ => false }),
            None  => false,
        })
    }

    loads_tag_of = (self: @Self, slot: usize, subject: usize) bool {
        self.only_def(slot).match({
            Ok(i) => i.match({
                LoadValue(l) => l.offset == 0 && self.pointee(l.base).value_or(NO_SLOT) == subject,
                _            => false,
            }),
            None  => false,
        })
    }

    // The slot a pointer addresses, followed through copies and pointer
    // arithmetic; None when its origin is not a slot of this function.
    pointee = (self: @Self, pointer: usize) Res<usize> {
        self.only_def(pointer).try().match({
            AddressOf(a)   => Ok(a.slot),
            Copy(m)        => self.pointee(m.source),
            BinaryValue(b) => b.op.match({
                WrapAdd => self.pointee(b.left),
                WrapSub => self.pointee(b.left),
                _       => None,
            }),
            _              => None,
        })
    }

    solve = (self :: @Self) Res<VerifyError> {
        changed ::= true;
        loop(() { changed }, (lh) {
            changed = false;
            self.function.blocks.loop((bh, index, block) {
                start   = self.entry.get(index).ok_or(VerifyError.OutOfMemory).try();
                reached = start.get(
                    0
                ).match({ Ok(v) => v != UNREACHED, None => true });
                reached.then(() {
                    out ::= self.state;
                    self.state_at(index, block.code.len, out).try();
                    block.exit.match({
                        Jump(to)   => { changed = self.merge(
                            to,
                            out
                        ).try() || changed; },
                        Branch(br) => {
                            guard: Res<TagGuard> = self.guards.tests.find(
                                (g) { g.block == index }
                            );
                            yes ::= self.yes;
                            no  ::= self.no;
                            assign(yes, out);
                            assign(no, out);
                            guard.when_ok((g) {
                                yes.set(self.fact(g.subject), g.variant);
                                g.otherwise.when_ok(
                                    (o) { no.set(self.fact(g.subject), o); }
                                );
                            });
                            changed = self.merge(br.yes, yes).try() || changed;
                            changed = self.merge(br.no, no).try() || changed;
                        },
                        _          => (),
                    });
                });
            });
        });
        Ok
    }

    // Meet `incoming` into the entry facts of `block`; true when they changed.
    merge = (self :: @Self, block: usize, incoming: Vec<usize>) Res<bool, VerifyError> {
        facts   ::= self.entry.get(block).ok_or(VerifyError.OutOfMemory).try();
        changed ::= false;
        Range(0, facts.len).loop((slot) {
            old = facts.get(slot).value_or(KNOWN_NONE);
            new = incoming.get(slot).value_or(KNOWN_NONE);
            met = (old == UNREACHED).match({
                true  => new,
                false => (old == new).match({ true => old, false => KNOWN_NONE }),
            });
            (met != old).then(() { facts.set(slot, met); changed = true; });
        });
        self.entry.set(block, facts);
        Ok(changed)
    }

    // The facts in `block` before instruction `at`.
    state_at = (self: @Self, block: usize, at: usize, state :: Vec<usize>) Res<VerifyError> {
        start = self.entry.get(block).ok_or(VerifyError.OutOfMemory).try();
        assign(state, start);
        code = self.function.blocks.get(block).ok_or(VerifyError.OutOfMemory).try().code;
        code.loop((h, i, instruction) {
            (i >= at).then(() { h.break(); });
            self.forget(state, instruction);
        });
        Ok
    }

    forget = (self: @Self, state :: Vec<usize>, instruction: Instruction) {
        written(instruction).when_ok((slot) { self.forget_slot(state, slot); });
        // Writes through a pointer, listed without a fallback for the same
        // reason as `written`.
        instruction.match({
            StoreValue(s)    => self.forget_through(state, s.base),
            CopyBytes(c)     => self.forget_through(state, c.dest),
            Invoke(c)        => c.args.loop(
                (a) { self.forget_argument(state, a); }
            ),
            System(c)        => c.args.loop(
                (a) { self.forget_argument(state, a); }
            ),
            Host(c)          => c.args.loop(
                (a) { self.forget_argument(state, a); }
            ),
            VolatileStore(v) => self.forget_through(state, v.base),
            AtomicStore(v)   => self.forget_through(state, v.base),
            AtomicUpdate(v)  => self.forget_through(state, v.base),
            CompareSwap(v)   => self.forget_through(state, v.base),
            InvokeAt(c)      => c.args.loop(
                (a) { self.forget_argument(state, a); }
            ),
            VolatileLoad(_)  => (),
            Barrier          => (),
            AtomicLoad(_)    => (),
            CodeAddress(_)   => (),
            Wait(_)          => (),
            Foreign(c)       => c.args.loop(
                (a) { self.forget_argument(state, a); }
            ),
            NativeConst(_)   => (),
            Constant(_)      => (),
            Copy(_)          => (),
            UnaryValue(_)    => (),
            BinaryValue(_)   => (),
            PrintValue(_)    => (),
            Text(_)          => (),
            Cast(_)          => (),
            AddressOf(_)     => (),
            LoadValue(_)     => (),
            Bytes(_)         => (),
            WriteOut(_)      => (),
            Startup(_)       => (),
            MapPages(_)      => (),
            UnmapPages(_)    => (),
            SysConst(_)      => (),
            Flush            => (),
            FormatFloat(v)   => self.forget_through(state, v.dest),
        });
    }

    // The fact row index of `slot`, NO_SLOT when no guard tests it.
    fact = (self: @Self, slot: usize) usize {
        self.member.get(slot).value_or(NO_SLOT)
    }

    forget_slot = (self: @Self, state :: Vec<usize>, slot: usize) {
        at = self.fact(slot);
        (at != NO_SLOT).then(() { state.set(at, KNOWN_NONE); });
    }

    forget_argument = (self: @Self, state :: Vec<usize>, slot: usize) {
        self.function.slots.get(slot).match({
            Ok(ty) => ty.match({ Ptr => self.forget_through(
                state,
                slot
            ), _ => () }),
            None   => (),
        });
    }

    forget_through = (self: @Self, state :: Vec<usize>, pointer: usize) {
        self.pointee(pointer).match({
            Ok(slot) => self.forget_slot(state, slot),
            None     => Range(0, state.len).loop((slot) {
                (state.get(slot).value_or(KNOWN_NONE) != UNREACHED).then(() { state.set(slot, KNOWN_NONE); });
            }),
        });
    }
}

// The slot an instruction writes, if any. Every instruction is listed, with
// no fallback: a new instruction that writes a slot must say so here, or a
// payload fact about that slot would outlive the write.
written = (instruction: Instruction) Res<usize> {
    instruction.match({
        Constant(v)      => Ok(v.out),
        Copy(v)          => Ok(v.out),
        UnaryValue(v)    => Ok(v.out),
        BinaryValue(v)   => Ok(v.out),
        Invoke(v)        => Ok(v.out),
        Cast(v)          => Ok(v.out),
        AddressOf(v)     => Ok(v.out),
        LoadValue(v)     => Ok(v.out),
        Bytes(v)         => Ok(v.out),
        System(v)        => Ok(v.out),
        Startup(v)       => Ok(v.out),
        MapPages(v)      => Ok(v.out),
        SysConst(v)      => Ok(v.out),
        Host(v)          => Ok(v.out),
        Wait(slot)       => Ok(slot),
        Foreign(v)       => Ok(v.out),
        NativeConst(v)   => Ok(v.out),
        VolatileLoad(v)  => Ok(v.out),
        AtomicLoad(v)    => Ok(v.out),
        AtomicUpdate(v)  => Ok(v.out),
        CompareSwap(v)   => Ok(v.out),
        CodeAddress(v)   => Ok(v.out),
        InvokeAt(v)      => Ok(v.out),
        VolatileStore(_) => None,
        Barrier          => None,
        AtomicStore(_)   => None,
        PrintValue(_)    => None,
        Text(_)          => None,
        StoreValue(_)    => None,
        CopyBytes(_)     => None,
        WriteOut(_)      => None,
        UnmapPages(_)    => None,
        Flush            => None,
        FormatFloat(v)   => Ok(v.out),
    })
}

// Both runs have the function's slot count.
assign = (to :: Vec<usize>, from: Vec<usize>) {
    from.loop((h, slot, v) { to.set(slot, v); });
}

refill_words = (
    words :: Vec<usize>,
    count : usize,
    value : usize
) Res<VerifyError> {
    words.clear();
    Range(0, count).loop((_) { words.add(value).try(VerifyError.OutOfMemory); });
    Ok
}

// A volatile access moves one scalar word, never a block or unit.
scalar_word = (ty: Scalar) bool {
    ty.match({ Block(_) => false, Unit => false, _ => true })
}

// A word, float or pointer: what crosses a C call by value.
native_word = (ty: Scalar) bool {
    integer(ty) || float(ty) || same(ty, Scalar.Ptr) || same(ty, Scalar.Bool)
}
