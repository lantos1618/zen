// Short constructors for IR values and records: what builders, tests and transforms
// write, so each spells a register, a constant or an instruction one way.

{ Res, Ok } = std.core
{
    ScalarType, Constant, IntegerConstant, Value, Instruction, InstructionRecord,
    IntBinary, IntOp, Overflow, RegisterId, InstructionId
} = ir.records

reg* = (i: u32) RegisterId { RegisterId(index: i) }

// The value held in a register.
value_of* = (r: RegisterId) Value { Value.Register(r) }

i32_const* = (n: u64) Value { Value.Constant(Constant.Integer(IntegerConstant(type: ScalarType.I32, bits: n))) }

record* = (id: u32, i: Instruction) InstructionRecord { InstructionRecord(id: InstructionId(index: id), instruction: i) }

checked_add* = (dst: RegisterId, lhs: Value, rhs: Value) Instruction {
    Instruction.IntBinary(IntBinary(dst: dst, op: IntOp.Add(Overflow.Checked), lhs: lhs, rhs: rhs))
}
