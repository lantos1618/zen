// COMPILER.md Appendix B: the reference interpreter. It is the oracle every route is
// compared against, and the comptime engine (I.4).
//
// Integers are kept encoded in u64: two's complement, masked to their width. Every
// overflow is computed, never trapped on by the host.
//
// A trap or a failure travels on the error channel as a `Stop`, so `.try()` returns
// early from any depth: a trap in a nested call unwinds to `run` with no checks between.

{
    Res, Ok, Err, None, Range, to_usize, to_u64, to_u128, truncate_u64,
    bit_and, bit_or, bit_xor, shift_left, shift_right, IoError
} = std.core
{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ str, str_at, String } = std.text
{ Console } = std.env
{
    Module, Function, Block, Import, ScalarType, IntegerConstant, Value,
    Instruction, Exit, Callee, IntOp, Overflow, IntPredicate,
    TrapCode, Id, Register, Symbol
} = ir.records
{ Runtime } = ir.runtime
{ DiagnosticCode, DiagnosticStage, Diagnostic } = ir.diagnostic
{ Int, int } = ir.int
{ Ir } = ir.validate
{ Limits } = limits

RuntimeValue* = {
    | Int: IntegerConstant
    | Bool: bool
    | F32: u32
    | F64: u64
    | NullPointer
    | Function: Id<Function>
    | NullFunction
    | Environment               // main's Env: what the runtime imports write through
    | Data: DataAddress,

    // Whether this value is a well-formed value of type t (integers masked to the width).
    fits_type* = (self: @Self, t: ScalarType) bool {
        self.match({
            Int(k)       => k.type.same(t) && k.bits.bit_and(int(t).mask()) == k.bits,
            Bool(_)      => t.match({ Bool => true, _ => false }),
            F32(_)       => t.match({ F32 => true, _ => false }),
            F64(_)       => t.match({ F64 => true, _ => false }),
            NullPointer  => t.match({ Pointer => true, _ => false }),
            Function(_)  => t.match({ FunctionPointer(_) => true, _ => false }),
            NullFunction => t.match({ FunctionPointer(_) => true, _ => false }),
            Environment  => t.match({ Pointer => true, _ => false }),
            Data(_)      => t.match({ Pointer => true, _ => false }),
        })
    }
}

// An address in a global: its symbol, and a byte offset into its initializer.
DataAddress* = { symbol*: Id<Symbol>, offset*: u64 }

// One output stream as the interpreter keeps it: the line being built, and the sticky
// failure (0 while writes succeed, else the IoError's discriminant).
Channel = { line :: String, failed :: u8 }

// B.2: a program fault that is neither a value nor a trap.
InterpreterFault* = {
    | DeadAllocation
    | OutOfBoundsAccess
    | Misaligned
    | PermissionDenied
    | UninitializedMemory
    | InvalidPointer
    | ImportContractViolation
}

Outcome* = {
    | Returned: Res<RuntimeValue>
    | Trapped: TrapCode
    | Fault: InterpreterFault
    | ResourceLimit
}

// Why execution stopped early: an outcome to report (a trap, a limit), or a diagnostic.
Stop = {
    | Halt: Outcome
    | Fail: Diagnostic
}

Next = {
    | Go: Id<Block>
    | Done: Res<RuntimeValue>
}


// Run one function of a validated module.
run* = (
    a    : Alloc,
    out  : Console,             // where the program's writes go
    ir   : Ir,
    f    : Id<Function>,
    args : Vec<RuntimeValue>
) Res<Outcome, Diagnostic> {
    m        = ir.view();
    function = m.function(f).match({
        Ok(function) => function,
        None         => diagnostic<Function>(
            DiagnosticCode.UnsupportedFeature,
            "running an import"
        ).try(),
    });
    (args.len == function.parameters.len).match({
        true  => (),
        false => diagnostic<()>(
            DiagnosticCode.ArityMismatch,
            "argument count differs from the signature"
        ).try(),
    });
    function.parameters.loop((h, k, r) {
        t  = function.register_type(
            r
        ).match({ Ok(t) => t, None => ScalarType.Bool });
        ok = args.get(k).match({ Ok(v) => v.fits_type(t), None => false });
        ok.match({
            true  => (),
            false => diagnostic<()>(
                DiagnosticCode.TypeMismatch,
                "an argument does not fit its parameter"
            ).try(),
        });
    });

    machine ::= Machine(
        m: m,
        a: a,
        frames: a.Vec<Vec<RuntimeValue>>(),
        staged: a.Vec<Vec<RuntimeValue>>(),
        steps: 0,
        depth: 0,
        console: out,
        out: Channel(line: String(data: a.Vec<u8>()), failed: 0),
        err: Channel(line: String(data: a.Vec<u8>()), failed: 0),
    );
    machine.call(f, args).match({
        Ok(value) => Ok(Outcome.Returned(value)),
        Err(stop) => stop.match({
            Halt(outcome) => Ok(outcome),
            Fail(d)       => Err(d),
        }),
    })
}

diagnostic = <T>(code: DiagnosticCode, what: str) Res<T, Diagnostic> {
    Err(Diagnostic(
        code: code,
        stage: DiagnosticStage.IR,
        function: None,
        block: None,
        instruction: None,
        message: what,
    ))
}

fail = <T>(code: DiagnosticCode, what: str) Res<T, Stop> {
    diagnostic<T>(code, what).match({
        Ok(x)  => Ok(x),
        Err(d) => Err(Stop.Fail(d)),
    })
}

halt = <T>(outcome: Outcome) Res<T, Stop> { Err(Stop.Halt(outcome)) }

trapped = <T>(code: TrapCode) Res<T, Stop> { halt<T>(Outcome.Trapped(code)) }

// An integer result in the interpreter: the bits, or a Stop carrying the trap.
arith = (r: Res<u64, TrapCode>) Res<u64, Stop> {
    r.match({
        Ok(bits) => Ok(bits),
        Err(code) => trapped<u64>(code),
    })
}

// ---- the machine

Machine = {
    m: Module,
    a: Alloc,
    frames :: Vec<Vec<RuntimeValue>>,     // registers, one buffer per call depth, reused
    staged :: Vec<Vec<RuntimeValue>>,     // call arguments, one buffer per call depth, reused
    steps :: u64,
    depth :: u32,
    console: Console,
    out :: Channel,
    err :: Channel,

    // A defined function runs here; an import is a runtime function the host provides.
    call = (self :: @Self, id: Id<Function>, args: Vec<RuntimeValue>) Res<Res<RuntimeValue>, Stop> {
        self.m.function(id).match({
            Ok(f) => self.enter(f, args),
            None  => self.host(id, args),
        })
    }

    enter = (self :: @Self, f: Function, args: Vec<RuntimeValue>) Res<Res<RuntimeValue>, Stop> {
        (self.depth >= Limits.RUN_DEPTH).match({ true => halt<()>(
            Outcome.ResourceLimit
        ).try(), false => () });

        regs ::= self.buffer(self.frames, f.register_types.len).try();
        f.parameters.loop((h, k, r) {
            regs.set(
                r.index.to_usize(),
                args.get(k).match({ Ok(v) => v, None => RuntimeValue.Bool(false) })
            );
        });

        self.depth = self.depth + 1;
        value      = self.blocks(f, regs).try();
        self.depth = self.depth - 1;
        Ok(value)
    }

    // ---- the runtime functions (ir/runtime.zen)

    // The import's runtime function, on the stream its second argument names. A stream
    // that has failed answers its failure without writing.
    host = (self :: @Self, id: Id<Function>, args: Vec<RuntimeValue>) Res<Res<RuntimeValue>, Stop> {
        im = self.m.import(id).match({ Ok(im) => im, None => fail<Import>(
            DiagnosticCode.InvalidId,
            "a call to no function"
        ).try() });
        name = self.m.symbol(im.symbol).match({ Ok(s) => s.external_name, None => None });
        r = name.match({ Ok(n) => Runtime.find(n), None => None }).match({ Ok(r) => r, None => fail<Runtime>(
            DiagnosticCode.UnsupportedFeature,
            "an import the interpreter doesn't provide"
        ).try() });
        stream = self.arg(args, 1).bits;
        status ::= self.channel(stream).failed;
        (status == 0).then(() {
            r.match({
                Write     => { self.write_bytes(stream, self.bytes(args).try()).try(); },
                WriteI32  => { self.write_i32(stream, self.arg(args, 2).bits).try(); },
                WriteBool => {
                    yes = self.truth_of(args, 2);
                    self.write_bytes(stream, yes.match({ true => "true", false => "false" })).try();
                },
            });
            status = self.channel(stream).failed;
        });
        Ok(Ok(RuntimeValue.Int(IntegerConstant(type: ScalarType.U8, bits: status.to_u64()))))
    }

    arg = (self: @Self, args: Vec<RuntimeValue>, k: usize) IntegerConstant {
        args.get(k).match({ Ok(v) => v.match({ Int(i) => i, _ => ZERO }), None => ZERO })
    }

    truth_of = (self: @Self, args: Vec<RuntimeValue>, k: usize) bool {
        args.get(k).match({ Ok(v) => v.match({ Bool(b) => b, _ => false }), None => false })
    }

    channel = (self: @Self, stream: u64) Channel { (stream == 2).match({ true => self.err, false => self.out }) }

    // zen_write's bytes: len bytes of a global's initializer, from the address's offset.
    bytes = (self: @Self, args: Vec<RuntimeValue>) Res<str, Stop> {
        at = args.get(2).match({ Ok(v) => v.match({ Data(d) => Ok(d), _ => None }), None => None });
        place = at.match({
            Ok(d) => d,
            None  => halt<DataAddress>(Outcome.Fault(InterpreterFault.InvalidPointer)).try(),
        });
        data ::= "";
        self.m.globals.loop((h, g) {
            (g.symbol.index == place.symbol.index).then(() {
                g.initializer.get(0).match({
                    Ok(part) => part.match({ Bytes(b) => { data = str_at(b.ptr(), b.len); }, _ => () }),
                    None     => (),
                });
                h.break();
            });
        });
        from = place.offset.to_usize().match({ Ok(n) => n, None => data.len + 1 });
        count = self.arg(args, 3).bits.to_usize().match({ Ok(n) => n, None => data.len + 1 });
        inside = from <= data.len && count <= data.len - from;
        inside.match({ true => (), false => halt<()>(Outcome.Fault(InterpreterFault.OutOfBoundsAccess)).try() });
        Ok(data.slice(from, from + count))
    }

    // An i32 in decimal, with a minus sign when negative.
    write_i32 = (self :: @Self, stream: u64, bits: u64) Res<(), Stop> {
        t = int(ScalarType.I32);
        t.negative(bits).then(() { self.write_bytes(stream, "-").try(); });
        digits ::= String(data: self.a.Vec<u8>());
        self.memory(digits.write_usize(t.magnitude(bits).to_usize().match({ Ok(n) => n, None => 0 }))).try();
        self.write_bytes(stream, digits.view())
    }

    // Bytes join the stream's line; each newline sends the line to the console.
    write_bytes = (self :: @Self, stream: u64, bytes: str) Res<(), Stop> {
        c ::= self.channel(stream);
        Range(0, bytes.len).loop((i) {
            b = bytes.get(i).match({ Ok(b) => b, None => 0 });
            (b == '\n').match({
                true  => { self.send(stream, c).try(); c.line.clear(); },
                false => { self.memory(c.line.add(b)).try(); },
            });
        });
        self.keep(stream, c);
        Ok
    }

    // The line, to stdout or stderr; a failure sticks to the stream.
    send = (self :: @Self, stream: u64, c :: Channel) Res<(), Stop> {
        sent = (stream == 2).match({
            true  => self.console.errorln("{}", c.line.view()),
            false => self.console.println("{}", c.line.view()),
        });
        // std's IoError as its discriminant in a Res<IoError> (front/check/library.zen)
        failed = sent.match({
            Ok     => 0,
            Err(e) => e.match({ Closed => 1, Full => 2, Invalid => 3, Interrupted => 4 }),
        });
        c.failed = failed;
        Ok
    }

    keep = (self :: @Self, stream: u64, c: Channel) {
        (stream == 2).match({ true => { self.err = c; }, false => { self.out = c; } });
    }

    // Running out of memory is a resource limit, like steps and depth.
    memory = (self: @Self, r: Res<AllocError>) Res<(), Stop> {
        r.match({
            Ok     => Ok,
            Err(_) => halt<()>(Outcome.ResourceLimit),
        })
    }

    // The buffer for the current call depth: cleared, then n values long.
    // A depth's buffer is free again once the call at that depth has returned.
    buffer = (self :: @Self, pool :: Vec<Vec<RuntimeValue>>, n: usize) Res<Vec<RuntimeValue>, Stop> {
        d = self.depth.to_usize();
        Range(pool.len, d + 1).loop((i) { self.memory(pool.add(self.a.Vec<RuntimeValue>())).try(); });
        v ::= pool.get(d).match({ Ok(v) => v, None => halt<Vec<RuntimeValue>>(Outcome.ResourceLimit).try() });
        v.clear();
        self.memory(v.reserve(n)).try();
        Range(0, n).loop((i) { self.memory(v.add(RuntimeValue.Bool(false))).try(); });
        pool.set(d, v);
        Ok(v)
    }

    // Runs blocks until a Return; every other way out is a Stop.
    blocks = (self :: @Self, f: Function, regs :: Vec<RuntimeValue>) Res<Res<RuntimeValue>, Stop> {
        at       ::= f.entry;
        returned :: Res<RuntimeValue> = None;
        done     ::= false;
        Range(0, Limits.RUN_STEPS).loop((h, _) {
            b = f.block(at).match({
                Ok(b) => b,
                None  => fail<Block>(
                    DiagnosticCode.InvalidSuccessor,
                    "a missing block"
                ).try(),
            });
            b.instructions.loop((rec) {
                self.steps = self.steps + 1;
                (self.steps > Limits.RUN_STEPS).match({ true => halt<()>(
                    Outcome.ResourceLimit
                ).try(), false => () });
                self.execute(f, regs, rec.instruction).try();
            });
            self.exit(regs, b.exit).try().match({
                Go(next) => { at = next; },
                Done(v)  => { returned = v; done = true; h.break(); },
            });
        });
        done.match({
            true  => Ok(returned),
            false => halt<Res<RuntimeValue>>(Outcome.ResourceLimit),
        })
    }

    value = (self: @Self, regs: Vec<RuntimeValue>, v: Value) RuntimeValue {
        v.match({
            Register(r) => regs.get(r.index.to_usize()).match({ Ok(x) => x, None => RuntimeValue.Bool(false) }),
            Constant(c) => c.match({
                Bool(b)                => RuntimeValue.Bool(b),
                Integer(k)             => RuntimeValue.Int(k),
                F32Bits(b)             => RuntimeValue.F32(b),
                F64Bits(b)             => RuntimeValue.F64(b),
                NullPointer            => RuntimeValue.NullPointer,
                NullFunctionPointer(_) => RuntimeValue.NullFunction,
            }),
        })
    }

    int = (self: @Self, regs: Vec<RuntimeValue>, v: Value) IntegerConstant {
        self.value(regs, v).match({
            Int(k) => k,
            _      => IntegerConstant(type: ScalarType.U64, bits: 0),
        })
    }

    truth = (self: @Self, regs: Vec<RuntimeValue>, v: Value) bool {
        self.value(regs, v).match({ Bool(b) => b, _ => false })
    }

    // Inputs are read before the destination is written, so `r = r + 1` reads the old r.
    execute = (self :: @Self, f: Function, regs :: Vec<RuntimeValue>, i: Instruction) Res<(), Stop> {
        set = (r: Id<Register>, v: RuntimeValue) { regs.set(
            r.index.to_usize(),
            v
        ); }
        integer = (t: ScalarType, bits: u64) RuntimeValue { RuntimeValue.Int(IntegerConstant(
            type: t,
            bits: bits
        )) }

        i.match({
            Set(x)        => set(x.dst, self.value(regs, x.value)),

            Select(x)     => set(x.dst, self.truth(regs, x.condition).match({
                true  => self.value(regs, x.yes),
                false => self.value(regs, x.no),
            })),

            IntBinary(x)  => {
                l    = self.int(regs, x.lhs);
                r    = self.int(regs, x.rhs);
                t    = int(l.type);
                bits = x.op.match({
                    Add(mode)      => arith(t.add(l.bits, r.bits, mode)).try(),
                    Subtract(mode) => arith(t.subtract(l.bits, r.bits, mode)).try(),
                    Multiply(mode) => arith(t.multiply(l.bits, r.bits, mode)).try(),
                    Divide         => arith(t.divide(l.bits, r.bits, false)).try(),
                    Remainder      => arith(t.divide(l.bits, r.bits, true)).try(),
                    And            => l.bits.bit_and(r.bits),
                    Or             => l.bits.bit_or(r.bits),
                    Xor            => l.bits.bit_xor(r.bits),
                    _              => arith(t.shift(l.bits, r, x.op)).try(),
                });
                set(x.dst, integer(l.type, bits));
            },

            IntCompare(x) => {
                equal  = x.op.match({ Equal => true, _ => false });
                r      = self.value(regs, x.rhs);
                result = self.value(regs, x.lhs).match({
                    Int(a)       => int(a.type).compare(
                        x.op,
                        a.bits,
                        r.match({ Int(b) => b.bits, _ => 0 })
                    ),
                    Bool(a)      => (a == r.match({ Bool(b) => b, _ => false })) == equal,
                    Function(a)  => r.match({ Function(b) => a.index == b.index, _ => false }) == equal,
                    NullFunction => r.match({ NullFunction => true, _ => false }) == equal,
                    _            => false,     // validation keeps floats and data pointers out of IntCompare
                });
                set(x.dst, RuntimeValue.Bool(result));
            },

            Convert(x)    => {
                to = f.register_type(
                    x.dst
                ).match({ Ok(t) => t, None => ScalarType.U64 });
                x.op.match({
                    BoolToInteger   => set(
                        x.dst,
                        integer(
                            to,
                            self.truth(
                                regs,
                                x.value
                            ).match({ true => 1, false => 0 })
                        )
                    ),
                    IntegerWrapping => {
                        k = self.int(regs, x.value);
                        set(
                            x.dst,
                            integer(
                                to,
                                int(k.type).wrap_to(int(to), k.bits)
                            )
                        );
                    },
                    IntegerChecked  => {
                        k = self.int(regs, x.value);
                        int(k.type).fits_in(int(to), k.bits).match({
                            true  => (),
                            false => trapped<()>(
                                TrapCode.InvalidConversion
                            ).try(),
                        });
                        set(
                            x.dst,
                            integer(
                                to,
                                int(k.type).wrap_to(int(to), k.bits)
                            )
                        );
                    },
                    _               => fail<()>(
                        DiagnosticCode.UnsupportedFeature,
                        "float and pointer conversions"
                    ).try(),
                });
            },

            Address(x)    => x.base.match({
                Symbol(sym) => set(x.dst, RuntimeValue.Data(DataAddress(
                    symbol: sym,
                    offset: self.int(regs, x.byte_offset).bits
                ))),
                _           => fail<()>(DiagnosticCode.UnsupportedFeature, "stack and register addresses").try(),
            }),

            Call(x)       => {
                result = self.call(
                    self.callee(regs, x.callee).try(),
                    self.arguments(regs, x.args).try()
                ).try();
                x.dst.match({
                    Ok(d) => result.match({ Ok(v) => set(d, v), None => () }),
                    None  => (),
                });
            },

            _             => fail<()>(
                DiagnosticCode.UnsupportedFeature,
                "float and memory instructions"
            ).try(),
        });
        Ok
    }

    arguments = (self :: @Self, regs: Vec<RuntimeValue>, args: Vec<Value>) Res<Vec<RuntimeValue>, Stop> {
        values ::= self.buffer(self.staged, args.len).try();
        args.loop((h, k, v) { values.set(k, self.value(regs, v)); });
        Ok(values)
    }

    callee = (self: @Self, regs: Vec<RuntimeValue>, c: Callee) Res<Id<Function>, Stop> {
        c.match({
            Function(id) => Ok(id),
            Register(r)  => self.value(regs, Value.Register(r)).match({
                Function(id) => Ok(id),
                _            => halt<Id<Function>>(Outcome.Fault(
                    InterpreterFault.InvalidPointer
                )),
            }),
        })
    }

    // Where control goes next: another block, or out with the returned value.
    // A Trap is a Stop.
    exit = (self :: @Self, regs :: Vec<RuntimeValue>, e: Exit) Res<Next, Stop> {
        e.match({
            Jump(x)      => Ok(Next.Go(x.target)),

            Branch(x)    => Ok(Next.Go(
                self.truth(
                    regs,
                    x.condition
                ).match({ true => x.yes, false => x.no })
            )),

            Switch(x)    => {
                k = self.int(regs, x.value);
                target ::= x.default;
                x.cases.loop((h, c) {
                    hit = c.value.match({ Integer(v) => v.bits == k.bits, _ => false });
                    hit.match({ true => { target = c.target; h.break(); }, false => () });
                });
                Ok(Next.Go(target))
            },

            Return(x)    => Ok(Next.Done(x.value.match({
                Ok(v) => Ok(self.value(regs, v)),
                None  => None,
            }))),

            Trap(x)      => trapped<Next>(x.code),

            CallNever(x) => {
                self.call(
                    self.callee(regs, x.callee).try(),
                    self.arguments(regs, x.args).try()
                ).try();
                fail<Next>(
                    DiagnosticCode.InvalidReturnContract,
                    "a Never function returned"
                )
            },
        })
    }
}

ZERO: IntegerConstant = IntegerConstant(type: ScalarType.U8, bits: 0)
