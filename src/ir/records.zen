// COMPILER.md §1.1, one to one. Every table is dense: an ID is its position,
// so `module.functions[f]` is one index. validate proves `table[i].id == i`.

{ Res, Ok, None, to_usize, to_u64 } = std.core
{ Vec } = std.collections
{ str } = std.text

FunctionId* = { index*: u32 }
SignatureId* = { index*: u32 }
RegisterId* = { index*: u32 }
BlockId* = { index*: u32 }
InstructionId* = { index*: u32 }
SymbolId* = { index*: u32 }
StackObjectId* = { index*: u32 }
GlobalId* = { index*: u32 }

ScalarType* = {
    Bool | I8 | U8 | I16 | U16 | I32 | U32 | I64 | U64 | F32 | F64
        | Pointer
        | FunctionPointer: SignatureId,

    // Equal codes are equal types, except FunctionPointer, which also compares signatures.
    code* = (self: @Self) u8 {
        self.match({
            Bool => 0, I8 => 1, U8 => 2, I16 => 3, U16 => 4, I32 => 5, U32 => 6,
            I64 => 7, U64 => 8, F32 => 9, F64 => 10, Pointer => 11, FunctionPointer(_) => 12,
        })
    }

    same* = (self: @Self, other: ScalarType) bool {
        self.match({
            FunctionPointer(s) => other.match({
                FunctionPointer(t) => s.index == t.index,
                _ => false,
            }),
            _ => self.code() == other.code(),
        })
    }

    is_integer* = (self: @Self) bool { self.code() >= 1 && self.code() <= 8 }
    is_signed* = (self: @Self) bool {
        self.match({ I8 => true, I16 => true, I32 => true, I64 => true, _ => false })
    }
    is_float* = (self: @Self) bool { self.code() == 9 || self.code() == 10 }

    width* = (self: @Self) u32 {
        self.match({
            Bool => 8, I8 => 8, U8 => 8, I16 => 16, U16 => 16,
            I32 => 32, U32 => 32, F32 => 32, _ => 64,
        })
    }
}

IntegerConstant* = { type*: ScalarType, bits*: u64 }

Constant* = {
    Bool: bool
        | Integer: IntegerConstant
        | F32Bits: u32
        | F64Bits: u64
        | NullPointer
        | NullFunctionPointer: SignatureId,

    type* = (self: @Self) ScalarType {
        self.match({
            Bool(_) => ScalarType.Bool,
            Integer(c) => c.type,
            F32Bits(_) => ScalarType.F32,
            F64Bits(_) => ScalarType.F64,
            NullPointer => ScalarType.Pointer,
            NullFunctionPointer(s) => ScalarType.FunctionPointer(s),
        })
    }
}

Value* = { Register: RegisterId | Constant: Constant }

Overflow* = { Checked | Wrapping }
IntOp* = {
    Add: Overflow | Subtract: Overflow | Multiply: Overflow
        | Divide | Remainder | And | Or | Xor
        | ShiftLeft | ShiftRightLogical | ShiftRightArithmetic,

    is_shift* = (self: @Self) bool {
        self.match({ ShiftLeft => true, ShiftRightLogical => true, ShiftRightArithmetic => true, _ => false })
    }
}
FloatOp* = { Add | Subtract | Multiply | Divide }
IntPredicate* = {
    Equal | NotEqual | Less | LessEqual | Greater | GreaterEqual,

    is_equality* = (self: @Self) bool { self.match({ Equal => true, NotEqual => true, _ => false }) }
}
FloatPredicate* = { Equal | NotEqual | Less | LessEqual | Greater | GreaterEqual | Unordered }
ConvertOp* = {
    IntegerChecked | IntegerWrapping | IntegerToFloat | FloatToIntegerChecked
        | FloatWidth | BoolToInteger | PointerToInteger | Bitcast
}
AddressBase* = { Register: RegisterId | StackObject: StackObjectId | Symbol: SymbolId }
Callee* = { Function: FunctionId | Register: RegisterId }
Access* = { Ordinary | Volatile }
MemoryAccess* = { alignment*: u32, access*: Access }

TrapCode* = {
    IntegerOverflow | DivisionByZero | InvalidShift | InvalidConversion
        | InvalidValue | StackOverflow
        | Explicit: u32,

    // The program result a trap reports (§1.2).
    code* = (self: @Self) u32 {
        self.match({
            IntegerOverflow => 1, DivisionByZero => 2, InvalidShift => 3,
            InvalidConversion => 4, InvalidValue => 5, StackOverflow => 6,
            Explicit(n) => n,
        })
    }
}

Set* = { dst*: RegisterId, value*: Value }
Select* = { dst*: RegisterId, condition*: Value, yes*: Value, no*: Value }
IntBinary* = { dst*: RegisterId, op*: IntOp, lhs*: Value, rhs*: Value }
FloatBinary* = { dst*: RegisterId, op*: FloatOp, lhs*: Value, rhs*: Value }
FloatNegate* = { dst*: RegisterId, value*: Value }
IntCompare* = { dst*: RegisterId, op*: IntPredicate, lhs*: Value, rhs*: Value }
PointerCompare* = { dst*: RegisterId, op*: IntPredicate, lhs*: Value, rhs*: Value }
FloatCompare* = { dst*: RegisterId, op*: FloatPredicate, lhs*: Value, rhs*: Value }
Convert* = { dst*: RegisterId, op*: ConvertOp, value*: Value }
Address* = { dst*: RegisterId, base*: AddressBase, byte_offset*: Value }
Load* = { dst*: RegisterId, address*: Value, memory*: MemoryAccess }
Store* = { address*: Value, value*: Value, memory*: MemoryAccess }
Call* = { dst*: Res<RegisterId>, callee*: Callee, args*: Vec<Value> }

Instruction* = {
    Set: Set | Select: Select
        | IntBinary: IntBinary | FloatBinary: FloatBinary | FloatNegate: FloatNegate
        | IntCompare: IntCompare | PointerCompare: PointerCompare | FloatCompare: FloatCompare
        | Convert: Convert | Address: Address
        | Load: Load | Store: Store | Call: Call
}

SwitchCase* = { value*: Constant, target*: BlockId }
Jump* = { target*: BlockId }
Branch* = { condition*: Value, yes*: BlockId, no*: BlockId }
Switch* = { value*: Value, cases*: Vec<SwitchCase>, default*: BlockId }
Return* = { value*: Res<Value> }
CallNever* = { callee*: Callee, args*: Vec<Value> }
Trap* = { code*: TrapCode }

Exit* = {
    Jump: Jump | Branch: Branch | Switch: Switch
        | Return: Return | CallNever: CallNever | Trap: Trap
}

ReturnContract* = { Returns: Res<ScalarType> | Never }
Abi* = { AppleArm64 | Aapcs64Linux | SysVAMD64 }
Backend* = { NativeAssembly | C }
CallingConvention* = { PlatformDefault | Exact: Abi }

Signature* = {
    parameters*: Vec<ScalarType>,
    result*: ReturnContract,
    calling_convention*: CallingConvention,

    is_never* = (self: @Self) bool { self.result.match({ Never => true, Returns(_) => false }) }
}

SymbolKind* = { Function | Data }
Linkage* = { Internal | ExternalDefinition | ExternalImport }
Symbol* = { id*: SymbolId, kind*: SymbolKind, linkage*: Linkage, external_name*: Res<str> }

AddressPart* = { symbol*: SymbolId, addend*: i64, type*: ScalarType }
InitializerPart* = {
    Bytes: Vec<u8> | ZeroBytes: u64 | Address: AddressPart,

    size* = (self: @Self) u64 {
        self.match({ Bytes(b) => b.len.to_u64(), ZeroBytes(n) => n, Address(_) => 8 })
    }
}
Definition* = { Function: FunctionId | Global: GlobalId }
Export* = { symbol*: SymbolId, definition*: Definition }
Global* = {
    symbol*: SymbolId, size*: u64, alignment*: u32, mutable*: bool,
    initializer*: Vec<InitializerPart>,
}
StackObject* = { id*: StackObjectId, size*: u64, alignment*: u32 }
InstructionRecord* = { id*: InstructionId, instruction*: Instruction }
Block* = { id*: BlockId, instructions*: Vec<InstructionRecord>, exit*: Exit }

Function* = {
    id*: FunctionId,
    symbol*: SymbolId,
    signature*: SignatureId,
    parameters*: Vec<RegisterId>,
    register_types*: Vec<ScalarType>,       // RegisterId is the position
    objects*: Vec<StackObject>,             // StackObjectId is the position
    entry*: BlockId,
    blocks*: Vec<Block>,                    // BlockId is the position

    register_type* = (self: @Self, r: RegisterId) Res<ScalarType> { self.register_types.get(r.index.to_usize()) }
    block* = (self: @Self, b: BlockId) Res<Block> { self.blocks.get(b.index.to_usize()) }
    object* = (self: @Self, o: StackObjectId) Res<StackObject> { self.objects.get(o.index.to_usize()) }
}

// FunctionIds are dense across definitions and imports: definitions first, then imports.
Import* = { function*: FunctionId, symbol*: SymbolId, signature*: SignatureId }

Module* = {
    signatures*: Vec<Signature>,
    symbols*: Vec<Symbol>,
    globals*: Vec<Global>,
    imports*: Vec<Import>,
    functions*: Vec<Function>,
    exports*: Vec<Export>,
    trap_handler*: Res<FunctionId>,     // an Import of type (U32) -> Never

    signature* = (self: @Self, s: SignatureId) Res<Signature> { self.signatures.get(s.index.to_usize()) }
    symbol* = (self: @Self, s: SymbolId) Res<Symbol> { self.symbols.get(s.index.to_usize()) }
    global* = (self: @Self, g: GlobalId) Res<Global> { self.globals.get(g.index.to_usize()) }
    function* = (self: @Self, f: FunctionId) Res<Function> { self.functions.get(f.index.to_usize()) }
    import* = (self: @Self, f: FunctionId) Res<Import> {
        i = f.index.to_usize();
        (i < self.functions.len).match({
            true => None,
            false => self.imports.get(i - self.functions.len),
        })
    }

    // The signature of a defined or imported function.
    signature_of* = (self: @Self, f: FunctionId) Res<SignatureId> {
        self.function(f).match({
            Ok(function) => Ok(function.signature),
            None => Ok(self.import(f).try().signature),
        })
    }
}
