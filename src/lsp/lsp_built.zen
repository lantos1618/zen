// Cached workspace check shared by diagnostics and semantic queries.
// Values retained in `cur` are owned by `arena` and die on rebuild.

{ str, String, dup } = std.text
{ Vec, Map } = std.collections
{ Alloc, AllocError, Arena } = std.mem
{ Res, Ok, None, Drop, Range, loop } = std.core
{ Span } = std.source
{ Note } = std.parse.parse_diag
{ Checker } = sema.sema_check
{ message, write_detail } = sema.sema_diag
{ Build, check_workspace, WorkspaceCheck, WorkspaceBase } = zen.zen_build
{ std_base, user_base, base_holds, check_workspace_after } = zen.zen_build
{ Classed } = lsp.lsp_colour
{ classify } = lsp.lsp_names
{ uri_at, path_of } = lsp.lsp_uri
{ written } = std.json
{ relative_to, anchored_path } = zen.zen_path
{ Env } = std.env

Spot* = {
    uri*: str,
    message*: str,
    span*: Span,
    note*: Res<Note>,
}

same_spot = (left: Spot, right: Spot) bool {
    left.uri.eq(right.uri) && left.message.eq(right.message)
        && left.span.start.line == right.span.start.line
        && left.span.start.col == right.span.start.col
        && left.span.end.line == right.span.end.line
        && left.span.end.col == right.span.end.col
}

copy_into = (spot: Spot, a: Alloc) Res<Spot, AllocError> {
    note = spot.note.match({
        None      => None,
        Ok(value) => Ok(Note(
            message: value.message.dup(a).try(),
            span: value.span.copy_into(a).try()
        )),
    });
    Ok(Spot(
        uri: spot.uri.dup(a).try(),
        message: spot.message.dup(a).try(),
        span: spot.span.copy_into(a).try(),
        note: note
    ))
}

copy_into = (span: Span, a: Alloc) Res<Span, AllocError> {
    Ok(Span(file: span.file.dup(a).try(), start: span.start, end: span.end))
}

// Bases kept per layer; past this the least recently used is dropped.
STD_BASES: usize = 2
USER_BASES: usize = 4

// A kept base. `id` names it, `under` names the std base a user base is
// checked on top of, `entry` is the open document it was built for, and
// `opened` the documents open when a std base was built.
Kept = {
    id: usize,
    under: usize,
    entry: str,
    opened: Vec<str>,
    base: WorkspaceBase
}

// Whether `docs` opens exactly the paths in `opened`.
same_docs = (opened: Vec<str>, docs: Map<str, str>) bool {
    opened.len == docs.len() && opened.find((p) {
        docs.get(p).match({ Ok(_) => false, None => true })
    }).match({ Ok(_) => false, None => true })
}

// Kept bases, each owned by the arena at its index; most recently used last.
Bases = {
    owners :: Vec<Arena>,
    views :: Vec<Kept>,

    add = (self :: @Self, owner :: Arena, kept: Kept) Res<AllocError> {
        self.owners.reserve(1).try();
        self.views.reserve(1).try();
        self.owners.add(consume owner).try();
        self.views.add(kept)
    }

    remove = (self :: @Self, at: usize) {
        self.views.take(at).match({ Ok(_) => (), None => () });
        self.owners.take(at).match({
            Ok(owner) => { _ = consume owner; },
            None      => (),
        });
    }

    // Move the base at `at` to the most recently used end.
    touch = (self :: @Self, at: usize) Res<AllocError> {
        self.views.take(at).match({
            None     => Ok,
            Ok(kept) => self.owners.take(at).match({
                None      => Ok,
                Ok(owner) => self.add(consume owner, kept),
            }),
        })
    }

    clear = (self :: @Self) {
        loop(
            () { self.views.len > 0 },
            (h) { self.remove(self.views.len - 1); }
        );
    }
}

Bases = (a: Alloc) Bases {
    Bases(owners: a.Vec<Arena>(), views: a.Vec<Kept>())
}

Inner = {
    root: str,          // the compilation root, copied into the arena
    entry: str,         // the open document, relative to the root
    directory: Res<str>,
    b: Build,
    c: Checker,
    spots: Vec<Spot>,   // every diagnostic of the build, in report order
    classed :: Map<str, Vec<Classed>>,
}

Built* = {
    arena :: Arena,

    // Std bases, which see no user module, and user bases, each checked on
    // top of a std base and dropped before it.
    stds :: Bases,
    users :: Bases,
    ids :: usize = 0,
    // A std base that no check could use when it was built; another is not
    // built for the same entry and open documents while it holds.
    missed :: usize = 0,

    cur :: Res<Inner>,

    stale :: bool = false,

    // Whether every user base is over a kept std base.
    layered* = (self: @Self) bool {
        self.users.views.find((u) {
            self.stds.views.find((k) { k.id == u.under })
                .match({ Ok(_) => false, None => true })
        }).match({ Ok(_) => false, None => true })
    }

    matches* = (self: @Self, root: str, entry: str) bool {
        self.stale.match({
            true  => false,
            false => self.cur.match({
                None  => false,
                Ok(i) => i.root.eq(root) && i.entry.eq(entry),
            }),
        })
    }

    ensure* = (self :: @Self, env: Env, root: str, entry: str,
               uris: Vec<str>, docs: Map<str, str>) Res<AllocError> {
        self.matches(root, entry).match({
            true  => written(),
            false => self.rebuild(env, root, entry, uris, docs),
        })
    }

    invalidate* = (self :: @Self) { self.stale = true; }

    // Check on a kept user base that still holds, preferring one built for
    // this entry; else on a kept std base, or a new one, keeping a user base
    // over it for later turns. Check the whole workspace when no base
    // qualifies.
    check = (self :: @Self, env: Env, root: str, entry: str,
             docs: Map<str, str>) Res<WorkspaceCheck, AllocError> {
        env.fs.cwd(self.arena).match({
            Err(_)        => check_workspace(
                env,
                self.arena,
                root,
                entry,
                docs
            ),
            Ok(directory) => {
                dir = directory.view();
                self.drop_stale(env, dir, root, docs).try();
                same                         = self.on_users(
                    env,
                    dir,
                    root,
                    entry,
                    docs,
                    true
                ).try();
                other: Res<WorkspaceCheck>   = same.match({
                    Ok(checked) => Ok(checked),
                    None        => self.on_users(
                        env,
                        dir,
                        root,
                        entry,
                        docs,
                        false
                    ).try(),
                });
                layered: Res<WorkspaceCheck> = other.match({
                    Ok(checked) => Ok(checked),
                    None        => self.on_stds(
                        env,
                        dir,
                        root,
                        entry,
                        docs
                    ).try(),
                });
                // A std base that failed, or that no check could use, and
                // still holds would do so again.
                refused                    = self.stds.views.find((k) {
                    !k.base.clean || (k.id == self.missed && k.entry.eq(entry)
                        && same_docs(k.opened, docs))
                })
                    .match({ Ok(_) => true, None => false });
                fresh: Res<WorkspaceCheck> = layered.match({
                    Ok(checked) => Ok(checked),
                    None        => refused.match({
                        true  => None,
                        false => self.on_new(env, dir, root, entry, docs).try(),
                    }),
                });
                fresh.match({
                    Ok(checked) => Ok(checked),
                    None        => check_workspace(
                        env,
                        self.arena,
                        root,
                        entry,
                        docs
                    ),
                })
            },
        })
    }

    // Drop every std base that no longer holds, with the bases over it.
    drop_stale = (self :: @Self, env: Env, dir: str, root: str,
                  docs: Map<str, str>) Res<AllocError> {
        at ::= self.stds.views.len;
        loop(() { at > 0 }, (h) {
            at    = at - 1;
            k     = self.stds.views.get(at).ok_or(AllocError.OutOfMemory).try();
            holds = k.base.base_holds(env, self.arena, dir, root, docs).try();
            (!holds).then(() { self.drop_std(at); });
        });
        Ok
    }

    // Drop the std base at `at` after every user base over it.
    drop_std = (self :: @Self, at: usize) {
        id = self.stds.views.get(at).match({ Ok(k) => k.id, None => 0 });
        i ::= self.users.views.len;
        loop(() { i > 0 }, (h) {
            i = i - 1;
            self.users.views.get(i).match({
                Ok(k) => { (k.under == id).then(
                    () { self.users.remove(i); }
                ); },
                None  => (),
            });
        });
        self.stds.remove(at);
    }

    // Check on the most recently used user base whose entry is (or, when
    // `same` is false, is not) `entry`. A base that no longer holds is
    // dropped; one the program no longer reaches whole is kept for later.
    on_users = (self :: @Self, env: Env, dir: str, root: str, entry: str,
                docs: Map<str, str>, same: bool)
               Res<Res<WorkspaceCheck>, AllocError> {
        found :: Res<WorkspaceCheck> = None;
        done  ::= false;
        at    ::= self.users.views.len;
        loop(() { at > 0 && !done }, (h) {
            at = at - 1;
            k  = self.users.views.get(at).ok_or(AllocError.OutOfMemory).try();
            (k.entry.eq(entry) == same).then(() {
                holds = k.base.base_holds(
                    env,
                    self.arena,
                    dir,
                    root,
                    docs
                ).try();
                holds.match({
                    false => self.users.remove(at),
                    true  => k.base.check_workspace_after(
                        env,
                        self.arena,
                        dir,
                        root,
                        entry,
                        docs
                    ).try().match({
                        None        => (),
                        Ok(checked) => {
                            self.users.touch(at).try();
                            found = Ok(checked);
                            done  = true;
                        },
                    }),
                });
            });
        });
        Ok(found)
    }

    // Check on the most recently used clean std base the program reaches.
    on_stds = (self :: @Self, env: Env, dir: str, root: str, entry: str,
               docs: Map<str, str>) Res<Res<WorkspaceCheck>, AllocError> {
        found :: Res<WorkspaceCheck> = None;
        done  ::= false;
        at    ::= self.stds.views.len;
        loop(() { at > 0 && !done }, (h) {
            at = at - 1;
            k  = self.stds.views.get(at).ok_or(AllocError.OutOfMemory).try();
            k.base.clean.then(() {
                self.on_layer(env, dir, root, entry, docs, k).try().match({
                    None        => (),
                    Ok(checked) => {
                        self.stds.touch(at).try();
                        found = Ok(checked);
                        done  = true;
                    },
                });
            });
        });
        Ok(found)
    }

    // Check on `layer`, and keep a user base over it of the modules that
    // check reached that no open buffer reaches, when they are clean.
    on_layer = (self :: @Self, env: Env, dir: str, root: str, entry: str,
                docs: Map<str, str>, layer: Kept)
               Res<Res<WorkspaceCheck>, AllocError> {
        checked = layer.base.check_workspace_after(
            env,
            self.arena,
            dir,
            root,
            entry,
            docs
        ).try();
        checked.match({
            None      => Ok(None),
            Ok(found) => {
                self.keep_users(env, entry, layer, found).try();
                Ok(Ok(found))
            },
        })
    }

    keep_users = (self :: @Self, env: Env, entry: str, layer: Kept,
                  checked: WorkspaceCheck) Res<AllocError> {
        owner ::= env.mem.alloc();
        made  = user_base(layer.base, checked, env, self.arena, owner).try();
        clean = made.match({ Ok(base) => base.clean, None => false });
        clean.match({
            false => {
                _ = consume owner;
                Ok
            },
            true  => {
                base       = made.ok_or(AllocError.OutOfMemory).try();
                kept_entry = entry.dup(owner).try();
                opened     = owner.Vec<str>();
                self.ids   = self.ids + 1;
                self.users.add(
                    consume owner,
                    Kept(
                        id: self.ids,
                        under: layer.id,
                        entry: kept_entry,
                        opened: opened,
                        base: base
                    )
                ).try();
                loop(() { self.users.views.len > USER_BASES }, (h) {
                    self.users.remove(0);
                });
                Ok
            },
        })
    }

    // Build a std base and check on it. One that is not clean is kept, so
    // no build is tried again while it holds.
    on_new = (self :: @Self, env: Env, dir: str, root: str, entry: str,
              docs: Map<str, str>) Res<Res<WorkspaceCheck>, AllocError> {
        owner ::= env.mem.alloc();
        made = std_base(env, self.arena, owner, dir, root, entry, docs).try();
        made.match({
            None     => {
                _ = consume owner;
                Ok(None)
            },
            Ok(base) => {
                kept_entry = entry.dup(owner).try();
                opened ::= owner.Vec<str>();
                docs.pairs((h, path, text) {
                    opened.add(path.dup(owner).try()).try();
                });
                self.ids = self.ids + 1;
                layer    = Kept(
                    id: self.ids,
                    under: 0,
                    entry: kept_entry,
                    opened: opened,
                    base: base
                );
                self.stds.add(consume owner, layer).try();
                loop(() { self.stds.views.len > STD_BASES }, (h) {
                    self.drop_std(0);
                });
                checked: Res<WorkspaceCheck> = base.clean.match({
                    false => None,
                    true  => self.on_layer(
                        env,
                        dir,
                        root,
                        entry,
                        docs,
                        layer
                    ).try(),
                });
                checked.match({
                    None  => { self.missed = layer.id; },
                    Ok(_) => (),
                });
                Ok(checked)
            },
        })
    }

    rebuild = (self :: @Self, env: Env, root: str, entry: str,
               uris: Vec<str>, docs: Map<str, str>) Res<AllocError> {
        // A refused rebuild must not expose values owned by the old arena.
        self.cur   = None;
        self.stale = true;
        fresh ::= env.mem.alloc();
        // Source selection may borrow the previous snapshot.
        kept_root  = root.dup(fresh).try();
        kept_entry = entry.dup(fresh).try();
        self.arena.drop();
        self.arena = consume fresh;

        over ::= self.arena.Map<str, str>();
        uris.loop((h, u) {
            docs.get(u).match({
                None     => written(),
                Ok(text) => over.set(path_of(self.arena, u).try(), text).try(),
            }).try();
        });

        checked = self.check(env, kept_root, kept_entry, over).try();
        spots ::= self.arena.Vec<Spot>();
        checked.b.parse_spots(self.arena, kept_root, spots).try();
        checked.c.sema_spots(self.arena, kept_root, spots).try();
        // A diagnostic for an open buffer keeps the client's URI spelling,
        // even when module discovery removed redundant path components.
        directory: Res<str> = env.fs.cwd(self.arena).match({
            Ok(path) => Ok(path.view()),
            Err(_)   => None,
        });
        directory.match({
            Ok(path) => spots.restore_uris(self.arena, path, uris).try(),
            None     => (),
        });
        classed ::= self.arena.Map<str, Vec<Classed>>();

        self.cur   = Ok(Inner(
            root: kept_root,
            entry: kept_entry,
            directory: directory,
            b: checked.b,
            c: checked.c,
            spots: spots,
            classed: classed
        ));
        self.stale = false;
        Ok;
    }

    covers* = (self: @Self, a: Alloc, path: str) Res<bool, AllocError> {
        self.stale.match({
            true  => Ok(false),
            false => self.cur.match({
                None      => Ok(false),
                Ok(inner) => {
                    file = inner.source_file(a, path).try();
                    Ok(Range(0, inner.b.tree.module_count()).find((index) {
                        inner.b.tree.module_at(index).match({
                            None => false, Ok(module) => module.span.file.eq(
                                file
                            ),
                        })
                    }).match({ Ok(_) => true, None => false }))
                },
            }),
        })
    }

    checker* = (self: @Self) Res<Checker> {
        self.cur.match({ None => None, Ok(i) => Ok(i.c) })
    }

    root* = (self: @Self) str {
        self.cur.match({ None => "", Ok(i) => i.root })
    }

    source_file* = (self: @Self, a: Alloc, path: str)
                   Res<str, AllocError> {
        self.cur.match({
            None  => Ok(path),
            Ok(i) => i.source_file(a, path),
        })
    }

    spots* = (self: @Self) Res<Vec<Spot>> {
        self.cur.match({ None => None, Ok(i) => Ok(i.spots) })
    }

    // Snapshot text before another build retires this arena. Shared import
    // graphs may contribute the same diagnostic more than once.
    append_spots* = (self: @Self, a: Alloc, into :: Vec<Spot>) Res<AllocError> {
        self.spots().match({
            None      => written(),
            Ok(found) => {
                found.loop((spot) {
                    into.find((old) { old.same_spot(spot) }).match({
                        Ok(_) => written(),
                        None  => into.add(spot.copy_into(a).try()),
                    }).try();
                });
                written()
            },
        })
    }

    classed_for* = (self :: @Self, a: Alloc, uri: str)
                   Res<Vec<Classed>, AllocError> {
        self.cur.match({
            None  => Ok(a.Vec<Classed>()),
            Ok(i) => (i.b.diag_count() == 0 && i.c.diag_count() == 0).match({
                false => Ok(a.Vec<Classed>()),
                true  => {
                    file = i.source_file(a, path_of(a, uri).try()).try();
                    i.classed.get(file).match({
                        Ok(rows) => Ok(rows),
                        None     => {
                            rows = classify(self.arena, i.c, file).try();
                            key  = file.dup(self.arena).try();
                            i.classed.set(key, rows).try();
                            self.cur = Ok(i);
                            Ok(rows)
                        },
                    })
                },
            }),
        })
    }
}

source_file = (inner: Inner, a: Alloc, path: str) Res<str, AllocError> {
    inner.directory.match({
        None          => Ok(relative_to(inner.root, path)),
        Ok(directory) => Ok(relative_to(
            inner.b.root,
            anchored_path(a, directory, path).try()
        )),
    })
}

restore_uris = (spots :: Vec<Spot>, a: Alloc, directory: str, uris: Vec<str>)
               Res<AllocError> {
    paths ::= a.Map<str, str>();
    uris.loop((uri) {
        paths.set(
            anchored_path(a, directory, path_of(a, uri).try()).try(),
            uri
        ).try();
    });
    spots.loop((h, index, spot) {
        path = anchored_path(a, directory, path_of(a, spot.uri).try()).try();
        paths.get(path).match({
            None    => (),
            Ok(uri) => {
                spots.set(
                    index,
                    Spot(
                        uri: uri,
                        message: spot.message,
                        span: spot.span,
                        note: spot.note
                    )
                );
            },
        });
    });
    Ok
}

Built.impl(Drop, {
    drop = (self :: @Self) {
        self.users.clear();
        self.stds.clear();
        self.arena.drop();
    }
})

// The two short vectors of kept bases live in the caller's allocator `a`.
Built* = (env: Env, a: Alloc) Built {
    Built(arena: env.mem.alloc(), stds: Bases(a), users: Bases(a), cur: None)
}

parse_spots = (b: Build, a: Alloc, root: str, spots :: Vec<Spot>)
              Res<AllocError> {
    Range(0, b.diag_count()).loop((h, i) {
        b.diag_at(i).match({
            None  => written(),
            Ok(d) => spots.add(Spot(
                uri: uri_at(a, root, d.span.file).try(),
                message: d.message,
                span: d.span,
                note: d.note
            )),
        }).try();
    });
    Ok;
}

sema_spots = (c: Checker, a: Alloc, root: str, spots :: Vec<Spot>)
             Res<AllocError> {
    Range(0, c.diag_count()).loop((h, i) {
        c.diag_at(i).match({
            None  => written(),
            Ok(d) => {
                said ::= a.String().try();
                said.add(message(d.fault)).try();
                write_detail(d.fault, c.types, said).try();
                spots.add(Spot(
                    uri: uri_at(a, root, d.file).try(),
                    message: said.view(),
                    span: d.span,
                    note: None
                ))
            },
        }).try();
    });
    Ok;
}
