// One independently retired editor buffer. Views expire when this owner drops.
{ str, dup } = std.text
{ Arena, Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ path_of } = lsp.lsp_uri
{ Res, Ok, Drop } = std.core
{ Env } = std.env

Document* = {
    arena :: Arena,
    uri*: str,
    path*: str,
    text*: str,
    version* :: Res<i64>,

    revise* = (self :: @Self, version: Res<i64>) { self.version = version; }
}

Document.impl(Drop, {
    drop = (self :: @Self) { self.arena.drop(); }
})

Document* = (env: Env, uri: str, text: str, version: Res<i64>)
            Res<Document, AllocError> {
    arena ::= env.mem.alloc();
    document_in(consume arena, uri, text, version)
}

document_in = (arena :: Arena, uri: str, text: str, version: Res<i64>)
              Res<Document, AllocError> {
    kept_uri  = uri.dup(arena).try();
    kept_text = text.dup(arena).try();
    path      = path_of(arena, uri).try();
    Ok(Document(
        arena: consume arena,
        uri: kept_uri,
        path: path,
        text: kept_text,
        version: version
    ))
}

// A view owns no arena and expires when its document is retired.
DocumentView* = { uri*: str, text*: str, version*: Res<i64> }

// Owners and their views share an index. Reserve both buffers before adding
// an owner; removing a document removes its view before handing ownership out.
Documents* = {
    owners :: Vec<Document>,
    views* :: Vec<DocumentView>,

    reserve* = (self :: @Self, count: usize) Res<(), AllocError> {
        self.owners.reserve(count).try();
        self.views.reserve(count)
    }

    add* = (self :: @Self, document: Document) Res<(), AllocError> {
        self.reserve(1).try();
        view = DocumentView(
            uri: document.uri,
            text: document.text,
            version: document.version
        );
        self.owners.add(consume document).try();
        self.views.add(view)
    }

    take* = (self :: @Self, index: usize) Res<Document> {
        self.views.take(index).try();
        self.owners.take(index)
    }

    clear* = (self :: @Self) {
        self.views.clear();
        self.owners.clear();
    }
}

Documents* = (a: Alloc) Documents {
    Documents(owners: a.Vec<Document>(), views: a.Vec<DocumentView>())
}
