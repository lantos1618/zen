// zen <file.zen>: compile the file with this compiler and run its `main` on the IR
// interpreter. The process exits with main's result; an error prints file:line:col and
// exits 1; a trap exits 134 (ZEN_LANGUAGE.md §8).
// zen --dump <file.zen>: print the syntax tree and the IR instead of running.

{ Res, Ok, Err, None, IoError, ignore } = std.core
{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ str } = std.text
{ println } = std.io
{ Env, Console } = std.env
{ Id, Function, ScalarType } = ir.records
{ Diagnostic } = ir.diagnostic
{ Ir, validate } = ir.validate
{ dump } = ir.dump
{ RuntimeValue, Outcome, run } = ir.interp
{ int } = ir.int
{ Source } = front.parse.source
{ ParseError, parse } = front.parse.parse
{ Tree } = front.parse.ast
{ CheckError, Program, check } = front.check.check
{ lower } = front.lower.lower

// Everything that can stop compiling. Each stage's `.try()` widens into it.
CompileError = ParseError | CheckError | AllocError | Diagnostic

// What compiling a file produces: its tree, the checked program, and validated IR.
Compiled = { tree: Tree, program: Program, ir: Ir }

main = (env: Env) Res<i32, IoError> {
    a = env.mem.alloc();
    first = env.argv.get(1).match({ Ok(p) => p, None => "" });
    dumping = first.eq("--dump");
    path = dumping.match({ true => env.argv.get(2).match({ Ok(p) => p, None => "" }), false => first });
    (path.len == 0).match({
        true  => { env.out.errorln("usage: zen [--dump] <file.zen>").try(); Ok(2) },
        false => env.fs.read(a, path).match({
            Err(_)   => { env.out.errorln("{}: can't read this file", path).try(); Ok(1) },
            Ok(text) => {
                s = Source(text: text.view());
                code = dumping.match({
                    true  => compile(a, s.text).match({ Ok(c) => show(c), Err(e) => report(env.out, path, s, e) }),
                    false => run_main(a, s.text).match({
                        Ok(o)  => finish(env.out, path, o),
                        Err(e) => report(env.out, path, s, e),
                    }),
                });
                Ok(code)
            },
        }),
    })
}

// source -> tree -> program -> IR -> validated IR.
compile = (a: Alloc, text: str) Res<Compiled, CompileError> {
    tree = parse(a, text).try();
    program = check(a, tree).try();
    ir = validate(a, lower(a, program).try()).try();
    Ok(Compiled(tree: tree, program: program, ir: ir))
}

// Compile, then run main on the interpreter.
run_main = (a: Alloc, text: str) Res<Outcome, CompileError> {
    c = compile(a, text).try();
    entry = c.program.find("main").match({ Ok(k) => k, None => 0 });
    Ok(run(a, c.ir, Id<Function>(index: entry), a.Vec<RuntimeValue>()).try())
}

// The tree and the IR, instead of running.
show = (c: Compiled) i32 {
    println("== syntax tree");
    c.tree.dump();
    println("");
    println("== IR");
    dump(c.ir.view());
    0
}

// The exit code for how main ended: its i32 result, or 134 after a trap or fault.
finish = (out: Console, path: str, o: Outcome) i32 {
    o.match({
        Returned(v)   => exit_code(v),
        Trapped(code) => { out.errorln("{}: trap: {}", path, code.variant_name()).ignore(); 134 },
        Fault(f)      => { out.errorln("{}: fault: {}", path, f.variant_name()).ignore(); 134 },
        ResourceLimit => { out.errorln("{}: a resource limit was reached", path).ignore(); 1 },
    })
}

// A compile error on stderr, as file:line:col: message where there is a position. Exits 1.
report = (out: Console, path: str, s: Source, e: CompileError) i32 {
    printed = e.match({
        ParseError(p)  => p.match({
            Syntax(x)   => {
                at = s.position(x.at);
                found = x.found.variant_name();
                out.errorln("{}:{}:{}: expected {}, found {}", path, at.line, at.column, x.wanted, found)
            },
            OutOfMemory => out.errorln("{}: out of memory", path),
        }),
        CheckError(c)  => {
            at = s.position(c.at);
            out.errorln("{}:{}:{}: {}", path, at.line, at.column, c.message)
        },
        AllocError(_)  => out.errorln("{}: out of memory", path),
        Diagnostic(d)  => out.errorln("{}: internal error: invalid IR: {} ({})", path, d.message, d.code.name()),
    });
    printed.ignore();
    1
}

// main's i32 result as a process exit code.
exit_code = (v: Res<RuntimeValue>) i32 {
    i32_type = int(ScalarType.I32);
    bits = v.match({ Ok(rv) => rv.match({ Int(k) => k.bits, _ => 0 }), None => 0 });
    size = i32_type.magnitude(bits).to_i32().match({ Ok(n) => n, None => 0 });
    i32_type.negative(bits).match({ true => 0 - size, false => size })
}
