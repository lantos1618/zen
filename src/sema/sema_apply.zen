{ Expr, ExprId, Call, Arg, Lambda } = std.ast
{ Span } = std.source
{ Decl, Enum, Struct, TypeId, Impl } = std.ast
{ AllocError } = std.mem
{ Vec } = std.collections
{ str } = std.text
{ Res, Ok, None, Range } = std.core
{ ImplId } = sema.sema_id
{ TyId, TyNamed, literal_default } = sema.sema_ty
{ Def, decl_at } = sema.sema_def
{ Checker, Ctx, CallResolution, CheckedCall, CallSignature } = sema.sema_check
{ Inst, InstEdge, subst, unify, tparam_vars, zip, push_tparams, owner_of, subst_list } = sema.sema_inst
{ has_var, inst_of_named, decl_tparam_vars } = sema.sema_inst
{ Cand, TBound, Actual, ty_at, signature_matches, cands_of } = sema.sema_cand
{ tparam_bounds } = sema.sema_cand
{ impl_bound_type, LocalImpl, local_impls } = sema.sema_supply
{ type_of } = sema.sema_type
{ spelled_lambda } = sema.sema_call
{ type_from_ast } = sema.sema_denote
{ check_literal } = sema.sema_trap
{ array_range_shape, check_inst_bounds, inst_bounds_hold } = sema.sema_bound
{ range_seq_arg, range_value } = sema.sema_bound
{ case_payload, Case, cases_of, find_case } = sema.sema_case
{ check_ctor_fields } = sema.sema_hoist
{ check_ctor_shape } = sema.sema_bound
{ Found, members_of } = sema.sema_member
{ SemaFault, NameFault, TypeFault } = sema.sema_diag
{ catch_all_named } = sema.sema_discriminant
{ forged_capability } = sema.sema_prim
{ storage_seat_name } = sema.sema_supply

construct* = (c :: Checker, id: ExprId, call: Call, d: Def, ctx: Ctx)
            Res<TyId, AllocError> {
    c.forged_capability(id, d, ctx).try();
    c.ctor_type_arg_arity_fits(call, d).try().match({
        false => {
            c.invalid_instantiation(id, d.name).try();
            c.types.unknown()
        },
        true  => c.valid_construct(id, call, d, ctx),
    })
}

valid_construct = (c :: Checker, id: ExprId, call: Call, d: Def, ctx: Ctx)
                  Res<TyId, AllocError> {
    args    = c.ctor_args(call, d, ctx).try();
    applied = c.types.named(d.id, d.qname, d.name, args).try();
    ty      = c.settled_ctor_type(call, d, ctx, args, applied).try();
    c.is_unknown(ty).match({
        true  => Ok(ty),
        false => c.checked_construct(id, call, ty, ctx),
    })
}

checked_construct = (c :: Checker, id: ExprId, call: Call, ty: TyId, ctx: Ctx)
                    Res<TyId, AllocError> {
    c.nominal_bounds_hold(ty, c.tree.expr_at(id).span).try().match({
        false => c.types.unknown(),
        true  => {
            c.check_ctor_fields(call, ty, ctx).try();
            c.check_ctor_shape(call, ty, c.tree.expr_at(id).span).try();
            Ok(ty)
        },
    })
}

ctor_type_arg_arity_fits = (c :: Checker, call: Call, d: Def)
                           Res<bool, AllocError> {
    (call.targs.len == 0).match({
        true  => Ok(true),
        false => c.tree.decl_at(d.id).match({
            None     => Ok(false),
            Ok(decl) => {
                vars ::= c.alloc.Vec<TyId>();
                c.decl_tparam_vars(decl, d.qname, vars).try();
                Ok(call.targs.len == vars.len)
            },
        }),
    })
}

settled_ctor_type = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                    Res<TyId, AllocError> {
    ((vars.len == 0) || (call.targs.len > 0)).match({
        true  => Ok(applied),
        false => c.ctor_type_from_args(call, d, ctx, vars, applied),
    })
}

// A construction's type arguments come from its field values. Typed values
// go first, so a literal takes the type they settle (`Range(0, n)` has n's
// type); a parameter that only literals reach takes the literal default, and
// a written binding may still settle it (`settle_ctor_at`). Two typed values
// that settle one parameter differently are refused here, naming both types,
// rather than reported as a field that does not fit the first.
ctor_type_from_args = (
    c       :: Checker,
    call    : Call,
    d       : Def,
    ctx     : Ctx,
    vars    : Vec<TyId>,
    applied : TyId
)
                      Res<TyId, AllocError> {
    inst   ::= c.alloc.Inst();
    agreed ::= true;
    call.args.loop((h, i, a) {
        (!c.unify_ctor_arg(a, i, applied, ctx, false, inst).try()).then(() {
            agreed = false;
            h.break();
        });
    });
    call.args.loop((h, i, a) {
        agreed.then(
            () { c.unify_ctor_arg(a, i, applied, ctx, true, inst).try(); }
        );
    });
    agreed.match({
        false => c.types.unknown(),
        true  => (inst.len() == 0).match({
            true  => Ok(applied),
            false => c.rebuilt_ctor_type(d, vars, inst),
        }),
    })
}

rebuilt_ctor_type = (c :: Checker, d: Def, vars: Vec<TyId>, inst: Inst)
                    Res<TyId, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    vars.loop((h, v) { args.add(inst.arg_for(v)).try() });
    c.types.named(d.id, d.qname, d.name, args)
}

// One pass over the arguments: typed values, or literals. Returns false when
// this value disagreed with an earlier one and was refused.
unify_ctor_arg = (
    c        :: Checker,
    a        : Arg,
    i        : usize,
    applied  : TyId,
    ctx      : Ctx,
    literals : bool,
    inst     :: Inst
) Res<bool, AllocError> {
    got = c.type_of(a.value, ctx).try();
    (c.is_literal_ty(got) == literals).match({
        false => Ok(true),
        true  => {
            name = a.name.match({
                Ok(nm) => nm.text,
                None   => c.storage_seat_name(applied, i).try(),
            });
            found ::= c.alloc.Vec<Found>();
            c.members_of(applied, name, found).try();
            found.get(0).match({
                None  => Ok(true),
                Ok(f) => literals.match({
                    true  => {
                        c.unify(
                            f.ty,
                            c.settled_arg_ty(a, ctx).try(),
                            inst
                        ).try();
                        Ok(true)
                    },
                    false => c.ctor_value_agrees(a, f.ty, got, inst),
                }),
            })
        },
    })
}

ctor_value_agrees = (
    c     :: Checker,
    a     : Arg,
    field : TyId,
    got   : TyId,
    inst  :: Inst
) Res<bool, AllocError> {
    prior: Res<TyId> = c.types.at(field).match({
        Var(_) => inst.lookup(field),
        _      => None,
    });
    prior.match({
        None      => {
            c.unify(field, got, inst).try();
            Ok(true)
        },
        Ok(first) => (c.same_type(first, got) || c.is_unknown(got)).match({
            true  => Ok(true),
            false => {
                c.report(a.span.file, a.span, SemaFault.CtorArgsDisagree(TypeFault(
                    name: c.types.at(
                        field
                    ).match({ Var(v) => v.name, _ => "" }),
                    expected: first,
                    found: got,
                ))).try();
                Ok(false)
            },
        }),
    })
}

variant_call_type* = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    name : str,
    ctx  : Ctx
) Res<TyId, AllocError> {
    own = c.applied_at_own_vars(ty).try();
    c.variant_type_arg_arity_fits(call, own).match({
        false => c.invalid_variant_instantiation(call, name),
        true  => c.valid_variant_call(call, ty, name, ctx),
    })
}

variant_type_arg_arity_fits = (c: Checker, call: Call, own: TyId) bool {
    (call.targs.len == 0) || c.types.at(own).match({
        Named(n) => call.targs.len == n.args.len,
        _        => false,
    })
}

invalid_variant_instantiation = (c :: Checker, call: Call, name: str)
                                Res<TyId, AllocError> {
    c.report(
        call.args_span.file,
        call.args_span,
        SemaFault.InvalidInstantiation(NameFault(name: name))
    ).try();
    c.types.unknown()
}

valid_variant_call = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    name : str,
    ctx  : Ctx
) Res<TyId, AllocError> {
    catch_all = c.catch_all_named(ty, name).try();
    inst ::= c.alloc.Inst();
    own = c.applied_at_own_vars(ty).try();
    c.types.at(own).match({
        Named(n) => {
            args ::= c.alloc.Vec<TyId>();
            c.denote_targs(call.targs, ctx, args).try();
            c.zip(n.args, args, inst).try();
            c.types.at(ty).match({
                Named(r) => c.zip(n.args, r.args, inst),
                _        => Ok(()),
            })
        },
        _        => Ok(()),
    }).try();
    cases ::= c.alloc.Vec<Case>();
    c.cases_of(ty, cases).try();
    (cases.find_case(name).match({
        None   => Ok(()),
        Ok(cs) => c.payload_says(call, ty, cs, ctx, inst),
    })).try();
    c.variant_has_type(call, ty).match({
        true  => c.variant_payload_fits(call, ty, name, ctx, inst),
        false => Ok(()),
    }).try();
    settled = (inst.len() == 0).match({
        true  => Ok(ty),
        false => c.subst(own, inst),
    }).try();
    catch_all.match({
        false => c.nominal_bounds_hold(settled, call.args_span).try().match({
            true  => Ok(settled),
            false => c.types.unknown(),
        }),
        true  => {
            c.report(
                call.args_span.file,
                call.args_span,
                SemaFault.CatchAllConstruction(NameFault(name: name))
            ).try();
            c.types.unknown()
        },
    })
}

nominal_bounds_hold = (c :: Checker, ty: TyId, at: Span)
                      Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            None     => Ok(true),
            Ok(decl) => c.decl_bounds_hold(
                decl,
                n.args,
                c.owner_of(n.decl.module.to_usize(), n.name).try(),
                n.decl.module.to_usize(),
                at
            ),
        }),
        _        => Ok(true),
    })
}

decl_bounds_hold = (
    c      :: Checker,
    decl   : Decl,
    args   : Vec<TyId>,
    owner  : str,
    module : usize,
    at     : Span
)
                   Res<bool, AllocError> {
    tmark  = c.tvar_mark();
    poison = c.types.unknown().try();
    ctx    = Ctx(module, poison);
    bounds ::= c.alloc.Vec<TBound>();
    vars   ::= c.alloc.Vec<TyId>();
    decl.kind.match({
        Struct(s) => {
            c.push_tparams(s.tparams, owner).try();
            c.tparam_vars(s.tparams, owner, vars).try();
            s.tparams.loop((h, tp) { c.tparam_bounds(tp, ctx, bounds).try() });
        },
        Enum(e)   => {
            c.push_tparams(e.tparams, owner).try();
            c.tparam_vars(e.tparams, owner, vars).try();
            e.tparams.loop((h, tp) { c.tparam_bounds(tp, ctx, bounds).try() });
        },
        _         => (),
    });
    c.release_tvars(tmark).try();
    inst ::= c.alloc.Inst();
    c.zip(vars, args, inst).try();
    c.inst_bounds_hold(bounds, owner, inst, at)
}

variant_has_type = (c: Checker, call: Call, ty: TyId) bool {
    (call.targs.len > 0) || c.types.at(ty).match({
        Named(n) => n.args.len > 0,
        _        => false,
    })
}

variant_payload_fits = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    name : str,
    ctx  : Ctx,
    inst : Inst
) Res<(), AllocError> {
    call.args.get(0).match({
        None    => Ok(()),
        Ok(arg) => {
            payload = c.case_payload(ty, name).try();
            want    = c.subst(payload, inst).try();
            c.check_literal(arg.value, want).try();
            got = c.type_of(arg.value, ctx).try();
            c.is_literal_ty(got).match({
                true  => Ok(()),
                false => c.coerce(arg.span.file, arg.span, got, want, ""),
            })
        },
    })
}

// A written binding supplies the same application that explicit type
// arguments would: to a variant call of the expected enum, and to a
// construction of the expected type.
settle_variant_at* = (
    c    :: Checker,
    id   : ExprId,
    got  : TyId,
    want : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    VariantCall(c, id, got, want).match({
        None     => c.settle_ctor_at(id, got, want, ctx),
        Ok(site) => site.settle(c, ctx),
    })
}

// `r: Range<u8> = Range(0, 10)` is a Range<u8>: the written type settles
// what the literals left to their default. The construction is checked again
// at the written type, so a value that does not fit it is refused there, at
// the value. A call that wrote its type arguments keeps them. A generic
// function whose result is the written type's declaration, such as
// `Range(10)`, is settled the same way (`settle_generic_call`).
settle_ctor_at = (c :: Checker, id: ExprId, got: TyId, want: TyId, ctx: Ctx)
                 Res<TyId, AllocError> {
    site: Res<CtorSite> = CtorSite(c, id, got, want);
    site.match({
        None    => Ok(got),
        Ok(one) => one.function.match({
            true  => c.settle_generic_call(id, one, got, want, ctx),
            false => c.settle_construction(id, one, want, ctx),
        }),
    })
}

settle_construction = (
    c    :: Checker,
    id   : ExprId,
    one  : CtorSite,
    want : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    mark = c.diag_count();
    c.check_ctor_fields(one.call, want, ctx).try();
    (c.diag_count() == mark).match({
        false => c.types.unknown(),
        true  => {
            c.expr_memo.set(id, want).try();
            c.record_call(
                id,
                CallResolution.Checked(CheckedCall(
                    declaration: one.checked.declaration,
                    member_provider: one.checked.member_provider,
                    inst: one.checked.inst,
                    result: want,
                    signature: one.checked.signature,
                    body: one.checked.body
                ))
            ).try();
            Ok(want)
        },
    })
}

// The function's declared result names its type parameters
// (`Range<T>`), so the written type's arguments bind them; the arguments are
// then checked against the parameters at that binding.
settle_generic_call = (
    c    :: Checker,
    id   : ExprId,
    one  : CtorSite,
    got  : TyId,
    want : TyId,
    ctx  : Ctx
) Res<TyId, AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    c.cands_of(ctx.module, one.name, cands).try();
    picked: Res<Cand> = one.checked.declaration.match({
        None  => None,
        Ok(d) => cands.find((k) { k.id.eq(d) }),
    });
    picked.match({
        None  => Ok(got),
        Ok(k) => {
            inst ::= c.alloc.Inst();
            c.zip(
                c.named_arg_list(k.ret).try(),
                c.named_arg_list(want).try(),
                inst
            ).try();
            Range(0, one.checked.inst.len()).loop((i) {
                one.checked.inst.var_at(i).when_ok((v) {
                    one.checked.inst.arg_at(i).when_ok((a) { inst.bind(v, a).try(); });
                });
            });
            params ::= c.alloc.Vec<TyId>();
            c.subst_list(k.params, inst, params).try();
            mark = c.diag_count();
            fits ::= true;
            one.call.args.loop((h, i, a) {
                p = params.ty_at(i);
                (c.assignable(c.type_of(a.value, ctx).try(), p)).match({
                    true  => c.check_literal(a.value, p).try(),
                    false => { fits = false; },
                });
            });
            settled = fits && c.same_type(c.subst(k.ret, inst).try(), want);
            (settled && c.diag_count() == mark).match({
                false => settled.match({
                    // A value that does not fit the written type was refused.
                    true  => c.types.unknown(),
                    false => Ok(got),
                }),
                true  => {
                    c.expr_memo.set(id, want).try();
                    c.record_call(
                        id,
                        CallResolution.Checked(CheckedCall(
                            declaration: one.checked.declaration,
                            member_provider: one.checked.member_provider,
                            inst: inst,
                            result: want,
                            signature: Ok(CallSignature(
                                params: params,
                                receiver: None
                            )),
                            body: one.checked.body
                        ))
                    ).try();
                    Ok(want)
                },
            })
        },
    })
}

named_arg_list = (c :: Checker, ty: TyId) Res<Vec<TyId>, AllocError> {
    out ::= c.alloc.Vec<TyId>();
    c.named_args(ty, out).try();
    Ok(out)
}

CtorSite = { call: Call, checked: CheckedCall, name: str, function: bool }

CtorSite = (c: Checker, id: ExprId, got: TyId, want: TyId) Res<CtorSite> {
    (c.same_head(got, want) && !c.same_type(got, want)).ensure().try();
    call = c.tree.expr_at(id).kind.match({ Call(value) => Ok(value), _ => None }).try();
    (call.targs.len == 0).ensure().try();
    checked  = c.checked_call(id).try();
    decl     = c.tree.decl_at(checked.declaration.try()).try();
    name     = c.tree.expr_at(call.callee).kind.match({ Name(n) => Ok(n.text), _ => None }).try();
    function = decl.kind.match({
        Struct(_)   => Ok(false),
        Function(f) => (f.tparams.len > 0).match({ true => Ok(
            true
        ), false => None }),
        _           => None,
    }).try();
    Ok(CtorSite(call: call, checked: checked, name: name, function: function))
}

// An inferred call to a declared variant of the expected enum application.
// Selection is allocation-free; missing syntax is ordinary absence.
VariantCall = {
    id: ExprId,
    call: Call,
    name: str,
    want: TyId,

    settle = (self: @Self, c :: Checker, ctx: Ctx) Res<TyId, AllocError> {
        settled = c.variant_call_type(
            self.call,
            self.want,
            self.name,
            ctx
        ).try();
        c.expr_memo.set(self.id, settled).try();
        Ok(settled)
    }
}

VariantCall = (c: Checker, id: ExprId, got: TyId, want: TyId) Res<VariantCall> {
    c.same_head(got, want).ensure().try();
    call = c.tree.expr_at(id).kind.match({ Call(value) => Ok(value), _ => None }).try();
    (call.targs.len == 0).ensure().try();
    access      = c.tree.expr_at(call.callee).kind.match({ Access(value) => Ok(value), _ => None }).try();
    named       = c.types.at(want).match({ Named(value) => Ok(value), _ => None }).try();
    decl        = c.tree.decl_at(named.decl).try();
    enumeration = decl.kind.match({ Enum(value) => Ok(
        value
    ), _ => None }).try();
    enumeration.variants.find(
        (variant) { variant.name.text.eq(access.name.text) }
    ).try();
    Ok(VariantCall(id: id, call: call, name: access.name.text, want: want))
}

// Re-apply the declaration at its own variables so every explicit or
// inferred argument binds the same `T` before substitution.
applied_at_own_vars = (c :: Checker, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            None  => Ok(ty),
            Ok(d) => {
                owner = c.owner_of(n.decl.module.to_usize(), n.name).try();
                vars ::= c.alloc.Vec<TyId>();
                c.decl_tparam_vars(d, owner, vars).try();
                c.types.named(n.decl, owner, n.name, vars)
            },
        }),
        _        => Ok(ty),
    })
}

// A variant holds one payload seat or none, so an argument past its arity
// has nowhere to land: codegen evaluates it and drops it, and the reader is
// told nothing. Report the first one; the rest are the same mistake.
refuse_variant_surplus* = (c :: Checker, call: Call, ty: TyId, name: str)
                          Res<(), AllocError> {
    cases ::= c.alloc.Vec<Case>();
    c.cases_of(ty, cases).try();
    cases.find_case(name).match({
        None   => Ok(()),
        Ok(cs) => c.refuse_surplus_payload(call, ty, cs),
    })
}

refuse_surplus_payload = (c :: Checker, call: Call, ty: TyId, cs: Case)
                         Res<(), AllocError> {
    call.args.get(cs.arity()).match({
        None  => Ok(()),
        Ok(a) => c.report(
            a.span.file,
            a.span,
            SemaFault.CtorSurplusArgument(TypeFault(
                name: "",
                expected: c.types.unknown().try(),
                found: ty,
            ))
        ),
    })
}

// Unify a variant payload with its first argument. A nullary variant leaves
// the enum's type parameters unbound.
payload_says = (
    c    :: Checker,
    call : Call,
    ty   : TyId,
    cs   : Case,
    ctx  : Ctx,
    inst :: Inst
) Res<(), AllocError> {
    call.args.get(0).match({
        None  => Ok(()),
        Ok(a) => c.unify(
            c.case_payload(ty, cs.name).try(),
            c.settled_arg_ty(a, ctx).try(),
            inst
        ),
    })
}

settled_arg_ty = (c :: Checker, a: Arg, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(a.value, ctx).try();
    c.is_literal_ty(got).match({
        false => Ok(got),
        true  => c.types.prim(c.prim_name(got).literal_default()),
    })
}

ctor_args = (c :: Checker, call: Call, d: Def, ctx: Ctx)
            Res<Vec<TyId>, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    (call.targs.len == 0).match({
        true  => c.tree.decl_at(d.id).match({
            None    => Ok(()),
            Ok(dec) => c.decl_tparam_vars(dec, d.qname, args),
        }),
        false => c.denote_targs(call.targs, ctx, args),
    }).try();
    Ok(args)
}

// Written type arguments resolve in the caller's module.
denote_targs = (
    c     :: Checker,
    targs : Vec<TypeId>,
    ctx   : Ctx,
    out   :: Vec<TyId>
) Res<(), AllocError> {
    targs.loop((h, t) { out.add(c.type_from_ast(t, ctx).try()).try() });
    Ok(());
}

Instantiation* = { result*: TyId, inst*: Inst }

instantiate* = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<Res<Instantiation>, AllocError> {
    c.type_arg_arity_fits(call, k).match({
        false => c.invalid_instantiation(id, k.name),
        true  => k.generic.match({
            false => c.callback_types_fit(
                call,
                k.params,
                actuals.len - call.args.len,
                ctx,
                c.alloc.Inst()
            ).try().match({
                true  => Ok(Ok(Instantiation(
                    result: k.ret,
                    inst: c.alloc.Inst()
                ))),
                false => c.invalid_instantiation(id, k.name),
            }),
            true  => c.instantiated_ret(id, call, k, actuals, ctx),
        }),
    })
}

type_arg_arity_fits = (c: Checker, call: Call, k: Cand) bool {
    (call.targs.len == 0) || (call.targs.len == k.tvars.len)
}

instantiated_ret = (
    c       :: Checker,
    id      : ExprId,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
)
                   Res<Res<Instantiation>, AllocError> {
    inst = c.settled_ret_literals(
        k.ret,
        c.call_inst(call, k, actuals, ctx).try()
    ).try();
    c.check_inst_bounds(k, inst, c.tree.expr_at(id).span).try().match({
        false => Ok(None),
        true  => {
            params ::= c.alloc.Vec<TyId>();
            c.subst_list(k.params, inst, params).try();
            (c.signature_matches(params, actuals, 0).try()
                && c.callback_types_fit(
                    call,
                    k.params,
                    actuals.len - call.args.len,
                    ctx,
                    inst
                ).try()).match({
                false => c.invalid_instantiation(id, k.name),
                true  => {
                    Ok(Ok(Instantiation(
                        result: c.subst(k.ret, inst).try(),
                        inst: inst
                    )))
                },
            })
        },
    })
}

// A type parameter a literal settled keeps the literal's flexible type in a
// plain value (`id(7)` still fits a u8), but a declared type over it has a
// layout, so a parameter the result passes to a declared type takes the
// literal's default: `Range(10)` is a `Range<i32>`.
settled_ret_literals = (c :: Checker, ret: TyId, inst: Inst)
                       Res<Inst, AllocError> {
    named: Res<TyNamed> = c.types.at(ret).match({ Named(n) => Ok(n), _ => None });
    named.match({
        None  => Ok(inst),
        Ok(n) => {
            out ::= c.alloc.Inst();
            Range(0, inst.len()).loop((k) {
                inst.var_at(k).when_ok((v) {
                    inst.arg_at(k).when_ok((a) {
                        held = n.args.find(
                            (x) { x.eq(v) }
                        ).match({ Ok(_) => true, None => false });
                        out.bind(v, (held && c.is_literal_ty(a)).match({
                            true  => c.types.prim(
                                c.prim_name(a).literal_default()
                            ).try(),
                            false => a,
                        })).try();
                    });
                });
            });
            Ok(out)
        },
    })
}

invalid_instantiation = (c :: Checker, id: ExprId, name: str)
                        Res<Res<Instantiation>, AllocError> {
    at = c.tree.expr_at(id).span;
    c.report(
        at.file,
        at,
        SemaFault.InvalidInstantiation(NameFault(name: name))
    ).try();
    Ok(None)
}

call_edge* = (c :: Checker, id: ExprId, k: Cand, inst: Inst)
             Res<InstEdge, AllocError> {
    args ::= c.alloc.Vec<TyId>();
    k.tvars.loop((h, v) { args.add(inst.arg_for(v)).try() });
    Ok(InstEdge(
        from_owner: c.owner_of_body(),
        to_owner: k.owner,
        to_name: k.name,
        to_tvars: k.tvars,
        args: args,
        span: c.tree.expr_at(id).span,
    ))
}

call_inst* = (
    c       :: Checker,
    call    : Call,
    k       : Cand,
    actuals : Vec<Actual>,
    ctx     : Ctx
) Res<Inst, AllocError> {
    inst ::= c.alloc.Inst();
    (call.targs.len > 0).then(() {
        tys ::= c.alloc.Vec<TyId>();
        c.denote_targs(call.targs, ctx, tys).try();
        c.zip(k.tvars, tys, inst).try();
    });
    c.infer_callback_targs(
        call,
        k.params,
        actuals.len - call.args.len,
        ctx,
        inst
    ).try();
    c.infer_targs(k, actuals, inst).try();
    c.infer_from_bounds(k, inst).try();
    Ok(inst);
}

// Written callback types provide context for otherwise untyped literals.
// Explicit call arguments were bound first; ordinary values must still fit
// the resulting signature. Generic lambdas keep their own inference scope.
infer_callback_targs* = (
    c      :: Checker,
    call   : Call,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx,
    inst   :: Inst
) Res<(), AllocError> {
    call.args.loop((h, i, a) {
        c.annotated_callback(a.value).match({
            None  => (),
            Ok(l) => c.infer_callback_types(
                l,
                params.ty_at(i + off),
                ctx,
                inst
            ).try(),
        });
    });
    Ok(());
}

// Unannotated callbacks contribute arity only. Generic callbacks establish
// their own type-parameter scope when their selected body is checked.
annotated_callback* = (c :: Checker, id: ExprId) Res<Lambda> {
    lambda = c.spelled_lambda(id).try();
    (lambda.tparams.len == 0).ensure().try();
    (lambda.ret.match({ Ok(_) => true, None => false })
        || lambda.params.find((param) {
            param.type.match({ Ok(_) => true, None => false })
        }).match({ Ok(_) => true, None => false })).ensure().try();
    Ok(lambda)
}

infer_callback_types = (
    c    :: Checker,
    l    : Lambda,
    sig  : TyId,
    ctx  : Ctx,
    inst :: Inst
) Res<(), AllocError> {
    c.types.at(sig).match({
        Fn(f) => {
            l.params.loop((h, i, p) {
                p.type.match({
                    None   => (),
                    Ok(ty) => c.unify(
                        f.params.ty_at(i),
                        c.type_from_ast(ty, ctx).try(),
                        inst
                    ).try(),
                });
            });
            l.ret.match({
                None   => (),
                Ok(ty) => c.unify(
                    f.ret,
                    c.type_from_ast(ty, ctx).try(),
                    inst
                ).try(),
            });
        },
        _     => (),
    });
    Ok(());
}

// Inference binds each variable once. Verify all written callback types
// against that substitution so conflicting annotations cannot be ignored.
// Generic callbacks retain their own type-parameter checking scope.
callback_types_fit* = (
    c      :: Checker,
    call   : Call,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx,
    inst   : Inst
) Res<bool, AllocError> {
    fits ::= true;
    call.args.loop((h, i, arg) {
        c.annotated_callback(arg.value).match({
            None       => (),
            Ok(lambda) => {
                sig = c.subst(params.ty_at(i + off), inst).try();
                c.types.at(sig).match({
                    Fn(fn) => {
                        lambda.params.loop((p, index, param) {
                            fits = fits && c.callback_annotation_fits(
                                param.type,
                                fn.params.ty_at(index),
                                ctx
                            ).try();
                        });
                        fits = fits && c.callback_annotation_fits(
                            lambda.ret,
                            fn.ret,
                            ctx
                        ).try();
                    },
                    _      => (),
                });
            },
        });
    });
    Ok(fits)
}

callback_annotation_fits = (
    c        :: Checker,
    written  : Res<TypeId>,
    expected : TyId,
    ctx      : Ctx
) Res<bool, AllocError> {
    written.match({
        None     => Ok(true),
        Ok(type) => {
            actual = c.type_from_ast(type, ctx).try();
            Ok(c.assignable(actual, expected) && c.assignable(expected, actual))
        },
    })
}

infer_targs = (c :: Checker, k: Cand, actuals: Vec<Actual>, inst :: Inst)
              Res<(), AllocError> {
    k.params.loop((h, i, p) {
        actuals.get(i).match({
            None  => Ok(()),
            Ok(a) => a.is_lambda.match({
                true  => Ok(()),
                false => c.unify(p, a.ty, inst),
            }),
        }).try();
    });
    Ok(());
}

infer_from_bounds = (c :: Checker, k: Cand, inst :: Inst)
                    Res<(), AllocError> {
    k.tbounds.loop((h, tb) { c.infer_one_bound(k, tb, inst).try() });
    Ok(());
}

infer_one_bound = (c :: Checker, k: Cand, tb: TBound, inst :: Inst)
                  Res<(), AllocError> {
    v = c.types.var(tb.name, k.owner).try();
    inst.lookup(v).match({
        None  => Ok(()),
        Ok(g) => c.same_head(tb.bound, g).match({
            true  => c.infer_own_bound(tb.bound, g, inst),
            false => c.infer_impl_bound(tb.bound, g, inst),
        }),
    })
}

same_head = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Named(x) => c.types.at(b).match({
            Named(y) => x.decl.eq(y.decl),
            _        => false,
        }),
        _        => false,
    })
}

// A bound's own type passed as itself settles each type argument it states.
infer_own_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                  Res<(), AllocError> {
    bs ::= c.alloc.Vec<TyId>();
    gs ::= c.alloc.Vec<TyId>();
    c.named_args(bound, bs).try();
    c.named_args(g, gs).try();
    (bs.len == gs.len).then(() {
        bs.loop((h, i, b) {
            settled = gs.ty_at(i);
            (!c.has_var(settled)).then(() { c.unify(b, settled, inst).try(); });
        });
    });
    Ok(());
}

named_args = (c :: Checker, ty: TyId, out :: Vec<TyId>)
             Res<(), AllocError> {
    c.types.at(ty).match({
        Named(n) => n.args.loop((h, a) { out.add(a).try() }),
        _        => (),
    });
    Ok(());
}

infer_impl_bound = (c :: Checker, bound: TyId, g: TyId, inst :: Inst)
                   Res<(), AllocError> {
    c.types.at(g).match({
        Named(n) => c.infer_named_impl(bound, n, inst),
        Array(a) => c.infer_array_bound(bound, a.elem, inst),
        Var(v)   => c.infer_var_bound(bound, v.name, g, inst),
        _        => Ok(()),
    })
}

// Forward a generic receiver's declared bound with its outer type variables
// intact. A later instantiation supplies their concrete types. Conflicting
// bounds with the same head do not provide a unique inference answer.
infer_var_bound = (
    c      :: Checker,
    bound  : TyId,
    name   : str,
    actual : TyId,
    inst   :: Inst
) Res<(), AllocError> {
    bounds ::= c.alloc.Vec<TyId>();
    c.unshadowed_tvar(name, actual).then(() {
        c.bounds_of(name, bounds).try();
    });
    source    :: Res<TyId> = None;
    ambiguous ::= false;
    bounds.loop((h, b) {
        c.same_head(bound, b).then(() {
            source.match({
                None      => { source = Ok(b); },
                Ok(prior) => (prior.eq(b) == false).then(() {
                    ambiguous = true;
                }),
            });
        });
    });
    (ambiguous == false).then(() {
        source.match({
            None  => (),
            Ok(b) => c.unify(bound, b, inst).try(),
        });
    });
    Ok(());
}

infer_array_bound = (c :: Checker, bound: TyId, elem: TyId, inst :: Inst)
                    Res<(), AllocError> {
    c.array_range_shape(bound).match({
        false => Ok(()),
        true  => {
            bs ::= c.alloc.Vec<TyId>();
            c.named_args(bound, bs).try();
            bs.get(0).match({
                None  => Ok(()),
                Ok(b) => c.unify(b, elem, inst),
            })
        },
    })
}

infer_named_impl = (c :: Checker, bound: TyId, n: TyNamed, inst :: Inst)
                   Res<(), AllocError> {
    c.range_seq_arg(n, bound).match({
        Ok(arg) => c.unify(arg, c.range_value(n), inst),
        None    => c.impl_bound_at(bound, n).try().match({
            None   => Ok(()),
            Ok(gb) => c.unify(bound, gb, inst),
        }),
    })
}

// The first local impl whose bound shares `bound`'s head, applied at the
// receiver's own arguments.
impl_bound_at = (c :: Checker, bound: TyId, n: TyNamed)
                Res<Res<TyId>, AllocError> {
    impls ::= c.alloc.Vec<LocalImpl>();
    c.local_impls(n, impls).try();
    impls.find((li) { c.same_head(li.bound, bound) }).match({
        None   => Ok(None),
        Ok(li) => {
            recv = c.inst_of_named(n).try();
            Ok(Ok(c.subst(li.bound, recv).try()))
        },
    })
}
