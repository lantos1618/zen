{ Expr, ExprId, Call, Arg, Access, Lambda, Param, Paren } = std.ast
{ Span, nowhere } = std.source
{ Struct, Function, BlockId } = std.ast
{ Ast } = std.ast.ast_arena
{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ str } = std.text
{ Res, Ok, None, Range } = std.core
{ DeclId } = sema.sema_id
{ TyId, TyFn, TyNamed, literal_default, is_integer } = sema.sema_ty
{ Def, decl_at } = sema.sema_def
{ SemaFault, NameFault, TypeFault, PairFault, ExportFault } = sema.sema_diag
{ Checker, Ctx, CheckedCall, CallSignature, CallResolution } = sema.sema_check
{ refuse_handle_argument } = sema.sema_handle
{ meta_refused } = sema.sema_meta
{ meta_member_call, MetaCall } = sema.sema_meta
{ discriminant_member_call, DiscriminantAnswer } = sema.sema_discriminant
{ variant_name_member_call, VariantNameAnswer } = sema.sema_variant_name
{ construct, instantiate, variant_call_type, call_edge } = sema.sema_apply
{ refuse_variant_surplus, call_inst, callback_types_fit, annotated_callback } = sema.sema_apply
{ infer_callback_targs } = sema.sema_apply
{ Inst, InstEdge, MemberEdge, subst, subst_list, unify_list, tparam_vars, zip, owner_of, unify } = sema.sema_inst
{ is_case } = sema.sema_case
{ Found, Base, base_of, members_of, actor_spawn_ret, ref_of_actor } = sema.sema_member
{ materialize_receiver } = sema.sema_member
{ is_type_def, opaque, first_found, named_as } = sema.sema_member
{ static_access } = sema.sema_static
{ filter_visible, hidden_member } = sema.sema_member
{ inst_bounds_hold, satisfies_bound, note_bound_view } = sema.sema_bound
{ check_literal } = sema.sema_trap
{ check_arms, check_arms_agree, hoist_at, one_value, tail_expr } = sema.sema_hoist
{ check_dropped_tail, note_lambda_tail } = sema.sema_effect
{ bound_declares } = sema.sema_supply
{ type_of, block_type } = sema.sema_type
{ push_tparams, module_name } = sema.sema_inst
{ param_type, type_from_ast } = sema.sema_denote
{ alias_module, module_not_a_value, module_named_by } = sema.sema_module
{ Cand, TBound, Actual, cands_of, exported_cands, core_cands } = sema.sema_cand
{ matches } = sema.sema_cand
{ ty_at, is_tvar, sig_fits, signature_matches } = sema.sema_cand
{ omittable_tail, collect_bounds, tail_swallows } = sema.sema_cand
{ missing_import, require_bound } = sema.sema_import

// A recovery signature supplies expected types to argument diagnostics, but
// it cannot make a call valid when its declared parameters do not match.
SignatureFit = { Exact | Recovery: str }

RecoverySig = {
    ty: TyId,
    off: usize,
}

SignatureUse = {
    node: Expr,
    call: Call,
    ctx: Ctx,
    ty: TyId,
    params: Vec<TyId>,
    off: usize,
    fit: SignatureFit,

    finish = (self: @Self, c :: Checker) Res<TyId, AllocError> {
        c.arg_literals(self.call.args, self.params, self.off, self.ctx).try();
        c.arg_lambdas(self.call.args, self.params, self.off, self.ctx).try();
        c.sig_args_handle_check(
            self.node,
            self.call,
            self.ty,
            self.off,
            self.ctx
        ).try();
        self.fit.match({
            Exact          => c.fn_ret(self.node, self.ty),
            Recovery(name) => {
                c.report(
                    self.node.span.file,
                    self.node.span,
                    SemaFault.NoOverload(NameFault(name: name))
                ).try();
                c.types.unknown()
            },
        })
    }
}

CallCheck = {
    id: ExprId,
    node: Expr,
    call: Call,
    ctx: Ctx,
    actuals :: Vec<Actual>,
    declaration :: Res<DeclId>,
    provider :: Res<TyId>,
    inst :: Inst,
    checked_signature :: Res<CallSignature>,
    body :: Res<BlockId>,
    edge :: Res<InstEdge>,
    member_edge :: Res<MemberEdge>,

    run = (self :: @Self, c :: Checker) Res<TyId, AllocError> {
        callee = c.tree.call_callee(self.call);
        callee.kind.match({
            Access(a) => self.member(c, a),
            Name(n)   => self.named(c, n.text),
            _         => self.indirect(c),
        })
    }

    load_actuals = (self :: @Self, c :: Checker) Res<AllocError> {
        c.actuals_of(self.call.args, self.ctx, self.actuals)
    }

    named = (self :: @Self, c :: Checker, name: str)
            Res<TyId, AllocError> {
        self.load_actuals(c).try();
        c.calls_res_ctor(name, self.ctx.module).try().match({
            true  => {
                c.require_bound(self.ctx.module, name, self.callee_span(c))
                    .try();
                c.refuse_res_surplus(self.call, name).try();
                c.res_ctor_type(name, self.actuals)
            },
            false => self.local_or_decl(c, name),
        })
    }

    local_or_decl = (self :: @Self, c :: Checker, name: str)
                    Res<TyId, AllocError> {
        c.lookup(name).match({
            Ok(b) => self.local_signature(c, b.ty),
            None  => self.unbound_or_decl(c, name),
        })
    }

    // A standard function or type called without its import is reported
    // here, before resolution, so the call then resolves as the import
    // would. An unimported printer is typed as the printer it names.
    unbound_or_decl = (self :: @Self, c :: Checker, name: str)
                      Res<TyId, AllocError> {
        found ::= c.alloc.Vec<Def>();
        c.world.defs_of(self.ctx.module, name, found).try();
        variants ::= c.alloc.Vec<Def>();
        (found.len == 0).then(() {
            c.world.variant_defs(c.tree, self.ctx.module, name, variants)
                .try();
        });
        unbound  = found.len == 0 && variants.len == 0;
        reported = unbound && c.missing_import(
            self.ctx.module,
            name,
            self.callee_span(c)
        ).try();
        (reported && name.is_printer_name()).match({
            true  => c.print_type(self.call),
            false => self.decl(c, name, None, self.actuals, None),
        })
    }

    callee_span = (self: @Self, c: Checker) Span {
        c.tree.expr_at(self.call.callee).span
    }

    local_signature = (self :: @Self, c :: Checker, ty: TyId)
                      Res<TyId, AllocError> {
        (self.call.targs.len > 0).match({
            true  => self.invalid_member_instantiation(
                c,
                c.call_name(self.call)
            ),
            false => {
                settled = self.instantiate_sig(c, ty).try();
                self.fitted_signature(c, settled, 0)
            },
        })
    }

    decl = (
        self    :: @Self,
        c       :: Checker,
        name    : str,
        recv    : Res<TyId>,
        actuals : Vec<Actual>,
        recovery: Res<RecoverySig>
    ) Res<TyId, AllocError> {
        cands ::= c.alloc.Vec<Cand>();
        c.cands_of(self.ctx.module, name, cands).try();
        // After what the module sees, a dot call reaches std.core's functions
        // for the receiver's type.
        recv.match({
            Ok(rty) => c.core_cands(name, rty, cands).try(),
            None    => (),
        });
        self.first_matching(c, cands, actuals).try().match({
            Ok(k) => self.chosen(c, k, actuals),
            None  => self.construct_or_fail(c, name, recv, cands, recovery),
        })
    }

    construct_or_fail = (
        self  :: @Self,
        c     :: Checker,
        name  : str,
        recv  : Res<TyId>,
        cands : Vec<Cand>,
        recovery: Res<RecoverySig>
    ) Res<TyId, AllocError> {
        defs ::= c.alloc.Vec<Def>();
        c.world.defs_of(self.ctx.module, name, defs).try();
        defs.find((d) { d.kind.is_type_def() }).match({
            None  => recovery.match({
                Ok(sig) => self.recovery_signature(c, sig.ty, sig.off),
                None    => recv.match({
                    Ok(ty) => c.no_such_method(self.call, name, ty),
                    None   => self.no_overload(c, name, cands),
                }),
            }),
            Ok(d) => self.construct_def(c, d),
        })
    }

    no_overload = (self: @Self, c :: Checker, name: str, cands: Vec<Cand>)
                  Res<TyId, AllocError> {
        (cands.len > 0).match({
            true  => c.report(
                self.node.span.file,
                self.node.span,
                SemaFault.NoOverload(NameFault(name: name))
            ),
            false => {
                // Bare payload constructors receive their enum from context.
                // A missing function with no such variant must still be rejected.
                variants ::= c.alloc.Vec<Def>();
                c.world.variant_defs(
                    c.tree,
                    self.ctx.module,
                    name,
                    variants
                ).try();
                // Import failures already have a diagnostic at the binding.
                imported = c.world.table_at(self.ctx.module).match({
                    Ok(table) => table.imports_name(name),
                    None      => false,
                });
                (variants.len == 0 && !imported).then(() {
                    c.undefined_or_unimported(self.node.span, name).try();
                });
                Ok
            },
        }).try();
        c.types.unknown()
    }

    construct_def = (self :: @Self, c :: Checker, d: Def)
                    Res<TyId, AllocError> {
        c.alias_module(d.id).match({
            None   => {
                ty               = c.construct(
                    self.id,
                    self.call,
                    d,
                    self.ctx
                ).try();
                self.declaration = Ok(d.id);
                Ok(ty)
            },
            Ok(mi) => c.module_not_a_value(self.node.span, d.name, mi),
        })
    }

    chosen = (self :: @Self, c :: Checker, k: Cand, actuals: Vec<Actual>)
             Res<TyId, AllocError> {
        mark = c.diag_count();
        off  = self.call.recv_off(actuals);
        c.arg_literals(self.call.args, k.params, off, self.ctx).try();
        c.instantiate(self.id, self.call, k, actuals, self.ctx).try().match({
            None        => c.types.unknown(),
            Ok(applied) => {
                self.inst = applied.inst;
                params ::= c.alloc.Vec<TyId>();
                c.subst_list(k.params, self.inst, params).try();
                (c.diag_count() == mark).then(() {
                    self.instantiated_literals(c, k.params, params, off).try();
                });
                k.generic.match({
                    false => c.arg_lambdas(
                        self.call.args,
                        params,
                        off,
                        self.ctx
                    ),
                    true  => {
                        c.arg_lambdas_settling(
                            self.call.args,
                            params,
                            k.params,
                            off,
                            self.ctx,
                            self.inst
                        ).try();
                        params.clear();
                        c.subst_list(k.params, self.inst, params)
                    },
                }).try();
                c.args_handle_check(self.call.args, params, off, self.ctx)
                    .try();
                c.note_receiver_view(self.receiver_expr(c, off), params).try();
                c.refuse_literal_lends(k, params, actuals).try();
                k.generic.then(() {
                    self.edge = Ok(c.call_edge(self.id, k, self.inst).try());
                });
                self.body              = c.tree.decl_at(k.id).match({
                    None     => None,
                    Ok(decl) => decl.kind.match({ Function(fn) => fn.body, _ => None }),
                });
                self.declaration       = Ok(k.id);
                self.checked_signature = Ok(CallSignature(
                    params: params,
                    receiver: self.receiver_expr(c, off)
                ));
                k.generic.match({
                    false => Ok(applied.result),
                    true  => c.subst(k.ret, self.inst),
                })
            },
        })
    }

    // Literal families still awaiting context are not concrete numeric widths.
    // Check newly settled widths without replaying diagnostics for parameters
    // whose declared type was already checked.
    instantiated_literals = (self: @Self, c :: Checker, declared: Vec<TyId>,
                             settled: Vec<TyId>, off: usize)
                             Res<AllocError> {
        self.receiver_expr(c, off).when_ok((receiver) {
            ty   = c.type_of(receiver, self.ctx).try();
            want = settled.ty_at(0);
            ((c.is_literal_ty(ty) || !want.eq(declared.ty_at(0))) && c.numeric_literal_context(want)).then(() {
                c.check_literal(receiver, want).try();
            });
        });
        self.call.args.loop((h, i, arg) {
            want = settled.ty_at(i + off);
            (!want.eq(declared.ty_at(i + off)) && c.numeric_literal_context(want)).then(() {
                c.check_literal(arg.value, want).try();
            });
        });
        Ok
    }

    receiver_expr = (self: @Self, c: Checker, off: usize) Res<ExprId> {
        (off == 1).ensure().try();
        c.tree.call_callee(self.call).kind.match({
            Access(access) => Ok(access.base),
            _              => None,
        })
    }

    member = (self :: @Self, c :: Checker, ac: Access)
             Res<TyId, AllocError> {
        c.callee_access.set(self.call.callee, true).try();
        c.meta_member_call(self.id, self.node, self.call, ac, self.ctx)
            .try().match({
                Answered(ty) => Ok(ty),
                Ordinary     => self.ordinary_member(c, ac),
            })
    }

    ordinary_member = (self :: @Self, c :: Checker, ac: Access)
                      Res<TyId, AllocError> {
        c.tree.expr_at(ac.base).kind.match({
            Meta(_) => c.meta_refused(c.tree.expr_at(ac.base)),
            _       => {
                b = c.base_of(ac.base, self.ctx).try();
                c.discriminant_member_call(
                    self.id,
                    self.node,
                    self.call,
                    ac,
                    b,
                    self.ctx
                ).try().match({
                    DiscriminantAnswered(ty) => Ok(ty),
                    NotDiscriminant          => c.variant_name_member_call(
                        self.id,
                        self.node,
                        self.call,
                        ac,
                        b,
                        self.ctx
                    ).try().match({
                        VariantNameAnswered(ty) => Ok(ty),
                        NotVariantName          => b.is_type.match({
                            true  => self.static_member(c, ac, b.ty),
                            false => self.receiver(c, ac, b),
                        }),
                    }),
                })
            },
        })
    }

    static_member = (self :: @Self, c :: Checker, ac: Access, ty: TyId)
                    Res<TyId, AllocError> {
        self.load_actuals(c).try();
        c.module_named_by(ty).match({
            Ok(module) => self.module_static(c, ac, module, ty),
            None       => {
                got = c.static_access(
                    self.call.callee,
                    self.node,
                    ac,
                    ty,
                    self.ctx
                ).try();
                c.is_case(ty, ac.name.text).try().match({
                    true  => {
                        c.refuse_variant_surplus(self.call, ty, ac.name.text)
                            .try();
                        c.variant_call_type(
                            self.call,
                            ty,
                            ac.name.text,
                            self.ctx
                        )
                    },
                    false => {
                        self.written_associated(c, ac, ty, got)
                    },
                })
            },
        })
    }

    module_static = (self :: @Self, c :: Checker, ac: Access, module: usize,
                     ty: TyId) Res<TyId, AllocError> {
        defs ::= c.alloc.Vec<Def>();
        c.world.exported_defs(module, ac.name.text, defs).try();
        defs.get(0).match({
            None    => self.module_static_type(c, ac, ty),
            Ok(def) => def.kind.match({
                StructDef   => c.fn_ret(
                    self.node,
                    self.module_static_type(c, ac, ty).try()
                ),
                FunctionDef => self.module_function(c, ac, module),
                _           => c.fn_ret(
                    self.node,
                    self.module_static_type(c, ac, ty).try()
                ),
            }),
        })
    }

    module_static_type = (self :: @Self, c :: Checker, ac: Access, ty: TyId)
                         Res<TyId, AllocError> {
        c.static_access(self.call.callee, self.node, ac, ty, self.ctx)
    }

    module_function = (self :: @Self, c :: Checker, ac: Access, module: usize)
                      Res<TyId, AllocError> {
        cands ::= c.alloc.Vec<Cand>();
        c.exported_cands(module, ac.name.text, cands).try();
        self.first_matching(c, cands, self.actuals).try().match({
            Ok(cand) => self.chosen(c, cand, self.actuals),
            None     => self.no_overload(c, ac.name.text, cands),
        })
    }

    written_associated = (self :: @Self, c :: Checker, ac: Access, ty: TyId,
                          got: TyId) Res<TyId, AllocError> {
        found ::= c.alloc.Vec<Found>();
        c.members_of(ty, ac.name.text, found).try();
        c.pick_fitting(found, self.actuals, 0).try().match({
            None    => (self.call.targs.len > 0).match({
                true  => self.invalid_member_instantiation(c, ac.name.text),
                false => self.fitted_signature(c, got, 0),
            }),
            Ok(mem) => self.checked_member(c, ac, mem, 0),
        })
    }

    receiver = (self :: @Self, c :: Checker, ac: Access, b: Base)
               Res<TyId, AllocError> {
        c.opaque(b.ty).match({
            true  => c.types.unknown(),
            false => {
                self.load_actuals(c).try();
                c.is_literal_ty(b.ty).match({
                    true  => self.contextual_literal_receiver(c, ac, b),
                    false => self.known_receiver(c, ac, b),
                })
            },
        })
    }

    // Generic UFCS inference gets the literal family before the primitive
    // default settles which concrete member applies.
    contextual_literal_receiver = (self :: @Self, c :: Checker, ac: Access,
                                   b: Base) Res<TyId, AllocError> {
        cands ::= c.alloc.Vec<Cand>();
        c.cands_of(self.ctx.module, ac.name.text, cands).try();
        generic = cands.filter(
            c.alloc,
            (candidate) { candidate.generic }
        ).try();
        actuals = self.receiver_actuals(c, b).try();
        self.first_matching(c, generic, actuals).try().match({
            Ok(k) => self.chosen(c, k, actuals),
            None  => self.known_receiver(
                c,
                ac,
                c.materialize_receiver(ac.base, b).try()
            ),
        })
    }

    known_receiver = (self :: @Self, c :: Checker, ac: Access, b: Base)
                     Res<TyId, AllocError> {
        found ::= c.alloc.Vec<Found>();
        c.members_of(b.ty, ac.name.text, found).try();
        visible ::= c.alloc.Vec<Found>();
        found.filter_visible(self.ctx.module, visible).try().match({
            Ok(f) => c.hidden_member(ac, f),
            None  => self.reachable(c, ac, b, visible),
        })
    }

    reachable = (
        self  :: @Self,
        c     :: Checker,
        ac    : Access,
        b     : Base,
        found : Vec<Found>
    ) Res<TyId, AllocError> {
        c.refuse_actor_payloads(b.ty, self.actuals, self.call).try();
        (found.len > 0).match({
            true  => {
                got = self.method(c, ac, b, found).try();
                self.actuals.get(0).match({
                    None    => Ok(got),
                    Ok(arg) => c.actor_spawn_ret(
                        b.ty,
                        ac.name.text,
                        arg.ty,
                        got
                    ),
                })
            },
            false => self.ufcs(c, ac, b),
        })
    }

    method = (
        self  :: @Self,
        c     :: Checker,
        ac    : Access,
        b     : Base,
        found : Vec<Found>
    )
             Res<TyId, AllocError> {
        c.pick_fitting(found, self.actuals, 1).try().match({
            Ok(f) => self.checked_member(c, ac, f, 1),
            None  => c.ref_of_actor(b.ty).try().match({
                None  => self.by_arity(c, ac, b, found, 1),
                Ok(_) => c.pick_fitting(found, self.actuals, 0).try().match({
                    Ok(f) => self.checked_member(c, ac, f, 0),
                    None  => self.by_arity(c, ac, b, found, 1),
                }),
            }),
        })
    }

    // Publish only a successfully checked member, never a recovery signature.
    checked_member = (self :: @Self, c :: Checker, ac: Access, f: Found,
                      off: usize) Res<TyId, AllocError> {
        mark = c.diag_count();
        ac.name.text.is_in(["read", "copy_from"]).then(() {
            c.types.at(f.decl_owner).match({
                Named(n) => c.world.is_core_decl(n.decl, "Ptr").try().then(() {
                    n.args.get(0).when_ok((element) {
                        c.contains_drop(element).try().then(() {
                            c.refuse(
                                self.node.span,
                                SemaFault.CopyFromPointer(NameFault(
                                    name: ac.name.text
                                ))
                            ).try();
                        });
                    });
                }),
                _        => (),
            });
        });
        self.body = c.member_fn(f.decl_owner, ac.name.text, f.decl_span).match({
            None => None, Ok(fn) => fn.body,
        });
        ty        = self.written_found(c, ac, f, off).try();
        got       = self.signature(c, ty, off, SignatureFit.Exact).try();
        (c.diag_count() == mark).then(() {
            c.types.at(ty).match({
                Fn(_) => {
                    provider = c.types.at(f.bound).match({
                        Unknown => f.decl_owner,
                        _       => f.bound,
                    });
                    (!c.is_unknown(provider)).then(() {
                        self.provider = Ok(provider);
                    });
                    c.is_unknown(f.bound).then(() {
                        self.member_edge = c.member_edge(
                            ac,
                            f,
                            ty,
                            self.inst,
                            self.node.span
                        );
                    });
                },
                _     => (),
            });
        });
        Ok(got)
    }

    // A member's own type parameters are settled before the signature is
    // fitted. Written arguments handle return-only doors such as
    // `env.args<Cli>()`; ordinary arguments infer nested uses too.
    written_found = (self :: @Self, c :: Checker, ac: Access, f: Found,
                     off: usize) Res<TyId, AllocError> {
        c.member_fn(f.decl_owner, ac.name.text, f.decl_span).match({
            None   => (self.call.targs.len > 0).match({
                true  => self.invalid_member_instantiation(c, ac.name.text),
                false => Ok(f.ty),
            }),
            Ok(fn) => (fn.tparams.len == 0 && self.call.targs.len == 0).match({
                true  => Ok(f.ty),
                false => self.instantiate_member(c, ac, f, fn, off),
            }),
        })
    }

    instantiate_member = (self :: @Self, c :: Checker, ac: Access, f: Found,
                          fn: Function, off: usize) Res<TyId, AllocError> {
        owner = c.owner_of(f.module, fn.name.text).try();
        vars ::= c.alloc.Vec<TyId>();
        c.tparam_vars(fn.tparams, owner, vars).try();
        ((self.call.targs.len > 0)
            && (self.call.targs.len != vars.len)).match({
            true  => self.invalid_member_instantiation(c, ac.name.text),
            false => {
                tmark = c.tvar_mark();
                c.push_tparams(fn.tparams, owner).try();
                bounds ::= c.alloc.Vec<TBound>();
                poison = c.types.unknown().try();
                c.collect_bounds(fn, Ctx(f.module, poison), bounds).try();
                c.release_tvars(tmark).try();
                self.settled_member(
                    c,
                    ac.name.text,
                    f.ty,
                    vars,
                    bounds,
                    owner,
                    off
                )
            },
        })
    }

    settled_member = (self :: @Self, c :: Checker, name: str, ty: TyId,
                      vars: Vec<TyId>, bounds: Vec<TBound>, owner: str,
                      off: usize)
                      Res<TyId, AllocError> {
        tys ::= c.alloc.Vec<TyId>();
        self.call.targs.loop((h, t) {
            tys.add(c.type_from_ast(t, self.ctx).try()).try();
        });
        inst ::= c.alloc.Inst();
        c.zip(vars, tys, inst).try();
        params = c.types.at(ty).match({
            Fn(signature) => signature.params,
            _             => c.alloc.Vec<TyId>(),
        });
        c.infer_callback_targs(self.call, params, off, self.ctx, inst).try();
        c.infer_member_inst(ty, self.actuals, off, inst).try();
        settled = c.subst(ty, inst).try();
        fitted ::= c.alloc.Vec<TyId>();
        c.fn_params(settled, fitted).try();
        (c.signature_matches(fitted, self.actuals, off).try()
            && c.callback_types_fit(
                self.call,
                params,
                off,
                self.ctx,
                inst
            ).try()).match({
            false => self.invalid_member_instantiation(c, name),
            true  => c.inst_bounds_hold(
                bounds,
                owner,
                inst,
                self.node.span
            ).try().match({
                false => c.types.unknown(),
                true  => {
                    self.inst = inst;
                    Ok(settled)
                },
            }),
        })
    }

    invalid_member_instantiation = (self: @Self, c :: Checker, name: str)
                                   Res<TyId, AllocError> {
        c.report(
            self.node.span.file,
            self.node.span,
            SemaFault.InvalidInstantiation(NameFault(name: name))
        ).try();
        c.types.unknown()
    }

    by_arity = (
        self  :: @Self,
        c     :: Checker,
        ac    : Access,
        b     : Base,
        found : Vec<Found>,
        off   : usize
    )
               Res<TyId, AllocError> {
        c.pick_arity(found, self.actuals.len + off).match({
            None  => self.first_found(c, ac, b, found, off),
            Ok(f) => self.ufcs_with_recovery(
                c,
                ac,
                b,
                Ok(RecoverySig(ty: f.ty, off: off))
            ),
        })
    }

    first_found = (
        self  :: @Self,
        c     :: Checker,
        ac    : Access,
        b     : Base,
        found : Vec<Found>,
        off   : usize
    )
                  Res<TyId, AllocError> {
        found.get(0).match({
            None  => c.types.unknown(),
            Ok(f) => self.ufcs_with_recovery(
                c,
                ac,
                b,
                Ok(RecoverySig(ty: f.ty, off: off))
            ),
        })
    }

    ufcs = (self :: @Self, c :: Checker, ac: Access, b: Base)
           Res<TyId, AllocError> {
        self.ufcs_with_recovery(c, ac, b, None)
    }

    ufcs_with_recovery = (
        self     :: @Self,
        c        :: Checker,
        ac       : Access,
        b        : Base,
        recovery : Res<RecoverySig>
    ) Res<TyId, AllocError> {
        all = self.receiver_actuals(c, b).try();
        self.decl(c, ac.name.text, Ok(b.ty), all, recovery)
    }

    receiver_actuals = (self: @Self, c: Checker, b: Base)
                       Res<Vec<Actual>, AllocError> {
        all ::= c.alloc.Vec<Actual>();
        all.add(Actual(
            ty: b.ty,
            is_lambda: false,
            arity: 0,
            named: false,
            span: self.node.span
        )).try();
        self.actuals.loop((h, a) { all.add(a).try() });
        Ok(all)
    }

    indirect = (self :: @Self, c :: Checker) Res<TyId, AllocError> {
        self.load_actuals(c).try();
        (self.call.targs.len > 0).match({
            true  => self.invalid_member_instantiation(c, ""),
            false => {
                ty = c.type_of(self.call.callee, self.ctx).try();
                self.fitted_signature(c, ty, 0)
            },
        })
    }

    fitted_signature = (self :: @Self, c :: Checker, ty: TyId, off: usize)
                       Res<TyId, AllocError> {
        params ::= c.alloc.Vec<TyId>();
        c.fn_params(ty, params).try();
        fit = c.types.at(ty).match({
            Fn(_) => c.signature_matches(params, self.actuals, off),
            _     => Ok(true),
        }).try().match({
            true  => SignatureFit.Exact,
            false => SignatureFit.Recovery(c.call_name(self.call)),
        });
        self.signature_with_params(c, ty, params, off, fit)
    }

    recovery_signature = (self :: @Self, c :: Checker, ty: TyId, off: usize)
                         Res<TyId, AllocError> {
        self.signature(
            c,
            ty,
            off,
            SignatureFit.Recovery(c.call_name(self.call))
        )
    }

    signature = (
        self :: @Self,
        c     :: Checker,
        ty    : TyId,
        off   : usize,
        fit   : SignatureFit
    ) Res<TyId, AllocError> {
        params ::= c.alloc.Vec<TyId>();
        c.fn_params(ty, params).try();
        self.signature_with_params(c, ty, params, off, fit)
    }

    signature_with_params = (
        self   :: @Self,
        c      :: Checker,
        ty     : TyId,
        params : Vec<TyId>,
        off    : usize,
        fit    : SignatureFit
    ) Res<TyId, AllocError> {
        use = SignatureUse(
            node: self.node,
            call: self.call,
            ctx: self.ctx,
            ty: ty,
            params: params,
            off: off,
            fit: fit
        );
        got = use.finish(c).try();
        fit.match({
            Exact       => {
                c.note_receiver_view(self.receiver_expr(c, off), params).try();
                self.checked_signature = Ok(CallSignature(
                    params: params,
                    receiver: self.receiver_expr(c, off)
                ));
            },
            Recovery(_) => (),
        });
        Ok(got)
    }

    instantiate_sig = (self :: @Self, c :: Checker, ty: TyId)
                      Res<TyId, AllocError> {
        c.types.at(ty).match({
            Fn(f) => {
                got ::= c.alloc.Vec<TyId>();
                self.actuals.loop((a) { got.add(a.ty).try(); });
                c.unify_list(f.params, got, self.inst).try();
                c.subst(ty, self.inst)
            },
            _     => Ok(ty),
        })
    }
}

CallCheck = (a: Alloc, id: ExprId, node: Expr, call: Call, ctx: Ctx)
            CallCheck {
    CallCheck(
        id: id,
        node: node,
        call: call,
        ctx: ctx,
        actuals: a.Vec<Actual>(),
        declaration: None,
        provider: None,
        inst: a.Inst(),
        checked_signature: None,
        body: None,
        edge: None,
        member_edge: None
    )
}

// The callee with its parentheses stripped.
call_callee* = (tree: Ast, call: Call) Expr {
    tree.call_callee_at(call.callee)
}

call_callee_at = (tree: Ast, id: ExprId) Expr {
    node = tree.expr_at(id);
    node.kind.match({
        Paren(p) => tree.call_callee_at(p.inner),
        _        => node,
    })
}

call_name = (c: Checker, call: Call) str {
    c.tree.call_callee(call).kind.match({
        Name(n)   => n.text,
        Access(a) => a.name.text,
        _         => "",
    })
}

// Check one call and record its chosen declaration and instantiation.
call_type* = (c :: Checker, id: ExprId, node: Expr, call: Call, ctx: Ctx)
             Res<TyId, AllocError> {
    c.record_call(id, CallResolution.Checking).try();
    mark = c.diag_count();
    check ::= c.alloc.CallCheck(id, node, call, ctx);
    got = check.run(c).try();
    (c.diag_count() == mark).match({
        true  => {
            check.edge.when_ok((edge) { c.note_edge(edge).try(); });
            check.member_edge.when_ok((edge) {
                c.note_member_edge(edge).try();
            });
            c.record_call(
                id,
                CallResolution.Checked(CheckedCall(
                    declaration: check.declaration,
                    member_provider: check.provider,
                    inst: check.inst,
                    result: got,
                    signature: check.checked_signature,
                    body: check.body
                ))
            )
        },
        false => c.record_call(id, CallResolution.Rejected),
    }).try();
    Ok(got)
}

actuals_of = (c :: Checker, args: Vec<Arg>, ctx: Ctx, out :: Vec<Actual>)
             Res<AllocError> {
    args.loop((h, a) {
        out.add(c.actual_of(a, ctx).try()).try();
    });
    Ok;
}

actual_of = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    c.spelled_lambda(a.value).match({
        Ok(l) => c.lambda_actual(l, a),
        None  => c.value_actual(a, ctx),
    })
}

spelled_lambda* = (c :: Checker, id: ExprId) Res<Lambda> {
    c.tree.expr_at(id).kind.match({
        Lambda(l) => Ok(l),
        Paren(p)  => c.spelled_lambda(p.inner),
        _         => None,
    })
}

is_named = (a: Arg) bool { a.name.match({ Ok(_) => true, None => false }) }

lambda_actual = (c :: Checker, l: Lambda, a: Arg) Res<Actual, AllocError> {
    poison = c.types.unknown().try();
    Ok(Actual(
        ty: poison,
        is_lambda: true,
        arity: l.params.len,
        named: a.is_named(),
        span: a.span
    ));
}

value_actual = (c :: Checker, a: Arg, ctx: Ctx) Res<Actual, AllocError> {
    ty = c.type_of(a.value, ctx).try();
    Ok(Actual(
        ty: ty,
        is_lambda: false,
        arity: 0,
        named: a.is_named(),
        span: a.span
    ));
}

print_type = (c :: Checker, call: Call) Res<TyId, AllocError> {
    call.args.loop((h, a) { c.check_arms_agree(a.value).try() });
    c.types.prim("()")
}

is_printer_name = (name: str) bool { name.eq("println") || name.eq("print") }

// A bare name another module exports is named with the import that would
// bind it; any other is undefined.
undefined_or_unimported* = (c :: Checker, at: Span, name: str)
                           Res<AllocError> {
    c.world.importable_from(name).try().match({
        Ok(module) => c.report(
            at.file,
            at,
            SemaFault.NotImported(ExportFault(name: name, module: module))
        ),
        None       => c.report(
            at.file,
            at,
            SemaFault.UndefinedName(NameFault(name: name))
        ),
    })
}

// `Ok(..)` and `Err(..)` construct a `Res` when the name resolves to
// std.core's variant: a local, a declaration, or an import of another
// module's function of the same name is called like any other function.
calls_res_ctor = (c :: Checker, name: str, mi: usize) Res<bool, AllocError> {
    (c.lookup(name).match({ Ok(_) => false, None => true })
        && (name.eq("None") == false)).match({
        false => Ok(false),
        true  => c.world.names_res_variant(c.tree, mi, name),
    })
}

// `Ok` and `Err` carry one value each, so a second argument is evaluated
// and then dropped on the floor: `Ok(41, "x")` is an `Ok(41)` that read
// the string for nothing. Only the first surplus is worth naming.
refuse_res_surplus = (c :: Checker, call: Call, name: str)
                     Res<AllocError> {
    call.args.get(1).match({
        None  => Ok,
        Ok(a) => c.report(
            a.span.file,
            a.span,
            SemaFault.ResSurplusArgument(NameFault(name: name))
        ),
    })
}

res_ctor_type = (c :: Checker, name: str, actuals: Vec<Actual>)
                Res<TyId, AllocError> {
    payload = c.first_ty(actuals).try();
    name.eq("Ok").match({
        true  => c.types.res_open(payload),
        false => c.err_res(payload),
    })
}

// Only success lifts, so `Err(e)` says nothing about the value type.
err_res = (c :: Checker, e: TyId) Res<TyId, AllocError> {
    hole = c.types.infer().try();
    c.types.res_failure(hole, e)
}

first_ty = (c :: Checker, actuals: Vec<Actual>) Res<TyId, AllocError> {
    actuals.get(0).match({
        None  => c.types.prim("()"),
        Ok(a) => Ok(a.ty),
    })
}

infer_member_inst = (
    c       :: Checker,
    ty      : TyId,
    actuals : Vec<Actual>,
    off     : usize,
    inst    :: Inst
) Res<AllocError> {
    c.types.at(ty).match({
        Fn(f) => actuals.loop((h, i, a) {
            (a.is_lambda == false).then(() {
                f.params.get(i + off).match({
                    None     => Ok,
                    Ok(want) => c.unify(want, a.ty, inst),
                }).try();
            });
        }),
        _     => (),
    });
    Ok
}

BoundFit = { BoundSatisfied | BoundUnresolved | BoundDisjoint }

first_matching = (
    site    : CallCheck,
    c       :: Checker,
    cands   : Vec<Cand>,
    actuals : Vec<Actual>
) Res<Res<Cand>, AllocError> {
    written   = site.call.targs.len;
    annotated = c.callback_annotated(site.call);
    hit      :: Res<Cand> = None;
    pending  :: Res<Cand> = None;
    rejected :: Res<Cand> = None;
    cands.loop((h, k) {
        c.candidate_compatible(k, actuals).try().then(() {
            fit = (annotated && (written == 0 || written == k.tvars.len)).match({
                true  => site.annotated_fit(c, k, actuals),
                false => (written > 0).match({
                    true  => Ok((written == k.tvars.len).match({
                        true  => BoundSatisfied,
                        false => BoundDisjoint,
                    })),
                    false => c.actual_bound_fit(k, actuals),
                }),
            }).try();
            fit.match({
                BoundSatisfied  => { hit = Ok(k); h.break(); },
                BoundUnresolved => pending.match({
                    None  => { pending = Ok(k); },
                    Ok(_) => (),
                }),
                BoundDisjoint   => rejected.match({
                    None  => { rejected = Ok(k); },
                    Ok(_) => (),
                }),
            });
        });
    });
    // A still-open lambda or type argument does not outrank a proved fit.
    // If no candidate fits, retain the ordinary bound diagnostic.
    Ok(hit.match({
        Ok(k) => Ok(k),
        None  => pending.match({ Ok(k) => Ok(k), None => rejected }),
    }));
}

// Callback annotations are candidate evidence, including for a concrete
// overload declared before its generic sibling. Use the selected-call
// inference order so literals cannot default before this evidence arrives.
annotated_fit = (site: CallCheck, c :: Checker, k: Cand, actuals: Vec<Actual>)
                Res<BoundFit, AllocError> {
    inst = c.call_inst(site.call, k, actuals, site.ctx).try();
    c.callback_types_fit(
        site.call,
        k.params,
        recv_off(site.call, actuals),
        site.ctx,
        inst
    )
        .try().match({
            false => Ok(BoundDisjoint),
            true  => c.inst_bound_fit(k, inst),
        })
}

callback_annotated = (c :: Checker, call: Call) bool {
    call.args.find((arg) {
        c.annotated_callback(arg.value).match({ Ok(_) => true, None => false })
    }).match({ Ok(_) => true, None => false })
}

// An unresolved argument is not evidence for every concrete overload. Its
// declared bounds can already rule out exact parameter types before a call
// instantiates the enclosing generic function.
candidate_compatible = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                       Res<bool, AllocError> {
    c.matches(k, actuals).try().match({
        false => Ok(false),
        true  => Ok(c.bounded_actual_excludes(k, actuals).try() == false),
    })
}

bounded_actual_excludes = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                         Res<bool, AllocError> {
    tail = k.params.get(k.params.len -% 1).match({
        Ok(t) => c.tail_swallows(t),
        None  => false,
    });
    tail.match({
        true  => Ok(false),
        false => c.fixed_bounded_actual_excludes(k, actuals),
    })
}

fixed_bounded_actual_excludes = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                               Res<bool, AllocError> {
    excluded ::= false;
    actuals.loop((h, i, a) {
        (a.is_lambda == false).then(() {
            k.params.get(i).match({
                None    => (),
                Ok(pty) => c.actual_bound_excludes(a.ty, pty).try().then(() {
                    excluded = true;
                    h.break();
                }),
            });
        });
    });
    Ok(excluded);
}

actual_bound_excludes = (c :: Checker, actual: TyId, param: TyId)
                       Res<bool, AllocError> {
    exact = c.types.at(param).match({
        Prim(_)  => true,
        Fn(_)    => true,
        Array(_) => true,
        _        => false,
    });
    // Nominal parameters may accept a bound projection; result and union
    // parameters may hoist an argument. Do not treat those as exact types.
    (exact && c.overload_concrete(param)).match({
        false => Ok(false),
        true  => c.types.at(actual).match({
            Var(v) => c.declared_bound_excludes(v.name, actual, param),
            _      => Ok(false),
        }),
    })
}

declared_bound_excludes = (c :: Checker, name: str, actual: TyId, param: TyId)
                         Res<bool, AllocError> {
    bounds ::= c.alloc.Vec<TyId>();
    c.unshadowed_tvar(name, actual).then(() {
        c.bounds_of(name, bounds).try();
    });
    excluded ::= false;
    bounds.loop((h, bound) {
        c.types.at(bound).match({
            // Direct holes compare conservatively in bound arguments.
            // Nested open types need fuller compatibility evidence.
            Named(n) => c.probeable_bound_args(n.args).then(() {
                c.concrete_bound_fit(param, bound).try().match({
                    BoundDisjoint => { excluded = true; h.break(); },
                    _             => (),
                });
            }),
            _        => (),
        });
    });
    Ok(excluded);
}

probeable_bound_args = (c: Checker, args: Vec<TyId>) bool {
    args.find((ty) {
        c.types.at(ty).match({
            Var(_)  => false,
            Unknown => false,
            Infer   => false,
            _       => c.overload_concrete(ty) == false,
        })
    }).match({ Ok(_) => false, None => true })
}

actual_bound_fit = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                   Res<BoundFit, AllocError> {
    (k.tbounds.len == 0).match({
        true  => Ok(BoundSatisfied),
        false => c.inferred_bound_fit(k, actuals),
    })
}

inferred_bound_fit = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                     Res<BoundFit, AllocError> {
    tail = k.params.get(k.params.len -% 1).match({
        Ok(t) => c.tail_swallows(t),
        None  => false,
    });
    // Explicit arguments, variadic tails, and omitted slots retain the
    // ordinary inference path rather than guessing a substitution here.
    (tail || k.params.len != actuals.len).match({
        true  => Ok(BoundUnresolved),
        false => c.fixed_actual_bound_fit(k, actuals),
    })
}

fixed_actual_bound_fit = (c :: Checker, k: Cand, actuals: Vec<Actual>)
                         Res<BoundFit, AllocError> {
    inst ::= c.alloc.Inst();
    actuals.loop((h, i, a) {
        (a.is_lambda == false).then(() {
            c.unify(k.params.ty_at(i), a.ty, inst).try();
        });
    });
    c.inst_bound_fit(k, inst)
}

// Bound-declared intrinsic methods may be lowered without an ordinary member.
no_such_method = (c :: Checker, call: Call, name: str, ty: TyId)
                 Res<TyId, AllocError> {
    c.bound_declares(ty, name).try().match({
        true  => c.types.unknown(),
        false => c.report_no_method(call, name, ty),
    })
}

report_no_method = (c :: Checker, call: Call, name: str, ty: TyId)
                   Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    at     = c.callee_name_span(call);
    c.report(
        at.file,
        at,
        SemaFault.NoSuchField(TypeFault(
            name: name,
            expected: poison,
            found: ty
        ))
    ).try();
    c.types.unknown()
}

callee_name_span = (c: Checker, call: Call) Span {
    c.tree.expr_at(call.callee).kind.match({
        Access(a) => a.name.span,
        _         => nowhere(),
    })
}

// Lambda arguments are the only legal inward path for a loop handle. Other
// arguments are checked against their settled formal types here.
args_handle_check = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<AllocError> {
    args.loop((h, i, a) {
        c.refuse_handle_argument(a, params.ty_at(i + off), ctx).try();
        c.note_bound_view(a.value, params.ty_at(i + off)).try();
    });
    Ok;
}

// A receiver is parameter zero, so a concrete receiver reaching a bound
// `self` builds a bound value exactly as an argument does.
note_receiver_view = (c :: Checker, receiver: Res<ExprId>, params: Vec<TyId>)
                     Res<AllocError> {
    receiver.match({
        None    => Ok,
        Ok(rid) => c.note_bound_view(rid, params.ty_at(0)),
    })
}

// A `::` parameter receives the argument's address, so the argument's storage
// must already have the parameter's type. An unannotated integer is stored as
// an i64 whatever a later use wants (a float as an f64), and C converts values
// between widths but not the pointers to them.
refuse_literal_lends = (
    c       :: Checker,
    k       : Cand,
    params  : Vec<TyId>,
    actuals : Vec<Actual>
) Res<AllocError> {
    c.tree.decl_at(k.id).match({
        None       => Ok,
        Ok(callee) => callee.kind.match({
            Function(f) => c.literal_lends(f, params, actuals),
            _           => Ok,
        }),
    })
}

literal_lends = (
    c       :: Checker,
    f       : Function,
    params  : Vec<TyId>,
    actuals : Vec<Actual>
) Res<AllocError> {
    actuals.loop((h, i, a) {
        lent   = f.params.get(i).match({ Ok(p) => p.mutable, None => false });
        stored = c.prim_name(a.ty).eq("int").match({ true => "i64", false => "f64" });
        wanted = params.get(i).match({ Ok(t) => c.prim_name(t), None => stored });
        (lent && c.is_literal_ty(a.ty) && !wanted.eq(stored) && !c.reported_at(a.span)).then(() {
            c.refuse(
                a.span,
                SemaFault.LiteralLent(NameFault(name: f.params.get(i).match({
                    Ok(p) => p.name.text,
                    None  => "",
                })))
            ).try();
        });
    });
    Ok;
}

// Type each lambda body once, after resolution supplies its parameter types.
arg_lambdas = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<AllocError> {
    args.loop((h, i, a) {
        c.spelled_lambda(a.value).match({
            Ok(l) => c.lambda_body(a.value, l, params.ty_at(i + off), ctx),
            None  => c.types.unknown(),
        }).try();
    });
    Ok;
}

// `arg_lambdas` for a generic callee. A type parameter that only a
// callback's result mentions -- `T` in `then<T>(b: bool, f: () T) Res<T>` --
// has no argument to be inferred from until the callback's body is typed,
// so each body's type is unified with its callback's declared result here.
// Left open, `Res<T>` would agree with every other type: a match whose arms
// were `.then(() { println(..) })` and `Range(..).loop(..)` passed the arm
// check, and cc then refused to assign one arm's result to the other's.
arg_lambdas_settling = (
    c        :: Checker,
    args     : Vec<Arg>,
    params   : Vec<TyId>,
    declared : Vec<TyId>,
    off      : usize,
    ctx      : Ctx,
    inst     :: Inst
) Res<AllocError> {
    args.loop((h, i, a) {
        c.spelled_lambda(a.value).match({
            None  => (),
            Ok(l) => {
                got  = c.lambda_body(
                    a.value,
                    l,
                    params.ty_at(i + off),
                    ctx
                ).try();
                body = c.one_value(c.tree.block_at(l.body)).match({
                    true  => got,
                    false => c.types.prim("()").try(),
                });
                c.settle_callback_ret(
                    declared.ty_at(i + off),
                    body,
                    inst
                ).try();
            },
        });
    });
    Ok;
}

// Only a body type with nothing left to decide binds. A body that is a bare
// literal (`() { 7 }`) has no context but the callee's instance, which the
// backend lowers at the literal's default width, so it binds as that width;
// left a literal family, a local holding the result would default it again,
// differently. A type variable of the enclosing generic body is settled per
// emission by the backend, and stays open here.
settle_callback_ret = (c :: Checker, declared: TyId, got: TyId, inst :: Inst)
                      Res<AllocError> {
    body = c.is_literal_ty(got).match({
        true  => c.types.prim(literal_default(c.prim_name(got))).try(),
        false => got,
    });
    c.decided(body).match({
        false => Ok,
        true  => c.types.at(declared).match({
            Fn(f) => c.unify(f.ret, body, inst),
            _     => Ok,
        }),
    })
}

decided = (c: Checker, ty: TyId) bool {
    (c.is_unknown(ty) || c.is_infer(ty) || c.is_literal_ty(ty)) == false
        && c.types.at(ty).match({
            Var(_)   => false,
            Named(n) => c.all_decided(n.args),
            Res(r)   => c.decided(r.value) && c.decided(r.error),
            Fn(f)    => c.all_decided(f.params) && c.decided(f.ret),
            Union(u) => c.all_decided(u.members),
            Array(a) => c.decided(a.elem),
            _        => true,
        })
}

all_decided = (c: Checker, list: Vec<TyId>) bool {
    list.find((t) { c.decided(t) == false }).match({
        Ok(_) => false,
        None  => true,
    })
}

// The closure keeps the enclosing return context: `.try()` inside it
// returns from the enclosing function. Answers the body's type.
lambda_body = (c :: Checker, id: ExprId, l: Lambda, sig: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    ptys ::= c.alloc.Vec<TyId>();
    c.fn_params(sig, ptys).try();
    smark = c.mark();
    tmark = c.tvar_mark();
    c.push_tparams(l.tparams, c.module_name(ctx.module)).try();
    c.resolve_lambda_inst(id, l, sig, ptys, ctx).try();
    l.params.loop((h, i, p) {
        ty = c.lambda_param(p, ptys, i, ctx).try();
        c.bind(p.name.text, ty, p.mutable, true).try();
    });
    body = c.block_type(l.body, ctx).try();
    c.lambda_dropped_tail(id, l, sig, body).try();
    c.release_tvars(tmark).try();
    c.release(smark).try();
    // A generic lambda's body type names its own parameters, which mean
    // nothing to the call it is passed to.
    (l.tparams.len == 0).match({
        true  => Ok(body),
        false => c.types.unknown(),
    })
}

// A unit closure drops its tail; a closure returning the callee's type
// parameter hands it to the call's result.
lambda_dropped_tail = (
    c   :: Checker,
    id  : ExprId,
    l   : Lambda,
    sig : TyId,
    got : TyId
) Res<AllocError> {
    c.types.at(sig).match({
        Fn(f) => c.tail_expr(c.tree.block_at(l.body)).match({
            Ok(e) => c.is_var(f.ret).match({
                true  => c.note_lambda_tail(id, e, got),
                false => c.check_dropped_tail(e, got, f.ret),
            }),
            None  => Ok,
        }),
        _     => Ok,
    })
}

resolve_lambda_inst = (
    c    :: Checker,
    id   : ExprId,
    l    : Lambda,
    sig  : TyId,
    ptys : Vec<TyId>,
    ctx  : Ctx
) Res<AllocError> {
    inst ::= c.alloc.Inst();
    l.params.loop((h, i, p) {
        p.type.match({
            Ok(_) => c.unify(c.param_type(p, ctx).try(), ptys.ty_at(i), inst),
            None  => Ok,
        }).try();
    });
    c.types.at(sig).match({
        Fn(f) => l.ret.match({
            Ok(r) => c.unify(c.type_from_ast(r, ctx).try(), f.ret, inst),
            None  => Ok,
        }),
        _     => Ok,
    }).try();
    (inst.len() > 0).then(() { c.record_lambda_inst(id, inst).try(); });
    Ok
}

lambda_param = (c :: Checker, p: Param, ptys: Vec<TyId>, i: usize, ctx: Ctx)
               Res<TyId, AllocError> {
    p.type.match({
        Ok(_) => c.param_type(p, ctx),
        None  => c.sig_param(ptys, i),
    })
}

// Lowering cannot emit an unsubstituted parameter type; a parameter the
// call signature has not settled is poison.
sig_param = (c :: Checker, ptys: Vec<TyId>, i: usize) Res<TyId, AllocError> {
    ptys.get(i).match({
        None   => c.types.unknown(),
        Ok(ty) => c.settled_param(ty).match({
            true  => Ok(ty),
            false => c.types.unknown(),
        }),
    })
}

// UFCS actuals include the receiver; written arguments do not.
recv_off = (call: Call, actuals: Vec<Actual>) usize {
    actuals.len - call.args.len
}

arg_literals = (
    c      :: Checker,
    args   : Vec<Arg>,
    params : Vec<TyId>,
    off    : usize,
    ctx    : Ctx
) Res<AllocError> {
    args.loop((h, i, a) {
        c.param_literal(a.value, params, i + off, ctx).try();
    });
    Ok;
}

// Variadic arguments beyond the declared prefix have no expected type.
param_literal = (
    c      :: Checker,
    id     : ExprId,
    params : Vec<TyId>,
    i      : usize,
    ctx    : Ctx
) Res<AllocError> {
    (i < params.len).match({
        false => c.check_arms_agree(id),
        true  => c.param_wants(id, params.ty_at(i), ctx),
    })
}

param_wants = (c :: Checker, id: ExprId, want: TyId, ctx: Ctx)
              Res<AllocError> {
    got = c.type_of(id, ctx).try();
    c.hoist_at(id, got, want).try();
    c.check_literal(id, want).try();
    c.settled_param(want).match({
        true  => c.check_arms(id, want),
        false => c.check_arms_agree(id),
    })
}

numeric_literal_context = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Prim(p)  => is_integer(p.name),
        Array(a) => c.numeric_literal_context(a.elem),
        _        => false,
    })
}

settled_param = (c: Checker, want: TyId) bool {
    (c.is_var(want) || c.is_infer(want) || c.is_unknown(want)) == false
}

actor_consumed_argument = (c: Checker, id: ExprId) bool {
    c.tree.expr_at(id).kind.match({
        Consume(_) => true,
        Paren(p)   => c.actor_consumed_argument(p.inner),
        _          => false,
    })
}

refuse_actor_payloads = (
    c       :: Checker,
    recv    : TyId,
    actuals : Vec<Actual>,
    call    : Call
)
                         Res<AllocError> {
    c.ref_of_actor(recv).try().match({
        None  => Ok,
        Ok(_) => {
            actuals.loop((h, i, a) {
                transferred = c.actor_byte_buffer(a.ty) && call.args.get(i).match({
                    None    => false,
                    Ok(arg) => c.actor_consumed_argument(arg.value),
                });
                (!transferred && c.actor_payload_unsafe(a.ty).try()).then(() {
                    spelling = c.types.name_of(a.ty).try();
                    c.report(
                        a.span.file,
                        a.span,
                        SemaFault.ActorPayload(NameFault(name: spelling.view()))
                    ).try();
                });
            });
            Ok
        },
    })
}

// First member whose declared parameters accept these arguments. Duplicate
// matching signatures are diagnosed at their declarations.
pick_fitting = (
    c       :: Checker,
    found   : Vec<Found>,
    actuals : Vec<Actual>,
    off     : usize
)
               Res<Res<Found>, AllocError> {
    hit :: Res<Found> = None;
    found.loop((h, f) {
        c.found_fits(f, actuals, off).try().then(() {
            hit.match({
                None  => { hit = Ok(f); },
                Ok(_) => {},
            });
        });
    });
    Ok(hit)
}

found_fits = (
    c       :: Checker,
    f       : Found,
    actuals : Vec<Actual>,
    off     : usize
) Res<bool, AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(f.ty, params).try();
    c.sig_fits(params, actuals, off)
}

// A member that is not a function has no parameters and fits no call.
fn_params = (c :: Checker, ty: TyId, out :: Vec<TyId>)
            Res<AllocError> {
    c.types.at(ty).match({
        Fn(f) => f.params.copy_tys(out),
        _     => Ok,
    })
}

copy_tys = (xs: Vec<TyId>, out :: Vec<TyId>) Res<AllocError> {
    xs.loop((h, x) { out.add(x).try() });
    Ok;
}

pick_arity = (c: Checker, found: Vec<Found>, want: usize) Res<Found> {
    found.find((f) {
        c.types.at(f.ty).match({ Fn(g) => g.params.len == want, _ => false })
    })
}

// Indirect calls use their settled signature for handle checks. Calls through
// local closures are inlined, so loop handles may travel through them.
sig_args_handle_check = (
    c    :: Checker,
    node : Expr,
    call : Call,
    ty   : TyId,
    off  : usize,
    ctx  : Ctx
) Res<AllocError> {
    spliced = c.tree.expr_at(call.callee).kind.match({
        Name(n) => c.lookup(n.text).match({
            Ok(_) => true,
            None  => false,
        }),
        _       => false,
    });
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(ty, params).try();
    spliced.match({
        // A loop handle may travel through an inlined closure, but a
        // concrete value it turns into a bound value is a view all the same.
        true  => {
            call.args.loop((h, i, a) {
                c.note_bound_view(a.value, params.ty_at(i + off)).try();
            });
            Ok
        },
        false => c.args_handle_check(call.args, params, off, ctx),
    })
}

sig_lambdas = (c :: Checker, call: Call, ty: TyId, off: usize, ctx: Ctx)
              Res<AllocError> {
    params ::= c.alloc.Vec<TyId>();
    c.fn_params(ty, params).try();
    c.arg_lambdas(call.args, params, off, ctx)
}

fn_ret = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Fn(f)   => Ok(f.ret),
        Unknown => Ok(ty),
        Infer   => Ok(ty),
        _       => c.not_callable(node, ty),
    })
}

not_callable = (c :: Checker, node: Expr, ty: TyId) Res<TyId, AllocError> {
    poison = c.types.unknown().try();
    c.report(
        node.span.file,
        node.span,
        SemaFault.NotCallable(TypeFault(name: "", expected: poison, found: ty))
    ).try();
    c.types.unknown()
}

check_overloads* = (c :: Checker, mi: usize, name: str)
                   Res<AllocError> {
    cands ::= c.alloc.Vec<Cand>();
    c.cands_of(mi, name, cands).try();
    cands.loop((h, i, a) {
        Range(i + 1, cands.len).loop((h2, j) {
            cands.get(j).match({
                None  => Ok,
                Ok(b) => c.compare(name, a, b),
            }).try();
        });
    });
    Ok;
}

compare = (c :: Checker, name: str, a: Cand, b: Cand) Res<AllocError> {
    (a.params.len == b.params.len).match({
        false => c.optional_overlap(a, b).match({
            true  => c.ambiguous(name, a, b),
            false => Ok,
        }),
        true  => c.same_signature(a, b).match({
            true  => c.duplicate(name, a, b),
            false => c.maybe_swallow(name, a, b),
        }),
    })
}

same_signature = (c: Checker, a: Cand, b: Cand) bool {
    c.same_params(a.params, b.params)
}

// Different declarations may still accept the same call when the longer
// signature ends in optional parameters.
optional_overlap = (c: Checker, a: Cand, b: Cand) bool {
    (a.params.len < b.params.len).match({
        true  => c.cand_prefix_overlaps(a, b, a.params.len)
                    && c.omittable_tail(b.params, a.params.len),
        false => c.cand_prefix_overlaps(a, b, b.params.len)
                    && c.omittable_tail(a.params, b.params.len),
    })
}

cand_prefix_overlaps = (c: Checker, a: Cand, b: Cand, n: usize) bool {
    Range(0, n).find((i) {
        x = a.params.ty_at(i);
        y = b.params.ty_at(i);
        (c.eats(x, y, a.owner) || c.eats(y, x, b.owner)) == false
    }).match({ Ok(_) => false, None => true })
}

prefix_same = (c: Checker, short: Vec<TyId>, long: Vec<TyId>) bool {
    Range(0, short.len).find((i) {
        c.same_param(short.ty_at(i), long.ty_at(i)) == false
    }).match({ Ok(_) => false, None => true })
}

// Members do not become `Cand`s, but overload identity is still their
// parameter list; a return type cannot distinguish a call.
same_fn_signature* = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Fn(x) => c.types.at(b).match({
            Fn(y) => c.same_params(x.params, y.params),
            _     => false,
        }),
        _     => false,
    })
}

fn_signatures_overlap* = (c: Checker, a: TyId, b: TyId) bool {
    c.types.at(a).match({
        Fn(x) => c.types.at(b).match({
            Fn(y) => (x.params.len != y.params.len) && (
                (x.params.len < y.params.len).match({
                    true  => c.prefix_same(x.params, y.params)
                                && c.omittable_tail(y.params, x.params.len),
                    false => c.prefix_same(y.params, x.params)
                                && c.omittable_tail(x.params, y.params.len),
                })
            ),
            _     => false,
        }),
        _     => false,
    })
}

same_params = (c: Checker, a: Vec<TyId>, b: Vec<TyId>) bool {
    (a.len == b.len) && Range(0, a.len).find((i) {
        c.same_param(a.ty_at(i), b.ty_at(i)) == false
    }).match({ Ok(_) => false, None => true })
}

same_param = (c: Checker, x: TyId, y: TyId) bool {
    x.eq(y) || (c.is_tvar(x) && c.is_tvar(y))
}

maybe_swallow = (c :: Checker, name: str, a: Cand, b: Cand)
                Res<AllocError> {
    c.swallows(a, b).try().match({
        true  => c.ambiguous(name, a, b),
        false => Ok,
    })
}

swallows = (c :: Checker, a: Cand, b: Cand) Res<bool, AllocError> {
    first  = c.all_eat(a, b).try();
    second = c.all_eat(b, a).try();
    Ok(first || second)
}

all_eat = (c :: Checker, g: Cand, k: Cand) Res<bool, AllocError> {
    (g.generic && c.all_eats(g.params, k.params, g.owner)).match({
        false => Ok(false),
        true  => c.bounds_disjoint(g, k).try().match({
            true  => Ok(false),
            false => Ok(true),
        }),
    })
}

// Structural swallowing is only a possible overlap: a concrete argument
// must also satisfy the generic declaration's bounds. Unresolved types keep
// the conservative overlap answer. Bound lookup preserves real declaration
// diagnostics and restores the caller's type-parameter scope.
bounds_disjoint = (c :: Checker, g: Cand, k: Cand) Res<bool, AllocError> {
    inst ::= c.alloc.Inst();
    c.unify_list(g.params, k.params, inst).try();
    Ok(c.inst_bound_fit(g, inst).try().match({
        BoundDisjoint => true,
        _             => false,
    }));
}

inst_bound_fit = (c :: Checker, g: Cand, inst: Inst) Res<BoundFit, AllocError> {
    fit ::= BoundSatisfied;
    g.tbounds.loop((h, tb) {
        var = c.types.var(tb.name, g.owner).try();
        one = inst.lookup(var).match({
            None       => Ok(BoundUnresolved),
            Ok(actual) => c.substituted_bound_fit(actual, tb.bound, inst),
        }).try();
        one.match({
            BoundSatisfied  => (),
            BoundUnresolved => { fit = BoundUnresolved; },
            BoundDisjoint   => { fit = BoundDisjoint; h.break(); },
        });
    });
    Ok(fit);
}

substituted_bound_fit = (c :: Checker, actual: TyId, bound: TyId, inst: Inst)
                        Res<BoundFit, AllocError> {
    settled  = c.is_literal_ty(actual).match({
        true  => c.types.prim(c.prim_name(actual).literal_default()),
        false => Ok(actual),
    }).try();
    expected = c.subst(bound, inst).try();
    (c.overload_concrete(settled) && c.overload_concrete(expected)).match({
        true  => c.concrete_bound_fit(settled, expected),
        false => Ok(BoundUnresolved),
    })
}

overload_concrete = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Prim(_)  => true,
        Var(_)   => false,
        Unknown  => false,
        Infer    => false,
        Named(n) => c.overload_concretes(n.args),
        Fn(f)    => c.overload_concretes(f.params) && c.overload_concrete(f.ret),
        Res(r)   => c.overload_concrete(r.value) && c.overload_concrete(r.error),
        Union(u) => c.overload_concretes(u.members),
        Array(a) => c.overload_concrete(a.elem),
    })
}

overload_concretes = (c: Checker, tys: Vec<TyId>) bool {
    tys.find((ty) { c.overload_concrete(ty) == false }).match({
        Ok(_) => false,
        None  => true,
    })
}

concrete_bound_fit = (c :: Checker, actual: TyId, bound: TyId)
                     Res<BoundFit, AllocError> {
    tmark   = c.tvar_mark();
    dmark   = c.diag_count();
    checked = c.satisfies_bound(actual, bound);
    c.release_tvars(tmark).try();
    holds = checked.try();
    // Resolving an invalid impl can report a real declaration error and
    // memoize poison. Keep both for ordinary checking; poison proves no
    // disjointness and must not make a candidate preferred.
    (c.diag_count() != dmark).match({
        true  => Ok(BoundUnresolved),
        false => Ok(holds.match({
            true  => BoundSatisfied,
            false => BoundDisjoint,
        })),
    })
}

eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.var_of(x, owner) || x.eq(y) || c.structural_eats(x, y, owner)
}

var_of = (c: Checker, x: TyId, owner: str) bool {
    c.types.at(x).match({ Var(v) => v.owner.eq(owner), _ => false })
}

structural_eats = (c: Checker, x: TyId, y: TyId, owner: str) bool {
    c.types.at(x).match({
        Fn(f)    => c.fn_eats(f, y, owner),
        Named(n) => c.named_eats(n, y, owner),
        _        => false,
    })
}

fn_eats = (c: Checker, f: TyFn, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Fn(g) => (f.params.len == g.params.len)
                     && c.all_eats(f.params, g.params, owner)
                     && c.eats(f.ret, g.ret, owner),
        _     => false,
    })
}

named_eats = (c: Checker, n: TyNamed, y: TyId, owner: str) bool {
    c.types.at(y).match({
        Named(m) => n.decl.eq(m.decl) && (n.args.len == m.args.len)
                        && c.all_eats(n.args, m.args, owner),
        _        => false,
    })
}

all_eats = (c: Checker, xs: Vec<TyId>, ys: Vec<TyId>, owner: str) bool {
    Range(0, xs.len).find((i) {
        c.eats(xs.ty_at(i), ys.ty_at(i), owner) == false
    }).match({ Ok(_) => false, None => true })
}

duplicate = (c :: Checker, name: str, a: Cand, b: Cand) Res<AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.DuplicateSignature(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}

ambiguous = (c :: Checker, name: str, a: Cand, b: Cand) Res<AllocError> {
    c.report(
        a.span.file,
        a.span,
        SemaFault.AmbiguousOverload(PairFault(
            name: name,
            first: a.span,
            second: b.span
        ))
    )
}

// The function a struct or enum body declares under `name`, for its
// parameter list.
member_fn* = (c: Checker, ty: TyId, name: str, at: Span) Res<Function> {
    c.types.at(ty).match({
        Named(n) => c.tree.decl_at(n.decl).match({
            Ok(decl) => decl.body_members().match({
                Ok(members) => members.find((m) {
                    m.named(name) && member_span_eq(m.span, at)
                }).match({
                    Ok(m) => m.kind.match({
                        Function(fn) => Ok(fn),
                        _            => None,
                    }),
                    None  => None,
                }),
                None        => None,
            }),
            None     => None,
        }),
        _        => None,
    })
}

member_span_eq = (a: Span, b: Span) bool {
    a.file.eq(b.file)
        && (a.start.line == b.start.line)
        && (a.start.col == b.start.col)
        && (a.end.line == b.end.line)
        && (a.end.col == b.end.col)
}

// An own member of a named receiver; `sema_instance` keeps the settled ones.
member_edge = (
    c    : Checker,
    ac   : Access,
    f    : Found,
    sig  : TyId,
    inst : Inst,
    at   : Span
) Res<MemberEdge> {
    c.types.at(f.decl_owner).match({
        Named(n) => Ok(MemberEdge(
            decl: n.decl,
            name: ac.name.text,
            decl_span: f.decl_span,
            self_ty: f.decl_owner,
            sig: sig,
            inst: inst,
            span: at,
        )),
        _        => None,
    })
}
