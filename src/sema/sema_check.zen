{ Ast, ExprId, TypeId, BlockId } = std.ast
{ Span } = std.source
{ nowhere } = std.source
{ BinOp, Unary, Binary, Access, TParam } = std.ast
{ Alloc, AllocError } = std.mem
{ Vec, Map } = std.collections
{ str, String } = std.text
{ Res, Ok, None, loop, Range } = std.core
{ DeclId } = sema.sema_id
{ TyId, Types, ResForm, TyRes, TyNamed, TyArray, StdDecls } = sema.sema_ty
{ is_integer, is_float } = sema.sema_ty
{ World, ImportBinding, Def, ModuleTable } = sema.sema_def
{ module_display } = sema.sema_def
{ Diag, SemaFault, TypeFault } = sema.sema_diag
{ ExportFault, PairFault } = sema.sema_diag
{ Inst, InstEdge } = sema.sema_inst
{ DiscriminantCall } = sema.sema_discriminant
{ VariantNameCall } = sema.sema_variant_name
{ NumericConversion, IntegerBitOperation } = sema.sema_numeric
{ Primitive } = sema.sema_prim
{ Printer, IO_MODULE, printer_named } = sema.sema_print
{ OwnCheck, StoreEffects } = sema.sema_store
{ owning_copy_unsafe, mailbox_payload_unsafe, mailbox_byte_buffer } = sema.sema_copy
{ decl_at } = sema.sema_def

// One scoped name. Mutability feeds receiver/ownership checks, param feeds LSP
// classification, and span identifies the original binding in diagnostics.
// `deferred` marks a local declared `x :: T;` or `x: T;`: its first
// assignment is a write to it, never a second binding of the name.
Binding* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    param*: bool,
    span*: Span,
    deferred*: bool,
    // The value of an immutable binding of an untyped integer literal
    // (`big = 3000000000`). Its type is still the literal's, so each use
    // checks this value against the type the use wants.
    held* :: Res<i64> = None,
}

// Binders for the active @meta field walk. Parameter spans distinguish the
// original binders from shadowing declarations; field is the current field.
WalkBind* = {
    h_name*: str,
    h_span*: Span,
    f_name*: str,
    f_span*: Span,
    field*: str,
}

// Query context not encoded in a node id: module, @Self, and enclosing return.
// Closures inherit return context because try may return through their caller.
Ctx* = {
    module*: usize,
    ret*: TyId,
    has_ret*: bool,
    self_ty*: TyId,
    has_self*: bool,
}

// A failure nothing reads, and where it was produced.
Dropped* = {
    at*: Span,
    ty*: TyId,
}

// Parameter order includes the implicit receiver when one is present.
CallSignature* = {
    params*: Vec<TyId>,
    receiver*: Res<ExprId>,
}

// One successful call check. Types can still mention the enclosing generic
// parameters; specialization substitutes them without changing these facts.
// All vectors borrow the checker's caller-chosen allocation lifetime.
CheckedCall* = {
    declaration*: Res<DeclId>,
    member_provider*: Res<TyId>,
    inst*: Inst,
    result*: TyId,
    signature*: Res<CallSignature>,
    body*: Res<BlockId>,
}

// An absent entry has no recorded call check. In-progress and
// rejected calls expose no selection, including after a contextual recheck.
CallResolution* = { Checking | Rejected | Checked: CheckedCall }

Checker* = {
    tree*: Ast,
    world* :: World,
    types* :: Types,
    diags :: Vec<Diag>,
    // Closures whose tail failure their call returns, by closure id.
    lambda_failures :: Map<ExprId, Dropped>,
    // Every reported diagnostic, rendered, so a repeat is dropped.
    reported :: Map<str, bool>,

    // Query results keyed by stable AST node ids.
    expr_memo* :: Map<ExprId, TyId>,
    type_memo* :: Map<TypeId, TyId>,
    // Written types successfully resolved in any context during this check.
    // This records classification only; it is never a cache of a Self type.
    resolved_types :: Vec<bool>,
    resolved_type_decls* :: Map<TypeId, DeclId>,

    // Successful `@meta(name: Type).name` folds, keyed by the written type.
    meta_memo* :: Map<TypeId, str>,

    // Successful field-count folds, also keyed by the written type.
    meta_count_memo* :: Map<TypeId, usize>,

    // Field-walk calls and the names each call unrolls over.
    meta_walks* :: Map<ExprId, Vec<str>>,

    // Accesses that read the current field walk's `field.name`.
    meta_name_reads* :: Map<ExprId, bool>,

    // Calls that project `recv.at(field)` in a field walk.
    meta_projs* :: Map<ExprId, bool>,

    // Active field-walk binder. Nested walks are rejected.
    walk_stack :: Vec<WalkBind>,

    // Field currently lowered by the backend for an unrolled walk pass.
    walk_now :: Vec<str>,

    // Nonzero while a field-walk body is rechecked with per-field types.
    meta_recheck :: usize,

    // Bound or declaration that supplied a field read.
    supply_memo* :: Map<ExprId, TyId>,

    calls :: Map<ExprId, CallResolution>,

    own_checks* :: Vec<OwnCheck>,
    store_effects* :: StoreEffects,

    // Validated standard numeric operations, keyed by declaration identity.
    numeric_conversions* :: Map<DeclId, NumericConversion>,
    integer_bits* :: Map<DeclId, IntegerBitOperation>,
    // Validated machine primitives (wide multiply, truncation, vectors).
    primitives* :: Map<DeclId, Primitive>,
    // Validated std.io printers (`println`, `print`).
    printers* :: Map<DeclId, Printer>,
    // Literal-only bitwise expressions and whether an expected unsigned type
    // has given them a width. See `sema_trap.defer_width`.
    bit_widths* :: Map<ExprId, bool>,

    // Compiler-provided represented-enum conversions.
    discriminant_calls* :: Map<ExprId, DiscriminantCall>,

    // Compiler-provided enum variant-name reflection.
    variant_name_calls* :: Map<ExprId, VariantNameCall>,

    // Name expressions that resolve to formal parameters.
    param_memo* :: Map<ExprId, bool>,

    // Access expressions used as a call's callee rather than as values.
    callee_access* :: Map<ExprId, bool>,

    // Contextual substitutions for lambda expressions, separate from calls.
    lambda_insts :: Map<ExprId, Inst>,

    // Arguments whose concrete value reaches a bound-typed parameter or
    // field. The backend builds the bound value over the argument's
    // address, so the ownership walk treats the result as a view of that
    // storage: `true` when it is this frame's (`sema_scope`, bound values),
    // `false` when it is a `::` parameter's, which the caller owns.
    bound_views* :: Map<ExprId, bool>,

    // `sema_copy.carries_bound`, once per type.
    carrier_memo* :: Map<TyId, bool>,

    // Instantiation edges in resolution order.
    edges :: Vec<InstEdge>,

    owner_now :: str = "",

    set_memo* :: Map<TyId, TyId>,

    raised :: Vec<TyId>,

    // Scoped bindings share a flat stack; marks identify frame boundaries.
    locals :: Vec<Binding>,

    block_base :: usize,

    tvars :: Vec<Binding>,
    bounds :: Vec<Binding>,

    // The declaration of every type parameter met so far, so a written
    // `Res<T>` can ask what `T`'s own bounds say without depending on which
    // bounds happen to be in scope while it is read.
    tparam_decls* :: Map<TyId, TParam>,

    // Set when the program already failed to lex or parse. A body the
    // parser had to cut short has no tail worth reporting as missing.
    syntax_faults* :: bool = false,

    after_syntax_faults* = (self :: @Self) { self.syntax_faults = true; }

    alloc*: Alloc,

    // -----------------------------------------------------------------
    // what came out
    // -----------------------------------------------------------------

    saved_bindings* = (self: @Self) Res<Vec<Binding>, AllocError> {
        self.locals.map(self.alloc, (binding) { binding })
    }

    use_bindings* = (self :: @Self, bindings: Vec<Binding>) {
        self.locals = bindings;
    }

    diag_count* = (self: @Self) usize { self.diags.len }

    diag_at* = (self: @Self, i: usize) Res<Diag> { self.diags.get(i) }

    // Whether a diagnostic already starts where `span` does: a second rule
    // reaching the same mistake stays silent.
    reported_at* = (self: @Self, span: Span) bool {
        self.diags.find((d) {
            d.file.eq(span.file) && d.span.start.line == span.start.line
                && d.span.start.col == span.start.col
        }).match({ Ok(_) => true, None => false })
    }

    type_store* = (self: @Self) Types { self.types }

    // Observations survive later queries in contexts where the type is unknown.
    type_was_resolved* = (self: @Self, id: TypeId) bool {
        self.resolved_types.get(id.index.to_usize()).value_or(false)
    }

    note_resolved_type* = (self :: @Self, id: TypeId) Res<AllocError> {
        index = id.index.to_usize();
        (index >= self.resolved_types.len).then(() {
            end = index + 1;
            self.resolved_types.reserve(end - self.resolved_types.len).try();
            loop(() { self.resolved_types.len < end }, (h) {
                self.resolved_types.add(false).try();
            });
        });
        // Growth initializes every slot before this indexed write.
        self.resolved_types.ptr().write(index, true);
    }

    call_resolution* = (self: @Self, id: ExprId) Res<CallResolution> {
        self.calls.get(id)
    }

    checked_call* = (self: @Self, id: ExprId) Res<CheckedCall> {
        self.calls.get(id).try().match({
            Checked(call) => Ok(call),
            _             => None,
        })
    }

    record_call* = (self :: @Self, id: ExprId, resolution: CallResolution)
                   Res<AllocError> {
        self.calls.set(id, resolution)
    }

    resolved_call* = (self: @Self, id: ExprId) Res<DeclId> {
        self.checked_call(id).try().declaration
    }

    // The std.io printer a call selected, and `None` for every other call.
    printer_call* = (self: @Self, id: ExprId) Res<Printer> {
        self.printer_of(self.resolved_call(id).try())
    }

    // The printer a declaration is. `check_all` validates std.io's bodyless
    // declarations and records them; a tree lowered without that pass still
    // finds them by the same identity, the declaring module and the name.
    printer_of* = (self: @Self, did: DeclId) Res<Printer> {
        self.printers.get(did).match({
            Ok(how) => Ok(how),
            None    => self.world.module_name(did).eq(IO_MODULE).match({
                false => None,
                true  => self.tree.decl_at(did).try().kind.match({
                    Function(f) => printer_named(f.name.text),
                    _           => None,
                }),
            }),
        })
    }

    resolved_member_provider* = (self: @Self, id: ExprId) Res<TyId> {
        self.checked_call(id).try().member_provider
    }

    // Copy and transfer facts about a settled type. The rules live in
    // sema_copy; these are the published questions a lowering asks once a
    // generic body is instantiated, since only then is a `Ptr<T>` element or
    // an actor argument concrete. Sema answers the same questions for the
    // written types, so a lowering never re-derives who owns what.

    // Copying a value of `ty` by bytes would duplicate a Drop owner.
    contains_drop* = (self :: @Self, ty: TyId) Res<bool, AllocError> {
        self.owning_copy_unsafe(ty)
    }

    // A mailbox copy of `ty` would share memory the sender still owns.
    actor_payload_unsafe* = (self :: @Self, ty: TyId) Res<bool, AllocError> {
        self.mailbox_payload_unsafe(ty)
    }

    // `ty` is the one container a mailbox transfers by ownership: `Vec<u8>`.
    actor_byte_buffer* = (self: @Self, ty: TyId) bool {
        self.mailbox_byte_buffer(ty)
    }

    mark_discriminant_call* = (
        self :: @Self,
        id   : ExprId,
        call : DiscriminantCall
    ) Res<AllocError> {
        self.discriminant_calls.set(id, call)
    }

    discriminant_call_of* = (self: @Self, id: ExprId)
                            Res<DiscriminantCall> {
        self.discriminant_calls.get(id)
    }

    mark_variant_name_call* = (
        self :: @Self,
        id   : ExprId,
        call : VariantNameCall
    ) Res<AllocError> {
        self.variant_name_calls.set(id, call)
    }

    variant_name_call_of* = (self: @Self, id: ExprId)
                            Res<VariantNameCall> {
        self.variant_name_calls.get(id)
    }

    // The text an `@meta(...).name` access folded to for this written
    // type, if it folded. A miss means the ordinary lowering applies.
    meta_str* = (self: @Self, t: TypeId) Res<str> {
        self.meta_memo.get(t)
    }

    // The count an `@meta(...).fields().len` chain folded to. A miss
    // means the ordinary lowering applies.
    meta_count_of* = (self: @Self, t: TypeId) Res<usize> {
        self.meta_count_memo.get(t)
    }

    // The field names an `@meta(..).fields().loop(..)` walk unrolls
    // over, in declaration order, if the call is one. A miss means the
    // ordinary lowering applies.
    meta_walk_of* = (self: @Self, id: ExprId) Res<Vec<str>> {
        self.meta_walks.get(id)
    }

    // Whether this access is a walk's `field.name` fold. Presence IS
    // the answer; a miss means the ordinary member path.
    meta_name_read* = (self: @Self, id: ExprId) bool {
        self.meta_name_reads.get(id).match({ Ok(_) => true, None => false })
    }

    // Whether this call is a walk's `recv.at(field)` projection.
    meta_proj* = (self: @Self, id: ExprId) bool {
        self.meta_projs.get(id).match({ Ok(_) => true, None => false })
    }

    // The active walk's binder row, while sema checks a pass. A miss
    // means no walk is being checked.
    walk_row* = (self: @Self) Res<WalkBind> {
        self.walk_stack.len.match({
            0 => None,
            n => self.walk_stack.get(n - 1),
        })
    }

    push_walk* = (self :: @Self, b: WalkBind) Res<AllocError> {
        self.walk_stack.add(b)
    }

    pop_walk* = (self :: @Self) {
        self.walk_stack.take(self.walk_stack.len - 1);
    }

    // The field the backend is lowering a pass for, pushed once per
    // unrolled block. A miss means no walk is being lowered.
    push_walk_now* = (self :: @Self, name: str) Res<AllocError> {
        self.walk_now.add(name)
    }

    pop_walk_now* = (self :: @Self) {
        self.walk_now.take(self.walk_now.len - 1);
    }

    walk_field_now* = (self: @Self) Res<str> {
        self.walk_now.len.match({
            0 => None,
            n => self.walk_now.get(n - 1),
        })
    }

    // The re-check depth, as a predicate: true while a walk's body is
    // being checked once per field, which is when `type_of` must not
    // answer from the memo.
    rechecking* = (self: @Self) bool { self.meta_recheck > 0 }

    enter_recheck* = (self :: @Self) {
        self.meta_recheck = self.meta_recheck + 1;
    }

    leave_recheck* = (self :: @Self) {
        self.meta_recheck = self.meta_recheck - 1;
    }


    meta_count_type* = (self :: @Self) Res<TyId, AllocError> {
        self.types.prim("usize")
    }

    resolved_inst* = (self: @Self, id: ExprId) Res<Inst> {
        self.checked_call(id).match({
            Ok(call) => {
                (call.inst.len() > 0).ensure().try();
                Ok(call.inst)
            },
            None     => self.lambda_insts.get(id),
        })
    }

    record_lambda_inst* = (self :: @Self, id: ExprId, inst: Inst)
                          Res<AllocError> {
        self.lambda_insts.set(id, inst)
    }

    // The instantiation graph, as a listing. `sema_depth.zen` is the
    // only reader and it needs every edge, which a keyed memo cannot
    // hand back.
    note_edge* = (self :: @Self, e: InstEdge) Res<AllocError> {
        self.edges.add(e)
    }

    edge_count* = (self: @Self) usize { self.edges.len }

    edge_at* = (self: @Self, i: usize) Res<InstEdge> { self.edges.get(i) }

    // Whose body is being walked. `check_body` brackets one declaration
    // with these, so an edge recorded in between knows its caller.
    enter_owner* = (self :: @Self, owner: str) { self.owner_now = owner; }

    owner_of_body* = (self: @Self) str { self.owner_now }

    modules* = (self: @Self) World { self.world }

    // Every diagnostic, rendered, one per line.
    render_diags* = (self: @Self, out :: String) Res<AllocError> {
        self.diags.loop((h, d) {
            d.render(self.types, out).try();
            out.add("\n").try();
        });
        Ok;
    }

    note_lambda_failure* = (self :: @Self, lambda: ExprId, d: Dropped)
                           Res<AllocError> {
        self.lambda_failures.set(lambda, d)
    }

    lambda_failure* = (self: @Self, lambda: ExprId) Res<Dropped> {
        self.lambda_failures.get(lambda)
    }

    memo_ty* = (self: @Self, id: ExprId) TyId {
        self.expr_memo.get(id).match({ Ok(ty) => ty, None => UNRESOLVED })
    }

    // A diagnostic identical to one already reported is the same mistake
    // found again by a second walk over the same node, so it is kept once.
    report* = (self :: @Self, file: str, span: Span, fault: SemaFault)
              Res<AllocError> {
        d = Diag(file: file, span: span, fault: fault);
        key ::= self.alloc.String().try();
        d.render(self.types, key).try();
        self.reported.get(key.view()).match({
            Ok(_) => Ok,
            None  => {
                self.reported.set(key.view(), true).try();
                self.diags.add(d)
            },
        })
    }

    // `report` at the position's own file.
    refuse* = (self :: @Self, span: Span, fault: SemaFault)
              Res<AllocError> {
        self.report(span.file, span, fault)
    }


    mark* = (self: @Self) usize { self.locals.len }

    enter_block* = (self :: @Self) usize {
        was             = self.block_base;
        self.block_base = self.locals.len;
        was
    }

    leave_block* = (self :: @Self, was: usize) { self.block_base = was; }

    lookup_here* = (self: @Self, name: str) Res<Binding> {
        Range(self.block_base, self.locals.len).find((k) {
            self.locals.get(k).match({
                Ok(b) => b.name.eq(name),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => self.locals.get(k),
        })
    }

    // `param` marks a formal parameter; `param_memo` is why it is recorded.
    bind* = (self :: @Self, name: str, ty: TyId, mutable: bool, param: bool)
            Res<AllocError> {
        self.bind_at(name, ty, mutable, param, nowhere())
    }

    bind_at* = (self :: @Self, name: str, ty: TyId, mutable: bool,
                param: bool, span: Span) Res<AllocError> {
        self.locals.add(Binding(
            name: name,
            ty: ty,
            mutable: mutable,
            param: param,
            span: span,
            deferred: false
        ))
    }

    // A local declared without a value; see `Binding.deferred`.
    bind_deferred* = (self :: @Self, name: str, ty: TyId, mutable: bool,
                      span: Span) Res<AllocError> {
        self.locals.add(Binding(
            name: name,
            ty: ty,
            mutable: mutable,
            param: false,
            span: span,
            deferred: true
        ))
    }

    bind_held* = (self :: @Self, name: str, ty: TyId, held: i64, span: Span)
                 Res<AllocError> {
        self.locals.add(Binding(
            name: name,
            ty: ty,
            mutable: false,
            param: false,
            span: span,
            deferred: false,
            held: Ok(held)
        ))
    }

    // Drop every binding added since `mark`.
    release* = (self :: @Self, mark: usize) Res<AllocError> {
        self.locals.truncate(mark);
    }

    detach_locals* = (self :: @Self, mark: usize, saved :: Vec<Binding>)
                     Res<AllocError> {
        extra = self.locals.len - mark;
        Range(0, extra).loop((h, _) {
            self.locals.take(self.locals.len - 1).match({
                Ok(b) => saved.add(b).try(),
                None  => (),
            });
        });
        Ok;
    }

    // `saved` came off the top, so it goes back bottom-first.
    reattach_locals* = (self :: @Self, saved: Vec<Binding>)
                       Res<AllocError> {
        n = saved.len;
        Range(0, n).loop((h, i) {
            saved.get(n - i - 1).match({
                Ok(b) => self.locals.add(b).try(),
                None  => (),
            });
        });
        Ok;
    }


    tvar_mark* = (self: @Self) usize { self.tvars.len }

    push_tvar* = (self :: @Self, tp: TParam, ty: TyId) Res<AllocError> {
        self.tparam_decls.set(ty, tp).try();
        self.tvars.add(Binding(tp.name.text, ty))
    }

    release_tvars* = (self :: @Self, mark: usize) Res<AllocError> {
        self.tvars.truncate(mark);
    }

    // The `T` of an enclosing `<T>`, innermost first. A type parameter
    // shadows a declaration of the same name, as a local binding does.
    lookup_tvar* = (self: @Self, name: str) Res<Binding> {
        self.tvars.innermost(name)
    }

    // Bounds currently carry a spelling, so a proof must not combine bounds
    // from distinct generic parameters that shadow one another.
    unshadowed_tvar* = (self: @Self, name: str, ty: TyId) bool {
        self.lookup_tvar(name).match({
            None    => false,
            Ok(now) => now.ty.eq(ty) && self.tvars.find((b) {
                b.name.eq(name) && (b.ty.eq(ty) == false)
            }).match({ Ok(_) => false, None => true }),
        })
    }

    bound_mark* = (self: @Self) usize { self.bounds.len }

    push_bound* = (self :: @Self, name: str, ty: TyId) Res<AllocError> {
        self.bounds.add(Binding(name, ty))
    }

    release_bounds* = (self :: @Self, mark: usize) Res<AllocError> {
        self.bounds.truncate(mark);
    }

    // A bound some generic in scope declared: the only question impl
    // selection asks.
    has_bound* = (self: @Self, ty: TyId) bool {
        self.bounds.find((b) { b.ty.eq(ty) }).match({
            Ok(_) => true,
            None  => false,
        })
    }

    // `bounds_of` asked as a predicate, so no allocation.
    is_bounded* = (self: @Self, name: str) bool {
        self.bounds.innermost(name).match({ Ok(_) => true, None => false })
    }

    // Every bound on one type parameter. `<K: Eq + Hash>` has two, and
    // a member reachable through either is reachable through `K`.
    bounds_of* = (self: @Self, name: str, out :: Vec<TyId>)
                 Res<AllocError> {
        self.bounds.loop((h, b) {
            ty = b.ty;
            b.name.eq(name).then(() { out.add(ty).try() });
        });
        Ok;
    }

    // The innermost binding of `name`.
    lookup* = (self: @Self, name: str) Res<Binding> {
        self.locals.innermost(name)
    }

    // -----------------------------------------------------------------
    // agreement
    // -----------------------------------------------------------------

    assignable* = (self: @Self, got: TyId, want: TyId) bool {
        got.eq(want)
            || self.is_unknown(got) || self.is_unknown(want)
            || self.is_infer(got) || self.is_infer(want)
            || self.literal_fits(got, want)
            || self.set_assignable(got, want)
            || self.res_assignable(got, want)
            || self.array_assignable(got, want)
            || self.uninstantiated(got, want)
    }

    array_assignable = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Array(g) => self.array_fits(g, want),
            _        => false,
        })
    }

    array_fits = (self: @Self, g: TyArray, want: TyId) bool {
        self.types.at(want).match({
            Array(w) => (g.count == w.count) && self.assignable(g.elem, w.elem),
            _        => false,
        })
    }

    res_assignable = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Res(g) => self.res_fits(g, want),
            _      => false,
        })
    }

    res_fits = (self: @Self, g: TyRes, want: TyId) bool {
        self.types.at(want).match({
            Res(w) => self.res_parts_fit(g, w),
            _      => false,
        })
    }

    res_parts_fit = (self: @Self, g: TyRes, w: TyRes) bool {
        forms_fit(g.form, w.form)
            && self.assignable(g.value, w.value)
            && self.assignable(g.error, w.error)
    }

    // Unsubstituted variables agree until inference supplies a concrete type.
    // Applications of the same declaration compare their arguments, while an
    // application against a bare generic head remains undecided.
    uninstantiated = (self: @Self, got: TyId, want: TyId) bool {
        self.is_var(got) || self.is_var(want) || self.same_applied(got, want)
    }

    // One type, or two applications of one declaration. Asked on its own
    // where assignability's other leniencies would be wrong — a poison
    // type is not an impl of a bound.
    same_type* = (self: @Self, a: TyId, b: TyId) bool {
        a.eq(b) || self.uninstantiated(a, b)
    }

    same_applied = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Named(g) => self.applied_to(g, want),
            _        => false,
        })
    }

    applied_to = (self: @Self, g: TyNamed, want: TyId) bool {
        self.types.at(want).match({
            Named(w) => g.decl.eq(w.decl) && self.args_agree(g.args, w.args),
            _        => false,
        })
    }

    // Applied types compare every argument. A concrete value cannot forget its
    // arguments, but an expected bare generic head has no arguments to compare.
    args_agree = (self: @Self, g: Vec<TyId>, w: Vec<TyId>) bool {
        (g.len == w.len).match({
            false => w.len == 0,
            true  => self.every_arg_agrees(g, w),
        })
    }

    every_arg_agrees = (self: @Self, g: Vec<TyId>, w: Vec<TyId>) bool {
        Range(0, g.len).find((i) {
            a = g.get(i).value_or(UNRESOLVED);
            b = w.get(i).value_or(UNRESOLVED);
            self.assignable(a, b) == false
        }).match({ Ok(_) => false, None => true })
    }

    // -----------------------------------------------------------------
    // what a body raises
    // -----------------------------------------------------------------

    raised_mark* = (self: @Self) usize { self.raised.len }

    // Return the access represented by a member id, when available.
    access_at* = (self: @Self, id: ExprId) Res<Access> {
        node = self.tree.expr_at(id);
        node.kind.match({
            Access(a) => Ok(a),
            _         => None,
        })
    }

    raise* = (self :: @Self, e: TyId) Res<AllocError> {
        self.raised.add(e)
    }

    // Move out every raised type recorded since `mark`.
    take_raised* = (self :: @Self, mark: usize, out :: Vec<TyId>)
                   Res<AllocError> {
        Range(mark, self.raised.len).loop((h, i) {
            out.add(self.raised.get(i).value_or(UNRESOLVED)).try();
        });
        self.raised.truncate(mark);
    }

    // The set a type stands for. A name declared `A | B` stands for the
    // union of what its variants name; everything else stands for
    // itself. `sema_union.zen` records the first kind.
    set_of* = (self: @Self, id: TyId) TyId {
        self.set_memo.get(id).match({
            None    => id,
            Ok(set) => set,
        })
    }

    set_assignable = (self: @Self, got: TyId, want: TyId) bool {
        wide = self.set_of(want);
        self.types.at(wide).match({
            Union(_) => self.types.set_within(self.set_of(got), wide),
            _        => false,
        })
    }

    literal_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_int_literal(got).match({
            true  => is_integer(self.prim_name(want)),
            false => self.float_fits(got, want),
        })
    }

    float_fits = (self: @Self, got: TyId, want: TyId) bool {
        self.is_float_literal(got) && is_float(self.prim_name(want))
    }

    // Report a mismatch unless `assignable` accepts the pair.
    coerce* = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
               name: str) Res<AllocError> {
        self.assignable(got, want).match({
            false => self.mismatch(file, span, got, want, name),
            true  => Ok,
        })
    }

    mismatch* = (self :: @Self, file: str, span: Span, got: TyId, want: TyId,
                 name: str) Res<AllocError> {
        fault = TypeFault(name: name, expected: want, found: got);
        self.report(
            file,
            span,
            self.failure_into_absence(got, want).match({
                true  => SemaFault.ErrWithoutError(fault),
                false => SemaFault.TypeMismatch(fault),
            })
        )
    }

    // An `Err` offered where a one-argument `Res` reads as absence.
    failure_into_absence = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Res(g) => g.form.match({ Failure => true, _ => false })
                && self.types.at(want).match({
                    Res(w) => w.form.match({ Absence => true, _ => false }),
                    _      => false,
                }),
            _      => false,
        })
    }

    // A nullary generic variant carries only its declaration. A written
    // destination may supply its type arguments when both sides name that
    // declaration; ordinary assignability does not invent them.
    nullary_settles* = (self: @Self, got: TyId, want: TyId) bool {
        self.types.at(got).match({
            Named(g) => (g.args.len == 0) && self.types.at(want).match({
                Named(w) => g.decl.eq(w.decl),
                _        => false,
            }),
            _        => false,
        })
    }

    check_not* = (self :: @Self, u: Unary, inner: TyId)
                 Res<TyId, AllocError> {
        want = self.types.bool_ty().try();
        self.coerce(u.op_span.file, u.op_span, inner, want, "").try();
        Ok(want);
    }

    check_logical* = (self :: @Self, b: Binary, lhs: TyId, rhs: TyId)
                     Res<AllocError> {
        is_logical(b.op).match({
            false => Ok,
            true  => self.logical_operands(b, lhs, rhs),
        })
    }

    // The position is the operator token for both sides, as `check_not`
    // puts it on the `!`: the operator is what demanded a bool.
    logical_operands = (self :: @Self, b: Binary, lhs: TyId, rhs: TyId)
                       Res<AllocError> {
        want = self.types.bool_ty().try();
        self.coerce(b.op_span.file, b.op_span, lhs, want, "").try();
        self.coerce(b.op_span.file, b.op_span, rhs, want, "").try();
    }

    // -----------------------------------------------------------------
    // asking a type what it is
    // -----------------------------------------------------------------

    is_unknown* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Unknown => true, _ => false })
    }

    is_infer* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Infer => true, _ => false })
    }

    is_var* = (self: @Self, id: TyId) bool {
        self.types.at(id).match({ Var(_) => true, _ => false })
    }

    prim_name* = (self: @Self, id: TyId) str {
        self.types.at(id).match({ Prim(p) => p.name, _ => "" })
    }

    is_literal_ty* = (self: @Self, id: TyId) bool {
        self.is_int_literal(id) || self.is_float_literal(id)
    }

    is_int_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("int")
    }

    is_float_literal = (self: @Self, id: TyId) bool {
        self.prim_name(id).eq("float")
    }
}

Checker* = (a: Alloc, tree: Ast) Res<Checker, AllocError> {
    c ::= Checker(
        tree: tree,
        world: a.World(tree).try(),
        types: a.Types(),
        diags: a.Vec<Diag>(),
        lambda_failures: a.Map<ExprId, Dropped>(),
        reported: a.Map<str, bool>(),
        expr_memo: a.Map<ExprId, TyId>(),
        type_memo: a.Map<TypeId, TyId>(),
        resolved_types: a.Vec<bool>(),
        resolved_type_decls: a.Map<TypeId, DeclId>(),
        meta_memo: a.Map<TypeId, str>(),
        meta_count_memo: a.Map<TypeId, usize>(),
        meta_walks: a.Map<ExprId, Vec<str>>(),
        meta_name_reads: a.Map<ExprId, bool>(),
        meta_projs: a.Map<ExprId, bool>(),
        walk_stack: a.Vec<WalkBind>(),
        walk_now: a.Vec<str>(),
        meta_recheck: 0,
        supply_memo: a.Map<ExprId, TyId>(),
        calls: a.Map<ExprId, CallResolution>(),
        own_checks: a.Vec<OwnCheck>(),
        store_effects: a.StoreEffects(),
        numeric_conversions: a.Map<DeclId, NumericConversion>(),
        integer_bits: a.Map<DeclId, IntegerBitOperation>(),
        primitives: a.Map<DeclId, Primitive>(),
        printers: a.Map<DeclId, Printer>(),
        bit_widths: a.Map<ExprId, bool>(),
        discriminant_calls: a.Map<ExprId, DiscriminantCall>(),
        variant_name_calls: a.Map<ExprId, VariantNameCall>(),
        param_memo: a.Map<ExprId, bool>(),
        callee_access: a.Map<ExprId, bool>(),
        lambda_insts: a.Map<ExprId, Inst>(),
        bound_views: a.Map<ExprId, bool>(),
        carrier_memo: a.Map<TyId, bool>(),
        edges: a.Vec<InstEdge>(),
        set_memo: a.Map<TyId, TyId>(),
        raised: a.Vec<TyId>(),
        locals: a.Vec<Binding>(),
        block_base: 0,
        tvars: a.Vec<Binding>(),
        bounds: a.Vec<Binding>(),
        tparam_decls: a.Map<TyId, TParam>(),
        alloc: a,
    );
    c.check_import_gate().try();
    c.know_std_decls().try();
    Ok(c);
}

know_std_decls = (c :: Checker) Res<AllocError> {
    c.types.know_std(StdDecls(
        from_core: c.world.has_core(),
        vararg: c.core_decl("vararg").try(),
        ptr: c.core_decl("Ptr").try(),
        scope: c.core_decl("Scope").try()
    ));
}

core_decl = (c :: Checker, name: str) Res<Res<DeclId>, AllocError> {
    defs ::= c.alloc.Vec<Def>();
    c.world.core_of(name, defs).try();
    Ok(defs.get(0).match({ Ok(d) => Ok(d.id), None => None }))
}

check_import_gate = (c :: Checker) Res<AllocError> {
    blocked ::= c.alloc.Vec<ImportBinding>();
    Range(0, c.world.count()).loop((h, mi) {
        c.world.blocked_imports(c.tree, mi, blocked).try();
    });
    blocked.loop((h, b) { c.report_blocked(b).try() });
    Range(0, c.world.count()).loop((h, mi) {
        c.world.table_at(mi).match({
            None  => Ok,
            Ok(t) => c.report_shadowed(t),
        }).try();
    });
    Ok;
}

// An import and a declaration of one name in one module would each hide
// the other, so neither wins silently.
report_shadowed = (c :: Checker, t: ModuleTable) Res<AllocError> {
    t.imports.loop((h, b) {
        t.defs.find((d) { d.name.eq(b.name) }).match({
            None  => Ok,
            Ok(d) => c.report(
                b.span.file,
                b.span,
                SemaFault.ImportShadowed(PairFault(
                    name: b.name,
                    first: b.span,
                    second: d.span
                ))
            ),
        }).try();
    });
    Ok;
}

report_blocked = (c :: Checker, b: ImportBinding) Res<AllocError> {
    c.report(
        b.span.file,
        b.span,
        SemaFault.NotExported(ExportFault(
            name: b.source,
            module: module_display(b.module)
        ))
    )
}

// A context with no `@Self` and no enclosing Res; a caller fills in what
// it knows.
Ctx* = (module: usize, none: TyId) Ctx {
    Ctx(
        module: module,
        ret: none,
        has_ret: false,
        self_ty: none,
        has_self: false
    )
}

UNRESOLVED* : TyId = TyId(index: 0)

is_predicate* = (op: BinOp) bool {
    op.match({
        Equal => true, NotEqual => true,
        Less => true, LessEq => true, Greater => true, GreaterEq => true,
        And => true, Or => true,
        _ => false,
    })
}

is_logical* = (op: BinOp) bool {
    op.match({ And => true, Or => true, _ => false })
}

forms_fit = (got: ResForm, want: ResForm) bool {
    got.match({
        Open    => true,
        Absence => undecided_or(want, false),
        Failure => undecided_or(want, true),
    })
}

undecided_or = (f: ResForm, failure: bool) bool {
    f.match({
        Open    => true,
        Failure => failure,
        Absence => failure == false,
    })
}

// A type-parameter or bound binding: immutable, and written nowhere.
Binding = (name: str, ty: TyId) Binding {
    Binding(
        name: name,
        ty: ty,
        mutable: false,
        param: false,
        span: nowhere(),
        deferred: false
    )
}

// The last binding of `name`: an inner scope shadows an outer one.
innermost = (v: Vec<Binding>, name: str) Res<Binding> {
    n = v.len;
    Range(0, n).find((k) {
        v.get(n - k - 1).match({ Ok(b) => b.name.eq(name), None => false })
    }).match({
        None  => None,
        Ok(k) => v.get(n - k - 1),
    })
}

truncate*<T> = (v :: Vec<T>, len: usize) {
    loop(v.len > len, (h) { v.take(v.len - 1); });
}
