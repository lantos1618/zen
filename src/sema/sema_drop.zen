Expr, Bind, Impl = std.ast
Span = std.source
AllocError = std.mem
Vec = std.collections
str = std.text
ImplId = sema.sema_id
TyId, TyNamed = sema.sema_ty
Checker, Ctx = sema.sema_check
SemaFault, NameFault = sema.sema_diag
Own = sema.sema_own
Res, Ok = std.core

// `g = f` on a value with a `Drop` impl would drop it twice.
check_drop_copy* = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
                   Res<(), AllocError> {
    node = c.tree.expr_at(b.value);
    node.kind.match({
        Name(n) => c.drop_copy_of_name(o, node, n.text),
        // Construction arguments follow constructor ownership rules.
        _       => Ok(()),
    })
}

// A name this frame does not bind is a global or a constant, and it is
// not a place this rule has an opinion about.
drop_copy_of_name = (c :: Checker, o :: Own, node: Expr, text: str)
                    Res<(), AllocError> {
    o.find_var(text).match({
        None  => Ok(()),
        Ok(_) => c.refuse_if_drop(node.span, o.var_type(text), text),
    })
}

refuse_if_drop = (c :: Checker, span: Span, ty: TyId, text: str)
                 Res<(), AllocError> {
    c.is_drop_type(ty).try().match({
        false => Ok(()),
        true  => c.refuse(
            span,
            SemaFault.CopyOfDropValue(NameFault(name: text))
        ),
    })
}

// Whether the type's own module holds an impl of `Drop` for it.
is_drop_type* = (c :: Checker, ty: TyId) Res<bool, AllocError> {
    c.types.at(ty).match({
        Named(n) => c.named_is_drop(n),
        _        => Ok(false),
    })
}

named_is_drop = (c :: Checker, n: TyNamed) Res<bool, AllocError> {
    ids ::= c.alloc.Vec<ImplId>();
    c.world.impls_named(c.tree, n.name, ids).try();
    found ::= false;
    ids.loop((h, id) {
        found = c.is_drop_impl(n, id).try();
        found.then(() { h.break(); });
    });
    Ok(found);
}

// The bound is std.core's `Drop` as the impl's own module resolves it.
is_drop_impl = (c: Checker, n: TyNamed, id: ImplId) Res<bool, AllocError> {
    (n.decl.module == id.decl.module).match({
        false => Ok(false),
        true  => c.world.impl_at(c.tree, id).match({
            None   => Ok(false),
            Ok(im) => c.tree.type_at(im.bound).kind.match({
                Named(b) => c.world.names_core(
                    id.decl.module.to_usize(),
                    b.name.text,
                    "Drop"
                ),
                _        => Ok(false),
            }),
        }),
    })
}
