// The compiler/stdlib contract for primitive conversions. Only validated
// declarations in std.core.num acquire an operation; renderers consume this
// table by declaration identity instead of interpreting a callee's spelling.
{ Function } = std.ast
{ AllocError } = std.mem
{ str } = std.text
{ Res, Ok, None, Range } = std.core
{ Checker, Ctx } = sema.sema_check
{ TyId } = sema.sema_ty
{ Def, decl_at } = sema.sema_def
{ param_type, ret_type } = sema.sema_denote
{ SemaFault, NameFault } = sema.sema_diag
{ primitive_signature } = sema.sema_prim

IntegerBitOperation* = { name*: str, word*: TyId }

NarrowTarget* = { U8 | U16 | U64 | Usize | I32 | CInt }
// Widen: every value converts exactly. Checked: an integer range check.
// Exact: an integer/float conversion that is None unless the value is
// represented exactly. Round: `narrow_*`, the one lossy family, which always
// yields the nearest representable value (see std.core.num).
ConversionKind* = { Widen | Checked: NarrowTarget | Exact | Round }

NumericConversion* = {
    source*: TyId,
    target*: TyId,
    result*: TyId,
    kind*: ConversionKind,
}

check_numeric_conversions* = (c :: Checker) Res<AllocError> {
    Range(0, c.world.count()).loop((h, mi) {
        c.world.table_at(mi).match({
            None      => (),
            Ok(table) => table.defs.loop(
                (d) { c.numeric_declaration(d).try() }
            ),
        });
    });
    Ok
}

numeric_declaration = (c :: Checker, d: Def) Res<AllocError> {
    // Translated C declarations retain their recorded foreign binding even
    // when a native function happens to have a conversion-shaped name.
    foreign = c.tree.module_origin_at(d.id.module.to_usize()).match({
        Ok(origin) => origin.match({ CBinding(_) => true, Source => false }),
        None       => false,
    });
    foreign.match({
        true  => Ok,
        false => c.source_numeric_declaration(d),
    })
}

source_numeric_declaration = (c :: Checker, d: Def) Res<AllocError> {
    decl_at(c.tree, d.id).match({
        None    => Ok,
        Ok(row) => row.kind.match({
            Function(f) => f.body.match({
                Ok(_) => Ok,
                None  => conversion_name(f.name.text).match({
                    None       => c.integer_bit_signature(d, f),
                    Ok(target) => c.numeric_signature(d, f, target),
                }),
            }),
            _           => Ok,
        }),
    })
}

// `to_T` converts without losing a value; `narrow_T` rounds.
conversion_name = (name: str) Res<str> {
    start: usize = name.starts_with("to_").match({
        true  => 3,
        false => name.starts_with("narrow_").match({ true => 7, false => 0 }),
    });
    (start > 0).ensure().try();
    target = name.slice(start, name.len);
    target.is_in([
        "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "u128",
        "usize", "f32", "f64", "bool", "c_char", "c_schar", "c_uchar",
        "c_short", "c_ushort", "c_int", "c_uint", "c_long", "c_ulong",
        "c_longlong", "c_ulonglong", "int", "float", "str",
    ]).ensure().try();
    Ok(target)
}

numeric_signature = (c :: Checker, d: Def, f: Function, target: str)
                    Res<AllocError> {
    (c.world.module_name(d.id).eq("std.core.num") && f.exported
        && f.params.len == 1 && f.tparams.len == 0).match({
        false => c.invalid_numeric(d),
        true  => {
            p = f.params.get(0).ok_or(AllocError.OutOfMemory).try();
            p.mutable.match({
                true  => c.invalid_numeric(d),
                false => {
                    ctx    = Ctx(
                        d.id.module.to_usize(),
                        c.types.unknown().try()
                    );
                    source = c.param_type(p, ctx).try();
                    result = c.ret_type(f, ctx).try();
                    rounds = f.name.text.starts_with("narrow_");
                    c.register_numeric(d, source, target, rounds, result)
                },
            })
        },
    })
}

register_numeric = (
    c      :: Checker,
    d      : Def,
    source : TyId,
    target : str,
    rounds : bool,
    result : TyId
) Res<AllocError> {
    name = c.prim_name(source);
    float_kind(name, target, rounds).match({
        Ok(kind) => Ok(kind),
        None     => rounds.match({
            true  => None,
            false => conversion_kind(name, target),
        }),
    }).match({
        None     => c.invalid_numeric(d),
        Ok(kind) => {
            optional = c.types.at(result).match({
                Res(r) => r.form.match({ Absence => true, _ => false })
                    && c.prim_name(r.value).eq(target),
                _      => false,
            });
            expected = kind.match({
                Widen      => c.prim_name(result).eq(target),
                Round      => c.prim_name(result).eq(target),
                Checked(_) => optional,
                Exact      => optional,
            });
            expected.match({
                false => c.invalid_numeric(d),
                true  => c.numeric_conversions.set(
                    d.id,
                    NumericConversion(
                        source: source,
                        target: c.types.prim(target).try(),
                        result: result,
                        kind: kind
                    )
                ),
            })
        },
    })
}

// This finite list is the supported contract, not a general permission to
// cast between machine representations. usize is currently a 64-bit target
// type; its checked conversions retain the contract for narrower targets.
conversion_kind = (source: str, target: str) Res<ConversionKind> {
    lossless = source.match({
        "u8"    => target.is_in([
            "u16", "u32", "u64", "u128", "usize", "i32", "i64", "f32", "f64"
        ]),
        "u16"   => target.is_in([
            "u32", "u64", "u128", "usize", "i64", "f32", "f64"
        ]),
        "u32"   => target.is_in(["u64", "u128", "usize", "i64", "f64"]),
        "u64"   => target.eq("u128"),
        "usize" => target.is_in(["u64", "u128"]),
        "i8"    => target.is_in(["i16", "i32", "i64", "f32", "f64"]),
        "i16"   => target.is_in(["i32", "i64", "f32", "f64"]),
        "i32"   => target.is_in(["i64", "f64"]),
        "f32"   => target.eq("f64"),
        _       => false,
    });
    lossless.match({
        true  => Ok(ConversionKind.Widen),
        false => source.match({
            "usize" => target.eq("u8"),
            "u32"   => target.eq("u8"),
            "u64"   => target.is_in(["u16", "usize", "i32"]),
            "i64"   => target.is_in(["i32", "usize"]),
            "u128"  => target.eq("u64"),
            "c_int" => target.eq("i32"),
            "i32"   => target.eq("c_int"),
            _       => false,
        }).ensure().match({
            None  => None,
            Ok(_) => target.match({
                "u8"    => Ok(ConversionKind.Checked(NarrowTarget.U8)),
                "u16"   => Ok(ConversionKind.Checked(NarrowTarget.U16)),
                "u64"   => Ok(ConversionKind.Checked(NarrowTarget.U64)),
                "usize" => Ok(ConversionKind.Checked(NarrowTarget.Usize)),
                "i32"   => Ok(ConversionKind.Checked(NarrowTarget.I32)),
                "c_int" => Ok(ConversionKind.Checked(NarrowTarget.CInt)),
                _       => None,
            }),
        }),
    })
}

// Conversions whose operand or result is a float and that are not lossless.
// `narrow_*` rounds; `to_*` between an integer and f64 is exact or None.
float_kind = (source: str, target: str, rounds: bool) Res<ConversionKind> {
    rounds.match({
        true  => {
            ((source.eq("f64") && target.eq("f32"))
                || (source.is_in(["i64", "u64"]) && target.eq("f64"))).ensure().try();
            Ok(ConversionKind.Round)
        },
        false => {
            ((source.eq("f64") && target.is_in(["i32", "i64"]))
                || (source.is_in(["i64", "u64"]) && target.eq("f64"))).ensure().try();
            Ok(ConversionKind.Exact)
        },
    })
}

invalid_numeric = (c :: Checker, d: Def) Res<AllocError> {
    c.report(
        d.span.file,
        d.span,
        SemaFault.InvalidNumericConversion(NameFault(name: d.name))
    )
}

// Every bit operation takes an unsigned word; `shift_right` alone also takes a
// signed one, where it is the arithmetic shift.
bit_operand = (name: str, word: str) bool {
    bit_word(word) || (name.eq("shift_right") && signed_shift_word(word))
}

signed_shift_word* = (word: str) bool {
    word.is_in(["i8", "i16", "i32", "i64"])
}

// Bit operations are compiler-owned only after validating their declaration.
// `bit_*` combine two words of one type; shifts and rotations take a usize
// count. Every name applies to every unsigned word below.
integer_bit_name* = (name: str) bool {
    name.is_in([
        "bit_xor", "bit_and", "bit_or", "shift_right", "shift_left",
        "rotate_right", "rotate_left",
    ])
}

bit_word* = (name: str) bool {
    name.is_in(["u8", "u16", "u32", "u64", "u128", "usize"])
}

integer_bit_signature = (
    c :: Checker,
    d : Def,
    f : Function
) Res<AllocError> {
    scalar = integer_bit_name(f.name.text)
        && !c.world.module_name(d.id).eq("std.simd");
    scalar.match({
        false => c.primitive_signature(d, f),
        true  => {
            (c.world.module_name(d.id).eq("std.core.num") && f.exported
                && f.params.len == 2 && f.tparams.len == 0).match({
                false => c.invalid_numeric(d),
                true  => {
                    a      = f.params.get(0).ok_or(AllocError.OutOfMemory).try();
                    b      = f.params.get(1).ok_or(AllocError.OutOfMemory).try();
                    ctx    = Ctx(
                        d.id.module.to_usize(),
                        c.types.unknown().try()
                    );
                    at     = c.param_type(a, ctx).try();
                    bt     = c.param_type(b, ctx).try();
                    rt     = c.ret_type(f, ctx).try();
                    word   = c.prim_name(at);
                    second = f.name.text.starts_with(
                        "bit_"
                    ).match({true => word, false => "usize"});
                    (!a.mutable && !b.mutable && bit_operand(f.name.text, word)
                        && c.prim_name(bt).eq(second) && c.prim_name(rt).eq(word)).match({
                        false => c.invalid_numeric(d),
                        true  => c.integer_bits.set(
                            d.id,
                            IntegerBitOperation(name: f.name.text, word: at)
                        ),
                    })
                },
            })
        },
    })
}
