{ Expr, ExprId, Block, BlockId, Stmt, Bind, Deferred } = std.ast
{ Decl, Member, Function, Param } = std.ast
{ Call, Arg, Access, Match, Arm, Lambda, Index, Consume } = std.ast
{ Name, Paren, Try, Unary, Binary } = std.ast
{ Span } = std.source
{ Record, FixedArray, Field, Const } = std.ast
{ Alloc, AllocError } = std.mem
{ Vec } = std.collections
{ str, String } = std.text
{ Res, Ok, None, loop, Range } = std.core
{ TyId } = sema.sema_ty
{ Checker, Ctx, UNRESOLVED, truncate } = sema.sema_check
{ SemaFault, NameFault } = sema.sema_diag
{ check_receiver, check_write_place, check_lent_args, check_lent_fields } = sema.sema_recv
{ check_scope_returned, check_scope_stored } = sema.sema_scope
{ check_scope_captured, is_scope_value, call_escapes } = sema.sema_scope
{ check_arena_returned, is_arena_backed, is_arena_ty } = sema.sema_scope
{ scope_alias, remember_block_origin, check_arena_stored, is_construction } = sema.sema_scope
{ frame_bound_view, frame_view_at, refuse_frame_view, sheds_frame_view } = sema.sema_scope
{ arena_source, release_stored_arena, stored_arena_backed } = sema.sema_scope
{ Pin, pin_captured, refuse_pinned, refuse_pinned_at, pin_viewed } = sema.sema_pin
{ refuse_deferred_write } = sema.sema_pin
{ check_drop_copy, is_drop_type } = sema.sema_drop
{ carries_bound } = sema.sema_copy
{ is_handle_ty, refuse_handle_at, spelled_name } = sema.sema_handle
{ local_lambda } = sema.sema_local
{ type_from_ast } = sema.sema_denote
{ spelled_lambda, call_callee } = sema.sema_call
{ OwnCheck, call_stores, transfer_call_stores, actual, selected_summary } = sema.sema_store
{ append_path, strip_path, copy_allocation, Returned } = sema.sema_store
{ decl_at } = sema.sema_def

OwnVar* = {
    name*: str,
    ty*: TyId,
    mutable*: bool,
    owned*: bool,
    scoped* :: bool,
    arena* :: bool,
    source :: Res<ExprId>,
    fields :: Vec<FieldOrigin>,
    span*: Span,
}

// Field overrides are immutable between snapshots. An absent field inherits
// the root's origin; whole-value reads include every recorded field.
FieldOrigin = {
    name: str,
    scoped: bool,
    arena: bool,
    source: Res<ExprId>,
}

// Storage origins reaching a binding at one point in the ownership walk.
Provenance = {
    scoped: bool,
    arena: bool,
    source: Res<ExprId>,
    fields: Vec<FieldOrigin>,

    field = (self: @Self, name: str) FieldOrigin {
        found ::= FieldOrigin(
            name: name,
            scoped: self.scoped,
            arena: self.arena,
            source: self.source
        );
        best  :: usize = 0;
        self.fields.loop((field) {
            matches = field.name.eq(name) || strip_path(name, field.name).match({ None => false, Ok(_) => true });
            (matches && field.name.len >= best).then(() {
                found = field;
                best  = field.name.len;
            });
        });
        found
    }

    eq = (self: @Self, other: Provenance) bool {
        self.scoped == other.scoped && self.arena == other.arena && same_source(
            self.source,
            other.source
        ) &&
            self.fields.find((f) {
                right = other.field(f.name);
                f.scoped != right.scoped || f.arena != right.arena || !same_source(
                    f.source,
                    right.source
                )
            }).match({ None => true, Ok(_) => false }) && other.fields.find((f) {
                left = self.field(f.name);
                f.scoped != left.scoped || f.arena != left.arena || !same_source(
                    f.source,
                    left.source
                )
            }).match({ None => true, Ok(_) => false })
    }

    join = (self: @Self, other: Provenance, alloc: Alloc) Res<Provenance, AllocError> {
        fields ::= alloc.Vec<FieldOrigin>();
        self.fields.loop((h, field) {
            right = other.field(field.name);
            fields.add(FieldOrigin(
                name: field.name,
                scoped: field.scoped || right.scoped,
                arena: field.arena || right.arena,
                source: joined_source(
                    field.arena,
                    field.source,
                    right.arena,
                    right.source
                )
            )).try();
        });
        other.fields.loop((h, field) {
            self.fields.find(
                (left) { left.name.eq(field.name) }
            ).match({ Ok(_) => true, None => false }).match({
                true  => (),
                false => fields.add(FieldOrigin(
                    name: field.name,
                    scoped: self.scoped || field.scoped,
                    arena: self.arena || field.arena,
                    source: joined_source(
                        self.arena,
                        self.source,
                        field.arena,
                        field.source
                    )
                )).try(),
            });
        });
        Ok(Provenance(
            scoped: self.scoped || other.scoped,
            arena: self.arena || other.arena,
            source: joined_source(
                self.arena,
                self.source,
                other.arena,
                other.source
            ),
            fields: fields
        ))
    }
}

ViewRoot* = { root*: usize, at*: ExprId }

// Moving an arena into caller storage takes its pages along, so what was
// drawn from it stops being local. A value that holds a bound built over the
// arena's binding is the exception: the record keeps the binding's address,
// which the move leaves behind, so it becomes a view of this frame instead.
rehome_arena* = (c :: Checker, o :: Own, source: ExprId, root: Res<usize>)
                Res<AllocError> {
    formed: Res<ExprId> = root.match({
        None  => None,
        Ok(i) => o.views.find((v) { v.root == i }).match({ None => None, Ok(v) => Ok(v.at) }),
    });
    formed.match({
        None     => o.release_arena(source),
        Ok(view) => {
            kept ::= o.alloc.Vec<usize>();
            o.vars.loop((h, i, row) {
                (row.arena && same_source(row.source, Ok(source)) && c.carries_bound(row.ty).try())
                    .then(() { kept.add(i).try(); });
            });
            o.release_arena(source).try();
            kept.loop((i) {
                o.vars.get(i).when_ok((old) {
                    row ::= old;
                    row.arena  = true;
                    row.source = Ok(view);
                    o.vars.set(i, row);
                });
            });
            Ok
        },
    })
}

// A moved-out place: a binding, or one field of it.
Place* = {
    root*: usize,
    field*: str,
    invalidated: bool,
    span*: Span,
}

// One body's ownership frame. `vars` is a scope stack indexed by
// declaration order; `escaped` is the index above which bindings were
// declared inside an escaping closure, 0 while no closure is open.
BlockOrigin = {
    block: BlockId,
    scoped: bool,
    arena: Res<str>,
    source: Res<ExprId>,
}

Own* = {
    results :: Vec<BlockOrigin>,
    vars :: Vec<OwnVar>,
    dead :: Vec<Place>,
    pinned* :: Vec<Pin>,
    // Bound values built over this frame's bindings: the binding, and the
    // converted argument that names the view (`sema_scope`, bound values).
    views* :: Vec<ViewRoot>,
    escaped* :: usize,
    // Like `escaped`, for the body of a `defer` closure: bindings below it
    // are captures the closure reads when its block ends.
    deferring* :: usize,
    // The `defer` is registered on a Scope passed in: its closure runs at
    // the end of a caller's block, after this function has returned.
    deferring_out* :: bool,
    method* :: str,
    body* :: BlockId,
    alloc*: Alloc,

    block_scoped* = (self: @Self, id: BlockId) bool {
        self.results.find((r) { r.block.index == id.index }).match({
            None => false, Ok(r) => r.scoped,
        })
    }

    block_arena* = (self: @Self, id: BlockId) Res<str> {
        self.results.find((r) { r.block.index == id.index }).match({
            None => None, Ok(r) => r.arena,
        })
    }

    block_source* = (self: @Self, id: BlockId) Res<ExprId> {
        self.results.find((r) { r.block.index == id.index }).match({
            None => None, Ok(r) => r.source,
        })
    }

    remember_block* = (
        self :: @Self, id: BlockId, scoped: bool, arena: Res<str>, source: Res<ExprId>
    ) Res<AllocError> {
        value = BlockOrigin(
            block: id,
            scoped: scoped,
            arena: arena,
            source: source
        );
        Range(0, self.results.len).find((i) {
            self.results.get(i).match({
                None => false, Ok(r) => r.block.index == id.index,
            })
        }).match({
            None  => self.results.add(value).try(),
            Ok(i) => self.results.set(i, value),
        });
        Ok
    }

    // The innermost binding of `text`, as an index into `vars`.
    find_var* = (self: @Self, text: str) Res<usize> {
        n = self.vars.len;
        Range(0, n).find((k) {
            self.vars.get(n - k - 1).match({
                Ok(v) => v.name.eq(text),
                None  => false,
            })
        }).match({
            None  => None,
            Ok(k) => Ok(n - k - 1),
        })
    }

    var_at = (self: @Self, text: str) Res<OwnVar> {
        self.find_var(text).match({ None => None, Ok(i) => self.vars.get(i) })
    }

    // A name this frame does not bind is a global, which is writable.
    var_mutable* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => true, Ok(v) => v.mutable })
    }

    var_type* = (self: @Self, text: str) TyId {
        self.var_at(text).match({ None => UNRESOLVED, Ok(v) => v.ty })
    }

    scoped_var* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => false, Ok(v) => v.scoped || v.fields.find((f) { f.scoped }).match({ Ok(_) => true, None => false }) })
    }

    // Whether this name is, or views into, an arena this frame made.
    arena_var* = (self: @Self, text: str) bool {
        self.var_at(text).match({ None => false, Ok(v) => v.arena || v.fields.find((f) { f.arena }).match({ Ok(_) => true, None => false }) })
    }

    field_view = (self: @Self, text: str, name: str) StoredView {
        self.var_at(text).match({
            None      => StoredView(scoped: false, arena: false, source: None),
            Ok(value) => {
                field = Provenance(scoped: value.scoped, arena: value.arena, source: value.source, fields: value.fields).field(name);
                StoredView(
                    scoped: field.scoped,
                    arena: field.arena,
                    source: field.source
                )
            },
        })
    }

    arena_field* = (self: @Self, text: str, name: str) bool {
        self.field_view(text, name).arena
    }

    arena_source* = (self: @Self, text: str) Res<ExprId> {
        self.var_at(text).match({
            None  => None,
            Ok(v) => {
                source ::= v.source;
                seen   ::= v.arena;
                v.fields.loop((f) {
                    source = joined_source(seen, source, f.arena, f.source);
                    seen   = seen || f.arena;
                });
                source
            },
        })
    }

    field_source* = (self: @Self, text: str, name: str) Res<ExprId> {
        self.field_view(text, name).source
    }

    release_arena* = (self :: @Self, source: ExprId) Res<AllocError> {
        self.vars.loop((h, i, old) {
            row ::= old;
            same_source(row.source, Ok(source)).then(() {
                row.arena  = false;
                row.source = None;
            });
            fields ::= self.alloc.Vec<FieldOrigin>();
            old.fields.loop((h, f) {
                same_source(f.source, Ok(source)).match({
                    false => fields.add(f).try(),
                    true  => fields.add(FieldOrigin(
                        name: f.name,
                        scoped: f.scoped,
                        arena: false,
                        source: None
                    )).try(),
                });
            });
            row.fields = fields;
            self.vars.set(i, row);
        });
        Ok
    }

    scoped_field* = (self: @Self, text: str, name: str) bool {
        self.field_view(text, name).scoped
    }

    taint_root = (self :: @Self, root: usize, value: Provenance) {
        self.vars.get(root).match({
            None    => (),
            Ok(old) => {
                row ::= old;
                row.scoped = old.scoped || old.fields.find(
                    (f) { f.scoped }
                ).match({ Ok(_) => true, None => false }) || value.scoped;
                row.source = None;
                row.arena  = old.arena || old.fields.find(
                    (f) { f.arena }
                ).match({ Ok(_) => true, None => false }) || value.arena;
                // A write through a deeper path may affect any prior override.
                row.fields = self.alloc.Vec<FieldOrigin>();
                self.vars.set(root, row);
            },
        });
    }

    assign_field = (self :: @Self, root: usize, name: str, value: Provenance)
                   Res<AllocError> {
        self.vars.get(root).match({
            None    => Ok,
            Ok(old) => {
                row    ::= old;
                fields ::= old.fields.filter(
                    self.alloc,
                    (f) { !f.name.eq(name) && strip_path(f.name, name).match({ None => true, Ok(_) => false }) }
                ).try();
                fields.add(FieldOrigin(
                    name: name,
                    scoped: value.scoped,
                    arena: value.arena,
                    source: value.source
                )).try();
                value.fields.loop((field) {
                    fields.add(FieldOrigin(
                        name: append_path(self.alloc, name, field.name).try(),
                        scoped: field.scoped,
                        arena: field.arena,
                        source: field.source
                    )).try();
                });
                row.fields = fields;
                self.vars.set(root, row);
                Ok
            },
        })
    }

    // A `@scope` binding read from inside an escaping closure.
    captures_scope* = (self: @Self, text: str) bool {
        self.find_var(text).match({
            None  => false,
            Ok(i) => (i < self.escaped) && self.scoped_at(i),
        })
    }

    scoped_at = (self: @Self, i: usize) bool {
        self.vars.get(i).match({ Ok(v) => v.scoped || v.fields.find((f) { f.scoped }).match({ Ok(_) => true, None => false }), None => false })
    }

    type_at* = (self: @Self, root: usize) TyId {
        self.vars.get(root).match({ Ok(v) => v.ty, None => UNRESOLVED })
    }

    owned_at* = (self: @Self, root: usize) bool {
        self.vars.get(root).match({ Ok(v) => v.owned, None => false })
    }

    is_dead = (self: @Self, root: usize, field: str) bool {
        self.dead.find((p) { (p.root == root) && p.field.eq(field) })
            .match({ Ok(_) => true, None => false })
    }

    has_dead_field = (self: @Self, root: usize) bool {
        self.dead.find(
            (p) { (p.root == root) && (p.field.len > 0) && !p.invalidated }
        )
            .match({ Ok(_) => true, None => false })
    }

    kill = (self :: @Self, root: usize, field: str, span: Span)
           Res<AllocError> {
        self.dead.add(Place(
            root: root,
            field: field,
            invalidated: false,
            span: span
        ))
    }

    // Destruction invalidates both definite dependents and unknown local origins.
    invalidate_arena = (self :: @Self, source: Res<ExprId>, span: Span)
                       Res<AllocError> {
        self.vars.loop((h, i, v) {
            dependent       = v.arena && may_share_source(v.source, source);
            field_dependent = v.fields.find((f) {
                f.arena && may_share_source(f.source, source)
            }).match({ None => false, Ok(_) => true });
            (dependent || field_dependent).then(() {
                self.dead.add(Place(
                    root: i,
                    field: "",
                    invalidated: true,
                    span: span
                )).try();
            });
        });
        Ok
    }

    // A write fills the hole.
    revive = (self :: @Self, root: usize, field: str) Res<AllocError> {
        self.dead = self.dead.filter(self.alloc, (p) {
            ((p.root == root) && p.field.eq(field)) == false
        }).try();
        Ok;
    }

    assign_provenance = (self :: @Self, root: usize, value: Provenance) {
        self.vars.get(root).match({
            None    => (),
            Ok(old) => {
                row ::= old;
                row.scoped = value.scoped;
                row.arena  = value.arena;
                row.source = value.source;
                row.fields = value.fields;
                self.vars.set(root, row);
            },
        });
    }

    provenance = (self: @Self) Res<Vec<Provenance>, AllocError> {
        out ::= self.alloc.Vec<Provenance>();
        self.vars.loop((h, v) {
            out.add(Provenance(
                scoped: v.scoped,
                arena: v.arena,
                source: v.source,
                fields: v.fields
            )).try();
        });
        Ok(out)
    }

    restore_provenance = (self :: @Self, saved: Vec<Provenance>) {
        saved.loop((h, i, value) { self.assign_provenance(i, value); });
    }

    join_provenance = (self: @Self, joined :: Vec<Provenance>) Res<AllocError> {
        joined.loop((h, i, before) {
            self.vars.get(i).match({
                None    => (),
                Ok(now) => joined.set(
                    i,
                    before.join(
                        Provenance(
                            scoped: now.scoped,
                            arena: now.arena,
                            source: now.source,
                            fields: now.fields
                        ),
                        self.alloc
                    ).try()
                ),
            });
        });
        Ok
    }

    provenance_eq = (self: @Self, saved: Vec<Provenance>) bool {
        equal ::= true;
        saved.loop((h, i, before) {
            self.vars.get(i).match({
                None    => { equal = false; },
                Ok(now) => {
                    equal = equal && before.eq(Provenance(
                        scoped: now.scoped,
                        arena: now.arena,
                        source: now.source,
                        fields: now.fields
                    ));
                },
            });
        });
        equal
    }

    // The moved-out places at this point, to restore or join later.
    dead_state = (self: @Self) Res<Vec<Place>, AllocError> {
        self.dead.filter(self.alloc, (p) { true })
    }

    set_dead = (self :: @Self, saved: Vec<Place>) Res<AllocError> {
        self.dead = saved.filter(self.alloc, (p) { true }).try();
        Ok
    }

    // Where paths meet, a place is dead if it is dead on any of them: a
    // write on one path does not refill the place on another.
    join_dead = (self :: @Self, other: Vec<Place>) Res<AllocError> {
        other.loop((h, p) {
            (p.root < self.vars.len && !self.is_dead(p.root, p.field)).then(
                () { self.dead.add(p).try(); }
            );
        });
        Ok
    }

    // A place dead now that was live in `before`.
    newly_dead = (self: @Self, before: Vec<Place>) Res<Vec<Place>, AllocError> {
        self.dead.filter(self.alloc, (p) {
            before.find((q) { q.root == p.root && q.field.eq(p.field) })
                .match({ Ok(_) => false, None => true })
        })
    }

    // Drop the bindings declared since `mark`, and every dead place or
    // pin rooted at one of them.
    release = (self :: @Self, mark: usize) Res<AllocError> {
        self.dead   = self.dead.filter(self.alloc, (p) { p.root < mark })
            .try();
        self.views  = self.views.filter(self.alloc, (v) { v.root < mark })
            .try();
        self.pinned = self.pinned.filter(self.alloc, (p) { p.root < mark })
            .try();
        self.vars.truncate(mark);
    }
}

Own* = (a: Alloc) Res<Own, AllocError> {
    Ok(Own(
        results: a.Vec<BlockOrigin>(),
        vars: a.Vec<OwnVar>(),
        dead: a.Vec<Place>(),
        pinned: a.Vec<Pin>(),
        views: a.Vec<ViewRoot>(),
        escaped: 0,
        deferring: 0,
        deferring_out: false,
        method: "",
        body: BlockId(index: 0),
        alloc: a
    ));
}

check_own* = (c :: Checker, f: Function, body: BlockId, ctx: Ctx)
             Res<AllocError> {
    c.own_checks.add(OwnCheck(
        function: f,
        body: body,
        ctx: ctx,
        bindings: c.saved_bindings().try()
    ))
}

check_own_body* = (c :: Checker, f: Function, body: BlockId, ctx: Ctx)
                  Res<AllocError> {
    o ::= c.alloc.Own().try();
    o.method = receiver_method(f, ctx);
    o.body   = body;
    c.own_params(o, f).try();
    c.own_block(o, body, ctx).try();
}

// A projected source selects a field's recorded provenance instead of
// attributing every field to every allocation carried by the aggregate.
StoredView* = {
    scoped*: bool,
    arena*: bool,
    source*: Res<ExprId>,

    join = (self: @Self, other: @Self) StoredView {
        StoredView(
            scoped: self.scoped || other.scoped,
            arena: self.arena || other.arena,
            source: joined_source(
                self.arena,
                self.source,
                other.arena,
                other.source
            )
        )
    }
}

// A bound value built from `value` at this use is a view of this frame
// whatever `value` itself was drawn from (`sema_scope`, bound values).
stored_view* = (
    c     :: Checker,
    o     :: Own,
    value : ExprId,
    field : Res<str>
) StoredView {
    view = c.stored_view_of(o, value, field);
    c.frame_bound_view(value).match({
        true  => view.arena.match({
            false => StoredView(
                scoped: view.scoped,
                arena: true,
                source: Ok(value)
            ),
            true  => view,
        }),
        false => (field.match({ None => true, Ok(_) => false }) && view.arena && c.sheds_frame_view(
            o,
            value,
            view.source
        )).match({
            true  => StoredView(
                scoped: view.scoped,
                arena: false,
                source: None
            ),
            false => view,
        }),
    })
}

stored_view_of = (
    c     :: Checker,
    o     :: Own,
    value : ExprId,
    field : Res<str>
) StoredView {
    text = c.spelled_name(value);
    field.match({
        Ok(name) => (text.len > 0).match({
            true  => StoredView(
                scoped: o.scoped_field(text, name),
                arena: o.arena_field(text, name),
                source: o.field_source(text, name)
            ),
            false => c.tree.expr_at(value).kind.match({
                Paren(p)   => c.stored_view(o, p.inner, field),
                Try(t)     => c.stored_view(o, t.operand, field),
                Call(call) => c.is_construction(value).match({
                    false => c.returned_view(o, value, call, name).match({ Ok(view) => view, None => c.stored_view(o, value, None) }),
                    true  => {
                        part = name.split_once('.');
                        head = part.match({ None => name, Ok(parts) => parts.before });
                        tail = part.match({ None => None, Ok(parts) => Ok(
                            parts.after
                        ) });
                        call.args.find((arg) {
                            arg.name.match({ None => false, Ok(label) => label.text.eq(
                                head
                            ) })
                        }).match({
                            None    => c.stored_view(o, value, None),
                            Ok(arg) => c.stored_view(o, arg.value, tail),
                        })
                    },
                }),
                _          => c.stored_view(o, value, None),
            }),
        }),
        None     => c.tree.expr_at(value).kind.match({
            Name(name)     => StoredView(
                scoped: o.scoped_var(name.text),
                arena: o.arena_var(name.text),
                source: o.arena_source(name.text)
            ),
            Paren(paren)   => c.stored_view(o, paren.inner, None),
            Consume(moved) => c.is_arena_ty(c.place_type(
                o,
                moved.operand
            )).match({
                true  => StoredView(scoped: false, arena: false, source: None),
                false => c.stored_view(o, moved.operand, None),
            }),
            Access(_)      => c.access_view(o, value),
            _              => StoredView(
                scoped: c.scope_alias(o, value),
                arena: c.is_arena_backed(o, value),
                source: c.arena_source(o, value)
            ),
        }),
    })
}

store_origin* = (
    c      :: Checker,
    o      :: Own,
    target : ExprId,
    value  : ExprId,
    field  : Res<str>
)
                Res<AllocError> {
    view = c.stored_view(o, value, field);
    c.path_root(o, target).when_ok((root) {
        (!o.owned_at(root) && view.arena).then(() {
            c.frame_view_at(view.source).match({
                None       => c.refuse(
                    c.tree.expr_at(target).span,
                    SemaFault.ArenaStored(NameFault(name: c.spelled_name(
                        value
                    )))
                ),
                Ok(formed) => c.refuse_frame_view(
                    o,
                    formed,
                    value,
                    target,
                    true
                ),
            }).try();
        });
    });
    c.transfer_view(o, target, view)
}

transfer_store_origin* = (
    c      :: Checker,
    o      :: Own,
    target : ExprId,
    value  : ExprId,
    field  : Res<str>
)
                         Res<AllocError> {
    c.transfer_view(o, target, c.stored_view(o, value, field))
}

transfer_view = (c :: Checker, o :: Own, target: ExprId, view: StoredView)
                Res<AllocError> {
    c.path_root(o, target).when_ok((root) {
        existing   = c.arena_source(o, target);
        same_owner = view.source.match({
            None     => false,
            Ok(from) => existing.match({ None => false, Ok(to) => from.index == to.index }),
        });
        (view.arena && !same_owner).then(() {
            o.taint_root(
                root,
                Provenance(
                    scoped: view.scoped,
                    arena: true,
                    source: view.source,
                    fields: o.alloc.Vec<FieldOrigin>()
                )
            );
        });
    });
    Ok
}

receiver_method = (f: Function, ctx: Ctx) str {
    (ctx.has_self && first_param_is_self(f)).match({
        true  => f.name.text,
        false => "",
    })
}

first_param_is_self = (f: Function) bool {
    f.params.get(0).match({
        None  => false,
        Ok(p) => p.name.text.eq("self"),
    })
}

own_params = (c :: Checker, o :: Own, f: Function) Res<AllocError> {
    f.params.loop((h, p) { c.own_param(o, p).try() });
    Ok;
}

own_param = (c :: Checker, o :: Own, p: Param) Res<AllocError> {
    text = p.name.text;
    ty   = c.lookup(text).match({ Ok(b) => b.ty, None => UNRESOLVED });
    o.vars.add(OwnVar(
        name: text,
        ty: ty,
        mutable: p.mutable,
        owned: false,
        scoped: false,
        arena: false,
        source: None,
        fields: o.alloc.Vec<FieldOrigin>(),
        span: p.name.span
    ))
}

// the walk
own_block = (c :: Checker, o :: Own, id: BlockId, ctx: Ctx)
            Res<AllocError> {
    b    = c.tree.block_at(id);
    mark = o.vars.len;
    b.stmts.loop((h, s) { c.own_stmt(o, s, ctx).try() });
    b.value.match({
        Ok(v) => c.own_expr(o, v, ctx),
        None  => Ok,
    }).try();
    c.remember_block_origin(o, id, b).try();
    c.check_scope_returned(o, id, b).try();
    c.check_arena_returned(o, id, b).try();
    c.check_partial_moves(o, mark).try();
    o.release(mark).try();
}

own_stmt = (c :: Checker, o :: Own, s: Stmt, ctx: Ctx) Res<AllocError> {
    s.kind.match({
        Bind(b)     => c.own_bind(o, b, ctx),
        Deferred(d) => c.own_deferred(o, d, ctx),
        Expr(e)     => c.own_expr(o, e.expr, ctx),
        Block(x)    => c.own_block(o, x, ctx),
        Decl(d)     => c.own_local_decl(o, d, ctx),
    })
}

// A deferred local is storage this frame owns from its declaration, with no
// origin until it is assigned. sema_init, not this walk, proves every read
// of it follows an assignment.
own_deferred = (c :: Checker, o :: Own, d: Deferred, ctx: Ctx)
               Res<AllocError> {
    node = c.tree.expr_at(d.target);
    node.kind.match({
        Name(n) => o.vars.add(OwnVar(
            name: n.text,
            ty: c.type_from_ast(d.type, ctx).try(),
            mutable: d.mutable,
            owned: true,
            scoped: false,
            arena: false,
            source: None,
            fields: o.alloc.Vec<FieldOrigin>(),
            span: node.span
        )),
        _       => Ok,
    })
}

// A local function may run any number of times, at any later point in its
// scope, so its body is walked as a repeating closure: a capture it would
// move is reported the way a loop body's is.
own_local_decl = (c :: Checker, o :: Own, d: Decl, ctx: Ctx)
                 Res<AllocError> {
    d.kind.match({
        Function(f) => local_lambda(f).match({
            Ok(l) => c.own_lambda(o, l, ctx, true, false),
            None  => Ok,
        }),
        _           => Ok,
    })
}

// The value is read before the target is written: `f = consume f` reads
// a live `f` and leaves a dead one.
own_bind = (c :: Checker, o :: Own, b: Bind, ctx: Ctx) Res<AllocError> {
    c.own_expr(o, b.value, ctx).try();
    c.check_drop_copy(o, b, ctx).try();
    c.own_target(o, b, ctx).try();
}

own_target = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
             Res<AllocError> {
    node = c.tree.expr_at(b.target);
    c.check_write_place(o, b.target).try();
    c.release_stored_arena(o, b.target, b.value).try();
    c.check_arena_stored(o, b.target, b.value).try();
    node.kind.match({
        Name(n)   => c.bind_name(o, b, n.text, node.span, ctx),
        Access(a) => c.revive_field(o, a, b.value, ctx),
        Index(_)  => {
            c.flow_bind(o, b, ctx).try();
            c.own_expr(o, b.target, ctx)
        },
        _         => c.own_expr(o, b.target, ctx),
    })
}

bind_name = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<AllocError> {
    o.find_var(text).match({
        Ok(i) => {
            value = Provenance(
                scoped: c.is_scope_value(b.value) || c.scope_alias(o, b.value),
                arena: c.stored_arena_backed(o, b.target, b.value),
                source: c.arena_source(o, b.value),
                fields: c.value_fields(o, b.value).try()
            );
            c.refuse_deferred_write(o, span, i).try();
            o.revive(i, "").try();
            o.assign_provenance(i, value);
            Ok
        },
        None  => c.declare_var(o, b, text, span, ctx),
    })
}

declare_var = (
    c    :: Checker,
    o    :: Own,
    b    : Bind,
    text : str,
    span : Span,
    ctx  : Ctx
) Res<AllocError> {
    o.vars.add(OwnVar(
        name: text,
        ty: c.memo_type(b.value),
        mutable: b.mutable,
        owned: true,
        scoped: c.is_scope_value(b.value) || c.scope_alias(o, b.value),
        arena: c.stored_arena_backed(o, b.target, b.value),
        source: c.arena_source(o, b.value),
        fields: c.value_fields(o, b.value).try(),
        span: span
    ))
}

revive_field = (c :: Checker, o :: Own, a: Access, value: ExprId, ctx: Ctx)
               Res<AllocError> {
    c.path_root(o, a.base).match({
        None  => Ok,
        Ok(i) => {
            origin = Provenance(
                scoped: c.is_scope_value(value) || c.scope_alias(o, value),
                arena: c.stored_arena_backed(o, a.base, value),
                source: c.arena_source(o, value),
                fields: c.value_fields(o, value).try()
            );
            c.refuse_deferred_write(o, c.tree.expr_at(a.base).span, i).try();
            c.assign_access(o, i, a, origin).try();
            o.revive(i, a.name.text)
        },
    }).try();
    c.own_expr(o, a.base, ctx).try();
}

own_expr = (c :: Checker, o :: Own, id: ExprId, ctx: Ctx)
           Res<AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)       => c.use_name(o, node, id, n.text),
        Access(a)     => c.use_access(o, node, id, a, ctx),
        Consume(x)    => c.own_consume(o, x, ctx),
        Call(k)       => c.own_call(o, id, k, ctx),
        Match(m)      => c.own_match(o, m, ctx),
        Lambda(l)     => c.own_lambda(o, l, ctx, false, false),
        Block(b)      => c.own_block(o, b, ctx),
        Paren(p)      => c.own_expr(o, p.inner, ctx),
        Try(t)        => c.own_try(o, t, ctx),
        Unary(u)      => c.own_expr(o, u.operand, ctx),
        Binary(bi)    => c.own_binary(o, bi, ctx),
        Index(x)      => c.own_pair(o, x.base, x.index, ctx),
        Array(a)      => c.own_elems(o, a.elems, ctx),
        FixedArray(a) => c.own_elems(o, a.elems, ctx),
        Record(r)     => c.own_record(o, r.entries, ctx),
        _             => Ok,
    })
}

// A left-leaning operator chain is walked iteratively, leftmost first.
own_binary = (c :: Checker, o :: Own, first: Binary, ctx: Ctx)
             Res<AllocError> {
    rights ::= o.alloc.Vec<ExprId>();
    left   ::= first.lhs;
    done   ::= false;
    rights.add(first.rhs).try();
    loop(() { done == false }, (h) {
        c.tree.expr_at(left).kind.match({
            Binary(next) => {
                rights.add(next.rhs).try();
                left = next.lhs;
            },
            _            => { done = true; },
        });
    });
    c.own_expr(o, left, ctx).try();
    Range(0, rights.len).loop((h, i) {
        c.opt_expr(o, rights.get(rights.len - 1 - i), ctx).try();
    });
    Ok
}

own_try = (c :: Checker, o :: Own, t: Try, ctx: Ctx)
          Res<AllocError> {
    c.own_expr(o, t.operand, ctx).try();
    c.opt_expr(o, t.error, ctx)
}

own_pair = (c :: Checker, o :: Own, a: ExprId, b: ExprId, ctx: Ctx)
           Res<AllocError> {
    c.own_expr(o, a, ctx).try();
    c.own_expr(o, b, ctx).try();
}

own_elems = (c :: Checker, o :: Own, elems: Vec<ExprId>, ctx: Ctx)
            Res<AllocError> {
    elems.loop((h, e) { c.own_expr(o, e, ctx).try() });
    Ok;
}

own_record = (c :: Checker, o :: Own, entries: Vec<Member>, ctx: Ctx)
             Res<AllocError> {
    entries.loop((h, m) { c.own_member_value(o, m, ctx).try() });
    Ok;
}

own_member_value = (c :: Checker, o :: Own, m: Member, ctx: Ctx)
                   Res<AllocError> {
    m.kind.match({
        Field(f)    => c.opt_expr(o, f.value, ctx),
        Const(k)    => c.own_expr(o, k.value, ctx),
        Function(_) => Ok,
    })
}

opt_expr = (c :: Checker, o :: Own, e: Res<ExprId>, ctx: Ctx)
           Res<AllocError> {
    e.match({ Ok(x) => c.own_expr(o, x, ctx), None => Ok })
}

// A moved place cannot be used again.
use_name = (c :: Checker, o :: Own, node: Expr, id: ExprId, text: str)
           Res<AllocError> {
    c.check_scope_captured(o, node.span, text).try();
    c.pin_captured(o, node, text).try();
    c.refuse_handle_captured(o, id, text).try();
    o.find_var(text).match({
        None  => Ok,
        Ok(i) => c.report_if_dead(o, node.span, i, ""),
    })
}

use_access = (
    c    :: Checker,
    o    :: Own,
    node : Expr,
    id   : ExprId,
    a    : Access,
    ctx  : Ctx
) Res<AllocError> {
    c.refuse_handle_captured(o, id, c.spelled_name(a.base)).try();
    c.path_root(o, a.base).match({
        None  => Ok,
        Ok(i) => c.report_if_dead(o, node.span, i, a.name.text),
    }).try();
    c.own_expr(o, a.base, ctx).try();
}

report_if_dead = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<AllocError> {
    o.is_dead(root, field).match({
        false => Ok,
        true  => c.report_consumed(o, span, root, field),
    })
}

report_consumed = (
    c     :: Checker,
    o     :: Own,
    span  : Span,
    root  : usize,
    field : str
) Res<AllocError> {
    name        = c.place_name(o, root, field).try();
    invalidated = o.dead.find((p) {
        p.root == root && p.field.eq(field) && p.invalidated
    }).match({ None => false, Ok(_) => true });
    c.refuse(span, invalidated.match({
        true  => SemaFault.ArenaInvalidated(NameFault(name: name)),
        false => SemaFault.ConsumedUse(NameFault(name: name)),
    }))
}

// `consume` moves only a place owned by the current frame.
own_consume = (c :: Checker, o :: Own, x: Consume, ctx: Ctx)
              Res<AllocError> {
    node = c.tree.expr_at(x.operand);
    node.kind.match({
        Paren(p)  => c.own_consume(o, Consume(operand: p.inner), ctx),
        Index(_)  => c.refuse(
            node.span,
            SemaFault.ConsumeNotAPlace(NameFault(name: ""))
        ),
        Name(n)   => c.consume_name(o, x.operand, n.text),
        Access(a) => c.consume_field(o, node, a, ctx),
        _         => c.own_expr(o, x.operand, ctx),
    })
}

consume_name = (c :: Checker, o :: Own, id: ExprId, text: str)
               Res<AllocError> {
    node = c.tree.expr_at(id);
    c.use_name(o, node, id, text).try();
    c.refuse_pinned(o, node.span, text).try();
    o.find_var(text).match({
        None  => Ok,
        Ok(i) => o.kill(i, "", node.span),
    }).try();
}

consume_field = (c :: Checker, o :: Own, node: Expr, a: Access, ctx: Ctx)
                Res<AllocError> {
    c.path_root(o, a.base).match({
        None  => c.own_expr(o, a.base, ctx),
        Ok(i) => c.consume_field_of(o, node, a, i),
    })
}

consume_field_of = (
    c    :: Checker,
    o    :: Own,
    node : Expr,
    a    : Access,
    root : usize
) Res<AllocError> {
    o.owned_at(root).match({
        false => c.refuse(
            node.span,
            SemaFault.ConsumeThroughHandle(NameFault(name: a.name.text))
        ),
        true  => c.kill_field(o, node, a, root),
    })
}

kill_field = (c :: Checker, o :: Own, node: Expr, a: Access, root: usize)
             Res<AllocError> {
    c.report_if_dead(o, node.span, root, a.name.text).try();
    c.refuse_pinned_at(o, node.span, root).try();
    o.kill(root, a.name.text, node.span).try();
}

check_partial_moves = (c :: Checker, o :: Own, mark: usize)
                      Res<AllocError> {
    Range(mark, o.vars.len).loop((h, i) {
        c.check_partial_move(o, i).try();
    });
    Ok;
}

check_partial_move = (c :: Checker, o :: Own, i: usize)
                     Res<AllocError> {
    (o.has_dead_field(i) && (o.is_dead(i, "") == false)).match({
        false => Ok,
        true  => c.report_partial(o, i),
    })
}

report_partial = (c :: Checker, o :: Own, i: usize) Res<AllocError> {
    o.vars.get(i).match({
        None  => Ok,
        Ok(v) => c.refuse(
            v.span,
            SemaFault.PartiallyMoved(NameFault(name: v.name))
        ),
    })
}

// calls: the receiver rule, `@scope` as an argument, and closure bodies
own_call = (c :: Checker, o :: Own, id: ExprId, k: Call, ctx: Ctx)
           Res<AllocError> {
    c.check_receiver(o, k, ctx).try();
    c.check_lent_args(o, id, k).try();
    c.check_lent_fields(o, id, k).try();
    c.check_scope_stored(id, k).try();
    c.own_expr(o, k.callee, ctx).try();
    c.own_args(o, id, k, ctx).try();
    c.pin_views(o, id, k).try();
    c.call_stores(o, id, k).try();
    c.own_destruction(o, id, k).try();
}

// Only the standard Drop requirement ends an owner's lifetime. A same-named
// inherent operation or unrelated interface does not carry this contract.
own_destruction = (c :: Checker, o :: Own, id: ExprId, k: Call)
                  Res<AllocError> {
    c.resolved_member_provider(id).match({
        None      => Ok,
        Ok(bound) => c.types.at(bound).match({
            Named(n) => c.world.is_core_decl(n.decl, "Drop").try().match({
                false => Ok,
                true  => c.drop_receiver(k).match({
                    None         => Ok,
                    Ok(receiver) => c.destroy_owner(o, id, receiver),
                }),
            }),
            _        => Ok,
        }),
    })
}

drop_receiver = (c: Checker, k: Call) Res<ExprId> {
    k.args.get(0).match({
        Ok(arg) => Ok(arg.value),
        None    => c.tree.call_callee(k).kind.match({
            Access(a) => Ok(a.base),
            _         => None,
        }),
    })
}

destroy_owner = (c :: Checker, o :: Own, id: ExprId, receiver: ExprId)
                Res<AllocError> {
    c.tree.expr_at(receiver).kind.match({
        Paren(p)   => c.destroy_owner(o, id, p.inner),
        Consume(x) => {
            owned = c.path_root(o, x.operand).match({
                None => true, Ok(root) => o.owned_at(root),
            });
            (owned && c.is_drop_type(c.place_type(o, x.operand)).try()).match({
                false => c.refuse(
                    c.tree.expr_at(receiver).span,
                    SemaFault.ExplicitDropBorrow(NameFault(name: c.spelled_name(
                        x.operand
                    )))
                ),
                true  => {
                    c.is_arena_backed(o, x.operand).then(() {
                        o.invalidate_arena(
                            c.arena_source(o, x.operand),
                            c.tree.expr_at(id).span
                        ).try();
                    });
                    Ok
                },
            })
        },
        // Fields are not recursively dropped. Their owner explicitly destroys
        // them and remains responsible for restoring any live field afterward.
        Access(_)  => Ok,
        _          => c.refuse(
            c.tree.expr_at(receiver).span,
            SemaFault.ExplicitDropBorrow(NameFault(name: c.spelled_name(
                receiver
            )))
        ),
    })
}

// A place a bound value is built over is recorded once the record may be
// kept: the call's result can hold a bound, or the callee can store one
// through a `::` parameter (`sema_pin.pin_viewed` says what that holds the
// place to). `text.dup(arena)` keeps nothing — the record lives only for
// the call.
pin_views = (c :: Checker, o :: Own, id: ExprId, k: Call) Res<AllocError> {
    c.builds_view(k).match({
        false => Ok,
        true  => (c.stores_through(id) || c.carries_bound(c.place_type(o, id)).try()).match({
            false => Ok,
            true  => c.pin_view_args(o, k),
        }),
    })
}

builds_view = (c: Checker, k: Call) bool {
    receiver = c.tree.expr_at(k.callee).kind.match({
        Access(a) => c.is_bound_view(a.base),
        _         => false,
    });
    receiver || k.args.find((a) { c.is_bound_view(a.value) }).match({
        Ok(_) => true,
        None  => false,
    })
}

is_bound_view = (c: Checker, id: ExprId) bool {
    c.bound_views.get(id).match({ Ok(_) => true, None => false })
}

// Any `::` parameter may receive what the callee was given.
stores_through = (c: Checker, id: ExprId) bool {
    c.resolved_call(id).match({
        None    => true,
        Ok(did) => c.tree.decl_at(did).match({
            None    => true,
            Ok(dec) => dec.kind.match({
                Function(f) => f.params.find(
                    (p) { p.mutable }
                ).match({ Ok(_) => true, None => false }),
                _           => true,
            }),
        }),
    })
}

pin_view_args = (c :: Checker, o :: Own, k: Call) Res<AllocError> {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => c.pin_viewed(o, a.base),
        _         => Ok,
    }).try();
    k.args.loop((h, a) { c.pin_viewed(o, a.value).try() });
    Ok;
}

own_args = (c :: Checker, o :: Own, id: ExprId, k: Call, ctx: Ctx)
           Res<AllocError> {
    repeats = c.repeating_body(id).try();
    escapes = c.call_escapes(o, k);
    outer   = o.deferring;
    (c.defers_body(o, k) && (outer == 0)).then(() {
        o.deferring     = o.vars.len;
        o.deferring_out = !c.defers_on_own_scope(k);
    });
    k.args.loop((h, a) { c.own_arg(o, a, repeats, escapes, ctx).try() });
    o.deferring = outer;
    Ok;
}

// `Scope.defer` runs its closure when the block ends, after every later
// statement of the block.
defers_body = (c :: Checker, o :: Own, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => a.name.text.eq("defer") && (c.is_scope_value(a.base) || c.types.at(c.place_type(o, a.base)).match({
            Named(n) => c.types.is_scope(n),
            _        => false,
        })),
        _         => false,
    })
}

defers_on_own_scope = (c :: Checker, k: Call) bool {
    c.tree.expr_at(k.callee).kind.match({
        Access(a) => c.is_scope_value(a.base),
        _         => false,
    })
}

own_arg = (
    c       :: Checker,
    o       :: Own,
    a       : Arg,
    repeats : bool,
    escapes : bool,
    ctx     : Ctx
) Res<AllocError> {
    c.spelled_lambda(a.value).match({
        Ok(l) => c.own_lambda(o, l, ctx, repeats, escapes),
        None  => c.own_expr(o, a.value, ctx),
    })
}

// Only the resolved standard conditional guarantees at most one invocation.
// A source-local method with the same spelling has no such contract.
repeating_body* = (c :: Checker, id: ExprId) Res<bool, AllocError> {
    c.resolved_call(id).match({
        None     => Ok(true),
        Ok(decl) => c.world.module_name(decl).eq("std.core.bool").match({
            false => Ok(true),
            true  => Ok(!c.world.is_core_decl(decl, "then").try()),
        }),
    })
}

own_lambda = (
    c       :: Checker,
    o       :: Own,
    l       : Lambda,
    ctx     : Ctx,
    repeats : bool,
    escapes : bool
) Res<AllocError> {
    repeats.then(() { c.loop_provenance(o, l, ctx).try() });
    before ::= o.provenance().try();
    entry     = o.dead_state().try();
    vmark     = o.vars.len;
    outer     = o.escaped;
    o.escaped = (escapes && (outer == 0)).match({
        false => outer,
        true  => vmark,
    });
    l.params.loop((h, p) { c.own_param(o, p).try() });
    c.own_block(o, l.body, ctx).try();
    o.escaped = outer;
    o.release(vmark).try();
    o.join_provenance(before).try();
    o.restore_provenance(before);
    repeats.then(() { c.report_back_edge(o, entry).try() });
    // The body may not run at all, so what was dead before it stays dead.
    o.join_dead(entry).try();
    Ok;
}

// Solve loop-carried origins before the diagnostic walk. This transfer walk
// changes provenance only: moves, captures, and diagnostics run exactly once.
loop_provenance = (c :: Checker, o :: Own, l: Lambda, ctx: Ctx)
                  Res<AllocError> {
    stable ::= false;
    loop(() { !stable }, (h) {
        before ::= o.provenance().try();
        previous = o.provenance().try();
        mark     = o.vars.len;
        l.params.loop((h, p) { c.own_param(o, p).try() });
        c.flow_block(o, l.body, ctx).try();
        truncate(o.vars, mark);
        o.join_provenance(before).try();
        o.restore_provenance(before);
        stable = o.provenance_eq(previous);
    });
    Ok
}

flow_block = (c :: Checker, o :: Own, id: BlockId, ctx: Ctx)
             Res<AllocError> {
    block = c.tree.block_at(id);
    mark  = o.vars.len;
    block.stmts.loop((h, stmt) {
        stmt.kind.match({
            Bind(b)     => {
                c.flow_expr(o, b.value, ctx).try();
                c.flow_bind(o, b, ctx).try();
            },
            Deferred(d) => c.own_deferred(o, d, ctx).try(),
            Expr(e)     => c.flow_expr(o, e.expr, ctx).try(),
            Block(b)    => c.flow_block(o, b, ctx).try(),
            Decl(_)     => (),
        });
    });
    block.value.match({
        None => (), Ok(value) => c.flow_expr(o, value, ctx).try(),
    });
    c.remember_block_origin(o, id, block).try();
    truncate(o.vars, mark);
}

flow_bind = (c :: Checker, o :: Own, b: Bind, ctx: Ctx)
            Res<AllocError> {
    c.release_stored_arena(o, b.target, b.value).try();
    node  = c.tree.expr_at(b.target);
    value = Provenance(
        scoped: c.is_scope_value(b.value) || c.scope_alias(o, b.value),
        arena: c.stored_arena_backed(o, b.target, b.value),
        source: c.arena_source(o, b.value),
        fields: c.value_fields(o, b.value).try()
    );
    node.kind.match({
        Name(n)   => o.find_var(n.text).match({
            None  => c.declare_var(o, b, n.text, node.span, ctx).try(),
            Ok(i) => o.assign_provenance(i, value),
        }),
        Access(a) => c.path_root(o, a.base).match({
            None  => (),
            Ok(i) => c.assign_access(o, i, a, value).try(),
        }),
        Index(x)  => c.path_root(o, x.base).match({
            None => (), Ok(i) => o.taint_root(i, value),
        }),
        _         => (),
    });
}

flow_expr = (c :: Checker, o :: Own, id: ExprId, ctx: Ctx)
            Res<AllocError> {
    c.tree.expr_at(id).kind.match({
        Block(b)      => c.flow_block(o, b, ctx).try(),
        Paren(p)      => c.flow_expr(o, p.inner, ctx).try(),
        Try(t)        => {
            c.flow_expr(o, t.operand, ctx).try();
            t.error.match({ None => (), Ok(e) => c.flow_expr(
                o,
                e,
                ctx
            ).try() });
        },
        Unary(u)      => c.flow_expr(o, u.operand, ctx).try(),
        Binary(b)     => c.flow_binary(o, b, ctx).try(),
        Access(a)     => c.flow_expr(o, a.base, ctx).try(),
        Index(x)      => {
            c.flow_expr(o, x.base, ctx).try();
            c.flow_expr(o, x.index, ctx).try();
        },
        Array(a)      => a.elems.loop((h, e) { c.flow_expr(o, e, ctx).try() }),
        FixedArray(a) => a.elems.loop((h, e) { c.flow_expr(o, e, ctx).try() }),
        Call(k)       => {
            c.flow_expr(o, k.callee, ctx).try();
            k.args.loop((h, a) {
                c.spelled_lambda(a.value).match({
                    None  => c.flow_expr(o, a.value, ctx).try(),
                    Ok(l) => c.repeating_body(id).try().match({
                        true  => c.loop_provenance(o, l, ctx).try(),
                        false => {
                            before ::= o.provenance().try();
                            mark = o.vars.len;
                            l.params.loop((h, p) { c.own_param(o, p).try() });
                            c.flow_block(o, l.body, ctx).try();
                            truncate(o.vars, mark);
                            o.join_provenance(before).try();
                            o.restore_provenance(before);
                        },
                    }),
                });
            });
            c.transfer_call_stores(o, id, k).try();
        },
        Match(m)      => {
            c.flow_expr(o, m.scrutinee, ctx).try();
            before ::= o.provenance().try();
            joined ::= o.provenance().try();
            m.arms.loop((h, arm) {
                o.restore_provenance(before);
                c.flow_expr(o, arm.body, ctx).try();
                o.join_provenance(joined).try();
            });
            o.restore_provenance(joined);
        },
        _             => (),
    });
}

// Preserve left-to-right transfers without recursing down a binary spine.
flow_binary = (c :: Checker, o :: Own, first: Binary, ctx: Ctx)
              Res<AllocError> {
    rights ::= o.alloc.Vec<ExprId>();
    left   ::= first.lhs;
    done   ::= false;
    rights.add(first.rhs).try();
    loop(() { !done }, (h) {
        c.tree.expr_at(left).kind.match({
            Binary(next) => {
                rights.add(next.rhs).try();
                left = next.lhs;
            },
            _            => { done = true; },
        });
    });
    c.flow_expr(o, left, ctx).try();
    Range(0, rights.len).loop((h, i) {
        rights.get(rights.len - 1 - i).match({
            None => (), Ok(value) => c.flow_expr(o, value, ctx).try(),
        });
    });
    Ok
}

// Everything the body leaves dead that was live on entry names a binding
// the body did not declare, and a second run would read it dead.
report_back_edge = (c :: Checker, o :: Own, entry: Vec<Place>)
                   Res<AllocError> {
    o.newly_dead(entry).try().loop((h, p) {
        p.invalidated.match({
            true  => c.report_consumed(o, p.span, p.root, p.field).try(),
            false => c.refuse(p.span, SemaFault.ConsumedPerRun(NameFault(
                name: c.place_name(o, p.root, p.field).try()
            ))).try(),
        });
    });
    Ok;
}

// match: each arm starts from the scrutinee's state, and a place dead at
// the end of any arm is dead after the match.
own_match = (c :: Checker, o :: Own, m: Match, ctx: Ctx)
            Res<AllocError> {
    c.own_expr(o, m.scrutinee, ctx).try();
    entry  = o.dead_state().try();
    before = o.provenance().try();
    origins ::= c.alloc.Vec<Provenance>();
    before.loop((h, _) {
        origins.add(Provenance(
            scoped: false,
            arena: false,
            source: None,
            fields: o.alloc.Vec<FieldOrigin>()
        )).try();
    });
    joined ::= c.alloc.Vec<Place>();
    m.arms.loop((h, a) {
        o.restore_provenance(before);
        o.set_dead(entry).try();
        c.own_expr(o, a.body, ctx).try();
        o.join_provenance(origins).try();
        out = o.dead_state().try();
        o.set_dead(joined).try();
        o.join_dead(out).try();
        joined = o.dead_state().try();
    });
    o.restore_provenance(origins);
    (m.arms.len == 0).match({
        true  => o.set_dead(entry).try(),
        false => o.set_dead(joined).try(),
    });
    Ok;
}

// The binding a place path is rooted at, or nothing when the path is not
// one this frame names.
path_root* = (c :: Checker, o :: Own, id: ExprId) Res<usize> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)   => o.find_var(n.text),
        Paren(p)  => c.path_root(o, p.inner),
        Access(a) => c.path_root(o, a.base),
        Index(x)  => c.path_root(o, x.base),
        _         => None,
    })
}

// A loop handle read from inside an escaping closure.
refuse_handle_captured = (c :: Checker, o :: Own, id: ExprId, text: str)
                         Res<AllocError> {
    o.find_var(text).match({
        None  => Ok,
        Ok(i) => ((i < o.escaped) && c.is_handle_ty(c.memo_type(id))).match({
            false => Ok,
            true  => c.refuse_handle_at(id),
        }),
    })
}

// `p.left`, joined: the place the author wrote, and the only spelling
// that says which half of `p` is gone.
place_name* = (c :: Checker, o :: Own, root: usize, field: str)
             Res<str, AllocError> {
    base = o.vars.get(root).match({ Ok(v) => v.name, None => "" });
    (field.len == 0).match({
        true  => Ok(base),
        false => c.dotted_name(base, field),
    })
}

dotted_name = (c :: Checker, base: str, field: str) Res<str, AllocError> {
    out ::= c.alloc.String("{base}.{field}").try();
    Ok(out.view());
}

memo_type = (c :: Checker, id: ExprId) TyId {
    c.expr_memo.get(id).match({ Ok(ty) => ty, None => UNRESOLVED })
}

// A place's type: recorded for a name, memoized for everything else.
place_type* = (c :: Checker, o :: Own, id: ExprId) TyId {
    node = c.tree.expr_at(id);
    node.kind.match({
        Name(n)  => o.var_type(n.text),
        Paren(p) => c.place_type(o, p.inner),
        _        => c.memo_type(id),
    })
}

same_source = (left: Res<ExprId>, right: Res<ExprId>) bool {
    left.match({
        None  => right.match({ None => true, Ok(_) => false }),
        Ok(l) => right.match({ None => false, Ok(r) => l.index == r.index }),
    })
}

joined_source* = (
    left_local  : bool,
    left        : Res<ExprId>,
    right_local : bool,
    right       : Res<ExprId>
) Res<ExprId> {
    left_local.match({
        false => right,
        true  => (!right_local || same_source(left, right)).match({
            true => left, false => None,
        }),
    })
}

may_share_source = (left: Res<ExprId>, right: Res<ExprId>) bool {
    left.match({
        None  => true,
        Ok(l) => right.match({ None => true, Ok(r) => l.index == r.index }),
    })
}

// Named construction fields have independent origins even when another
// field in the same record borrows temporary storage.
value_fields = (c :: Checker, o :: Own, value: ExprId)
               Res<Vec<FieldOrigin>, AllocError> {
    fields ::= o.alloc.Vec<FieldOrigin>();
    c.tree.expr_at(value).kind.match({
        Name(n)        => o.var_at(n.text).when_ok((row) { fields = row.fields; }),
        Paren(p)       => { fields = c.value_fields(o, p.inner).try(); },
        Try(t)         => { fields = c.value_fields(o, t.operand).try(); },
        Access(access) => {
            c.value_fields(o, access.base).try().loop((field) {
                strip_path(field.name, access.name.text).when_ok((suffix) {
                    fields.add(FieldOrigin(
                        name: suffix,
                        scoped: field.scoped,
                        arena: field.arena,
                        source: field.source
                    )).try();
                });
            });
        },
        Call(call)     => c.is_construction(value).match({
            true  => call.args.loop((arg) {
                arg.name.when_ok((name) {
                    view = c.stored_view(o, arg.value, None);
                    fields.add(FieldOrigin(
                        name: name.text,
                        scoped: view.scoped,
                        arena: view.arena,
                        source: view.source
                    )).try();
                    c.value_fields(o, arg.value).try().loop((field) {
                        fields.add(FieldOrigin(
                            name: append_path(
                                o.alloc,
                                name.text,
                                field.name
                            ).try(),
                            scoped: field.scoped,
                            arena: field.arena,
                            source: field.source
                        )).try();
                    });
                });
            }),
            false => c.store_effects.selected_summary(c, value).when_ok((summary) {
                summary.returns.loop((returned) {
                    view = c.returned_view(o, value, call, returned.field).ok_or(AllocError.OutOfMemory).try();
                    (!returned.field.is_empty()).then(() {
                        fields.include_field(FieldOrigin(
                            name: returned.field,
                            scoped: view.scoped,
                            arena: view.arena,
                            source: view.source
                        )).try();
                    });
                    c.inherit_fields(
                        o,
                        value,
                        call,
                        summary.function,
                        returned,
                        fields
                    ).try();
                });
            }),
        }),
        _              => (),
    });
    Ok(fields)
}

// Return paths are interpreted in the caller, using the chosen declaration's
// parameter identities. A missing summary retains conservative call behavior.
returned_view* = (
    c    :: Checker,
    o    :: Own,
    id   : ExprId,
    call : Call,
    path : str
) Res<StoredView> {
    copy_allocation(c, id, call).match({
        Ok(allocation) => Ok(c.stored_view(o, allocation, None)),
        None           => c.summarized_view(o, id, call, path),
    })
}

summarized_view = (
    c    :: Checker,
    o    :: Own,
    id   : ExprId,
    call : Call,
    path : str
) Res<StoredView> {
    summary  = c.store_effects.selected_summary(c, id).try();
    returned = summary.returns.find((value) { value.field.eq(path) }).try();
    view ::= StoredView(scoped: false, arena: false, source: None);
    returned.sources.loop((source) {
        actual(c, id, call, summary.function, source.parameter).when_ok((argument) {
            drawn = c.stored_view(o, argument, source.field);
            // The result keeps a bound view only if its type can hold one.
            (drawn.arena && c.sheds_frame_view(o, id, drawn.source)).match({
                true  => (),
                false => { view = view.join(drawn); },
            });
        });
    });
    Ok(view)
}

// Match a flat field path against syntax without allocating during queries.
path_matches = (c: Checker, id: ExprId, path: str) bool {
    c.tree.expr_at(id).kind.match({
        Name(_)        => path.is_empty(),
        Paren(p)       => c.path_matches(p.inner, path),
        Access(access) => {
            name = access.name.text;
            (path.len >= name.len).match({
                false => false,
                true  => {
                    offset = path.len - name.len;
                    path.slice(offset, path.len).eq(name) && (offset == 0).match({
                        true  => c.path_matches(access.base, ""),
                        false => path.index(offset - 1) == '.' && c.path_matches(access.base, path.slice(0, offset - 1)),
                    })
                },
            })
        },
        _              => false,
    })
}

access_view* = (c :: Checker, o :: Own, id: ExprId) StoredView {
    found: Res<FieldOrigin> = c.path_root(o, id).match({
        None     => None,
        Ok(root) => o.vars.get(root).match({
            None    => None,
            Ok(row) => row.fields.find(
                (field) { c.path_matches(id, field.name) }
            ),
        }),
    });
    found.match({
        Ok(field) => StoredView(
            scoped: field.scoped,
            arena: field.arena,
            source: field.source
        ),
        None      => c.tree.expr_at(id).kind.match({
            Access(access) => c.stored_view(o, access.base, None),
            _              => StoredView(
                scoped: false,
                arena: false,
                source: None
            ),
        }),
    })
}

include_field = (
    fields :: Vec<FieldOrigin>,
    field  : FieldOrigin
) Res<AllocError> {
    index = Range(0, fields.len).find((i) {
        fields.get(i).match({ None => false, Ok(prior) => prior.name.eq(field.name) })
    });
    index.match({
        None  => fields.add(field),
        Ok(i) => {
            prior = fields.get(i).ok_or(AllocError.OutOfMemory).try();
            fields.set(
                i,
                FieldOrigin(
                    name: field.name,
                    scoped: prior.scoped || field.scoped,
                    arena: prior.arena || field.arena,
                    source: joined_source(
                        prior.arena,
                        prior.source,
                        field.arena,
                        field.source
                    )
                )
            );
            Ok
        },
    })
}

projection_path = (c: Checker, id: ExprId) Res<Res<str>, AllocError> {
    c.tree.expr_at(id).kind.match({
        Name(_)        => Ok(Ok("")),
        Paren(paren)   => c.projection_path(paren.inner),
        Access(access) => c.projection_path(access.base).try().match({
            None       => Ok(None),
            Ok(prefix) => Ok(Ok(
                append_path(c.alloc, prefix, access.name.text).try()
            )),
        }),
        _              => Ok(None),
    })
}

assign_access = (
    c      : Checker,
    o      :: Own,
    root   : usize,
    access : Access,
    value  : Provenance
)
                Res<AllocError> {
    c.projection_path(access.base).try().match({
        None       => o.taint_root(root, value),
        Ok(prefix) => o.assign_field(
            root,
            append_path(o.alloc, prefix, access.name.text).try(),
            value
        ),
    })
}

inherit_fields = (
    c        :: Checker,
    o        :: Own,
    value    : ExprId,
    call     : Call,
    function : Function,
    returned : Returned,
    fields   :: Vec<FieldOrigin>
) Res<AllocError> {
returned.sources.loop((source) {
                        source.projectable.then(() {
                            actual(c, value, call, function, source.parameter).when_ok((argument) {
                                c.value_fields(o, argument).try().loop((field) {
                                    suffix = source.field.match({
                                        None => Ok(field.name), Ok(path) => strip_path(field.name, path),
                                    });
                                    suffix.when_ok((tail) {
                                        fields.include_field(FieldOrigin(
                                            name: append_path(
                                                o.alloc,
                                                returned.field,
                                                tail
                                            ).try(),
                                            scoped: field.scoped,
                                            arena: field.arena,
                                            source: field.source
                                        )).try();
                                    });
                                });
                            });
                        });
                    });
    Ok
}
