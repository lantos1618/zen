{ Expr, ExprId, Bind, Deferred, Access } = std.ast
{ AllocError } = std.mem
{ str } = std.text
{ TyId, TyArray, literal_default } = sema.sema_ty
{ Checker, Ctx, Binding } = sema.sema_check
{ SemaFault, NameFault, PairFault, TypeValueFault } = sema.sema_diag
{ computed_member, writable_member } = sema.sema_member
{ check_literal } = sema.sema_trap
{ const_def, const_int } = sema.sema_const
{ check_arms, check_arms_agree } = sema.sema_hoist
{ type_of } = sema.sema_type
{ type_from_ast } = sema.sema_denote
{ settle_variant_at } = sema.sema_apply
{ refuse_handle_value } = sema.sema_handle
{ Res, Ok, None } = std.core

bind_stmt* = (c :: Checker, b: Bind, ctx: Ctx) Res<TyId, AllocError> {
    got = c.type_of(b.value, ctx).try();
    c.refuse_type_value(b.value, ctx).try();
    c.refuse_handle_value(b.value, got).try();
    want    = c.check_rebound(b).try().match({
        true  => c.types.unknown(),
        false => c.bind_want(b, got, ctx),
    }).try();
    settled = c.settle_variant_at(b.value, got, want, ctx).try();
    c.check_assign(b, settled, want, ctx).try();
    c.refuse_bare_none(b, want).try();
    c.bind_target(b, want, ctx).try();
    c.types.prim("()")
}

// `x = Foo;` binds a type where a value belongs. A type's name reaches
// value position as a constructor or as a member's base, never alone, so
// the binding is refused here rather than left to a backend with nothing to
// lower.
refuse_type_value = (c :: Checker, id: ExprId, ctx: Ctx) Res<AllocError> {
    node = c.tree.expr_at(id);
    node.kind.match({
        Paren(p) => c.refuse_type_value(p.inner, ctx),
        Name(n)  => c.lookup(n.text).match({
            Ok(_) => Ok,
            None  => c.world.first_def_of(ctx.module, n.text).try().match({
                None  => Ok,
                Ok(d) => d.kind.match({
                    StructDef => c.refuse(
                        node.span,
                        SemaFault.TypeNotAValue(TypeValueFault(
                            name: n.text,
                            record: true
                        ))
                    ),
                    EnumDef   => c.refuse(
                        node.span,
                        SemaFault.TypeNotAValue(TypeValueFault(
                            name: n.text,
                            record: false
                        ))
                    ),
                    _         => Ok,
                }),
            }),
        }),
        _        => Ok,
    })
}

// `x :: T;` and `x: T;` bind the name with its written type and no value.
// sema_init proves each read follows an assignment on every path.
deferred_stmt* = (c :: Checker, d: Deferred, ctx: Ctx) Res<TyId, AllocError> {
    ty     = c.type_from_ast(d.type, ctx).try();
    target = c.tree.expr_at(d.target);
    target.kind.match({
        Name(n) => c.bind_deferred(n.text, ty, d.mutable, target.span),
        _       => Ok,
    }).try();
    c.types.prim("()")
}

// An unannotated declaration takes its initializer's type, and a binding's
// type never changes after its declaration. A bare `None` names no payload
// type, so nothing could ever supply the payload the storage needs.
refuse_bare_none = (c :: Checker, b: Bind, want: TyId) Res<AllocError> {
    written = b.type.match({ Ok(_) => true, None => false });
    stores  = c.assign_binding(b).match({ Ok(_) => true, None => false });
    target  = c.tree.expr_at(b.target);
    target.kind.match({
        Name(n) => (!written && !stores && c.is_bare_none(want)).then(() {
            c.refuse(
                target.span,
                SemaFault.BareNoneBinding(NameFault(name: n.text))
            ).try();
        }),
        _       => (),
    });
    Ok;
}

// A bare `None` is an absence whose payload nothing has named.
is_bare_none = (c: Checker, ty: TyId) bool {
    c.types.at(ty).match({
        Res(r) => r.form.match({ Absence => c.is_infer(r.value), _ => false }),
        _      => false,
    })
}

// Only plain `=` with no written type can mean a write. Mutable or explicitly
// typed forms always declare.
plain_write = (b: Bind) bool {
    written = b.type.match({ Ok(_) => true, None => false });
    (b.mutable == false) && (written == false)
}

// The existing binding a plain-name write targets. This predicate must
// stay identical to the backend's store classification.
assign_binding = (c :: Checker, b: Bind) Res<Binding> {
    plain_write(b).match({
        false => None,
        true  => c.tree.expr_at(b.target).kind.match({
            Name(n) => c.lookup(n.text),
            _       => None,
        }),
    })
}

// A second immutable `=` binding of one name in the same block; both
// sites are reported. `lookup_here` leaves shadowing in nested blocks legal.
check_rebound = (c :: Checker, b: Bind) Res<bool, AllocError> {
    c.rebound_of(b).match({
        None    => Ok(false),
        Ok(old) => c.report_rebound(b, old),
    })
}

rebound_of = (c :: Checker, b: Bind) Res<Binding> {
    plain_write(b).match({
        false => None,
        true  => c.tree.expr_at(b.target).kind.match({
            Name(n) => settled_binding(c.lookup_here(n.text)),
            _       => None,
        }),
    })
}

// A mutable first binding is writable and therefore not a rebound fault, and
// a deferred one is waiting for exactly this write.
settled_binding = (found: Res<Binding>) Res<Binding> {
    found.match({
        Ok(old) => (old.mutable || old.deferred).match({
            true  => None,
            false => Ok(old),
        }),
        None    => None,
    })
}

report_rebound = (c :: Checker, b: Bind, old: Binding)
                 Res<bool, AllocError> {
    target = c.tree.expr_at(b.target);
    c.refuse(
        target.span,
        SemaFault.Rebound(PairFault(
            name: old.name,
            first: old.span,
            second: target.span,
        ))
    ).try();
    Ok(true);
}

bind_want = (c :: Checker, b: Bind, got: TyId, ctx: Ctx)
             Res<TyId, AllocError> {
    b.type.match({
        Ok(t) => c.type_from_ast(t, ctx),
        None  => c.assign_binding(b).match({
            Ok(old) => c.store_want(old.ty, got),
            None    => c.place_want(b.target, got, ctx),
        }),
    })
}

store_want = (c :: Checker, old: TyId, got: TyId) Res<TyId, AllocError> {
    (c.is_literal_ty(old) && c.assignable(old, got)).match({
        true  => Ok(got),
        false => Ok(old),
    })
}

place_want = (c :: Checker, id: ExprId, got: TyId, ctx: Ctx)
              Res<TyId, AllocError> {
    c.tree.expr_at(id).kind.match({
        Name(_) => c.settled_array(got),
        _       => c.type_of(id, ctx),
    })
}

settled_array* = (c :: Checker, ty: TyId) Res<TyId, AllocError> {
    c.types.at(ty).match({
        Array(a) => c.settled_elem(ty, a),
        _        => Ok(ty),
    })
}

settled_elem = (c :: Checker, ty: TyId, a: TyArray) Res<TyId, AllocError> {
    elem = c.is_literal_ty(a.elem).match({
        true  => c.types.prim(literal_default(c.prim_name(a.elem))),
        false => c.settled_array(a.elem),
    }).try();
    elem.eq(a.elem).match({
        true  => Ok(ty),
        false => c.types.array(elem, a.count),
    })
}

check_assign = (c :: Checker, b: Bind, got: TyId, want: TyId, ctx: Ctx)
               Res<AllocError> {
    node = c.tree.expr_at(b.value);
    (c.assignable(got, want) || c.nullary_settles(got, want)).match({
        true  => Ok,
        false => c.mismatch(node.span.file, node.span, got, want, ""),
    }).try();
    // `literal_fits` accepts every integer literal for every integer
    // type; the value is checked against the width here.
    c.check_literal(b.value, want).try();
    c.written_want(b, want).try();
}

written_want = (c :: Checker, b: Bind, want: TyId) Res<AllocError> {
    b.type.match({
        Ok(_) => c.check_arms(b.value, want),
        None  => c.check_arms_agree(b.value),
    })
}

bind_target = (c :: Checker, b: Bind, ty: TyId, ctx: Ctx)
              Res<AllocError> {
    target = c.tree.expr_at(b.target);
    target.kind.match({
        Name(n)   => c.bind_name(b, n.text, target, ty, ctx),
        Access(a) => c.assign_access(target, a, ctx),
        _         => Ok,
    }).try();
}

// A write introduces no binding; a plain `=` on no local is a fresh
// binding unless a module constant already owns the name.
bind_name = (
    c      :: Checker,
    b      : Bind,
    name   : str,
    target : Expr,
    ty     : TyId,
    ctx    : Ctx
)
           Res<AllocError> {
    c.assign_binding(b).match({
        Ok(old) => c.refuse_immutable_store(b, old, target),
        None    => c.fresh_or_refused(b, name, target, ty, ctx),
    })
}

// A write to an immutable local from a nested block, an arm, or a closure
// that captures it is the same fault a field write through `:` is. The same
// block already reports it as a rebinding, and a deferred local's one
// assignment is sema_init's to check.
refuse_immutable_store = (c :: Checker, b: Bind, old: Binding, target: Expr)
                         Res<AllocError> {
    same_block = c.rebound_of(b).match({ Ok(_) => true, None => false });
    (old.mutable || old.deferred || same_block).match({
        true  => Ok,
        false => c.refuse(
            target.span,
            SemaFault.ImmutableWrite(NameFault(name: old.name))
        ),
    })
}

fresh_or_refused = (
    c      :: Checker,
    b      : Bind,
    name   : str,
    target : Expr,
    ty     : TyId,
    ctx    : Ctx
)
                   Res<AllocError> {
    plain_write(b).match({
        false => c.bind_fresh(b, name, target, ty),
        true  => c.const_def(name, ctx).try().match({
            Ok(_) => c.refuse(
                target.span,
                SemaFault.ImmutableWrite(NameFault(name: name))
            ),
            None  => c.bind_fresh(b, name, target, ty),
        }),
    })
}

// An immutable binding of an untyped integer literal keeps the literal's
// value, so a use that wants a type checks the value exactly as it would
// check the literal written there.
bind_fresh = (c :: Checker, b: Bind, name: str, target: Expr, ty: TyId)
             Res<AllocError> {
    held: Res<i64> = (!b.mutable && c.prim_name(ty).eq("int")).match({
        true  => c.const_int(b.value),
        false => None,
    });
    held.match({
        Ok(v) => c.bind_held(name, ty, v, target.span),
        None  => c.bind_at(name, ty, b.mutable, false, target.span),
    })
}

// `c.width = 5` on an impl-supplied field: there is nothing to assign
// into.
assign_access = (c :: Checker, target: Expr, a: Access, ctx: Ctx)
                Res<AllocError> {
    c.writable_member(a, ctx).try();
    c.computed_member(a, ctx).try().match({
        true  => c.no_storage(target, a),
        false => Ok,
    })
}

no_storage = (c :: Checker, target: Expr, a: Access) Res<AllocError> {
    c.refuse(
        target.span,
        SemaFault.ComputedFieldAssign(NameFault(name: a.name.text))
    )
}
