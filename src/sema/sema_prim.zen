// Machine primitives: wide multiplication, explicit truncation, the
// std.simd vector operations and the std.ct value barrier.
// Like numeric conversions, only validated bodyless declarations in the
// owning standard modules acquire an operation. Backends consume the
// recorded Primitive by declaration identity, never by a callee's spelling.
Function, ExprId = std.ast
AllocError = std.mem
Vec = std.collections
str, String = std.text
Range = std.core
Checker, Ctx = sema.sema_check
TyId, is_vector, vector_lane, vector_lanes = sema.sema_ty
Def = sema.sema_def
param_type, ret_type = sema.sema_denote
SemaFault, NameFault = sema.sema_diag

// `params` are the declared parameter types in order, receiver first.
Primitive* = { name*: str, params*: Vec<TyId>, result*: TyId }

// Modules whose bodyless declarations must all be supported primitives.
primitive_module* = (module: str) bool {
    module.is_in(["std.core.num", "std.simd", "std.ct.ct"])
}

// Names no other module may declare without a body: a local declaration
// must not manufacture a truncating cast or a wide multiply.
reserved_primitive = (name: str) bool {
    name.eq("mul_wide") || name.starts_with("truncate_")
        || name.eq("compiler_barrier") || name.eq("value_barrier")
        || name.eq("declassify_barrier")
}

primitive_signature* = (c :: Checker, d: Def, f: Function)
                       Res<(), AllocError> {
    module = c.world.module_name(d.id);
    (primitive_module(module) || reserved_primitive(f.name.text)).match({
        false => Ok(()),
        true  => c.primitive_declaration(d, f, module),
    })
}

primitive_declaration = (c :: Checker, d: Def, f: Function, module: str)
                        Res<(), AllocError> {
    ctx = Ctx(d.id.module.to_usize(), c.types.unknown().try());
    params ::= c.alloc.Vec<TyId>();
    names  ::= c.alloc.Vec<String>();
    fixed  ::= f.exported && f.tparams.len == 0;
    f.params.loop((p) {
        fixed = fixed && !p.mutable;
        t     = c.param_type(p, ctx).try();
        params.add(t).try();
        names.add(c.types.name_of(t).try()).try();
    });
    result = c.ret_type(f, ctx).try();
    shown ::= c.types.name_of(result).try();
    shape = module.match({
        "std.simd"        => vector_shape(f.name.text, names, shown.view()),
        "std.mem.mem_ptr" => f.name.text.eq("compiler_barrier")
            && names.len == 0 && shown.view().eq("()"),
        "std.ct.ct"       => barrier_shape(f.name.text, names, shown.view()),
        _                 => primitive_shape(f.name.text, names, shown.view()),
    });
    owner = primitive_module(module) || module.eq("std.mem.mem_ptr");
    (fixed && owner && shape).match({
        false => c.report(
            d.span.file,
            d.span,
            SemaFault.InvalidPrimitive(NameFault(name: d.name))
        ),
        true  => c.primitives.set(
            d.id,
            Primitive(name: f.name.text, params: params, result: result)
        ),
    })
}

type_at* = (names: Vec<String>, i: usize) str {
    names.get(i).match({ Ok(n) => n.view(), None => "" })
}

primitive_shape = (name: str, ps: Vec<String>, r: str) bool {
    name.eq("mul_wide").match({
        true  => ps.len == 2 && type_at(ps, 0).eq("u64")
            && type_at(ps, 1).eq("u64") && r.eq("u128"),
        false => name.starts_with("truncate_") && ps.len == 1
            && r.eq(name.slice(9, name.len)) && narrows(type_at(ps, 0), r),
    })
}

// std.ct.value_barrier returns its unsigned word unchanged, but the optimizer
// may assume nothing about the result: the constant-time helpers rely on it
// to stop a mask from being turned back into a branch. declassify_barrier is
// the same barrier, also naming its register in the assembly so tools/ct
// knows the value is public from there on.
barrier_shape = (name: str, ps: Vec<String>, r: str) bool {
    (name.eq("value_barrier") || name.eq("declassify_barrier")) && ps.len == 1 && unsigned_width(type_at(ps, 0)) > 0
        && r.eq(type_at(ps, 0))
}

// Bit width of an unsigned word; zero for anything else. usize follows the
// current 64-bit targets, as in std.core.num.
unsigned_width* = (name: str) usize {
    name.match({
        "u8"    => 8,
        "u16"   => 16,
        "u32"   => 32,
        "u64"   => 64,
        "usize" => 64,
        "u128"  => 128,
        _       => 0,
    })
}

// Truncation keeps the low bits of a strictly wider unsigned word. Its
// destination is a fixed-width word so the result does not depend on usize.
narrows = (source: str, target: str) bool {
    target.is_in(["u8", "u16", "u32", "u64"])
        && unsigned_width(target) > 0
        && unsigned_width(target) < unsigned_width(source)
}

// std.simd: V is a vector, E its lane type, N its lane count. Constructors
// name their vector (`splat_u32x4`); operations overload on the receiver.
vector_shape = (name: str, ps: Vec<String>, r: str) bool {
    v = type_at(ps, 0);
    e = vector_lane(v);
    n = vector_lanes(v);
    name.match({
        "store"     => is_vector(v) && ps.len == 3
            && type_at(ps, 1).eq("Ptr<u8>") && type_at(ps, 2).eq("usize")
            && r.eq("()"),
        "lane"      => is_vector(v) && ps.len == 2
            && type_at(ps, 1).eq("usize") && r.eq(e),
        "with_lane" => is_vector(v) && ps.len == 3
            && type_at(ps, 1).eq("usize") && type_at(ps, 2).eq(e) && r.eq(v),
        "shuffle"   => is_vector(v) && ps.len == 2
            && is_pattern(type_at(ps, 1), n) && r.eq(v),
        "shuffle2"  => is_vector(v) && ps.len == 3 && type_at(ps, 1).eq(v)
            && is_pattern(type_at(ps, 2), n) && r.eq(v),
        _           => lane_shape(name, ps, r)
            || constructor_shape(name, ps, r) || feature_shape(name, ps, r)
            || cast_shape(name, ps, r),
    })
}

// Lane-wise arithmetic wraps; shifts and rotations take one usize count.
lane_shape = (name: str, ps: Vec<String>, r: str) bool {
    v       = type_at(ps, 0);
    binary  = name.is_in(["add_wrap", "sub_wrap", "mul_wrap", "bit_xor", "bit_and", "bit_or"]) || (name.eq("mul_low32") && vector_lane(v).eq("u64"));
    counted = name.is_in([
        "shift_left", "shift_right", "rotate_left", "rotate_right"
    ]);
    second  = binary.match({ true => v, false => "usize" });
    (binary || counted) && is_vector(v) && ps.len == 2
        && type_at(ps, 1).eq(second) && r.eq(v)
}

constructor_shape = (name: str, ps: Vec<String>, r: str) bool {
    e = vector_lane(r);
    n = vector_lanes(r);
    is_vector(r) && constructor_of(name, r, ps, e, n)
}

constructor_of = (name: str, r: str, ps: Vec<String>, e: str, n: usize) bool {
    name.ends_with(r) && name_head(name, r).match({
        "splat_" => ps.len == 1 && type_at(ps, 0).eq(e),
        "load_"  => ps.len == 2 && type_at(ps, 0).eq("Ptr<u8>")
            && type_at(ps, 1).eq("usize"),
        "lanes_" => ps.len == n && all_lanes(ps, e),
        _        => false,
    })
}

name_head = (name: str, r: str) str {
    (name.len > r.len).match({
        true  => name.slice(0, name.len - r.len),
        false => "",
    })
}

all_lanes = (ps: Vec<String>, e: str) bool {
    ok ::= true;
    ps.loop((p) { ok = ok && p.view().eq(e); });
    ok
}

// A shuffle pattern is a fixed array of N usize lane indices.
is_pattern = (shown: str, n: usize) bool {
    n > 0 && shown.starts_with("[usize, ") && shown.ends_with("]")
        && shown.slice(8, shown.len - 1).parse_usize().match({
            Ok(count) => count == n,
            None      => false,
        })
}

// CPU capabilities are std.simd structs whose values prove that runtime
// detection succeeded. Functions taking one are compiled for the feature.
is_capability* = (name: str) bool {
    name.is_in([
        "Avx2", "Ssse3", "Bmi2", "Aes", "Clmul", "Neon", "ShaNi", "ArmSha2",
        "ArmSha512"
    ])
}

forged_capability* = (c :: Checker, id: ExprId, d: Def, ctx: Ctx)
                     Res<(), AllocError> {
    owned = c.world.module_name(d.id).eq("std.simd") && is_capability(d.name);
    (owned && !c.world.name_at(ctx.module).eq("std.simd")).match({
        false => Ok(()),
        true  => {
            span = c.tree.expr_at(id).span;
            c.report(
                span.file,
                span,
                SemaFault.ForgedCapability(NameFault(name: d.name))
            )
        },
    })
}

// CPU detection and the instructions a capability unlocks.
feature_shape = (name: str, ps: Vec<String>, r: str) bool {
    name.match({
        "cpu_avx2"       => ps.len == 0 && r.eq("bool"),
        "cpu_ssse3"      => ps.len == 0 && r.eq("bool"),
        "cpu_bmi2"       => ps.len == 0 && r.eq("bool"),
        "cpu_aes"        => ps.len == 0 && r.eq("bool"),
        "cpu_clmul"      => ps.len == 0 && r.eq("bool"),
        "cpu_neon"       => ps.len == 0 && r.eq("bool"),
        "cpu_sha_ni"     => ps.len == 0 && r.eq("bool"),
        "cpu_arm_sha2"   => ps.len == 0 && r.eq("bool"),
        "cpu_arm_sha512" => ps.len == 0 && r.eq("bool"),
        "aes_round"      => aes_shape(ps, r),
        "aes_round_last" => aes_shape(ps, r),
        "clmul_low"      => clmul_shape(ps, r),
        "clmul_high"     => clmul_shape(ps, r),
        _                => sha_shape(name, ps, r),
    })
}

// The SHA instructions: every operand and the result are one vector type,
// followed by the capability of the instruction's architecture.
sha_shape = (name: str, ps: Vec<String>, r: str) bool {
    name.match({
        "sha256_rnds2" => instruction_shape(ps, r, "u32x4", 3, "ShaNi"),
        "sha256_msg1"  => instruction_shape(ps, r, "u32x4", 2, "ShaNi"),
        "sha256_msg2"  => instruction_shape(ps, r, "u32x4", 2, "ShaNi"),
        "sha256h"      => instruction_shape(ps, r, "u32x4", 3, "ArmSha2"),
        "sha256h2"     => instruction_shape(ps, r, "u32x4", 3, "ArmSha2"),
        "sha256su0"    => instruction_shape(ps, r, "u32x4", 2, "ArmSha2"),
        "sha256su1"    => instruction_shape(ps, r, "u32x4", 3, "ArmSha2"),
        "sha512h"      => instruction_shape(ps, r, "u64x2", 3, "ArmSha512"),
        "sha512h2"     => instruction_shape(ps, r, "u64x2", 3, "ArmSha512"),
        "sha512su0"    => instruction_shape(ps, r, "u64x2", 2, "ArmSha512"),
        "sha512su1"    => instruction_shape(ps, r, "u64x2", 3, "ArmSha512"),
        _              => false,
    })
}

instruction_shape = (
    ps       : Vec<String>,
    r        : str,
    v        : str,
    operands : usize,
    cpu      : str
) bool {
    same ::= ps.len == operands + 1 && r.eq(v);
    Range(0, operands).loop((i) { same = same && type_at(ps, i).eq(v); });
    same && type_at(ps, operands).eq(cpu)
}

aes_shape = (ps: Vec<String>, r: str) bool {
    ps.len == 3 && type_at(ps, 0).eq("u8x16") && type_at(ps, 1).eq("u8x16")
        && type_at(ps, 2).eq("Aes") && r.eq("u8x16")
}

clmul_shape = (ps: Vec<String>, r: str) bool {
    ps.len == 3 && type_at(ps, 0).eq("u64x2") && type_at(ps, 1).eq("u64x2")
        && type_at(ps, 2).eq("Clmul") && r.eq("u64x2")
}

// `v.cast_u64x2()`: the same bytes viewed as another vector of equal size.
cast_shape = (name: str, ps: Vec<String>, r: str) bool {
    from = type_at(ps, 0);
    name.starts_with("cast_") && name.slice(5, name.len).eq(r) && ps.len == 1
        && is_vector(from) && is_vector(r) && !from.eq(r)
        && vector_bytes(from) == vector_bytes(r)
}

vector_bytes* = (name: str) usize {
    vector_lanes(name) * unsigned_width(vector_lane(name)) / 8
}
