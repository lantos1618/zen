// The secret discipline (docs/DESIGN.md, "Secret values").
//
// `std.ct.Secret<T>` is T to the type checker; this pass gives it meaning.
// For one function body it computes which expressions are secret (derived
// from a value whose written type mentions Secret), then refuses every use
// whose timing or address pattern would depend on one: a branch, a short
// circuit, a loop bound, an index or shift count, a division, checked
// arithmetic, an ordinary comparison, or a secret leaving through a
// parameter or result that is not itself written Secret.
//
// The analysis is intraprocedural and flow-insensitive over local bindings:
// names are resolved through block and closure scopes to the binding they
// denote, and a binding that is ever bound or written from a secret is
// secret everywhere in the body, closures included. It iterates the walk until that set stops
// growing, then walks once more to report. std.ct is not checked (it builds
// the masks), and a program that never loads std.ct pays nothing.
ExprId, BlockId, TypeId, Span, Function, Param, Decl, Call, Arg = std.ast
Bind, Binary, Expr = std.ast
WalkVisitor, WalkEvent, WalkNode = std.ast
Alloc, AllocError = std.mem
Vec, Map = std.collections
str = std.text
Range = std.core
DeclId = sema.sema_id
TyId = sema.sema_ty
Checker = sema.sema_check
decl_at = sema.sema_def
SemaFault, NameFault = sema.sema_diag

SECRET_MODULE: str = "std.ct.ct"

// One refusal, reported after the final walk.
Refusal = { span: Span, fault: SemaFault }

// What the discipline knows about a parameter: whether it is written
// Secret, and whether a write through it reaches the caller (a `::`
// binding, or a pointer).
ParamFacts = { name: str, secret: bool, escapes: bool }

// A binding in scope during the walk. Keys are stable across passes:
// parameter i is i; a local is BINDING + its target expression; a closure
// parameter is CLOSURE + its closure expression * 256 + its position.
Local = { name: str, key: u64, mutable: bool }

BINDING: u64 = 1099511627776
CLOSURE: u64 = 2199023255552

// The callee of one checked call, when it is a declared function.
Callee = { function: Function, module: str, module_index: usize, name: str, shift: usize }

check_secret* = (c :: Checker, f: Function, body: BlockId, mi: usize)
                Res<(), AllocError> {
    loaded = c.world.index_of(SECRET_MODULE).match({
        Ok(_) => true,
        None  => false,
    });
    (loaded && !c.world.name_at(mi).eq(SECRET_MODULE)).match({
        false => Ok(()),
        true  => c.scan_body(f, body, mi),
    })
}

scan_body = (c :: Checker, f: Function, body: BlockId, mi: usize)
            Res<(), AllocError> {
    scan ::= SecretScan(
        check: c,
        alloc: c.alloc,
        module: mi,
        base: c.alloc.Vec<Local>(),
        scope: c.alloc.Vec<Local>(),
        marks: c.alloc.Vec<usize>(),
        secrets: c.alloc.Vec<u64>(),
        params: c.alloc.Vec<ParamFacts>(),
        taint: c.alloc.Map<ExprId, bool>(),
        grew: false,
        seen: false,
        reporting: false,
        refusals: c.alloc.Vec<Refusal>()
    );
    f.params.loop((h, i, p) {
        key     = i.to_u64();
        secret  = p.type.match({
            Ok(t) => c.written_secret(t, mi),
            None  => false,
        });
        escapes = p.mutable || p.type.match({
            Ok(t) => c.written_pointer(t),
            None  => false,
        });
        scan.params.add(ParamFacts(
            name: p.name.text,
            secret: secret,
            escapes: escapes
        )).try();
        scan.base.add(Local(
            name: p.name.text,
            key: key,
            mutable: p.mutable
        )).try();
        secret.then(() { scan.secrets.add(key).try(); });
    });
    // Grow the secret bindings to a fixed point, then report once.
    loop((h) {
        scan.grew = false;
        scan.restart().try();
        c.tree.walk(c.alloc, WalkNode.Block(body), scan).try();
        (!scan.grew).then(() { h.break(); });
    });
    (scan.seen || scan.secrets.len > 0).match({
        false => Ok(()),
        true  => c.report_secrets(f, body, mi, scan),
    })
}

report_secrets = (
    c    :: Checker,
    f    : Function,
    body : BlockId,
    mi   : usize,
    scan :: SecretScan
)
                 Res<(), AllocError> {
    scan.reporting = true;
    scan.restart().try();
    c.tree.walk(c.alloc, WalkNode.Block(body), scan).try();
    // A unit result carries nothing, so only a valued result can leak.
    public_result = f.ret.match({
        Ok(t) => !c.written_secret(t, mi) && !c.tree.type_at(t).kind.match({ Unit => true, _ => false }),
        None  => false,
    });
    c.tail_expr(c.tree.block_at(body)).when_ok((value) {
        (public_result && scan.secret(value)).then(() {
            scan.refuse(
                value,
                SemaFault.SecretResult(NameFault(name: f.name.text))
            ).try();
        });
    });
    scan.refusals.loop((r) { c.report(r.span.file, r.span, r.fault).try(); });
    Ok(())
}

// Whether a written type mentions std.ct's Secret anywhere, read in the
// module that wrote it. The C backend asks the same question to mark secret
// parameters for tools/ct.
written_secret* = (c: Checker, t: TypeId, mi: usize) bool {
    c.tree.type_at(t).kind.match({
        Named(n) => (n.name.text.eq("Secret") && c.names_std_secret(mi))
            || n.args.find((a) { c.written_secret(a, mi) }).match({
                Ok(_) => true,
                None  => false,
            }),
        Array(a) => c.written_secret(a.elem, mi),
        Union(u) => u.members.find((m) { c.written_secret(m, mi) }).match({
            Ok(_) => true,
            None  => false,
        }),
        _        => false,
    })
}

names_std_secret = (c: Checker, mi: usize) bool {
    c.world.first_def_of(mi, "Secret").match({
        Ok(found) => found.match({
            Ok(d) => c.world.module_name(d.id).eq(SECRET_MODULE),
            None  => false,
        }),
        Err(_)    => false,
    })
}

// A pointer, or a Secret pointer: the address is public, the pointee is
// what the marker describes.
written_pointer* = (c: Checker, t: TypeId) bool {
    c.tree.type_at(t).kind.match({
        Named(n) => n.name.text.eq("Ptr") || (n.name.text.eq("Secret")
            && n.args.find((a) { c.written_pointer(a) }).match({
                Ok(_) => true,
                None  => false,
            })),
        _        => false,
    })
}

SecretScan = {
    check: Checker,
    alloc: Alloc,
    module: usize,
    // The parameters, which open every pass's scope.
    base :: Vec<Local>,
    scope :: Vec<Local>,
    marks :: Vec<usize>,
    secrets :: Vec<u64>,
    params :: Vec<ParamFacts>,
    taint :: Map<ExprId, bool>,
    grew :: bool,
    // Whether any expression was secret: a body with none needs no report.
    seen :: bool,
    reporting :: bool,
    refusals :: Vec<Refusal>,

    secret = (self: @Self, id: ExprId) bool { self.taint.get(id).value_or(false) }

    restart = (self :: @Self) Res<(), AllocError> {
        self.taint = self.alloc.Map<ExprId, bool>();
        self.scope = self.base.map(self.alloc, (l) { l }).try();
        self.marks = self.alloc.Vec<usize>();
        Ok(())
    }

    // The innermost binding of `name`, if it is a local or a parameter.
    resolve = (self: @Self, name: str) Res<Local> {
        at ::= self.scope.len;
        found: Res<Local> = loop<Local>((h) {
            (at == 0).then(() { h.break(); });
            at    = at - 1;
            local = self.scope.get(at).ok_or(AllocError.OutOfMemory).match({
                Ok(l)  => l,
                Err(_) => Local(name: "", key: 0, mutable: false),
            });
            local.name.eq(name).then(() { h.break(local); });
        });
        found
    }

    is_secret_key = (self: @Self, key: u64) bool {
        self.secrets.find(
            (k) { k == key }
        ).match({ Ok(_) => true, None => false })
    }

    secret_name = (self: @Self, name: str) bool {
        self.resolve(name).match({ Ok(l) => self.is_secret_key(l.key), None => false })
    }

    mark_key = (self :: @Self, key: u64) Res<(), AllocError> {
        (!self.is_secret_key(key)).then(() {
            self.secrets.add(key).try();
            self.grew = true;
        });
        Ok(())
    }

    open_scope = (self :: @Self) Res<(), AllocError> { self.marks.add(
        self.scope.len
    ) }

    close_scope = (self :: @Self) Res<(), AllocError> {
        mark = self.marks.take(self.marks.len - 1).ok_or(AllocError.OutOfMemory).try();
        loop(() { self.scope.len > mark }, (h) {
            self.scope.take(self.scope.len - 1).ok_or(AllocError.OutOfMemory).try();
        });
        Ok(())
    }

    // A closure's parameters are fresh bindings; they are secret only when
    // something secret is written to them, which the loop overloads do not.
    open_closure = (self :: @Self, id: ExprId, params: Vec<Param>) Res<(), AllocError> {
        self.open_scope().try();
        params.loop((h, i, p) {
            key = CLOSURE +% id.index.to_u64() *% 256 +% i.to_u64();
            self.scope.add(Local(
                name: p.name.text,
                key: key,
                mutable: p.mutable
            )).try();
        });
        Ok(())
    }

    refuse = (self :: @Self, id: ExprId, fault: SemaFault) Res<(), AllocError> {
        self.refuse_at(self.check.tree.expr_at(id).span, fault)
    }

    refuse_at = (self :: @Self, span: Span, fault: SemaFault) Res<(), AllocError> {
        self.reporting.match({
            false => Ok(()),
            true  => self.refusals.add(Refusal(span: span, fault: fault)),
        })
    }

    // The first secret name read by an expression, for the diagnostic.
    culprit = (self: @Self, id: ExprId) str {
        self.check.tree.expr_at(id).kind.match({
            Name(n)   => self.secret_name(n.text).match({
                true  => n.text,
                false => "",
            }),
            Paren(p)  => self.culprit(p.inner),
            Access(a) => self.culprit(a.base),
            Index(i)  => self.culprit(i.base),
            Unary(u)  => self.culprit(u.operand),
            Binary(b) => self.culprit(b.lhs).is_empty().match({
                true  => self.culprit(b.rhs),
                false => self.culprit(b.lhs),
            }),
            Call(c)   => self.call_culprit(c),
            _         => "",
        })
    }

    call_culprit = (self: @Self, c: Call) str {
        found ::= self.culprit(c.callee);
        c.args.loop((a) {
            found.is_empty().then(() { found = self.culprit(a.value); });
        });
        found
    }

    fault = (self: @Self, id: ExprId) NameFault { NameFault(name: self.culprit(
        id
    )) }

    // The facts of a parameter binding; None for any other binding.
    param_facts = (self: @Self, key: u64) Res<ParamFacts> {
        (key < BINDING).ensure().try();
        self.params.get(key.to_usize().try())
    }

    // The local binding a place expression writes through, if any.
    root = (self: @Self, id: ExprId) Res<str> {
        self.check.tree.expr_at(id).kind.match({
            Name(n)   => Ok(n.text),
            Paren(p)  => self.root(p.inner),
            Access(a) => self.root(a.base),
            Index(i)  => self.root(i.base),
            Call(c)   => self.check.tree.expr_at(c.callee).kind.match({
                Access(a) => self.root(a.base),
                _         => None,
            }),
            _         => None,
        })
    }

    // A secret stored into `target` makes its root secret; a root that is a
    // public parameter would carry the secret out to the caller.
    store = (self :: @Self, target: ExprId, at: ExprId) Res<(), AllocError> {
        self.root(target).when_ok((name) {
            self.resolve(name).when_ok((local) {
                self.param_facts(local.key).when_ok((p) {
                    (p.escapes && !p.secret).then(() {
                        self.refuse(
                            at,
                            SemaFault.SecretStore(NameFault(name: name))
                        ).try();
                    });
                });
                self.mark_key(local.key).try();
            });
        });
        Ok(())
    }

    // Whether a field read yields a value written Secret in its struct.
    secret_field = (self: @Self, base: ExprId, field: str) bool {
        self.check.expr_memo.get(base).match({
            None   => false,
            Ok(ty) => self.check.types.at(ty).match({
                Named(n) => decl_at(self.check.tree, n.decl).match({
                    None  => false,
                    Ok(d) => d.kind.match({
                        Struct(s) => s.members.find((m) {
                            m.named(field) && m.kind.match({
                                Field(fl) => fl.type.match({
                                    Ok(t) => self.check.written_secret(
                                        t,
                                        n.decl.module.to_usize()
                                    ),
                                    None  => false,
                                }),
                                _         => false,
                            })
                        }).match({ Ok(_) => true, None => false }),
                        _         => false,
                    }),
                }),
                _        => false,
            }),
        })
    }

    callee = (self: @Self, id: ExprId, c: Call) Res<Callee> {
        checked      = self.check.checked_call(id).try();
        declared     = checked.declaration.try();
        shift: usize = checked.signature.match({
            Ok(sig) => sig.receiver.match({ Ok(_) => 1, None => 0 }),
            None    => 0,
        });
        name         = self.check.tree.expr_at(c.callee).kind.match({
            Name(n)   => n.text,
            Access(a) => a.name.text,
            _         => "",
        });
        mi           = declared.module.to_usize();
        module       = self.check.world.module_name(declared);
        decl         = decl_at(self.check.tree, declared).try();
        function     = decl.kind.match({
            Function(f) => Ok(f),
            Struct(s)   => s.members.find((m) {
                m.named(name) && m.kind.match({
                    Function(f) => f.params.len == c.args.len + shift,
                    _           => false,
                })
            }).match({
                Ok(m) => m.kind.match({ Function(f) => Ok(f), _ => None }),
                None  => None,
            }),
            _           => None,
        }).try();
        Ok(Callee(
            function: function,
            module: module,
            module_index: mi,
            name: name,
            shift: shift
        ))
    }

    // The argument expression bound to parameter `i` (receiver first).
    argument = (self: @Self, id: ExprId, c: Call, i: usize) Res<ExprId> {
        receiver = self.check.checked_call(id).match({
            Ok(checked) => checked.signature.match({
                Ok(sig) => sig.receiver,
                None    => None,
            }),
            None        => None,
        });
        receiver.match({
            Ok(r) => (i == 0).match({
                true  => Ok(r),
                false => c.args.get(i - 1).match({ Ok(a) => Ok(a.value), None => None }),
            }),
            None  => c.args.get(i).match({ Ok(a) => Ok(a.value), None => None }),
        })
    }

    // Is the value computed by this call secret, and is the call allowed?
    call = (self :: @Self, id: ExprId, c: Call) Res<bool, AllocError> {
        inputs ::= self.secret(c.callee);
        c.args.loop((a) { inputs = inputs || self.secret(a.value); });
        self.callee(id, c).match({
            Ok(target) => self.checked_callee(id, c, target, inputs),
            None       => self.pointer_method(c).match({
                Ok(name) => self.pointer_call(id, c, name, inputs),
                None     => Ok(inputs),
            }),
        })
    }

    // Ptr's methods are compiler operations with no recorded declaration;
    // they are recognised by the receiver's type.
    pointer_method = (self: @Self, c: Call) Res<str> {
        self.check.tree.expr_at(c.callee).kind.match({
            Access(a) => self.check.expr_memo.get(a.base).match({
                None   => None,
                Ok(ty) => self.check.types.at(ty).match({
                    Named(n) => self.check.world.module_name(n.decl).eq("std.mem.mem_ptr").match({
                        true  => Ok(a.name.text),
                        false => None,
                    }),
                    _        => None,
                }),
            }),
            _         => None,
        })
    }

    checked_callee = (self :: @Self, id: ExprId, c: Call, target: Callee, inputs: bool)
                     Res<bool, AllocError> {
        declared_secret = target.function.ret.match({
            Ok(t) => self.check.written_secret(t, target.module_index),
            None  => false,
        });
        target.module.match({
            "std.ct.ct"       => Ok(
                !target.name.is_in(["declassify", "declassify_bool"]) && inputs
            ),
            "std.core.num"    => self.numeric_call(id, c, target, inputs),
            "std.mem.mem_ptr" => self.pointer_call(id, c, target.name, inputs),
            "std.simd"        => {
                target.name.is_in(["lane", "with_lane"]).then(() {
                    self.index_argument(id, c, 1).try();
                });
                Ok(inputs)
            },
            _                 => {
                // The callee is checked too: its result is secret only if
                // its signature says so (the result rule refuses the rest).
                self.public_parameters(id, c, target).try();
                Ok(declared_secret)
            },
        })
    }

    index_argument = (self :: @Self, id: ExprId, c: Call, i: usize) Res<(), AllocError> {
        self.argument(id, c, i).when_ok((value) {
            self.secret(value).then(() {
                self.refuse(
                    value,
                    SemaFault.SecretIndex(self.fault(value))
                ).try();
            });
        });
        Ok(())
    }

    // Integer operations are single machine operations, except where their
    // lowering tests the value: a checked conversion (its Res is a branch)
    // and a shift or rotation count (the lowering tests it against the width).
    numeric_call = (self :: @Self, id: ExprId, c: Call, target: Callee, inputs: bool)
                   Res<bool, AllocError> {
        checked = target.function.ret.match({
            Ok(t) => self.check.tree.type_at(t).kind.match({
                Named(n) => n.name.text.eq("Res"),
                _        => false,
            }),
            None  => false,
        });
        (checked && inputs).then(() {
            self.refuse(id, SemaFault.SecretTrap(self.fault(id))).try();
        });
        (target.name.starts_with("shift_") || target.name.starts_with("rotate_")).then(() {
            self.argument(id, c, 1).when_ok((count) {
                self.secret(count).then(() {
                    self.refuse(
                        count,
                        SemaFault.SecretShift(self.fault(count))
                    ).try();
                });
            });
        });
        Ok(inputs)
    }

    // Ptr: the index or offset is an address; the pointee may be secret.
    // Writing a secret makes the pointer's binding secret. Address
    // questions (is_null, same) are public.
    pointer_call = (self :: @Self, id: ExprId, c: Call, name: str, inputs: bool)
                   Res<bool, AllocError> {
        // The first explicit argument of these is an element index or count.
        name.is_in(["read", "write", "offset", "back", "read_volatile", "write_volatile"]).then(() {
            c.args.get(0).when_ok((index) {
                self.secret(index.value).then(() {
                    self.refuse(
                        index.value,
                        SemaFault.SecretIndex(self.fault(index.value))
                    ).try();
                });
            });
        });
        name.is_in(["write", "write_volatile", "copy_from"]).then(() {
            written = c.args.find(
                (a) { self.secret(a.value) }
            ).match({ Ok(_) => true, None => false });
            written.then(() { self.store(c.callee, id).try(); });
        });
        Ok(!name.is_in(["is_null", "same"]) && inputs)
    }

    // Every secret argument must meet a parameter written Secret. Loop and
    // one-sided conditionals get the more specific refusal.
    public_parameters = (self :: @Self, id: ExprId, c: Call, target: Callee)
                        Res<(), AllocError> {
        Range(0, target.function.params.len).loop((i) {
            self.argument(id, c, i).when_ok((value) {
                p            = target.function.params.get(i).ok_or(AllocError.OutOfMemory).try();
                secret_param = p.type.match({
                    Ok(t) => self.check.written_secret(t, target.module_index),
                    None  => false,
                });
                (self.secret(value) && !secret_param).then(() {
                    fault = target.name.match({
                        "then"   => SemaFault.SecretBranch(self.fault(value)),
                        "ensure" => SemaFault.SecretBranch(self.fault(value)),
                        _        => target.name.is_in([
                            "loop", "find", "filter", "all", "any", "map",
                            "fold"
                        ]).match({
                            true  => SemaFault.SecretLoop(self.fault(value)),
                            false => SemaFault.SecretCall(NameFault(
                                name: target.name
                            )),
                        }),
                    });
                    self.refuse(value, fault).try();
                });
            });
        });
        Ok(())
    }

    is_named = (self: @Self, callee: ExprId, name: str) bool {
        self.check.tree.expr_at(callee).kind.match({
            Name(n) => n.text.eq(name),
            _       => false,
        })
    }

    // `loop(() { condition }, body)`: the condition's value decides when the
    // loop stops.
    loop_condition = (self :: @Self, c: Call) Res<(), AllocError> {
        c.args.get(0).when_ok((first) {
            self.check.tree.expr_at(first.value).kind.match({
                Lambda(l) => self.check.tail_expr(self.check.tree.block_at(l.body)).when_ok((tail) {
                    self.secret(tail).then(() {
                        self.refuse(
                            tail,
                            SemaFault.SecretLoop(self.fault(tail))
                        ).try();
                    });
                }),
                _         => (),
            });
        });
        Ok(())
    }

    binary = (self :: @Self, id: ExprId, b: Binary) Res<bool, AllocError> {
        either   = self.secret(b.lhs) || self.secret(b.rhs);
        logic    = b.op.match({ And => true, Or => true, _ => false });
        divides  = b.op.match({ Div => true, Rem => true, _ => false });
        traps    = b.op.match({ Add => true, Sub => true, Mul => true, _ => false });
        compares = b.op.match({
            Equal     => true,
            NotEqual  => true,
            Less      => true,
            LessEq    => true,
            Greater   => true,
            GreaterEq => true,
            _         => false,
        });
        // Short circuits, division and a shift count are refused at the
        // secret operand; trapping arithmetic and comparisons at the operator.
        // `<<` and `>>` are `shift_left` and `shift_right`, so their counts
        // follow `numeric_call`.
        (b.op.is_shift() && self.secret(b.rhs)).then(() {
            self.refuse(b.rhs, SemaFault.SecretShift(self.fault(b.rhs))).try();
        });
        (logic || divides).then(() {
            [ExprId, 2](b.lhs, b.rhs).loop((side) {
                self.secret(side).then(() {
                    fault = logic.match({
                        true  => SemaFault.SecretShortCircuit(self.fault(side)),
                        false => SemaFault.SecretDivide(self.fault(side)),
                    });
                    self.refuse(side, fault).try();
                });
            });
        });
        (either && traps).then(() {
            self.refuse_at(
                b.op_span,
                SemaFault.SecretTrap(self.fault(id))
            ).try();
        });
        (either && compares).then(() {
            self.refuse_at(
                b.op_span,
                SemaFault.SecretCompare(self.fault(id))
            ).try();
        });
        Ok(either)
    }

    // Post-order: children are already known when an expression is left.
    expression = (self :: @Self, id: ExprId) Res<(), AllocError> {
        node         = self.check.tree.expr_at(id);
        secret: bool = node.kind.match({
            Name(n)       => self.secret_name(n.text),
            Paren(p)      => self.secret(p.inner),
            Array(a)      => a.elems.find(
                (e) { self.secret(e) }
            ).match({ Ok(_) => true, None => false }),
            FixedArray(a) => a.elems.find(
                (e) { self.secret(e) }
            ).match({ Ok(_) => true, None => false }),
            Call(c)       => {
                self.is_named(c.callee, "loop").then(() { self.loop_condition(c).try(); });
                self.call(id, c).try()
            },
            Match(m)      => {
                self.secret(m.scrutinee).then(() {
                    self.refuse(
                        m.scrutinee,
                        SemaFault.SecretBranch(self.fault(m.scrutinee))
                    ).try();
                });
                self.secret(m.scrutinee)
                    || m.arms.find(
                        (arm) { self.secret(arm.body) }
                    ).match({ Ok(_) => true, None => false })
            },
            Try(t)        => {
                self.secret(t.operand).then(() {
                    self.refuse(
                        t.operand,
                        SemaFault.SecretBranch(self.fault(t.operand))
                    ).try();
                });
                self.secret(t.operand)
            },
            Record(r)     => r.entries.find((m) {
                m.kind.match({
                    Field(fl) => fl.value.match({ Ok(v) => self.secret(
                        v
                    ), None => false }),
                    _         => false,
                })
            }).match({ Ok(_) => true, None => false }),
            Access(a)     => self.secret(a.base) || self.secret_field(a.base, a.name.text),
            Index(i)      => {
                self.secret(i.index).then(() {
                    self.refuse(
                        i.index,
                        SemaFault.SecretIndex(self.fault(i.index))
                    ).try();
                });
                self.secret(i.base) || self.secret(i.index)
            },
            Unary(u)      => self.secret(u.operand),
            Binary(b)     => self.binary(id, b).try(),
            Consume(c)    => self.secret(c.operand),
            Block(body)   => self.check.tail_expr(self.check.tree.block_at(
                body
            )).match({
                Ok(v) => self.secret(v),
                None  => false,
            }),
            _             => false,
        });
        secret.then(() { self.seen = true; });
        self.taint.set(id, secret)
    }

    // `x = e` assigns when `x` is a mutable binding in scope and the
    // statement declares nothing; otherwise it binds a new `x` here.
    bind = (self :: @Self, b: Bind) Res<(), AllocError> {
        written = b.type.match({
            Ok(t) => self.check.written_secret(t, self.module),
            None  => false,
        });
        tainted = written || self.secret(b.value);
        self.check.tree.expr_at(b.target).kind.match({
            Name(n) => {
                existing = self.resolve(n.text);
                assigns  = !b.mutable && b.type.match({ Ok(_) => false, None => true })
                    && existing.match({ Ok(l) => l.mutable, None => false });
                key      = assigns.match({
                    true  => existing.match({ Ok(l) => l.key, None => 0 }),
                    false => BINDING +% b.target.index.to_u64(),
                });
                (!assigns).then(() {
                    self.scope.add(Local(
                        name: n.text,
                        key: key,
                        mutable: b.mutable
                    )).try();
                });
                tainted.then(() {
                    self.param_facts(key).when_ok((p) {
                        (p.escapes && !p.secret && self.secret(b.value)).then(() {
                            self.refuse(
                                b.value,
                                SemaFault.SecretStore(NameFault(name: n.text))
                            ).try();
                        });
                    });
                    self.mark_key(key).try();
                });
            },
            _       => {
                tainted.then(() { self.store(b.target, b.value).try(); });
            },
        });
        Ok(())
    }
}

SecretScan.impl(WalkVisitor, {
    visit = (self :: @Self, event: WalkEvent) Res<(), AllocError> {
        event.match({
            Enter(node) => node.match({
                Block(_) => self.open_scope().try(),
                Expr(id) => self.check.tree.expr_at(id).kind.match({
                    Lambda(l) => self.open_closure(id, l.params).try(),
                    _         => (),
                }),
                _        => (),
            }),
            Leave(node) => node.match({
                Block(_)     => self.close_scope().try(),
                Expr(id)     => {
                    self.expression(id).try();
                    self.check.tree.expr_at(id).kind.match({
                        Lambda(_) => self.close_scope().try(),
                        _         => (),
                    });
                },
                Statement(s) => s.value.kind.match({
                    Bind(b) => self.bind(b).try(),
                    _       => (),
                }),
                _            => (),
            }),
        });
        Ok(())
    }
})
