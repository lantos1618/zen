Expr, ExprId = std.ast
AllocError = std.mem
Vec = std.collections
Checker, Ctx = sema.sema_check
TyId = sema.sema_ty
type_of = sema.sema_type

// A parent types one operand before anything else: a binary its left operand,
// a paren or unary operator its only one. Typing that chain deepest first
// leaves every parent's first operand a memo hit, so a deeply nested chain
// costs constant host stack.
type_first* = (c :: Checker, id: ExprId, ctx: Ctx) Res<TyId, AllocError> {
    c.spine_ahead(id).match({
        false => Ok(()),
        true  => c.seed_left_spine(id, ctx),
    }).try();
    c.type_of(id, ctx)
}

// Guard the heavier iterative walk; most operands have no chain below them.
spine_ahead = (c: Checker, id: ExprId) bool {
    c.below(id).match({ None => false, Ok(_) => true })
}

seed_left_spine = (c :: Checker, id: ExprId, ctx: Ctx)
                  Res<(), AllocError> {
    spine ::= c.alloc.Vec<ExprId>();
    down  ::= id;
    going ::= true;
    going.loop((h) {
        going = c.below(down).match({
            None     => false,
            Ok(next) => { spine.add(down).try(); down = next; true },
        });
    });
    // The spine was collected top-down, so popping visits it deepest first.
    loop(spine.len > 0, (h) {
        spine.take(spine.len - 1).match({
            None   => c.types.unknown(),
            Ok(at) => c.type_of(at, ctx),
        }).try();
    });
    Ok(());
}

// One step down: the first-typed operand of a node nothing has typed yet,
// and `None` at anything else.
below = (c: Checker, id: ExprId) Res<ExprId> {
    c.expr_memo.get(id).match({
        Ok(_) => None,
        None  => c.tree.expr_at(id).left_of(),
    })
}

left_of = (node: Expr) Res<ExprId> {
    node.kind.match({
        Binary(b) => Ok(b.lhs),
        Paren(p)  => Ok(p.inner),
        Unary(u)  => Ok(u.operand),
        _         => None,
    })
}
