{ MailboxStorage*, MailboxOps* } = std.actor.actor_storage
{ Error } = std.core
ActorError* = { Closed | Full }
ActorError.impl(Error, {})
ActorStartError* = { OutOfMemory | Unavailable }
ActorStartError.impl(Error, {})

// An address to A. Calling one of A's behavior methods through a Ref enqueues
// its arguments as a message; the call never enters actor state directly.
Ref*<A> = {
    id: u64,

    // Close admission, drain accepted messages, then run stopped.
    stop* = (self: @Self) ()

    // Wait until the actor has drained and stopped; concurrent callers share
    // one native join. Calling from this actor returns immediately. External
    // callers must finish before process-wide runtime teardown.
    join* = (self: @Self) ()
}

Actor* = {}
