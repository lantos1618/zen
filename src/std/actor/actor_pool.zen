// Memory for the actor runtime: messages, actor bodies, outboxes and waiter
// nodes come from size classes, so a steady stream of messages allocates
// nothing from the kernel.
//
// Each thread that runs actors keeps its own stack of free block addresses
// per class (`Heap`), touched without atomics. A block may be freed by any
// thread: its address goes onto that thread's own stack, whichever thread
// carved it, and nothing is written into the block, so a block freed by a
// consumer is not pulled back across cores until its next owner writes it.
// A full stack hands its oldest BATCH addresses, copied into a batch array,
// to the class's central stack under a spin lock, and a thread whose stack
// is empty takes a batch back before it carves new memory. So a producer
// whose messages are freed by a consumer on another core pays one lock per
// BATCH messages, not an atomic per message: remote frees are batched.
//
// Blocks carry no header. Memory comes from the kernel in 2 MiB spans cut
// into 64 KiB slabs aligned to 64 KiB, and a slab's first 64 bytes record
// its class, so a block's class is found from its address. A request above
// the largest class gets its own mapping, aligned the same way, whose
// header says so. Mappings up to 4 MiB are rounded to a power of two and,
// once freed, kept in a per-size cache for the next large block, so a
// stream of big messages costs no system calls (and no TLB shootdowns);
// larger ones, and any beyond the cache's bound, are unmapped.

{ Ptr, null_ptr, Mem, Page } = std.mem
{ Res, Ok, Err, None, loop, Range } = std.core
{ mmap, munmap, madvise, map_private_anonymous, pointer_at, address_of, platform_darwin } = std.sys
{ atomic_load_usize, process_block } = std.sys
{ PB_MEM, G_CENTRAL, G_LARGE } = std.actor.actor_layout
{ atomic_swap_u32, atomic_store_u32 } = std.sys

// The address of word `i` of the block at `p`, and plain word access.
word_at* = (p: Ptr<u8>, i: usize) Ptr<usize> { p.to<usize>().offset(i) }

load* = (p: Ptr<u8>, i: usize) usize { p.to<usize>().read(i) }

store* = (p: Ptr<u8>, i: usize, value: usize) { p.to<usize>().write(i, value); }

pointer* = (p: Ptr<u8>, i: usize) Ptr<u8> { pointer_at(load(p, i)) }

// A spin lock on a u32 word: 0 free, 1 held. For short critical sections
// that are rarely contended (central batches, span refills).
lock* = (word: Ptr<u32>) {
    loop(() { atomic_swap_u32(word, 1) != 0 }, (h) {});
}

unlock* = (word: Ptr<u32>) { atomic_store_u32(word, 0); }

SLAB_BYTES: usize = 65536
SPAN_BYTES*: usize = 2097152
// A slab's header: its class, then (for a large block) its mapping's length.
SLAB_HEADER: usize = 64
LARGE: usize = 65535
// Blocks moved between a thread and the central stack at a time.
BATCH: usize = 64

// Bytes per class: 16 to 128 in steps of 16, then four classes per
// doubling up to 16 KiB. Every class is a multiple of 16, so every block is
// 16-byte aligned.
CLASSES*: usize = 36
LARGEST: usize = 16384
SMALL: usize = 128
STEP: usize = 32

class_size = (c: usize) usize {
    (c < 8).match({
        true  => (c + 1) * 16,
        false => {
            k = c - 8;
            g = k / 4;
            (SMALL << g) + (k % 4 + 1) * (STEP << g)
        },
    })
}

// The smallest class that holds `bytes`.
class_of = (bytes: usize) usize {
    (bytes <= 128).match({
        true  => (bytes <= 16).match({ true => 0, false => (bytes + 15) / 16 - 1 }),
        false => {
            g :: usize = 0;
            loop(() { ((SMALL * 2) << g) < bytes }, (h) { g = g + 1; });
            step = STEP << g;
            8 + g * 4 + (bytes - (SMALL << g) + step - 1) / step - 1
        },
    })
}

// A thread's cache: per class, how many free blocks it holds, the slab it
// is carving (next block, end), a spare batch array, then a stack of up to
// CAP free block addresses. Freeing writes the address here, not into the
// block, so a block freed on one core is not read again before its next
// owner writes it.
CAP: usize = 128
HEAP_WORDS: usize = 132
HEAP_BYTES*: usize = 38016

heap_count = (heap: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    heap,
    c * HEAP_WORDS
) }

heap_next = (heap: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    heap,
    c * HEAP_WORDS + 1
) }

heap_end = (heap: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    heap,
    c * HEAP_WORDS + 2
) }

heap_spare = (heap: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    heap,
    c * HEAP_WORDS + 3
) }

heap_stack = (heap: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    heap,
    c * HEAP_WORDS + 4
) }

// The process-wide part, inside the runtime's globals: per class a lock
// word and a stack of batches, then the span being cut into slabs.
//
//     +0                  per class: lock (u32), then the batch stack
//     +CLASSES * 16       the span lock, the next slab, the span's end
CENTRAL_BYTES*: usize = 624

central_lock = (central: Ptr<u8>, c: usize) Ptr<u32> { central.offset(
    c * 16
).to<u32>() }

central_stack = (central: Ptr<u8>, c: usize) Ptr<usize> { word_at(
    central,
    c * 2 + 1
) }

span_lock = (central: Ptr<u8>) Ptr<u32> { central.offset(
    CLASSES * 16
).to<u32>() }

span_next = (central: Ptr<u8>) Ptr<usize> { word_at(central, CLASSES * 2 + 1) }

span_end = (central: Ptr<u8>) Ptr<usize> { word_at(central, CLASSES * 2 + 2) }

// Checked mode: every block gets its own mapping and freeing unmaps it, so
// a use after free faults at once instead of reading a recycled block. For
// sanitizer and stress runs only (each block costs a system call).
set_checked* = (central: Ptr<u8>, on: bool) {
    store(central, CLASSES * 2 + 3, on.match({ true => 1, false => 0 }));
}

checked = (central: Ptr<u8>) bool { load(central, CLASSES * 2 + 3) != 0 }

// Batch arrays not holding a batch: a lock, then a stack linked through
// each array's first word.
empty_lock = (central: Ptr<u8>) Ptr<u32> { word_at(
    central,
    CLASSES * 2 + 4
).to<u32>() }

empty_stack = (central: Ptr<u8>) Ptr<usize> { word_at(
    central,
    CLASSES * 2 + 5
) }

// A batch array: the link, then BATCH block addresses.
ARRAY_BYTES: usize = 528

// `bytes` of fresh zeroed memory starting on an `align` boundary; null
// when the kernel refuses.
map_aligned* = (bytes: usize, align: usize) Ptr<u8> {
    total = bytes + align;
    got   = mmap(0, total, 3, map_private_anonymous(), -1, 0);
    (got < 0).match({
        true  => null_ptr<u8>(),
        false => {
            raw     = got.to_usize().value_or(0);
            aligned = (raw + align - 1) / align * align;
            lead    = aligned - raw;
            (lead > 0).then(() { munmap(raw, lead).discard(); });
            (align - lead > 0).then(() {
                munmap(aligned + bytes, align - lead).discard();
            });
            pointer_at(aligned)
        },
    })
}

// The Mem `env.actor_mem` gave the runtime; null when every runtime page
// comes straight from the kernel.
actor_mem* = () Ptr<Mem> {
    pointer_at(atomic_load_usize(word_at(process_block(), PB_MEM))).to<Mem>()
}

// `bytes` of zeroed memory on an `align` boundary (a power of two), for
// anything the runtime keeps; null when refused. Without an actor Mem it
// is the kernel's, as it always was. With one, the Mem's page is asked
// for `align` + 8 more bytes so the block can be aligned inside it with
// the page's address in the word just before it, for `give_back`.
grab* = (bytes: usize, align: usize) Ptr<u8> {
    mem = actor_mem();
    mem.is_null().match({
        true  => (align <= 4096).match({
            true  => kernel(bytes),
            false => map_aligned(bytes, align),
        }),
        false => {
            words = (bytes + 7) / 8;
            room  = (align < 8).match({ true => 8, false => align });
            mem.read(0).page(words * 8 + room + 8, null_ptr<Page>()).match({
                Err(_)   => null_ptr<u8>(),
                Ok(page) => {
                    base    = page.to<usize>().read(1);
                    aligned = (base + 8 + room - 1) / room * room;
                    store(
                        pointer_at(aligned - 8),
                        0,
                        address_of(page.to<u8>())
                    );
                    block = pointer_at(aligned);
                    Range(0, words).loop((i) { store(block, i, 0); });
                    block
                },
            })
        },
    })
}

// Hand back what `grab(bytes, ..)` gave.
give_back* = (block: Ptr<u8>, bytes: usize) {
    mem = actor_mem();
    mem.is_null().match({
        true  => { munmap(address_of(block), bytes).discard(); },
        false => {
            page = pointer_at(load(pointer_at(address_of(block) - 8), 0));
            mem.read(0).release(page.to<Page>());
        },
    })
}

// Zeroed pages from the kernel; null when refused.
kernel* = (bytes: usize) Ptr<u8> {
    got = mmap(0, bytes, 3, map_private_anonymous(), -1, 0);
    (got < 0).match({
        true  => null_ptr<u8>(),
        false => pointer_at(got.to_usize().value_or(0)),
    })
}

// A whole 2 MiB span, asking Linux for one huge page: a million actors'
// bodies and slots then cost a few hundred page faults instead of tens of
// thousands. (MADV_HUGEPAGE; macOS has no such advice. An actor Mem's
// pages are its own business.)
map_span* = () Ptr<u8> {
    span = grab(SPAN_BYTES, SPAN_BYTES);
    (!span.is_null() && platform_darwin() == 0 && actor_mem().is_null()).then(() {
        madvise(address_of(span), SPAN_BYTES, 14).discard();
    });
    span
}

// A fresh slab, cut from the current span (a new span when it is used up).
new_slab = (central: Ptr<u8>) Ptr<u8> {
    lock(span_lock(central));
    (span_next(central).read(0) >= span_end(central).read(0)).then(() {
        span = map_span();
        (!span.is_null()).then(() {
            span_next(central).write(0, address_of(span));
            span_end(central).write(0, address_of(span) + SPAN_BYTES);
        });
    });
    next = span_next(central).read(0);
    slab = (next < span_end(central).read(0)).match({
        true  => {
            span_next(central).write(0, next + SLAB_BYTES);
            pointer_at(next)
        },
        false => null_ptr<u8>(),
    });
    unlock(span_lock(central));
    slab
}

// A block of at least `bytes`, 16-byte aligned; null when out of memory.
// Its contents are whatever the last user left.
alloc* = (heap: Ptr<u8>, central: Ptr<u8>, bytes: usize) Ptr<u8> {
    (bytes > LARGEST || checked(central)).match({
        true  => alloc_large(central, bytes),
        false => {
            c = class_of(bytes);
            n = heap_count(heap, c).read(0);
            (n > 0).match({
                true  => {
                    heap_count(heap, c).write(0, n - 1);
                    pointer_at(heap_stack(heap, c).read(n - 1))
                },
                false => refill(heap, central, c),
            })
        },
    })
}

// The class's stack is empty: take a batch from the central stack, else
// carve the next block of the thread's slab, else start a new slab.
refill = (heap: Ptr<u8>, central: Ptr<u8>, c: usize) Ptr<u8> {
    lock(central_lock(central, c));
    batch = central_stack(central, c).read(0);
    (batch != 0).then(() {
        central_stack(central, c).write(0, load(pointer_at(batch), 0));
    });
    unlock(central_lock(central, c));
    (batch != 0).match({
        true  => {
            array = pointer_at(batch);
            stack = heap_stack(heap, c);
            Range(0, BATCH).loop((i) { stack.write(i, load(array, i + 1)); });
            keep_array(heap, central, c, array);
            heap_count(heap, c).write(0, BATCH - 1);
            pointer_at(stack.read(BATCH - 1))
        },
        false => carve(heap, central, c),
    })
}

// An emptied batch array: the class's spare, or back to the shared stack.
keep_array = (heap: Ptr<u8>, central: Ptr<u8>, c: usize, array: Ptr<u8>) {
    (heap_spare(heap, c).read(0) == 0).match({
        true  => heap_spare(heap, c).write(0, address_of(array)),
        false => {
            lock(empty_lock(central));
            store(array, 0, empty_stack(central).read(0));
            empty_stack(central).write(0, address_of(array));
            unlock(empty_lock(central));
        },
    });
}

// An array to hand a batch over in: the class's spare, else a shared one,
// else a fresh slab cut into arrays. Null when out of memory.
take_array = (heap: Ptr<u8>, central: Ptr<u8>, c: usize) Ptr<u8> {
    spare = heap_spare(heap, c).read(0);
    (spare != 0).match({
        true  => { heap_spare(heap, c).write(0, 0); pointer_at(spare) },
        false => {
            lock(empty_lock(central));
            top = empty_stack(central).read(0);
            (top != 0).then(
                () { empty_stack(central).write(0, load(pointer_at(top), 0)); }
            );
            unlock(empty_lock(central));
            (top != 0).match({
                true  => pointer_at(top),
                false => {
                    slab = new_slab(central);
                    (!slab.is_null()).then(() {
                        store(slab, 0, LARGE - 1);
                        Range(1, (SLAB_BYTES - SLAB_HEADER) / ARRAY_BYTES).loop((i) {
                            keep_array(
                                heap,
                                central,
                                c,
                                slab.offset(SLAB_HEADER + i * ARRAY_BYTES)
                            );
                        });
                    });
                    slab.is_null().match({
                        true  => slab,
                        false => slab.offset(SLAB_HEADER),
                    })
                },
            })
        },
    })
}

carve = (heap: Ptr<u8>, central: Ptr<u8>, c: usize) Ptr<u8> {
    size = class_size(c);
    (heap_next(heap, c).read(0) + size > heap_end(heap, c).read(0)).then(() {
        slab = new_slab(central);
        (!slab.is_null()).then(() {
            store(slab, 0, c);
            store(slab, 1, size);
            heap_next(heap, c).write(0, address_of(slab) + SLAB_HEADER);
            heap_end(heap, c).write(0, address_of(slab) + SLAB_BYTES);
        });
    });
    next = heap_next(heap, c).read(0);
    (next != 0 && next + size <= heap_end(heap, c).read(0)).match({
        true  => {
            heap_next(heap, c).write(0, next + size);
            pointer_at(next)
        },
        false => null_ptr<u8>(),
    })
}

alloc_large = (central: Ptr<u8>, bytes: usize) Ptr<u8> {
    (bytes <= usize.MAX - SLAB_HEADER - SLAB_BYTES).match({
        false => null_ptr<u8>(),
        true  => {
            want  = (bytes + SLAB_HEADER + 4095) / 4096 * 4096;
            bin   = large_bin(want);
            total = (bin < LARGE_BINS).match({
                true  => LARGE_MIN << bin,
                false => want,
            });
            kept  = (bin < LARGE_BINS && !checked(central)).match({
                true  => take_large(central, bin),
                false => null_ptr<u8>(),
            });
            base  = kept.is_null().match({
                true  => grab(total, SLAB_BYTES),
                false => kept,
            });
            base.is_null().match({
                true  => base,
                false => {
                    store(base, 0, LARGE);
                    store(base, 1, total);
                    base.offset(SLAB_HEADER)
                },
            })
        },
    })
}

// The large-block cache, inside the runtime's globals: per bin a lock
// (u32), the newest kept mapping (linked through its header's third
// word), and how many are kept. Bin b holds mappings of LARGE_MIN << b.
LARGE_BINS: usize = 8
LARGE_MIN: usize = 32768
LARGE_KEEP: usize = 33554432

large_word = (central: Ptr<u8>, bin: usize, i: usize) Ptr<usize> { word_at(
    central.offset(G_LARGE - G_CENTRAL),
    bin * 3 + i
) }

// The bin whose size holds `total` bytes; LARGE_BINS or more when none.
large_bin = (total: usize) usize {
    b :: usize = 0;
    loop(() { b < LARGE_BINS && (LARGE_MIN << b) < total }, (h) { b = b + 1; });
    b
}

take_large = (central: Ptr<u8>, bin: usize) Ptr<u8> {
    lock(large_word(central, bin, 0).to<u32>());
    head = pointer_at(large_word(central, bin, 1).read(0));
    (!head.is_null()).then(() {
        large_word(central, bin, 1).write(0, load(head, 2));
        large_word(central, bin, 2).write(0, large_word(central, bin, 2).read(0) - 1);
    });
    unlock(large_word(central, bin, 0).to<u32>());
    head
}

// Keep a freed large mapping for reuse; false when it is not a cached
// size or its bin already holds LARGE_KEEP bytes (but at least four).
keep_large = (central: Ptr<u8>, base: Ptr<u8>) bool {
    total = load(base, 1);
    bin   = large_bin(total);
    (!checked(
        central
    ) && bin < LARGE_BINS && (LARGE_MIN << bin) == total).match({
        false => false,
        true  => keep_in(central, bin, base, total),
    })
}

keep_in = (central: Ptr<u8>, bin: usize, base: Ptr<u8>, total: usize) bool {
    lock(large_word(central, bin, 0).to<u32>());
    n    = large_word(central, bin, 2).read(0);
    room = n < 4 || (n + 1) * total <= LARGE_KEEP;
    room.then(() {
        store(base, 2, large_word(central, bin, 1).read(0));
        large_word(central, bin, 1).write(0, address_of(base));
        large_word(central, bin, 2).write(0, n + 1);
    });
    unlock(large_word(central, bin, 0).to<u32>());
    room
}

// The slab, or large mapping, that `block` lies in.
slab_of = (block: Ptr<u8>) Ptr<u8> {
    pointer_at(address_of(block) / SLAB_BYTES * SLAB_BYTES)
}

// Return a block to this thread's stack (any thread may free any block).
free* = (heap: Ptr<u8>, central: Ptr<u8>, block: Ptr<u8>) {
    slab = slab_of(block);
    c    = load(slab, 0);
    (c == LARGE).match({
        true  => (!keep_large(central, slab)).then(() {
            give_back(slab, load(slab, 1));
        }),
        false => {
            full = heap_count(heap, c).read(0) == CAP && !give_batch(heap, central, c);
            // Out of memory for a batch array: the block is lost, not reused.
            (!full).then(() {
                n = heap_count(heap, c).read(0);
                heap_stack(heap, c).write(n, address_of(block));
                heap_count(heap, c).write(0, n + 1);
            });
        },
    });
}

// Hand the oldest BATCH blocks of the stack to the central stack, keeping
// the most recently freed (likeliest cached) ones. False when no array
// could be had.
give_batch = (heap: Ptr<u8>, central: Ptr<u8>, c: usize) bool {
    array = take_array(heap, central, c);
    (!array.is_null()).then(() {
        stack = heap_stack(heap, c);
        Range(0, BATCH).loop((i) { store(array, i + 1, stack.read(i)); });
        Range(0, CAP - BATCH).loop((i) { stack.write(i, stack.read(i + BATCH)); });
        heap_count(heap, c).write(0, CAP - BATCH);
        lock(central_lock(central, c));
        store(array, 0, central_stack(central, c).read(0));
        central_stack(central, c).write(0, address_of(array));
        unlock(central_lock(central, c));
    });
    !array.is_null()
}

// A result the caller has no use for.
discard = (code: i64) {}
