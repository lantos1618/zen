// The actor runtime: workers, run queues, mailboxes, send-or-park, and the
// lifecycle the compilers call into. Both backends compile this module into
// every program that spawns an actor.
//
// Scheduling. One worker (a run queue, Go's P) per CPU the process may use,
// each driven by one thread. A worker runs an actor's turn: up to
// TURN_BATCH messages from its mailbox. An actor woken by a turn goes to
// its waker's LIFO slot and runs next on that core, while its message is
// warm; the actor it displaces goes to the back of the ring. An idle worker
// looks, in order, at its LIFO slot, its ring, the shared injector, then
// steals half of another worker's ring; only after that, and only from a
// worker whose turn has gone on for STEAL_DELAY_NS, does it take a LIFO
// slot. A full ring moves half of itself to the injector in one push and
// wakes idle workers to take it, so a mass wake spreads instead of piling
// up. Idle workers spin briefly, then sleep on a parker; a worker that
// publishes work wakes one sleeper only when no worker is already looking.
//
// Ownership. The life word in an actor's registry slot (actor_layout) holds
// the scheduled bit: whoever sets it owns the actor (it is queued or
// running) until it clears it, and only the owner may finalise. A turn ends
// with one atomic add that subtracts the messages it took and drops the
// bit; what that add returns decides whether the actor must run again, so
// nothing is read from the body once the bit is gone.
//
// Send-or-park. A mailbox holds BOUND messages. A send to a full mailbox
// from a turn goes to the sender's outbox; at the end of the turn the
// sender links a waiter onto each receiver it is waiting for and runs no
// more turns until every one has taken its messages. A receiver that
// drains below half its bound releases waiters oldest first, moving each
// one's messages into its mailbox (per-pair FIFO holds). Before parking, a
// sender records whom it waits on; a send to a full receiver whose chain of
// "waiting on" leads back to the sender goes through
// over the bound instead, so a cycle of full mailboxes never wedges. A
// sender that is not running a turn (main, a plain thread) waits for room
// instead. `offer` never waits: a full mailbox answers Full.

{ Ptr, null_ptr } = std.mem
{ Res, Ok, None, loop, Range } = std.core
{ atomic_load_usize, atomic_store_usize, atomic_add_usize, atomic_cas_usize } = std.sys
{ atomic_swap_usize, atomic_load_u32, atomic_cas_u32, atomic_store_u32 } = std.sys
{ atomic_store_release_usize } = std.sys
{ thread_word, set_thread_word, process_block, call_entry, guarded_call, pointer_at, address_of } = std.sys
{ cpu_count, monotonic_ns, nanosleep_ns, spin_hint, env_var, write_all, exit_group } = std.sys
{ openat, close, at_fdcwd, o_wronly, o_creat, o_trunc, o_cloexec } = std.sys
{ str } = std.text
{ thread_spawn, thread_join, mutex_init, mutex_lock, mutex_unlock, cond_init } = std.sys.sys_thread
{ cond_wait, cond_signal, cond_broadcast, parker_init, park, park_for, unpark, park_clear } = std.sys.sys_thread
{ word_at, load, store, lock, unlock, alloc, free, set_checked } = std.actor.actor_pool
{ grab, give_back, kernel, actor_mem } = std.actor.actor_pool
{ slot_at, slot_of_ref, take_slot, give_slot } = std.actor.actor_registry
{ MAX_MESSAGE_BYTES } = std.actor.actor_limits
{ PB_ONCE, PB_GLOBALS, PB_MEM, MAX_WORKERS, TURN_BATCH, RING, RING_MASK, BOUND } = std.actor.actor_layout
{ G_STATE, G_WORKERS, G_WORKER_BASE, G_IDLE, G_SPINNING, G_SLEEPING, G_DETACHED } = std.actor.actor_layout
{ G_INJ_HEAD, G_INJ_TAIL, G_INJ_STUB, G_INJ_LOCK, G_SLOT_FRESH, G_JOINERS } = std.actor.actor_layout
{ G_ENTRY, G_SPARE_IDLE, G_ORPHANS, G_THREADS, G_SYSMON_NS, G_ENV, G_STATS, G_CENTRAL } = std.actor.actor_layout
{ G_TRACE, G_TRACE_N, G_TRACE_CAP, G_TRACE_T0 } = std.actor.actor_layout
{ G_REC_THREADS, G_REC_ON, G_RINGS, REC_EVENTS, REC_MASK, REC_WORDS, ID_SHIFT } = std.actor.actor_layout
{ G_SIM, G_SIM_SEED, G_SIM_NOW, G_READY, G_READY_N, G_READY_CAP, G_SIM_LOCK, G_SIM_MAIN, G_SIM_SHARED } = std.actor.actor_layout
{ G_JOIN_LOCK, G_JOIN_COND, G_SPARE_LOCK, G_SPARE_COND, G_EXIT_PARKER } = std.actor.actor_layout
{ G_THREAD_LIST, MAX_THREADS, GLOBALS_BYTES } = std.actor.actor_layout
{ G_WATCH_LOCK, G_TIMER_LOCK, G_TIMERS, G_TIMER_LAST, G_TIMER_N, G_TIMER_ON, G_TIMER_PARKER } = std.actor.actor_layout
{ S_WATCH, WATCHED, E_NEXT, E_TO, E_GEN, E_AT, E_DONE, E_MSG, E_FAILED, ENTRY_BYTES } = std.actor.actor_layout
{ S_QUEUED, S_CLOSED, S_FULL, S_RELEASES, S_BREAKS, S_FINALIZED, S_HANDOFFS } = std.actor.actor_layout
{ S_PREEMPTS, S_STEALS, S_SPREADS, S_FAILED } = std.actor.actor_layout
{ L_WORKER, L_ACTOR, L_YIELD, L_HEAP, L_MSG, L_SEQ, L_RING, L_TAG, LOCAL_BYTES } = std.actor.actor_layout
{ W_HEAD, W_TAIL, W_NEXT, W_TURNS, W_IN_TURN, W_PREEMPT, W_SEEN, W_TICK, W_ID } = std.actor.actor_layout
{ W_RANDOM, W_SPINNING, W_PARKER, W_RING, WORKER_BYTES } = std.actor.actor_layout
{ S_LIFE, S_BODY, S_WAITING } = std.actor.actor_layout
{ COUNT_MASK, CLOSED, SCHED, BLOCKED, WAITED, GEN_SHIFT, GEN_MASK } = std.actor.actor_layout
{ B_HEAD, B_TAIL, B_STUB, B_REF, B_RUN_NEXT, B_STOPPED, B_SIDE, B_FAILED, B_RECEIVE, B_NAME, B_RECORD } = std.actor.actor_layout
{ D_OUTBOX, D_OUT_N, D_OUT_CAP, D_FIRST, D_LAST, D_LOCK, SIDE_BYTES } = std.actor.actor_layout
{ OUTBOX_ENTRY, PENDING, DONE, REFUSED, WAITER_BYTES, M_NEXT, M_TURN, M_CAUSE, M_PAYLOAD } = std.actor.actor_layout

// ---------------------------------------------------------------------
// words
// ---------------------------------------------------------------------

aload = (p: Ptr<u8>, i: usize) usize { atomic_load_usize(word_at(p, i)) }

astore = (p: Ptr<u8>, i: usize, value: usize) { atomic_store_usize(
    word_at(p, i),
    value
); }

// Wrapping atomic add; returns the previous word.
aadd = (p: Ptr<u8>, i: usize, value: usize) usize { atomic_add_usize(
    word_at(p, i),
    value
) }

asub = (p: Ptr<u8>, i: usize, value: usize) usize { atomic_add_usize(
    word_at(p, i),
    0 -% value
) }

acas = (p: Ptr<u8>, i: usize, expected: usize, desired: usize) usize {
    atomic_cas_usize(word_at(p, i), expected, desired)
}

// A release store: for words other threads only read as hints (turn
// counters, the preemption flag) or that publish what was written before.
arel = (p: Ptr<u8>, i: usize, value: usize) {
    atomic_store_release_usize(word_at(p, i), value);
}

aswap = (p: Ptr<u8>, i: usize, value: usize) usize { atomic_swap_usize(
    word_at(p, i),
    value
) }

at = (address: usize) Ptr<u8> { pointer_at(address) }

addr = (p: Ptr<u8>) usize { address_of(p) }

// Set bits in a word; returns the word before.
aset = (p: Ptr<u8>, i: usize, bits: usize) usize {
    loop<usize>((h) {
        v = aload(p, i);
        ((v & bits) == bits || acas(p, i, v, v | bits) == v).then(() { h.break(v); });
    }).value_or(0)
}

// Clear bits in a word; returns the word before.
aclear = (p: Ptr<u8>, i: usize, bits: usize) usize {
    loop<usize>((h) {
        v = aload(p, i);
        ((v & bits) == 0 || acas(p, i, v, v & (bits ^ usize.MAX)) == v).then(() { h.break(v); });
    }).value_or(0)
}

count_of = (life: usize) usize { life & COUNT_MASK }

gen_of = (life: usize) usize { (life >> GEN_SHIFT) & GEN_MASK }

ref_gen = (r: usize) usize { (r >> 32) & GEN_MASK }

ref_index = (r: usize) usize { r & COUNT_MASK }

as_ref = (index: usize, gen: usize) usize { (gen << 32) | index }

stat = (g: Ptr<u8>, which: usize) { aadd(g, G_STATS + which, 1); }

// ZEN_ACTOR_TRACE=<file>: every message's path through the runtime, one
// event each time it moves, written to <file> at exit. `from` and `to` are
// registry indices (0: not an actor); for TAKE, SLEEP and WAKE `from` is
// the worker. The message is its block's address, unique while it lives.
T_SEND: usize = 1      // into the receiver's mailbox
T_PARK: usize = 2      // into the sender's outbox: the receiver is full
T_RELEASE: usize = 3   // from the outbox into the mailbox
T_REFUSE: usize = 4    // dropped from the outbox: the receiver stopped
T_TAKE: usize = 5      // out of the mailbox, to run
T_BREAK: usize = 6     // let in over the bound: waiting would close a cycle
T_BLOCK: usize = 7     // the sender's turn ended with sends waiting
T_UNBLOCK: usize = 8
T_SLEEP: usize = 9
T_WAKE: usize = 10
T_CLOSED: usize = 11   // refused: the receiver is gone
T_WAIT: usize = 12     // the blocked sender now waits on `to`
TRACE_WORDS: usize = 6

trace = (g: Ptr<u8>, kind: usize, from: usize, to: usize, m: usize) { trace_event(
    g,
    kind,
    from,
    to,
    m,
    0
); }

// A take also records the message's recorder id and its cause.
trace_event = (
    g    : Ptr<u8>,
    kind : usize,
    from : usize,
    to   : usize,
    m    : usize,
    id   : usize
) {
    buf = aload(g, G_TRACE);
    (buf != 0).then(() {
        i = aadd(g, G_TRACE_N, 1);
        (i < load(g, G_TRACE_CAP)).then(() {
            e = at(buf).offset(i * TRACE_WORDS * 8);
            store(e, 0, clock(g) - load(g, G_TRACE_T0));
            store(e, 1, kind | (from << 8));
            store(e, 2, to);
            store(e, 3, m);
            store(e, 4, id);
            store(
                e,
                5,
                (id == 0).match({ true => 0, false => load(at(m), M_CAUSE) })
            );
        });
    });
}

index_of = (a: Ptr<u8>) usize {
    a.is_null().match({ true => 0, false => ref_index(load(a, B_REF)) })
}

// ---------------------------------------------------------------------
// globals and the thread's local state
// ---------------------------------------------------------------------

// The runtime's globals, null before the first spawn.
globals = () Ptr<u8> {
    block = process_block();
    (atomic_load_usize(word_at(block, PB_ONCE)) == 2).match({
        true  => at(load(block, PB_GLOBALS)),
        false => null_ptr<u8>(),
    })
}

// This thread's local state, made on first use.
local = () Ptr<u8> {
    word = thread_word();
    (word != 0).match({
        true  => at(word),
        false => {
            made = map(LOCAL_BYTES);
            set_thread_word(addr(made));
            made
        },
    })
}

// Zeroed memory the runtime keeps (globals, locals, workers), from the
// actor Mem or the kernel; null when refused.
map = (bytes: usize) Ptr<u8> { grab(bytes, 8) }

heap_of = (l: Ptr<u8>) Ptr<u8> { l.offset(L_HEAP) }

central_of = (g: Ptr<u8>) Ptr<u8> { g.offset(G_CENTRAL) }

new_block = (g: Ptr<u8>, l: Ptr<u8>, bytes: usize) Ptr<u8> {
    alloc(heap_of(l), central_of(g), bytes)
}

free_block = (g: Ptr<u8>, l: Ptr<u8>, block: Ptr<u8>) {
    free(heap_of(l), central_of(g), block);
}

zero = (p: Ptr<u8>, bytes: usize) {
    Range(0, bytes / 8).loop((i) { store(p, i, 0); });
}

worker_at = (g: Ptr<u8>, i: usize) Ptr<u8> {
    at(load(g, G_WORKER_BASE) + i * WORKER_BYTES)
}

parker_of = (w: Ptr<u8>) Ptr<u8> { w.offset(W_PARKER) }

// ---------------------------------------------------------------------
// the injector
// ---------------------------------------------------------------------

// A Vyukov MPSC list of actors linked through their B_RUN_NEXT words, for
// actors woken off any worker and for spread and preempted ones. Any thread
// pushes (a whole chain in one exchange); workers take under a try-lock,
// a batch at a time.

stub_node = (g: Ptr<u8>) usize { addr(g) + G_INJ_STUB * 8 }

node_of = (body: Ptr<u8>) usize { addr(body) + B_RUN_NEXT * 8 }

body_of_node = (node: usize) Ptr<u8> { at(node - B_RUN_NEXT * 8) }

link_of = (node: usize) Ptr<u8> { at(node) }

inject_chain = (g: Ptr<u8>, first: Ptr<u8>, last: Ptr<u8>) {
    astore(last, B_RUN_NEXT, 0);
    prev = aswap(g, G_INJ_HEAD, node_of(last));
    astore(link_of(prev), 0, node_of(first));
}

inject = (g: Ptr<u8>, body: Ptr<u8>) { inject_chain(g, body, body); }

injector_empty = (g: Ptr<u8>) bool {
    aload(g, G_INJ_TAIL) == stub_node(g) && aload(g, G_INJ_HEAD) == stub_node(g)
}

// The lock is held.
inject_pop = (g: Ptr<u8>) Ptr<u8> {
    stub = stub_node(g);
    tail ::= aload(g, G_INJ_TAIL);
    next ::= aload(link_of(tail), 0);
    skip = tail == stub && next != 0;
    skip.then(() {
        astore(g, G_INJ_TAIL, next);
        tail = next;
        next = aload(link_of(next), 0);
    });
    (tail == stub && !skip).match({
        true  => null_ptr<u8>(),
        false => (next != 0).match({
            true  => { astore(g, G_INJ_TAIL, next); body_of_node(tail) },
            false => (tail != aload(g, G_INJ_HEAD)).match({
                true  => null_ptr<u8>(),
                false => {
                    astore(link_of(stub), 0, 0);
                    prev = aswap(g, G_INJ_HEAD, stub);
                    astore(link_of(prev), 0, stub);
                    after = aload(link_of(tail), 0);
                    (after != 0).match({
                        true  => { astore(g, G_INJ_TAIL, after); body_of_node(tail) },
                        false => null_ptr<u8>(),
                    })
                },
            }),
        }),
    })
}

INJECT_BATCH: usize = 32

// One actor from the injector, with up to INJECT_BATCH more moved onto the
// worker's ring; null when it is empty or another worker holds it.
inject_take = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    injector_empty(g).match({
        true  => null_ptr<u8>(),
        false => {
            word = g.offset(G_INJ_LOCK * 8).to<u32>();
            (atomic_cas_u32(word, 0, 1) == 0).match({
                false => null_ptr<u8>(),
                true  => {
                    first = inject_pop(g);
                    (!first.is_null() && !w.is_null()).then(() {
                        moved :: usize = 0;
                        loop(() { moved < INJECT_BATCH && ring_room(w) }, (h) {
                            a = inject_pop(g);
                            a.is_null().then(() { h.break(); });
                            ring_put(w, a);
                            moved = moved + 1;
                        });
                    });
                    atomic_store_u32(word, 0);
                    first
                },
            })
        },
    })
}

// ---------------------------------------------------------------------
// run queues
// ---------------------------------------------------------------------

ring_slot = (w: Ptr<u8>, i: usize) Ptr<usize> { word_at(
    w.offset(W_RING),
    i & RING_MASK
) }

ring_size = (w: Ptr<u8>) usize { aload(w, W_TAIL) -% aload(w, W_HEAD) }

ring_room = (w: Ptr<u8>) bool { aload(w, W_TAIL) - aload(w, W_HEAD) < RING }

// The owner's push; the caller checked for room.
ring_put = (w: Ptr<u8>, a: Ptr<u8>) {
    t = aload(w, W_TAIL);
    ring_slot(w, t).write(0, addr(a));
    astore(w, W_TAIL, t + 1);
}

// Push onto the worker's ring; a full ring moves half of itself, with `a`,
// to the injector and wakes idle workers to share it.
ring_push = (g: Ptr<u8>, w: Ptr<u8>, a: Ptr<u8>) {
    loop((h) {
        ring_room(w).then(() { ring_put(w, a); h.break(); });
        spread(g, w, a).then(() { h.break(); });
    });
}

spread = (g: Ptr<u8>, w: Ptr<u8>, a: Ptr<u8>) bool {
    half = RING / 2;
    h    = aload(w, W_HEAD);
    (acas(w, W_HEAD, h, h + half) == h).match({
        false => false,
        true  => {
            first = at(ring_slot(w, h).read(0));
            prev ::= first;
            Range(1, half).loop((i) {
                next = at(ring_slot(w, h + i).read(0));
                astore(prev, B_RUN_NEXT, node_of(next));
                prev = next;
            });
            astore(prev, B_RUN_NEXT, node_of(a));
            inject_chain(g, first, a);
            stat(g, S_SPREADS);
            Range(0, load(g, G_WORKERS)).loop((i) { wake_idle(g); });
            true
        },
    })
}

// The owner's pop, and a single-actor steal.
ring_pop = (w: Ptr<u8>) Ptr<u8> {
    loop<usize>((h) {
        hd = aload(w, W_HEAD);
        (hd == aload(w, W_TAIL)).then(() { h.break(0); });
        a = ring_slot(w, hd).read(0);
        (acas(w, W_HEAD, hd, hd + 1) == hd).then(() { h.break(a); });
    }).match({ Ok(a) => at(a), None => null_ptr<u8>() })
}

// Take half of `victim`'s ring onto the thief's (empty) ring; returns one
// of them to run now, null when the victim had nothing.
steal_half = (thief: Ptr<u8>, victim: Ptr<u8>) Ptr<u8> {
    got: Res<usize> = loop<usize>((h) {
        hd = aload(victim, W_HEAD);
        tl = aload(victim, W_TAIL);
        n  = (tl -% hd) - (tl -% hd) / 2;
        (n == 0).then(() { h.break(0); });
        (n <= RING / 2).then(() {
            base = aload(thief, W_TAIL);
            Range(0, n).loop((i) {
                ring_slot(thief, base + i).write(0, ring_slot(victim, hd + i).read(0));
            });
            (acas(victim, W_HEAD, hd, hd + n) == hd).then(() {
                last = ring_slot(thief, base + n - 1).read(0);
                astore(thief, W_TAIL, base + n - 1);
                h.break(last);
            });
        });
    });
    got.match({ Ok(a) => at(a), None => null_ptr<u8>() })
}

// ---------------------------------------------------------------------
// waking and scheduling
// ---------------------------------------------------------------------

// Wake one sleeping worker, unless one is already looking for work: that
// one will find what was just published. Every publication and every
// sleeper's last look are sequentially consistent, so a worker going to
// sleep either sees the new work or is seen here.
wake_one = (g: Ptr<u8>) {
    (aload(g, G_SPINNING) == 0).then(() { wake_idle(g); });
}

// Wake one sleeping worker if there is one. It starts out looking for work,
// counted as such before it runs.
wake_idle = (g: Ptr<u8>) {
    loop((h) {
        m = aload(g, G_IDLE);
        (m == 0).then(() { h.break(); });
        i   = lowest_bit(m);
        bit = one_bit(i);
        (acas(g, G_IDLE, m, m & (bit ^ usize.MAX)) == m).then(() {
            aadd(g, G_SPINNING, 1);
            unpark(parker_of(worker_at(g, i)));
            h.break();
        });
    });
}

ONE: usize = 1

one_bit = (i: usize) usize { ONE << i }

lowest_bit = (m: usize) usize {
    i :: usize = 0;
    loop(() { ((m >> i) & 1) == 0 }, (h) { i = i + 1; });
    i
}

// Own the actor whose slot this is, if it is still generation `gen` and
// nobody owns it. The owner may run, queue or finalise it.
try_acquire = (slot: Ptr<u8>, gen: usize) bool {
    loop<bool>((h) {
        v = aload(slot, S_LIFE);
        (gen_of(v) != gen || (v & SCHED) != 0).then(() { h.break(false); });
        (acas(slot, S_LIFE, v, v | SCHED) == v).then(() { h.break(true); });
    }).value_or(false)
}

// Queue an actor this thread just acquired: next on this worker (its LIFO
// slot) when there is one, else the injector. An actor placed in the LIFO
// slot wakes nobody: it runs as soon as the current turn ends, on this
// core. Only the actor it displaces to the ring, or one in the injector, is
// work another worker should come for. (sysmon covers the case of a LIFO
// actor stuck behind a long turn.)
schedule = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>) {
    w = at(load(l, L_WORKER));
    w.is_null().match({
        true  => (load(g, G_SIM) != 0).match({
            true  => ready(g, l, a),
            false => { inject(g, a); wake_one(g); },
        }),
        false => {
            displaced = aswap(w, W_NEXT, addr(a));
            (displaced != 0).then(() {
                ring_push(g, w, at(displaced));
                wake_one(g);
            });
        },
    });
}

// ---------------------------------------------------------------------
// the mailbox
// ---------------------------------------------------------------------

// Vyukov's intrusive MPSC list. A node's first word is its link: a
// message, or the stub B_STUB inside the body. Producers swap themselves
// into B_HEAD and then link the previous node to themselves; between the
// two a take sees "empty", and the producer's own scheduling (or the
// count it raised) brings the actor back.

stub_of = (a: Ptr<u8>) usize { addr(a) + B_STUB * 8 }

// The body is not yet reachable: the slot's publication orders these.
mailbox_init = (a: Ptr<u8>) {
    store(a, B_STUB, 0);
    store(a, B_HEAD, stub_of(a));
    store(a, B_TAIL, stub_of(a));
}

mailbox_put = (a: Ptr<u8>, node: usize) {
    // The node is private until the exchange publishes it.
    store(at(node), M_NEXT, 0);
    prev = aswap(a, B_HEAD, node);
    arel(at(prev), M_NEXT, node);
}

// The running worker only.
mailbox_take = (a: Ptr<u8>) Ptr<u8> {
    stub = stub_of(a);
    tail ::= load(a, B_TAIL);
    next ::= aload(at(tail), M_NEXT);
    skip = tail == stub && next != 0;
    skip.then(() {
        store(a, B_TAIL, next);
        tail = next;
        next = aload(at(next), M_NEXT);
    });
    (tail == stub && !skip).match({
        true  => null_ptr<u8>(),
        false => (next != 0).match({
            true  => { store(a, B_TAIL, next); at(tail) },
            false => (tail != aload(a, B_HEAD)).match({
                true  => null_ptr<u8>(),
                false => {
                    mailbox_put(a, stub);
                    after = aload(at(tail), M_NEXT);
                    (after != 0).match({
                        true  => { store(a, B_TAIL, after); at(tail) },
                        false => null_ptr<u8>(),
                    })
                },
            }),
        }),
    })
}

mailbox_empty = (a: Ptr<u8>) bool {
    load(a, B_TAIL) == stub_of(a) && aload(a, B_HEAD) == stub_of(a)
}

// ---------------------------------------------------------------------
// sending
// ---------------------------------------------------------------------

SEND_OK*: i32 = 0
SEND_CLOSED*: i32 = 1
SEND_FULL*: i32 = 2
// Internal: the message waits in the sender's outbox (Ok to the program).
SEND_QUEUED: i32 = 3

// A message's smallest block: one cache line, so a producer writing the
// next message never shares a line with the consumer reading this one.
MESSAGE_MIN: usize = 64

MODE_SEND: usize = 0
MODE_OFFER: usize = 1
MODE_RESERVED: usize = 2

// Deliver message `m` to the actor `r` names. From a turn, a full receiver
// queues it in the outbox; from a worker outside any turn (a stopped
// hook) the send never waits; from any other thread it waits for room.
send_message = (g: Ptr<u8>, l: Ptr<u8>, r: usize, m: Ptr<u8>, mode: usize) i32 {
    slot = slot_of_ref(g, r);
    slot.is_null().match({
        true  => { free_block(g, l, m); SEND_CLOSED },
        false => deliver(g, l, slot, r, m, mode),
    })
}

deliver = (
    g    : Ptr<u8>,
    l    : Ptr<u8>,
    slot : Ptr<u8>,
    r    : usize,
    m    : Ptr<u8>,
    mode : usize
) i32 {
    gen     = ref_gen(r);
    me      = at(load(l, L_ACTOR));
    on_core = load(l, L_WORKER) != 0;
    // One compare-and-swap admits the message and, when nobody owns the
    // receiver, takes ownership to schedule it: a stale or closed receiver,
    // or a full one, leaves the word untouched.
    loop<i32>((h) {
        old = aload(slot, S_LIFE);
        (gen_of(old) != gen || (old & CLOSED) != 0).then(() {
            stat(g, S_CLOSED);
            trace(g, T_CLOSED, index_of(me), ref_index(r), addr(m));
            free_block(g, l, m);
            h.break(SEND_CLOSED);
        });
        a      = at(load(slot, S_BODY));
        waits  = mode != MODE_RESERVED && !a.same(
            me
        ) && (!me.is_null() || !on_core);
        behind = waits && !me.is_null() && outbox_holds(me, r);
        full ::= waits && (count_of(old) >= BOUND || behind);
        (full && !behind && !me.is_null() && cycle_through(g, me, r)).then(() {
            full = false;
            stat(g, S_BREAKS);
            trace(g, T_BREAK, index_of(me), ref_index(r), addr(m));
        });
        full.then(() {
            (mode == MODE_OFFER).then(() {
                stat(g, S_FULL);
                free_block(g, l, m);
                h.break(SEND_FULL);
            });
            (!me.is_null()).then(() {
                outbox_put(g, l, me, r, m);
                h.break(SEND_QUEUED);
            });
            (load(g, G_SIM) != 0).match({
                true  => sim_wait(g, l),
                false => nanosleep_ns(2000).discard(),
            });
        });
        (!full && acas(slot, S_LIFE, old, (old + 1) | SCHED) == old).then(() {
            trace(g, T_SEND, index_of(me), ref_index(r), addr(m));
            mailbox_put(a, addr(m));
            ((old & SCHED) == 0).then(() { schedule(g, l, a); });
            h.break(SEND_OK);
        });
    }).value_or(SEND_CLOSED)
}

// Whether `me` already waits to send to `r`: later sends to it queue behind,
// keeping per-pair order.
outbox_holds = (me: Ptr<u8>, r: usize) bool {
    side = at(load(me, B_SIDE));
    (side.is_null() || load(side, D_OUT_N) == 0).match({
        true  => false,
        false => {
            entries = at(load(side, D_OUTBOX));
            Range(0, load(side, D_OUT_N)).find((i) {
                e = entries.offset(i * OUTBOX_ENTRY);
                load(e, 0) == r && aload(e, 2) == PENDING
            }).match({ Ok(_) => true, None => false })
        },
    })
}

// Whether `to`, followed through the waiting-on words of the actors it
// waits on, leads back to `me`. A blocked actor waits on one receiver at a
// time, so this walks a single chain, of any length: it stops at an actor
// that waits on nothing, at a loop that does not pass through `me` (Brent's
// marker, moved at each power of two), or after one hop per registry slot.
// Slots are never freed, so it only reads live words; a reused slot fails
// the generation check and ends it.
cycle_through = (g: Ptr<u8>, me: Ptr<u8>, to: usize) bool {
    mine  = load(me, B_REF);
    limit = aload(g, G_SLOT_FRESH);
    r    ::= to;
    mark ::= to;
    hops :: usize = 0;
    lap  :: usize = 1;
    loop<bool>(() { hops < limit }, (h) {
        slot = slot_of_ref(g, r);
        next = slot.is_null().match({ true => 0, false => aload(
            slot,
            S_WAITING
        ) });
        (next == mine).then(() { h.break(true); });
        (next == 0 || next == mark || gen_of(aload(slot, S_LIFE)) != ref_gen(r)).then(() { h.break(false); });
        r    = next;
        hops = hops + 1;
        (hops == lap).then(() { mark = r; lap = lap * 2; });
    }).value_or(false)
}

// The actor's send-or-park record, made by whichever thread needs it first.
side_of = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>) Ptr<u8> {
    side = aload(a, B_SIDE);
    (side != 0).match({
        true  => at(side),
        false => {
            made = new_block(g, l, SIDE_BYTES);
            zero(made, SIDE_BYTES);
            prev = acas(a, B_SIDE, 0, addr(made));
            (prev == 0).match({
                true  => made,
                false => { free_block(g, l, made); at(prev) },
            })
        },
    })
}

outbox_put = (g: Ptr<u8>, l: Ptr<u8>, me: Ptr<u8>, r: usize, m: Ptr<u8>) {
    side = side_of(g, l, me);
    n    = load(side, D_OUT_N);
    (n == load(side, D_OUT_CAP)).then(() {
        cap   = (n == 0).match({ true => 4, false => n * 2 });
        grown = new_block(g, l, cap * OUTBOX_ENTRY);
        old   = at(load(side, D_OUTBOX));
        (n > 0).then(() {
            grown.copy_from(old, n * OUTBOX_ENTRY);
            free_block(g, l, old);
        });
        store(side, D_OUTBOX, addr(grown));
        store(side, D_OUT_CAP, cap);
    });
    e = at(load(side, D_OUTBOX)).offset(n * OUTBOX_ENTRY);
    store(e, 0, r);
    store(e, 1, addr(m));
    astore(e, 2, PENDING);
    store(side, D_OUT_N, n + 1);
    stat(g, S_QUEUED);
    trace(g, T_PARK, index_of(me), ref_index(r), addr(m));
}

// ---------------------------------------------------------------------
// waiting for room
// ---------------------------------------------------------------------

// The end of a turn whose outbox holds sends: the actor is marked blocked
// and waits on its receivers one at a time, oldest send first.
outbox_park = (g: Ptr<u8>, l: Ptr<u8>, me: Ptr<u8>, slot: Ptr<u8>) {
    aset(slot, S_LIFE, BLOCKED);
    trace(g, T_BLOCK, index_of(me), 0, 0);
    wait_next(g, l, me, true);
}

// Link `me` on the receiver of its oldest pending send, after naming that
// receiver in its waiting-on word: the word then always names the one
// receiver the actor waits on, so the cycle walk sees every edge of the
// wait-for graph and the last edge of a cycle finds the cycle. A receiver
// with room, or whose wait would close a cycle, takes its sends at once and
// the next is tried. Once a waiter is linked, the receiver that releases it
// carries on from here; with nothing pending the actor is unblocked (on its
// own turn, its release does the rest).
wait_next = (g: Ptr<u8>, l: Ptr<u8>, me: Ptr<u8>, own_turn: bool) {
    side    = at(load(me, B_SIDE));
    entries = at(load(side, D_OUTBOX));
    n       = load(side, D_OUT_N);
    slot    = slot_of_ref(g, load(me, B_REF));
    loop((h) {
        Range(0, n).find((i) {
            aload(entries.offset(i * OUTBOX_ENTRY), 2) == PENDING
        }).match({
            Ok(i) => {
                to = load(entries.offset(i * OUTBOX_ENTRY), 0);
                astore(slot, S_WAITING, to);
                trace(g, T_WAIT, index_of(me), ref_index(to), 0);
                register_waiter(g, l, me, to).then(() { h.break(); });
            },
            None  => {
                astore(slot, S_WAITING, 0);
                trace(g, T_UNBLOCK, index_of(me), 0, 0);
                own_turn.then(() { aclear(slot, S_LIFE, BLOCKED); });
                (!own_turn).then(() { unblock(g, l, me); });
                h.break();
            },
        });
    });
}

// Wait on receiver `to`: link a waiter and mark its mailbox waited on, in
// one step with reading its count. Either the receiver's next end-of-turn
// sees the mark, or this read sees the room that turn made: nothing is
// missed. If there is room after all, or waiting would close a cycle,
// deliver now. True when the waiter stays linked: the actor's outbox then
// belongs to whoever releases it.
register_waiter = (g: Ptr<u8>, l: Ptr<u8>, me: Ptr<u8>, to: usize) bool {
    slot = slot_of_ref(g, to);
    old  = aadd(slot, S_LIFE, 1);
    (gen_of(old) != ref_gen(to) || (old & CLOSED) != 0).match({
        true  => {
            asub(slot, S_LIFE, 1);
            resolve(g, l, me, to, null_ptr<u8>(), REFUSED);
            false
        },
        false => {
            r    = at(load(slot, S_BODY));
            side = side_of(g, l, r);
            word = side.offset(D_LOCK * 8).to<u32>();
            lock(word);
            closed = side.offset(D_LOCK * 8 + 4).to<u32>().read(0) != 0;
            closed.match({
                true  => {
                    unlock(word);
                    asub(slot, S_LIFE, 1);
                    resolve(g, l, me, to, null_ptr<u8>(), REFUSED);
                    false
                },
                false => {
                    w = new_block(g, l, WAITER_BYTES);
                    store(w, 0, 0);
                    store(w, 1, addr(me));
                    store(w, 2, to);
                    last = load(side, D_LAST);
                    (last == 0).match({
                        true  => store(side, D_FIRST, addr(w)),
                        false => store(at(last), 0, addr(w)),
                    });
                    store(side, D_LAST, addr(w));
                    life = aset(slot, S_LIFE, WAITED);
                    room ::= count_of(life) - 1 < BOUND;
                    (!room && cycle_through(g, me, to)).then(() {
                        room = true;
                        stat(g, S_BREAKS);
                    });
                    room.then(() {
                        // Take the node back: it is the last one.
                        (last == 0).match({
                            true  => store(side, D_FIRST, 0),
                            false => store(at(last), 0, 0),
                        });
                        store(side, D_LAST, last);
                        free_block(g, l, w);
                    });
                    unlock(word);
                    room.then(() { resolve(g, l, me, to, r, DONE); });
                    asub(slot, S_LIFE, 1);
                    !room
                },
            });
        },
    });
}

// Settle the sender's pending entries for receiver `to`: deliver them into
// `r` (DONE) or drop them (REFUSED). The sender stays blocked, so alive,
// until its caller moves it on with `wait_next`.
resolve = (
    g      : Ptr<u8>,
    l      : Ptr<u8>,
    sender : Ptr<u8>,
    to     : usize,
    r      : Ptr<u8>,
    how    : usize
) {
    side    = at(load(sender, B_SIDE));
    entries = at(load(side, D_OUTBOX));
    delivered ::= false;
    rslot = slot_of_ref(g, to);
    Range(0, load(side, D_OUT_N)).loop((i) {
        e = entries.offset(i * OUTBOX_ENTRY);
        (load(e, 0) == to && aload(e, 2) == PENDING).then(() {
            m = load(e, 1);
            (how == DONE).match({
                true  => {
                    aadd(rslot, S_LIFE, 1);
                    trace(g, T_RELEASE, index_of(sender), ref_index(to), m);
                    mailbox_put(r, m);
                    delivered = true;
                },
                false => {
                    trace(g, T_REFUSE, index_of(sender), ref_index(to), m);
                    free_block(g, l, at(m));
                },
            });
            astore(e, 2, how);
        });
    });
    (delivered && try_acquire(rslot, ref_gen(to))).then(() { schedule(g, l, r); });
}

// The sender's last receiver let it go: clear its blocked bit, and queue it
// if it has work and nobody owns it.
unblock = (g: Ptr<u8>, l: Ptr<u8>, sender: Ptr<u8>) {
    mine = load(sender, B_REF);
    slot = slot_of_ref(g, mine);
    old  = aclear(slot, S_LIFE, BLOCKED);
    stat(g, S_RELEASES);
    ((old & SCHED) == 0 && (count_of(old) > 0 || (old & CLOSED) != 0) && try_acquire(slot, ref_gen(mine))).then(() {
        schedule(g, l, sender);
    });
}

// The receiver's side, called by its owner: release waiters oldest first
// while it has room, or all of them, refused, when it is finalised. The
// waited-on mark is cleared when the list empties (under the lock that
// every waiter links under).
release_waiters = (
    g       : Ptr<u8>,
    l       : Ptr<u8>,
    a       : Ptr<u8>,
    slot    : Ptr<u8>,
    closing : bool
) {
    side = at(aload(a, B_SIDE));
    side.is_null().match({
        true  => aclear(slot, S_LIFE, WAITED).ignore_word(),
        false => {
            word = side.offset(D_LOCK * 8).to<u32>();
            lock(word);
            loop((h) {
                w = load(side, D_FIRST);
                (w == 0).then(() {
                    aclear(slot, S_LIFE, WAITED);
                    h.break();
                });
                life = aload(slot, S_LIFE);
                (!closing && (life & CLOSED) == 0 && count_of(life) >= BOUND).then(() { h.break(); });
                node = at(w);
                store(side, D_FIRST, load(node, 0));
                (load(node, 0) == 0).then(() { store(side, D_LAST, 0); });
                // A stopped receiver accepts nothing new: what waited for
                // room was never accepted, so it is refused.
                refuse = closing || (aload(slot, S_LIFE) & CLOSED) != 0;
                how    = refuse.match({ true => REFUSED, false => DONE });
                sender = at(load(node, 1));
                to     = load(node, 2);
                free_block(g, l, node);
                // Unlocked: moving the sender on links it on another
                // receiver, under that receiver's lock.
                unlock(word);
                resolve(g, l, sender, to, a, how);
                wait_next(g, l, sender, false);
                lock(word);
            });
            closing.then(
                () { side.offset(D_LOCK * 8 + 4).to<u32>().write(0, 1); }
            );
            unlock(word);
        },
    });
}

// ---------------------------------------------------------------------
// turns
// ---------------------------------------------------------------------

// Run one turn of `a`, which this worker owns: up to TURN_BATCH messages,
// then park on full receivers if it queued sends, then finalise if it is
// stopped and drained, else give it up.
run = (g: Ptr<u8>, l: Ptr<u8>, w: Ptr<u8>, a: Ptr<u8>) {
    mine = load(a, B_REF);
    slot = slot_of_ref(g, mine);
    gen  = ref_gen(mine);
    // A seeded schedule runs turns with no worker published.
    owner = load(l, L_WORKER);
    arel(w, W_PREEMPT, 0);
    arel(w, W_TURNS, load(w, W_TURNS) + 1);
    arel(w, W_IN_TURN, 1);
    store(l, L_ACTOR, addr(a));
    taken :: usize = 0;
    ((aload(slot, S_LIFE) & BLOCKED) == 0).then(() {
        side = at(load(a, B_SIDE));
        (!side.is_null()).then(() { store(side, D_OUT_N, 0); });
        (load(slot, S_WAITING) != 0).then(() { astore(slot, S_WAITING, 0); });
        record = a.offset(B_RECORD);
        ring   = recorder(g, l);
        batch  = (owner != 0 || load(g, G_SIM) == 0).match({
            true  => TURN_BATCH,
            false => 1 + sim_random(g) % SIM_BATCH,
        });
        loop(() { taken < batch }, (h) {
            m = mailbox_take(a);
            m.is_null().then(() { h.break(); });
            taken = taken + 1;
            id    = (ring != 0).match({ true => note(
                l,
                ring,
                a,
                m
            ), false => 0 });
            trace_event(g, T_TAKE, load(w, W_ID), ref_index(mine), addr(m), id);
            // A failed actor's remaining messages are dropped, not run.
            (load(a, B_FAILED) == 0).then(() {
                // A send through a message-typed Ref names no turn: it runs
                // the receive turn the actor started with.
                turn    = load(m, M_TURN);
                trapped = guarded_call(
                    (turn == 0).match({ true => load(
                        a,
                        B_RECEIVE
                    ), false => turn }),
                    record,
                    m.offset(M_PAYLOAD)
                ) != 0;
                trapped.then(() { fail(g, l, a, slot); blame(g, l, a, m); });
            });
            free_block(g, l, m);
            queued = aload(a, B_SIDE) != 0 && load(at(aload(a, B_SIDE)), D_OUT_N) > 0;
            // A queued send parks the turn (S: at its end); a preempted,
            // yielded or handed-off turn stops taking messages.
            stop = queued || aload(w, W_PREEMPT) != 0 || load(l, L_YIELD) != 0 || load(l, L_WORKER) != owner;
            stop.then(() { h.break(); });
        });
        (aload(a, B_SIDE) != 0 && load(at(aload(a, B_SIDE)), D_OUT_N) > 0).then(() {
            outbox_park(g, l, a, slot);
        });
    });
    store(l, L_ACTOR, 0);
    store(l, L_MSG, 0);
    current = at(load(l, L_WORKER));
    (!current.is_null()).then(() { arel(current, W_IN_TURN, 0); });
    v       = aload(slot, S_LIFE);
    yielded = load(l, L_YIELD) != 0;
    store(l, L_YIELD, 0);
    done = (v & CLOSED) != 0 && (v & BLOCKED) == 0 && count_of(v) == taken && mailbox_empty(a)
        && finalize(g, l, a, slot, v);
    (!done).then(() { release(g, l, a, slot, gen, taken, yielded); });
}

// The flight recorder. Each thread that runs turns keeps a ring of the
// messages it took, made the first time it runs one; 0 when it has none
// (ZEN_ACTOR_RECORDER=0, too many threads, or no memory).
recorder = (g: Ptr<u8>, l: Ptr<u8>) usize {
    r ::= load(l, L_RING);
    (r == 0).then(() {
        r = 1;
        (load(g, G_REC_ON) != 0).then(() {
            tag = aadd(g, G_REC_THREADS, 1) + 1;
            (tag < MAX_THREADS).then(() {
                ring = map(REC_EVENTS * REC_WORDS * 8);
                (!ring.is_null()).then(() {
                    store(l, L_TAG, tag << ID_SHIFT);
                    astore(g.offset(G_RINGS), tag, addr(ring));
                    r = addr(ring);
                });
            });
        });
        store(l, L_RING, r);
    });
    (r == 1).match({ true => 0, false => r })
}

ID_MASK: usize = 1099511627775

// Record `m`, about to run on `a`, and return its id: the cause of every
// message the turn sends. Plain stores; readers only look once it's old
// or once the runtime is quiet.
note = (l: Ptr<u8>, ring: usize, a: Ptr<u8>, m: Ptr<u8>) usize {
    seq = load(l, L_SEQ) + 1;
    id  = load(l, L_TAG) | (seq & ID_MASK);
    e   = at(ring).offset((seq & REC_MASK) * REC_WORDS * 8);
    store(e, 0, id);
    store(e, 1, load(m, M_CAUSE));
    store(e, 2, load(a, B_REF));
    store(e, 3, load(a, B_NAME));
    store(l, L_SEQ, seq);
    store(l, L_MSG, id);
    id
}

// The recorder's entry for message `id`; null once its ring moved on.
find_event = (g: Ptr<u8>, id: usize) Ptr<u8> {
    tag  = id >> ID_SHIFT;
    ring = (tag > 0 && tag < MAX_THREADS).match({ true => aload(
        g.offset(G_RINGS),
        tag
    ), false => 0 });
    (ring == 0).match({
        true  => null_ptr<u8>(),
        false => {
            e = at(ring).offset(((id & ID_MASK) & REC_MASK) * REC_WORDS * 8);
            (load(e, 0) == id).match({ true => e, false => null_ptr<u8>() })
        },
    })
}

CHAIN_HOPS: usize = 16

// Why message `id` was sent: one line per message whose turn sent the
// next, from `cause` back to a send outside any turn (main, or a spawn's
// started message) or to the end of the recorded history.
explain = (g: Ptr<u8>, buf: Ptr<u8>, lead: str, id: usize, cause: usize) {
    cur  ::= id;
    why  ::= cause;
    hops :: usize = 0;
    loop(() { hops < CHAIN_HOPS }, (h) {
        e = (why == 0).match({ true => null_ptr<u8>(), false => find_event(
            g,
            why
        ) });
        n ::= put_text(buf, 0, lead);
        n = put_id(buf, n, cur);
        (why == 0).then(
            () { n = put_text(buf, n, " was sent outside any actor turn"); }
        );
        (why != 0 && e.is_null()).then(() {
            n = put_text(buf, n, " was sent while handling ");
            n = put_id(buf, n, why);
            n = put_text(buf, n, " (older history is not kept)");
        });
        (!e.is_null()).then(() {
            n = put_text(buf, n, " was sent by ");
            n = put_actor(buf, n, ref_index(load(e, 2)), load(e, 3));
            n = put_text(buf, n, " while handling ");
            n = put_id(buf, n, why);
        });
        n = put_text(buf, n, "\n");
        write_all(2, str(data: buf, len: n)).ignore();
        e.is_null().then(() { h.break(); });
        cur  = why;
        why  = load(e, 1);
        hops = hops + 1;
    });
    (hops == CHAIN_HOPS).then(() {
        n ::= put_text(buf, 0, lead);
        n = put_text(buf, n, "...\n");
        write_all(2, str(data: buf, len: n)).ignore();
    });
}

// A trap's report on stderr, after the trap's own line: the actor, the
// message its turn ran, and the chain of turns that sent it.
blame = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>, m: Ptr<u8>) {
    buf = new_block(g, l, 512);
    (!buf.is_null()).then(() {
        id = load(l, L_MSG);
        n ::= put_text(buf, 0, "actor-runtime: ");
        n = put_actor(buf, n, ref_index(load(a, B_REF)), load(a, B_NAME));
        n = put_text(buf, n, " trapped");
        (id != 0).then(
            () { n = put_text(buf, n, " handling "); n = put_id(buf, n, id); }
        );
        n = put_text(buf, n, "\n");
        write_all(2, str(data: buf, len: n)).ignore();
        (id != 0).then(
            () { explain(g, buf, "actor-runtime:   ", id, load(m, M_CAUSE)); }
        );
        seed_hint(g, buf);
        free_block(g, l, buf);
    });
}

// A checked trap ended one of `a`'s turns: the actor stops here. It runs
// none of its remaining messages and not its own `stopped` (its state may
// be half-updated); its state and memory are still dropped and freed.
// Senders see Closed from now on. (W4 adds the `failed` hook and links.)
fail = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>, slot: Ptr<u8>) {
    store(a, B_FAILED, 1);
    aset(slot, S_LIFE, CLOSED).ignore_word();
    stat(g, S_FAILED);
}

// Give up `a` after a turn that took `taken` messages: one add drops them
// and the scheduled bit together, and what it returns says whether `a`
// must run again (more messages, a stop to finish, waiters to release).
release = (
    g       : Ptr<u8>,
    l       : Ptr<u8>,
    a       : Ptr<u8>,
    slot    : Ptr<u8>,
    gen     : usize,
    taken   : usize,
    yielded : bool
) {
    t ::= taken;
    loop((h) {
        old  = asub(slot, S_LIFE, t + SCHED);
        rest = count_of(old) - t;
        t    = 0;
        // A blocked actor takes no turns, so no later release would free
        // its waiters: let them in while there is any room.
        free_up = (old & WAITED) != 0 && (
            rest < BOUND / 2 || (old & CLOSED) != 0 || ((old & BLOCKED) != 0 && rest < BOUND)
        );
        again   = free_up || ((old & BLOCKED) == 0 && (rest > 0 || (old & CLOSED) != 0 || yielded));
        (again && try_acquire(slot, gen)).match({
            false => h.break(),
            true  => free_up.match({
                true  => release_waiters(g, l, a, slot, false),
                false => { requeue(g, l, a, yielded); h.break(); },
            }),
        });
    });
}

// Back of this worker's ring (not its LIFO slot), or the injector when the
// thread has no worker or the turn yielded to preemption: requeued
// locally it would run again before anything waiting in the injector.
requeue = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>, yielded: bool) {
    w = at(load(l, L_WORKER));
    (w.is_null() && load(g, G_SIM) != 0).match({
        true  => ready(g, l, a),
        false => {
            (w.is_null() || yielded).match({
                true  => inject(g, a),
                false => ring_push(g, w, a),
            });
            wake_one(g);
        },
    });
}

// The actor is stopped, drained and owned by this worker: retire its
// generation in one step, so every later send sees Closed, then refuse its
// waiting senders, run `stopped`, and free it. False when a short-lived pin
// or a late sender's count got in first; the turn is simply retried.
finalize = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>, slot: Ptr<u8>, v: usize) bool {
    next = ((gen_of(v) + 1) & GEN_MASK) << GEN_SHIFT;
    (acas(slot, S_LIFE, v, next) == v).match({
        false => false,
        true  => {
            // Taken before the slot can be reused by a new generation.
            watchers = ((v & WATCHED) != 0).match({
                true  => take_watchers(g, slot),
                false => null_ptr<u8>(),
            });
            release_waiters(g, l, a, slot, true);
            // The stopped entry runs the actor's `stopped` (skipped for a
            // failed actor: a non-null second argument), then drops.
            stopped = load(a, B_STOPPED);
            failed  = load(a, B_FAILED) != 0;
            (stopped != 0).then(() {
                marker = failed.match({ true => a, false => null_ptr<u8>() });
                guarded_call(
                    stopped,
                    a.offset(B_RECORD),
                    marker
                ).ignore_status();
            });
            side = at(load(a, B_SIDE));
            (!side.is_null()).then(() {
                (load(side, D_OUT_CAP) > 0).then(() { free_block(g, l, at(load(side, D_OUTBOX))); });
                free_block(g, l, side);
            });
            index = ref_index(load(a, B_REF));
            astore(slot, S_BODY, 0);
            free_block(g, l, a);
            give_slot(g, l, index);
            stat(g, S_FINALIZED);
            (!watchers.is_null()).then(() { notify(g, l, watchers, failed); });
            (aload(g, G_JOINERS) > 0).then(() {
                mutex_lock(g.offset(G_JOIN_LOCK));
                cond_broadcast(g.offset(G_JOIN_COND));
                mutex_unlock(g.offset(G_JOIN_LOCK));
            });
            true
        },
    })
}

// ---------------------------------------------------------------------
// workers
// ---------------------------------------------------------------------

// Polls (each after a spin hint) an idle worker makes before it sleeps.
SPIN_ROUNDS: usize = 2000
// How long a thief leaves a busy worker's LIFO slot alone: the actor there
// was just woken by that worker's turn and will most likely run next on
// it, with its message still in cache (Go's runnext).
STEAL_DELAY_NS: u64 = 3000
// Every n-th pick looks at the injector first, so nothing waits there
// behind a worker that always has local work.
INJECT_EVERY: usize = 61

// Drive worker `w` until the runtime stops or the worker is handed to
// another thread.
drive = (g: Ptr<u8>, l: Ptr<u8>, w: Ptr<u8>) {
    store(l, L_WORKER, addr(w));
    loop((h) {
        a ::= find_work(g, w);
        a.is_null().then(() { a = idle(g, w); });
        a.is_null().match({
            false => {
                (load(w, W_SPINNING) != 0).then(() {
                    store(w, W_SPINNING, 0);
                    // The last worker looking found work: let another look.
                    (asub(g, G_SPINNING, 1) == 1).then(() { wake_one(g); });
                });
                run(g, l, w, a);
                (load(l, L_WORKER) != addr(w)).then(() { h.break(); });
            },
            true  => (aload(g, G_STATE) == 2).then(() { h.break(); }),
        });
    });
}

// The worker's next actor, or null: its LIFO slot, its ring, the injector,
// half of another worker's ring, and last another busy worker's LIFO slot.
find_work = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    tick = load(w, W_TICK) + 1;
    store(w, W_TICK, tick);
    a ::= null_ptr<u8>();
    (tick % INJECT_EVERY == 0).then(() { a = inject_take(g, w); });
    (a.is_null() && aload(w, W_NEXT) != 0).then(() { a = at(aswap(w, W_NEXT, 0)); });
    a.is_null().then(() { a = ring_pop(w); });
    a.is_null().then(() { a = inject_take(g, w); });
    a.is_null().then(() { a = steal(g, w); });
    a.is_null().then(() { a = steal_next(g, w); });
    // Count picks, not polls, so the injector's share does not depend on
    // how long a worker sat idle.
    a.is_null().then(() { store(w, W_TICK, tick - 1); });
    a
}

next_random = (w: Ptr<u8>) usize {
    x ::= load(w, W_RANDOM);
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    store(w, W_RANDOM, x);
    x
}

steal = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    n               = load(g, G_WORKERS);
    me              = load(w, W_ID);
    start           = next_random(w) % n;
    got: Res<usize> = loop<usize>((h) {
        Range(0, n).loop((i) {
            v = (start + i) % n;
            (v != me).then(() {
                a = steal_half(w, worker_at(g, v));
                (!a.is_null()).then(() {
                    stat(g, S_STEALS);
                    h.break(addr(a));
                });
            });
        });
        h.break();
    });
    got.match({ Ok(a) => at(a), None => null_ptr<u8>() })
}

// Take the actor in a busy worker's LIFO slot, if that worker is still in
// the same turn STEAL_DELAY_NS later.
steal_next = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    n               = load(g, G_WORKERS);
    me              = load(w, W_ID);
    got: Res<usize> = loop<usize>((h) {
        Range(0, n).loop((v) {
            victim = worker_at(g, v);
            x      = aload(victim, W_NEXT);
            (v != me && x != 0 && aload(victim, W_IN_TURN) == 1).then(() {
                turn     = aload(victim, W_TURNS);
                deadline = monotonic_ns() + STEAL_DELAY_NS;
                loop(() { monotonic_ns() < deadline }, (k) { spin_hint(); });
                (aload(victim, W_TURNS) == turn && acas(victim, W_NEXT, x, 0) == x).then(() {
                    stat(g, S_STEALS);
                    h.break(x);
                });
            });
        });
        h.break();
    });
    got.match({ Ok(a) => at(a), None => null_ptr<u8>() })
}

// No work: look for a while as a spinning worker, then sleep.
idle = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    (load(w, W_SPINNING) == 0).then(() {
        store(w, W_SPINNING, 1);
        aadd(g, G_SPINNING, 1);
    });
    found ::= spin(g, w);
    found.is_null().then(() {
        store(w, W_SPINNING, 0);
        asub(g, G_SPINNING, 1);
        // No longer counted as looking: one last look, so that work
        // published while this worker still counted is not missed.
        found = find_work(g, w);
        found.is_null().then(() { found = sleep(g, w); });
    });
    found
}

spin = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    i :: usize = 0;
    got: Res<usize> = loop<usize>(() { i < SPIN_ROUNDS && aload(
        g,
        G_STATE
    ) != 2 }, (h) {
        spin_hint();
        ((i & 63) == 63).then(() {
            a = find_work(g, w);
            (!a.is_null()).then(() { h.break(addr(a)); });
        });
        i = i + 1;
    });
    got.match({ Ok(a) => at(a), None => null_ptr<u8>() })
}

// Mark the worker idle, look once more, then park until a waker (or the
// runtime stopping) unparks it.
sleep = (g: Ptr<u8>, w: Ptr<u8>) Ptr<u8> {
    bit = one_bit(load(w, W_ID));
    aadd(g, G_IDLE, bit);
    a = find_work(g, w);
    a.is_null().then(() {
        asleep = aadd(g, G_SLEEPING, 1) + 1;
        (asleep == load(g, G_WORKERS) && aload(g, G_STATE) == 1).then(() {
            unpark(g.offset(G_EXIT_PARKER));
        });
        trace(g, T_SLEEP, load(w, W_ID), 0, 0);
        (aload(g, G_STATE) != 2).then(() { park(parker_of(w)); });
        asub(g, G_SLEEPING, 1);
        trace(g, T_WAKE, load(w, W_ID), 0, 0);
    });
    claim_back(g, w, bit);
    a
}

// Take the idle bit back. If a waker took it first, the waker counted this
// worker as looking for work and left a wake on its parker: keep both.
claim_back = (g: Ptr<u8>, w: Ptr<u8>, bit: usize) {
    ((aclear(g, G_IDLE, bit) & bit) == 0).then(() {
        store(w, W_SPINNING, 1);
        park_clear(parker_of(w));
    });
}

// ---------------------------------------------------------------------
// hand-off, spare threads and preemption
// ---------------------------------------------------------------------

// Give this thread's worker to a spare thread and finish the current turn
// without one: the actors queued on the worker keep running while this
// thread is busy (a long turn) or waiting (a join). Go's sysmon retaking a
// P. The thread becomes a spare when its turn ends.
detach = (g: Ptr<u8>, l: Ptr<u8>) {
    w = at(load(l, L_WORKER));
    (!w.is_null()).then(() {
        store(l, L_WORKER, 0);
        aadd(g, G_DETACHED, 1);
        arel(w, W_IN_TURN, 0);
        stat(g, S_HANDOFFS);
        mutex_lock(g.offset(G_SPARE_LOCK));
        aset(g, G_ORPHANS, one_bit(load(w, W_ID)));
        (aload(g, G_SPARE_IDLE) > 0).match({
            true  => cond_signal(g.offset(G_SPARE_COND)),
            false => { start_thread(g, spare_marker(g)).unused(); },
        });
        mutex_unlock(g.offset(G_SPARE_LOCK));
    });
}

// A thread that gave its worker away has finished its turn.
reattach = (g: Ptr<u8>, l: Ptr<u8>) {
    (load(l, L_WORKER) == 0).then(() {
        (asub(g, G_DETACHED, 1) == 1 && aload(g, G_STATE) == 1).then(() {
            unpark(g.offset(G_EXIT_PARKER));
        });
    });
    store(l, L_WORKER, 0);
}

// A spare thread: drive whichever worker was handed off, until stopping.
spare_loop = (g: Ptr<u8>, l: Ptr<u8>) {
    lk = g.offset(G_SPARE_LOCK);
    mutex_lock(lk);
    loop((h) {
        loop(() { aload(g, G_ORPHANS) == 0 && aload(g, G_STATE) != 2 }, (k) {
            aadd(g, G_SPARE_IDLE, 1);
            cond_wait(g.offset(G_SPARE_COND), lk);
            asub(g, G_SPARE_IDLE, 1);
        });
        orphans = aload(g, G_ORPHANS);
        (orphans == 0).then(() { h.break(); });
        i = lowest_bit(orphans);
        aclear(g, G_ORPHANS, one_bit(i));
        mutex_unlock(lk);
        drive(g, l, worker_at(g, i));
        reattach(g, l);
        mutex_lock(lk);
    });
    mutex_unlock(lk);
}

// The check the compiler puts at loop back-edges: when sysmon has flagged
// this worker's turn as long, hand the worker off so the actors behind the
// turn keep running. Plain code cannot suspend, so the turn continues on
// this thread without a worker.
actor_yield_check* = () {
    word = thread_word();
    (word != 0).then(() {
        w = at(load(at(word), L_WORKER));
        (!w.is_null() && aload(w, W_PREEMPT) != 0).then(() {
            astore(w, W_PREEMPT, 0);
            detach(globals(), at(word));
        });
    });
}

// The parking form of the check, for a function lowered to a resumable
// state machine (H'): when flagged, the turn ends here and the actor goes
// to the back of the injector, as Go requeues a preempted goroutine on its
// global queue. True when the caller must park.
actor_should_park* = () bool {
    word = thread_word();
    (word == 0).match({
        true  => false,
        false => {
            w       = at(load(at(word), L_WORKER));
            flagged = !w.is_null() && aload(w, W_PREEMPT) != 0;
            flagged.then(() {
                astore(w, W_PREEMPT, 0);
                store(at(word), L_YIELD, 1);
            });
            flagged
        },
    })
}

// Every tick, flag each worker whose turn has not changed since the last
// tick: that turn has run for at least one tick. Also the watchdog: every
// worker asleep with actors blocked for ZEN_ACTOR_WATCHDOG_MS (default
// 1000; 0 turns it off) means nothing can unblock them, so the wait-for
// graph is reported, once until the number of blocked actors changes.
sysmon = (g: Ptr<u8>) {
    ns    = load(g, G_SYSMON_NS);
    tick  = ns.to_u64();
    limit = (env_number("ZEN_ACTOR_WATCHDOG_MS", 1000) * 1000000 + ns - 1) / ns;
    still :: usize = 0;
    told  :: usize = 0;
    loop(() { aload(g, G_STATE) != 2 }, (h) {
        nanosleep_ns(tick).discard();
        (limit > 0).then(() {
            still = quiet(g).match({ true => still + 1, false => 0 });
            (still == limit).then(() {
                blocked = blocked_actors(g);
                (blocked > 0 && blocked != told).then(() {
                    stall_report(
                        g,
                        "every worker asleep past ZEN_ACTOR_WATCHDOG_MS"
                    );
                    told = blocked;
                });
            });
        });
        Range(0, load(g, G_WORKERS)).loop((i) {
            w    = worker_at(g, i);
            turn = aload(w, W_TURNS);
            long = aload(w, W_IN_TURN) == 1 && turn == load(w, W_SEEN);
            (long && aload(w, W_PREEMPT) == 0).then(() {
                astore(w, W_PREEMPT, 1);
                stat(g, S_PREEMPTS);
            });
            // Work queued behind a long turn: make sure some worker is
            // awake to steal it.
            (long && (aload(w, W_NEXT) != 0 || ring_size(w) > 0)).then(() { wake_one(g); });
            store(w, W_SEEN, turn);
        });
    });
}

// ---------------------------------------------------------------------
// the seeded schedule (ZEN_ACTOR_SEED)
// ---------------------------------------------------------------------

// With a seed the runtime starts no threads: turns run on whichever
// thread would otherwise wait (a join, a send to a full mailbox, the exit
// hook). The seed picks the next ready actor and how many messages its
// turn takes, and timers move a virtual clock, so a seed is a schedule.

SIM_BATCH: usize = 32
SIM_READY: usize = 4096

clock = (g: Ptr<u8>) usize {
    (load(g, G_SIM) != 0).match({
        true  => load(g, G_SIM_NOW),
        false => monotonic_ns().to_usize().value_or(0),
    })
}

sim_random = (g: Ptr<u8>) usize {
    x ::= load(g, G_SIM);
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    store(g, G_SIM, x);
    x
}

// The seeded schedule is single-threaded unless the program starts plain
// threads; this lock keeps the ready set and the timer list whole then.
sim_lock = (g: Ptr<u8>) Ptr<u32> { g.offset(G_SIM_LOCK * 8).to<u32>() }

// Add `a` to the ready set, growing it when full.
ready = (g: Ptr<u8>, l: Ptr<u8>, a: Ptr<u8>) {
    sim_thread(g, l);
    lock(sim_lock(g));
    n   = load(g, G_READY_N);
    cap = load(g, G_READY_CAP);
    (n == cap).then(() {
        old  = at(load(g, G_READY));
        more = map(cap * 16);
        (!more.is_null()).then(() {
            more.copy_from(old, cap * 8);
            give_back(old, cap * 8);
            store(g, G_READY, addr(more));
            store(g, G_READY_CAP, cap * 2);
        });
    });
    (n < load(g, G_READY_CAP)).then(() {
        store(at(load(g, G_READY)), n, addr(a));
        store(g, G_READY_N, n + 1);
    });
    unlock(sim_lock(g));
}

// Run one turn of a ready actor the seed picks, or else fire the earliest
// timers, moving the clock to them. False when nothing can run.
sim_step = (g: Ptr<u8>, l: Ptr<u8>) bool {
    actor  = load(l, L_ACTOR);
    msg    = load(l, L_MSG);
    worker = load(l, L_WORKER);
    lock(sim_lock(g));
    n = load(g, G_READY_N);
    a ::= null_ptr<u8>();
    (n > 0).then(() {
        list = at(load(g, G_READY));
        i    = sim_random(g) % n;
        a    = at(load(list, i));
        store(list, i, load(list, n - 1));
        store(g, G_READY_N, n - 1);
    });
    first ::= null_ptr<u8>();
    (n == 0 && load(g, G_TIMERS) != 0).then(() {
        first = at(load(g, G_TIMERS));
        due   = load(first, E_AT);
        now   = (due > load(g, G_SIM_NOW)).match({ true => due, false => load(g, G_SIM_NOW) });
        store(g, G_SIM_NOW, now);
        last ::= first;
        cur  ::= at(load(first, E_NEXT));
        loop(() { !cur.is_null() && load(cur, E_AT) <= now }, (h) {
            last = cur;
            cur  = at(load(cur, E_NEXT));
        });
        store(g, G_TIMERS, addr(cur));
        cur.is_null().then(() { store(g, G_TIMER_LAST, 0); });
        store(last, E_NEXT, 0);
    });
    unlock(sim_lock(g));
    (!a.is_null()).match({
        true  => {
            store(l, L_WORKER, 0);
            run(g, l, worker_at(g, 0), a);
        },
        false => (!first.is_null()).then(() {
            store(l, L_ACTOR, 0);
            store(l, L_MSG, 0);
            fire(g, l, first);
        }),
    });
    store(l, L_WORKER, worker);
    store(l, L_ACTOR, actor);
    store(l, L_MSG, msg);
    !a.is_null() || !first.is_null() || load(g, G_READY_N) > 0
}

// Note a thread using the schedule. Once a second one has (a plain thread
// sending or joining), an empty schedule may still be refilled by it.
sim_thread = (g: Ptr<u8>, l: Ptr<u8>) {
    first = acas(g, G_SIM_MAIN, 0, addr(l));
    (first != 0 && first != addr(l) && load(g, G_SIM_SHARED) == 0).then(() {
        astore(g, G_SIM_SHARED, 1);
    });
}

SIM_GRACE: usize = 2000

// Wait by running the schedule. Nothing left to run while something waits
// is a deadlock: report it and end the process. With plain threads about,
// one of them may yet send, so wait for that as the threaded runtime does;
// before any has shown up, a short grace lets a starting one do so.
sim_wait = (g: Ptr<u8>, l: Ptr<u8>) {
    sim_thread(g, l);
    (!sim_step(g, l)).then(() {
        idle :: usize = 0;
        loop(() {
            aload(g, G_READY_N) == 0 && aload(g, G_TIMERS) == 0
                && aload(g, G_SIM_SHARED) == 0 && idle < SIM_GRACE
        }, (h) {
            nanosleep_ns(50000).discard();
            idle = idle + 1;
        });
        // The caller checks its own wait again: another thread may have
        // ended it by running the turn that was missing here.
        (aload(g, G_SIM_SHARED) != 0).then(() { nanosleep_ns(50000).discard(); });
        (aload(g, G_READY_N) == 0 && aload(g, G_TIMERS) == 0 && aload(g, G_SIM_SHARED) == 0).then(() {
            stall_report(g, "deadlock: a wait that nothing can end");
            exit_group(3).discard();
        });
    });
}

seed_hint = (g: Ptr<u8>, buf: Ptr<u8>) {
    (load(g, G_SIM) != 0).then(() {
        k :: usize = put_text(
            buf,
            0,
            "actor-runtime: rerun with ZEN_ACTOR_SEED="
        );
        k = put_number(buf, k, load(g, G_SIM_SEED));
        k = put_text(buf, k, "\n");
        write_all(2, str(data: buf, len: k)).ignore();
    });
}

// ---------------------------------------------------------------------
// starting the runtime
// ---------------------------------------------------------------------

// The second byte of the globals marks a spare thread's argument; the
// globals themselves mark sysmon's.
spare_marker = (g: Ptr<u8>) Ptr<u8> { g.offset(8) }

// Start a runtime thread running the runtime's thread body with `arg`.
start_thread = (g: Ptr<u8>, arg: Ptr<u8>) bool {
    n = aadd(g, G_THREADS, 1);
    (n < MAX_THREADS).match({
        false => { asub(g, G_THREADS, 1); false },
        true  => thread_spawn(load(g, G_ENTRY), arg).match({
            Ok(t)  => { astore(g.offset(G_THREAD_LIST), n, addr(t)); true },
            Err(_) => { astore(g.offset(G_THREAD_LIST), n, 0); false },
        }),
    })
}

// The body of every thread the runtime starts: a worker's driver, sysmon,
// the timer thread, or a spare waiting for a handed-off worker.
actor_thread* = (arg: Ptr<u8>) {
    g = globals();
    l = local();
    arg.same(g).match({
        true  => sysmon(g),
        false => arg.same(timer_marker(g)).match({ true => timers(g, l), false => {
            (!arg.same(spare_marker(g))).then(() {
                drive(g, l, arg);
                reattach(g, l);
            });
            spare_loop(g, l);
        } }),
    });
}

// The runtime, made by the first spawn; the others wait for it. `entry` is
// the code address of `actor_thread`, `exit` that of `actor_shutdown`,
// which becomes the process's exit hook. Null when it cannot be made.
runtime = (entry: usize, exit: usize) Ptr<u8> {
    block = process_block();
    // 4 is an `env.actor_mem` in progress on another thread: wait it out.
    seen: Res<usize> = loop<usize>((h) {
        was = atomic_cas_usize(word_at(block, PB_ONCE), 0, 1);
        (was != 4).then(() { h.break(was); });
        nanosleep_ns(1000).discard();
    });
    (seen.value_or(1) == 0).then(() {
        g  = map(GLOBALS_BYTES);
        ok = !g.is_null() && setup(g, entry);
        ok.then(() {
            store(block, PB_GLOBALS, addr(g));
            atomic_store_usize(word_at(block, 0), exit);
            atomic_store_usize(word_at(block, PB_ONCE), 2);
            (load(g, G_SIM) == 0).then(() {
                Range(0, load(g, G_WORKERS)).loop((i) { start_thread(g, worker_at(g, i)).unused(); });
            });
            (load(g, G_SYSMON_NS) > 0).then(() { start_thread(g, g).unused(); });
        });
        (!ok).then(() { atomic_store_usize(word_at(block, PB_ONCE), 3); });
    });
    loop(
        () { atomic_load_usize(word_at(block, PB_ONCE)) == 1 },
        (h) { nanosleep_ns(1000).discard(); }
    );
    globals()
}

// A home for `env.actor_mem`'s implementor: zeroed kernel memory that is
// never handed back, so it outlives main (a refused call leaks its page).
// Null when refused.
actor_keep* = (bytes: usize) Ptr<u8> { kernel((bytes + 7) / 8 * 8 + 8) }

// `env.actor_mem`: the `bytes`-byte Mem at `mem` becomes where every
// later runtime page comes from. False once the runtime is made, or being
// made, or after a Mem was already given.
actor_use_mem* = (bytes: usize, mem: Ptr<u8>) bool {
    block = process_block();
    (atomic_cas_usize(word_at(block, PB_ONCE), 0, 4) == 0).match({
        false => false,
        true  => {
            cell = actor_mem().is_null().match({
                true  => map(bytes),
                false => null_ptr<u8>(),
            });
            (!cell.is_null()).then(() {
                cell.copy_from(mem, bytes);
                atomic_store_usize(word_at(block, PB_MEM), addr(cell));
            });
            atomic_store_usize(word_at(block, PB_ONCE), 0);
            !cell.is_null()
        },
    })
}

// A positive number from the environment, or `fallback`.
env_number = (name: str, fallback: usize) usize {
    env_var(name).match({
        None     => fallback,
        Ok(text) => text.parse_i64().match({
            Ok(n) => n.to_usize().value_or(fallback),
            None  => fallback,
        }),
    })
}

// Workers: one per CPU the process may use (ZEN_ACTOR_WORKERS overrides),
// at most MAX_WORKERS. Sysmon's tick: ZEN_ACTOR_SYSMON_US microseconds,
// default 1000; 0 turns preemption off.
setup = (g: Ptr<u8>, entry: usize) bool {
    stub = stub_node(g);
    astore(g, G_INJ_HEAD, stub);
    astore(g, G_INJ_TAIL, stub);
    store(g, G_ENTRY, entry);
    // Slot 0 is never used, so Ref 0 names no actor.
    store(g, G_SLOT_FRESH, 1);
    // ZEN_ACTOR_SEED=n: one thread, the order picked by the seed.
    env_var("ZEN_ACTOR_SEED").match({
        None     => (),
        Ok(text) => {
            seed = text.parse_i64().match({ Ok(n) => n.to_usize().value_or(
                0
            ), None => 0 });
            store(g, G_SIM_SEED, seed);
            store(g, G_SIM, (seed << 1) | 1);
        },
    });
    sim    = load(g, G_SIM) != 0;
    wanted = sim.match({ true => 1, false => env_number(
        "ZEN_ACTOR_WORKERS",
        cpu_count()
    ) });
    n      = (wanted == 0).match({ true => 1, false => (wanted > MAX_WORKERS).match({ true => MAX_WORKERS, false => wanted }) });
    store(
        g,
        G_SYSMON_NS,
        sim.match({ true => 0, false => env_number(
            "ZEN_ACTOR_SYSMON_US",
            1000
        ) * 1000 })
    );
    // ZEN_ACTOR_CHECKED=1: one mapping per block, unmapped when freed.
    set_checked(central_of(g), env_number("ZEN_ACTOR_CHECKED", 0) != 0);
    // ZEN_ACTOR_RECORDER=0: no flight recorder, so no causes in reports.
    store(
        g,
        G_REC_ON,
        (env_number(
            "ZEN_ACTOR_RECORDER",
            1
        ) != 0).match({ true => 1, false => 0 })
    );
    env_var("ZEN_ACTOR_TRACE").match({
        None  => (),
        Ok(_) => {
            cap = env_number("ZEN_ACTOR_TRACE_EVENTS", 1000000);
            buf = map(cap * TRACE_WORDS * 8);
            (!buf.is_null()).then(() {
                store(g, G_TRACE_CAP, cap);
                store(g, G_TRACE_T0, clock(g));
                astore(g, G_TRACE, addr(buf));
            });
        },
    });
    sim.then(() {
        store(g, G_READY, addr(map(SIM_READY * 8)));
        store(g, G_READY_CAP, SIM_READY);
    });
    base = map(n * WORKER_BYTES);
    ready ::= !base.is_null() && (!sim || load(g, G_READY) != 0);
    ready.then(() {
        store(g, G_WORKERS, n);
        store(g, G_WORKER_BASE, addr(base));
        Range(0, n).loop((i) {
            w = worker_at(g, i);
            store(w, W_ID, i);
            store(w, W_RANDOM, i * 2654435761 + 1);
            ready = ready && parker_init(parker_of(
                w
            )).match({ Ok(_) => true, Err(_) => false });
        });
        ready = ready && mutex_init(g.offset(
            G_JOIN_LOCK
        )).match({ Ok(_) => true, Err(_) => false })
            && cond_init(g.offset(
                G_JOIN_COND
            )).match({ Ok(_) => true, Err(_) => false })
            && mutex_init(g.offset(
                G_SPARE_LOCK
            )).match({ Ok(_) => true, Err(_) => false })
            && cond_init(g.offset(
                G_SPARE_COND
            )).match({ Ok(_) => true, Err(_) => false })
            && parker_init(g.offset(
                G_EXIT_PARKER
            )).match({ Ok(_) => true, Err(_) => false })
            && parker_init(g.offset(
                G_TIMER_PARKER
            )).match({ Ok(_) => true, Err(_) => false });
    });
    ready
}

// ---------------------------------------------------------------------
// the compilers' entry points
// ---------------------------------------------------------------------

// A zeroed body for an actor whose compiler-made record is `record_bytes`,
// starting the runtime on first use; null when memory or the runtime
// cannot be had. `entry` and `exit` are the code addresses of
// `actor_thread` and `actor_shutdown`.
actor_new* = (record_bytes: usize, entry: usize, exit: usize) Ptr<u8> {
    g = runtime(entry, exit);
    g.is_null().match({
        true  => g,
        false => {
            bytes = (B_RECORD + record_bytes + 7) / 8 * 8;
            a     = new_block(g, local(), bytes);
            (!a.is_null()).then(() { zero(a, bytes); });
            a
        },
    })
}

// One process-wide copy of `bytes` at `init`, made by the first caller; later
// callers (and `bytes` 0) get the same copy. The compilers keep the process
// Env here, so an actor's record need not carry its own copy of the Context:
// a turn builds the Context from this and the actor's allocator.
actor_env* = (bytes: usize, init: Ptr<u8>) Ptr<u8> {
    g = globals();
    (!g.is_null() && aload(g, G_ENV) == 0 && bytes > 0).then(() {
        made = new_block(g, local(), bytes);
        (!made.is_null()).then(() {
            made.copy_from(init, bytes);
            (acas(g, G_ENV, 0, addr(made)) != 0).then(() { free_block(g, local(), made); });
        });
    });
    g.is_null().match({ true => g, false => at(aload(g, G_ENV)) })
}

// Where the compiler's record (state, allocator) lives in a body.
actor_record* = (cell: Ptr<u8>) Ptr<u8> { cell.offset(B_RECORD) }

// Release a body whose actor never started.
actor_discard* = (cell: Ptr<u8>) { free_block(globals(), local(), cell); }

// Register the actor and queue its `started` turn (code address, or 0).
// `stopped` runs after its last message, before its memory goes; `receive`
// runs a message sent through a message-typed Ref (0 when it has none). 0
// started, 2 no slot can be had or the process is exiting.
actor_start* = (
    cell    : Ptr<u8>,
    started : usize,
    stopped : usize,
    receive : usize,
    name    : str
) i32 {
    g     = globals();
    l     = local();
    index = (aload(g, G_STATE) == 2).match({ true => 0, false => take_slot(g, l) });
    (index == 0).match({
        true  => 2,
        false => {
            slot = slot_at(g, index);
            gen  = gen_of(aload(slot, S_LIFE));
            store(cell, B_REF, as_ref(index, gen));
            store(cell, B_STOPPED, stopped);
            store(cell, B_RECEIVE, receive);
            store(cell, B_NAME, name_word(name));
            mailbox_init(cell);
            arel(slot, S_WAITING, 0);
            arel(slot, S_BODY, addr(cell));
            m = (started == 0).match({ true => null_ptr<u8>(), false => new_block(
                g,
                l,
                M_PAYLOAD
            ) });
            // The life word already holds this generation, with nothing
            // accepted; a stale sender may be adding and taking back a
            // count this moment, so the started turn is added, not stored.
            (!m.is_null()).then(() {
                store(m, M_TURN, started);
                store(m, M_CAUSE, load(l, L_MSG));
                mailbox_put(cell, addr(m));
                aadd(slot, S_LIFE, SCHED + 1);
                schedule(g, l, cell);
            });
            0
        },
    })
}

// The Ref of the actor whose turn runs on this thread, or 0 outside one.
actor_me* = () u64 {
    a = at(load(local(), L_ACTOR));
    a.is_null().match({ true => 0, false => load(a, B_REF).to_u64() })
}

// The Ref of a started actor.
actor_ref* = (cell: Ptr<u8>) u64 { load(cell, B_REF).to_u64() }

// One str or byte-buffer argument copied after the payload record, and
// where its pointer and length go in the copy (the compiler fills these).
SLICE_WORDS: usize = 4

// Send a message built from the payload record (`size` bytes at `data`)
// and `count` slices. 0 accepted (or waiting in this turn's outbox), 1
// Closed, 2 Full: too large, or out of memory. Waits for room when the
// mailbox is full; see `send_message`.
actor_send* = (
    r      : u64,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) i32 {
    post(r, turn, data, size, slices, count, MODE_SEND)
}

// As `actor_send`, but a full mailbox answers 2 (Full) and drops the
// message.
actor_offer* = (
    r      : u64,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) i32 {
    post(r, turn, data, size, slices, count, MODE_OFFER)
}

// As `actor_send`, past the bound: for replies, whose slot the asker
// reserved by waiting for exactly one.
actor_reply* = (
    r      : u64,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) i32 {
    post(r, turn, data, size, slices, count, MODE_RESERVED)
}

post = (
    r      : u64,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize,
    mode   : usize
) i32 {
    g = globals();
    g.is_null().match({
        true  => SEND_CLOSED,
        false => {
            l = local();
            m = build(g, l, turn, data, size, slices, count);
            m.is_null().match({
                true  => SEND_FULL,
                false => {
                    result = send_message(
                        g,
                        l,
                        r.to_usize().value_or(0),
                        m,
                        mode
                    );
                    (result == SEND_QUEUED).match({ true => SEND_OK, false => result })
                },
            })
        },
    })
}

// The message for a send: the turn, the payload record and its slices
// copied into one block. Null when it is too large or memory runs out.
build = (
    g      : Ptr<u8>,
    l      : Ptr<u8>,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) Ptr<u8> {
            total ::= M_PAYLOAD + size;
            fits  ::= size <= MAX_MESSAGE_BYTES;
            Range(0, count).loop((i) {
                n    = load(slices, i * SLICE_WORDS + 3);
                fits = fits && n <= MAX_MESSAGE_BYTES - (total - M_PAYLOAD);
                fits.then(() { total = total + n; });
            });
            block = (total < MESSAGE_MIN).match({ true => MESSAGE_MIN, false => total });
            m     = fits.match({ true => new_block(
                g,
                l,
                block
            ), false => null_ptr<u8>() });
            m.is_null().match({
                true  => null_ptr<u8>(),
                false => {
                    store(m, M_TURN, turn);
                    store(m, M_CAUSE, load(l, L_MSG));
                    payload = m.offset(M_PAYLOAD);
                    (size > 0).then(() { payload.copy_from(data, size); });
                    tail ::= payload.offset(size);
                    Range(0, count).loop((i) {
                        n = load(slices, i * SLICE_WORDS + 3);
                        (n > 0).then(
                            () { tail.copy_from(
                                pointer_at(load(slices, i * SLICE_WORDS + 2)),
                                n
                            ); }
                        );
                        store(
                            payload.offset(load(slices, i * SLICE_WORDS)),
                            0,
                            addr(tail)
                        );
                        store(
                            payload.offset(load(slices, i * SLICE_WORDS + 1)),
                            0,
                            n
                        );
                        tail = tail.offset(n);
                    });
                    m
                },
            })
}

// ---------------------------------------------------------------------
// watches
// ---------------------------------------------------------------------

// The message blocks for `actor_watch` and `actor_after`, built as a send
// builds them; 0 when too large or out of memory.
actor_message* = (
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) usize {
    g = globals();
    g.is_null().match({
        true  => 0,
        false => addr(build(g, local(), turn, data, size, slices, count)),
    })
}

// When the actor `r` names ends, deliver `done` (it stopped) or `failed`
// (a trap ended it) to `to`; the runtime owns both blocks from here. An
// actor already gone gets `done` at once. 0, or 2 (Full) when a block is
// missing or memory runs out.
actor_watch* = (r: u64, to: u64, done: usize, failed: usize) i32 {
    g = globals();
    g.is_null().match({
        true  => SEND_CLOSED,
        false => {
            l = local();
            e = (done != 0 && failed != 0).match({
                true  => new_block(g, l, ENTRY_BYTES),
                false => null_ptr<u8>(),
            });
            e.is_null().match({
                true  => {
                    drop_message(g, l, done);
                    drop_message(g, l, failed);
                    SEND_FULL
                },
                false => {
                    store(e, E_NEXT, 0);
                    store(e, E_TO, to.to_usize().value_or(0));
                    store(e, E_DONE, done);
                    store(e, E_FAILED, failed);
                    watch_slot(g, r.to_usize().value_or(0), e).match({
                        true  => (),
                        false => notify(g, l, e, false),
                    });
                    SEND_OK
                },
            })
        },
    })
}

drop_message = (g: Ptr<u8>, l: Ptr<u8>, m: usize) {
    (m != 0).then(() { free_block(g, l, at(m)); });
}

// Put entry `e` on the watch list of the actor `r` names, unless that
// actor has already been finalised. Marking the life word makes
// `finalize` take the list; a racing finalize sees the change and retries.
watch_slot = (g: Ptr<u8>, r: usize, e: Ptr<u8>) bool {
    slot = slot_of_ref(g, r);
    gen  = ref_gen(r);
    word = g.offset(G_WATCH_LOCK * 8).to<u32>();
    lock(word);
    kept = !slot.is_null() && loop<bool>((h) {
        v = aload(slot, S_LIFE);
        (gen_of(v) != gen).then(() { h.break(false); });
        (acas(slot, S_LIFE, v, v | WATCHED) == v).then(() { h.break(true); });
    }).value_or(false);
    kept.then(() {
        store(e, E_GEN, gen);
        store(e, E_NEXT, load(slot, S_WATCH));
        store(slot, S_WATCH, addr(e));
    });
    unlock(word);
    kept
}

// The watch list of a slot whose generation was just retired.
take_watchers = (g: Ptr<u8>, slot: Ptr<u8>) Ptr<u8> {
    word = g.offset(G_WATCH_LOCK * 8).to<u32>();
    lock(word);
    first = at(load(slot, S_WATCH));
    store(slot, S_WATCH, 0);
    unlock(word);
    first
}

// Deliver each entry's `done` or `failed` message, past the bound (a
// watcher must never miss one, and nothing here may wait), and free the
// rest.
notify = (g: Ptr<u8>, l: Ptr<u8>, first: Ptr<u8>, failed: bool) {
    e ::= first;
    loop(() { !e.is_null() }, (h) {
        next = at(load(e, E_NEXT));
        sent = load(e, failed.match({ true => E_FAILED, false => E_DONE }));
        drop_message(
            g,
            l,
            load(e, failed.match({ true => E_DONE, false => E_FAILED }))
        );
        send_message(
            g,
            l,
            load(e, E_TO),
            at(sent),
            MODE_RESERVED
        ).ignore_status();
        free_block(g, l, e);
        e = next;
    });
}

// ---------------------------------------------------------------------
// timers
// ---------------------------------------------------------------------

// The longest delay: about 35 years, so a deadline never wraps.
MAX_DELAY_MS: u64 = 1099511627776

timer_marker = (g: Ptr<u8>) Ptr<u8> { g.offset(16) }

now_ns = (g: Ptr<u8>) usize { clock(g) }

// Deliver a message built from the payload to the actor `r` names after
// `ms` milliseconds, past the bound. 0, 1 (Closed: `r` has already
// stopped), or 2 (Full: too large, out of memory, or no timer thread).
// A timer whose actor stops before it fires is dropped.
actor_after* = (
    r      : u64,
    ms     : u64,
    turn   : usize,
    data   : Ptr<u8>,
    size   : usize,
    slices : Ptr<u8>,
    count  : usize
) i32 {
    g  = globals();
    rr = r.to_usize().value_or(0);
    (g.is_null() || !live_ref(g, rr)).match({
        true  => SEND_CLOSED,
        false => {
            l = local();
            m = build(g, l, turn, data, size, slices, count);
            e = m.is_null().match({
                true  => null_ptr<u8>(),
                false => new_block(g, l, ENTRY_BYTES),
            });
            (e.is_null() || !timers_on(g)).match({
                true  => {
                    drop_message(g, l, addr(m));
                    (!e.is_null()).then(() { free_block(g, l, e); });
                    SEND_FULL
                },
                false => {
                    wait = (ms > MAX_DELAY_MS).match({ true => MAX_DELAY_MS, false => ms });
                    store(e, E_TO, rr);
                    store(
                        e,
                        E_AT,
                        now_ns(g) + wait.to_usize().value_or(0) * 1000000
                    );
                    store(e, E_MSG, addr(m));
                    timer_add(g, e);
                    SEND_OK
                },
            })
        },
    })
}

live_ref = (g: Ptr<u8>, r: usize) bool {
    slot = slot_of_ref(g, r);
    !slot.is_null() && gen_of(aload(slot, S_LIFE)) == ref_gen(r) && (aload(slot, S_LIFE) & CLOSED) == 0
}

// Start the timer thread on first use; false when it cannot be started.
timers_on = (g: Ptr<u8>) bool {
    (load(g, G_SIM) != 0).then(() { astore(g, G_TIMER_ON, 2); });
    (acas(g, G_TIMER_ON, 0, 1) == 0).then(() {
        astore(
            g,
            G_TIMER_ON,
            start_thread(g, timer_marker(g)).match({ true => 2, false => 0 })
        );
    });
    loop(() { aload(g, G_TIMER_ON) == 1 }, (h) { spin_hint(); });
    aload(g, G_TIMER_ON) == 2
}

// Insert `e` in deadline order, after any entry due at the same time, so
// timers with equal deadlines fire in the order they were set. A deadline
// at or past the last one (a steady interval) appends at once.
timer_add = (g: Ptr<u8>, e: Ptr<u8>) {
    word = g.offset(G_TIMER_LOCK * 8).to<u32>();
    due  = load(e, E_AT);
    lock(word);
    aadd(g, G_TIMER_N, 1);
    last = at(load(g, G_TIMER_LAST));
    prev ::= null_ptr<u8>();
    (!last.is_null() && load(last, E_AT) <= due).match({
        true  => { prev = last; },
        false => {
            cur ::= at(load(g, G_TIMERS));
            loop(() { !cur.is_null() && load(cur, E_AT) <= due }, (h) {
                prev = cur;
                cur  = at(load(cur, E_NEXT));
            });
        },
    });
    prev.is_null().match({
        true  => {
            store(e, E_NEXT, load(g, G_TIMERS));
            store(g, G_TIMERS, addr(e));
        },
        false => {
            store(e, E_NEXT, load(prev, E_NEXT));
            store(prev, E_NEXT, addr(e));
        },
    });
    (load(e, E_NEXT) == 0).then(() { store(g, G_TIMER_LAST, addr(e)); });
    unlock(word);
    // A new earliest deadline: the timer thread may be sleeping past it.
    prev.is_null().then(() { unpark(g.offset(G_TIMER_PARKER)); });
}

// The timer thread: take every entry that is due, deliver it, and sleep
// until the next deadline (or until a timer_add brings one forward).
timers = (g: Ptr<u8>, l: Ptr<u8>) {
    word   = g.offset(G_TIMER_LOCK * 8).to<u32>();
    parker = g.offset(G_TIMER_PARKER);
    loop(() { aload(g, G_STATE) != 2 }, (h) {
        now = now_ns(g);
        lock(word);
        first = at(load(g, G_TIMERS));
        last ::= null_ptr<u8>();
        cur  ::= first;
        loop(() { !cur.is_null() && load(cur, E_AT) <= now }, (h2) {
            last = cur;
            cur  = at(load(cur, E_NEXT));
        });
        store(g, G_TIMERS, addr(cur));
        cur.is_null().then(() { store(g, G_TIMER_LAST, 0); });
        wait = cur.is_null().match({ true => 0, false => load(
            cur,
            E_AT
        ) - now });
        unlock(word);
        last.is_null().match({
            true  => (wait == 0).match({
                true  => park(parker),
                false => park_for(parker, wait.to_u64()),
            }),
            false => {
                store(last, E_NEXT, 0);
                fire(g, l, first);
            },
        });
    });
}

// Deliver a chain of due timers. Each is counted down only after its
// message is in a mailbox, so an exiting runtime never sees a moment
// with neither the timer nor its message.
fire = (g: Ptr<u8>, l: Ptr<u8>, first: Ptr<u8>) {
    e ::= first;
    loop(() { !e.is_null() }, (h) {
        next = at(load(e, E_NEXT));
        send_message(
            g,
            l,
            load(e, E_TO),
            at(load(e, E_MSG)),
            MODE_RESERVED
        ).ignore_status();
        free_block(g, l, e);
        asub(g, G_TIMER_N, 1);
        e = next;
    });
    (aload(g, G_STATE) == 1).then(() { unpark(g.offset(G_EXIT_PARKER)); });
}

// Close admission: messages already accepted still run, then `stopped`,
// then the actor is freed. Idempotent; a stale Ref does nothing.
actor_stop* = (r: u64) {
    g = globals();
    (!g.is_null()).then(() { stop_ref(g, local(), r.to_usize().value_or(0)); });
}

stop_ref = (g: Ptr<u8>, l: Ptr<u8>, r: usize) {
    slot = slot_of_ref(g, r);
    gen  = ref_gen(r);
    (!slot.is_null()).then(() {
        loop((h) {
            v = aload(slot, S_LIFE);
            (gen_of(v) != gen || (v & CLOSED) != 0).then(() { h.break(); });
            take = (v & (SCHED | BLOCKED)) == 0;
            want = v | CLOSED | take.match({ true => SCHED, false => 0 });
            (acas(slot, S_LIFE, v, want) == v).then(() {
                take.then(() { schedule(g, l, at(load(slot, S_BODY))); });
                h.break();
            });
        });
    });
}

// Wait until the actor has stopped and run `stopped`. From the actor
// itself it returns at once. A thread driving a worker hands the worker
// off first, so the actors queued on it keep running meanwhile.
actor_join* = (r: u64) {
    g = globals();
    (!g.is_null()).then(() {
        l    = local();
        rr   = r.to_usize().value_or(0);
        slot = slot_of_ref(g, rr);
        gen  = ref_gen(rr);
        me   = at(load(l, L_ACTOR));
        own  = !me.is_null() && load(me, B_REF) == rr;
        sim  = load(g, G_SIM) != 0;
        (sim && !own && !slot.is_null()).then(() {
            loop(
                () { gen_of(aload(slot, S_LIFE)) == gen },
                (h) { sim_wait(g, l); }
            );
        });
        (!sim && !own && !slot.is_null() && gen_of(aload(slot, S_LIFE)) == gen).then(() {
            (load(l, L_WORKER) != 0).then(() { detach(g, l); });
            aadd(g, G_JOINERS, 1);
            mutex_lock(g.offset(G_JOIN_LOCK));
            loop(() { gen_of(aload(slot, S_LIFE)) == gen }, (h) {
                cond_wait(g.offset(G_JOIN_COND), g.offset(G_JOIN_LOCK));
            });
            mutex_unlock(g.offset(G_JOIN_LOCK));
            asub(g, G_JOINERS, 1);
        });
    });
}

// The exit hook, on the main thread after `main` returns: wait until every
// accepted message (and every message those sent) has run, stop every
// actor still alive and let each run `stopped`, then stop the threads.
actor_shutdown* = () {
    g = globals();
    (!g.is_null()).then(() {
        l = local();
        astore(g, G_STATE, 1);
        before ::= usize.MAX;
        loop((h) {
            wait_quiet(g);
            live = live_actors(g);
            // Nothing left, or the last round of stops freed nothing: actors
            // still alive are wedged waiting for each other.
            (live > 0 && live == before && blocked_actors(g) > 0).then(() {
                stall_report(g, "wedged at exit; stopping them");
            });
            (live == 0 || live == before).then(() { h.break(); });
            before = live;
            Range(1, aload(g, G_SLOT_FRESH)).loop((i) {
                slot = slot_at(g, i);
                life = aload(slot, S_LIFE);
                (aload(slot, S_BODY) != 0).then(() { stop_ref(g, l, as_ref(i, gen_of(life))); });
            });
        });
        astore(g, G_STATE, 2);
        (env_number("ZEN_ACTOR_STATS", 0) != 0).then(() { print_stats(g, l); });
        Range(0, load(g, G_WORKERS)).loop((i) { unpark(parker_of(worker_at(g, i))); });
        unpark(g.offset(G_TIMER_PARKER));
        mutex_lock(g.offset(G_SPARE_LOCK));
        cond_broadcast(g.offset(G_SPARE_COND));
        mutex_unlock(g.offset(G_SPARE_LOCK));
        Range(0, aload(g, G_THREADS)).loop((i) {
            t = aload(g.offset(G_THREAD_LIST), i);
            (t != 0).then(() { thread_join(at(t)).ignore(); });
        });
        trace_dump(g);
    });
}

// The trace as text, one event per line, oldest first.
TRACE_OUT: usize = 65536

trace_dump = (g: Ptr<u8>) {
    buf = aload(g, G_TRACE);
    out = (buf != 0).match({ true => map(TRACE_OUT), false => null_ptr<u8>() });
    (!out.is_null()).then(() {
        env_var("ZEN_ACTOR_TRACE").match({
            None     => (),
            Ok(path) => {
                n ::= put_text(out, 0, path);
                // A fresh mapping is zeroed: the path is already terminated.
                fd = openat(
                    at_fdcwd(),
                    out,
                    o_wronly() + o_creat() + o_trunc() + o_cloexec(),
                    420
                );
                (fd >= 0).then(() {
                    f       = fd.to_i32().value_or(-1);
                    claimed = aload(g, G_TRACE_N);
                    cap     = load(g, G_TRACE_CAP);
                    kept    = (claimed < cap).match({ true => claimed, false => cap });
                    n       = put_text(
                        out,
                        0,
                        "# zen actor trace: index ns kind from to message id cause\n"
                    );
                    n       = put_text(
                        out,
                        n,
                        "# kinds: 1 send 2 park 3 release 4 refuse 5 take 6 break 7 block 8 unblock 9 sleep 10 wake 11 closed 12 wait\n"
                    );
                    n       = put_text(
                        out,
                        n,
                        "# a take's id is the message's flight-recorder id, its cause the id whose turn sent it (0: none)\n"
                    );
                    n       = put_text(out, n, "# workers ");
                    n       = put_number(out, n, load(g, G_WORKERS));
                    n       = put_text(out, n, " events ");
                    n       = put_number(out, n, claimed);
                    n       = put_text(out, n, " kept ");
                    n       = put_number(out, n, kept);
                    n       = put_text(out, n, "\n");
                    Range(0, kept).loop((i) {
                        e    = at(buf).offset(i * TRACE_WORDS * 8);
                        word = load(e, 1);
                        n    = put_number(out, n, i);
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, load(e, 0));
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, word & 255);
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, word >> 8);
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, load(e, 2));
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, load(e, 3));
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, load(e, 4));
                        n    = put_text(out, n, " ");
                        n    = put_number(out, n, load(e, 5));
                        n    = put_text(out, n, "\n");
                        (n > TRACE_OUT - 160).then(() {
                            write_all(f, str(data: out, len: n)).ignore();
                            n = 0;
                        });
                    });
                    write_all(f, str(data: out, len: n)).ignore();
                    close(f).discard();
                });
            },
        });
    });
}

// Actors spawned and not yet finalised (a scan of the registry).
live_actors = (g: Ptr<u8>) usize {
    n :: usize = 0;
    Range(1, aload(g, G_SLOT_FRESH)).loop((i) {
        (aload(slot_at(g, i), S_BODY) != 0).then(() { n = n + 1; });
    });
    n
}

// Actors waiting for room in a full mailbox.
blocked_actors = (g: Ptr<u8>) usize {
    n :: usize = 0;
    Range(1, aload(g, G_SLOT_FRESH)).loop((i) {
        slot = slot_at(g, i);
        (aload(slot, S_BODY) != 0 && (aload(slot, S_LIFE) & BLOCKED) != 0).then(() { n = n + 1; });
    });
    n
}

// The wait-for graph on stderr: each blocked actor (by registry index), its
// mailbox depth and the one actor it waits on, then the cycles in it. Only
// slot words are read, and slots are never freed, so this is safe while
// other threads run; a graph that is still changing may read inconsistently.
REPORT_ACTORS: usize = 64
REPORT_CYCLES: usize = 16
REPORT_CHAINS: usize = 8

stall_report = (g: Ptr<u8>, why: str) {
    buf = map(4096);
    (!buf.is_null()).then(() {
        blocked = blocked_actors(g);
        n :: usize = put_text(buf, 0, "actor-runtime: stuck (");
        n = put_text(buf, n, why);
        n = put_text(buf, n, "): ");
        n = put_number(buf, n, blocked);
        n = put_text(buf, n, " actors blocked, ");
        n = put_number(buf, n, aload(g, G_SLEEPING));
        n = put_text(buf, n, " of ");
        n = put_number(buf, n, load(g, G_WORKERS));
        n = put_text(buf, n, " workers asleep\n");
        write_all(2, str(data: buf, len: n)).ignore();
        shown :: usize = 0;
        Range(1, aload(g, G_SLOT_FRESH)).loop((i) {
            slot = slot_at(g, i);
            life = aload(slot, S_LIFE);
            (shown < REPORT_ACTORS && aload(slot, S_BODY) != 0 && (life & BLOCKED) != 0).then(() {
                k :: usize = put_text(buf, 0, "actor-runtime:   actor ");
                k = put_actor(buf, k, i, name_of(g, i));
                k = put_text(buf, k, " mailbox ");
                k = put_number(buf, k, count_of(life));
                k = put_text(buf, k, " waits on ");
                j = ref_index(aload(slot, S_WAITING));
                k = put_actor(buf, k, j, name_of(g, j));
                k = put_text(buf, k, "\n");
                write_all(2, str(data: buf, len: k)).ignore();
                (shown < REPORT_CHAINS).then(
                    () { blocked_turn(g, buf, at(aload(slot, S_BODY))); }
                );
                shown = shown + 1;
            });
        });
        (blocked > shown).then(() {
            k :: usize = put_text(buf, 0, "actor-runtime:   and ");
            k = put_number(buf, k, blocked - shown);
            k = put_text(buf, k, " more blocked\n");
            write_all(2, str(data: buf, len: k)).ignore();
        });
        cycles :: usize = 0;
        Range(1, aload(g, G_SLOT_FRESH)).loop((i) {
            (cycles < REPORT_CYCLES && cycle_from(g, i)).then(() {
                k :: usize = put_text(buf, 0, "actor-runtime:   cycle ");
                k = put_actor(buf, k, i, name_of(g, i));
                j ::= ref_index(aload(slot_at(g, i), S_WAITING));
                // A long cycle is cut short to fit the line.
                loop(() { j != i && k < 3800 }, (c) {
                    k = put_text(buf, k, " -> ");
                    k = put_actor(buf, k, j, name_of(g, j));
                    j = ref_index(aload(slot_at(g, j), S_WAITING));
                });
                k = (j == i).match({ true => put_text(buf, k, " -> "), false => put_text(buf, k, " ...") });
                k = (j == i).match({ true => put_actor(
                    buf,
                    k,
                    i,
                    name_of(g, i)
                ), false => k });
                k = put_text(buf, k, "\n");
                write_all(2, str(data: buf, len: k)).ignore();
                cycles = cycles + 1;
            });
        });
        seed_hint(g, buf);
    });
}

// How a blocked actor got stuck: the turn whose send is waiting in its
// outbox, and the chain of turns that led to it.
blocked_turn = (g: Ptr<u8>, buf: Ptr<u8>, body: Ptr<u8>) {
    side = at(load(body, B_SIDE));
    held = side.is_null().match({ true => 0, false => load(side, D_OUT_N).min(load(side, D_OUT_CAP)) });
    turn :: usize = 0;
    Range(0, held).loop((j) {
        e = at(load(side, D_OUTBOX)).offset(j * OUTBOX_ENTRY);
        (turn == 0 && aload(e, 2) == PENDING).then(() { turn = load(at(load(e, 1)), M_CAUSE); });
    });
    (turn != 0).then(() {
        n ::= put_text(
            buf,
            0,
            "actor-runtime:     blocked sending in the turn handling "
        );
        n = put_id(buf, n, turn);
        n = put_text(buf, n, "\n");
        write_all(2, str(data: buf, len: n)).ignore();
        e = find_event(g, turn);
        e.is_null().match({
            true  => write_all(
                2,
                "actor-runtime:       older history is not kept\n"
            ).ignore(),
            false => explain(g, buf, "actor-runtime:       ", turn, load(e, 1)),
        });
    });
}

// Whether blocked actor `i` starts a wait-for cycle with `i` its lowest
// index, so each cycle is reported once (the walk of `cycle_through`).
cycle_from = (g: Ptr<u8>, i: usize) bool {
    limit = aload(g, G_SLOT_FRESH);
    j    ::= i;
    mark ::= i;
    hops :: usize = 0;
    lap  :: usize = 1;
    loop<bool>(() { hops < limit }, (h) {
        slot = slot_at(g, j);
        next = ref_index(aload(slot, S_WAITING));
        (aload(slot, S_BODY) == 0 || (aload(slot, S_LIFE) & BLOCKED) == 0 || next < i).then(() { h.break(false); });
        (next == i).then(() { h.break(true); });
        (next == mark || next >= limit).then(() { h.break(false); });
        j    = next;
        hops = hops + 1;
        (hops == lap).then(() { mark = j; lap = lap * 2; });
    }).value_or(false)
}

// Every worker asleep with nothing queued, no thread finishing a turn
// without a worker, and no timer still to fire: nothing can make more work.
quiet = (g: Ptr<u8>) bool {
    aload(g, G_SLEEPING) == load(g, G_WORKERS) && aload(g, G_DETACHED) == 0 && injector_empty(g)
        && aload(g, G_TIMER_N) == 0
}

wait_quiet = (g: Ptr<u8>) {
    (load(g, G_SIM) != 0).match({
        true  => loop(() { sim_step(g, local()) }, (h) {}),
        false => loop(() { !quiet(g) }, (h) { park(g.offset(G_EXIT_PARKER)); }),
    });
}

discard = (code: i64) {}

// A flag the caller has no use for.
unused = (flag: bool) {}

// A word the caller has no use for.
ignore_word = (word: usize) {}

// A status the caller has no use for.
ignore_status = (code: i32) {}

// ZEN_ACTOR_STATS=1: the runtime's counters on stderr at exit, one line.
STAT_NAMES: str = "queued closed full releases breaks finalized handoffs preempts steals spreads failed"

print_stats = (g: Ptr<u8>, l: Ptr<u8>) {
    buf = new_block(g, l, 512);
    (!buf.is_null()).then(() {
        n :: usize = 0;
        n = put_text(buf, n, "actor-runtime:");
        i :: usize = 0;
        STAT_NAMES.split(' ').loop((name) {
            n = put_text(buf, n, " ");
            n = put_text(buf, n, name);
            n = put_text(buf, n, "=");
            n = put_number(buf, n, aload(g, G_STATS + i));
            i = i + 1;
        });
        n = put_text(buf, n, "\n");
        write_all(2, str(data: buf, len: n)).ignore();
        free_block(g, l, buf);
    });
}

put_text = (buf: Ptr<u8>, at: usize, text: str) usize {
    (text.len > 0).then(() { buf.offset(at).copy_from(text.ptr(), text.len); });
    at + text.len
}

NAME_SHIFT: usize = 48
NAME_ADDR: usize = 281474976710655
NAME_MAX: usize = 128

// An actor type's name as one word: its static bytes' address | length.
name_word = (name: str) usize {
    addr(name.ptr()) | (name.len.min(NAME_MAX) << NAME_SHIFT)
}

// The name word of the actor in registry slot `i`; 0 when it has none.
name_of = (g: Ptr<u8>, i: usize) usize {
    body = aload(slot_at(g, i), S_BODY);
    (i == 0 || body == 0).match({ true => 0, false => load(at(body), B_NAME) })
}

// An actor as Name#index: its type's name and its registry index.
put_actor = (buf: Ptr<u8>, k: usize, index: usize, name: usize) usize {
    len  = name >> NAME_SHIFT;
    text = (len == 0).match({ true => "actor", false => str(
        data: at(name & NAME_ADDR),
        len: len
    ) });
    n ::= put_text(buf, k, text);
    n = put_text(buf, n, "#");
    put_number(buf, n, index)
}

// A recorder id as m<thread>.<sequence>.
put_id = (buf: Ptr<u8>, k: usize, id: usize) usize {
    n ::= put_text(buf, k, "m");
    n = put_number(buf, n, id >> ID_SHIFT);
    n = put_text(buf, n, ".");
    put_number(buf, n, id & ID_MASK)
}

put_number = (buf: Ptr<u8>, at: usize, value: usize) usize {
    digits :: usize = 1;
    scale  ::= value;
    loop(() { scale >= 10 }, (h) { scale = scale / 10; digits = digits + 1; });
    v ::= value;
    k ::= digits;
    loop(() { k > 0 }, (h) {
        k = k - 1;
        buf.write(at + k, (48 + v % 10).to_u8().value_or(48));
        v = v / 10;
    });
    at + digits
}
