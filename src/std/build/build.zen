// Build files are ordinary Zen programs handed a `Builder`.
// Phase order is parse modules -> run build.zen -> compile: a build may
// inspect parsed declarations, but cannot call code from its project.

{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ Vec } = std.collections
{ str } = std.text
{ Res, Ok, None, Range, Path, Duration, Error } = std.core

Module* = {
    functions* = (self: @Self, a: Alloc) Res<Vec<Function>, AllocError>
}

Function* = {}

BuildFault* = { NotFound | FetchFailed | VersionConflict | HashMismatch }
BuildFault.impl(Error, {})

BuildError* = BuildFault | AllocError

Os* = { Macos | Linux | Windows }

Arch* = { X86_64 | Arm64 }

Abi* = { Gnu | Musl | Msvc | Darwin }

StableName* = {
    stable_name* ::= (self: @Self) str
}

Os.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ Macos => "macos", Linux => "linux", Windows => "windows" })
    }
})

Arch.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ X86_64 => "x86_64", Arm64 => "arm64" })
    }
})

Abi.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ Gnu => "gnu", Musl => "musl", Msvc => "msvc", Darwin => "darwin" })
    }
})

Target* = {
    os*: Os,
    arch*: Arch,
    abi*: Abi,

    // Clang's canonical target spelling. None means the three independently
    // valid coordinates do not form a target this toolchain supports.
    clang_triple* = (self: @Self) Res<str> {
        self.os.match({
            Linux   => self.arch.match({
                X86_64 => self.abi.match({
                    Gnu => Ok("x86_64-linux-gnu"), Musl => Ok("x86_64-linux-musl"), _ => None
                }),
                Arm64  => self.abi.match({
                    Gnu => Ok("aarch64-linux-gnu"), Musl => Ok("aarch64-linux-musl"), _ => None
                }),
            }),
            Macos   => self.abi.match({
                Darwin => self.arch.match({
                    X86_64 => Ok("x86_64-apple-darwin"),
                    Arm64  => Ok("arm64-apple-darwin"),
                }),
                _      => None,
            }),
            Windows => self.arch.match({
                X86_64 => self.abi.match({
                    Msvc => Ok("x86_64-pc-windows-msvc"),
                    Gnu  => Ok("x86_64-w64-windows-gnu"),
                    _    => None,
                }),
                Arm64  => self.abi.match({
                    Msvc => Ok("aarch64-pc-windows-msvc"),
                    _    => None,
                }),
            }),
        })
    }
}

// Parse the target spellings accepted by `--target`: clang triples and
// their short `<arch>-<os>` forms. Unknown spellings are refused.
target_named* = (text: str) Res<Target> {
    text.match({
        "x86_64-linux"        => Ok(Target(
            os: Os.Linux,
            arch: Arch.X86_64,
            abi: Abi.Gnu
        )),
        "x86_64-linux-gnu"    => Ok(Target(
            os: Os.Linux,
            arch: Arch.X86_64,
            abi: Abi.Gnu
        )),
        "aarch64-linux"       => Ok(Target(
            os: Os.Linux,
            arch: Arch.Arm64,
            abi: Abi.Gnu
        )),
        "aarch64-linux-gnu"   => Ok(Target(
            os: Os.Linux,
            arch: Arch.Arm64,
            abi: Abi.Gnu
        )),
        "arm64-linux"         => Ok(Target(
            os: Os.Linux,
            arch: Arch.Arm64,
            abi: Abi.Gnu
        )),
        "arm64-darwin"        => Ok(Target(
            os: Os.Macos,
            arch: Arch.Arm64,
            abi: Abi.Darwin
        )),
        "arm64-apple-darwin"  => Ok(Target(
            os: Os.Macos,
            arch: Arch.Arm64,
            abi: Abi.Darwin
        )),
        "x86_64-darwin"       => Ok(Target(
            os: Os.Macos,
            arch: Arch.X86_64,
            abi: Abi.Darwin
        )),
        "x86_64-apple-darwin" => Ok(Target(
            os: Os.Macos,
            arch: Arch.X86_64,
            abi: Abi.Darwin
        )),
        _                     => None,
    })
}

// A Git source pinned to a full commit ID. Paths are relative to its checkout.
// The project driver fetches it on first use and verifies a clean cache on reuse.
Package* = {
    url*: str,
    rev*: str,
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

Dep* = {
    name*: str,
}

Exe* = {
    src*: Path,
    deps*: Vec<Dep>,

    backend* :: Codegen = Codegen.C,
    // None follows the build mode; a target may also match on `b.mode()`.
    optimize* :: Res<Optimize> = None,
    language* :: str = "c",
    frameworks* :: Res<Vec<str>> = None,
    // Remove the symbol table. The small mode always strips.
    strip* :: bool = false,

    // The C toolchain. `--cc` and the CC variable override `cc`, and CFLAGS
    // words follow `cflags`. A define is NAME or NAME=value; a lib links
    // as `-l<name>`.
    cc* :: Res<Cc> = None,
    cflags* :: Res<Vec<str>> = None,
    defines* :: Res<Vec<str>> = None,
    libs* :: Res<Vec<str>> = None,

    // JavaScript for a page: `out` is a directory that receives index.html,
    // runtime.js and app.js (the `js-browser` layout).
    web* :: bool = false,

    // None selects build/{os}-{arch}/{name}, with .js for JavaScript (a
    // directory of that name for `web`).
    out* :: Res<Path> = None,
}

Lib* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

Extern* = {
    src*: Path,
    libs*: Vec<str>,
    paths*: Vec<str>,
}

// Defines use NAME or NAME=value.
CImport* = {
    headers*: Vec<str>,
    include_paths*: Vec<str>,
    defines*: Vec<str>,
    libraries*: Vec<str>,
    target*: Target,
}

Test* = {
    tests*: Vec<Function>,
    deps*: Vec<Dep>,
}

Bench* = {
    benches*: Vec<Function>,
    budgets*: Vec<Budget>,
}

// Allocation budgets are exact; timing uses a rolling median.
Budget* = {
    name*: str,
    ns_op*: u64,
    allocs_op*: u64,
    bytes_op*: u64,
}

// The build profile chosen on the command line: `debug` (the default),
// `release` (`--release`) or `small`. A build file reads it with `b.mode()`.
// Debug compiles unoptimized, Release optimizes for speed, and Small
// optimizes for size, drops unreferenced code at link time and strips.
Mode* = { Debug | Release | Small }

// A target's own optimization, overriding its mode's.
Optimize* = { Debug | Speed | Size }

// The C compiler for a native target. Custom names an executable.
Cc* = { Clang | Gcc | Tcc | Custom: Path }

Mode.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({ Debug => "debug", Release => "release", Small => "small" })
    }
})

// Spell a mode as `--mode` accepts it.
mode_named* = (text: str) Res<Mode> {
    text.match({
        "debug"   => Ok(Mode.Debug),
        "release" => Ok(Mode.Release),
        "small"   => Ok(Mode.Small),
        _         => None,
    })
}

// Generator choice is independent of artifact delivery and OS/arch/ABI.
// Only implemented generators are admitted; unknown names never fall back.
Codegen* = { C | Js | Asm }

Codegen* = (name: str) Res<Codegen> {
    name.match({
        "c" => Ok(Codegen.C), "js" => Ok(Codegen.Js), "asm" => Ok(Codegen.Asm), _ => None
    })
}

Codegen.impl(StableName, {
    stable_name = (self: @Self) str { self.match({ C => "c", Js => "js", Asm => "asm" }) }
})

// Check emits nothing. Other modes describe where generated artifacts go.
Emission* = { Check | Stdout | File: str | Directory: str }

Permutation* = {
    Natural | Reverse | Rotate | Interleave,

    // The position the `i`th of `n` items takes in this order.
    index* = (self: @Self, n: usize, i: usize) usize {
        self.match({
            Natural    => i,
            Reverse    => n - 1 - i,
            Rotate     => (i + 1) % n,
            Interleave => interleaved(n, i),
        })
    }
}

Permutation.impl(StableName, {
    stable_name = (self: @Self) str {
        self.match({
            Natural    => "",
            Reverse    => "reverse",
            Rotate     => "rotate",
            Interleave => "interleave",
        })
    }
})

interleaved = (n: usize, i: usize) usize {
    half = n / 2;
    (i < half).match({
        true  => i * 2 + 1,
        false => (i - half) * 2,
    })
}

permutation* = (text: str) Permutation {
    text.match({
        "reverse"    => Permutation.Reverse,
        "rotate"     => Permutation.Rotate,
        "interleave" => Permutation.Interleave,
        _            => Permutation.Natural,
    })
}

BuildArgs* = {
    root*: str,
    emission* :: Emission = Emission.Check,
    backend* :: Codegen = Codegen.C,
    entry* :: str = "",
    std_root* :: str = "",
    symbol_map* :: str = "",
    ffi* :: bool = false,
    repeat* :: usize = 1,
    permute* :: Permutation = Permutation.Natural,
    // A target spelling for native generators; empty selects the host.
    target* :: str = "",

    emits* = (self: @Self) bool {
        self.emission.match({ Check => false, _ => true })
    }

    writes_file* = (self: @Self) bool {
        self.emission.match({ File(_) => true, _ => false })
    }
}

// A project command starts at build.zen. `argv` remains borrowed from Env;
// run arguments begin at `args_at` and are ignored by `zen build`.
ProjectArgs* = {
    root* :: str = ".",
    target* :: str = "",
    std_root* :: str = "",
    argv*: Vec<str>,
    args_at* :: usize = 0,
    mode* :: Mode = Mode.Debug,
    // Print each phase, command and timing.
    verbose* :: bool = false,
    // `--cc`: clang, gcc, tcc or an executable path.
    cc* :: Res<str> = None,
    // `--target`: the platform to build for, when not the host.
    triple* :: Res<str> = None,
}

ZEN_STD_ENV*: str = "ZEN_STD"

// The compiler driver supplies these methods.
Builder* = {
    os*: Os,
    arch*: Arch,
    env*: Env,
    alloc*: Alloc,
    args*: BuildArgs = BuildArgs(root: ""),

    module* = (self: @Self, path: Path) Module

    target* = (self: @Self) Target
    mode* = (self: @Self) Mode

    add* ::= (self :: @Self, name: str, pkg: Package) Res<Dep, BuildError>
    remove* ::= (self :: @Self, name: str) Res<BuildError>

    exe* = (self :: @Self, name: str, target: Exe) Res<Builder, BuildError>
    lib* = (self :: @Self, name: str, target: Lib) Res<Dep, BuildError>
    extern* = (self :: @Self, name: str, target: Extern) Res<Dep, BuildError>
    c_import* = (self :: @Self, name: str, import: CImport)
        Res<Dep, BuildError>
    // Function-discovery tests and executable tests are distinct contracts.
    test* = (self :: @Self, name: str, target: Test) Res<BuildError>
    exe_test* = (self :: @Self, name: str, target: Exe) Res<Builder, BuildError>
    bench* = (self :: @Self, name: str, target: Bench) Res<BuildError>

    budget* = (self :: @Self, d: Duration) ()
}
