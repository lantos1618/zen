// Errors are values: a type a `Res` fails with implements Error. Writing
// `Res<R>` with such an R reads as `Ok | Err(R)`; see std.core.result.

{ Sink, WriteError } = std.core.io
{ Res } = std.core

Error* = {
    // What went wrong, for a reader. The default writes the name of the
    // variant the value holds (a struct's is its type's name); an impl
    // rebinds it when the payload has more to say.
    message* ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.write(self.variant_name())
    }
}
