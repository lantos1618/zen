// Primitive numeric bounds, widths, conversions, and equality impls.
// Arithmetic traps on overflow; `+%`, `-%`, and `*%` wrap.

Eq = std.core.eq
Res, Ok, None = std.core.result

i8* = {
    MIN*: i8 = -128,
    MAX*: i8 = 127,
    BITS*: usize = 8,
}

i16* = {
    MIN*: i16 = -32768,
    MAX*: i16 = 32767,
    BITS*: usize = 16,
}

i32* = {
    MIN*: i32 = -2147483648,
    MAX*: i32 = 2147483647,
    BITS*: usize = 32,
}

i64* = {
    MIN*: i64 = -9223372036854775808,
    MAX*: i64 = 9223372036854775807,
    BITS*: usize = 64,
}

u8* = {
    MIN*: u8 = 0,
    MAX*: u8 = 255,
    BITS*: usize = 8,
}

u16* = {
    MIN*: u16 = 0,
    MAX*: u16 = 65535,
    BITS*: usize = 16,
}

u32* = {
    MIN*: u32 = 0,
    MAX*: u32 = 4294967295,
    BITS*: usize = 32,
}

u64* = {
    MIN*: u64 = 0,
    MAX*: u64 = 18446744073709551615,
    BITS*: usize = 64,
}

// u128 holds wide products and carries. Literals are limited to the u64
// range, so MAX is not spelled here; ~0 is `u128.MIN -% 1`.
u128* = {
    MIN*: u128 = 0,
    BITS*: usize = 128,
}

// usize follows the target pointer width. Current supported architectures are
// 64-bit; a 32-bit target must change this declaration and backend metadata
// together.
usize* = {
    MIN*: usize = 0,
    MAX*: usize = 18446744073709551615,
    BITS*: usize = 64,
}

// Float MIN is the most negative finite value, not the smallest positive
// normal value.

f32* = {
    MIN*: f32 = -340282346638528859811704183484516925440.0,
    MAX*: f32 = 340282346638528859811704183484516925440.0,
    BITS*: usize = 32,
}

f64* = {
    MIN*: f64 = -.0,
    MAX*: f64 = .0,
    BITS*: usize = 64,
}

// Compiler-provided conversions: sema_numeric validates these declarations
// and records their operations; gen_c_num supplies the C implementation.
// Bodyless numeric declarations in other modules are rejected.
//
// Lossless widening conversions.
to_u16* = (self: u8) u16
to_u32* = (self: u8) u32
to_u64* = (self: u8) u64
to_u32* = (self: u16) u32
to_u64* = (self: u16) u64
to_u64* = (self: u32) u64
to_usize* = (self: u32) usize
to_u128* = (self: u8) u128
to_u128* = (self: u16) u128
to_u128* = (self: u32) u128
to_u128* = (self: u64) u128
to_u128* = (self: usize) u128

// usize is currently 64-bit. u64-to-usize is omitted because it would narrow
// on a future 32-bit target.
to_u64* = (self: usize) u64
to_usize* = (self: u8) usize
to_usize* = (self: u16) usize

to_i16* = (self: i8) i16
to_i32* = (self: i8) i32
to_i64* = (self: i8) i64
to_i32* = (self: i16) i32
to_i64* = (self: i16) i64
to_i64* = (self: i32) i64

to_i32* = (self: u8) i32
to_i64* = (self: u8) i64
to_i64* = (self: u16) i64
to_i64* = (self: u32) i64

// Lossless into floating point: every source value is exactly representable
// (f32 carries 24 significand bits, f64 carries 53).
to_f64* = (self: i8) f64
to_f64* = (self: i16) f64
to_f64* = (self: i32) f64
to_f64* = (self: u8) f64
to_f64* = (self: u16) f64
to_f64* = (self: u32) f64
to_f64* = (self: f32) f64
to_f32* = (self: i8) f32
to_f32* = (self: i16) f32
to_f32* = (self: u8) f32
to_f32* = (self: u16) f32

// Checked conversions evaluate the receiver once and return None when its
// value does not fit. They never truncate, wrap, saturate, or allocate.
to_u8* = (self: usize) Res<u8>
to_u8* = (self: u32) Res<u8>
to_u16* = (self: u64) Res<u16>
to_usize* = (self: u64) Res<usize>
to_usize* = (self: i64) Res<usize>
to_i32* = (self: u64) Res<i32>
to_i32* = (self: i64) Res<i32>
to_u64* = (self: u128) Res<u64>

// C int follows the native ABI; both directions check the destination range.
to_c_int* = (self: i32) Res<c_int>
to_i32* = (self: c_int) Res<i32>

// Exact conversions between integers and f64 are checked the same way: the
// result is None unless the value is represented exactly. A fractional,
// infinite, NaN, or out-of-range f64 has no integer; an integer beyond 2^53
// that falls between two doubles has no f64. Round explicitly first
// (std.math.round) to convert a fractional value.
to_i32* = (self: f64) Res<i32>
to_i64* = (self: f64) Res<i64>
to_f64* = (self: i64) Res<f64>
to_f64* = (self: u64) Res<f64>

// Rounding narrowing: always produces a value, rounded to the nearest
// representable one (IEEE 754 round-to-nearest, ties to even; Zen never
// changes the floating-point environment). f64 beyond the f32 range becomes
// +/-infinity, never undefined behaviour; NaN stays NaN and infinities stay
// infinite. `narrow_` is spelled apart from `to_` so a lossy conversion is
// never mistaken for a lossless one at the call site.
narrow_f32* = (self: f64) f32
narrow_f64* = (self: i64) f64
narrow_f64* = (self: u64) f64

min* = (self: usize, other: usize) usize {
    (self < other).match({ true => self, false => other })
}

// 2^self; ordinary usize overflow traps.
pow2* = (self: usize) usize {
    power    ::= 1;
    i: usize ::= 0;
    (i < self).loop((h) {
        power = power * 2;
        i     = i + 1;
    });
    power;
}

ToU16* = { widen_u16* = (self: @Self) u16 }
ToU32* = { widen_u32* = (self: @Self) u32 }
ToU64* = { widen_u64* = (self: @Self) u64 }
ToUsize* = { widen_usize* = (self: @Self) usize }
ToI16* = { widen_i16* = (self: @Self) i16 }
ToI32* = { widen_i32* = (self: @Self) i32 }
ToI64* = { widen_i64* = (self: @Self) i64 }
ToF64* = { widen_f64* = (self: @Self) f64 }

u8.impl(ToU16, { widen_u16 = to_u16 })
u8.impl(ToU32, { widen_u32 = to_u32 })
u8.impl(ToU64, { widen_u64 = to_u64 })
u8.impl(ToI32, { widen_i32 = to_i32 })
u8.impl(ToI64, { widen_i64 = to_i64 })

u16.impl(ToU32, { widen_u32 = to_u32 })
u16.impl(ToU64, { widen_u64 = to_u64 })
u16.impl(ToI64, { widen_i64 = to_i64 })

u32.impl(ToU64, { widen_u64 = to_u64 })
u32.impl(ToUsize, { widen_usize = to_usize })
u32.impl(ToI64, { widen_i64 = to_i64 })

usize.impl(ToU64, { widen_u64 = to_u64 })

u8.impl(ToUsize, { widen_usize = to_usize })

u16.impl(ToUsize, { widen_usize = to_usize })

i8.impl(ToI16, { widen_i16 = to_i16 })
i8.impl(ToI32, { widen_i32 = to_i32 })
i8.impl(ToI64, { widen_i64 = to_i64 })

i16.impl(ToI32, { widen_i32 = to_i32 })
i16.impl(ToI64, { widen_i64 = to_i64 })

i32.impl(ToI64, { widen_i64 = to_i64 })
i8.impl(ToF64, { widen_f64 = to_f64 })
i16.impl(ToF64, { widen_f64 = to_f64 })
i32.impl(ToF64, { widen_f64 = to_f64 })
u8.impl(ToF64, { widen_f64 = to_f64 })
u16.impl(ToF64, { widen_f64 = to_f64 })
u32.impl(ToF64, { widen_f64 = to_f64 })

f32.impl(ToF64, { widen_f64 = to_f64 })

i8.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i16.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i32.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
i64.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })

u8.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u16.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u32.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u64.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
u128.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })
usize.impl(Eq, { eq ::= (self: @Self, other: @Self) bool { self == other } })

// Compiler-native unsigned bit operations on W = u8, u16, u32, u64, u128 and
// usize. Rotation counts are reduced modulo the width. Logical shifts
// saturate to zero at or above the word width.
bit_xor* = (self: u8, other: u8) u8
bit_xor* = (self: u16, other: u16) u16
bit_xor* = (self: u32, other: u32) u32
bit_xor* = (self: u64, other: u64) u64
bit_xor* = (self: u128, other: u128) u128
bit_xor* = (self: usize, other: usize) usize
bit_and* = (self: u8, other: u8) u8
bit_and* = (self: u16, other: u16) u16
bit_and* = (self: u32, other: u32) u32
bit_and* = (self: u64, other: u64) u64
bit_and* = (self: u128, other: u128) u128
bit_and* = (self: usize, other: usize) usize
bit_or* = (self: u8, other: u8) u8
bit_or* = (self: u16, other: u16) u16
bit_or* = (self: u32, other: u32) u32
bit_or* = (self: u64, other: u64) u64
bit_or* = (self: u128, other: u128) u128
bit_or* = (self: usize, other: usize) usize
shift_left* = (self: u8, count: usize) u8
shift_left* = (self: u16, count: usize) u16
shift_left* = (self: u32, count: usize) u32
shift_left* = (self: u64, count: usize) u64
shift_left* = (self: u128, count: usize) u128
shift_left* = (self: usize, count: usize) usize
shift_right* = (self: u8, count: usize) u8
shift_right* = (self: u16, count: usize) u16
shift_right* = (self: u32, count: usize) u32
shift_right* = (self: u64, count: usize) u64
shift_right* = (self: u128, count: usize) u128
shift_right* = (self: usize, count: usize) usize
rotate_left* = (self: u32, count: usize) u32
rotate_left* = (self: u64, count: usize) u64
rotate_right* = (self: u32, count: usize) u32
rotate_right* = (self: u64, count: usize) u64

// 64x64->128 multiplication; never overflows.
mul_wide* = (self: u64, other: u64) u128

// Add with carry and subtract with borrow: [sum, carry] of self + other +
// carry and [difference, borrow] of self - other - borrow. Only the low bit
// of the incoming carry or borrow is read; the outgoing one is 0 or 1.
// Chained through their carries they lower to ADC/SBB (x86-64) and
// ADCS/SBCS (arm64) where the C compiler keeps the carry in the flags, as
// Clang does for __builtin_addcll chains; u128 sums of three terms often
// leave the carry in a register instead. Never traps and never branches.
add_carry* = (self: u64, other: u64, carry: u64) [u64, 2]
sub_borrow* = (self: u64, other: u64, borrow: u64) [u64, 2]

// Explicit truncation keeps the low bits of a strictly wider unsigned word.
// Unlike the checked `to_` conversions, it never fails: the discarded high
// bits are the documented intent.
truncate_u8* = (self: u16) u8
truncate_u8* = (self: u32) u8
truncate_u8* = (self: u64) u8
truncate_u8* = (self: usize) u8
truncate_u16* = (self: u32) u16
truncate_u16* = (self: u64) u16
truncate_u16* = (self: usize) u16
truncate_u32* = (self: u64) u32
truncate_u32* = (self: usize) u32
truncate_u32* = (self: u128) u32
truncate_u64* = (self: u128) u64

// Arithmetic shifts copy the sign bit into the vacated high bits. A count at
// or above the word width yields 0 for a non-negative value and -1 for a
// negative one, as though the value were shifted one bit at a time.
shift_right* = (self: i8, count: usize) i8
shift_right* = (self: i16, count: usize) i16
shift_right* = (self: i32, count: usize) i32
shift_right* = (self: i64, count: usize) i64
