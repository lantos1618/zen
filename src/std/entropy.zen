// Operating-system cryptographic entropy. No allocation, PRNG state or fallback.
Ptr = std.mem
Native = c.bind("sys/random.h", {
    getentropy = (output: Ptr<u8>, count: usize) i32
})
EntropyError* = Invalid | Unavailable

// Fill a live writable span using the OS CSPRNG on macOS/Linux. Empty spans
// succeed without touching the OS; nonempty spans require a non-null pointer.
// May block until the OS entropy source is initialized. On an OS error, a
// prefix may already have been overwritten: discard the whole result. Never
// substitute std.core.rand or previously generated bytes after a failure.
fill_random* = (output: Ptr<u8>, count: usize) Res<(), EntropyError> {
    (count == 0 || !output.is_null()).ensure(EntropyError.Invalid).try();
    at: usize ::= 0;
    loop(() { at < count }, (h) {
        size = (count - at > 256).match({true => 256, false => count - at});
        (Native.getentropy(output.offset(at), size) == 0).ensure(EntropyError.Unavailable).try();
        at = at + size;
    });
    Ok(())
}
