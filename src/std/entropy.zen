// Operating-system cryptographic entropy. No allocation, PRNG state or fallback.
{ Ptr } = std.mem
{ Res, Ok, Error } = std.core
// arc4random_buf is declared by <stdlib.h> on every Apple SDK (macOS and iOS,
// whose SDK has no <sys/random.h>) and by glibc 2.36+. It draws from the OS
// CSPRNG and has no error result: Apple's never fails, and glibc terminates
// the process rather than return unfilled bytes.
Native = c.bind("stdlib.h", {
    arc4random_buf = (output: Ptr<u8>, count: usize) ()
})
// Invalid: a null pointer with a nonzero count. Unavailable is kept so existing
// matches still compile, but the arc4random_buf source never produces it.
EntropyError* = { Invalid | Unavailable }
EntropyError.impl(Error, {})

// Fill a live writable span using the OS CSPRNG on macOS/iOS/Linux. Empty spans
// succeed without touching the OS; nonempty spans require a non-null pointer.
// May block until the OS entropy source is initialized. An OS entropy failure
// is not reported: the C library aborts the process instead of returning.
// Never substitute std.core.rand or previously generated bytes.
fill_random* = (output: Ptr<u8>, count: usize) Res<EntropyError> {
    (count == 0 || !output.is_null()).ensure(EntropyError.Invalid).try();
    (count > 0).then(() { Native.arc4random_buf(output, count); });
    Ok
}
