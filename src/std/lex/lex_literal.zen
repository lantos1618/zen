// Strings, characters, escapes and numbers. Invalid spellings are rejected
// rather than reinterpreted (`010` is not octal and `"\q"` is not `"q"`).
// Recoverable faults may still emit a token; unterminated or unrepresentable
// literals do not.

Lexer = std.lex.lex_state
Pos, TokenKind = std.lex.lex_token
LexFault = std.lex.lex_diag
is_escape, escape_value = std.lex.lex_byte
Alloc, AllocError = std.mem
str, String = std.text
Range = std.core

LiteralError* = OutOfMemory | IncompleteEscape(usize) | UnknownEscape(usize)

// Byte length of an unquoted, lexer-validated literal body or format fragment.
// Each Zen escape denotes one byte; counting needs no decoded allocation.
literal_byte_len* = (raw: str) usize {
    count :: usize = 0;
    at    :: usize = 0;
    loop(() { at < raw.len }, (h) {
        count = count + 1;
        at    = at + (raw[at] == '\\').match({ true => 2, false => 1 });
    });
    count
}

// Decode an unquoted Zen literal body or format fragment. Plain bytes borrow
// raw; escaped bytes borrow storage allocated through a. JSON uses a different
// vocabulary and must keep its own decoder. Error offsets name the backslash.
decode_literal* = (raw: str, a: Alloc) Res<str, LiteralError> {
    raw.find('\\').match({
        None      => Ok(raw),
        Ok(first) => {
            out ::= a.String().try(LiteralError.OutOfMemory);
            out.add(raw.slice(0, first)).try(LiteralError.OutOfMemory);
            at :: usize = first;
            loop(() { at < raw.len }, (h) {
                byte ::= raw[at];
                (byte == '\\').then(() {
                    slash = at;
                    at    = at + 1;
                    (at < raw.len).ensure(LiteralError.IncompleteEscape(
                        slash
                    )).try();
                    byte = raw[at].escape_value()
                        .ok_or(LiteralError.UnknownEscape(slash)).try();
                });
                out.add(byte).try(LiteralError.OutOfMemory);
                at = at + 1;
            });
            Ok(out.view())
        },
    })
}

// String line/end faults are anchored at the opening quote. `"""` opens a
// multi-line string instead.
string* = (lx :: Lexer) Res<(), AllocError> {
    lx.at_triple_quote().match({
        true  => lx.text_block(),
        false => lx.line_string(),
    })
}

at_triple_quote = (lx: Lexer) bool {
    lx.cur.at_byte('"') && lx.cur.at_byte(1, '"') && lx.cur.at_byte(2, '"')
}

line_string = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    loop((h) {
        lx.cur.peek().match({
            None     => { lx.report(
                LexFault.UnterminatedString,
                from
            ).try(); h.break(); },
            Ok('\n') => { lx.report(
                LexFault.StringSpansLine,
                from
            ).try(); h.break(); },
            Ok('\\') => {
                reported = lx.escape().try();
                (lx.cur.is_done() && reported).then(() { h.break(); });
            },
            Ok('"')  => { lx.cur.bump(); lx.emit(
                TokenKind.Str,
                from
            ).try(); h.break(); },
            Ok(_)    => { lx.cur.bump(); },
        });
    });
    Ok(());
}

// The closing `"""` of a multi-line string and the whitespace before it on
// its line, which every line of text begins with.
BlockEnd = { at: Pos, indent: str }

// How the search for a closing `"""` ended. `Reported` means a fault inside
// the literal was already diagnosed.
Closing = Closed(BlockEnd) | Reported | Unclosed

// A multi-line string: `"""`, a line break, the lines of text, and a closing
// `"""` as the first text on its own line (DESIGN.md, "Multi-line strings").
// The whole literal is one Str token; `text_block_literal` reads its value.
// A literal with any fault yields no token.
text_block = (lx :: Lexer) Res<(), AllocError> {
    from   = lx.cur.pos();
    faults = lx.diags.len;
    lx.cur.bump();
    lx.cur.bump();
    lx.cur.bump();
    lx.block_opening().try().match({
        true  => Ok(()),
        false => lx.block_close().try().match({
            Unclosed    => lx.report(LexFault.UnterminatedTextBlock, from),
            Reported    => Ok(()),
            Closed(end) => {
                (lx.diags.len == faults).then(() {
                    lx.block_indents(from, end).try();
                });
                (lx.diags.len == faults).match({
                    true  => lx.emit(TokenKind.Str, from),
                    false => Ok(()),
                })
            },
        }),
    })
}

// Only a line break may follow the opening `"""`; other text there is a fault
// at its first byte. Returns true when the literal already ended: when the
// same line also holds a closing `"""` (`"""text"""`), the literal ends
// there rather than reading the rest of the file as its text.
block_opening = (lx :: Lexer) Res<bool, AllocError> {
    at = lx.cur.pos();
    loop(() { lx.on_opening_line() }, (h) { lx.cur.bump(); });
    rest  = lx.since(at);
    blank = rest.len == 0 || rest.eq("\r");
    lx.at_triple_quote().match({
        true  => {
            lx.cur.bump();
            lx.cur.bump();
            lx.cur.bump();
            lx.report(LexFault.TextBlockOpening, at).try();
            Ok(true)
        },
        false => {
            (!blank && !lx.cur.is_done()).then(() {
                lx.report(LexFault.TextBlockOpening, at).try();
            });
            Ok(false)
        },
    })
}

on_opening_line = (lx: Lexer) bool {
    lx.cur.peek().match({
        Ok('\n') => false,
        Ok(_)    => !lx.at_triple_quote(),
        None     => false,
    })
}

// Scan the lines of text for the closing `"""`. Escapes are checked as in a
// one-line string.
block_close = (lx :: Lexer) Res<Closing, AllocError> {
    line ::= lx.cur.pos();
    ended: Res<Closing> = loop<Closing>((h) {
        lx.cur.peek().match({
            None     => h.break(Closing.Unclosed),
            Ok('\n') => {
                lx.cur.bump();
                line = lx.cur.pos();
            },
            Ok('\\') => {
                lx.block_escape().try().then(() { h.break(Closing.Reported); });
            },
            Ok('"')  => lx.at_triple_quote().match({
                true  => h.break(lx.block_end(line).try()),
                false => lx.cur.bump(),
            }),
            Ok(_)    => lx.cur.bump(),
        });
    });
    Ok(ended.value_or(Closing.Unclosed))
}

// Returns true when the literal must stop here: a fault at end of input that
// an unterminated-literal report would only repeat.
block_escape = (lx :: Lexer) Res<bool, AllocError> {
    breaks = lx.cur.at_byte(1, '\n')
        || (lx.cur.at_byte(1, '\r') && lx.cur.at_byte(2, '\n'));
    breaks.match({
        // Zen has no line continuation, in either kind of string.
        true  => {
            from = lx.cur.pos();
            lx.cur.bump();
            lx.report(LexFault.UnknownEscape, from).try();
            Ok(false)
        },
        false => {
            reported = lx.escape().try();
            Ok(lx.cur.is_done() && reported)
        },
    })
}

// A closing `"""` is the first text on its line; the whitespace before it is
// the indentation stripped from every line of text.
block_end = (lx :: Lexer, line: Pos) Res<Closing, AllocError> {
    lead = lx.since(line);
    at   = lx.cur.pos();
    lx.cur.bump();
    lx.cur.bump();
    lx.cur.bump();
    is_indent(lead).match({
        true  => Ok(Closing.Closed(BlockEnd(at: at, indent: lead))),
        false => {
            lx.report(LexFault.TextBlockClosing, at).try();
            Ok(Closing.Reported)
        },
    })
}

// Every line of text begins with the closing indentation, except a line of
// only whitespace, which is an empty line of text. The first line that does
// not is the fault, at its first byte of text.
block_indents = (lx :: Lexer, from: Pos, end: BlockEnd) Res<(), AllocError> {
    whole = lx.since(from);
    stop  = end.at.offset - end.indent.len - from.offset;
    at   ::= whole.newline_in(0, stop) + 1;
    line ::= from.line + 1;
    bad: Res<Pos> = loop<Pos>(() { at < stop }, (h) {
        upto = whole.newline_in(at, stop);
        text = whole.slice(at, upto);
        (text.starts_with(end.indent) || is_indent(without_cr(text))).match({
            true  => (),
            false => {
                lead = text.len - text.trim_start().value_or("").len;
                h.break(Pos(
                    offset: from.offset + at + lead,
                    line: line,
                    col: 1 + lead
                ));
            },
        });
        at   = upto + 1;
        line = line + 1;
    });
    bad.match({
        Ok(pos) => lx.report(LexFault.TextBlockIndent, pos),
        None    => Ok(()),
    })
}

is_indent = (s: str) bool {
    Range(0, s.len).find((i) { s[i] != ' ' && s[i] != '\t' }).match({
        Ok(_) => false,
        None  => true,
    })
}

// A CRLF line's text, without the CR: a literal's value does not depend on
// the line endings its file was saved with.
without_cr = (s: str) str {
    s.ends_with("\r").match({
        true  => s.slice(0, s.len - 1),
        false => s,
    })
}

// The value of a lexer-validated multi-line string, spelled as the equivalent
// one-line literal: quoted, each line's closing indentation removed, the lines
// joined by `\n` escapes, and each bare `"` escaped. Escapes in the text stay
// as written, so every consumer of a one-line literal reads this one alike.
text_block_literal* = (raw: str, a: Alloc) Res<str, AllocError> {
    close  = raw.len - 3;
    first  = raw.newline_in(3, close);
    last   = raw.slice(0, close).rfind('\n').value_or(first);
    indent = raw.slice(last + 1, close);
    out ::= a.String().try();
    out.add('"').try();
    (last > first).then(() {
        at ::= first + 1;
        loop((h) {
            upto = raw.newline_in(at, last);
            out.add_block_line(without_cr(raw.slice(at, upto)), indent).try();
            (upto >= last).then(() { h.break(); });
            out.add("\\n").try();
            at = upto + 1;
        });
    });
    out.add('"').try();
    Ok(out.view())
}

// Where a byte of a multi-line string's one-line spelling (as written by
// `text_block_literal`) stands in the source: the line within the literal,
// counted from the opening line, and the zero-based byte column on it. An
// offset past the text answers the closing `"""`. A diagnostic about a byte
// of the value, such as a format hole, points at that byte this way.
SourceAt* = { line*: usize, col*: usize }

text_block_at* = (raw: str, offset: usize) SourceAt {
    close  = raw.len - 3;
    first  = raw.newline_in(3, close);
    last   = raw.slice(0, close).rfind('\n').value_or(first);
    indent = raw.slice(last + 1, close);
    seen ::= 1;
    line :: usize = 1;
    at   ::= first + 1;
    found: Res<SourceAt> = loop<SourceAt>(() { offset > 0 && last > first }, (
        h
    ) {
        upto = raw.newline_in(at, last);
        text = without_cr(raw.slice(at, upto));
        col ::= text.starts_with(
            indent
        ).match({ true => indent.len, false => text.len });
        loop(() { col < text.len }, (h2) {
            b      = text[col];
            cooked = (b == '\\' || b == '"').match({ true => 2, false => 1 });
            (offset < seen + cooked).then(
                () { h.break(SourceAt(line: line, col: col)); }
            );
            seen = seen + cooked;
            col  = col + (b == '\\').match({ true => 2, false => 1 });
        });
        (upto >= last).then(() { h.break(); });
        (offset < seen + 2).then(
            () { h.break(SourceAt(line: line, col: text.len)); }
        );
        seen = seen + 2;
        at   = upto + 1;
        line = line + 1;
    });
    (offset == 0).match({
        true  => SourceAt(line: 0, col: 0),
        false => found.value_or(SourceAt(
            line: raw.slice(0, close).count("\n"),
            col: indent.len
        )),
    })
}

add_block_line = (out :: String, line: str, indent: str) Res<(), AllocError> {
    text = line.starts_with(indent).match({
        true  => line.slice(indent.len, line.len),
        false => "",
    });
    at :: usize = 0;
    loop(() { at < text.len }, (h) {
        b = text[at];
        b.match({
            '\\' => {
                out.add(text.slice(at, at + 2)).try();
                at = at + 2;
            },
            '"'  => {
                out.add("\\\"").try();
                at = at + 1;
            },
            _    => {
                out.add(b).try();
                at = at + 1;
            },
        });
    });
    Ok(())
}

// Character literals contain exactly one byte, not one Unicode code point.
character* = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.peek().match({
        None     => lx.report(LexFault.UnterminatedChar, from),
        Ok('\n') => lx.report(LexFault.CharSpansLine, from),
        Ok('\'') => { lx.cur.bump(); lx.report(LexFault.EmptyChar, from) },
        Ok('\\') => {
            reported = lx.escape().try();
            (lx.cur.is_done() && reported).match({
                true  => Ok(()),
                false => lx.close_char(from),
            })
        },
        Ok(_)    => { lx.cur.bump(); lx.close_char(from) },
    });
}

close_char = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.at_byte('\'').match({
        true  => { lx.cur.bump(); lx.emit(TokenKind.Char, from) },
        false => lx.overlong_char(from),
    });
}

// Resynchronize at the closing quote or the end of the line.
overlong_char = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.bump_while((b) { (b != '\'') && (b != '\n') });
    lx.cur.peek().match({
        Ok('\'') => { lx.cur.bump(); lx.report(LexFault.CharTooLong, from) },
        Ok(_)    => lx.report(LexFault.CharSpansLine, from),
        None     => lx.report(LexFault.UnterminatedChar, from),
    });
}

// Consume one escape. Returns true when a fault was reported; at end of input
// the caller must then not report its own. Newlines are left for the
// enclosing literal to diagnose.
escape = (lx :: Lexer) Res<bool, AllocError> {
    from = lx.cur.pos();
    lx.cur.bump();
    lx.cur.peek().match({
        None     => { lx.report(LexFault.UnterminatedEscape, from).try(); Ok(true) },
        // Newlines are not escapable and Zen has no line continuation. Keep
        // LF, or the CR of CRLF, for the caller to report as a literal that
        // spans a line. A lone CR remains an ordinary unknown escape.
        Ok('\n') => Ok(false),
        Ok('\r') => lx.cur.at_byte(1, '\n').match({
            true  => Ok(false),
            false => { lx.cur.bump(); lx.report(LexFault.UnknownEscape, from).try(); Ok(true) },
        }),
        Ok(b)    => {
            lx.cur.bump();
            is_escape(b).match({
                false => { lx.report(LexFault.UnknownEscape, from).try(); Ok(true) },
                true  => Ok(false),
            })
        },
    });
}

// Integers are decimal or `0x` hexadecimal. Floats are decimal. Neither form
// accepts separators or type suffixes.
number* = (lx :: Lexer) Res<(), AllocError> {
    from = lx.cur.pos();
    lx.is_hex_prefix().match({
        true  => lx.hex_number(from),
        false => lx.decimal_number(from),
    })
}

is_hex_prefix = (lx: Lexer) bool {
    lx.cur.at_byte('0')
        && (lx.cur.at_byte(1, 'x') || lx.cur.at_byte(1, 'X'))
}

hex_number = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.bump();
    lx.cur.bump();
    digits_at = lx.cur.pos();
    lx.cur.bump_while((b) { b.is_hex_digit() });
    digits = lx.since(digits_at);
    (digits.len > 0).match({
        false => {
            lx.cur.bump_while((b) { b.is_ident_cont() });
            lx.report(LexFault.HexNeedsDigit, from)
        },
        true  => {
            lx.suffix().try();
            lx.emit_int(digits.parse_u64_radix(16), from)
        },
    })
}

decimal_number = (lx :: Lexer, from: Pos) Res<(), AllocError> {
    lx.cur.bump_while((b) { b.is_digit() });
    whole = lx.since(from);

    has_leading_zero(whole).match({
        true  => lx.report(LexFault.LeadingZero, from),
        false => Ok(()),
    }).try();

    is_float = lx.fraction().try();

    lx.suffix().try();

    is_float.match({
        true  => lx.emit(TokenKind.Float, from),
        false => lx.emit_int(whole.parse_u64(), from),
    });
}

// `1.` and `1.x` are faults; a number is never an Int followed by Dot.
fraction = (lx :: Lexer) Res<bool, AllocError> {
    lx.cur.at_byte('.').match({
        true  => lx.after_dot(),
        false => Ok(false),
    });
}

after_dot = (lx :: Lexer) Res<bool, AllocError> {
    dot           = lx.cur.pos();
    digit_follows = lx.cur.peek(
        1
    ).match({ Ok(b) => b.is_digit(), None => false });
    lx.cur.bump();
    digit_follows.match({
        false => lx.report(LexFault.FloatNeedsDigit, dot),
        true  => Ok(()),
    }).try();
    lx.cur.bump_while((b) { b.is_digit() });
    Ok(digit_follows);
}

// Identifier bytes glued to a number (`1abc`, `0xffg`) are a fault.
suffix = (lx :: Lexer) Res<(), AllocError> {
    at = lx.cur.pos();
    lx.cur.bump_while((b) { b.is_ident_cont() });
    (lx.cur.pos().offset > at.offset).match({
        true  => lx.report(LexFault.SuffixOnNumber, at),
        false => Ok(()),
    });
}

// Values beyond u64 produce a fault and no token.
emit_int = (lx :: Lexer, value: Res<u64>, from: Pos) Res<(), AllocError> {
    value.match({
        Ok(v) => lx.emit(TokenKind.Int(v), from),
        None  => lx.report(LexFault.IntegerOutOfRange, from),
    });
}

has_leading_zero = (whole: str) bool { (whole.len > 1) && (whole[0] == '0') }
