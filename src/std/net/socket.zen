// Owns one POSIX socket and closes it on drop.

Alloc, AllocError, Ptr, null_ptr = std.mem
str, String, str_at = std.text
Res = std.core
Drop = std.core
Vec = std.collections

// Header-owned layout: the native compiler supplies offsets, size and alignment.
AddrInfo = c.record("netdb.h", "struct addrinfo", {
    ai_flags: i32,
    ai_family: i32,
    ai_socktype: i32,
    ai_protocol: i32,
    ai_addrlen: u32,
    ai_addr: Ptr<()>,
    ai_canonname: Ptr<c_char>,
    ai_next: Ptr<AddrInfo>,
})
Native = c.bind("sys/socket.h", {
    AF_UNSPEC: i32
    AF_INET6: i32
    SOCK_STREAM: i32
    SOCK_CLOEXEC: i32 = 0
    MSG_NOSIGNAL: i32 = 0
    SO_NOSIGPIPE: i32 = 0
    SOL_SOCKET: i32
    socket = (domain: i32, kind: i32, protocol: i32) i32
    connect = (fd: i32, address: Ptr<()>, address_len: u32) i32
    send = (fd: i32, bytes: Ptr<u8>, len: usize, flags: i32) i64
    recv = (fd: i32, bytes: Ptr<u8>, len: usize, flags: i32) i64
    setsockopt = (fd: i32, level: i32, option: i32, value: Ptr<()>, len: u32) i32
})
Descriptors = c.bind("fcntl.h", {
    F_GETFD: i32
    F_SETFD: i32
    FD_CLOEXEC: i32
    fcntl = (fd: i32, command: i32, value: i32) i32
})
Io = c.bind("unistd.h", { close = (fd: i32) i32 })
Resolver = c.bind("netdb.h", {
    NI_MAXHOST: u32
    NI_NUMERICHOST: i32
    getaddrinfo = (host: Ptr<c_char>, service: Ptr<c_char>, hints: Ptr<AddrInfo>, answer: Ptr<Ptr<AddrInfo>>) i32
    freeaddrinfo = (answer: Ptr<AddrInfo>) ()
    getnameinfo = (address: Ptr<()>, address_len: u32, host: Ptr<c_char>, host_len: u32, service: Ptr<c_char>, service_len: u32, flags: i32) i32
})

// POSIX options here are individual positive bits; retain all caller flags.
with_flag = (flags: i32, bit: i32) i32 {
    (bit > 0 && (flags / bit) % 2 == 0).match({true => flags + bit, false => flags})
}

SocketFault* = ConnectFault | WriteFault | ReadFault | PeerClosed

ResolvedAddr* = {
    ip*: String,
    is_v6*: bool,
}

// A borrowed descriptor; Socket alone closes it. Raw IO takes this receiver
// rather than attaching to every i32.
SocketFd* = {
    raw: i32,

    raw_handle* = (self: @Self) i32 { self.raw }

    // One OS send; send(bytes) repeats it until every byte is sent.
    send* = (
        self  : @Self,
        bytes : Ptr<u8>,
        len   : usize,
        flags : i32
    ) Res<usize, SocketFault> {
        (flags >= 0).ensure(SocketFault.WriteFault).try();
        n = Native.send(
            self.raw,
            bytes,
            len,
            with_flag(flags, Native.MSG_NOSIGNAL)
        );
        n.to_usize().ok_or(SocketFault.WriteFault)
    }

    send* = (self: @Self, bytes: str) Res<(), SocketFault> {
        sent: usize ::= 0;
        loop(sent < bytes.len, (h) {
            n = self.send(bytes.ptr().offset(sent), bytes.len - sent, 0).try();
            (n == 0).match({
                true  => Err(SocketFault.PeerClosed).try(),
                false => { sent = sent + n; },
            });
        });
        Ok(())
    }

    recv* = (
        self  : @Self,
        bytes : Ptr<u8>,
        len   : usize,
        flags : i32
    ) Res<usize, SocketFault> {
        n = Native.recv(self.raw, bytes, len, flags);
        n.to_usize().ok_or(SocketFault.ReadFault)
    }

    recv* = (self: @Self, bytes: Ptr<u8>, len: usize)
            Res<usize, SocketFault> {
        self.recv(bytes, len, 0)
    }
}

hints = (a: Alloc, fault: SocketFault) Res<Vec<AddrInfo>, SocketFault> {
    out ::= a.Vec<AddrInfo>();
    out.add(AddrInfo(
        ai_flags: 0,
        ai_family: Native.AF_UNSPEC,
        ai_socktype: Native.SOCK_STREAM,
        ai_protocol: 0,
        ai_addrlen: 0,
        ai_addr: null_ptr<()>(),
        ai_canonname: null_ptr<c_char>(),
        ai_next: null_ptr<AddrInfo>()
    )).try(fault);
    Ok(out)
}

addresses = (
    a            : Alloc,
    host         : Ptr<u8>,
    service      : Ptr<u8>,
    alloc_fault  : SocketFault,
    lookup_fault : SocketFault
)
            Res<Vec<Ptr<AddrInfo>>, SocketFault> {
    spec   ::= hints(a, alloc_fault).try();
    answer ::= a.Vec<Ptr<AddrInfo>>();
    answer.add(null_ptr<AddrInfo>()).try(alloc_fault);
    (Resolver.getaddrinfo(
        host.to<c_char>(),
        service.to<c_char>(),
        spec.ptr(),
        answer.ptr()
    ) == 0).match({
        false => Err(lookup_fault),
        true  => answer.ptr().read(0).is_null().match({
            true  => Err(lookup_fault),
            false => Ok(answer),
        }),
    })
}

resolve_addr* = (a: Alloc, host: str) Res<ResolvedAddr, SocketFault> {
    host_c ::= host.c_text(a).try(SocketFault.ReadFault);
    run    ::= addresses(
        a,
        host_c.ptr(),
        null_ptr<u8>(),
        SocketFault.ReadFault,
        SocketFault.ConnectFault
    ).try();
    head = run.ptr().read(0);
    @scope.defer(() { Resolver.freeaddrinfo(head) });

    info = head.read(0);
    bytes ::= a.Vec<u8>();
    bytes.reserve(Resolver.NI_MAXHOST.to_usize()).try(SocketFault.ReadFault);
    rc = Resolver.getnameinfo(
        info.ai_addr,
        info.ai_addrlen,
        bytes.ptr().to<c_char>(),
        Resolver.NI_MAXHOST,
        null_ptr<c_char>(),
        0,
        Resolver.NI_NUMERICHOST
    );
    (rc == 0).match({
        false => Err(SocketFault.ReadFault),
        true  => {
            n: usize ::= 0;
            loop(() { n < Resolver.NI_MAXHOST.to_usize() && bytes.ptr().read(
                n
            ) != 0 }, (h) {
                n = n + 1;
            });
            ip ::= a.String().try(SocketFault.ReadFault);
            ip.add(str_at(bytes.ptr(), n)).try(SocketFault.ReadFault);
            Ok(ResolvedAddr(ip: ip, is_v6: info.ai_family == Native.AF_INET6))
        },
    })
}

Socket* = {
    raw: i32,
    open :: bool = true,

    tcp_connect* = (a: Alloc, host: str, port: u16)
                   Res<Socket, SocketFault> {
        host_c ::= host.c_text(a).try(SocketFault.ConnectFault);
        port_text = a.String("{}", port).try(SocketFault.ConnectFault);
        port_c ::= port_text.view().c_text(a).try(SocketFault.ConnectFault);
        run    ::= addresses(
            a,
            host_c.ptr(),
            port_c.ptr(),
            SocketFault.ConnectFault,
            SocketFault.ConnectFault
        ).try();
        head = run.ptr().read(0);
        @scope.defer(() { Resolver.freeaddrinfo(head) });

        option ::= a.Vec<i32>();
        (Native.SO_NOSIGPIPE > 0).then(
            () { option.add(1).try(SocketFault.ConnectFault); }
        );
        // Linux admits CLOEXEC atomically. Platforms without that socket flag
        // set it before publishing the descriptor; concurrent fork needs care.
        raw: i32 ::= -1;
        at       ::= head;
        loop(() { !at.is_null() && raw < 0 }, (h) {
            info      = at.read(0);
            candidate = Native.socket(
                info.ai_family,
                with_flag(info.ai_socktype, Native.SOCK_CLOEXEC),
                info.ai_protocol
            );
            (candidate >= 0).then(() {
                prior     = Descriptors.fcntl(
                    candidate,
                    Descriptors.F_GETFD,
                    0
                );
                protected = prior >= 0 && Descriptors.fcntl(
                    candidate,
                    Descriptors.F_SETFD,
                    with_flag(prior, Descriptors.FD_CLOEXEC)
                ) == 0;
                quiet     = Native.SO_NOSIGPIPE == 0 || Native.setsockopt(
                    candidate,
                    Native.SOL_SOCKET,
                    Native.SO_NOSIGPIPE,
                    option.ptr().to<()>(),
                    4
                ) == 0;
                (protected && quiet && Native.connect(
                    candidate,
                    info.ai_addr,
                    info.ai_addrlen
                ) == 0).match({
                    true  => { raw = candidate; },
                    false => { Io.close(candidate); },
                });
            });
            at = info.ai_next;
        });
        (raw < 0).match({
            true  => Err(SocketFault.ConnectFault),
            false => Ok(Socket(raw: raw)),
        })
    }

    // Borrow the descriptor without transferring close ownership.
    handle* = (self: @Self) SocketFd { SocketFd(raw: self.raw) }

    write* = (self: @Self, bytes: str) Res<(), SocketFault> {
        self.open.ensure(SocketFault.PeerClosed).try();
        self.handle().send(bytes)
    }

    read* = (self: @Self, buf :: Vec<u8>, n: usize)
            Res<usize, SocketFault> {
        self.open.ensure(SocketFault.PeerClosed).try();
        (n == 0).match({
            true  => Ok(0),
            false => {
                buf.reserve(n).try(SocketFault.ReadFault);
                got = self.handle().recv(buf.ptr(), n).try();
                (got == 0).match({
                    true  => Err(SocketFault.PeerClosed),
                    false => Ok(got),
                })
            },
        })
    }

    close* = (self :: @Self) {
        self.open.then(() {
            self.open = false;
            Io.close(self.raw);
        });
    }
}

Socket.impl(Drop, {
    drop = (self :: @Self) { self.close() }
})
