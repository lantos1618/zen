// TCP policy over the portable owned socket handle.

{ Alloc } = std.mem
{ str } = std.text
{ Res, Ok, Err, Error } = std.core
{ Drop } = std.core
{ Vec } = std.collections
{ Socket, SocketFault } = std.net.socket

TcpError* = { ConnectFailed | WriteFailed | ReadFailed | Closed }
TcpError.impl(Error, {})

tcp_error = (fault: SocketFault) TcpError {
    fault.match({
        ConnectFault => TcpError.ConnectFailed,
        WriteFault   => TcpError.WriteFailed,
        ReadFault    => TcpError.ReadFailed,
        PeerClosed   => TcpError.Closed,
        // A stream never listens or accepts; TcpListener reports these.
        ListenFault  => TcpError.ConnectFailed,
        AcceptFault  => TcpError.ConnectFailed,
    })
}

TcpStream* = {
    socket :: Socket,

    connect* = (a: Alloc, host: str, port: u16) Res<TcpStream, TcpError> {
        Socket.tcp_connect(a, host, port).match({
            Ok(socket) => Ok(TcpStream(socket: consume socket)),
            Err(e)     => Err(e.tcp_error()),
        })
    }

    write* = (self: @Self, bytes: str) Res<TcpError> {
        self.socket.write(bytes).map_err((e) { e.tcp_error() })
    }

    read* = (self: @Self, buf :: Vec<u8>, n: usize) Res<usize, TcpError> {
        self.socket.read(buf, n).map_err((e) { e.tcp_error() })
    }

    close* = (self :: @Self) { self.socket.close() }
}

TcpStream.impl(Drop, {
    drop = (self :: @Self) { self.close() }
})

TcpListenError* = { ListenFailed | AcceptFailed }
TcpListenError.impl(Error, {})

TcpListener* = {
    socket :: Socket,

    listen* = (a: Alloc, host: str, port: u16) Res<TcpListener, TcpListenError> {
        Socket.tcp_listen(a, host, port, 64).match({
            Ok(socket) => Ok(TcpListener(socket: consume socket)),
            Err(_)     => Err(TcpListenError.ListenFailed),
        })
    }

    // Waits for the next connection; `a` holds only scratch for the call.
    accept* = (self: @Self, a: Alloc) Res<TcpStream, TcpListenError> {
        self.socket.accept(a).match({
            Ok(socket) => Ok(TcpStream(socket: consume socket)),
            Err(_)     => Err(TcpListenError.AcceptFailed),
        })
    }

    close* = (self :: @Self) { self.socket.close() }
}

TcpListener.impl(Drop, {
    drop = (self :: @Self) { self.close() }
})
