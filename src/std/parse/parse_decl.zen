// Declaration parsing. The shape after `Name =` distinguishes declaration
// kinds:
//
//     { .. }              struct
//     | A   /  A | B      enum
//     (..) T { .. }       function, with a body
//     (..) T              function, signature only
//     a.b.c               import
//     Name / Name<T>      alias
//     anything else       constant
//
// The leading bar distinguishes a one-variant enum from an alias.

AllocError = std.mem
Ident, no_trivia = std.ast.ast_span
Span, Pos = std.source
ExprId, TypeId = std.ast.ast_id
Decl, DeclKind, Struct, Enum, Alias, Impl, Import, Const = std.ast.ast_node
Member, MemberKind, Field, Variant, ImportName, TParam, Module = std.ast.ast_node
TokenKind = std.parse.parse_token
Parser, Mark = std.parse.parser
expr, expr_before_bar = std.parse.parse_expr
type, written_type = std.parse.parse_type
value_shape, delim_step, inline_fn_ahead, bar_operands_ahead = std.parse.parse_lookahead
struct_members, record_body, type_params, fn_value = std.parse.parse_member

// Parse a whole module. Its span and trailing trivia cover the complete file.
module* = (p :: Parser, name: str) Res<Module, AllocError> {
    start = Pos(line: 1, col: 1);
    p.drain().try();
    decls   ::= p.alloc.Vec<Decl>();
    running ::= !p.at_eof();
    running.loop((h) {
        before = p.at;
        p.resume();
        decls.add(p.declaration(true).try()).try();
        (p.at == before).then(() { p.recover().try(); });
        running = !p.at_eof() && !p.too_deep;
    });
    trailing = p.claim_rest();
    Ok(Module(
        name: name,
        decls: decls,
        span: Span(file: p.source.file, start: start, end: p.here_span().end),
        leading: no_trivia(),
        trailing: trailing,
    ));
}

// Recover at the next identifier outside brackets.
recover = (p :: Parser) Res<(), AllocError> {
    p.bump().try();
    depth   :: usize = 0;
    running ::= !p.at_eof();
    running.loop((h) {
        kind  = p.peek().kind;
        depth = kind.delim_step(depth);
        (depth == 0 && kind == TokenKind.Ident).match({
            true  => { running = false; },
            false => p.skip().try(),
        });
        running = running && !p.at_eof();
    });
    Ok(());
}

declaration* = (p :: Parser, module_level: bool) Res<Decl, AllocError> {
    m = p.open();
    p.impl_ahead().match({
        true  => p.impl_decl(m),
        false => p.named_decl(m, module_level),
    });
}

// Parse `Circle.impl(Rect, { .. })` as an impl declaration.
impl_decl = (p :: Parser, m: Mark) Res<Decl, AllocError> {
    target = p.ident("expected the type an impl is for").try();
    p.bump().try();
    p.bump().try();
    open = p.here_span();
    p.bump().try();
    bound = p.type().try();
    p.expect(
        TokenKind.Comma,
        "expected `,` between an impl's bound and its body"
    ).try();
    body_start = p.here();
    members ::= p.alloc.Vec<Member>();
    p.record_body(members).try();
    body_span = p.span_from(body_start);
    p.eat(TokenKind.Comma).try();
    p.expect_close(
        TokenKind.ParenClose,
        "unclosed `(`: this impl is never closed",
        open
    ).try();
    p.add_decl(DeclKind.Impl(Impl(
        target: target,
        bound: bound,
        members: members,
        body_span: body_span,
    )), m);
}

named_decl = (p :: Parser, m: Mark, module_level: bool) Res<Decl, AllocError> {
    names   ::= p.alloc.Vec<ImportName>();
    tparams ::= p.alloc.Vec<TParam>();
    p.decl_names(names, tparams).try();
    written = p.eat(TokenKind.Colon).try().match({
        true  => p.written_type(),
        false => Ok(None),
    }).try();
    mutable = p.at_kind(TokenKind.ColonColonEq);
    ok      = p.eat(TokenKind.Eq).try() || p.eat(TokenKind.ColonColonEq).try();
    (!ok).then(() {
        p.error("expected `=` or `::=` after a declaration's name").try();
    });
    p.decl_value(m, names, tparams, written, mutable, module_level);
}

// Imports may bind multiple names (`Res*, Ok*, None*`); other declarations
// have one.
decl_names = (
    p       :: Parser,
    names   :: Vec<ImportName>,
    tparams :: Vec<TParam>
) Res<(), AllocError> {
    names.add(p.one_decl_name(tparams).try()).try();
    loop(p.at_kind(TokenKind.Comma), (h) {
        p.bump().try();
        names.add(p.one_decl_name(tparams).try()).try();
    });
    Ok(());
}

one_decl_name = (
    p       :: Parser,
    tparams :: Vec<TParam>
) Res<ImportName, AllocError> {
    m        = p.open();
    name     = p.ident(
        "expected `identifier`: a declaration begins with the name it declares"
    ).try();
    exported = p.eat(TokenKind.Star).try();
    p.at_kind(TokenKind.Lt).then(() { p.type_params(tparams).try(); });
    end = p.prev_end;
    Ok(ImportName(
        name: name,
        exported: exported,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

decl_value = (
    p            :: Parser,
    m            : Mark,
    names        : Vec<ImportName>,
    tparams      : Vec<TParam>,
    written      : Res<TypeId>,
    mutable      : bool,
    module_level : bool
) Res<Decl, AllocError> {
    head = p.head_name(names);
    (names.len > 1).match({
        true  => p.import_decl(m, names),
        false => p.native_binding_ahead().match({
            true  => {
                annotated = written.match({ Ok(_) => true, None => false });
                (mutable || annotated).then(() {
                    p.error(
                        "a native namespace uses an untyped immutable declaration"
                    ).try();
                });
                p.native_binding(m, head, tparams)
            },
            false => p.value_shape(module_level).match({
            StructValue => p.struct_decl(m, head, tparams),
            EnumValue   => p.typed_bits_ahead(module_level, written).match({
                true  => p.const_decl(m, head, written, mutable),
                false => p.enum_decl(m, head, tparams, written),
            }),
            FnValue     => p.fn_decl(m, head, tparams, mutable),
            PathValue   => p.import_decl(m, names),
            AliasValue  => p.alias_decl(m, head, tparams),
            ExprValue   => p.const_decl(m, head, written, mutable),
            }),
        }),
    });
}

// An enum never writes a type, so a typed module constant may begin with
// `Name |`: `MASK: u8 = LOW | HIGH`. Untyped, that shape declares an enum.
typed_bits_ahead = (p :: Parser, module_level: bool, written: Res<TypeId>)
                   bool {
    module_level && written.match({ Ok(_) => true, None => false })
        && p.bar_operands_ahead()
}

// A header binding is a namespace of explicitly written native signatures:
// `c.bind("header.h", {..})`, `c.record(..)`, or `js.bind("document", {..})`
// for an object of the JavaScript host.
native_binding_ahead = (p: Parser) bool {
    c_form  = p.at_text("c")
        && (p.text(p.peek_n(2)).eq("bind") || p.text(p.peek_n(2)).eq("record"));
    js_form = p.at_text("js") && p.text(p.peek_n(2)).eq("bind");
    (c_form || js_form) && p.peek_n(1).kind == TokenKind.Dot && p.peek_n(3).kind == TokenKind.ParenOpen
}

native_text = (p :: Parser) Res<str, AllocError> {
    token = p.peek();
    (token.kind == TokenKind.Str).match({
        false => { p.error("expected a literal native header or symbol name").try(); Ok("") },
        true  => {
            raw = p.literal_text(token).try();
            p.bump().try();
            Ok(raw.slice(1, raw.len - 1))
        },
    })
}

native_binding = (p :: Parser, m: Mark, head: ImportName, tparams: Vec<TParam>)
                 Res<Decl, AllocError> {
    native_record = p.text(p.peek_n(2)).eq("record");
    native_host   = p.at_text("js");
    p.bump().try(); p.bump().try(); p.bump().try();
    open = p.here_span();
    p.bump().try();
    header = p.native_text().try();
    p.expect(TokenKind.Comma, "expected comma after native header").try();
    symbol: Res<str> = p.at_kind(TokenKind.Str).match({
        true  => {
            value = p.native_text().try();
            p.expect(
                TokenKind.Comma,
                "expected comma after native symbol"
            ).try();
            Ok(value)
        },
        false => None,
    });
    (native_record && symbol.match({None => true, Ok(_) => false})).then(() {
        p.error("native records require an explicit C type name").try();
    });
    body_start = p.here();
    raw_members ::= p.alloc.Vec<Member>();
    p.struct_members(raw_members).try();
    body_span = p.span_from(body_start);
    members ::= p.alloc.Vec<Member>();
    raw_members.loop((member) {
        converted = (!native_record).match({
            false => member,
            true  => member.kind.match({
                Const(c) => Member(
                    kind: MemberKind.Field(Field(
                        name: c.name,
                        exported: c.exported,
                        mutable: c.mutable,
                        type: c.type,
                        value: Ok(c.value)
                    )),
                    span: member.span,
                    leading: member.leading,
                    trailing: member.trailing
                ),
                _        => member,
            }),
        });
        valid     = converted.kind.match({
            Function(f) => !native_record && f.body.match({ None => f.tparams.len == 0, Ok(_) => false }),
            // A host object has members, not header constants.
            Field(f)    => !native_host && native_record.match({
                true  => f.type.match({None => false, Ok(_) => true}) && f.value.match({None => true, Ok(_) => false}),
                false => !f.mutable && p.native_integer(
                    f.type
                ) && f.value.match({
                    None      => true,
                    Ok(value) => p.tree.expr_at(
                        value
                    ).kind.match({Literal(lit) => lit.kind.match({Int => true, _ => false}), _ => false}),
                }),
            }),
            _           => false,
        });
        (!valid).then(() {
            p.error_at(
                native_record.match({true => "native records require explicitly typed fields without defaults", false => "native bindings require function signatures or immutable integer constants with optional literal macro fallback"}),
                member.span
            ).try();
        });
        members.add(converted).try();
    });
    (tparams.len > 0).then(
        () { p.error("native binding namespaces cannot be generic").try(); }
    );
    p.eat(TokenKind.Comma).try();
    p.expect_close(TokenKind.ParenClose, "unclosed native binding", open).try();
    p.add_decl(DeclKind.Struct(Struct(
        name: head.name, exported: head.exported, tparams: tparams,
        members: members, body_span: body_span,
        native_header: Ok(
            header
        ), native_symbol: symbol, native_record: native_record,
        native_host: native_host,
    )), m)
}

// Native constants are runtime header expressions, not Zen comptime values.
native_integer = (p: Parser, ty: Res<TypeId>) bool {
    ty.match({
        None   => false,
        Ok(id) => p.tree.type_at(id).kind.match({
            Named(n) => {
                found ::= false;
                ["c_int", "c_uint", "c_char", "c_long", "c_ulong", "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "isize", "usize"].loop((name) { found = found || n.name.text.eq(name); });
                found && n.args.len == 0
            },
            _        => false,
        }),
    })
}

head_name = (p: Parser, names: Vec<ImportName>) ImportName {
    names.get(0).match({
        Ok(n) => n,
        None  => ImportName(
            name: Ident(text: "", span: p.here_span()),
            exported: false,
            span: p.here_span(),
            leading: no_trivia(),
            trailing: no_trivia(),
        ),
    });
}

struct_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>
) Res<Decl, AllocError> {
    body_start = p.here();
    members ::= p.alloc.Vec<Member>();
    p.struct_members(members).try();
    p.add_decl(DeclKind.Struct(Struct(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        members: members,
        body_span: p.span_from(body_start),
    )), m);
}

// The leading bar is retained so one-variant enums round-trip faithfully.
enum_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>,
    repr    : Res<TypeId>
) Res<Decl, AllocError> {
    repr.match({
        Ok(_) => p.error_at(
            "an enum's integer domain comes from its final payload catch-all; remove the type after its name",
            head.name.span
        ),
        None  => Ok(()),
    }).try();
    bar = p.at_kind(TokenKind.Bar).match({
        true  => p.bar_span(),
        false => Ok(None),
    }).try();
    variants ::= p.alloc.Vec<Variant>();
    variants.add(p.one_variant().try()).try();
    // Diagnose a trailing `|` at the bar rather than at the next declaration.
    running ::= p.at_kind(TokenKind.Bar);
    running.loop((h) {
        at_bar = p.here_span();
        p.bump().try();
        another = p.at_kind(TokenKind.Ident);
        another.match({
            true  => variants.add(p.one_variant().try()).try(),
            false => p.error_at(
                "expected variant: a `|` promises another one",
                at_bar
            ).try(),
        });
        running = another && p.at_kind(TokenKind.Bar);
    });
    p.add_decl(DeclKind.Enum(Enum(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        variants: variants,
        leading_bar: bar,
    )), m);
}

bar_span = (p :: Parser) Res<Res<Span>, AllocError> {
    span = p.here_span();
    p.bump().try();
    Ok(Ok(span));
}

// Variants accept at most one type payload and one external discriminant.
one_variant = (p :: Parser) Res<Variant, AllocError> {
    m            = p.open();
    name         = p.ident("expected a variant name").try();
    payload      = p.at_kind(TokenKind.ParenOpen).match({
        true  => p.variant_payload(),
        false => Ok(None),
    }).try();
    discriminant = p.eat(TokenKind.Eq).try().match({
        true  => p.variant_discriminant(),
        false => Ok(None),
    }).try();
    end          = p.prev_end;
    Ok(Variant(
        name: name,
        payload: payload,
        discriminant: discriminant,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}

variant_discriminant = (p :: Parser) Res<Res<ExprId>, AllocError> {
    value = p.expr_before_bar().try();
    Ok(Ok(value));
}

variant_payload = (p :: Parser) Res<Res<TypeId>, AllocError> {
    open = p.here_span();
    p.bump().try();
    t = p.type().try();
    p.expect_close(
        TokenKind.ParenClose,
        "unclosed `(`: this variant's payload is never closed",
        open
    ).try();
    Ok(Ok(t));
}

fn_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>,
    mutable : bool
) Res<Decl, AllocError> {
    forced = p.inline_fn_ahead();
    forced.then(() { p.bump().try(); });
    f ::= p.fn_value(head.name, head.exported, tparams, mutable).try();
    forced.then(() { f.force_inline(); });
    p.add_decl(DeclKind.Function(f), m);
}

alias_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    tparams : Vec<TParam>
) Res<Decl, AllocError> {
    target = p.type().try();
    p.add_decl(DeclKind.Alias(Alias(
        name: head.name,
        exported: head.exported,
        tparams: tparams,
        target: target,
    )), m);
}

import_decl = (
    p     :: Parser,
    m     : Mark,
    names : Vec<ImportName>
) Res<Decl, AllocError> {
    module_name = p.qualified_name().try();
    p.add_decl(DeclKind.Import(Import(names: names, module: module_name)), m);
}

const_decl = (
    p       :: Parser,
    m       : Mark,
    head    : ImportName,
    written : Res<TypeId>,
    mutable : bool
) Res<Decl, AllocError> {
    value = p.expr().try();
    p.add_decl(DeclKind.Const(Const(
        name: head.name,
        exported: head.exported,
        mutable: mutable,
        type: written,
        value: value,
    )), m);
}

add_decl = (p :: Parser, kind: DeclKind, m: Mark) Res<Decl, AllocError> {
    end = p.prev_end;
    Ok(Decl(
        kind: kind,
        span: p.span_from(m.start),
        leading: m.leading,
        trailing: p.claim_trailing(end),
    ));
}
