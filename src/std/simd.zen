// Fixed-width SIMD vectors of unsigned lanes: u8x16, u8x32, u32x4, u32x8,
// u64x2 and u64x4. Every operation below is a compiler primitive validated by
// declaration identity (sema_prim); the C backend lowers vectors to GCC/Clang
// vector extensions, so 32-byte vectors become two 16-byte registers unless a
// function is compiled for a wider target (see `Avx2`).
//
// Lane arithmetic wraps; there is no trapping vector arithmetic. Shifts take
// one count for every lane and yield zero at or above the lane width;
// rotations reduce the count modulo the lane width. Shuffle patterns select
// lanes by index, reduced modulo the lane count (`shuffle`) or twice the lane
// count (`shuffle2`, whose indices at or above N select from `other`). A
// pattern written as an array literal of integer literals lowers to one
// native shuffle. Loads and stores are unaligned and use the target's native
// byte order; every supported target is little-endian. `lane` and
// `with_lane` trap on an index at or beyond the lane count.
Ptr = std.mem

// u8x16: 16 x u8
splat_u8x16* = (value: u8) u8x16
load_u8x16* = (bytes: Ptr<u8>, offset: usize) u8x16
store* = (self: u8x16, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u8x16, index: usize) u8
with_lane* = (self: u8x16, index: usize, value: u8) u8x16
add_wrap* = (self: u8x16, other: u8x16) u8x16
sub_wrap* = (self: u8x16, other: u8x16) u8x16
mul_wrap* = (self: u8x16, other: u8x16) u8x16
bit_xor* = (self: u8x16, other: u8x16) u8x16
bit_and* = (self: u8x16, other: u8x16) u8x16
bit_or* = (self: u8x16, other: u8x16) u8x16
shift_left* = (self: u8x16, count: usize) u8x16
shift_right* = (self: u8x16, count: usize) u8x16
rotate_left* = (self: u8x16, count: usize) u8x16
rotate_right* = (self: u8x16, count: usize) u8x16
shuffle* = (self: u8x16, pattern: [usize, 16]) u8x16
shuffle2* = (self: u8x16, other: u8x16, pattern: [usize, 16]) u8x16

// u8x32: 32 x u8
splat_u8x32* = (value: u8) u8x32
load_u8x32* = (bytes: Ptr<u8>, offset: usize) u8x32
store* = (self: u8x32, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u8x32, index: usize) u8
with_lane* = (self: u8x32, index: usize, value: u8) u8x32
add_wrap* = (self: u8x32, other: u8x32) u8x32
sub_wrap* = (self: u8x32, other: u8x32) u8x32
mul_wrap* = (self: u8x32, other: u8x32) u8x32
bit_xor* = (self: u8x32, other: u8x32) u8x32
bit_and* = (self: u8x32, other: u8x32) u8x32
bit_or* = (self: u8x32, other: u8x32) u8x32
shift_left* = (self: u8x32, count: usize) u8x32
shift_right* = (self: u8x32, count: usize) u8x32
rotate_left* = (self: u8x32, count: usize) u8x32
rotate_right* = (self: u8x32, count: usize) u8x32
shuffle* = (self: u8x32, pattern: [usize, 32]) u8x32
shuffle2* = (self: u8x32, other: u8x32, pattern: [usize, 32]) u8x32

// u32x4: 4 x u32
splat_u32x4* = (value: u32) u32x4
lanes_u32x4* = (l0: u32, l1: u32, l2: u32, l3: u32) u32x4
load_u32x4* = (bytes: Ptr<u8>, offset: usize) u32x4
store* = (self: u32x4, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u32x4, index: usize) u32
with_lane* = (self: u32x4, index: usize, value: u32) u32x4
add_wrap* = (self: u32x4, other: u32x4) u32x4
sub_wrap* = (self: u32x4, other: u32x4) u32x4
mul_wrap* = (self: u32x4, other: u32x4) u32x4
bit_xor* = (self: u32x4, other: u32x4) u32x4
bit_and* = (self: u32x4, other: u32x4) u32x4
bit_or* = (self: u32x4, other: u32x4) u32x4
shift_left* = (self: u32x4, count: usize) u32x4
shift_right* = (self: u32x4, count: usize) u32x4
rotate_left* = (self: u32x4, count: usize) u32x4
rotate_right* = (self: u32x4, count: usize) u32x4
shuffle* = (self: u32x4, pattern: [usize, 4]) u32x4
shuffle2* = (self: u32x4, other: u32x4, pattern: [usize, 4]) u32x4

// u32x8: 8 x u32
splat_u32x8* = (value: u32) u32x8
lanes_u32x8* = (
    l0 : u32,
    l1 : u32,
    l2 : u32,
    l3 : u32,
    l4 : u32,
    l5 : u32,
    l6 : u32,
    l7 : u32
) u32x8
load_u32x8* = (bytes: Ptr<u8>, offset: usize) u32x8
store* = (self: u32x8, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u32x8, index: usize) u32
with_lane* = (self: u32x8, index: usize, value: u32) u32x8
add_wrap* = (self: u32x8, other: u32x8) u32x8
sub_wrap* = (self: u32x8, other: u32x8) u32x8
mul_wrap* = (self: u32x8, other: u32x8) u32x8
bit_xor* = (self: u32x8, other: u32x8) u32x8
bit_and* = (self: u32x8, other: u32x8) u32x8
bit_or* = (self: u32x8, other: u32x8) u32x8
shift_left* = (self: u32x8, count: usize) u32x8
shift_right* = (self: u32x8, count: usize) u32x8
rotate_left* = (self: u32x8, count: usize) u32x8
rotate_right* = (self: u32x8, count: usize) u32x8
shuffle* = (self: u32x8, pattern: [usize, 8]) u32x8
shuffle2* = (self: u32x8, other: u32x8, pattern: [usize, 8]) u32x8

// u64x2: 2 x u64
splat_u64x2* = (value: u64) u64x2
lanes_u64x2* = (l0: u64, l1: u64) u64x2
load_u64x2* = (bytes: Ptr<u8>, offset: usize) u64x2
store* = (self: u64x2, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u64x2, index: usize) u64
with_lane* = (self: u64x2, index: usize, value: u64) u64x2
add_wrap* = (self: u64x2, other: u64x2) u64x2
sub_wrap* = (self: u64x2, other: u64x2) u64x2
mul_wrap* = (self: u64x2, other: u64x2) u64x2
bit_xor* = (self: u64x2, other: u64x2) u64x2
bit_and* = (self: u64x2, other: u64x2) u64x2
bit_or* = (self: u64x2, other: u64x2) u64x2
shift_left* = (self: u64x2, count: usize) u64x2
shift_right* = (self: u64x2, count: usize) u64x2
rotate_left* = (self: u64x2, count: usize) u64x2
rotate_right* = (self: u64x2, count: usize) u64x2
shuffle* = (self: u64x2, pattern: [usize, 2]) u64x2
shuffle2* = (self: u64x2, other: u64x2, pattern: [usize, 2]) u64x2

// u64x4: 4 x u64
splat_u64x4* = (value: u64) u64x4
lanes_u64x4* = (l0: u64, l1: u64, l2: u64, l3: u64) u64x4
load_u64x4* = (bytes: Ptr<u8>, offset: usize) u64x4
store* = (self: u64x4, bytes: Ptr<u8>, offset: usize) ()
lane* = (self: u64x4, index: usize) u64
with_lane* = (self: u64x4, index: usize, value: u64) u64x4
add_wrap* = (self: u64x4, other: u64x4) u64x4
sub_wrap* = (self: u64x4, other: u64x4) u64x4
mul_wrap* = (self: u64x4, other: u64x4) u64x4
bit_xor* = (self: u64x4, other: u64x4) u64x4
bit_and* = (self: u64x4, other: u64x4) u64x4
bit_or* = (self: u64x4, other: u64x4) u64x4
shift_left* = (self: u64x4, count: usize) u64x4
shift_right* = (self: u64x4, count: usize) u64x4
rotate_left* = (self: u64x4, count: usize) u64x4
rotate_right* = (self: u64x4, count: usize) u64x4
shuffle* = (self: u64x4, pattern: [usize, 4]) u64x4
shuffle2* = (self: u64x4, other: u64x4, pattern: [usize, 4]) u64x4
