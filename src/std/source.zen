// Source positions. Every stage carries them: the parser records them, sema
// reports at them, and the IR keeps them for traps and debug lines. They sit
// here, beside no AST type, so a backend can hold a position without
// importing the AST (docs/IR_ARCHITECTURE.md §3.1).

{ Res, Ok, loop, Display, WriteError, Sink } = std.core

// A source point with a one-based line and byte column.
Pos* = {
    line*: usize,
    col*: usize,

    before* = (self: @Self, other: @Self) bool {
        self.line < other.line
            || (self.line == other.line && self.col < other.col)
    }

    at_or_after* = (self: @Self, other: @Self) bool {
        !self.before(other)
    }

    // Byte offset in the original source. Invalid positions are refused,
    // including columns beyond the line and lines beyond the final newline.
    offset_in* = (self: @Self, text: str) Res<usize> {
        (self.line > 0 && self.col > 0).ensure().try();
        at   :: usize = 0;
        line :: usize = 1;
        loop(() { line < self.line }, (h) {
            end = text.newline_in(at, text.len);
            (end < text.len).ensure().try();
            at   = end + 1;
            line = line + 1;
        });
        end = text.newline_in(at, text.len);
        (self.col - 1 <= end - at).ensure().try();
        Ok(at + self.col - 1)
    }
}

Pos.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("{}:{}", self.line, self.col)
    }
})

// Half-open `[start, end)` span. `file` is compilation-root-relative.
Span* = {
    file*: str,
    start*: Pos,
    end*: Pos,

    // Borrow the half-open source span, using the parser's byte columns.
    text_in* = (self: @Self, text: str) Res<str> {
        from = self.start.offset_in(text).try();
        to   = self.end.offset_in(text).try();
        (from <= to).ensure().try();
        Ok(text.slice(from, to))
    }

    // Whether `p` in `file` lies in this span.
    covers* = (self: @Self, file: str, p: Pos) bool {
        self.file.eq(file) && p.at_or_after(self.start) && p.before(self.end)
    }

    // Strictly inside `outer`: contained, and not the same span.
    inside* = (self: @Self, outer: @Self) bool {
        self.start.at_or_after(outer.start)
            && outer.end.at_or_after(self.end)
            && (outer.start.before(self.start) || self.end.before(outer.end))
    }
}

// Span for generated values with no source position. Line zero is the marker.
nowhere* = () Span {
    Span(file: "", start: Pos(line: 0, col: 0), end: Pos(line: 0, col: 0))
}
