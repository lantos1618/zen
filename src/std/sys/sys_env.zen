// Env capabilities on the kernel interface, for the native backend. Each
// function is the native meaning of one bodiless Env, Fs, Stdin or Clock
// member; the C backend supplies its own.

{ Alloc, AllocError, Ptr, null_ptr } = std.mem
{ str, String } = std.text
{ Vec } = std.collections
{ FsError } = std.env
{ Res, Ok, Err, Range, IoError, Duration, loop } = std.core
{ read_file, write_file, env_var, arg, argc, Pages } = std.sys
{ monotonic_ns, realtime_ns, c_path, openat, close, at_fdcwd, o_rdonly, o_cloexec } = std.sys
{ o_directory, o_rdwr, o_creat, flock, eagain } = std.sys
{ mkdirat, unlinkat, renameat2, getcwd, c_len } = std.sys
{ pipe2, dup3, chdir, execve, wait4, kill, ppoll, fcntl, fork, clone } = std.sys
{ read, write, exit_group, envp, eintr, platform_darwin, c_view } = std.sys
{ sleep_ns } = std.sys.sys_thread

// A kernel -errno as the Fs error a caller can act on.
fs_error* = (errno: i64) FsError {
    code = 0 - errno;
    code.match({
        2  => FsError.NotFound,
        13 => FsError.Denied,
        1  => FsError.Denied,
        21 => FsError.IsDir,
        17 => FsError.Exists,
        12 => FsError.OutOfMemory,
        _  => FsError.Failed,
    })
}

fs_read* = (a: Alloc, path: str) Res<String, FsError> {
    read_file(a, path).map_err((e) { fs_error(e) })
}

fs_write* = (path: str, bytes: str) Res<FsError> {
    scratch = Pages();
    write_file(scratch, path, bytes).map_err((e) { fs_error(e) })
}

// `fs.cwd(a)`: the process directory, copied into `a`.
fs_cwd* = (a: Alloc) Res<String, FsError> {
    scratch = Pages();
    buf     = scratch.raw(4096, 1).match({ Ok(p) => Ok(p), Err(_) => Err(FsError.OutOfMemory) }).try();
    n       = getcwd(buf, 4096);
    (n < 0).match({ true => Err(fs_error(n)), false => Ok }).try();
    (n == 0).match({ true => Err(FsError.Failed), false => Ok }).try();
    out ::= a.String().match({ Ok(s) => Ok(s), Err(_) => Err(FsError.OutOfMemory) }).try();
    out.add(str(data: buf, len: c_len(buf))).match({ Ok(_) => Ok, Err(_) => Err(FsError.OutOfMemory) }).try();
    scratch.free(buf);
    Ok(out)
}

// `fs.remove(path)`: true when a file was removed, false when none was
// there. A directory is IsDir and is left alone.
fs_remove* = (path: str) Res<bool, FsError> {
    fs_is_dir(path).match({ true => Err(FsError.IsDir), false => Ok }).try();
    scratch = Pages();
    name    = c_path(scratch, path).match({ Ok(p) => Ok(p), Err(_) => Err(FsError.OutOfMemory) }).try();
    rc      = unlinkat(at_fdcwd(), name, 0);
    scratch.free(name);
    gone    = rc == 0;
    missing = rc == 0 - 2 || rc == 0 - 20;
    (gone || missing).match({ true => Ok(gone), false => Err(fs_error(rc)) })
}

// `fs.rename(from, to)`: `to` names what `from` named, in one step.
fs_rename* = (from: str, to: str) Res<FsError> {
    scratch = Pages();
    old     = c_path(scratch, from).match({ Ok(p) => Ok(p), Err(_) => Err(FsError.OutOfMemory) }).try();
    new     = c_path(scratch, to).match({
        Ok(p)  => Ok(p),
        Err(_) => { scratch.free(old); Err(FsError.OutOfMemory) },
    }).try();
    rc      = renameat2(at_fdcwd(), old, at_fdcwd(), new, 0);
    scratch.free(old);
    scratch.free(new);
    (rc == 0).match({ true => Ok, false => Err(fs_error(rc)) })
}

// `fs.mkdir(path)`: true when this call made the directory, false when it
// already was one. A non-directory in the way is Exists.
fs_mkdir* = (path: str) Res<bool, FsError> {
    scratch = Pages();
    name    = c_path(scratch, path).match({ Ok(p) => Ok(p), Err(_) => Err(FsError.OutOfMemory) }).try();
    rc      = mkdirat(at_fdcwd(), name, 511);
    scratch.free(name);
    (rc == 0).match({
        true  => Ok(true),
        false => (rc == 0 - 17).match({
            true  => fs_is_dir(path).match({ true => Ok(false), false => Err(FsError.Exists) }),
            false => Err(fs_error(rc)),
        }),
    })
}

// Whether a path names anything, and whether it names a directory.
fs_exists* = (path: str) bool { probe(path, 0) }

fs_is_dir* = (path: str) bool { probe(path, o_directory()) }

probe = (path: str, extra: i32) bool {
    scratch = Pages();
    c_path(scratch, path).match({
        Err(_) => false,
        Ok(p)  => {
            fd = openat(at_fdcwd(), p, o_rdonly() + o_cloexec() + extra, 0);
            (fd >= 0).then(() { close(fd.to_i32().value_or(-1)); });
            scratch.free(p);
            fd >= 0
        },
    })
}

// The process arguments as borrowed views, in a Vec whose storage is
// mapped directly and lives until exit.
argv* = () Vec<str> {
    pages = Pages();
    rows ::= pages.Vec<str>();
    Range(0, argc()).loop((i) { arg(i).when_ok((s) { rows.add(s).ignore(); }); });
    rows
}

var* = (name: str) Res<str> { env_var(name) }

// Monotonic time; its origin is unspecified, so only differences matter.
since_start* = () Duration { Duration(ns: monotonic_ns()) }

// Wall-clock time since the Unix epoch.
unix* = () Duration { Duration(ns: realtime_ns()) }

// Block the calling thread for at least `ms` milliseconds.
sleep_ms* = (ms: u64) {
    limit: u64 = 18446744073709;
    sleep_ns((ms > limit).match({ true => u64.MAX, false => ms * 1000000 }));
}

// `fs.lock(path)`: create or open the file and take an exclusive,
// non-blocking flock. Exists when another open file description holds it.
// The descriptor is the Lock the compiler builds from it.
fs_lock_fd* = (path: str) Res<i32, FsError> {
    fs_is_dir(path).match({ true => Err(FsError.IsDir), false => Ok }).try();
    scratch = Pages();
    name    = c_path(scratch, path).match({ Ok(p) => Ok(p), Err(_) => Err(FsError.OutOfMemory) }).try();
    fd      = openat(at_fdcwd(), name, o_rdwr() + o_creat() + o_cloexec(), 438);
    scratch.free(name);
    (fd < 0).match({ true => Err(fs_error(fd)), false => Ok }).try();
    handle = fd.to_i32().value_or(-1);
    // LOCK_EX | LOCK_NB
    locked = flock(handle, 6);
    (locked < 0).then(() { close(handle); }).match({ Ok(_) => (), None => () });
    (locked < 0).match({
        true  => Err(
            (locked == 0 - eagain()).match({ true => FsError.Exists, false => fs_error(
                locked
            ) })
        ),
        false => Ok(handle),
    })
}

// Release a Lock's descriptor; a released Lock holds -1.
fs_unlock_fd* = (fd: i32) {
    (fd >= 0).then(() { close(fd); }).match({ Ok(_) => (), None => () });
}

// ---------------------------------------------------------------------
// child processes: the native meaning of std.proc's zg_os_proc_* floor
// ---------------------------------------------------------------------

// -1 for a failed call, -2 for one a signal interrupted.
proc_failed = (rc: i64) i32 {
    (rc == 0 - eintr()).match({ true => -2, false => -1 })
}

proc_pipe* = (fds: Ptr<i32>) i32 {
    darwin = platform_darwin() == 1;
    flags  = darwin.match({ true => 0, false => o_cloexec() });
    (pipe2(fds, flags) < 0).match({
        true  => -1,
        false => (!darwin || (cloexec(fds.read(0)) && cloexec(fds.read(1)))).match({
            true  => 0,
            false => {
                close(fds.read(0));
                close(fds.read(1));
                -1
            },
        }),
    })
}

// F_SETFD, FD_CLOEXEC
cloexec = (fd: i32) bool { fcntl(fd, 2, 1) >= 0 }

proc_close* = (fd: i32) { (fd >= 0).then(() { close(fd); }); }

// Like posix_spawnp: a failed exec fails the spawn. The child reports one
// byte on a close-on-exec pipe when it cannot exec; a successful exec
// closes the pipe empty.
proc_spawn* = (
    cwd  : Ptr<u8>,
    argv : Ptr<Ptr<u8>>,
    out  : i32,
    err  : i32,
    pid  : Ptr<i32>
)
              i32 {
    scratch = Pages();
    fds     = scratch.realloc<i32>(
        null_ptr<i32>(),
        2
    ).match({ Ok(p) => p, Err(_) => null_ptr<i32>() });
    path    = scratch.raw(
        4096,
        1
    ).match({ Ok(p) => p, Err(_) => null_ptr<u8>() });
    rc :: i32 = -1;
    (!fds.is_null() && !path.is_null() && proc_pipe(fds) == 0).then(() {
        child = fork_process();
        (child == 0).then(() {
            close(fds.read(0));
            exec_child(cwd, argv, out, err, path);
            write(fds.read(1), path, 1);
            exit_group(127);
        });
        close(fds.read(1));
        (child > 0).then(() {
            id = child.to_i32().value_or(-1);
            n ::= read(fds.read(0), path, 1);
            loop(n == 0 - eintr(), (h) { n = read(fds.read(0), path, 1); });
            (n == 0).match({
                true  => {
                    pid.write(0, id);
                    rc = 0;
                },
                false => { reap(id, fds); },
            });
        });
        close(fds.read(0));
    });
    (!path.is_null()).then(() { scratch.free(path); });
    (!fds.is_null()).then(() { scratch.free(fds); });
    rc
}

fork_process = () i64 {
    (platform_darwin() == 1).match({
        true  => fork(),
        // SIGCHLD, so the parent can wait for it.
        false => clone(17, 0, 0, 0, 0),
    })
}

reap = (id: i32, status: Ptr<i32>) {
    rc ::= wait4(id, status, 0, 0);
    loop(rc == 0 - eintr(), (h) { rc = wait4(id, status, 0, 0); });
}

// In the child: returns only when it cannot exec.
exec_child = (
    cwd  : Ptr<u8>,
    argv : Ptr<Ptr<u8>>,
    out  : i32,
    err  : i32,
    path : Ptr<u8>
)
             {
    rc :: i64 = 0;
    (!cwd.is_null()).then(() { rc = chdir(cwd); });
    (rc >= 0 && out >= 0 && out != 1).then(() { rc = dup3(out, 1, 0); });
    (rc >= 0 && err >= 0 && err != 2).then(() { rc = dup3(err, 2, 0); });
    (rc >= 0).then(() { exec_search(argv, path); });
}

// A name with a slash executes as given; any other is tried in each PATH
// directory, an empty one meaning the current directory.
exec_search = (argv: Ptr<Ptr<u8>>, path: Ptr<u8>) {
    name    = c_view(argv.read(0));
    slashed = name.contains('/');
    slashed.then(() { execve(argv.read(0), argv, envp()); });
    (!slashed).then(() {
        dirs = env_var("PATH").value_or("/usr/local/bin:/usr/bin:/bin");
        start :: usize = 0;
        Range(0, dirs.len + 1).loop((i) {
            (i == dirs.len || dirs.index(i) == ':').then(() {
                dir = dirs.slice(start, i);
                exec_in(
                    (dir.len == 0).match({ true => ".", false => dir }),
                    name,
                    argv,
                    path
                );
                start = i + 1;
            });
        });
    });
}

exec_in = (dir: str, name: str, argv: Ptr<Ptr<u8>>, path: Ptr<u8>) {
    (dir.len + name.len + 2 <= 4096).then(() {
        path.copy_from(dir.ptr(), dir.len);
        path.write(dir.len, '/');
        path.offset(dir.len + 1).copy_from(name.ptr(), name.len);
        path.write(dir.len + 1 + name.len, 0);
        execve(path, argv, envp());
    });
}

// Bit 1: stdout is ready, bit 2: stderr; hang-up counts as ready so the
// caller drains what is left before EOF. A negative descriptor is skipped.
proc_poll* = (out: i32, err: i32) i32 {
    scratch = Pages();
    fds     = scratch.realloc<i32>(
        null_ptr<i32>(),
        4
    ).match({ Ok(p) => p, Err(_) => null_ptr<i32>() });
    fds.is_null().match({
        true  => -1,
        false => {
            // struct pollfd: fd, then events (POLLIN) and revents as shorts.
            fds.write(0, out);
            fds.write(1, 1);
            fds.write(2, err);
            fds.write(3, 1);
            wait   = (platform_darwin() == 1).match({ true => usize.MAX, false => 0 });
            rc     = ppoll(fds, 2, wait, 0, 8);
            first  = fds.read(1) / 65536;
            second = fds.read(3) / 65536;
            scratch.free(fds);
            (rc < 0).match({
                true  => proc_failed(rc),
                // POLLNVAL
                false => (first / 32 % 2 == 1 || second / 32 % 2 == 1).match({
                    true  => -1,
                    false => (first > 0).match({ true => 1, false => 0 }) + (second > 0).match({
                        true  => 2,
                        false => 0,
                    }),
                }),
            })
        },
    })
}

proc_read* = (fd: i32, buf: Ptr<u8>, cap: usize, count: Ptr<usize>) i32 {
    n = read(fd, buf, cap);
    (n < 0).match({
        true  => proc_failed(n),
        false => {
            count.write(0, n.to_usize().value_or(0));
            (n > 0).match({ true => 1, false => 0 })
        },
    })
}

// pid <= 0 names a process group, never one child: refused.
proc_wait* = (pid: i32, code: Ptr<i32>) i32 {
    scratch = Pages();
    status  = scratch.realloc<i32>(
        null_ptr<i32>(),
        1
    ).match({ Ok(p) => p, Err(_) => null_ptr<i32>() });
    (pid <= 0 || status.is_null()).match({
        true  => -1,
        false => {
            rc = wait4(pid, status, 0, 0);
            s  = status.read(0);
            scratch.free(status);
            (rc < 0).match({
                true  => proc_failed(rc),
                false => {
                    signal = s % 128;
                    code.write(0, signal.match({
                        0   => s / 256 % 256,
                        127 => 127,
                        _   => 128 + signal,
                    }));
                    0
                },
            })
        },
    })
}

proc_kill* = (pid: i32) { (pid > 0).then(() { kill(pid, 9); }); }
