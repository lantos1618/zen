// CLI entry point and public driver surface.

Alloc, AllocError = std.mem
str, String = std.text
FsError = std.env
BuildArgs, ProjectArgs = std.build

Cli*, FmtJob*, LspJob*, Refusal*, cli*, help = zen.zen_cli
Build* = zen.zen_build
fs_message = std.env
std_root_for, holds_std = zen.zen_path
build* = zen.zen_run
project, Action = zen.zen_project
format = zen.zen_fmt
init = zen.zen_init
Server, serve, serve_stdio = lsp

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    cli(env, alloc, env.argv).try().match({
        Build(job)       => build_cli(env, alloc, job),
        Project(job)     => project_cli(env, alloc, job, Action.Build),
        Run(job)         => project_cli(env, alloc, job, Action.Run),
        Test(job)        => project_cli(env, alloc, job, Action.Test),
        Fmt(job)         => format(env, alloc, job),
        Init(dir)        => init(env, alloc, dir),
        Lsp(job)         => lsp(env, alloc, job),
        Version(v)       => {
            println("zen {}", v);
            Ok(0)
        },
        Help(text)       => {
            print("{}", text.view());
            Ok(0)
        },
        Refused(refusal) => usage(env, refusal),
    })
}

// Exit 2: a usage error is not a build failure. The message and the help of
// the command it addressed go to standard error.
usage = (env: Env, refusal: Refusal) Res<i32, AllocError> {
    (!refusal.message.view().is_empty()).then(() {
        env.out.errorln("zen: {}\n", refusal.message.view()).ignore();
    });
    env.out.error("{}", refusal.help.view()).ignore();
    Ok(2)
}

// The standard library every command compiles against. None has already
// explained what is missing.
standard_library = (env: Env, a: Alloc, given: str) Res<str> {
    root = given.is_empty().match({ true => std_root_for(
        env,
        a
    ), false => given });
    (!root.is_empty() && holds_std(env, a, root)).match({
        true  => Ok(root),
        false => {
            root.is_empty().match({
                true  => println(
                    "zen: standard library not found; set ZEN_STD or install std next to the zen binary"
                ),
                false => println(
                    "zen: standard library not found at `{}`: it holds no std/std.zen; set ZEN_STD to the directory that does",
                    root
                ),
            });
            None
        },
    })
}

// Project configuration and its resolved paths share the caller allocation.
project_cli = (env: Env, a: Alloc, job: ProjectArgs, action: Action)
              Res<i32, AllocError> {
    standard_library(env, a, job.std_root).match({
        None         => Ok(1),
        Ok(std_root) => project(
            env,
            a,
            ProjectArgs(
                root: job.root,
                target: job.target,
                std_root: std_root,
                argv: job.argv,
                args_at: job.args_at,
                mode: job.mode,
                verbose: job.verbose,
                cc: job.cc,
                triple: job.triple
            ),
            action
        ),
    })
}

build_cli = (env: Env, a: Alloc, job: BuildArgs) Res<i32, AllocError> {
    standard_library(env, a, job.std_root).match({
        None         => Ok(1),
        Ok(std_root) => build(
            env,
            a,
            BuildArgs(
                root: job.root,
                emission: job.emission,
                backend: job.backend,
                entry: job.entry,
                std_root: std_root,
                symbol_map: job.symbol_map,
                ffi: job.ffi,
                repeat: job.repeat,
                permute: job.permute,
                target: job.target
            )
        ),
    })
}

// `zen lsp` serves standard I/O; `zen lsp <requests> <replies>` serves the
// same session over two files for transport tests.
lsp = (env: Env, a: Alloc, job: LspJob) Res<i32, AllocError> {
    job.requests.match({
        None     => serve_stdio(env, a),
        Ok(from) => answer(env, a, from, job.replies.value_or("")),
    })
}

answer = (env: Env, a: Alloc, from: str, to: str) Res<i32, AllocError> {
    env.fs.read(a, from).match({
        Err(e)    => unreadable(from, e),
        Ok(input) => replies(env, a, input.view(), to),
    })
}

replies = (env: Env, a: Alloc, input: str, to: str) Res<i32, AllocError> {
    s   ::= a.Server(env);
    out ::= a.String().try();
    serve(s, input, out).try();
    env.fs.write(to, out.view()).match({
        Err(e) => unwritable(to, e),
        Ok(_)  => Ok(0),
    })
}

unreadable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: {}: {}", path, fs_message(e));
    Ok(1);
}

unwritable = (path: str, e: FsError) Res<i32, AllocError> {
    println("zen lsp: {}: {}", path, fs_message(e));
    Ok(1);
}
