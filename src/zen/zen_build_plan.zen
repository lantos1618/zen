// Execute the dependency-graph subset of a checked build.zen AST: target
// registrations, local bindings, lists, std.build enum values and `.match`
// over values known while planning, such as `b.mode()` and `b.os`.
// Unsupported expression shapes are rejected at their source spans, and a
// written target field that cannot be evaluated is an error naming it.

{ Alloc, AllocError } = std.mem
{ str } = std.text
{ Vec } = std.collections
{ Res, Ok, Err, None, Range, Path } = std.core

{ Ast, ExprId, Expr, Call, Access, Record, Block, Function, Try } = std.ast
{ Match, PatternId } = std.ast
{ Span } = std.source
{ nowhere } = std.source
{ Stmt, Bind, Member, Field, Module } = std.ast
{ Checker, Ctx, type_of } = sema.sema
{ CImport, Lib, Extern, Exe, Dep, Target, Codegen, Package } = std.build
{ Mode, Optimize, Cc } = std.build

PlanFault* = { MissingBuild: str
    | CheckedFaults
    | MissingField: Span
    | UnknownName: Span
    | DuplicateTarget: str
    | Unsupported: Span
    | BadField: FieldFault
    | UnknownField: FieldFault
    | NoArm: Span }

// A written target field the planner could not turn into its value.
FieldFault* = { at*: Span, name*: str }

PlanError* = { OutOfMemory | Refused: PlanFault }

refused = (fault: PlanFault) PlanError { PlanError.Refused(fault) }

unsupported = (at: Span) PlanError { refused(PlanFault.Unsupported(at)) }

CImportNode* = {
    name*: str,
    spec*: CImport,
    dep*: Dep,
}

LibNode* = {
    name*: str,
    spec*: Lib,
    dep*: Dep,
}

PackageNode* = {
    name*: str,
    spec*: Package,
}

ExternNode* = {
    name*: str,
    spec*: Extern,
    dep*: Dep,
}

ExeNode* = {
    name*: str,
    spec*: Exe,
}

BuildPlan* = {
    target*: Target,
    imports* :: Vec<CImportNode>,
    libs* :: Vec<LibNode>,
    packages* :: Vec<PackageNode>,
    externs* :: Vec<ExternNode>,
    exes* :: Vec<ExeNode>,
    tests* :: Vec<ExeNode>,
}

ExecutableRole = { Program | Test }

EXE_FIELDS: str = "src deps backend optimize language frameworks strip cc cflags defines libs web out"

Value = { UnitValue
    | BuilderValue
    | TextValue: str
    | BoolValue: bool
    | PathValue: Path
    | TargetValue: Target
    | VariantValue: Variant
    | CcValue: Cc
    | DepValue: Dep
    | EmptyList
    | TextList: Vec<str>
    | DepList: Vec<Dep>
    | PathOption: Res<Path> }

// A std.build enum value known while planning: its type's name and the
// variant's.
Variant = { owner: str, name: str }

Local = {
    name: str,
    value: Value,
}

Executor = {
    alloc: Alloc,
    tree: Ast,
    check :: Checker,
    builder: str,
    mode: Mode,
    locals :: Vec<Local>,
    plan :: BuildPlan,

    block = (self :: @Self, body: Block) Res<(), PlanError> {
        body.stmts.loop((h, stmt) {
            stmt.kind.match({
                Bind(b) => self.bind(b).try(),
                Expr(s) => { self.eval(s.expr).try(); },
                _       => Err(unsupported(stmt.span)).try(),
            });
        });
        body.value.match({
            None      => Ok(()),
            Ok(value) => { self.eval(value).try(); Ok(()) },
        })
    }

    bind = (self :: @Self, b: Bind) Res<(), PlanError> {
        target = self.tree.expr_at(b.target);
        target.kind.match({
            Name(n) => {
                self.has_local(n.text).match({
                    true  => Err(unsupported(target.span)),
                    false => {
                        value = self.eval(b.value).try();
                        self.locals.add(Local(
                            name: n.text,
                            value: value
                        )).try(PlanError.OutOfMemory);
                        Ok(())
                    },
                })
            },
            _       => Err(unsupported(target.span)),
        })
    }

    eval = (self :: @Self, id: ExprId) Res<Value, PlanError> {
        node = self.tree.expr_at(id);
        node.kind.match({
            Unit       => Ok(Value.UnitValue),
            Name(n)    => n.text.eq(self.builder).match({
                true  => Ok(Value.BuilderValue),
                false => self.named(n.text, node.span),
            }),
            Literal(l) => l.kind.match({
                Str  => self.text(l.text, node.span),
                Bool => Ok(Value.BoolValue(l.text.eq("true"))),
                _    => Err(unsupported(node.span)),
            }),
            Paren(p)   => self.eval(p.inner),
            Access(a)  => self.access(id, a, node.span),
            Match(m)   => self.choose(m, node.span),
            Array(a)   => self.array(a.elems, node.span),
            Try(t)     => self.eval_try(t),
            Call(c)    => self.call(id, c, node.span),
            _          => Err(unsupported(node.span)),
        })
    }

    // `Mode.Release`, `b.os`, `b.target().arch`: an enum value from std.build,
    // or a field of the Builder or of a Target.
    access = (self :: @Self, id: ExprId, access: Access, at: Span) Res<Value, PlanError> {
        self.global_base(access.base).match({
            true  => {
                owner = self.enum_owner(id, at).try();
                Ok(Value.VariantValue(Variant(
                    owner: owner,
                    name: access.name.text
                )))
            },
            false => self.eval(access.base).try().match({
                BuilderValue   => self.target_part(
                    self.plan.target,
                    access.name.text,
                    at
                ),
                TargetValue(t) => self.target_part(t, access.name.text, at),
                _              => Err(unsupported(at)),
            }),
        })
    }

    target_part = (self: @Self, target: Target, name: str, at: Span) Res<Value, PlanError> {
        name.match({
            "os"   => Ok(Value.VariantValue(Variant(
                owner: "Os",
                name: target.os.variant_name()
            ))),
            "arch" => Ok(Value.VariantValue(Variant(
                owner: "Arch",
                name: target.arch.variant_name()
            ))),
            "abi"  => Ok(Value.VariantValue(Variant(
                owner: "Abi",
                name: target.abi.variant_name()
            ))),
            _      => Err(unsupported(at)),
        })
    }

    // The std.build enum an expression's checked type names. Required builder
    // members do not retain a memo for every record field, so an unmemoized
    // global expression is typed again in its owning module; runtime locals
    // cannot be reconstructed outside their lexical scope.
    enum_owner = (self :: @Self, id: ExprId, at: Span) Res<str, PlanError> {
        ty    = self.check.expr_memo.get(id).match({
            Ok(ty) => ty,
            None   => {
                module  = Range(0, self.tree.module_count()).find((index) {
                    self.tree.module_at(index).match({
                        Ok(module) => module.span.file.eq(at.file),
                        None       => false,
                    })
                }).ok_or(unsupported(at)).try();
                unknown = self.check.types.unknown().try(PlanError.OutOfMemory);
                self.check.type_of(
                    id,
                    Ctx(module, unknown)
                ).try(PlanError.OutOfMemory)
            },
        });
        owner = self.check.types.at(ty).match({
            Named(named) => self.check.world.module_name(named.decl).eq("std.build.build").match({
                true  => Ok(named.name),
                false => None,
            }),
            _            => None,
        }).ok_or(unsupported(at)).try();
        known = owner.eq("Codegen") || owner.eq("Mode") || owner.eq("Optimize")
            || owner.eq("Cc") || owner.eq("Os") || owner.eq("Arch") || owner.eq("Abi");
        known.ensure(unsupported(at)).try();
        Ok(owner)
    }

    // The first arm whose pattern accepts the scrutinee's planned value.
    choose = (self :: @Self, m: Match, at: Span) Res<Value, PlanError> {
        value = self.eval(m.scrutinee).try();
        arm   = m.arms.find((arm) { self.accepts(arm.pattern, value) }).ok_or(refused(PlanFault.NoArm(at))).try();
        self.eval(arm.body)
    }

    accepts = (self: @Self, id: PatternId, value: Value) bool {
        self.tree.pattern_at(id).kind.match({
            Wild       => true,
            Name(n)    => value.match({
                VariantValue(v) => v.name.eq(n.name.last_segment()),
                CcValue(cc)     => cc.variant_name().eq(n.name.last_segment()),
                _               => false,
            }),
            Literal(l) => value.match({
                BoolValue(b) => l.text.eq(
                    b.match({ true => "true", false => "false" })
                ),
                TextValue(t) => l.text.len == t.len + 2 && l.text.slice(1, l.text.len - 1).eq(t),
                _            => false,
            }),
            _          => false,
        })
    }

    global_base = (self: @Self, id: ExprId) bool {
        self.tree.expr_at(id).kind.match({
            Name(name)     => !self.has_local(name.text) && !name.text.eq(self.builder),
            Access(access) => self.global_base(access.base),
            _              => false,
        })
    }

    // Checked build calls take their Ok path; mapping belongs to Err.
    eval_try = (self :: @Self, t: Try) Res<Value, PlanError> {
        t.error.match({
            Ok(_) => self.eval(t.operand),
            None  => self.eval(t.operand),
        })
    }

    text = (self: @Self, raw: str, at: Span) Res<Value, PlanError> {
        escaped ::= false;
        Range(1, raw.len - 1).loop((h, i) {
            (raw.index(i) == '\\').then(() { escaped = true; h.break(); });
        });
        escaped.match({
            true  => Err(unsupported(at)),
            false => Ok(Value.TextValue(raw.slice(1, raw.len - 1))),
        })
    }

    array = (self :: @Self, ids: Vec<ExprId>, at: Span)
            Res<Value, PlanError> {
        (ids.len == 0).match({
            true  => Ok(Value.EmptyList),
            false => self.array_nonempty(ids, at),
        })
    }

    array_nonempty = (self :: @Self, ids: Vec<ExprId>, at: Span)
                     Res<Value, PlanError> {
        first_id = ids.get(0).match({ Ok(id) => id, None => ExprId(index: 0) });
        first    = self.eval(first_id).try();
        first.match({
            TextValue(text) => {
                out ::= self.alloc.Vec<str>();
                out.add(text).try(PlanError.OutOfMemory);
                Range(1, ids.len).loop((h, i) {
                    id = ids.get(i).match({ Ok(v) => v, None => first_id });
                    self.eval(id).try().match({
                        TextValue(value) => out.add(
                            value
                        ).try(PlanError.OutOfMemory),
                        _                => Err(unsupported(at)).try(),
                    });
                });
                Ok(Value.TextList(out))
            },
            DepValue(dep)   => {
                out ::= self.alloc.Vec<Dep>();
                out.add(dep).try(PlanError.OutOfMemory);
                Range(1, ids.len).loop((h, i) {
                    id = ids.get(i).match({ Ok(v) => v, None => first_id });
                    self.eval(id).try().match({
                        DepValue(value) => out.add(
                            value
                        ).try(PlanError.OutOfMemory),
                        _               => Err(unsupported(at)).try(),
                    });
                });
                Ok(Value.DepList(out))
            },
            _               => Err(unsupported(at)),
        })
    }

    call = (self :: @Self, id: ExprId, c: Call, at: Span)
           Res<Value, PlanError> {
        callee = self.tree.expr_at(c.callee);
        callee.kind.match({
            Name(n)   => self.free_call(n.text, c, at),
            Access(a) => self.access_call(id, c, a, at),
            _         => Err(unsupported(at)),
        })
    }

    free_call = (self :: @Self, name: str, c: Call, at: Span)
                Res<Value, PlanError> {
        name.match({
            "Path" => self.path_call(c, at),
            "Ok"   => self.one_arg(c, at).match({
                Err(e) => Err(e),
                Ok(id) => self.eval(id).try().match({
                    PathValue(path) => Ok(Value.PathOption(Ok(path))),
                    value           => Ok(value),
                }),
            }),
            _      => Err(unsupported(at)),
        })
    }

    // Path has a borrowed one-argument constructor and an allocating
    // allocator-plus-text constructor. The checked call has already selected
    // the overload; the plan retains only the resulting path bytes.
    path_call = (self :: @Self, c: Call, at: Span)
                Res<Value, PlanError> {
        c.args.len.match({
            1 => self.path_arg(c, 0, at),
            2 => self.path_arg(c, 1, at),
            _ => Err(unsupported(at)),
        })
    }

    path_arg = (self :: @Self, c: Call, i: usize, at: Span)
               Res<Value, PlanError> {
        id = self.arg(c, i, at).try();
        self.eval(id).try().match({
            TextValue(text) => Ok(Value.PathValue(Path(text))),
            _               => Err(unsupported(at)),
        })
    }

    // Sema selects no body for a required Builder member, so no member-call
    // memo exists; the checked receiver type is the proof.
    access_call = (self :: @Self, id: ExprId, c: Call, a: Access, at: Span)
                  Res<Value, PlanError> {
        custom = a.name.text.eq("Custom") && self.global_base(a.base);
        custom.then(
            () { self.enum_owner(id, at).try().eq("Cc").ensure(unsupported(at)).try(); }
        );
        // Evaluate the receiver once, so chained registrations retain order.
        (a.name.text.eq("Vec") && c.args.len == 0 || custom).match({
            true  => self.value_call(c, a, at),
            false => self.eval(a.base).try().match({
                BuilderValue => self.builder_call(a.name.text, c, at),
                _            => self.value_call(c, a, at),
            }),
        })
    }

    value_call = (self :: @Self, c: Call, a: Access, at: Span)
                 Res<Value, PlanError> {
        a.name.text.match({
            "Vec"    => (c.args.len == 0).match({
                true  => Ok(Value.EmptyList),
                false => self.local_add(c, a, at),
            }),
            "Custom" => self.eval(self.one_arg(c, at).try()).try().match({
                PathValue(path) => Ok(Value.CcValue(Cc.Custom(path))),
                _               => Err(unsupported(at)),
            }),
            _        => self.local_add(c, a, at),
        })
    }

    // A dependency accumulator is the mutable local shape used by real build
    // files before handing the completed Vec to an executable target.
    local_add = (self :: @Self, c: Call, a: Access, at: Span)
                Res<Value, PlanError> {
        base = self.tree.expr_at(a.base);
        (a.name.text.eq("add") && c.args.len == 1).match({
            false => Err(unsupported(at)),
            true  => base.kind.match({
                Name(n) => self.add_dep_local(n.text, c, at),
                _       => Err(unsupported(at)),
            }),
        })
    }

    add_dep_local = (self :: @Self, name: str, c: Call, at: Span)
                    Res<Value, PlanError> {
        value = self.eval(self.arg(c, 0, at).try()).try();
        value.match({
            DepValue(dep) => self.push_dep(name, dep, at),
            _             => Err(unsupported(at)),
        })
    }

    push_dep = (self :: @Self, name: str, dep: Dep, at: Span)
               Res<Value, PlanError> {
        self.local_index(name).match({
            None  => Err(refused(PlanFault.UnknownName(at))),
            Ok(i) => self.locals.get(i).match({
                None      => Err(refused(PlanFault.UnknownName(at))),
                Ok(local) => local.value.match({
                    EmptyList       => {
                        values ::= self.alloc.Vec<Dep>();
                        values.add(dep).try(PlanError.OutOfMemory);
                        self.replace_local(i, name, Value.DepList(values))
                    },
                    DepList(values) => {
                        kept ::= values;
                        kept.add(dep).try(PlanError.OutOfMemory);
                        self.replace_local(i, name, Value.DepList(kept))
                    },
                    _               => Err(unsupported(at)),
                }),
            }),
        })
    }

    replace_local = (self :: @Self, i: usize, name: str, value: Value)
                    Res<Value, PlanError> {
        self.locals.set(i, Local(name: name, value: value)).match({
            None  => Err(refused(PlanFault.UnknownName(nowhere()))),
            Ok(_) => Ok(Value.UnitValue),
        })
    }

    builder_call = (self :: @Self, name: str, c: Call, at: Span)
                   Res<Value, PlanError> {
        name.match({
            "target"   => (c.args.len == 0).match({
                true  => Ok(Value.TargetValue(self.plan.target)),
                false => Err(unsupported(at)),
            }),
            "mode"     => (c.args.len == 0).match({
                true  => Ok(Value.VariantValue(Variant(
                    owner: "Mode",
                    name: self.mode.variant_name()
                ))),
                false => Err(unsupported(at)),
            }),
            "c_import" => self.add_import(c, at),
            "lib"      => self.add_lib(c, at),
            "add"      => self.add_package(c, at),
            "extern"   => self.add_extern(c, at),
            "exe"      => self.add_exe(c, at, ExecutableRole.Program),
            "exe_test" => self.add_exe(c, at, ExecutableRole.Test),
            _          => Err(unsupported(at)),
        })
    }

    add_import = (self :: @Self, c: Call, at: Span)
                 Res<Value, PlanError> {
        name = self.name_arg(c, at).try();
        self.unique(name).try();
        record_id = self.arg(c, 1, at).try();
        r         = self.record(record_id).try();
        spec      = CImport(
            headers: self.texts_field(r, "headers").try(),
            include_paths: self.texts_field(r, "include_paths").try(),
            defines: self.texts_field(r, "defines").try(),
            libraries: self.texts_field(r, "libraries").try(),
            target: self.target_field(r, "target").try()
        );
        dep       = Dep(name: name);
        self.plan.imports.add(CImportNode(
            name: name,
            spec: spec,
            dep: dep
        )).try(PlanError.OutOfMemory);
        Ok(Value.DepValue(dep))
    }

    add_lib = (self :: @Self, c: Call, at: Span) Res<Value, PlanError> {
        name = self.name_arg(c, at).try();
        self.unique(name).try();
        r    = self.record(self.arg(c, 1, at).try()).try();
        spec = Lib(
            src: self.path_field(r, "src").try(),
            libs: self.texts_field(r, "libs").try(),
            paths: self.texts_field(r, "paths").try()
        );
        dep  = Dep(name: name);
        self.plan.libs.add(LibNode(
            name: name,
            spec: spec,
            dep: dep
        )).try(PlanError.OutOfMemory);
        Ok(Value.DepValue(dep))
    }

    add_package = (self :: @Self, c: Call, at: Span) Res<Value, PlanError> {
        name = self.name_arg(c, at).try();
        self.unique(name).try();
        r    = self.record(self.arg(c, 1, at).try()).try();
        spec = Package(
            url: self.text_field(r, "url").try(),
            rev: self.text_field(r, "rev").try(),
            src: self.path_field(r, "src").try(),
            libs: self.texts_field(r, "libs").try(),
            paths: self.texts_field(r, "paths").try()
        );
        self.plan.packages.add(PackageNode(
            name: name,
            spec: spec
        )).try(PlanError.OutOfMemory);
        Ok(Value.DepValue(Dep(name: name)))
    }

    add_extern = (self :: @Self, c: Call, at: Span)
                 Res<Value, PlanError> {
        name = self.name_arg(c, at).try();
        self.unique(name).try();
        r    = self.record(self.arg(c, 1, at).try()).try();
        spec = Extern(
            src: self.path_field(r, "src").try(),
            libs: self.texts_field(r, "libs").try(),
            paths: self.texts_field(r, "paths").try()
        );
        dep  = Dep(name: name);
        self.plan.externs.add(ExternNode(
            name: name,
            spec: spec,
            dep: dep
        )).try(PlanError.OutOfMemory);
        Ok(Value.DepValue(dep))
    }

    add_exe = (self :: @Self, c: Call, at: Span, role: ExecutableRole) Res<Value, PlanError> {
        name = self.name_arg(c, at).try();
        self.unique(name).try();
        r = self.record(self.arg(c, 1, at).try()).try();
        self.only(r, EXE_FIELDS).try();
        spec = Exe(
            src: self.path_field(r, "src").try(),
            deps: self.deps_field(r, "deps").try(),
            backend: self.backend_field(r).try(),
            optimize: self.optimize_field(r).try(),
            language: self.optional_text_field(r, "language", "c").try(),
            frameworks: Ok(self.optional_texts_field(r, "frameworks").try()),
            strip: self.optional_bool_field(r, "strip", false).try(),
            cc: self.cc_field(r).try(),
            cflags: Ok(self.optional_texts_field(r, "cflags").try()),
            defines: Ok(self.optional_texts_field(r, "defines").try()),
            libs: Ok(self.optional_texts_field(r, "libs").try()),
            web: self.optional_bool_field(r, "web", false).try(),
            out: self.optional_path_field(r, "out").try()
        );
        node = ExeNode(name: name, spec: spec);
        role.match({
            Test    => self.plan.tests.add(node),
            Program => self.plan.exes.add(node),
        }).try(PlanError.OutOfMemory);
        Ok(Value.BuilderValue)
    }

    unique = (self: @Self, name: str) Res<(), PlanError> {
        duplicate = self.plan.imports.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            })
            || self.plan.libs.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            })
            || self.plan.packages.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            })
            || self.plan.externs.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            })
            || self.plan.tests.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            })
            || self.plan.exes.find((n) { n.name.eq(name) }).match({
                Ok(_) => true, None => false,
            });
        duplicate.match({
            true  => Err(refused(PlanFault.DuplicateTarget(name))),
            false => Ok(()),
        })
    }

    name_arg = (self :: @Self, c: Call, at: Span) Res<str, PlanError> {
        self.eval(self.arg(c, 0, at).try()).try().match({
            TextValue(name) => Ok(name),
            _               => Err(unsupported(at)),
        })
    }

    arg = (self: @Self, c: Call, i: usize, at: Span)
          Res<ExprId, PlanError> {
        c.args.get(i).match({
            Ok(a) => Ok(a.value),
            None  => Err(unsupported(at)),
        })
    }

    one_arg = (self: @Self, c: Call, at: Span) Res<ExprId, PlanError> {
        (c.args.len == 1).match({
            true  => self.arg(c, 0, at),
            false => Err(unsupported(at)),
        })
    }

    record = (self: @Self, id: ExprId) Res<Record, PlanError> {
        node = self.tree.expr_at(id);
        node.kind.match({
            Record(r) => Ok(r),
            _         => Err(unsupported(node.span)),
        })
    }

    field = (self: @Self, r: Record, name: str) Res<ExprId, PlanError> {
        r.entries.find((m) { m.named(name) }).match({
            None  => Err(refused(PlanFault.MissingField(r.entries.get(0).match({
                Ok(m) => m.span,
                None  => nowhere(),
            })))),
            Ok(m) => m.kind.match({
                Field(f) => f.value.match({
                    Ok(id) => Ok(id),
                    None   => Err(refused(PlanFault.MissingField(m.span))),
                }),
                _        => Err(unsupported(m.span)),
            }),
        })
    }

    text_field = (self :: @Self, r: Record, name: str) Res<str, PlanError> {
        id = self.field(r, name).try();
        self.eval(id).try().match({
            TextValue(text) => Ok(text),
            _               => Err(unsupported(self.tree.expr_at(id).span)),
        })
    }

    texts_field = (self :: @Self, r: Record, name: str)
                  Res<Vec<str>, PlanError> {
        id = self.field(r, name).try();
        self.eval(id).try().match({
            TextList(values) => Ok(values),
            EmptyList        => Ok(self.alloc.Vec<str>()),
            _                => Err(unsupported(self.tree.expr_at(id).span)),
        })
    }

    deps_field = (self :: @Self, r: Record, name: str)
                 Res<Vec<Dep>, PlanError> {
        id = self.field(r, name).try();
        self.eval(id).try().match({
            DepList(values) => Ok(values),
            EmptyList       => Ok(self.alloc.Vec<Dep>()),
            _               => Err(unsupported(self.tree.expr_at(id).span)),
        })
    }

    path_field = (self :: @Self, r: Record, name: str)
                 Res<Path, PlanError> {
        id = self.field(r, name).try();
        self.eval(id).try().match({
            PathValue(value) => Ok(value),
            _                => Err(unsupported(self.tree.expr_at(id).span)),
        })
    }

    target_field = (self :: @Self, r: Record, name: str)
                   Res<Target, PlanError> {
        id = self.field(r, name).try();
        self.eval(id).try().match({
            TargetValue(value) => Ok(value),
            _                  => Err(unsupported(self.tree.expr_at(id).span)),
        })
    }

    // An omitted optional field takes its default. A written one must
    // evaluate to its type; anything else is an error naming the field, never
    // a silent fallback.
    optional = (self :: @Self, r: Record, name: str) Res<Res<Value>, PlanError> {
        r.entries.find((m) { m.named(name) }).match({
            None  => Ok(None),
            Ok(m) => {
                id    = self.field(r, name).try();
                fault = PlanFault.BadField(FieldFault(
                    at: self.tree.expr_at(id).span,
                    name: name
                ));
                value = self.eval(id).map_err((e) {
                    e.match({ OutOfMemory => PlanError.OutOfMemory, Refused(_) => refused(
                        fault
                    ) })
                }).try();
                Ok(Ok(value))
            },
        })
    }

    // Refuse a field the target type does not declare. `known` lists the
    // declared names separated by spaces.
    only = (self: @Self, r: Record, known: str) Res<(), PlanError> {
        r.entries.loop((m) {
            m.kind.match({
                Field(f) => {
                    declared = known.split(' ').loop((h, name) { f.name.text.eq(name).then(() { h.break(name); }); });
                    declared.match({
                        Ok(_) => (),
                        None  => Err(refused(PlanFault.UnknownField(FieldFault(
                            at: m.span,
                            name: f.name.text
                        )))).try(),
                    });
                },
                _        => (),
            });
        });
        Ok(())
    }

    // The error for a field whose value has the wrong shape.
    misplaced = (self: @Self, r: Record, name: str) PlanError {
        at = self.field(r, name).match({ Ok(id) => self.tree.expr_at(id).span, Err(_) => nowhere() });
        refused(PlanFault.BadField(FieldFault(at: at, name: name)))
    }

    backend_field = (self :: @Self, r: Record) Res<Codegen, PlanError> {
        self.optional(r, "backend").try().match({
            None                => Ok(Codegen.C),
            Ok(VariantValue(v)) => v.name.match({
                "C"   => Ok(Codegen.C),
                "Js"  => Ok(Codegen.Js),
                "Asm" => Ok(Codegen.Asm),
                _     => Err(self.misplaced(r, "backend")),
            }),
            Ok(_)               => Err(self.misplaced(r, "backend")),
        })
    }

    optimize_field = (self :: @Self, r: Record) Res<Res<Optimize>, PlanError> {
        self.optional(r, "optimize").try().match({
            None                => Ok(None),
            Ok(VariantValue(v)) => v.name.match({
                "Debug" => Ok(Ok(Optimize.Debug)),
                "Speed" => Ok(Ok(Optimize.Speed)),
                "Size"  => Ok(Ok(Optimize.Size)),
                _       => Err(self.misplaced(r, "optimize")),
            }),
            Ok(_)               => Err(self.misplaced(r, "optimize")),
        })
    }

    cc_field = (self :: @Self, r: Record) Res<Res<Cc>, PlanError> {
        self.optional(r, "cc").try().match({
            None                => Ok(None),
            Ok(CcValue(cc))     => Ok(Ok(cc)),
            Ok(VariantValue(v)) => v.name.match({
                "Clang" => Ok(Ok(Cc.Clang)),
                "Gcc"   => Ok(Ok(Cc.Gcc)),
                "Tcc"   => Ok(Ok(Cc.Tcc)),
                _       => Err(self.misplaced(r, "cc")),
            }),
            Ok(_)               => Err(self.misplaced(r, "cc")),
        })
    }

    optional_texts_field = (self :: @Self, r: Record, name: str) Res<Vec<str>, PlanError> {
        self.optional(r, name).try().match({
            None            => Ok(self.alloc.Vec<str>()),
            Ok(TextList(v)) => Ok(v),
            Ok(EmptyList)   => Ok(self.alloc.Vec<str>()),
            Ok(_)           => Err(self.misplaced(r, name)),
        })
    }

    optional_path_field = (self :: @Self, r: Record, name: str) Res<Res<Path>, PlanError> {
        self.optional(r, name).try().match({
            None                  => Ok(None),
            Ok(PathOption(value)) => Ok(value),
            Ok(PathValue(value))  => Ok(Ok(value)),
            Ok(_)                 => Err(self.misplaced(r, name)),
        })
    }

    optional_text_field = (self :: @Self, r: Record, name: str, fallback: str)
                          Res<str, PlanError> {
        self.optional(r, name).try().match({
            None                 => Ok(fallback),
            Ok(TextValue(value)) => Ok(value),
            Ok(_)                => Err(self.misplaced(r, name)),
        })
    }

    optional_bool_field = (self :: @Self, r: Record, name: str, fallback: bool)
                          Res<bool, PlanError> {
        self.optional(r, name).try().match({
            None                 => Ok(fallback),
            Ok(BoolValue(value)) => Ok(value),
            Ok(_)                => Err(self.misplaced(r, name)),
        })
    }

    // A bare `Ok` is `Ok(())`, unless build.zen binds the name itself.
    named = (self: @Self, name: str, at: Span) Res<Value, PlanError> {
        (name.eq("Ok") && !self.has_local(name)).match({
            true  => Ok(Value.UnitValue),
            false => self.local(name, at),
        })
    }

    local = (self: @Self, name: str, at: Span) Res<Value, PlanError> {
        self.locals.find((l) { l.name.eq(name) }).match({
            Ok(l) => Ok(l.value),
            None  => Err(refused(PlanFault.UnknownName(at))),
        })
    }

    has_local = (self: @Self, name: str) bool {
        self.locals.find((l) { l.name.eq(name) }).match({
            Ok(_) => true,
            None  => false,
        })
    }

    local_index = (self: @Self, name: str) Res<usize> {
        Range(0, self.locals.len).find((i) {
            self.locals.get(i).match({
                Ok(local) => local.name.eq(name),
                None      => false,
            })
        })
    }
}

plan* = (a: Alloc, tree: Ast, check: Checker, target: Target, mode: Mode)
        Res<BuildPlan, PlanError> {
    (check.diag_count() > 0).match({
        true  => Err(refused(PlanFault.CheckedFaults)),
        false => tree.build_function().match({
            Err(e) => Err(e),
            Ok(f)  => plan_function(a, tree, check, target, mode, f),
        }),
    })
}

plan_function = (
    a      : Alloc,
    tree   : Ast,
    check  : Checker,
    target : Target,
    mode   : Mode,
    f      : Function
) Res<BuildPlan, PlanError> {
    f.body.match({
        None     => Err(refused(PlanFault.MissingBuild("body"))),
        Ok(body) => f.params.get(0).match({
            None  => Err(refused(PlanFault.MissingBuild("builder parameter"))),
            Ok(p) => execute_function(
                a,
                tree,
                check,
                target,
                mode,
                p.name.text,
                tree.block_at(body)
            ),
        }),
    })
}

execute_function = (
    a       : Alloc,
    tree    : Ast,
    check   : Checker,
    target  : Target,
    mode    : Mode,
    builder : str,
    body    : Block
) Res<BuildPlan, PlanError> {
    ex ::= Executor(
        alloc: a,
        tree: tree,
        check: check,
        builder: builder,
        mode: mode,
        locals: a.Vec<Local>(),
        plan: BuildPlan(
            target: target,
            imports: a.Vec<CImportNode>(),
            libs: a.Vec<LibNode>(),
            packages: a.Vec<PackageNode>(),
            externs: a.Vec<ExternNode>(),
            exes: a.Vec<ExeNode>(),
            tests: a.Vec<ExeNode>()
        )
    );
    ex.block(body).try();
    Ok(ex.plan)
}

// The first `build` function declared in any module of the tree.
build_function = (tree: Ast) Res<Function, PlanError> {
    Range(0, tree.module_count()).find((i) {
        tree.module_at(i).match({
            None  => false,
            Ok(m) => m.build_in().match({ Ok(_) => true, None => false }),
        })
    }).match({
        None  => Err(refused(PlanFault.MissingBuild("function"))),
        Ok(i) => tree.module_at(i).match({
            None  => Err(refused(PlanFault.MissingBuild("module"))),
            Ok(m) => m.build_in().ok_or(refused(PlanFault.MissingBuild(
                "function"
            ))),
        }),
    })
}

build_in = (m: Module) Res<Function> {
    m.decls.find((d) {
        d.kind.match({ Function(f) => f.name.text.eq("build"), _ => false })
    }).match({
        None  => None,
        Ok(d) => d.kind.match({ Function(f) => Ok(f), _ => None }),
    })
}
