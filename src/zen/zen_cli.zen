// The `zen` command line. `Line` is its commands and each command's struct is
// that command's arguments: std.cli parses argv, refuses a bad command line
// with that command's help and answers `zen help <command>`, all from these
// types and their Cli tables. What the words mean for a build -- a project or
// emitted source, a directory or a target -- is decided here. argv and option
// values stay borrowed. `--repeat` and `--permute` are hidden determinism
// controls (tests/determinism/README.md).

{ Alloc, AllocError } = std.mem
{ str, String } = std.text
{ Vec } = std.collections
{ Env } = std.env
{ BuildArgs, ProjectArgs, Emission, Codegen, Mode, Permutation } = std.build
{ Cli, Spec, Stop, outcome } = std.cli
{ holds_build_zen } = zen.zen_path
{ Res, Ok, Err, None } = std.core

VERSION*: str = "0.1.0"

// What a command line asks zen to do.
Job* = { Build: BuildArgs
    | Project: ProjectArgs
    | Run: ProjectArgs
    | Test: ProjectArgs
    | Fmt: FmtJob
    | Init: str
    | Lsp: LspJob
    | Help: String
    | Refused: Refusal }

// A refused command line: what was wrong, and the help of the command it
// addressed. An empty message means no command was given at all.
Refusal* = {
    message*: String,
    help*: String,
}

// `zen fmt` takes files; zen_fmt validates that they are not directories.
FmtJob* = {
    paths*: Vec<str>,
    // Report without writing.
    check*: bool,
}

// `zen lsp` serves stdin and stdout, or one request file into one reply file.
LspJob* = {
    requests*: Res<str>,
    replies*: Res<str>,
}

ENVIRONMENT: str = "Environment:\n  ZEN_STD           Standard library root; default: src/ beside the zen executable\n  CC, CFLAGS        C compiler and extra flags for native targets\n  ZEN_BUILD_DIR     Directory for generated files; default: build\n  ZEN_BUILD_OUTPUT  Executable path for the one selected target\n  ZEN_SYMBOL_MAP    Also write the generated symbol map to this path\n\nRun `zen help <COMMAND>` for a command's options."

PROJECT_NOTE: str = "A word naming a directory that holds build.zen selects that project;\nany other word names a target declared by ./build.zen."

Line = { Build: BuildLine
    | Run: RunLine
    | Test: TestLine
    | Check: CheckLine
    | Fmt: FmtLine
    | Init: InitLine
    | Lsp: LspLine }

Line.impl(Cli, {
    name: "zen",
    about: "The Zen compiler and project tool",
    version: VERSION,
    note: ENVIRONMENT,
})

// The profile and toolchain options build, run and test share.
RELEASE: Spec = Spec(help: "Build optimized: the same as --mode release")
MODE: Spec = Spec(
    help: "Build mode, which build.zen reads with b.mode(); debug when not given"
)
VERBOSE: Spec = Spec(short: 'v', help: "Print each phase, command and timing")
CC: Spec = Spec(env: "CC", help: "C compiler: clang, gcc, tcc or a path")

BuildLine = {
    project: Res<str>,
    release :: bool = false,
    mode :: Res<Mode>,
    verbose :: bool = false,
    cc :: Res<str>,
    target :: Res<str>,
    emit_c :: bool = false,
    emit_c_dir :: Res<str>,
    output :: Res<str>,
    backend :: Res<Codegen>,
    entry :: Res<str>,
    std :: Res<str>,
    ffi :: bool = false,
    symbol_map :: Res<str>,
    repeat :: Res<usize>,
    permute :: Res<Permutation>,
}

BuildLine.impl(Cli, {
    about: "Build project targets, or emit source from a root",
    note: PROJECT_NOTE,
    project: Spec(
        help: "Target name or project directory; with --emit-c, -o or --backend, a source root"
    ),
    release: RELEASE,
    mode: MODE,
    verbose: VERBOSE,
    cc: CC,
    target: Spec(
        value: "TRIPLE",
        help: "Platform to build for, such as x86_64-linux or arm64-darwin; js-browser with --backend js"
    ),
    emit_c: Spec(help: "Emit C to standard output, or to -o"),
    emit_c_dir: Spec(value: "DIR", help: "Emit one C file per module"),
    output: Spec(
        short: 'o',
        value: "FILE",
        help: "Write generated source to FILE"
    ),
    backend: Spec(value: "NAME", help: "Generator for emitted source"),
    entry: Spec(value: "FILE", help: "Entry file inside the root"),
    std: Spec(value: "PATH", help: "Standard library root"),
    ffi: Spec(help: "Allow foreign-function bindings"),
    symbol_map: Spec(value: "FILE", help: "Write the generated symbol map"),
    repeat: Spec(hidden: true),
    permute: Spec(hidden: true),
})

RunLine = {
    target: Res<str>,
    release :: bool = false,
    mode :: Res<Mode>,
    verbose :: bool = false,
    cc :: Res<str>,
    args :: Vec<str>,
}

RunLine.impl(Cli, {
    about: "Build and run an executable target",
    note: "Words after `--` are passed to the program.",
    target: Spec(
        help: "Executable target, or a project directory; needed when build.zen declares several"
    ),
    release: RELEASE,
    mode: MODE,
    verbose: VERBOSE,
    cc: CC,
    args: Spec(trailing: true),
})

TestLine = {
    project: Res<str>,
    target: Res<str>,
    release :: bool = false,
    mode :: Res<Mode>,
    verbose :: bool = false,
    cc :: Res<str>,
    args :: Vec<str>,
}

TestLine.impl(Cli, {
    about: "Build and run executable test targets",
    note: "Every test target builds before any runs. Words after `--` are passed\nto each test program.",
    project: Spec(help: "Test target, or a project directory"),
    target: Spec(help: "Test target within that project"),
    release: RELEASE,
    mode: MODE,
    verbose: VERBOSE,
    cc: CC,
    args: Spec(trailing: true),
})

CheckLine = {
    root: str,
    entry :: Res<str>,
    std :: Res<str>,
    ffi :: bool = false,
}

CheckLine.impl(Cli, {
    about: "Check source without generating artifacts",
    root: Spec(help: "Compilation root directory"),
    entry: Spec(value: "FILE", help: "Entry file inside the root"),
    std: Spec(value: "PATH", help: "Standard library root"),
    ffi: Spec(help: "Allow foreign-function bindings"),
})

FmtLine = {
    check :: bool = false,
    files: Vec<str>,
}

FmtLine.impl(Cli, {
    about: "Format Zen source files",
    check: Spec(help: "Report files that would change; write nothing"),
    files: Spec(value: "FILE", help: "Zen source file"),
})

InitLine = { dir: Res<str> }

InitLine.impl(Cli, {
    about: "Create a project: build.zen, src/main.zen and .gitignore",
    note: "Existing files are never overwritten.",
    dir: Spec(help: "Project directory, created when missing [default: .]"),
})

LspLine = {
    stdio :: bool = false,
    requests: Res<str>,
    replies: Res<str>,
}

LspLine.impl(Cli, {
    about: "Run the language server",
    stdio: Spec(help: "Serve stdin and stdout (the default)"),
    requests: Spec(help: "Request file; omit to serve stdin"),
    replies: Spec(help: "Reply file, required with REQUESTS"),
})

// The one place `Line` is parsed, so its parser is written once.
parsed = (env: Env, a: Alloc, argv: Vec<str>) Res<Line, Stop> {
    outcome<Line>(env, a, argv)
}

cli* = (env: Env, a: Alloc, argv: Vec<str>) Res<Job, AllocError> {
    parsed(env, a, argv).match({
        Err(stop) => stop.match({
            Help(text)       => Ok(Job.Help(text)),
            Refused(refusal) => Ok(Job.Refused(Refusal(
                message: refusal.message,
                help: refusal.help
            ))),
            Failed(e)        => Err(e),
        }),
        Ok(line)  => line.match({
            Build(b) => build_job(env, a, argv, b),
            Run(r)   => Chosen(command: "run", words: words(a, r.target, None).try(), release: r.release, mode: r.mode, verbose: r.verbose, cc: r.cc, args_at: argv.len - r.args.len).project(env, a, argv, (job) { Job.Run(job) }),
            Test(t)  => Chosen(command: "test", words: words(a, t.project, t.target).try(), release: t.release, mode: t.mode, verbose: t.verbose, cc: t.cc, args_at: argv.len - t.args.len).project(env, a, argv, (job) { Job.Test(job) }),
            Check(c) => Ok(Job.Build(BuildArgs(
                root: c.root,
                entry: c.entry.value_or(""),
                std_root: c.std.value_or(""),
                ffi: c.ffi
            ))),
            Fmt(f)   => Ok(Job.Fmt(FmtJob(paths: f.files, check: f.check))),
            Init(i)  => Ok(Job.Init(i.dir.value_or("."))),
            Lsp(l)   => {
                paired = l.requests.match({ Ok(_) => true, None => false })
                    == l.replies.match({ Ok(_) => true, None => false });
                paired.match({
                    true  => Ok(Job.Lsp(LspJob(
                        requests: l.requests,
                        replies: l.replies
                    ))),
                    false => refused(
                        env,
                        a,
                        "lsp",
                        a.String("a request file needs a reply file").try()
                    ),
                })
            },
        }),
    })
}

// The help text of `zen` itself (an empty name) or of one command.
help* = (env: Env, a: Alloc, name: str) Res<String, AllocError> {
    argv ::= a.Vec<str>();
    argv.add("zen").try();
    name.is_empty().match({
        true  => argv.add("-h").try(),
        false => { argv.add("help").try(); argv.add(name).try(); },
    });
    parsed(env, a, argv).match({
        Err(Help(text))       => Ok(text),
        Err(Refused(refusal)) => Ok(refusal.help),
        Err(Failed(e))        => Err(e),
        Ok(_)                 => a.String(),
    })
}

// A command line the types accepted and zen still refuses.
refused = (
    env     : Env,
    a       : Alloc,
    command : str,
    message : String
) Res<Job, AllocError> {
    Ok(Job.Refused(Refusal(
        message: message,
        help: help(env, a, command).try()
    )))
}

// `--release` and `--mode` both say which mode to build in.
conflict = (release: bool, mode: Res<Mode>) bool {
    release && mode.match({ Ok(_) => true, None => false })
}

released = (env: Env, a: Alloc, command: str) Res<Job, AllocError> {
    refused(
        env,
        a,
        command,
        a.String("argument `--release` cannot be used with `--mode`").try()
    )
}

// Whether a word of argv spells `--cc`: a C compiler from the environment
// does not count, and the command line's own one does.
written_cc = (argv: Vec<str>) bool {
    argv.find(
        (w) { w.eq("--cc") || w.starts_with("--cc=") }
    ).match({ Ok(_) => true, None => false })
}

given = (r: Res<str>) bool { r.match({ Ok(_) => true, None => false }) }

build_job = (
    env  : Env,
    a    : Alloc,
    argv : Vec<str>,
    b    : BuildLine
) Res<Job, AllocError> {
    // Any source-emission option selects the compilation-root interface;
    // otherwise the build starts at build.zen.
    source = b.emit_c || given(b.emit_c_dir) || given(b.output) || given(b.entry)
        || given(b.symbol_map) || b.ffi
        || b.backend.match({ Ok(_) => true, None => false })
        || b.repeat.match({ Ok(_) => true, None => false })
        || b.permute.match({ Ok(_) => true, None => false });
    conflict(b.release, b.mode).match({
        true  => released(env, a, "build"),
        false => source.match({
            true  => source_job(env, a, argv, b),
            false => Chosen(command: "build", words: words(a, b.project, None).try(), release: b.release, mode: b.mode, verbose: b.verbose, cc: b.cc, triple: b.target, std_root: b.std.value_or(""), args_at: argv.len).project(env, a, argv, (job) { Job.Project(job) }),
        }),
    })
}

source_job = (
    env  : Env,
    a    : Alloc,
    argv : Vec<str>,
    b    : BuildLine
) Res<Job, AllocError> {
    root          = b.project.value_or("");
    selected      = b.emit_c || b.emit_c_dir.match({ Ok(_) => true, None => false })
        || b.backend.match({ Ok(_) => true, None => false });
    profiled: str = b.release.match({
        true  => "--release",
        false => b.mode.match({
            Ok(_) => "--mode",
            None  => b.verbose.match({
                true  => "--verbose",
                false => written_cc(
                    argv
                ).match({ true => "--cc", false => "" }),
            }),
        }),
    });
    emission      = b.emit_c_dir.match({
        Ok(dir) => Emission.Directory(dir),
        None    => b.output.match({ Ok(file) => Emission.File(
            file
        ), None => Emission.Stdout }),
    });
    root.is_empty().match({
        true  => refused(
            env,
            a,
            "build",
            a.String("`zen build` needs a source root to emit from").try()
        ),
        false => selected.match({
            false => refused(
                env,
                a,
                "build",
                a.String(
                    "`--emit-c` is required: a source build without `--emit-c` or `--backend` writes nothing"
                ).try()
            ),
            true  => profiled.is_empty().match({
                false => refused(
                    env,
                    a,
                    "build",
                    a.String(
                        "`{}` applies to project builds, not to emitted source",
                        profiled
                    ).try()
                ),
                true  => Ok(Job.Build(BuildArgs(
                    root: root,
                    emission: emission,
                    backend: b.backend.value_or(Codegen.C),
                    entry: b.entry.value_or(""),
                    std_root: b.std.value_or(""),
                    symbol_map: b.symbol_map.value_or(""),
                    ffi: b.ffi,
                    repeat: b.repeat.match({ Ok(n) => (n == 0).match({ true => 1, false => n }), None => 1 }),
                    permute: b.permute.value_or(Permutation.Natural),
                    target: b.target.value_or("")
                ))),
            }),
        }),
    })
}

// A project command's positional words, in order.
words = (
    a      : Alloc,
    first  : Res<str>,
    second : Res<str>
) Res<Vec<str>, AllocError> {
    out ::= a.Vec<str>();
    first.when_ok((w) { out.add(w).try(); });
    second.when_ok((w) { out.add(w).try(); });
    Ok(out)
}

// A project command's first word: a directory holding build.zen is the
// project, and anything else is a target of ./build.zen.
Place = { root: str, target: str }

place = (env: Env, a: Alloc, word: str) Place {
    holds_build_zen(env, a, word).match({
        true  => Place(root: word, target: ""),
        false => Place(root: ".", target: word),
    })
}

// What a project command chose, before its words are placed.
Chosen = {
    command: str,
    words: Vec<str>,
    release: bool,
    mode: Res<Mode>,
    verbose: bool,
    cc: Res<str>,
    triple :: Res<str> = None,
    std_root :: str = "",
    // The first word after `--`, or the end of argv.
    args_at: usize,

    // The first word is a project directory or a target; a second word is a
    // target within the project the first one named.
    project = (
        self : @Self,
        env  : Env,
        a    : Alloc,
        argv : Vec<str>,
        made : (job: ProjectArgs) Job
    ) Res<Job, AllocError> {
        first  = self.words.get(0).value_or("");
        second = self.words.get(1);
        placed = (first.is_empty()).match({ true => Place(root: ".", target: ""), false => place(env, a, first) });
        target = second.match({ Ok(word) => word, None => placed.target });
        stray  = second.match({ Ok(word) => !placed.target.is_empty(), None => false });
        conflict(self.release, self.mode).match({
            true  => released(env, a, self.command),
            false => stray.match({
                true  => refused(
                    env,
                    a,
                    self.command,
                    a.String(
                        "unexpected argument `{}` for `zen {}`: `{}` is not a project directory",
                        second.value_or(""),
                        self.command,
                        first
                    ).try()
                ),
                false => Ok(made(ProjectArgs(
                    root: placed.root,
                    target: target,
                    std_root: self.std_root,
                    argv: argv,
                    args_at: self.args_at,
                    mode: self.release.match({ true => Mode.Release, false => self.mode.value_or(
                        Mode.Debug
                    ) }),
                    verbose: self.verbose,
                    cc: self.cc,
                    triple: self.triple
                ))),
            }),
        })
    }
}
