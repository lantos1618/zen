// Rewrites a program to read `Res` by the Error bound. It exists for that one
// migration and is removed with it.
//
// ZEN_MIGRATE_RES=impls adds `T.impl(Error, {})` beside each type a `Res`
// fails with: the second argument of a `Res<V, R>`, or what `Err(..)` holds.
// ZEN_MIGRATE_RES=forms, run once those impls are in, writes `Res<(), R>` as
// `Res<R>` where R implements Error, `Ok(())` as `Ok`, drops a final `Ok(())`
// a unit body no longer needs, and writes a `{ e; Ok(()) }` arm as `e`.
// ZEN_MIGRATE_SKIP names top-level modules, comma-separated, whose files are
// read but never written: the compiler's own, when a test is migrated.
{ Alloc, AllocError } = std.mem
{ str, String } = std.text
{ Vec } = std.collections
{ Res, Ok, Err, None, Range, loop } = std.core
{ Env } = std.env
{ println } = std.io
{ Ast, Module, Decl, Block, Stmt, Arm, ExprId, TypeId, BlockId, Span, Pos } = std.ast
{ WalkVisitor, WalkEvent, WalkNode, DeclVisit, DeclSite, DeclParent } = std.ast
{ walk } = std.ast
{ scan, Source } = std.lex
{ Parser, module } = std.parse
{ Checker } = sema.sema_check
{ TyId, TyNamed } = sema.sema_ty
{ implements_error } = sema.sema_bound
{ Src } = fmt.fmt_src

// One replacement: `len` bytes at `at` become `text`.
Edit = {
    at: usize,
    len: usize,
    text: str,
}

// A failure type found in module `mi`.
Failure = {
    ty: TyId,
    mi: usize,
}

Counts = {
    impls :: usize = 0,
    res_unit :: usize = 0,
    ok_unit :: usize = 0,
    trailing :: usize = 0,
    arms :: usize = 0,
}

// One module's walk. `src` is the module's text when its forms are being
// rewritten, and `dropped` the `Ok(())` calls an earlier edit already
// removes with their statement or arm.
Scan = {
    c :: Checker,
    a: Alloc,
    mi: usize,
    forms: bool,
    src: Src,
    failures :: Vec<Failure>,
    edits :: Vec<Edit>,
    dropped :: Vec<ExprId>,
    counts :: Counts,
}

Scan.impl(WalkVisitor, {
    visit = (self :: @Self, event: WalkEvent) Res<(), AllocError> {
        event.match({
            Enter(node) => node.match({
                Type(id)        => self.written_type(id),
                Expr(id)        => self.expression(id),
                Declaration(dv) => dv.value.kind.match({
                    Function(f) => self.function(f.ret, f.body),
                    _           => Ok(()),
                }),
                Member(mv)      => mv.value.kind.match({
                    Function(f) => self.function(f.ret, f.body),
                    _           => Ok(()),
                }),
                _               => Ok(()),
            }),
            Leave(_)    => Ok(()),
        })
    }
})

// `Res<V, R>`: R is a failure; written `Res<(), R>` with R an Error, the
// unit success goes.
written_type = (s :: Scan, id: TypeId) Res<(), AllocError> {
    t = s.c.tree.type_at(id);
    t.kind.match({
        Named(n) => (n.name.text.eq("Res") && n.args.len == 2).match({
            false => Ok(()),
            true  => s.c.type_memo.get(id).match({
                None     => Ok(()),
                Ok(ty)   => s.c.type_store().at(ty).match({
                    Res(r) => s.failure_res(n.args, r.error),
                    _      => Ok(()),
                }),
            }),
        }),
        _        => Ok(()),
    })
}

failure_res = (s :: Scan, args: Vec<TypeId>, error: TyId)
              Res<(), AllocError> {
    s.failures.add(Failure(ty: error, mi: s.mi)).try();
    first  = args.get(0).ok_or(AllocError.OutOfMemory).try();
    second = args.get(1).ok_or(AllocError.OutOfMemory).try();
    unit   = s.c.tree.type_at(first).kind.match({ Unit => true, _ => false });
    (s.forms && unit).match({
        false => Ok(()),
        true  => s.c.implements_error(error, s.mi).try().match({
            false => Ok(()),
            true  => {
                s.counts.res_unit = s.counts.res_unit + 1;
                s.cut(
                    s.c.tree.type_at(first).span,
                    s.c.tree.type_at(second).span
                )
            },
        }),
    })
}

// Removes the text from the start of `from` to the start of `to`.
cut = (s :: Scan, from: Span, to: Span) Res<(), AllocError> {
    at = s.src.offset(from.start);
    s.edits.add(Edit(at: at, len: s.src.offset(to.start) - at, text: ""))
}

// Removes the text from the end of `from` to the end of `to`.
cut_after = (s :: Scan, from: Span, to: Span) Res<(), AllocError> {
    at = s.src.offset(from.end);
    s.edits.add(Edit(at: at, len: s.src.offset(to.end) - at, text: ""))
}

expression = (s :: Scan, id: ExprId) Res<(), AllocError> {
    e = s.c.tree.expr_at(id);
    e.kind.match({
        Call(call) => {
            s.called(call.callee, "Err").then(() {
                call.args.get(0).match({
                    None    => (),
                    Ok(arg) => s.c.expr_memo.get(arg.value).match({
                        None     => (),
                        Ok(ty)   => s.failures.add(
                            Failure(ty: ty, mi: s.mi)
                        ).try(),
                    }),
                });
            });
            (s.forms && s.ok_unit(id)
                && s.dropped.find((d) { d.index == id.index }).match({
                    Ok(_) => false,
                    None  => true,
                })).match({
                false => Ok(()),
                true  => {
                    s.counts.ok_unit = s.counts.ok_unit + 1;
                    s.cut_after(s.c.tree.expr_at(call.callee).span, e.span)
                },
            })
        },
        Match(m)   => s.forms.match({
            false => Ok(()),
            true  => s.unit_arms(id, m.arms),
        }),
        Lambda(l)  => s.forms.match({
            false => Ok(()),
            true  => s.function(l.ret, Ok(l.body)),
        }),
        _          => Ok(()),
    })
}

called = (s: Scan, callee: ExprId, name: str) bool {
    s.c.tree.expr_at(callee).kind.match({
        Name(n) => n.text.eq(name),
        _       => false,
    })
}

// `Ok(())`, written with its unit.
ok_unit = (s: Scan, id: ExprId) bool {
    s.c.tree.expr_at(id).kind.match({
        Call(call) => s.called(call.callee, "Ok") && call.targs.len == 0
            && call.args.len == 1 && call.args.get(0).match({
                None    => false,
                Ok(arg) => arg.name.match({ Ok(_) => false, None => true })
                    && s.c.tree.expr_at(arg.value).kind.match({
                        Unit => true,
                        _    => false,
                    }),
            }),
        _          => false,
    })
}

// A Res whose success is `()`.
unit_res = (s: Scan, ty: TyId) bool {
    s.c.type_store().at(ty).match({
        Res(r) => s.c.prim_name(r.value).eq("()"),
        _      => false,
    })
}

unit_expr = (s: Scan, id: ExprId) bool {
    s.c.expr_memo.get(id).match({
        None     => false,
        Ok(ty)   => s.c.prim_name(ty).eq("()"),
    })
}

commented = (s: Scan, from: Pos, to: Pos) bool {
    s.src.text.slice(s.src.offset(from), s.src.offset(to)).contains("//")
}

// A body returning a unit Res that ends `stmt; Ok(())` ends in `stmt`.
function = (s :: Scan, ret: Res<TypeId>, body: Res<BlockId>)
           Res<(), AllocError> {
    unit = ret.match({
        None    => false,
        Ok(t)   => s.c.type_memo.get(t).match({
            None     => false,
            Ok(ty)   => s.unit_res(ty),
        }),
    });
    (s.forms && unit).match({
        false => Ok(()),
        true  => body.match({
            None      => Ok(()),
            Ok(bid)   => s.trailing_ok(s.c.tree.block_at(bid)),
        }),
    })
}

trailing_ok = (s :: Scan, blk: Block) Res<(), AllocError> {
    n = blk.stmts.len;
    blk.value.match({
        Ok(v) => (n >= 1 && s.ok_unit(v)).match({
            false => Ok(()),
            true  => s.drop_final(
                blk.stmts.get(n - 1).ok_or(AllocError.OutOfMemory).try(),
                v,
                s.c.tree.expr_at(v).span
            ),
        }),
        None  => (n >= 2).match({
            false => Ok(()),
            true  => {
                last = blk.stmts.get(n - 1).ok_or(AllocError.OutOfMemory).try();
                last.kind.match({
                    Expr(x) => s.ok_unit(x.expr).match({
                        false => Ok(()),
                        true  => s.drop_final(
                            blk.stmts.get(n - 2).ok_or(AllocError.OutOfMemory).try(),
                            x.expr,
                            last.span
                        ),
                    }),
                    _       => Ok(()),
                })
            },
        }),
    })
}

// Only after an expression statement of type `()`: a binding has no value
// to end on, and a statement of any other type would become the result.
drop_final = (s :: Scan, prev: Stmt, ok: ExprId, end: Span)
             Res<(), AllocError> {
    plain = prev.kind.match({
        Expr(x) => s.unit_expr(x.expr),
        _       => false,
    });
    (plain && !s.commented(prev.span.end, end.end)).match({
        false => Ok(()),
        true  => {
            s.dropped.add(ok).try();
            s.counts.trailing = s.counts.trailing + 1;
            s.cut_after(prev.span, end)
        },
    })
}

// In a match whose value is a unit Res, an arm `{ e; Ok(()) }` with `e` of
// type `()` is written `e`: a `()` arm is that Res's `Ok`. Only while some
// other arm still carries the Res, or the match would read as `()`.
unit_arms = (s :: Scan, id: ExprId, arms: Vec<Arm>) Res<(), AllocError> {
    res  = s.c.expr_memo.get(id).match({
        None     => false,
        Ok(ty)   => s.unit_res(ty),
    });
    kept = arms.find((arm) {
        s.arm_unit(arm.body).match({ Ok(_) => false, None => true })
            && s.c.expr_memo.get(arm.body).match({
                None     => false,
                Ok(ty)   => s.unit_res(ty),
            })
    }).match({ Ok(_) => true, None => false });
    (res && kept).match({
        false => Ok(()),
        true  => {
            arms.loop((h, arm) {
                s.arm_unit(arm.body).match({
                    None        => (),
                    Ok(inner)   => s.unwrap_arm(arm.body, inner).try(),
                });
            });
            Ok(())
        },
    })
}

unwrap_arm = (s :: Scan, body: ExprId, inner: ExprId) Res<(), AllocError> {
    whole = s.c.tree.expr_at(body).span;
    kept  = s.c.tree.expr_at(inner).span;
    s.c.tree.expr_at(body).kind.match({
        Block(bid) => s.arm_ok(s.c.tree.block_at(bid)).match({
            Ok(ok) => s.dropped.add(ok).try(),
            None   => (),
        }),
        _          => (),
    });
    s.counts.arms = s.counts.arms + 1;
    s.cut(whole, kept).try();
    s.cut_after(kept, whole)
}

// `e` of a `{ e; Ok(()) }` arm body whose `e` is `()`.
arm_unit = (s: Scan, body: ExprId) Res<ExprId> {
    s.c.tree.expr_at(body).kind.match({
        Block(bid) => s.block_unit(s.c.tree.block_at(bid)),
        _          => None,
    })
}

block_unit = (s: Scan, blk: Block) Res<ExprId> {
    s.arm_ok(blk).match({
        None  => None,
        Ok(_) => blk.stmts.get(0).match({
            None     => None,
            Ok(st)   => st.kind.match({
                Expr(x) => (s.unit_expr(x.expr)
                    && !s.commented(blk.span.start, blk.span.end)).match({
                    true  => Ok(x.expr),
                    false => None,
                }),
                _       => None,
            }),
        }),
    })
}

// The final `Ok(())` of a `{ e; Ok(()) }` block, with or without its `;`.
arm_ok = (s: Scan, blk: Block) Res<ExprId> {
    blk.value.match({
        Ok(v) => (blk.stmts.len == 1 && s.ok_unit(v)).match({
            true  => Ok(v),
            false => None,
        }),
        None  => (blk.stmts.len == 2).match({
            false => None,
            true  => blk.stmts.get(1).match({
                None     => None,
                Ok(st)   => st.kind.match({
                    Expr(x) => s.ok_unit(x.expr).match({
                        true  => Ok(x.expr),
                        false => None,
                    }),
                    _       => None,
                }),
            }),
        }),
    })
}

// Edits are applied in offset order; one that overlaps an earlier edit is
// dropped, and an exact repeat is applied once.
apply = (a: Alloc, text: str, edits: Vec<Edit>) Res<String, AllocError> {
    out       ::= a.String().try();
    used      ::= a.Vec<bool>();
    edits.loop((h, ed) { used.add(false).try(); });
    at :: usize = 0;
    Range(0, edits.len).loop((h, round) {
        best :: usize = edits.len;
        Range(0, edits.len).loop((h2, i) {
            (!used.get(i).value_or(true)).then(() {
                (best == edits.len
                    || edits.get(i).ok_or(AllocError.OutOfMemory).try().at
                        < edits.get(best).ok_or(AllocError.OutOfMemory).try().at)
                    .then(() { best = i; });
            });
        });
        (best < edits.len).then(() {
            used.set(best, true).ok_or(AllocError.OutOfMemory).try();
            ed = edits.get(best).ok_or(AllocError.OutOfMemory).try();
            (ed.at >= at).match({
                false => println(
                    "migrate-res: an edit at byte {} overlaps another; skipped",
                    ed.at
                ),
                true  => {
                    out.add(text.slice(at, ed.at)).try();
                    out.add(ed.text).try();
                    at = ed.at + ed.len;
                },
            });
        });
    });
    out.add(text.slice(at, text.len)).try();
    Ok(out)
}

// The rewritten file parses without a diagnostic.
parses = (a: Alloc, file: str, text: str) Res<bool, AllocError> {
    lexed = scan(a, Source(file: file, text: text)).try();
    p ::= a.Parser(lexed);
    p.module(file).try();
    Ok(lexed.is_clean() && p.diags.len == 0)
}

rewrite = (env: Env, a: Alloc, path: str, text: str, edits: Vec<Edit>)
          Res<(), AllocError> {
    (edits.len == 0).match({
        true  => Ok(()),
        false => {
            out = apply(a, text, edits).try();
            parses(a, path, out.view()).try().match({
                false => println(
                    "migrate-res: {} does not parse after rewriting; left unchanged",
                    path
                ),
                true  => env.fs.write(path, out.view()).match({
                    Ok(_)  => println("migrate-res: rewrote {}", path),
                    Err(_) => println("migrate-res: cannot write {}", path),
                }),
            });
            Ok(())
        },
    })
}

// Span files are relative to their root: `std/..` to the stdlib's parent,
// everything else to the build root.
migrate_res* = (
    env      : Env,
    a        : Alloc,
    c        :: Checker,
    root     : str,
    std_root : str,
    mode     : str
) Res<(), AllocError> {
    skip   = env.var("ZEN_MIGRATE_SKIP").match({ Ok(v) => v, None => "" });
    forms  = mode.eq("forms");
    counts ::= Counts();
    found  ::= a.Vec<Failure>();
    Range(0, c.tree.module_count()).loop((h, mi) {
        c.tree.module_at(mi).match({
            None    => (),
            Ok(m)   => c.tree.module_origin_at(mi).match({
                Ok(origin) => origin.match({
                    Source => {
                        file = m.span.file;
                        path ::= a.String().try();
                        path.fmt("{}/{}", base_of(file, root, std_root), file).try();
                        text = forms.match({
                            false => "",
                            true  => skipped(file, skip).match({
                                true  => "",
                                false => env.fs.read(a, path.view()).match({
                                    Ok(raw) => raw.view(),
                                    Err(_)  => "",
                                }),
                            }),
                        });
                        scan ::= Scan(
                            c: c,
                            a: a,
                            mi: mi,
                            forms: forms && text.len > 0,
                            src: a.Src(text).try(),
                            failures: found,
                            edits: a.Vec<Edit>(),
                            dropped: a.Vec<ExprId>(),
                            counts: counts
                        );
                        di :: usize = 0;
                        m.decls.loop((h2, d) {
                            c.tree.walk(a, WalkNode.Declaration(DeclVisit(
                                site: DeclSite(
                                    parent: DeclParent.Module(mi),
                                    index: di
                                ),
                                value: d
                            )), scan).try();
                            di = di + 1;
                        });
                        found  = scan.failures;
                        counts = scan.counts;
                        rewrite(env, a, path.view(), text, scan.edits).try();
                    },
                    _      => (),
                }),
                None       => (),
            }),
        });
    });
    forms.match({
        true  => (),
        false => {
            counts.impls = add_impls(env, a, c, root, std_root, skip, found)
                .try();
        },
    });
    println(
        "migrate-res: {} impls, {} Res<(), R>, {} Ok(()), {} trailing Ok, {} arms",
        counts.impls,
        counts.res_unit,
        counts.ok_unit,
        counts.trailing,
        counts.arms
    );
    Ok(())
}

base_of = (file: str, root: str, std_root: str) str {
    file.starts_with("std/").match({ true => std_root, false => root })
}

// Whether the file's first path segment is one of the comma-separated names.
skipped = (file: str, skip: str) bool {
    top = file.find("/").match({
        Ok(i) => file.slice(0, i),
        None  => file,
    });
    hit ::= false;
    skip.split(',').loop((name) { name.eq(top).then(() { hit = true; }); });
    hit
}

// Beside each named failure type that does not implement Error yet, once; a
// union's members each. Answers how many impls were written.
add_impls = (
    env      : Env,
    a        : Alloc,
    c        :: Checker,
    root     : str,
    std_root : str,
    skip     : str,
    found    : Vec<Failure>
) Res<usize, AllocError> {
    named ::= a.Vec<TyNamed>();
    found.loop((h, f) {
        set = c.set_of(f.ty);
        c.type_store().at(set).match({
            Union(u) => u.members.loop((h2, m) {
                c.needs_impl(m, f.mi, named).try();
            }),
            _        => c.needs_impl(set, f.mi, named).try(),
        });
    });
    added :: usize = 0;
    Range(0, c.tree.module_count()).loop((h, mi) {
        c.tree.module_at(mi).match({
            None    => (),
            Ok(m)   => {
                file = m.span.file;
                path ::= a.String().try();
                path.fmt("{}/{}", base_of(file, root, std_root), file).try();
                text = env.fs.read(a, path.view()).match({
                    Ok(raw) => raw.view(),
                    Err(_)  => "",
                });
                src    = a.Src(text).try();
                edits ::= a.Vec<Edit>();
                named.loop((h2, n) {
                    (n.decl.module.to_usize() == mi).then(() {
                        m.decls.get(n.decl.decl.to_usize()).match({
                            None    => (),
                            Ok(d)   => impl_beside(
                                a, m, d, file, skip, src, edits
                            ).try(),
                        });
                    });
                });
                added = added + edits.len;
                rewrite(env, a, path.view(), text, edits).try();
            },
        });
    });
    Ok(added)
}

needs_impl = (c :: Checker, ty: TyId, mi: usize, named :: Vec<TyNamed>)
             Res<(), AllocError> {
    c.type_store().at(ty).match({
        Named(n) => c.implements_error(ty, mi).try().match({
            true  => Ok(()),
            false => named.find((d) {
                d.decl.module == n.decl.module && d.decl.decl == n.decl.decl
            }).match({
                Ok(_) => Ok(()),
                None  => named.add(n),
            }),
        }),
        Var(_)   => Ok(()),
        _        => {
            println(
                "migrate-res: failure type {} cannot implement Error",
                c.type_store().key_at(ty)
            );
            Ok(())
        },
    })
}

impl_beside = (
    a     : Alloc,
    m     : Module,
    d     : Decl,
    file  : str,
    skip  : str,
    src   : Src,
    edits :: Vec<Edit>
) Res<(), AllocError> {
    name = d.kind.match({
        Struct(s) => s.name.text,
        Enum(e)   => e.name.text,
        _         => "",
    });
    local = m.decls.find((o) {
        o.kind.match({
            Struct(s) => s.name.text.eq("Error"),
            Enum(e)   => e.name.text.eq("Error"),
            Alias(al) => al.name.text.eq("Error"),
            _         => false,
        })
    }).match({ Ok(_) => true, None => false });
    (name.is_empty() || local || skipped(file, skip)).match({
        true  => {
            println(
                "migrate-res: {}:{} `{}` fails a Res and is left without Error",
                file,
                d.span.start.line,
                name
            );
            Ok(())
        },
        false => {
            line ::= a.String("\n{}.impl(Error, {{}})", name).try();
            edits.add(Edit(
                at: line_end(src.text, src.offset(d.span.end)),
                len: 0,
                text: line.view()
            ))
        },
    })
}

// The end of the line `at` is on, after any comment that trails it.
line_end = (text: str, at: usize) usize {
    end ::= at;
    loop(
        () { end < text.len && text.index(end) != '\n' },
        (h) { end = end + 1; }
    );
    end
}
