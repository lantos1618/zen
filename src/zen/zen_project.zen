// Project builds start at build.zen. This driver executes its checked target
// graph, compiles each selected Zen entry, links it, and optionally runs it.

{ Alloc, AllocError } = std.mem
{ str, String } = std.text
{ Res, Ok, Err, None, loop, Range, Path, join_path, Duration, Error } = std.core
{ Map, Vec } = std.collections

{ BuildArgs, ProjectArgs, Emission, Target, Os, Arch, Abi, Dep, Codegen } = std.build
{ Mode, Optimize, Cc, target_named } = std.build
{ Build, host_target } = zen.zen_build
{ asm_native, assemble_and_link } = zen.zen_native
{ entry_of, holds_build_zen, make_dirs, program_path } = zen.zen_path
{ Inputs, inputs, digest } = zen.zen_inputs
{ BuildPlan, ExeNode, LibNode, plan, PlanFault } = zen.zen_build_plan
{ resolve, PackageFault } = zen.zen_packages
{ Env } = std.env
{ println } = std.io

Action* = { Build | Run | Test }

// The flag dialect of a C compiler.
Family = { Clang | Gcc | Tcc }

// A resolved compiler executable and the SDK it compiles against.
Toolchain = { compiler: str, sysroot: str }

project* = (env: Env, a: Alloc, job: ProjectArgs, action: Action)
           Res<i32, AllocError> {
    holds_build_zen(env, a, job.root).match({
        false => { println("zen: no build.zen in `{}`", job.root); Ok(1) },
        true  => project_present(env, a, job, action),
    })
}

project_present = (env: Env, a: Alloc, job: ProjectArgs, action: Action)
                  Res<i32, AllocError> {
    trace = Trace(env: env, on: job.verbose, start: env.clock.since_start());
    trace.say("plan build.zen");
    build ::= a.Build(env, job.root);
    build.set_std_root(job.std_root);
    entry = entry_of(env, a, job.root, "build.zen").try();
    build.walk(entry).try();
    checked ::= build.checked().try();
    report  ::= a.String().try();
    checked.render_diags(report).try();
    (checked.diag_count() > 0).then(() { println("{}", report.view()); });
    host                  = host_target();
    platform: Res<Target> = job.triple.match({
        Ok(name) => target_named(name),
        None     => host,
    });
    code: Res<i32>        = loop<i32>((h) {
        (build.faults > 0 || checked.diag_count() > 0).then(() { h.break(1); });
        host.match({
            None  => { println("zen: cannot identify a supported native host"); h.break(1); },
            Ok(_) => (),
        });
        platform.match({
            None  => {
                println(
                    "zen: unknown target `{}`; known targets are x86_64-linux, aarch64-linux, arm64-darwin and x86_64-darwin",
                    job.triple.value_or("")
                );
                h.break(1);
            },
            Ok(_) => (),
        });
        target = platform.value_or(host.value_or(Target(
            os: Os.Linux,
            arch: Arch.X86_64,
            abi: Abi.Gnu
        )));
        cross  = !target.clang_triple().value_or("").eq(host.value_or(target).clang_triple().value_or(""));
        (cross && action.match({ Build => false, _ => true })).then(() {
            println(
                "zen: cannot run `{}` executables on this host; use `zen build --target`",
                target.clang_triple().value_or("")
            );
            h.break(1);
        });
        outcome = plan(a, build.tree, checked, target, job.mode);
        outcome.match({
            Err(Refused(why)) => { explain(why); h.break(1); },
            _                 => (),
        });
        planned  = outcome.map_err((e) { AllocError.OutOfMemory }).try();
        prepared = prepare_packages(env, a, job, planned, action).try();
        prepared.match({ None => h.break(1), Ok(_) => () });
        project = Project(
            env: env,
            a: a,
            job: job,
            planned: prepared.value_or(planned),
            host: host.value_or(target),
            trace: trace
        );
        h.break(project.execute(action).try());
    });
    Ok(code.value_or(1))
}

// Why build.zen could not be planned, at the source position when one is known.
explain = (why: PlanFault) {
    why.match({
        Unsupported(at)     => println(
            "zen: {}:{}:{}: build.zen cannot be planned: this expression is outside what the planner evaluates",
            at.file,
            at.start.line,
            at.start.col
        ),
        NulByte(at)         => println(
            "zen: {}:{}:{}: build.zen cannot be planned: a build string cannot hold a NUL byte; command arguments and paths end at one",
            at.file,
            at.start.line,
            at.start.col
        ),
        BadField(field)     => println(
            "zen: {}:{}:{}: field `{}` cannot be planned: write a value of its declared type that the planner evaluates",
            field.at.file,
            field.at.start.line,
            field.at.start.col,
            field.name
        ),
        UnknownField(field) => println(
            "zen: {}:{}:{}: an executable target has no field `{}`",
            field.at.file,
            field.at.start.line,
            field.at.start.col,
            field.name
        ),
        NoArm(at)           => println(
            "zen: {}:{}:{}: no arm of this match accepts the planned value",
            at.file,
            at.start.line,
            at.start.col
        ),
        MissingField(at)    => println(
            "zen: {}:{}:{}: a required field is missing",
            at.file,
            at.start.line,
            at.start.col
        ),
        UnknownName(at)     => println(
            "zen: {}:{}:{}: this name is not bound in build",
            at.file,
            at.start.line,
            at.start.col
        ),
        DuplicateTarget(n)  => println("zen: build.zen declares `{}` twice", n),
        MissingBuild(what)  => println(
            "zen: build.zen has no `build` {}",
            what
        ),
        CheckedFaults       => (),
    });
}

// `-v`: each phase and command on stderr, after the milliseconds since the
// project command began.
Trace = {
    env: Env,
    on: bool,
    start: Duration,

    say = (self: @Self, what: str) {
        self.on.then(() {
            now = self.env.clock.since_start();
            ms  = now.sub(
                self.start
            ).match({ Ok(d) => d.millis_of(), None => 0 });
            self.env.out.errorln("zen: {}ms {}", ms, what).ignore();
        });
    }

    // Each word is quoted as CC and CFLAGS read them, and as a POSIX shell
    // does, so the line shows where every argument begins and ends.
    command = (self: @Self, a: Alloc, argv: Vec<str>) Res<AllocError> {
        self.on.match({
            false => Ok,
            true  => {
                line ::= a.String().try();
                argv.loop((h, i, word) {
                    (i > 0).then(() { line.add(' ').try(); });
                    add_word(line, word).try();
                });
                self.say(line.view());
                Ok
            },
        })
    }
}

// A word of only unremarkable bytes is written bare. Any other is wrapped in
// single quotes, with each `'` in it written as `'\''`: close the quotes, an
// escaped quote, reopen.
add_word = (line :: String, word: str) Res<AllocError> {
    plain = word.len > 0 && Range(0, word.len).find((i) {
        b = word.index(i);
        !(b.is_alnum() || b.is_in([
            '_', '-', '.', '/', '=', ':', ',', '+', '@', '%'
        ]))
    }).match({ Ok(_) => false, None => true });
    plain.match({
        true  => line.add(word).try(),
        false => {
            line.add('\'').try();
            Range(0, word.len).loop((i) {
                b = word.index(i);
                (b == '\'').match({
                    true  => line.add("'\\''").try(),
                    false => line.add(b).try(),
                });
            });
            line.add('\'').try();
        },
    });
    Ok
}

// Resolve only dependencies of selected targets, before any compilation.
prepare_packages = (
    env     : Env,
    a       : Alloc,
    job     : ProjectArgs,
    planned : BuildPlan,
    action  : Action
)
                   Res<Res<BuildPlan>, AllocError> {
    ready ::= planned;
    targets = action.match({ Test => planned.tests, _ => planned.exes });
    failed ::= false;
    planned.packages.loop((h, node) {
        needed = targets.find((exe) {
            (job.target.is_empty() || exe.name.eq(job.target)) && exe.spec.deps.find((dep) {
                dep.name.eq(node.name)
            }).match({ Ok(_) => true, None => false })
        }).match({ Ok(_) => true, None => false });
        needed.then(() {
            resolve(env, a, job.root, node.spec).match({
                Err(error) => error.match({
                    OutOfMemory => Err(AllocError.OutOfMemory).try(),
                    _           => {
                    message = error.match({
                        InvalidSpec   => "requires an HTTPS/file URL, full lowercase commit ID and relative source paths",
                        DirtyCache    => "cached source is modified; restore or remove its build/packages directory",
                        CacheMismatch => "cache origin or commit differs from the manifest",
                        MissingSource => "source entry does not exist in the pinned commit",
                        Unavailable   => "Git or the package cache is unavailable or locked",
                        _             => "Git fetch/verification failed; check the URL, commit and network (remove an incomplete cache before retrying)",
                    });
                    println("zen: package `{}`: {}", node.name, message);
                    failed = true;
                    h.break();
                    },
                }),
                Ok(spec)   => ready.libs.add(LibNode(
                    name: node.name,
                    spec: spec,
                    dep: Dep(name: node.name)
                )).try(),
            });
        });
    });
    failed.match({ true => Ok(None), false => Ok(Ok(ready)) })
}

// An empty selection means `zen build` builds every executable. `zen run`
// requires one unambiguous target.
Unselected = { Unknown | Ambiguous | Empty }
Unselected.impl(Error, {})

select_exe = (planned: BuildPlan, named: str, execute: bool)
             Res<Res<ExeNode>, Unselected> {
    named.is_empty().match({
        false => planned.exes.find((exe) { exe.name.eq(named) }).match({
            None      => Err(Unselected.Unknown),
            Ok(found) => Ok(Ok(found)),
        }),
        true  => (execute && planned.exes.len != 1).match({
            true  => Err((planned.exes.len == 0).match({
                true  => Unselected.Empty,
                false => Unselected.Ambiguous,
            })),
            false => Ok(
                execute.match({ true => planned.exes.get(0), false => None })
            ),
        }),
    })
}

PreparedTest = { target: ExeNode, executable: String }

// One planned project: what every compile, link, and run step shares.
Project = {
    env: Env,
    a: Alloc,
    job: ProjectArgs,
    planned: BuildPlan,
    host: Target,
    trace: Trace,

    // Whether the planned platform is another than the host's.
    cross = (self: @Self) bool {
        !self.planned.target.clang_triple().value_or("").eq(self.host.clang_triple().value_or(""))
    }

    execute = (self: @Self, action: Action) Res<i32, AllocError> {
        overridden = self.env.var("ZEN_BUILD_OUTPUT").value_or("");
        ambiguous  = !overridden.is_empty() && self.job.target.is_empty() && self.planned.exes.len != 1;
        ambiguous.match({
            true  => { println("zen: ZEN_BUILD_OUTPUT requires one selected executable"); Ok(1) },
            false => self.execute_action(action),
        })
    }

    execute_action = (self: @Self, action: Action) Res<i32, AllocError> {
        action.match({
            Test => self.run_tests(),
            _    => self.execute_exes(action),
        })
    }

    execute_exes = (self: @Self, action: Action) Res<i32, AllocError> {
        run = action.match({ Run => true, _ => false });
        self.planned.select_exe(self.job.target, run).match({
            Err(why)     => {
                names ::= self.a.String().try();
                self.planned.exes.loop((h, i, exe) {
                    (i > 0).then(() { names.add(", ").try(); });
                    names.add(exe.name).try();
                });
                why.match({
                    Unknown   => println(
                        "zen: build.zen declares no executable target `{}`; its targets are: {}",
                        self.job.target,
                        names.view()
                    ),
                    Ambiguous => println(
                        "zen run: name the target to run; build.zen declares {}",
                        names.view()
                    ),
                    Empty     => println(
                        "zen run: build.zen declares no executable target"
                    ),
                });
                Ok(1)
            },
            Ok(selected) => run.match({
                true  => self.build_and_run(selected),
                false => self.build_selected(selected),
            }),
        })
    }

    run_tests = (self: @Self) Res<i32, AllocError> {
        selected = self.planned.tests.filter(self.a, (test) {
            self.job.target.is_empty() || test.name.eq(self.job.target)
        }).try();
        (selected.len == 0).match({
            true  => {
                println("zen test: no matching executable test targets");
                Ok(1)
            },
            false => self.prepare_tests(selected).try().match({
                None         => Ok(1),
                Ok(programs) => self.execute_tests(programs),
            }),
        })
    }

    // Complete compilation before any selected test executes. Each prepared
    // executable retains its target so failure cannot misalign parallel lists.
    prepare_tests = (self: @Self, selected: Vec<ExeNode>)
                    Res<Res<Vec<PreparedTest>>, AllocError> {
        programs ::= self.a.Vec<PreparedTest>();
        ready    ::= true;
        selected.loop((test) {
            output = self.output_path(test).try();
            programs.find(
                (previous) { previous.executable.view().eq(output.view()) }
            ).match({
                Ok(_) => {
                    println(
                        "zen test: selected targets share output `{}`",
                        output.view()
                    );
                    ready = false;
                },
                None  => self.build_exe(test).try().match({
                    None        => { ready = false; },
                    Ok(program) => programs.add(PreparedTest(
                        target: test,
                        executable: program
                    )).try(),
                }),
            });
        });
        Ok(ready.match({ true => Ok(programs), false => None }))
    }

    execute_tests = (self: @Self, programs: Vec<PreparedTest>)
                    Res<i32, AllocError> {
        failed :: usize = 0;
        programs.loop((test) {
            code = self.run_program(
                test.executable.view(),
                test.target.spec.backend
            ).try();
            (code == 0).match({
                true  => println("ok {}", test.target.name),
                false => {
                    failed = failed + 1;
                    println("not ok {} (exit {})", test.target.name, code);
                },
            });
        });
        println(
            "zen test: {} passed, {} failed",
            programs.len - failed,
            failed
        );
        Ok((failed == 0).match({ true => 0, false => 1 }))
    }

    build_selected = (self: @Self, selected: Res<ExeNode>)
                     Res<i32, AllocError> {
        code :: i32 = 0;
        self.planned.exes.loop((h, exe) {
            wanted = selected.match({
                None       => true,
                Ok(chosen) => chosen.name.eq(exe.name),
            });
            wanted.then(() {
                self.build_exe(exe).try().match({
                    None  => { code = 1; h.break(); },
                    Ok(_) => {},
                });
            });
        });
        (self.planned.exes.len == 0).then(() {
            println("zen: build.zen declared no executable target");
            code = 1;
        });
        Ok(code)
    }

    build_and_run = (self: @Self, selected: Res<ExeNode>)
                    Res<i32, AllocError> {
        selected.match({
            None       => Ok(1),
            Ok(target) => self.build_exe(target).try().match({
                None           => Ok(1),
                Ok(executable) => self.run_program(
                    executable.view(),
                    target.spec.backend
                ),
            }),
        })
    }

    build_exe = (self: @Self, exe: ExeNode) Res<Res<String>, AllocError> {
        exe.spec.backend.match({
            C   => self.build_native(exe, "c"),
            Js  => self.build_script(exe),
            Asm => asm_native(self.planned.target).match({
                true  => self.build_native(exe, "s"),
                false => {
                    println(
                        "zen: asm projects require x86_64-linux, aarch64-linux or arm64-darwin"
                    );
                    Ok(None)
                },
            }),
        })
    }

    build_script = (self: @Self, exe: ExeNode) Res<Res<String>, AllocError> {
        output              = self.output_path(exe).try();
        result: Res<String> = loop<String>((done) {
            // Zen source libraries compile into the script like any module;
            // a library that links native code has nothing to link against.
            native = exe.spec.deps.find((dep) {
                self.planned.libs.find((lib) { lib.name.eq(dep.name) }).match({
                    None      => false,
                    Ok(found) => found.spec.libs.len > 0,
                })
            });
            native.match({
                None    => (),
                Ok(dep) => {
                    println(
                        "zen: js projects cannot link native library `{}`",
                        dep.name
                    );
                    done.break();
                },
            });
            (!self.ensure_parent(output.view()).try()).then(() { done.break(); });
            (!self.compile_exe(exe, output.view()).try()).then(() { done.break(); });
            done.break(output);
        });
        Ok(result)
    }

    build_native = (self: @Self, exe: ExeNode, extension: str)
                   Res<Res<String>, AllocError> {
        output    = self.output_path(exe).try();
        workspace = self.project_path(self.env.var("ZEN_BUILD_DIR").value_or("build")).try();
        generated = self.a.String(
            "{}/.zen/{}/program.{}",
            workspace.view(),
            exe.name,
            extension
        ).try();
        lock_path = self.a.String("{}.lock", generated.view()).try();
        ready     = self.ensure_parent(generated.view()).try() && self.ensure_parent(output.view()).try();
        (!ready || self.env.fs.is_dir(output.view())).match({
            true  => { println("zen: cannot publish executable `{}`", output.view()); Ok(None) },
            false => self.env.fs.lock(lock_path.view()).match({
                Err(_)    => { println("zen: build workspace is locked or unavailable"); Ok(None) },
                Ok(guard) => {
                    // Bind an owned local so scope exit releases the lock.
                    held ::= guard;
                    self.build_locked(exe, generated.view(), output)
                },
            }),
        })
    }

    // Link beside the destination, then rename only a successful candidate.
    // The inherited workspace lock also covers a compiler surviving its parent.
    build_locked = (self: @Self, exe: ExeNode, generated: str, output: String)
                   Res<Res<String>, AllocError> {
        candidate = self.a.String("{}.zen-next", output.view()).try();
        self.env.fs.remove(candidate.view()).match({
            Err(_) => { println("zen: cannot clear build candidate"); Ok(None) },
            Ok(_)  => {
                @scope.defer(
                    () { self.env.fs.remove(candidate.view()).ignore(); }
                );
                symbols             = self.env.var("ZEN_SYMBOL_MAP").value_or("");
                result: Res<String> = loop<String>((done) {
                    (!symbols.is_empty()).then(() {
                        (!self.ensure_parent(symbols).try()).then(() { done.break(); });
                    });
                    (!self.compile_exe(exe, generated).try()).then(() { done.break(); });
                    linked = exe.spec.backend.match({
                        Asm => self.assemble_exe(
                            exe,
                            generated,
                            candidate.view()
                        ).try()
                            && self.replace(
                                candidate.view(),
                                output.view()
                            ).try(),
                        _   => self.link_c(
                            exe,
                            generated,
                            candidate.view(),
                            output.view()
                        ).try(),
                    });
                    linked.then(() { done.break(output); });
                    done.break();
                });
                Ok(result)
            },
        })
    }

    replace = (self: @Self, from: str, to: str) Res<bool, AllocError> {
        self.env.fs.rename(from, to).match({
            Ok(_)            => Ok(true),
            Err(OutOfMemory) => Err(AllocError.OutOfMemory),
            Err(_)           => { println("zen: cannot replace `{}`", to); Ok(false) },
        })
    }

    // The front end is skipped when the generated file exists and its input
    // record matches: the same compiler executable, compilation words, files
    // read (by length and content hash) and probe answers. The record is
    // removed before compiling and written only after a successful compile,
    // so it always describes the generated file beside it.
    compile_exe = (self: @Self, exe: ExeNode, generated: str)
                  Res<bool, AllocError> {
        source = self.project_path(exe.spec.src.text).try();
        parent = Path(source.view()).parent().value_or(Path(self.job.root));
        root  ::= parent.text;
        entry ::= Path(source.view()).name();

        // A conventional src/ tree is one module namespace. Starting at the
        // entry's immediate directory would make sibling modules unreachable.
        src_root = self.project_path("src").try();
        prefix   = self.a.String("{}/", src_root.view()).try();
        source.view().starts_with(prefix.view()).then(() {
            root  = src_root.view();
            entry = source.view().slice(prefix.view().len, source.view().len);
        });
        args        = BuildArgs(
            root: root,
            emission: Emission.File(generated),
            backend: exe.spec.backend,
            entry: entry,
            std_root: self.job.std_root,
            symbol_map: self.env.var("ZEN_SYMBOL_MAP").value_or(""),
            ffi: true,
            target: exe.spec.web.match({
                true  => "js-browser",
                false => self.planned.target.clang_triple().value_or(""),
            })
        );
        header      = self.compile_header(exe, args).try();
        record_path = self.a.String("{}.inputs", generated).try();
        paths_path  = self.a.String("{}.paths", generated).try();
        reusable    = header.match({
            None     => false,
            Ok(head) => self.env.fs.exists(generated)
                && self.unchanged(
                    head,
                    record_path.view(),
                    paths_path.view()
                ).try(),
        });
        reusable.match({
            true  => {
                self.trace.say(
                    self.a.String(
                        "compile `{}`: sources unchanged",
                        exe.name
                    ).try().view()
                );
                Ok(true)
            },
            false => self.env.fs.remove(record_path.view()).match({
                Err(_) => { println("zen: cannot clear input record `{}`", record_path.view()); Ok(false) },
                Ok(_)  => {
                    self.trace.say(
                        self.a.String("compile `{}`", exe.name).try().view()
                    );
                    compiler ::= self.a.Build(self.env, root);
                    compiler.set_std_root(self.job.std_root);
                    compiler.enable_ffi();
                    header.match({ None => (), Ok(_) => compiler.record_inputs().try() });
                    exe.spec.deps.loop((dep) {
                        self.planned.libs.find(
                            (lib) { lib.name.eq(dep.name) }
                        ).match({
                            None    => (),
                            Ok(lib) => {
                                path = self.project_path(
                                    lib.spec.src.text
                                ).try();
                                compiler.register_library(
                                    lib.name,
                                    path.view()
                                ).try();
                            },
                        });
                    });
                    compiler.walk(
                        entry_of(self.env, self.a, root, entry).try()
                    ).try();
                    compiler.back_end(args).try();
                    compiler.tally();
                    compiled = compiler.code() == 0;
                    compiled.then(() {
                        header.when_ok((head) {
                            self.save_inputs(
                                head,
                                compiler.inputs,
                                record_path.view(),
                                paths_path.view()
                            ).try();
                        });
                    });
                    Ok(compiled)
                },
            }),
        })
    }

    // The words that decide what a compile produces, led by the compiler's own
    // content hash. None means the compile cannot be reused: C imports
    // translate headers in a child process whose reads are not recorded, and
    // a requested symbol map must be rewritten.
    compile_header = (self: @Self, exe: ExeNode, args: BuildArgs)
                     Res<Res<Inputs>, AllocError> {
        result: Res<Inputs> = loop<Inputs>((done) {
            (self.imports_c_headers(exe) || !args.symbol_map.is_empty()).then(() { done.break(); });
            program = program_path(self.env, self.a);
            head ::= inputs(self.a).try();
            self.env.fs.read(self.a, program).match({
                Ok(binary) => head.read(program, binary.view()).try(),
                Err(_)     => done.break(),
            });
            head.word(args.root).try();
            head.word(args.entry).try();
            head.word(args.std_root).try();
            head.word(args.target).try();
            head.word(
                args.backend.match({ C => "c", Js => "js", Asm => "asm" })
            ).try();
            exe.spec.deps.loop((dep) {
                self.planned.libs.find((lib) { lib.name.eq(dep.name) }).match({
                    None    => (),
                    Ok(lib) => {
                        head.word(lib.name).try();
                        head.word(lib.spec.src.text).try();
                    },
                });
            });
            head.exact.then(() { done.break(head); });
            done.break();
        });
        Ok(result)
    }

    unchanged = (self: @Self, head: Inputs, record_path: str, paths_path: str)
                Res<bool, AllocError> {
        stored  = self.env.fs.read(self.a, record_path);
        listing = self.env.fs.read(self.a, paths_path);
        stored.match({
            Err(_)     => Ok(false),
            Ok(record) => listing.match({
                Err(_)    => Ok(false),
                Ok(paths) => self.replay(paths.view()).try().match({
                    None    => Ok(false),
                    Ok(now) => {
                        text = record.view();
                        lead = head.record.view();
                        Ok(text.starts_with(lead) && text.slice(lead.len, text.len).eq(now.record.view()))
                    },
                }),
            }),
        })
    }

    // Rebuild the record for a `paths` listing from the filesystem. None means
    // a listed file can no longer be read, so the old record cannot match.
    replay = (self: @Self, paths: str) Res<Res<Inputs>, AllocError> {
        now      ::= inputs(self.a).try();
        readable ::= true;
        paths.split('\n').loop((line) {
            (line.len > 2).then(() {
                path = line.slice(2, line.len);
                (line.index(0) == 'R').match({
                    true  => self.env.fs.read(self.a, path).match({
                        Ok(text) => now.read(path, text.view()).try(),
                        Err(_)   => { readable = false; },
                    }),
                    false => now.probe(path, self.env.fs.exists(path)).try(),
                });
            });
        });
        Ok(readable.match({ true => Ok(now), false => None }))
    }

    // The listing is written before the record, so a record on disk always
    // has the listing it was built from.
    save_inputs = (self: @Self, head: Inputs, body: Res<Inputs>, record_path: str, paths_path: str)
                  Res<AllocError> {
        body.match({
            None         => Ok,
            Ok(recorded) => recorded.exact.match({
                false => Ok,
                true  => {
                    record ::= self.a.String().try();
                    record.add(head.record.view()).try();
                    record.add(recorded.record.view()).try();
                    self.env.fs.write(paths_path, recorded.paths.view()).match({
                        Err(_) => (),
                        Ok(_)  => self.env.fs.write(
                            record_path,
                            record.view()
                        ).ignore(),
                    });
                    Ok
                },
            }),
        })
    }

    assemble_exe = (self: @Self, exe: ExeNode, generated: str, output: str)
                   Res<bool, AllocError> {
        log ::= self.a.String().try();
        ok = assemble_and_link(
            self.env,
            self.a,
            self.planned.target,
            generated,
            output,
            exe.spec.strip,
            log
        ).try();
        (!log.view().is_empty()).then(() { println("{}", log.view()); });
        Ok(ok)
    }

    link_c = (self: @Self, exe: ExeNode, generated: str, candidate: str, output: str)
             Res<bool, AllocError> {
        argv ::= self.a.Vec<str>();
        valid_cc = self.append_command(
            self.compiler(exe),
            argv
        ).try() && argv.len > 0;
        flag_words ::= self.a.Vec<str>();
        valid_flags       = self.append_command(
            self.env.var("CFLAGS").value_or(""),
            flag_words
        ).try();
        family            = self.family(exe, argv.get(0).value_or(""));
        refusal: Res<str> = loop((h) {
            (!valid_cc || !valid_flags).then(
                () { h.break("invalid CC or CFLAGS command words"); }
            );
            (!exe.spec.language.eq("c") && !exe.spec.language.eq("objective-c"))
                .then(
                    () { h.break(
                        "a native target's language is c or objective-c"
                    ); }
                );
            (self.cross() && family.match({ Clang => false, _ => true }))
                .then(
                    () { h.break("building for another platform needs clang"); }
                );
            h.break();
        });
        refusal.match({
            Ok(why) => { println("zen: {}", why); Ok(false) },
            None    => {
                link ::= self.toolchain(argv, family).try();
                self.link_command(
                    exe,
                    generated,
                    candidate,
                    link,
                    flag_words,
                    family
                ).try();
                self.publish(exe, generated, link, candidate, output)
            },
        })
    }

    // The native compiler is skipped when the executable exists and the link
    // record beside the generated file matches: the same compiler command and
    // generated source. A current executable is left untouched, which also
    // spares macOS from verifying a new binary on its first run. The record
    // is removed before linking, so a failed or interrupted link never leaves
    // a record describing an executable it did not publish. Libraries found
    // through search paths and system headers are not recorded; removing the
    // executable forces a relink.
    publish = (self: @Self, exe: ExeNode, generated: str, link: Vec<str>, candidate: str, output: str)
              Res<bool, AllocError> {
        record_path = self.a.String("{}.linked", generated).try();
        record      = self.link_record(exe, generated, link).try();
        current     = record.match({
            None       => false,
            Ok(expect) => self.env.fs.exists(output) && self.env.fs.read(self.a, record_path.view()).match({
                Err(_)   => false,
                Ok(text) => text.view().eq(expect.view()),
            }),
        });
        current.match({
            true  => {
                self.trace.say(
                    self.a.String("link `{}`: unchanged", exe.name).try().view()
                );
                Ok(true)
            },
            false => self.env.fs.remove(record_path.view()).match({
                Err(_) => { println("zen: cannot clear link record `{}`", record_path.view()); Ok(false) },
                Ok(_)  => {
                    linked = self.run_captured(link).try() && self.replace(candidate, output).try();
                    linked.then(() {
                        record.when_ok(
                            (text) { self.env.fs.write(
                                record_path.view(),
                                text.view()
                            ).ignore(); }
                        );
                    });
                    Ok(linked)
                },
            }),
        })
    }

    // None means the link cannot be proven current: extern C sources and C
    // imports may include project headers this record does not observe. The
    // candidate path is the same on every build, so the command words compare
    // as written.
    link_record = (self: @Self, exe: ExeNode, generated: str, link: Vec<str>)
                  Res<Res<String>, AllocError> {
        self.links_c_sources(exe).match({
            true  => Ok(None),
            false => self.env.fs.read(self.a, generated).match({
                Err(_)     => Ok(None),
                Ok(source) => {
                    record ::= self.a.String().try();
                    link.loop(
                        (word) { record.fmt("{}:{}\n", word.len, word).try(); }
                    );
                    record.fmt(
                        "{} {}\n",
                        source.view().len,
                        digest(source.view())
                    ).try();
                    Ok(Ok(record))
                },
            }),
        })
    }

    links_c_sources = (self: @Self, exe: ExeNode) bool {
        self.imports_c_headers(exe) || exe.spec.deps.find((dep) {
            self.planned.externs.find(
                (node) { node.name.eq(dep.name) }
            ).match({ Ok(_) => true, None => false })
        }).match({ Ok(_) => true, None => false })
    }

    imports_c_headers = (self: @Self, exe: ExeNode) bool {
        exe.spec.deps.find((dep) {
            self.planned.imports.find(
                (node) { node.name.eq(dep.name) }
            ).match({ Ok(_) => true, None => false })
        }).match({ Ok(_) => true, None => false })
    }

    // On macOS, /usr/bin/cc, clang and gcc are xcrun shims that locate the
    // real compiler and SDK on every call. Resolve them once, keep the answer
    // in the build workspace, and call the compiler with its sysroot
    // directly. Any other compiler is called as given.
    toolchain = (self: @Self, argv: Vec<str>, family: Family) Res<Vec<str>, AllocError> {
        program                  = argv.get(0).value_or("");
        located                  = program.contains('/').match({
            true  => program,
            false => self.on_path(program),
        });
        shim                     = self.host.os.match({ Macos => true, _ => false })
            && family.match({ Clang => true, _ => false })
            && located.starts_with("/usr/bin/");
        resolved: Res<Toolchain> = shim.match({
            true  => self.apple_toolchain().try(),
            false => None,
        });
        out ::= self.a.Vec<str>();
        resolved.match({
            Ok(found) => {
                out.add(found.compiler).try();
                out.add("-isysroot").try();
                out.add(found.sysroot).try();
            },
            None      => out.add(program).try(),
        });
        argv.loop((h, i, word) { (i > 0).then(() { out.add(word).try(); }); });
        Ok(out)
    }

    on_path = (self: @Self, name: str) str {
        found: Res<str> = self.env.var("PATH").value_or("").split(':').loop((h, dir) {
            (!dir.is_empty()).then(() {
                join_path(self.a, dir, name).match({
                    Ok(path) => self.env.fs.exists(path.view()).then(() { h.break(path.view()); }),
                    Err(_)   => (),
                });
            });
        });
        found.value_or(name)
    }

    // The clang and SDK behind Apple's shims, read from the workspace when
    // both recorded paths still exist, otherwise asked of xcrun and recorded.
    apple_toolchain = (self: @Self) Res<Res<Toolchain>, AllocError> {
        workspace             = self.project_path(self.env.var("ZEN_BUILD_DIR").value_or("build")).try();
        cached                = self.a.String(
            "{}/.zen/toolchain",
            workspace.view()
        ).try();
        known: Res<Toolchain> = self.env.fs.read(self.a, cached.view()).match({
            Err(_)   => None,
            Ok(text) => text.view().split_once('\n').match({
                None     => None,
                Ok(pair) => (self.env.fs.exists(pair.before) && self.env.fs.exists(pair.after.trim_end().value_or(""))).match({
                    true  => Ok(Toolchain(
                        compiler: pair.before,
                        sysroot: pair.after.trim_end().value_or("")
                    )),
                    false => None,
                }),
            }),
        });
        known.match({
            Ok(found) => Ok(Ok(found)),
            None      => {
                compiler = self.xcrun("--find", "clang").try();
                sysroot  = self.xcrun("--show-sdk-path", "").try();
                (compiler.is_empty() || sysroot.is_empty()).match({
                    true  => Ok(None),
                    false => {
                        text = self.a.String(
                            "{}\n{}\n",
                            compiler,
                            sysroot
                        ).try();
                        self.env.fs.write(cached.view(), text.view()).ignore();
                        Ok(Ok(Toolchain(compiler: compiler, sysroot: sysroot)))
                    },
                })
            },
        })
    }

    xcrun = (self: @Self, question: str, tool: str) Res<str, AllocError> {
        argv ::= self.a.Vec<str>();
        argv.add("xcrun").try();
        argv.add(question).try();
        (!tool.is_empty()).then(() { argv.add(tool).try(); });
        self.trace.command(self.a, argv).try();
        Ok(self.env.proc.run_argv(self.a, "", argv).match({
            Ok(result) => (result.code == 0).match({ true => result.out.view().trim_end().value_or(
                ""
            ), false => "" }),
            Err(_)     => "",
        }))
    }

    // The C compiler command: `--cc` or CC, else the target's `cc`, else `cc`.
    compiler = (self: @Self, exe: ExeNode) str {
        self.job.cc.match({
            Ok(given) => given,
            None      => self.env.var("CC").match({
                Ok(given) => given,
                None      => exe.spec.cc.match({
                    Ok(Clang)        => "clang",
                    Ok(Gcc)          => "gcc",
                    Ok(Tcc)          => "tcc",
                    Ok(Custom(path)) => path.text,
                    None             => "cc",
                }),
            }),
        })
    }

    // Which flag dialect the compiler speaks, judged from its name. A plain
    // `cc` is clang on macOS and GCC-compatible elsewhere.
    family = (self: @Self, exe: ExeNode, program: str) Family {
        name = Path(program).name();
        loop<Family>((h) {
            name.contains("tcc").then(() { h.break(Family.Tcc); });
            name.contains("clang").then(() { h.break(Family.Clang); });
            (name.contains("gcc") || name.contains("g++")).then(() { h.break(Family.Gcc); });
            self.host.os.match({ Macos => h.break(Family.Clang), _ => h.break(Family.Gcc) });
        }).value_or(Family.Gcc)
    }

    // The mode and the target's own settings, as compiler flags. Size
    // optimization also drops unreferenced sections at link time.
    link_command = (
        self      : @Self,
        exe       : ExeNode,
        generated : str,
        output    : str,
        argv      :: Vec<str>,
        flags     : Vec<str>,
        family    : Family
    ) Res<AllocError> {
        optimize = exe.spec.optimize.value_or(self.job.mode.match({
            Debug   => Optimize.Debug,
            Release => Optimize.Speed,
            Small   => Optimize.Size,
        }));
        macos    = self.planned.target.os.match({ Macos => true, _ => false });
        dialect  = family.match({ Tcc => false, _ => true });
        argv.add(optimize.match({
            Debug => "-O0",
            Speed => "-O2",
            Size  => family.match({ Clang => "-Oz", _ => "-Os" }),
        })).try();
        exe.spec.backend.match({ C => argv.add("-std=c99").try(), _ => () });
        (self.cross() && dialect).then(() {
            argv.add("-target").try();
            argv.add(self.planned.target.clang_triple().value_or("")).try();
        });
        (dialect && optimize.match({ Size => true, _ => false })).then(() {
            argv.add("-ffunction-sections").try();
            argv.add("-fdata-sections").try();
            // Zen faults are values; unwind tables only cost size.
            argv.add("-fno-asynchronous-unwind-tables").try();
            argv.add("-fno-unwind-tables").try();
            macos.match({
                true  => argv.add("-Wl,-dead_strip").try(),
                false => {
                    // Resolve external calls through the GOT without
                    // per-symbol PLT code.
                    argv.add("-fno-plt").try();
                    argv.add("-Wl,--gc-sections").try();
                },
            });
        });
        // Apple's linker ignores `-s`: `-x` drops local symbols and `-S`
        // debugging symbols, which is all a linked executable can lose.
        (exe.spec.strip || self.job.mode.match({ Small => true, _ => false })).then(() {
            macos.match({
                true  => { argv.add("-Wl,-x").try(); argv.add("-Wl,-S").try(); },
                false => argv.add("-s").try(),
            });
        });
        exe.spec.defines.value_or(self.a.Vec<str>()).loop((name) {
            definition = self.a.String("-D{}", name).try();
            argv.add(definition.view()).try();
        });
        exe.spec.cflags.value_or(self.a.Vec<str>()).loop((flag) { argv.add(flag).try(); });
        flags.loop((flag) { argv.add(flag).try(); });
        exe.spec.backend.match({
            C => {
                argv.add("-x").try();
                argv.add(exe.spec.language).try();
            },
            _ => (),
        });
        argv.add(generated).try();
        exe.spec.deps.loop((h, dep) { self.add_dep(dep.name, argv).try(); });
        self.add_std_floors(generated, argv).try();
        exe.spec.frameworks.match({
            None      => (),
            Ok(names) => names.loop((name) {
                argv.add("-framework").try();
                argv.add(name).try();
            }),
        });
        exe.spec.libs.value_or(self.a.Vec<str>()).loop((name) {
            library = self.a.String("-l{}", name).try();
            argv.add(library.view()).try();
        });
        argv.add("-o").try();
        argv.add(output).try();
    }

    // CC/CFLAGS use quoted command words, never shell evaluation.
    append_command = (self: @Self, text: str, argv :: Vec<str>) Res<bool, AllocError> {
        word    ::= self.a.String().try();
        quote   :: u8 = 0;
        escaped ::= false;
        started ::= false;
        Range(0, text.len).loop((i) {
            byte = text.index(i);
            escaped.match({
                true  => { word.add(byte).try(); escaped = false; },
                false => {
                    (byte == 92 && quote != 39).match({
                        true  => { escaped = true; started = true; },
                        false => (quote != 0).match({
                            true  => (byte == quote).match({
                                true  => { quote = 0; },
                                false => word.add(byte).try(),
                            }),
                            false => (byte == 39 || byte == 34).match({
                                true  => { quote = byte; started = true; },
                                false => (byte == 32 || byte == 9 || byte == 10).match({
                                    true  => started.then(() {
                                        argv.add(word.view()).try();
                                        word    = self.a.String().try();
                                        started = false;
                                    }),
                                    false => { word.add(
                                        byte
                                    ).try(); started = true; },
                                }),
                            }),
                        }),
                    });
                },
            });
        });
        (started && quote == 0 && !escaped).then(
            () { argv.add(word.view()).try(); }
        );
        Ok(quote == 0 && !escaped)
    }

    add_dep = (self: @Self, name: str, argv :: Vec<str>)
              Res<AllocError> {
        self.planned.libs.find((node) { node.name.eq(name) }).match({
            None       => {},
            Ok(native) => self.add_link_options(
                native.spec.paths,
                native.spec.libs,
                argv
            ).try(),
        });
        self.planned.externs.find((node) { node.name.eq(name) }).match({
            None         => {},
            Ok(external) => {
                source = self.project_path(external.spec.src.text).try();
                argv.add(source.view()).try();
                self.add_link_options(
                    external.spec.paths,
                    external.spec.libs,
                    argv
                ).try();
            },
        });
        self.planned.imports.find((node) { node.name.eq(name) }).match({
            None         => {},
            Ok(imported) => imported.spec.libraries.loop((h, lib) {
                option = self.a.String("-l{}", lib).try();
                argv.add(option.view()).try();
            }),
        });
    }

    add_link_options = (
        self  : @Self,
        paths : Vec<str>,
        libs  : Vec<str>,
        argv  :: Vec<str>
    ) Res<AllocError> {
        paths.loop((h, path) {
            resolved = self.project_path(path).try();
            option   = self.a.String("-L{}", resolved.view()).try();
            argv.add(option.view()).try();
        });
        libs.loop((h, lib) {
            option = self.a.String("-l{}", lib).try();
            argv.add(option.view()).try();
        });
        Ok
    }

    // Native implementations used by std travel with the toolchain, not each
    // project's build file. Generated calls identify the floors that survived
    // reachability, matching the compiler test harness's link contract.
    add_std_floors = (self: @Self, generated: str, argv :: Vec<str>)
                     Res<AllocError> {
        self.env.fs.read(self.a, generated).match({
            Err(_)     => Ok,
            Ok(source) => {
                tls  ::= false;
                math ::= false;
                source.view().split('\n').loop((line) {
                    (line.starts_with("extern ") && line.contains(" SSL_")).then(() { tls = true; });
                    line.eq("#include <math.h>").then(() { math = true; });
                });
                math.then(() { argv.add("-lm").try(); });
                tls.then(() {
                    argv.add("-lssl").try();
                    argv.add("-lcrypto").try();
                });
                Ok
            },
        })
    }

    run_captured = (self: @Self, argv: Vec<str>) Res<bool, AllocError> {
        self.trace.command(self.a, argv).try();
        self.env.proc.run_argv(self.a, "", argv).match({
            Err(_)     => {
                println("zen: could not start `{}`", argv.get(0).match({
                    Ok(value) => value, None => "process",
                }));
                Ok(false)
            },
            Ok(result) => {
                (!result.out.view().is_empty()).then(
                    () { println("{}", result.out.view()); }
                );
                (!result.err.view().is_empty()).then(
                    () { println("{}", result.err.view()); }
                );
                Ok(result.code == 0)
            },
        })
    }

    ensure_parent = (self: @Self, path: str) Res<bool, AllocError> {
        Ok(Path(path).parent().match({
            None       => true,
            Ok(parent) => make_dirs(self.env, self.a, parent.text),
        }))
    }

    run_program = (self: @Self, program: str, backend: Codegen)
                  Res<i32, AllocError> {
        self.trace.say(self.a.String("run {}", program).try().view());
        argv ::= self.a.Vec<str>();
        backend.match({ Js => argv.add("node").try(), _ => () });
        argv.add(program).try();
        Range(self.job.args_at, self.job.argv.len).loop((h, i) {
            self.job.argv.get(i).match({
                Ok(arg) => argv.add(arg).try(),
                None    => {},
            });
        });
        self.env.proc.run_argv_inherit(self.a, "", argv).match({
            Err(_)   => {
                backend.match({
                    Js => println(
                        "zen: could not start Node.js for `{}`",
                        program
                    ),
                    _  => println("zen: could not run `{}`", program),
                });
                Ok(1)
            },
            Ok(code) => Ok(code),
        })
    }

    output_path = (self: @Self, exe: ExeNode) Res<String, AllocError> {
        self.env.var("ZEN_BUILD_OUTPUT").match({
            Ok(path) => path.is_empty().match({
                true => self.declared_output(exe), false => self.project_path(path),
            }),
            None     => self.declared_output(exe),
        })
    }

    declared_output = (self: @Self, exe: ExeNode) Res<String, AllocError> {
        exe.spec.out.match({
            Ok(path) => self.project_path(path.text),
            None     => self.a.String(
                "{}/build/{}-{}/{}{}",
                self.job.root,
                self.planned.target.os.stable_name(),
                self.planned.target.arch.stable_name(),
                exe.name,
                exe.spec.backend.match({ Js => exe.spec.web.match({ true => "", false => ".js" }), _ => "" })
            ),
        })
    }

    project_path = (self: @Self, path: str) Res<String, AllocError> {
        (path.len > 0 && path.index(0) == '/').match({
            true  => self.a.String(path),
            false => join_path(self.a, self.job.root, path),
        })
    }
}
