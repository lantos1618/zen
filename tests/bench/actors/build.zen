// The actor runtime benchmarks and stress scenarios, each for the C and the
// native backend. Run them on dev-box, pinned: see README.md.
{ Builder, BuildError, Codegen } = std.build
{ Res, Ok, Path } = std.core

build = (b :: Builder) Res<BuildError> {
    b.exe(
        "spawn",
        { src: Path("spawn.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/spawn")) }
    ).try();
    b.exe(
        "spawn-asm",
        { src: Path("spawn.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/spawn")) }
    ).try();
    b.exe(
        "pingpong",
        { src: Path("pingpong.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/pingpong")) }
    ).try();
    b.exe(
        "pingpong-asm",
        { src: Path("pingpong.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/pingpong")) }
    ).try();
    b.exe(
        "ring",
        { src: Path("ring.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/ring")) }
    ).try();
    b.exe(
        "ring-asm",
        { src: Path("ring.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/ring")) }
    ).try();
    b.exe(
        "fanin",
        { src: Path("fanin.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/fanin")) }
    ).try();
    b.exe(
        "fanin-asm",
        { src: Path("fanin.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/fanin")) }
    ).try();
    b.exe(
        "churn",
        { src: Path("churn.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/churn")) }
    ).try();
    b.exe(
        "churn-asm",
        { src: Path("churn.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/churn")) }
    ).try();
    b.exe(
        "parked",
        { src: Path("parked.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/parked")) }
    ).try();
    b.exe(
        "parked-asm",
        { src: Path("parked.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/parked")) }
    ).try();
    b.exe(
        "overload",
        { src: Path("overload.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/overload")) }
    ).try();
    b.exe(
        "overload-asm",
        { src: Path("overload.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/overload")) }
    ).try();
    b.exe(
        "preempt",
        { src: Path("preempt.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/preempt")) }
    ).try();
    b.exe(
        "preempt-asm",
        { src: Path("preempt.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/preempt")) }
    ).try();
    b.exe(
        "soak",
        { src: Path("soak.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/soak")) }
    ).try();
    b.exe(
        "soak-asm",
        { src: Path("soak.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/soak")) }
    ).try();
    b.exe(
        "chatter",
        { src: Path("chatter.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/chatter")) }
    ).try();
    b.exe(
        "chatter-asm",
        { src: Path("chatter.zen"), deps: [], backend: Codegen.Asm, out: Ok(Path("bin/asm/chatter")) }
    ).try();
    b.exe(
        "run",
        { src: Path("run.zen"), deps: [], backend: Codegen.C, out: Ok(Path("bin/c/run")) }
    ).try();
    Ok
}
