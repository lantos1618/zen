// pingpong through the message API: one `receive` per actor, enum
// messages, and Refs typed by the message (Ref<Rally>), so every send runs
// the receive turn the actor started with. Same numbers as `pingpong`.

{ Res, Ok, None, loop } = std.core
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor
{ println } = std.io
{ param } = common

Score = { Begin | Finished }

Tally = { left :: usize, pairs: usize, rounds: usize, start :: u64 = 0 }

Tally.impl(Actor, {
    receive = (self :: @Self, ctx: Context, s: Score) {
        s.match({
            Begin    => { self.start = ctx.env.clock.since_start().ns; },
            Finished => {
                self.left = self.left - 1;
                (self.left == 0).then(() {
                    ns   = (ctx.env.clock.since_start().ns - self.start).to_usize().value_or(
                        0
                    );
                    msgs = self.pairs * self.rounds * 2;
                    println(
                        "bench=pingpong_msg pairs={} rounds={} round_trip_ns={} msgs_per_s={}",
                        self.pairs,
                        self.rounds,
                        ns / self.rounds,
                        msgs * 1000 / (ns / 1000000 + 1)
                    );
                });
            },
        });
    }
})

Rally = { Ball: u64 | Partner: Ref<Rally> }

Player = { partner :: Res<Ref<Rally>> = None, tally: Ref<Score> }

Player.impl(Actor, {
    receive = (self :: @Self, ctx: Context, m: Rally) {
        m.match({
            Partner(p) => { self.partner = Ok(p); },
            Ball(n)    => (n == 0).match({
                true  => self.tally.send(Score.Finished).ignore(),
                false => self.partner.match({
                    Ok(p) => p.send(Rally.Ball(n - 1)).ignore(),
                    None  => (),
                }),
            }),
        });
    }
})

Error = ActorStartError | ActorError

main = (env: Env) Res<i32, Error> {
    pairs              = param(env, "PAIRS", 1);
    rounds             = param(env, "ROUNDS", 10000000);
    tally              = env.spawn(Tally(
        left: pairs,
        pairs: pairs,
        rounds: rounds
    )).try();
    scores: Ref<Score> = tally;
    a                  = env.mem.alloc();
    serves ::= a.Vec<Ref<Rally>>();
    i      :: usize = 0;
    loop(() { i < pairs }, (h) {
        x = env.spawn(Player(tally: scores)).try();
        y = env.spawn(Player(tally: scores)).try();
        x.send(Rally.Partner(y)).try();
        y.send(Rally.Partner(x)).try();
        serves.add(x).ignore();
        i = i + 1;
    });
    env.threads.sleep(100);
    scores.send(Score.Begin).try();
    env.threads.sleep(10);
    serves.loop((p) { p.send(Rally.Ball(rounds.to_u64() * 2)).ignore(); });
    Ok(0)
}
