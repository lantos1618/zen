{ Res, Ok, Range } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// Calls and integer arithmetic: fib(24) computed `rounds` times (argument,
// default 64), so the run time is linear in `rounds`. The argument depends on
// the round so a C compiler cannot hoist the call out of the loop.
fib = (n: i64) i64 {
    (n < 2).match({ true => n, false => fib(n - 1) + fib(n - 2) })
}

main = (env: Env) Res<i32, AllocError> {
    rounds = env.argv.get(1).match({ Ok(s) => s.parse_usize().value_or(64), None => 64 });
    total :: i64 = 0;
    Range(0, rounds).loop((r) { total = total +% fib((r % 2 == 0).match({ true => 24, false => 23 })); });
    println("{} rounds fib {}", rounds, total);
    Ok(0)
}
