// The sender's arena dies before program shutdown lets the receiver drain.
// A correct mailbox owns the str bytes rather than retaining this view.

{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor

Reader = {}

Reader.impl(Actor, {
    read = (self :: @Self, ctx: Context, text: str) {
        ctx.env.out.println("{}", text).ignore()
    }
})

Error = AllocError | IoError | ActorStartError | ActorError

send_from_short_arena = (env: Env, reader: Ref<Reader>) Res<Error> {
    arena ::= env.mem.alloc();
    text = arena.String("dynamic {}", "bytes survive").try();
    reader.read(text.view()).try();
}

main = (env: Env) Res<i32, Error> {
    reader = env.spawn(Reader()).try();
    send_from_short_arena(env, reader).try();
    Ok(0)
}
