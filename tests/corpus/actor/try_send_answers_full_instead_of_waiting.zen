// `r.try_send(m)` never waits: on one worker a receiver cannot drain while
// the sender's turn runs, so flooding it past the bound answers Full; a
// stopped actor answers Closed. The accepted messages still all run.

{ Res, Ok, Err, Range } = std.core
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor
{ println } = std.io

Sink = { got :: u64 = 0 }

Sink.impl(Actor, {
    receive = (self :: @Self, ctx: Context, n: u64) { self.got = self.got + n; }

    stopped = (self :: @Self, ctx: Context) { println(
        "sink got {}",
        self.got
    ); }
})

Flooder = { sink: Ref<Sink> }

Flooder.impl(Actor, {
    receive = (self :: @Self, ctx: Context, n: u64) {
        sent :: u64 = 0;
        full :: u64 = 0;
        Range(0, n).loop((i) {
            self.sink.try_send(1).match({
                Ok(_)       => { sent = sent + 1; },
                Err(Full)   => { full = full + 1; },
                Err(Closed) => {},
            });
        });
        println("some accepted {}", sent > 0);
        println("the rest full {}", sent + full == n && full > 0);
        println("accepted {}", sent);
        self.sink.stop();
        ctx.me.stop();
    }
})

Error = ActorStartError | ActorError

main = (env: Env) Res<i32, Error> {
    s = env.spawn(Sink()).try();
    f = env.spawn(Flooder(sink: s)).try();
    f.send(1000).try();
    f.join();
    s.join();
    s.try_send(1).match({
        Err(Closed) => println("closed"),
        _           => println("accepted"),
    });
    Ok(0)
}
