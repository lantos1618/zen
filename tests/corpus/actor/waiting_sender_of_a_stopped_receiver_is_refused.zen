// A receiver stops itself while a sender waits for room in its mailbox.
// The 256 messages it accepted before the stop still run, then `stopped`;
// the 344 that waited in the sender's outbox were never accepted, so they
// are refused, and the sender is released to run again. The two report to
// a log actor that prints once it has heard from both, so the receiver
// stopping and the sender running again may happen in either order. The
// receiver gets its log at spawn, not in a message, so all 256 slots of its
// mailbox hold the sender's messages whatever the schedule.

{ Res, Ok, None, loop } = std.core
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor
{ println } = std.io

Log = {
    took :: Res<u64> = None,
    released :: bool = false,
}

show = (took: Res<u64>, released: bool) {
    took.when_ok((n) {
        released.then(() {
            println("sender released");
            println("receiver took {}", n);
        });
    });
}

Log.impl(Actor, {
    receiver_took = (self :: @Self, ctx: Context, n: u64) {
        self.took = Ok(n);
        show(self.took, self.released);
    }

    sender_released = (self :: @Self, ctx: Context) {
        self.released = true;
        show(self.took, self.released);
    }
})

Receiver = {
    log: Ref<Log>,
    taken :: u64 = 0,
}

Receiver.impl(Actor, {
    take = (self :: @Self, ctx: Context, n: u64) {
        self.taken = self.taken + 1;
        (n == 50).then(() { ctx.me.stop(); });
    }

    stopped = (self :: @Self, ctx: Context) {
        self.log.receiver_took(self.taken).ignore();
    }
})

Sender = { sent :: u64 = 0 }

Sender.impl(Actor, {
    flood = (self :: @Self, ctx: Context, to: Ref<Receiver>, count: u64) {
        loop(() { self.sent < count }, (h) {
            to.take(self.sent).ignore();
            self.sent = self.sent + 1;
        });
    }

    report = (self :: @Self, ctx: Context, log: Ref<Log>) {
        log.sender_released().ignore();
    }
})

Error = ActorStartError | ActorError

main = (env: Env) Res<i32, Error> {
    log      = env.spawn(Log()).try();
    receiver = env.spawn(Receiver(log: log)).try();
    sender   = env.spawn(Sender()).try();
    sender.flood(receiver, 600).try();
    sender.report(log).try();
    receiver.join();
    Ok(0)
}
