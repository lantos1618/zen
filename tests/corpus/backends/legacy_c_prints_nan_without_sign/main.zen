// The legacy C backend (project builds and `--ffi`) prints every NaN as `nan`,
// as IR-C, the JIT and JS do. C's `%g` would print a set sign bit as `-nan`,
// and x86's default 0/0 NaN has its sign bit set. Each path is checked: the
// stdout and stderr printers and the scratch buffer behind `String.fmt`.
{ Build } = zen.zen_build
{ Generation, Layout } = gen.gen
{ Codegen } = std.build
{ Res, Ok, Err, None, loop } = std.core
{ Alloc, AllocError } = std.mem
{ String } = std.text
{ Vec } = std.collections
{ Env } = std.env
{ println } = std.io

legacy_c = (env: Env, a: Alloc, code :: String) Res<bool, AllocError> {
    build ::= a.Build(env, "src/program");
    build.set_std_root("src");
    check = build.whole("program.zen", a.Map<str, str>()).try();
    report ::= a.String().try();
    (build.diag_count() > 0 || check.diag_count() > 0).match({
        true  => {
            check.render_diags(report).try();
            println("frontend {}", report.view());
            Ok(false)
        },
        false => {
            generation = Generation(
                alloc: a,
                mem: env.mem,
                tree: build.tree,
                check: check,
                backend: Codegen.C,
                entry: 0,
                layout: Layout.Single,
                ffi: true,
                symbols: false,
                target: None
            );
            faults     = generation.emit(
                report,
                (artifact) { code.add(artifact.text).try(); Ok(0) }
            ).try();
            (faults > 0).then(() { println("legacy {}", report.view()); });
            Ok(faults == 0)
        },
    })
}

run = (env: Env, a: Alloc, argv: Vec<str>) Res<bool, AllocError> {
    env.proc.run_argv(a, "", argv).match({
        Err(_)     => { println("cannot run {}", argv.get(0).value_or("")); Ok(false) },
        Ok(result) => {
            println("exit {}", result.code);
            println("stdout {}", result.out.view());
            println("stderr {}", result.err.view());
            Ok(result.code == 0)
        },
    })
}

main = (env: Env) Res<AllocError> {
    a = env.mem.alloc();
    code ::= a.String().try();
    good: Res<bool> = loop<bool>((h) {
        (!legacy_c(env, a, code).try()).then(() { h.break(false); });
        written = env.fs.write(
            "legacy.c",
            code.view()
        ).match({ Ok(_) => true, Err(_) => false });
        (!written).then(
            () { println("cannot write legacy.c"); h.break(false); }
        );
        compiler ::= a.Vec<str>();
        [str, 8]("cc", "legacy.c", "-O2", "-std=c99", "-o", "candidate", "-pthread", "-lm")
            .loop((word) { compiler.add(word).try(); });
        compiled = env.proc.run_argv(a, "", compiler).match({
            Err(_)     => false,
            Ok(result) => {
                (result.code != 0).then(
                    () { println("C compile {}", result.err.view()); }
                );
                result.code == 0
            },
        });
        (!compiled).then(() { h.break(false); });
        program ::= a.Vec<str>();
        program.add("./candidate").try();
        h.break(run(env, a, program).try());
    });
    println("legacy C ran {}", good.value_or(false));
    Ok
}
