{ println } = std.io
{ Env } = std.env
{ Res, Ok } = std.core
{ AllocError } = std.mem

main = (env: Env) Res<AllocError> {
    zero: f64    = 0.0;
    nan: f64     = zero / zero;
    negated: f64 = 0.0 - nan;
    one: f64     = 1.0;
    inf: f64     = one / zero;
    println("{} {} {} {}", nan, negated, inf, 0.0 - inf);
    env.out.errorln("{} {}", nan, negated).ignore();
    a = env.mem.alloc();
    text ::= a.String().try();
    text.fmt("{} {} {}", nan, negated, 0.0 - inf).try();
    println("{}", text.view());
    Ok
}
