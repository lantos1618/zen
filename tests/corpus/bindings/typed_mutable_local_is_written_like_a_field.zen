// A typed mutable local is written `name :: T = value`: `::` marks
// mutability on a local exactly as it does on a field or a parameter, and
// the type is optional only in the inferred form `name ::= value`.

Circle = { r: f64 }

grow = (c :: Circle) { c = Circle(r: c.r * 2.0); }

main = () i32 {
    c :: Circle = Circle(r: 1.5);
    grow(c);
    count :: i32 = 0;
    count = count + 1;
    total ::= 10;
    total      = total + count;
    fixed: i32 = 7;
    println("{} {} {} {}", c.r, count, total, fixed);
    0
}
