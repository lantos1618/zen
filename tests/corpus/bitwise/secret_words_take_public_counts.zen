// The operators on secret words are single machine operations, which the
// secret discipline accepts, provided every shift count is public.
Secret, declassify = std.ct

mix = (a: Secret<u64>, b: Secret<u64>, rounds: usize) Secret<u64> {
    x = (a ^ b) & ~(a | b);
    (x << rounds) | ((a & b) >> 3)
}

main = () {
    key: Secret<u64>   = 0xF0F0;
    nonce: Secret<u64> = 0x0FF0;
    println("{}", declassify(mix(key, nonce, 4)));
}
