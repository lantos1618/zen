// A u128 loaded or stored at a constant offset from a computed pointer
// (Vec<u128> get and set at a constant index) reads and writes the right
// element, both halves.
{ Res, Ok } = std.core
{ truncate_u64 } = std.core.num
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

halves = (label: str, v: u128) {
    println("{}: {} {}", label, (v >> 64).truncate_u64(), v.truncate_u64());
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    big: u128 = 0xFFFFFFFFFFFFFFFF;
    v ::= alloc.Vec<u128>();
    v.add(1).try();
    v.add(2).try();
    v.add((big << 8) | 5).try();
    v.get(2).match({ Ok(x) => halves("get", x), None => println("get none") });
    v.set(1, (big << 72) | 7);
    v.get(1).match({ Ok(x) => halves("set", x), None => println("set none") });
    Ok(0);
}
