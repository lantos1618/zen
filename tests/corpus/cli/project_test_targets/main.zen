project, Action = zen.zen_project
ProjectArgs = std.build

run = (env: Env, a: Alloc, target: str) Res<(), AllocError> {
    job  = ProjectArgs(
        root: "src/app",
        target: target,
        std_root: "src",
        argv: a.Vec<str>(),
        release: false
    );
    code = project(env, a, job, Action.Test).try();
    println("result {} {}", target, code);
    Ok(())
}

main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    run(env, a, "passing").try();
    run(env, a, "failing").try();
    run(env, a, "missing").try();
    run(env, a, "").try();
    Ok(())
}
