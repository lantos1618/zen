{ Range } = std.core
{ println } = std.io

// A dense integer match of literals lowers to a static table
// (gen_c_table.zen); every index, the fallback, and a negative
// scrutinee must answer exactly as the `if` chain did.
k = (
    i : usize
) u32 { i.match({ 0 => 10, 1 => 11, 2 => 12, 3 => 13, 4 => 4000000000, _ => 7 }) }
s = (i: i64) i64 { i.match({ 0 => -1, 1 => -2, 2 => -3, 3 => -4, _ => 99 }) }
main = () {
    total :: u64 = 0;
    Range<usize>(0, 8).loop((i) { total = total + k(i).to_u64(); });
    println("{}", total);
    println("{} {} {}", s(0), s(3), s(-1));
    println("{}", s(4));
}
