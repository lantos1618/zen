{ println } = std.io

// A wide `:` argument is lent by address when the callee only reads it.
// The callee still sees the caller's value at the call: a result written
// back into the same binding, or a `::` argument of the same call that
// writes the binding, cannot change what the lent parameter reads.
Big = { a :: u64, b :: u64, c :: u64 }
turn = (x: Big) Big { Big(a: x.c, b: x.a, c: x.b) }
sum = (x: Big) u64 { x.a * 100 + x.b * 10 + x.c }
write_then_read = (x: Big, y :: Big) u64 { y.a = 7; y.c = 9; sum(x) }
deep = (x: Big) u64 { sum(turn(x)) + sum(x) }
main = () {
    b ::= Big(a: 1, b: 2, c: 3);
    b = turn(b);
    println("{}", sum(b));
    b = turn(turn(b));
    println("{}", sum(b));
    println("{}", write_then_read(b, b));
    println("{}", sum(b));
    println("{}", deep(b));
}
