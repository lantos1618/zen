{ println } = std.io

// A `:` argument read through a `::` parameter is lent in place only when
// nothing can write that storage before the callee returns. Here `y` names
// the same storage as `x` and writes it, two calls down or while the later
// arguments are evaluated, so each callee still sees `x` as it was read.
Big = { a :: u64, b :: u64, c :: u64 }
sum = (x: Big) u64 { x.a * 100 + x.b * 10 + x.c }
poke = (y :: Big) u64 {
    y.a = 7;
    y.c = 9;
    0
}
deep = (y :: Big) u64 { poke(y) }
later = (x: Big, y :: Big) u64 { deep(y) + sum(x) }
plus = (x: Big, n: u64) u64 { sum(x) + n }
via_later = (x :: Big, y :: Big) u64 { later(x, y) }
via_args = (x :: Big, y :: Big) u64 { plus(x, poke(y)) }
// A callee that only reads may read `x` where it is.
via_sum = (x :: Big) u64 { plus(x, 0) + plus(x, 1) }
main = () {
    b ::= Big(a: 1, b: 2, c: 3);
    println("{}", via_later(b, b));
    println("{}", sum(b));
    b = Big(a: 1, b: 2, c: 3);
    println("{}", via_args(b, b));
    println("{}", sum(b));
    b = Big(a: 1, b: 2, c: 3);
    println("{}", via_sum(b));
}
