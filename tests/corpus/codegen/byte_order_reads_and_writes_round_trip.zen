// Ptr<u8> byte-order verbs (mem_ptr.zen): little- and big-endian, 32 and
// 64 bits, at an unaligned offset, against the bytes written one at a time.
AllocError, Ptr = std.mem
Res, Ok, Range = std.core
Env = std.env
println = std.io
main = (env: Env) Res<(), AllocError> {
    a = env.mem.alloc();
    p = a.raw(16, 1).try();
    Range<usize>(0, 16).loop((i) { p.write(i, (i * 17 + 1).to_u8().value_or(0)); });
    println("{} {}", p.read_le32(1), p.read_be32(1));
    println("{} {}", p.read_le64(3), p.read_be64(3));
    p.write_be64(5, 0x0102030405060708);
    println("{} {} {}", p.read(5), p.read(12), p.read_le64(5));
    p.write_le32(0, 0xA1B2C3D4);
    println("{} {} {}", p.read(0), p.read(3), p.read_be32(0));
    Ok(())
}
