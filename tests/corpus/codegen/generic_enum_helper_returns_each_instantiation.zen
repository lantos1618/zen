// A generic body is checked once with `T` open, then emitted once per concrete
// call. The variant literal in that body must use the queued emission's
// `Box<i32>` or `Box<str>` layout, not the open memo shared by both copies.
// Otherwise Zen accepts this but C sees three incompatible Box structures.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box<T> = { Full: T | Empty }

some = <T>(value: T) Box<T> { Box.Full(value) }

pick_i32 = (value: Box<i32>) i32 {
    value.match({ Full(n) => n, Empty => 0 })
}

pick_str = (value: Box<str>) str {
    value.match({ Full(text) => text, Empty => "none" })
}

main = (env: Env) Res<i32, AllocError> {
    number: Box<i32> = some(41);
    text: Box<str>   = some("seven");
    println("{} {}", pick_i32(number), pick_str(text));
    (env.argv.len > 0).match({ true => Ok(0), false => Ok(9) })
}
