// A fixed unit parameter is evaluated but has no C storage. The following
// vararg pack must therefore be the callee's first emitted C argument.

Res, Ok = std.core
AllocError = std.mem
vararg = std.collections
Env = std.env
println = std.io

count = (unit: (), values: vararg<i32>) usize { values.len }

main = (env: Env) Res<i32, AllocError> {
    println("{}", count((), 10, 20));
    Ok(0);
}
