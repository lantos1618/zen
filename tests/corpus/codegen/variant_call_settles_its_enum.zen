// A generic variant constructor returns the instantiated enum. A payload-free
// variant instead takes its instantiation from the expected type.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box<T> = { Full: T | Empty }

pick = (o: Box<i32>) i32 {
    o.match({ Full(v) => v, Empty => 0 })
}

main = (env: Env) Res<i32, AllocError> {
    x = Box.Full(41);
    println("{}", pick(x));
    none: Box<i32> = Box.Empty;
    println("{}", pick(none));
    Ok(0);
}
