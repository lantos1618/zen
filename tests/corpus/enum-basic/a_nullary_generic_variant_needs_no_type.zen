// A nullary generic variant used only by match needs no annotation because no
// position demands type arguments for the value. Prints 0.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Opt<T> = { Some: T | None }

main = (env: Env) Res<i32, AllocError> {
    x = Opt.None;
    println("{}", x.match({ Some(v) => 1, None => 0 }));
    Ok(0);
}
