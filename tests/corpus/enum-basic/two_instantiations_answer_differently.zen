// TWO INSTANTIATIONS OF ONE GENERIC ENUM ANSWER DIFFERENTLY. The issue's
// own standing constraint: if the fix made pick(x) compile by mangling
// Box<i32> and Box<str> to one symbol, it would have converted a loud
// bug into a silent one. Both calls monomorphise separately, each value
// keeps its own payload width, and each answer is its own.
//
// Box<str>'s payload is a str; seven() hands the literal back through an
// annotated return so the callee owns its type. Prints 41 then seven.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box<T> = { Full: T | Empty }

pick_i32 = (o: Box<i32>) i32 { o.match({ Full(v) => v, Empty => 0 }) }

seven = () str { "seven" }

pick_str = (o: Box<str>) str { o.match({ Full(s) => s, Empty => "none" }) }

main = (env: Env) Res<i32, AllocError> {
    a = Box.Full(41);
    println("{}", pick_i32(a));
    b = Box.Full(seven());
    println("{}", pick_str(b));
    Ok(0);
}
