// `rename` retires a name and hands its contents to another in one step:
// a reader of the target sees the old file or the new one, never a mix.

{ Env, FsError } = std.env
{ Res, Ok } = std.core
{ println } = std.io

main = (env: Env) Res<i32, FsError> {
    a ::= env.mem.alloc();
    env.fs.write("candidate.txt", "fresh").try();
    env.fs.write("target.txt", "stale").try();
    env.fs.rename("candidate.txt", "target.txt").try();
    println("candidate still there {}", env.fs.exists("candidate.txt"));
    println("target holds {}", env.fs.read(a, "target.txt").try().view());

    // a source that is not there refuses, naming why
    env.fs.rename("never.txt", "target.txt").match({
        Ok(_)         => println("renaming a stranger succeeded"),
        Err(NotFound) => println("stranger NotFound"),
        Err(_)        => println("stranger failed otherwise"),
    });
    println("target kept {}", env.fs.read(a, "target.txt").try().view());
    Ok(0);
}
