// A record named in a written `A | B` is a case of that union: a match can
// bind it, and `.try()` widens a declared set into the written one.

{ Res, Ok, Err, Error } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Busy = { Waiting | Locked }
Busy.impl(Error, {})
Gone = { at: i32 }
Gone.impl(Error, {})
Fault = Busy | Gone

claim = (n: i32) Res<Fault> {
    n.match({
        0 => Ok,
        1 => Err(Busy.Locked),
        _ => Err(Gone(at: n)),
    })
}

release = (n: i32) Res<Busy | Gone> {
    claim(n).try();
    println("released {}", n);
}

show = (e: Busy | Gone) {
    e.match({
        Busy(b) => println("busy {}", b.variant_name()),
        Gone(g) => println("gone at {}", g.at),
    })
}

main = (env: Env) Res<i32, AllocError> {
    show(Gone(at: 3));
    show(Busy.Waiting);
    release(0).match({ Ok => println("ok"), Err(e) => show(e) });
    release(1).match({ Ok => println("ok"), Err(e) => show(e) });
    release(7).match({ Ok => println("ok"), Err(e) => show(e) });
    Ok(0);
}
