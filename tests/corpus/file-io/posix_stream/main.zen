Descriptor, FileError, open_read, create_temporary = std.fs.posix
AllocError, Ptr, null_ptr = std.mem
str_at = std.text
callback = std.native
Res, Ok, Err = std.core
Env, FsError = std.env
println = std.io
Native = c.bind("unistd.h", {
    pipe = (fds: Ptr<i32>) i32
    fork = () i32
    write = (fd: i32, bytes: Ptr<u8>, count: usize) i64
    close = (fd: i32) i32
    usleep = (micros: u32) i32
    alarm = (seconds: u32) u32
    _exit = (code: i32) ()
})
Signals = c.bind("signal.h", {
    signal = (number: i32, handler: Ptr<()>) Ptr<()>
    siginterrupt = (number: i32, interrupt: i32) i32
    SIGALRM: i32
})
Wait = c.bind("sys/wait.h", {
    waitpid = (pid: i32, status: Ptr<i32>, options: i32) i32
})
Failure = | Check
interrupted = (number: i32) {}

main = (env: Env) Res<i32, AllocError | FileError | FsError | Failure> {
    a    = env.mem.alloc();
    temp = create_temporary(a, "./stream-XXXXXX.bin", 4).try();
    @scope.defer(() { env.fs.remove(temp.path); });
    @scope.defer(() { temp.file.close(); });
    temp.file.write_all("abcdef").try();
    (temp.file.size().try() == 6).ensure(Failure.Check).try();
    temp.file.write_all("gh").try();
    (temp.file.size().try() == 8).ensure(Failure.Check).try();
    reader = open_read(a, temp.path).try();
    @scope.defer(() { reader.close(); });
    bytes = a.realloc<u8>(null_ptr<u8>(), 9).try();
    reader.read_exact(bytes, 2).try();
    (reader.size().try() == 8).ensure(Failure.Check).try();
    reader.read_exact(bytes.offset(2), 6).try();
    (str_at(bytes, 8) == "abcdefgh").ensure(Failure.Check).try();
    reader.read_exact(bytes, 1).match({
        Ok(_)      => Err(Failure.Check),
        Err(error) => error.match({UnexpectedEnd => Ok(()), _ => Err(Failure.Check)}),
    }).try();
    bad = Descriptor(fd: -1);
    bad.read_exact(null_ptr<u8>(), 0).try();
    bad.write_all("").try();
    bad.read_exact(bytes, 1).match({
        Ok(_)      => Err(Failure.Check),
        Err(error) => error.match({ReadFailed => Ok(()), _ => Err(Failure.Check)}),
    }).try();
    bad.write_all("x").match({
        Ok(_)      => Err(Failure.Check),
        Err(error) => error.match({WriteFailed => Ok(()), _ => Err(Failure.Check)}),
    }).try();
    open_read(a, "bad\0path").match({
        Ok(_)      => Err(Failure.Check),
        Err(error) => error.match({InvalidPath => Ok(()), _ => Err(Failure.Check)}),
    }).try();
    create_temporary(a, "missing-template", 0).match({
        Ok(_)      => Err(Failure.Check),
        Err(error) => error.match({InvalidPath => Ok(()), _ => Err(Failure.Check)}),
    }).try();
    // Force a partial read followed by EINTR before the final bytes arrive.
    // The child uses only native calls after fork; no actor/runtime work.
    fds = a.realloc<i32>(null_ptr<i32>(), 2).try();
    (Native.pipe(fds) == 0).ensure(Failure.Check).try();
    pid = Native.fork();
    (pid >= 0).ensure(Failure.Check).try();
    (pid == 0).then(() {
        Native.close(fds.read(0));
        Native.write(fds.read(1), "ab".ptr(), 2);
        Native.usleep(1500000);
        Native.write(fds.read(1), "cd".ptr(), 2);
        Native.close(fds.read(1));
        Native._exit(0);
    });
    Native.close(fds.read(1));
    pipe = Descriptor(fd: fds.read(0));
    @scope.defer(() { pipe.close(); });
    @scope.defer(() { Wait.waitpid(pid, null_ptr<i32>(), 0); });
    old = Signals.signal(Signals.SIGALRM, callback(interrupted));
    @scope.defer(() { Native.alarm(0); Signals.signal(Signals.SIGALRM, old); });
    (Signals.siginterrupt(Signals.SIGALRM, 1) == 0).ensure(Failure.Check).try();
    Native.alarm(1);
    pipe.read_exact(bytes, 4).try();
    (str_at(bytes, 4) == "abcd").ensure(Failure.Check).try();
    println(
        "streaming files: bytes, cursor, EOF, invalid descriptors and paths passed"
    );
    Ok(0)
}
