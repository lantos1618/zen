{ render } = fmt.fmt
{ scan, Source } = std.lex
SOURCE: str = "Native = c.bind(\"unit.h\", { call = () () })\nContract = {\n    required = () ()\n    hook ::= () ()\n}\nCallback = (value: i32) ()\nunit_value: () = ()\nfallible = () Res<(), ()> { Ok(()) }\napply = () { map(<T>(value: T) () { use(value); }); }\ntext: str = \"f = () () {}\"\n"
WANTED: str = "Native = c.bind(\"unit.h\", { call = () () })\nContract = {\n    required = () ()\n    hook ::= () ()\n}\nCallback = (value: i32) ()\nunit_value: () = ()\nfallible = () Res<(), ()> { Ok(()) }\napply = () { map(<T>(value: T) () { use(value); }); }\ntext: str = \"f = () () {}\"\n"
main = (env: Env) Res<(), AllocError> {
    a      = env.mem.alloc();
    result = render(
        a,
        scan(a, Source(file: "unit.zen", text: SOURCE)).try()
    ).try();
    second = render(
        a,
        scan(a, Source(file: "unit.zen", text: result.text.view())).try()
    ).try();
    println(
        "faithful {} exact {} fixed {} diagnostics {}",
        result.faithful && second.faithful,
        result.text.view().eq(WANTED),
        result.text.view().eq(second.text.view()),
        result.diags.len
    );
    Ok(())
}
