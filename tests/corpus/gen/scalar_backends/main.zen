Build, host_target = zen.zen_build
assemble_and_link = zen.zen_native
Generation, Layout = gen.gen
Codegen = std.build

// All three backends consume the same checked source. The output comparison
// catches reordered mutable reads, short-circuit effects, recursion, shadowed
// print sugar, and literal bytes; unsupported programs must never publish.
run = (
    env     : Env,
    a       : Alloc,
    backend : Codegen,
    source  : str,
    output  : str,
    code    : i32
)
      Res<bool, AllocError> {
    build ::= a.Build(env, "src/program");
    build.set_std_root("src");
    check = build.whole(source, a.Map<str, str>()).try();
    report ::= a.String().try();
    (check.diag_count() > 0).then(() {
        check.render_diags(report).try();
        println("frontend {}", report.view());
    });
    source_path = backend.match({ C => "candidate.c", Js => "candidate.js", Asm => "candidate.s" });
    host        = host_target(env, a).try();
    generation  = Generation(
        alloc: a,
        mem: env.mem,
        tree: build.tree,
        check: check,
        backend: backend,
        entry: 0,
        layout: Layout.Single,
        ffi: false,
        symbols: false,
        target: host
    );
    called ::= 0;
    faults = generation.emit(report, (artifact) {
        called = called + 1;
        Ok(
            env.fs.write(
                source_path,
                artifact.text
            ).match({ Ok(_) => 0, Err(_) => 1 })
        )
    }).try();
    (faults > 0).then(() { println("generation {}", report.view()); });
    good: Res<bool> = loop<bool>((h) {
        (build.diag_count() > 0 || check.diag_count() > 0 || faults > 0 || called != 1)
            .then(() { h.break(false); });
        args ::= a.Vec<str>();
        backend.match({
            Js  => { args.add("node").try(); args.add(source_path).try(); },
            // Native assembly uses the system assembler and linker only.
            Asm => {
                log ::= a.String().try();
                built = host.match({
                    Ok(machine) => assemble_and_link(
                        env,
                        a,
                        machine,
                        source_path,
                        "candidate",
                        false,
                        log
                    ).try(),
                    None        => false,
                });
                (!built).then(() { h.break(false); });
                args.add("./candidate").try();
            },
            _   => {
                compiler ::= a.Vec<str>();
                [str, 6]("cc", source_path, "-o", "candidate", "-pthread", "-lm")
                    .loop((word) { compiler.add(word).try(); });
                built = env.proc.run_argv(a, "", compiler).match({
                    Ok(result) => result.code == 0, Err(_) => false,
                });
                (!built).then(() { h.break(false); });
                args.add("./candidate").try();
            },
        });
        result = env.proc.run_argv(a, "", args).match({
            Err(_)     => false,
            Ok(result) => result.code == code && result.out.view().eq(output)
                && result.err.view().is_empty(),
        });
        h.break(result);
    });
    Ok(good.value_or(false))
}

// A refused program publishes nothing and reports at least one fault; when
// `what` is not empty, the report must name it.
refused = (
    env     : Env,
    a       : Alloc,
    backend : Codegen,
    source  : str,
    layout  : Layout,
    what    : str
)
          Res<bool, AllocError> {
    build ::= a.Build(env, "src/program");
    build.set_std_root("src");
    check = build.whole(source, a.Map<str, str>()).try();
    report ::= a.String().try();
    (check.diag_count() > 0).then(() {
        check.render_diags(report).try();
        println("frontend {}", report.view());
    });
    generation = Generation(
        alloc: a,
        mem: env.mem,
        tree: build.tree,
        check: check,
        backend: backend,
        entry: 0,
        layout: layout,
        ffi: false,
        symbols: false,
        target: host_target(env, a).try()
    );
    called ::= false;
    faults = generation.emit(report, (artifact) { called = true; Ok(0) }).try();
    Ok(build.diag_count() == 0 && check.diag_count() == 0 && faults > 0
        && !called && !report.view().is_empty()
        && (what.is_empty() || report.view().contains(what)))
}

// Construct expected NUL bytes independently of source literal spelling.
literal_output = (a: Alloc) Res<String, AllocError> {
    out ::= a.String().try();
    out.add("\\01|").try();
    [str, 5]("1|", "0|", "00|", "7|", "8|end\n").loop((tail) {
        out.add('\0').try();
        out.add(tail).try();
    });
    Ok(out)
}

c_literal_output = (a: Alloc) Res<String, AllocError> {
    out ::= a.String().try();
    out.add(
        "str 10 0 49 0 48 0 48 48 92 48 49\nmatch true\nsink 6 0 49 55 92 48 49\nconsole:"
    ).try();
    out.add('\0').try();
    out.add("1\n").try();
    Ok(out)
}

main = (env: Env) Res<(), AllocError> {
    [Codegen, 3](Codegen.C, Codegen.Js, Codegen.Asm).loop((backend) {
        a = env.mem.alloc();
        println(
            "{} evaluation {}",
            backend.stable_name(),
            run(
                env,
                a,
                backend,
                "program.zen",
                "2 23 4 8 false true 8\n{literal} 4\0\n",
                7
            ).try()
        );
        expected = literal_output(a).try();
        println(
            "{} literal bytes {}",
            backend.stable_name(),
            run(env, a, backend, "literal_bytes.zen", expected.view(), 0).try()
        );
        println(
            "{} shadow {}",
            backend.stable_name(),
            run(env, a, backend, "shadow.zen", "", 42).try()
        );
    });
    a        = env.mem.alloc();
    expected = c_literal_output(a).try();
    println(
        "c literal paths {}",
        run(env, a, Codegen.C, "literal_c.zen", expected.view(), 0).try()
    );
    // JavaScript and assembly render the full lowering, so both run these
    // with the C backend's meaning (64-bit literal arithmetic, a bool main
    // exits 0).
    [Codegen, 2](Codegen.Js, Codegen.Asm).loop((backend) {
        w = env.mem.alloc();
        println(
            "{} wide {}",
            backend.stable_name(),
            run(env, w, backend, "wide.zen", "12\n", 0).try()
        );
        println(
            "{} literal width {}",
            backend.stable_name(),
            run(env, w, backend, "literal_width.zen", "2147483648\n", 0).try()
        );
        println(
            "{} bool entry {}",
            backend.stable_name(),
            run(env, w, backend, "bool_entry.zen", "", 0).try()
        );
    });
    [Codegen, 2](Codegen.Js, Codegen.Asm).loop((backend) {
        b = env.mem.alloc();
        println(
            "{} constant time refused {}",
            backend.stable_name(),
            refused(
                env,
                a,
                backend,
                "constant_time.zen",
                Layout.Single,
                ""
            ).try()
        );
        println(
            "{} split refused {}",
            backend.stable_name(),
            refused(env, b, backend, "program.zen", Layout.Modules, "").try()
        );
        // `&`, `>>` and `~` lower as their named operations, never as another.
        println(
            "{} bitwise {}",
            backend.stable_name(),
            run(env, b, backend, "bitwise.zen", "8\n3\n4294967283\n", 0).try()
        );
        // The IR's shift is logical, so a signed shift_right is refused by
        // name rather than lowered as the logical shift.
        println(
            "{} signed shift refused {}",
            backend.stable_name(),
            refused(
                env,
                a,
                backend,
                "signed_shift.zen",
                Layout.Single,
                "an arithmetic shift of a signed word"
            ).try()
        );
    });
    Ok(())
}
