HARNESS_NATIVE_ASM* : bool = false
Build = zen.zen_build
Generation, Layout = gen.gen
Codegen = std.build

// All three backends consume the same checked source. The output comparison
// catches reordered mutable reads, short-circuit effects, recursion, shadowed
// print sugar, and literal bytes; unsupported programs must never publish.
run = (
    env     : Env,
    a       : Alloc,
    backend : Codegen,
    source  : str,
    output  : str,
    code    : i32
)
      Res<bool, AllocError> {
    build ::= a.Build(env, "src/program");
    build.set_std_root("src");
    check = build.whole(source, a.Map<str, str>()).try();
    report ::= a.String().try();
    (check.diag_count() > 0).then(() {
        check.render_diags(report).try();
        println("frontend {}", report.view());
    });
    source_path = backend.match({ C => "candidate.c", Js => "candidate.js", Asm => "candidate.s" });
    generation  = Generation(
        alloc: a,
        mem: env.mem,
        tree: build.tree,
        check: check,
        backend: backend,
        entry: 0,
        layout: Layout.Single,
        ffi: false,
        symbols: false
    );
    called ::= 0;
    faults = generation.emit(report, (artifact) {
        called = called + 1;
        Ok(
            env.fs.write(
                source_path,
                artifact.text
            ).match({ Ok(_) => 0, Err(_) => 1 })
        )
    }).try();
    (faults > 0).then(() { println("generation {}", report.view()); });
    good: Res<bool> = loop<bool>((h) {
        (build.diag_count() > 0 || check.diag_count() > 0 || faults > 0 || called != 1)
            .then(() { h.break(false); });
        (backend.match({ Asm => true, _ => false }) && !HARNESS_NATIVE_ASM).then(
            () { h.break(asm_object(env, a, source_path).try()); }
        );
        args ::= a.Vec<str>();
        backend.match({
            Js => { args.add("node").try(); args.add(source_path).try(); },
            _  => {
                compiler ::= a.Vec<str>();
                [str, 6]("cc", source_path, "-o", "candidate", "-pthread", "-lm")
                    .loop((word) { compiler.add(word).try(); });
                built = env.proc.run_argv(a, "", compiler).match({
                    Ok(result) => result.code == 0, Err(_) => false,
                });
                (!built).then(() { h.break(false); });
                args.add("./candidate").try();
            },
        });
        result = env.proc.run_argv(a, "", args).match({
            Err(_)     => false,
            Ok(result) => result.code == code && result.out.view().eq(output)
                && result.err.view().is_empty(),
        });
        h.break(result);
    });
    Ok(good.value_or(false))
}

refused = (env: Env, a: Alloc, backend: Codegen, source: str, layout: Layout)
          Res<bool, AllocError> {
    build ::= a.Build(env, "src/program");
    build.set_std_root("src");
    check = build.whole(source, a.Map<str, str>()).try();
    report ::= a.String().try();
    (check.diag_count() > 0).then(() {
        check.render_diags(report).try();
        println("frontend {}", report.view());
    });
    generation = Generation(
        alloc: a,
        mem: env.mem,
        tree: build.tree,
        check: check,
        backend: backend,
        entry: 0,
        layout: layout,
        ffi: false,
        symbols: false
    );
    called ::= false;
    faults = generation.emit(report, (artifact) { called = true; Ok(0) }).try();
    Ok(build.diag_count() == 0 && check.diag_count() == 0 && faults > 0
        && !called && !report.view().is_empty())
}

// Construct expected NUL bytes independently of source literal spelling.
literal_output = (a: Alloc) Res<String, AllocError> {
    out ::= a.String().try();
    out.add("\\01|").try();
    [str, 5]("1|", "0|", "00|", "7|", "8|end\n").loop((tail) {
        out.add('\0').try();
        out.add(tail).try();
    });
    Ok(out)
}

c_literal_output = (a: Alloc) Res<String, AllocError> {
    out ::= a.String().try();
    out.add(
        "str 10 0 49 0 48 0 48 48 92 48 49\nmatch true\nsink 6 0 49 55 92 48 49\nconsole:"
    ).try();
    out.add('\0').try();
    out.add("1\n").try();
    Ok(out)
}

main = (env: Env) Res<(), AllocError> {
    (!HARNESS_NATIVE_ASM).then(
        () { println(
            "asm checks assemble ELF objects; execution requires Linux x86_64 GNU"
        ); }
    );
    [Codegen, 3](Codegen.C, Codegen.Js, Codegen.Asm).loop((backend) {
        a = env.mem.alloc();
        println(
            "{} evaluation {}",
            backend.stable_name(),
            run(
                env,
                a,
                backend,
                "program.zen",
                "2 23 4 8 false true 8\n{literal} 4\0\n",
                7
            ).try()
        );
        expected = literal_output(a).try();
        println(
            "{} literal bytes {}",
            backend.stable_name(),
            run(env, a, backend, "literal_bytes.zen", expected.view(), 0).try()
        );
        println(
            "{} shadow {}",
            backend.stable_name(),
            run(env, a, backend, "shadow.zen", "", 42).try()
        );
    });
    a        = env.mem.alloc();
    expected = c_literal_output(a).try();
    println(
        "c literal paths {}",
        run(env, a, Codegen.C, "literal_c.zen", expected.view(), 0).try()
    );
    [Codegen, 2](Codegen.Js, Codegen.Asm).loop((backend) {
        a = env.mem.alloc();
        println(
            "{} wide refused {}",
            backend.stable_name(),
            refused(env, a, backend, "wide.zen", Layout.Single).try()
        );
        println(
            "{} literal width refused {}",
            backend.stable_name(),
            refused(env, a, backend, "literal_width.zen", Layout.Single).try()
        );
        println(
            "{} bool entry refused {}",
            backend.stable_name(),
            refused(env, a, backend, "bool_entry.zen", Layout.Single).try()
        );
        println(
            "{} split refused {}",
            backend.stable_name(),
            refused(env, a, backend, "program.zen", Layout.Modules).try()
        );
        println(
            "{} bitwise refused {}",
            backend.stable_name(),
            refused(env, a, backend, "bitwise.zen", Layout.Single).try()
        );
    });
    Ok(())
}

// A foreign host validates the real ELF object; execution remains a Linux
// x86-64 gate, never reported as having run on another instruction set.
asm_object = (env: Env, a: Alloc, source: str) Res<bool, AllocError> {
    args ::= a.Vec<str>();
    ["clang", "--target=x86_64-linux-gnu", "-c", source, "-o", "assembly.o"].loop((word) { args.add(word).try(); });
    result = env.proc.run_argv(
        a,
        "",
        args
    ).match({ Ok(r) => r.code == 0, Err(_) => false });
    (!result).match({
        true  => Ok(false),
        false => Ok(env.fs.read(a, "assembly.o").match({
            Err(_)   => false,
            Ok(file) => {
                bytes = file.view();
                bytes.len >= 20 && bytes.index(0) == 127 && bytes.slice(1, 4).eq("ELF")
                    && bytes.index(4) == 2 && bytes.index(5) == 1
                    && bytes.index(18) == 62 && bytes.index(19) == 0
            },
        })),
    })
}
