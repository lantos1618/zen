// A parameter only literals settle is i32 at its instance unless a literal
// does not fit: 5000000000 truncated to 32 bits would equal 705032704.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io
{ Eq } = std.core.eq

same = <U: Eq>(left: U, right: U) bool { left.eq(right) }

main = (env: Env) Res<i32, AllocError> {
    println("{}", same(5000000000, 705032704));
    println("{}", same(7, 7));
    Ok(0)
}
