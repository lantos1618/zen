// An imported struct-body constant has one value per type and folds through
// both `Type.NAME` and `value.NAME`; it never becomes instance storage.

Box = box.box
Res, Ok, IoError = std.core
Env = std.env
println = std.io

main = (env: Env) Res<i32, IoError> {
    b = Box();
    println("{}", Box.LIMIT);
    println("{}", b.LIMIT);
    Ok(0);
}
