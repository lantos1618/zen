// Importing Box makes its travelling function reachable through a Box with
// no further import: `b.describe()` finds it by the receiver's type. The bare
// spelling names the function, so it needs the function imported; once it
// is, both spellings resolve to the same function and print the same value.
// A bare call with no import is must-fail/sema/a_bare_call_needs_its_import.

Box, describe = box.box

main = (env: Env) Res<i32, IoError> {
    b = Box(label: 3);
    println("{}", b.describe());
    println("{}", describe(b));
    Ok(0);
}
