{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

seed: i32 = 5381
// a utf-8 BOM (EF BB BF) sits immediately before the first import, with no
// comment between. The BOM must be stripped EXACTLY -- one byte too few and
// `\xbf` is a stray character, one byte too many and the import binds `es`
// -- so the file compiling at all, and the value printed here, are what say
// the strip landed on the right boundary.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("{} {}", seed, seed * 2);
    Ok(0);
}
