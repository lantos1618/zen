{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// a line comment terminated by EOF rather than by a newline: the file
// does not end with \n.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("done");
    Ok(0);
}

// this comment is the last thing in the file and has no newline