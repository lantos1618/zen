Res, Ok, IoError = std.core
AllocError = std.mem
Env = std.env
println = std.io

// line endings are mixed: this line is LF
// this line is CRLF
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("mixed one");
    println("mixed two");
    /* a block comment
       spanning a CRLF boundary */
    Ok(0);
}
