// float literals. printed via comparison, because DESIGN.md does not
// say how many digits {} produces for an f64.
Error = AllocError | IoError

same = (a: f64, b: f64) str {
    (a == b).match({
        true  => "yes",
        false => "no",
    });
}

main = (env: Env) Res<i32, Error> {
    println("{}", same(1.0 + 1.0, 2.0));
    println("{}", same(0.5 + 0.5, 1.0));
    println("{}", same(0.0, 0.0));
    println("{}", same(1.25 * 4.0, 5.0));
    println("{}", same(1.0, 2.0));
    println("{}", same(0.125 * 8.0, 1.0));
    println("{}", same(12.5 / 2.0, 6.25));
    println("{}", same(-0.5 + 1.0, 0.5));
    Ok(0);
}
