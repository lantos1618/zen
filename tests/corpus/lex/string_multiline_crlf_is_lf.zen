{ println } = std.io

// Every line of this file ends with CRLF. A multi-line string's line
// breaks are LF in its value whatever the file's line endings, so the
// literal below is the same four bytes it would be in an LF file.
main = () i32 {
    text = """
        ab
        c
        """;
    println("{} {}", text.len, text == "ab\nc");
    0
}
