{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// indentation is hard tabs, including inside the match arms.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
	n: i32 = 1;
	label = (n == 1).match({
		true  => "one",
		false => "other",
	});
	println("{}", label);
	Ok(0);
}
