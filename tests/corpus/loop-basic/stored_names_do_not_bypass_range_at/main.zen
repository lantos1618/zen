// A type satisfying Range through an impl is not the concrete Range
// intrinsic merely because it also has fields named start and end. Its at
// hook still decides the value handed to each pass.

{ Res, Ok, Range, Seq } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Window = {
    start*: usize,
    end*: usize,
}

Window.impl(Seq<usize>, {
    start: self.start,
    end: self.end,

    at ::= (self: @Self, index: usize) Res<usize> { Ok(index + 100) }
})

main = (env: Env) Res<i32, AllocError> {
    Window(start: 2, end: 4).loop((h, index, value) {
        println("{} {}", index, value);
    });
    Ok(0);
}
