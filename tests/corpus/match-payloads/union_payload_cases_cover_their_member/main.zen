// THE PAYLOAD CASES OF A SET MEMBER COVER THAT MEMBER. On
// `Res<T, Kind | Fail>` with `Kind = Io(i32) | Protocol(i32)`, the arms
// `Err(Protocol(c))` and `Err(Io(c))` between them take every `Kind`, so
// with `Err(Fail)` and `Ok(v)` the match is exhaustive with no `_`. The
// checker once read a payload case as a constructor of the set itself,
// disjoint from `Kind`: it demanded an arm for `Err` that nothing could
// reach, and accepted an `Err(Protocol(c))` placed after `Err(Kind)`.

Kind = Io(i32) | Protocol(i32)
Fail = Mismatch | Accepted
Both = Kind | Fail

pick = (n: i32) Res<i32, Kind | Fail> {
    n.match({ 0 => Err(Kind.Io(7)), 1 => Err(Kind.Protocol(9)), 2 => Err(Fail.Accepted), _ => Ok(n) })
}

pick_both = (n: i32) Res<i32, Both> {
    n.match({ 0 => Err(Kind.Io(7)), 1 => Err(Kind.Protocol(9)), 2 => Err(Fail.Mismatch), _ => Ok(n) })
}

inline = (r: Res<i32, Kind | Fail>) i32 {
    r.match({ Err(Protocol(c)) => c, Err(Io(c)) => 100 + c, Err(Fail) => -1, Ok(v) => v })
}

declared = (r: Res<i32, Both>) i32 {
    r.match({
        Err(Io(c))       => 100 + c,
        Err(Protocol(c)) => c,
        Err(Mismatch)    => -2,
        Err(Accepted)    => -1,
        Ok(v)            => v,
    })
}

main = (env: Env) Res<i32, AllocError> {
    println(
        "{} {} {} {}",
        inline(pick(0)),
        inline(pick(1)),
        inline(pick(2)),
        inline(pick(5))
    );
    println(
        "{} {} {} {}",
        declared(pick_both(0)),
        declared(pick_both(1)),
        declared(pick_both(2)),
        declared(pick_both(5))
    );
    Ok(0);
}
