// `app` exports an item `shape` and `app.shape` is also a module. The
// exported item wins, so adding a module never changes what an existing
// import binds.
shape = app.shape
{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, IoError> {
    println("{}", shape(1));
    Ok(0);
}
