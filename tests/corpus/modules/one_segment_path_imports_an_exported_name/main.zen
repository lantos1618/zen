// `Name = module` imports `Name` when that module exports it, as the
// multi-name form `Name, other = module` does. With nothing but the one
// segment, the declaration used to read as a module alias whatever the
// module exported, so the struct and function below could only be
// written `Circle.<name>`. A binding the module does not export is still
// a module alias, and `sh.area` and `ut.twice` pin that reading.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Circle = shapes
area = shapes
Util = util
twice = util
sh = shapes
ut = util

main = (env: Env) Res<i32, AllocError> {
    c = Circle(r: 2);
    u = Util(k: 5);
    println("{} {}", area(c), twice(u));
    println("{} {}", sh.area(sh.Circle(r: 3)), ut.twice(u));
    Ok(0);
}
