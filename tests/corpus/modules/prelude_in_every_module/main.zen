{ half } = work.work
{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, IoError> {
    half(8).match({
        Ok(v) => println("{}", v),
        None  => println("odd"),
    });
    half(7).match({
        Ok(v) => println("{}", v),
        None  => println("odd"),
    });
    Ok(0);
}
