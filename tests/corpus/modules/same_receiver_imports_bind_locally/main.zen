// two modules export `pick` for the same first-parameter type; each
// importer calls the one it imported, in bare and dot form alike
{ Tag } = tag.tag
{ via_one } = wa.wa
{ via_two } = wb.wb
{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, IoError> {
    t = Tag(v: 0);
    println("{} {}", via_one(t, 1), via_two(t, 2));
    Ok(0);
}
