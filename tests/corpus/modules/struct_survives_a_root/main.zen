// the consumer names the folder, never the file inside it
{ Circle, area, unit } = geo.geo
{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, IoError> {
    println("{}", unit().radius);
    println("{}", unit().area());
    println("{}", Circle(radius: 4).area());
    Ok(0);
}
