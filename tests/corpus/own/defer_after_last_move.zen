// A defer registered after the last move of what it reads is fine: the
// closure's copy is the value the block still owns, and the defer runs
// before that value is dropped.

{ Res, Ok, Drop, IoError } = std.core
{ Env } = std.env
{ println } = std.io

Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) { println("drop {}", self.id) } })

main = (env: Env) Res<i32, IoError> {
    b = Buf(id: 3);
    g = consume b;
    @scope.defer(() { println("deferred {}", g.id) });
    println("moved {}", g.id);
    Ok(0)
}
