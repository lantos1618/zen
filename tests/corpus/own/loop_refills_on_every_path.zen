// The loop body moves `cur` out and every arm refills it, so each run
// starts with a live `cur`. After the loop it is live too.

{ Res, Ok, None, Drop, Range, IoError } = std.core
{ Env } = std.env
{ println } = std.io

Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) { println("drop {}", self.id) } })
sink = (b: Buf) { println("sink {}", b.id) }
fresh = (n: i32) Res<Buf> { (n > 1).match({ true => Ok(Buf(
    id: n
)), false => None }) }

main = (env: Env) Res<i32, IoError> {
    cur ::= Buf(id: 1);
    Range(1, 3).loop((h, i) {
        g = consume cur;
        sink(g);
        fresh(i).match({
            Ok(n) => { cur = consume n; },
            None  => { cur = Buf(id: 0); },
        });
    });
    println("last {}", cur.id);
    Ok(0)
}
