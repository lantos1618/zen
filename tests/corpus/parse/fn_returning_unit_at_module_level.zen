// Explicit unit returns remain valid parser input. Executable functions use
// the canonical omitted annotation; the quoted source preserves the legacy
// lookahead case where a second parenthesized group denotes the return type.
scan, Source = std.lex
Parser, module = std.parse
Res, Ok = std.core
AllocError = std.mem
Env = std.env
println = std.io

SOURCE: str = "shout = (env: Env, n: i32) () {}\n"

shout = (env: Env, n: i32) { println("{}", n * 6 + 4) }

// the signature-only spelling of the same thing, which has no `{` after
// it at all and must still not be read as a call
Sink = {
    put* = (self: @Self, e: Env, n: i32) ()
}

Doubler = { factor: i32 }

Doubler.impl(Sink, {
    put* = (self: @Self, e: Env, n: i32) { println("{}", n * self.factor) }
})

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    lexed = scan(alloc, Source(file: "unit.zen", text: SOURCE)).try();
    p ::= alloc.Parser(lexed);
    m     = p.module("unit").try();
    valid = m.decls.get(0).match({
        Ok(d) => d.kind.match({
            Function(f) => f.body.match({ Ok(_) => true, None => false }) && f.params.len == 2 && f.ret.match({
                Ok(t) => p.tree.type_at(
                    t
                ).kind.match({ Unit => true, _ => false }),
                None  => false,
            }),
            _           => false,
        }),
        None  => false,
    });
    (!valid || lexed.diags.len != 0 || p.diags.len != 0 || m.decls.len != 1).then(() {
        println("explicit unit return was not parsed as a function");
    });
    shout(env, 7);
    d = Doubler(factor: 3);
    d.put(env, 14);
    d.put(env, 100);
    Ok(0);
}
