// `+` and `+%` are the SAME precedence and associate LEFT.
// a + b +% c is (a + b) +% c = 2147483646.
// the other reading, a + (b +% c), is -3 + -2147483647 and TRAPS on
// overflow -- so a wrong precedence here is a non-zero exit, not a
// wrong number.
// ASSUMPTION: DESIGN.md never says where `+%` sits relative to `+`.

Res, Ok = std.core
Env, ArgError = std.env
println = std.io

main = (env: Env) Res<i32, ArgError> {
    a: i32 = -3;
    b: i32 = 2147483647;
    c: i32 = 2;
    v      = a + b +% c;
    println("{}", v);
    Ok(0);
}
