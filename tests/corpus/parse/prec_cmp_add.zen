// `+` binds tighter than `==`: 1 + 2 == 3 is (1 + 2) == 3.
// the other reading, 1 + (2 == 3), does not type-check.

{ Res, Ok } = std.core
{ Env, ArgError } = std.env
{ println } = std.io

main = (env: Env) Res<i32, ArgError> {
    (1 + 2 == 3).match({
        true  => println("yes"),
        false => println("no"),
    });
    Ok(0);
}
