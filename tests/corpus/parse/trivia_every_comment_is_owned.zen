// Every comment and blank belongs to exactly one source-ordered AST trivia
// run. Total run length detects omissions; monotonic indices detect duplicates.
//
// One comment per placement that has a distinct owner:
//
//    1  // before the declaration              -> Point.leading
//    2  Point = {
//    3      x: i32,
//    4  }
//    5                                         -> blank, name.leading
//    6  name = (b: bool) str {
//    7      b.match({
//    8          // first inside the arm body   -> arm.leading
//    9          true => "c",
//   10         false => "s",
//   11     });
//   12 } // trailing on the closing brace     -> name.trailing
//   13                                         -> blank, f.leading
//   14  f = () () {
//   15      // the only content of a closure body
//   16                                        ->>> f.body.trailing
//   17  }
//   18                                        -> blank, main.leading
//   19  main = () () {
//   20      {
//   21          // the only content of a bare block
//   22                                        ->>> bare-block.trailing
//   23      }
//   24  }
//   25  // at end of file                     -> Module.trailing

{ scan, Source } = std.lex.lex
{ Parser, module } = std.parse
{ Ast } = std.ast.ast_arena
{ TriviaRun } = std.ast.ast_span
{ ExprId, TypeId, PatternId, BlockId } = std.ast.ast_id
{ Decl, Struct, Enum, Alias, Function, Impl, Import, Const } = std.ast.ast_node
{ Module, Block, Stmt, Bind, ExprStmt } = std.ast.ast_node
{ Expr, Name, Literal, Paren, ArrayLit, FixedArray } = std.ast.ast_node
{ Lambda, Call, Match, Try, Record, Access, Index } = std.ast.ast_node
{ Unary, Binary, Consume, Meta, Arg, Arm } = std.ast.ast_node
{ Type, Named, Union, FnType, ArrayType } = std.ast.ast_node
{ Pattern, PatName, Destructure } = std.ast.ast_node
{ Member, Field, Param, TParam, ImportName } = std.ast.ast_node
{ Res, Ok, Range } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

SOURCE: str = "// before the declaration\nPoint = {\n    x: i32,\n}\n\nname = (b: bool) str {\n    b.match({\n        // first inside the arm body\n        true => \"c\",\n        false => \"s\",\n    });\n} // trailing on the closing brace\n\nf = () () {\n    // the only content of a closure body\n}\n\nmain = () () {\n    {\n        // the only content of a bare block\n    }\n}\n// at end of file\n"

// The walk's state. `last` and `started` turn the whole audit into one
// comparison per piece: see the ordering argument in the header.
Walk = {
    tree*: Ast,
    claimed* :: usize = 0,
    bad* :: usize = 0,
    started* :: bool = false,
    last* :: usize = 0,
}

add = (w :: Walk, run: TriviaRun, label: str) Res<(), AllocError> {
    w.claimed = w.claimed + run.len;
    Range(0, run.len).loop((h, i) {
        piece = w.tree.trivia_at(run, i);
        (w.started && run.at + i <= w.last).match({
            true  => {
                w.bad = w.bad + 1;
                println(
                    "  {} names piece {} (line {}) again or out of order",
                    label,
                    run.at + i,
                    piece.span.start.line
                );
            },
            false => { w.last = run.at + i; w.started = true; },
        });
    });
    Ok(());
}

// -------------------------------------------------------------------
// one walk per node family
//
// Each adds the runs its nodes carry — both of them, the empty ones
// costing nothing — around walking the children, so the order pieces
// are met in is their source order. A family without trivia runs
// (Ident, QualifiedName, spans) has no case here.
// -------------------------------------------------------------------

walk_module = (w :: Walk, m: Module) Res<(), AllocError> {
    add(w, m.leading, "module.leading").try();
    Range(0, m.decls.len).loop((h, i) {
        m.decls.get(i).match({
            Ok(d) => walk_decl(w, d),
            None  => println("  module.decls.get({}) was None", i),
        }).try();
    });
    add(w, m.trailing, "module.trailing").try();
    Ok(());
}

walk_decl = (w :: Walk, d: Decl) Res<(), AllocError> {
    add(w, d.leading, "decl.leading").try();
    d.kind.match({
        Struct(s)   => {
            s.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            s.members.loop((h, mem) { walk_member(w, mem).try() });
        },
        Enum(e)     => {
            e.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            e.variants.loop((h, v) {
                add(w, v.leading, "variant.leading").try();
                v.payload.match({
                    Ok(t) => walk_type(w, t),
                    None  => (),
                }).try();
                v.discriminant.match({
                    Ok(x) => walk_expr(w, x),
                    None  => (),
                }).try();
                add(w, v.trailing, "variant.trailing").try();
            });
        },
        Alias(a)    => {
            a.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            walk_type(w, a.target);
        },
        Function(f) => {
            f.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            f.params.loop((h, pm) { walk_param(w, pm).try() });
            f.ret.match({
                Ok(t) => walk_type(w, t),
                None  => (),
            }).try();
            f.body.match({
                Ok(b) => walk_block(w, block_of(w, b)),
                None  => (),
            });
        },
        Impl(im)    => im.members.loop((h, mem) { walk_member(w, mem).try() }),
        Import(im)  => im.names.loop((h, n) {
            add(w, n.leading, "import-name.leading").try();
            add(w, n.trailing, "import-name.trailing").try();
        }),
        Const(c)    => walk_expr(w, c.value),
    });
    add(w, d.trailing, "decl.trailing").try();
    Ok(());
}

walk_member = (w :: Walk, mem: Member) Res<(), AllocError> {
    add(w, mem.leading, "member.leading").try();
    mem.kind.match({
        Field(f)    => f.value.match({
            Ok(v) => walk_expr(w, v),
            None  => (),
        }),
        Const(c)    => walk_expr(w, c.value),
        Function(f) => {
            f.params.loop((h, pm) { walk_param(w, pm).try() });
            f.ret.match({
                Ok(t) => walk_type(w, t),
                None  => (),
            }).try();
            f.body.match({
                Ok(b) => walk_block(w, block_of(w, b)),
                None  => (),
            });
        },
    }).try();
    add(w, mem.trailing, "member.trailing").try();
    Ok(());
}

walk_block = (w :: Walk, b: Block) Res<(), AllocError> {
    add(w, b.leading, "block.leading").try();
    b.stmts.loop((h, s) { walk_stmt(w, s).try() });
    b.value.match({
        Ok(v) => walk_expr(w, v),
        None  => (),
    }).try();
    add(w, b.trailing, "block.trailing").try();
    Ok(());
}

walk_stmt = (w :: Walk, s: Stmt) Res<(), AllocError> {
    add(w, s.leading, "stmt.leading").try();
    s.kind.match({
        Bind(bd)    => {
            walk_expr(w, bd.target).try();
            bd.type.match({
                Ok(t) => walk_type(w, t),
                None  => (),
            }).try();
            walk_expr(w, bd.value);
        },
        Deferred(d) => {
            walk_expr(w, d.target).try();
            walk_type(w, d.type).try();
        },
        Expr(es)    => walk_expr(w, es.expr),
        Decl(d)     => walk_decl(w, d),
        Block(bid)  => walk_block(w, block_of(w, bid)),
    }).try();
    add(w, s.trailing, "stmt.trailing").try();
    Ok(());
}

walk_expr = (w :: Walk, id: ExprId) Res<(), AllocError> {
    e = w.tree.expr_at(id);
    add(w, e.leading, "expr.leading").try();
    e.kind.match({
        Name(_)        => (),
        Literal(_)     => (),
        Unit           => (),
        SelfType       => (),
        Scope          => (),
        Meta(mt)       => mt.value.match({
            Ok(v) => walk_expr(w, v),
            None  => (),
        }).try(),
        Paren(pa)      => walk_expr(w, pa.inner).try(),
        Array(arr)     => arr.elems.loop((h, el) { walk_expr(w, el).try() }),
        FixedArray(fa) => {
            walk_type(w, fa.type).try();
            fa.elems.loop((h, el) { walk_expr(w, el).try() });
        },
        Lambda(l)      => {
            l.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            l.params.loop((h, pm) { walk_param(w, pm).try() });
            l.ret.match({
                Ok(t) => walk_type(w, t),
                None  => (),
            }).try();
            walk_block(w, block_of(w, l.body)).try();
        },
        Call(c)        => {
            walk_expr(w, c.callee).try();
            c.targs.loop((h, t) { walk_type(w, t).try() });
            c.args.loop((h, arg) { walk_arg(w, arg).try() });
        },
        Match(mt)      => {
            walk_expr(w, mt.scrutinee).try();
            mt.arms.loop((h, arm) {
                add(w, arm.leading, "arm.leading").try();
                walk_pattern(w, arm.pattern).try();
                walk_expr(w, arm.body).try();
                add(w, arm.trailing, "arm.trailing").try();
            });
        },
        Try(ty)        => {
            walk_expr(w, ty.operand).try();
            ty.error.match({ Ok(e) => walk_expr(w, e), None => Ok(()) }).try();
        },
        Record(r)      => r.entries.loop(
            (h, mem) { walk_member(w, mem).try() }
        ),
        Access(a)      => walk_expr(w, a.base).try(),
        Index(ix)      => {
            walk_expr(w, ix.base).try();
            walk_expr(w, ix.index).try();
        },
        Unary(u)       => walk_expr(w, u.operand).try(),
        Binary(bn)     => {
            walk_expr(w, bn.lhs).try();
            walk_expr(w, bn.rhs).try();
        },
        Consume(cn)    => walk_expr(w, cn.operand).try(),
        Block(bid)     => walk_block(w, block_of(w, bid)).try(),
    });
    add(w, e.trailing, "expr.trailing").try();
    Ok(());
}

walk_arg = (w :: Walk, arg: Arg) Res<(), AllocError> {
    add(w, arg.leading, "arg.leading").try();
    walk_expr(w, arg.value).try();
    add(w, arg.trailing, "arg.trailing").try();
    Ok(());
}

walk_pattern = (w :: Walk, id: PatternId) Res<(), AllocError> {
    pt = w.tree.pattern_at(id);
    add(w, pt.leading, "pattern.leading").try();
    pt.kind.match({
        Name(_)         => (),
        Wild            => (),
        Literal(_)      => (),
        Destructure(ds) => walk_pattern(w, ds.binder).try(),
    });
    add(w, pt.trailing, "pattern.trailing").try();
    Ok(());
}

walk_param = (w :: Walk, pm: Param) Res<(), AllocError> {
    add(w, pm.leading, "param.leading").try();
    pm.type.match({
        Ok(t) => walk_type(w, t),
        None  => (),
    }).try();
    add(w, pm.trailing, "param.trailing").try();
    Ok(());
}

walk_tparam = (w :: Walk, tp: TParam) Res<(), AllocError> {
    add(w, tp.leading, "tparam.leading").try();
    tp.bounds.loop((h, b) { walk_type(w, b).try() });
    add(w, tp.trailing, "tparam.trailing").try();
    Ok(());
}

walk_type = (w :: Walk, id: TypeId) Res<(), AllocError> {
    t = w.tree.type_at(id);
    add(w, t.leading, "type.leading").try();
    t.kind.match({
        Named(n)  => n.args.loop((h, arg) { walk_type(w, arg).try() }),
        Union(u)  => u.members.loop((h, m) { walk_type(w, m).try() }),
        Fn(ft)    => {
            ft.tparams.loop((h, tp) { walk_tparam(w, tp).try() });
            ft.params.loop((h, pm) { walk_param(w, pm).try() });
            walk_type(w, ft.ret);
        },
        Array(at) => {
            walk_type(w, at.elem).try();
            walk_expr(w, at.count);
        },
        Unit      => (),
        SelfType  => (),
        Infer     => (),
        Variadic  => (),
    });
    add(w, t.trailing, "type.trailing").try();
    Ok(());
}

block_of = (w: Walk, id: BlockId) Block { w.tree.block_at(id) }

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    lexed = scan(alloc, Source(file: "t.zen", text: SOURCE)).try();
    p ::= alloc.Parser(lexed);
    m = p.module("t").try();
    println("lex {} parse {}", lexed.diags.len, p.diags.len);

    w ::= Walk(tree: p.tree);
    walk_module(w, m).try();

    // The one number the runs have to add up to.
    total = p.tree.trivia_count();
    println("trivia pieces {} claimed by runs {}", total, w.claimed);
    (w.claimed == total).match({
        true  => println("every comment is named by exactly one trivia run"),
        false => {
            println(
                "{} of {} pieces of trivia are named by no run at all",
                total - w.claimed,
                total
            );
            w.bad = w.bad + 1;
        },
    });

    failed ::= w.bad > 0 || p.diags.len > 0;
    failed.match({
        true  => Ok(1),
        false => Ok(0),
    });
}
