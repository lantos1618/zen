// `println` and `print` are declarations in std.io, imported like any other
// name. The compiler supplies their bodies and still reads a leading string
// literal as a format at compile time, on every backend.
println, print = std.io

main = () i32 {
    n = 42;
    print("a{}b ", n);
    println("n = {n}");
    println(n, n);
    println("{{}}");
    0
}
