// Unit has no C storage, but its printable spelling is still `()`.
// Pin both a format hole and the value-only console form.

{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("unit {}", ());
    println(());
    Ok(0);
}
