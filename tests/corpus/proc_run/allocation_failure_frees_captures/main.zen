// Sweep allocation failures through argument preparation, pipe setup and
// output capture. Every failed run must leave the next process runnable.

{ Res, Ok, Err, Range } = std.core
{ Alloc, AllocError, Ptr } = std.mem
{ Env } = std.env
{ println } = std.io

FailAfter = {
    base: Alloc,
    left: Ptr<usize>,

    take = (self: @Self) bool {
        n = self.left.read(0);
        (n == 0).match({
            true  => false,
            false => {
                self.left.write(0, n - 1);
                true
            },
        })
    }
}

FailAfter.impl(Alloc, {
    raw = (self: @Self, size: usize, align: usize)
          Res<Ptr<u8>, AllocError> {
        self.take().match({
            true  => self.base.raw(size, align),
            false => Err(AllocError.OutOfMemory),
        })
    }

    realloc = <T>(self: @Self, p: Ptr<T>, count: usize)
                Res<Ptr<T>, AllocError> {
        self.take().match({
            true  => self.base.realloc(p, count),
            false => Err(AllocError.OutOfMemory),
        })
    }
})

main = (env: Env) Res<AllocError> {
    alloc ::= env.mem.alloc();
    left  ::= alloc.Vec<usize>();
    left.add(0).try();
    failing = FailAfter(base: alloc, left: left.ptr());
    errors    ::= false;
    completed ::= false;
    valid     ::= true;
    Range<usize>(0, 32).loop((budget) {
        left.ptr().write(0, budget);
        env.proc.run(failing, "", "printf out; printf err >&2").match({
            Ok(value) => {
                completed = true;
                valid     = valid && value.code == 0 && value.out.view().eq("out") && value.err.view().eq("err");
            },
            Err(e)    => {
                errors = true;
                valid  = valid && e.match({ ReadFailed => true, _ => false });
            },
        });
    });
    println("allocation failures {} completion {}", errors && valid, completed);
}
