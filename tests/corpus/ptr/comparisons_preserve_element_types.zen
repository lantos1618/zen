main = (env: Env) Res<i32, AllocError> {
    a  = env.mem.alloc();
    p0 = a.create<u8>().try();
    p0.write(0, 199);
    before0 = p0.read(0);
    p0.write(0, 200);
    (p0.read(0) == before0 + 1).ensure(AllocError.OutOfMemory).try();
    (before0 + 1 == p0.read(0)).ensure(AllocError.OutOfMemory).try();
    (p0.read(0) != before0).ensure(AllocError.OutOfMemory).try();
    (before0 != p0.read(0)).ensure(AllocError.OutOfMemory).try();
    (p0.read(0) > before0).ensure(AllocError.OutOfMemory).try();
    (before0 < p0.read(0)).ensure(AllocError.OutOfMemory).try();
    (p0.read(0) >= before0 + 1).ensure(AllocError.OutOfMemory).try();
    (before0 + 1 <= p0.read(0)).ensure(AllocError.OutOfMemory).try();
    p1 = a.create<u64>().try();
    p1.write(0, 4294967298);
    before1 = p1.read(0);
    p1.write(0, 4294967299);
    (p1.read(0) == before1 + 1).ensure(AllocError.OutOfMemory).try();
    (before1 + 1 == p1.read(0)).ensure(AllocError.OutOfMemory).try();
    (p1.read(0) != before1).ensure(AllocError.OutOfMemory).try();
    (before1 != p1.read(0)).ensure(AllocError.OutOfMemory).try();
    (p1.read(0) > before1).ensure(AllocError.OutOfMemory).try();
    (before1 < p1.read(0)).ensure(AllocError.OutOfMemory).try();
    (p1.read(0) >= before1 + 1).ensure(AllocError.OutOfMemory).try();
    (before1 + 1 <= p1.read(0)).ensure(AllocError.OutOfMemory).try();
    p2 = a.create<usize>().try();
    p2.write(0, 2);
    before2 = p2.read(0);
    p2.write(0, 3);
    (p2.read(0) == before2 + 1).ensure(AllocError.OutOfMemory).try();
    (before2 + 1 == p2.read(0)).ensure(AllocError.OutOfMemory).try();
    (p2.read(0) != before2).ensure(AllocError.OutOfMemory).try();
    (before2 != p2.read(0)).ensure(AllocError.OutOfMemory).try();
    (p2.read(0) > before2).ensure(AllocError.OutOfMemory).try();
    (before2 < p2.read(0)).ensure(AllocError.OutOfMemory).try();
    (p2.read(0) >= before2 + 1).ensure(AllocError.OutOfMemory).try();
    (before2 + 1 <= p2.read(0)).ensure(AllocError.OutOfMemory).try();
    p3 = a.create<i32>().try();
    p3.write(0, -8);
    before3 = p3.read(0);
    p3.write(0, -7);
    (p3.read(0) == before3 + 1).ensure(AllocError.OutOfMemory).try();
    (before3 + 1 == p3.read(0)).ensure(AllocError.OutOfMemory).try();
    (p3.read(0) != before3).ensure(AllocError.OutOfMemory).try();
    (before3 != p3.read(0)).ensure(AllocError.OutOfMemory).try();
    (p3.read(0) > before3).ensure(AllocError.OutOfMemory).try();
    (before3 < p3.read(0)).ensure(AllocError.OutOfMemory).try();
    (p3.read(0) >= before3 + 1).ensure(AllocError.OutOfMemory).try();
    (before3 + 1 <= p3.read(0)).ensure(AllocError.OutOfMemory).try();
    p4 = a.create<f32>().try();
    p4.write(0, 2.5);
    before4 = p4.read(0);
    p4.write(0, 3.5);
    (p4.read(0) == before4 + 1).ensure(AllocError.OutOfMemory).try();
    (before4 + 1 == p4.read(0)).ensure(AllocError.OutOfMemory).try();
    (p4.read(0) != before4).ensure(AllocError.OutOfMemory).try();
    (before4 != p4.read(0)).ensure(AllocError.OutOfMemory).try();
    (p4.read(0) > before4).ensure(AllocError.OutOfMemory).try();
    (before4 < p4.read(0)).ensure(AllocError.OutOfMemory).try();
    (p4.read(0) >= before4 + 1).ensure(AllocError.OutOfMemory).try();
    (before4 + 1 <= p4.read(0)).ensure(AllocError.OutOfMemory).try();
    p5 = a.create<f64>().try();
    p5.write(0, 2.5);
    before5 = p5.read(0);
    p5.write(0, 3.5);
    (p5.read(0) == before5 + 1).ensure(AllocError.OutOfMemory).try();
    (before5 + 1 == p5.read(0)).ensure(AllocError.OutOfMemory).try();
    (p5.read(0) != before5).ensure(AllocError.OutOfMemory).try();
    (before5 != p5.read(0)).ensure(AllocError.OutOfMemory).try();
    (p5.read(0) > before5).ensure(AllocError.OutOfMemory).try();
    (before5 < p5.read(0)).ensure(AllocError.OutOfMemory).try();
    (p5.read(0) >= before5 + 1).ensure(AllocError.OutOfMemory).try();
    (before5 + 1 <= p5.read(0)).ensure(AllocError.OutOfMemory).try();
    println("comparisons preserve numeric elements");
    Ok(0)
}
