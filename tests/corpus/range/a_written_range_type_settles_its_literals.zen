Range = std.core
println, print = std.io

// A binding's written type settles bounds that are all literals, exactly as
// written type arguments do. The two spellings are one type.
show = (r: Range<i32>) {
    r.loop((v) { print("{} ", v); });
    println("");
}

main = () i32 {
    r: Range<i32> = Range(0, 3);
    show(r);
    show(Range<i32>(5, 7));
    small: Range<u8> = Range(253, 255);
    small.loop((v) { println("{}", v); });
    0
}
