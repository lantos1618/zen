// A standard-library name grants an operation only after signature validation.
{ Source, scan } = std.lex
{ Parser } = std.parse.parser
{ module } = std.parse.parse_decl
{ Checker } = sema.sema_check
{ check_all } = sema.sema_decl
{ DeclId } = sema.sema_id
{ CHeader, CTypeBinding, CBinding } = std.ast
{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

accepts = (a: Alloc, text: str, owner: str) Res<bool, AllocError> {
    lexed = scan(a, Source(file: "numeric.zen", text: text)).try();
    parser ::= a.Parser(lexed);
    parsed = parser.module(owner).try();
    parser.tree.add_module(parsed).try();
    checker ::= a.Checker(parser.tree).try();
    checker.check_all().try();
    operation = checker.integer_bits.get(DeclId(module: 0, decl: 0));
    Ok(
        checker.diag_count() == 0 && operation.match({ Ok(_) => true, None => false })
    )
}

foreign_keeps_binding = (a: Alloc) Res<bool, AllocError> {
    lexed = scan(
        a,
        Source(file: "native.zen", text: "bit_xor* = (value: c_int) c_int\n")
    ).try();
    parser ::= a.Parser(lexed);
    parsed = parser.module("native").try();
    parser.tree.add_c_module(
        parsed,
        CBinding(headers: a.Vec<CHeader>(), types: a.Vec<CTypeBinding>())
    ).try();
    checker ::= a.Checker(parser.tree).try();
    checker.check_all().try();
    Ok(
        checker.diag_count() == 0 && checker.integer_bits.get(DeclId(
            module: 0,
            decl: 0
        )).match({ None => true, _ => false })
    )
}

main = (env: Env) Res<AllocError> {
    a = env.mem.alloc();
    println(
        "registered: {}",
        accepts(
            a,
            "bit_xor* = (self: u64, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "owner: {}",
        accepts(
            a,
            "bit_xor* = (self: u64, other: u64) u64\n",
            "pretend.num"
        ).try()
    );
    println(
        "result: {}",
        accepts(
            a,
            "bit_xor* = (self: u64, other: u64) bool\n",
            "std.core.num"
        ).try()
    );
    println(
        "source: {}",
        accepts(
            a,
            "bit_xor* = (self: bool, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "arity: {}",
        accepts(a, "bit_xor* = (self: u64) u64\n", "std.core.num").try()
    );
    println(
        "mutable: {}",
        accepts(
            a,
            "bit_xor* = (self :: u64, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "private: {}",
        accepts(
            a,
            "bit_xor = (self: u64, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "generic: {}",
        accepts(
            a,
            "bit_xor* = <T>(self: T, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "body: {}",
        accepts(
            a,
            "bit_xor* = (self: u64, other: u64) u64 { 7 }\n",
            "std.core.num"
        ).try()
    );
    println(
        "rotate: {}",
        accepts(
            a,
            "rotate_right* = (self: u64, count: usize) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "rotate count: {}",
        accepts(
            a,
            "rotate_right* = (self: u64, count: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "u32 xor: {}",
        accepts(
            a,
            "bit_xor* = (self: u32, other: u32) u32\n",
            "std.core.num"
        ).try()
    );
    println(
        "u32 rotate: {}",
        accepts(
            a,
            "rotate_right* = (self: u32, count: usize) u32\n",
            "std.core.num"
        ).try()
    );
    println(
        "u32 and: {}",
        accepts(
            a,
            "bit_and* = (self: u32, other: u32) u32\n",
            "std.core.num"
        ).try()
    );
    println(
        "u64 and: {}",
        accepts(
            a,
            "bit_and* = (self: u64, other: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "shift: {}",
        accepts(
            a,
            "shift_right* = (self: u32, count: usize) u32\n",
            "std.core.num"
        ).try()
    );
    println(
        "mixed: {}",
        accepts(
            a,
            "bit_and* = (self: u64, other: u32) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "shift count: {}",
        accepts(
            a,
            "shift_right* = (self: u64, count: u64) u64\n",
            "std.core.num"
        ).try()
    );
    println(
        "and owner: {}",
        accepts(
            a,
            "bit_and* = (self: u64, other: u64) u64\n",
            "pretend.num"
        ).try()
    );
    println("foreign: {}", foreign_keeps_binding(a).try());
}
