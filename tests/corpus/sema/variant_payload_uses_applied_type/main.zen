{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box<T> = { Full: T | Empty }

value = (o: Box<i64>) i64 { o.match({ Full(v) => v, Empty => 0 }) }

main = (env: Env) Res<i32, AllocError> {
    contextual: Box<i64> = Box.Full(5000000000);
    explicit             = Box.Full<i64>(5000000000);
    println("{} {}", value(contextual), value(explicit));
    Ok(0);
}
