// A name that is not imported is not visible, and there is no prelude.
//
// DESIGN.md, Modules: "`Res`, `Ok`, `Vec`, `String`, `Env` and `println`
// are ordinary declarations in `std`, and a module that names one imports
// it like any other name. ... a compiler that resolves any exported
// top-level name program-wide makes 'two modules may define the same
// top-level name' impossible, which is the property the flat namespace
// exists to provide."
//
// The negative properties carry the weight: a fallback that answers every
// name is the whole-program table that paragraph rules out, and it would
// pass the positive tests alone.
//
//   - a std.core name does not resolve without an import       -> no
//   - it resolves where it is imported                         -> yes
//   - a primitive's name resolves to std.core's declaration of
//     it with no import, because the primitive is built in     -> yes
//   - a name reported as a missing import resolves afterwards,
//     so one omission is one diagnostic                        -> yes
//   - a name NOT imported from another module does not         -> no
//   - the same name DOES resolve where it was imported          -> yes
//   - two modules declaring one name are two declarations, and
//     each module sees its OWN                                  -> yes
//
// The last is the property the whole rule exists to protect, so it is
// asserted rather than assumed: `own` and `other` both declare `Widget`
// and neither imports the other.
//
// The AST is built through the arena API rather than parsed: this is a
// test of name resolution, and routing it through a parser would make a
// parser bug read as a resolution bug.

World, Def, CORE = sema.sema_def
Ast = std.ast.ast_arena
Decl, DeclKind, Struct, Import, ImportName, Member, Module = std.ast.ast_node
TParam = std.ast.ast_node
Pos, Span, Ident, QualifiedName, no_trivia = std.ast.ast_span
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Res, Ok = std.core
Env = std.env
println = std.io

at = () Span {
    Span(file: "in.zen", start: Pos(line: 1, col: 1), end: Pos(line: 1, col: 2))
}

id_of = (text: str) Ident { Ident(text: text, span: at()) }

// a struct declaration, starred or not. `exported` is the whole of the
// visibility rule at the DECLARATION hop, and it is a parameter here so
// the unstarred case can be asked for.
struct_decl = (a: Alloc, text: str, exported: bool) Res<Decl, AllocError> {
    members ::= a.Vec<Member>();
    tparams ::= a.Vec<TParam>();
    Ok(Decl(
        kind: DeclKind.Struct(Struct(
            name: id_of(text),
            exported: exported,
            tparams: tparams,
            members: members,
            body_span: at()
        )),
        span: at(),
        leading: no_trivia(),
        trailing: no_trivia()
    ));
}

// `Widget = other` — one binding, not re-exported. The `*` on the
// IMPORT is what re-exports; this deliberately has none.
import_decl = (a: Alloc, name: str, module: str) Res<Decl, AllocError> {
    segments ::= a.Vec<Ident>();
    segments.add(id_of(module)).try();
    names ::= a.Vec<ImportName>();
    names.add(ImportName(
        name: id_of(name),
        exported: false,
        span: at(),
        leading: no_trivia(),
        trailing: no_trivia()
    )).try();
    Ok(Decl(
        kind: DeclKind.Import(Import(
            names: names,
            module: QualifiedName(segments: segments, span: at())
        )),
        span: at(),
        leading: no_trivia(),
        trailing: no_trivia()
    ));
}

module_of = (tree :: Ast, name: str, decls: Vec<Decl>)
            Res<(), AllocError> {
    tree.add_module(Module(
        name: name,
        decls: decls,
        span: at(),
        leading: no_trivia(),
        trailing: no_trivia()
    )).try();
    Ok(());
}

// The question, and the answer as a reader can check it: how many
// declarations of `name` module `mi` can see, and which module each one
// came from — because "two modules may define the same top-level name"
// means a count alone would not tell them apart.
visible = (w :: World, a: Alloc, label: str, mi: usize, name: str)
          Res<(), AllocError> {
    found ::= a.Vec<Def>();
    w.defs_of(mi, name, found).try();
    out ::= a.String().try();
    found.loop((h, d) {
        out.add(" ").try();
        out.add(d.qname).try();
    });
    println("{}: {}{}", label, found.len, out.view());
    Ok(());
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    tree  ::= alloc.Ast();

    // module 0 IS std.core — the name is `CORE`'s, because a module is
    // addressable by its full dotted path only and the resolver finds
    // this one by that spelling
    core ::= alloc.Vec<Decl>();
    core.add(struct_decl(alloc, "Vec", true).try()).try();
    core.add(struct_decl(alloc, "i32", true).try()).try();
    module_of(tree, CORE, core).try();

    // module 1: declares `Gadget` and its own `Widget`, exports both
    other ::= alloc.Vec<Decl>();
    other.add(struct_decl(alloc, "Gadget", true).try()).try();
    other.add(struct_decl(alloc, "Widget", true).try()).try();
    module_of(tree, "other", other).try();

    // module 2: imports nothing at all
    bare ::= alloc.Vec<Decl>();
    module_of(tree, "bare", bare).try();

    // module 3: imports `Gadget` from `other` and `Vec` from std.core, and
    // declares a `Widget` of its OWN — the collision the flat namespace has
    // to survive
    own ::= alloc.Vec<Decl>();
    own.add(import_decl(alloc, "Gadget", "other").try()).try();
    own.add(import_decl(alloc, "Vec", CORE).try()).try();
    own.add(struct_decl(alloc, "Widget", true).try()).try();
    module_of(tree, "own", own).try();

    w ::= alloc.World(tree).try();

    // std.core is not in scope without an import
    visible(w, alloc, "bare sees Vec", 2, "Vec").try();

    // and an import is what makes it visible
    visible(w, alloc, "own sees Vec", 3, "Vec").try();

    // a primitive's name is the language's, and std.core declares it
    visible(w, alloc, "bare sees i32", 2, "i32").try();

    // after a missing import is reported, the name resolves as its
    // import would
    w.grant(2, "Vec").try();
    visible(w, alloc, "bare sees a reported Vec", 2, "Vec").try();

    // nothing from another module is visible without an import
    visible(w, alloc, "bare sees Gadget", 2, "Gadget").try();

    // a written import is what makes it visible
    visible(w, alloc, "own sees Gadget", 3, "Gadget").try();

    // and each module sees its OWN Widget, which is the property the
    // whole rule exists to provide
    visible(w, alloc, "own sees Widget", 3, "Widget").try();
    visible(w, alloc, "other sees Widget", 1, "Widget").try();

    // a module that imported nothing sees neither
    visible(w, alloc, "bare sees Widget", 2, "Widget").try();
    Ok(0);
}
