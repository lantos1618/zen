// One declaration drives parsing, typed dispatch and help.

{ Vec } = std.collections
{ str, String } = std.text
{ Command, command, Spec, Kind, Matches } = std.cli
{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ println, print } = std.io

Id = { Verbose | Quiet | Jobs | Mode | Input | Define }

main = (env: Env) Res<i32, AllocError> {
    a     ::= env.mem.alloc();
    model ::= tool(a).try();

    show(
        a,
        model,
        model.parse(env, line(a, "-v --jobs=4 main.zen -D one").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(
            env,
            line(a, "main.zen -Dtwo --define three --mode small").try(),
            1
        ).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "--jobs nope main.zen").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "--jobs --quiet main.zen").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "--mode fast main.zen").try(), 1).try()
    ).try();
    show(a, model, model.parse(env, line(a, "--verbose").try(), 1).try()).try();
    show(
        a,
        model,
        model.parse(env, line(a, "-v -v main.zen").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "--bogus main.zen").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "main.zen extra").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "--verbose=yes main.zen").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "main.zen --help --bogus").try(), 1).try()
    ).try();
    show(
        a,
        model,
        model.parse(env, line(a, "-- -literal").try(), 1).try()
    ).try();

    text = model.help().try();
    print("{}", text.view());
    Ok(0)
}

tool = (a: Alloc) Res<Command<Id>, AllocError> {
    cmd ::= command<Id>(a, "tool build", "Build one input");
    cmd.note("Environment:\n  TOOL_HOME  Where tool keeps its cache");
    cmd.flag(
        Id.Verbose,
        "--verbose",
        Spec(short: 'v', help: "Print more detail")
    ).try();
    cmd.flag(Id.Quiet, "--quiet", Spec(help: "Print no detail")).try();
    cmd.option(
        Id.Jobs,
        "--jobs",
        Spec(
            value: "N",
            kind: Kind.Unsigned,
            default: "2",
            help: "Worker count"
        )
    ).try();
    cmd.option(
        Id.Mode,
        "--mode",
        Spec(value: "MODE", choices: "debug|release|small", help: "Build mode")
    ).try();
    cmd.option(
        Id.Define,
        "--define",
        Spec(short: 'D', value: "NAME", many: true, help: "Add a definition")
    ).try();
    cmd.positional(
        Id.Input,
        "INPUT",
        Spec(required: true, help: "Input path")
    ).try();
    Ok(cmd)
}

show = (a: Alloc, model: Command<Id>, parsed: Matches<Id>) Res<AllocError> {
    parsed.problem.match({
        Err(usage) => {
            message = usage.message(a, model.name).try();
            println("error: {}", message.view());
        },
        Ok         => parsed.help.match({
            true  => println("help"),
            false => {
                out ::= a.String().try();
                parsed.found.loop((f) {
                    name   = f.id.match({
                        Verbose => "verbose",
                        Quiet   => "quiet",
                        Jobs    => "jobs",
                        Mode    => "mode",
                        Input   => "input",
                        Define  => "define",
                    });
                    origin = f.origin.match({ Line => "", Variable => " (env)", Default => " (default)" });
                    out.fmt(" {}={}{}", name, f.text, origin).try();
                });
                println("ok{}", out.view());
            },
        }),
    });
}

// Space-separated words after the program name.
line = (a: Alloc, words: str) Res<Vec<str>, AllocError> {
    argv ::= a.Vec<str>();
    argv.add("tool").try();
    words.split(' ').loop((word) { argv.add(word).try(); });
    Ok(argv)
}
