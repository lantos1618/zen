// A malformed declaration is reported before any word is read.

{ Vec } = std.collections
{ Command, command, Spec, Kind, Arg } = std.cli
{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Id = { A | B }

main = (env: Env) Res<i32, AllocError> {
    a ::= env.mem.alloc();

    twice ::= command<Id>(a, "tool", "");
    twice.flag(Id.A, "--same", Spec()).try();
    twice.flag(Id.B, "--same", Spec()).try();
    show(env, a, twice).try();

    shorts ::= command<Id>(a, "tool", "");
    shorts.flag(Id.A, "--alpha", Spec(short: 'x')).try();
    shorts.flag(Id.B, "--beta", Spec(short: 'x')).try();
    show(env, a, shorts).try();

    help ::= command<Id>(a, "tool", "");
    help.flag(Id.A, "--alpha", Spec(short: 'h')).try();
    show(env, a, help).try();

    single ::= command<Id>(a, "tool", "");
    single.flag(Id.A, "-a", Spec()).try();
    show(env, a, single).try();

    distinct ::= command<Id>(a, "tool", "");
    distinct.flag(Id.A, "--alpha", Spec(short: 'a')).try();
    distinct.flag(Id.B, "--beta", Spec(short: 'b')).try();
    show(env, a, distinct).try();

    switch_default ::= command<Id>(a, "tool", "");
    switch_default.flag(Id.A, "--alpha", Spec(default: "true")).try();
    show(env, a, switch_default).try();

    bad_default ::= command<Id>(a, "tool", "");
    bad_default.option(
        Id.A,
        "--count",
        Spec(kind: Kind.Unsigned, default: "many")
    ).try();
    show(env, a, bad_default).try();

    unlisted ::= command<Id>(a, "tool", "");
    unlisted.option(
        Id.A,
        "--mode",
        Spec(choices: "fast|small", default: "slow")
    ).try();
    show(env, a, unlisted).try();

    spelled ::= command<Id>(a, "tool", "");
    spelled.positional(Id.A, "INPUT", Spec(short: 'i')).try();
    show(env, a, spelled).try();

    order ::= command<Id>(a, "tool", "");
    order.positional(Id.A, "MAYBE", Spec()).try();
    order.positional(Id.B, "NEEDED", Spec(required: true)).try();
    show(env, a, order).try();

    unreachable ::= command<Id>(a, "tool", "");
    unreachable.positional(Id.A, "MANY", Spec(many: true)).try();
    unreachable.positional(Id.B, "LATER", Spec()).try();
    show(env, a, unreachable).try();

    ambiguous ::= command<Id>(a, "tool", "");
    ambiguous.command(Id.B, "run", "").try();
    ambiguous.positional(Id.A, "INPUT", Spec()).try();
    show(env, a, ambiguous).try();

    itself ::= command<Id>(a, "tool", "");
    alpha = itself.flag(Id.A, "--alpha", Spec()).try();
    itself.requires(alpha, alpha).try();
    show(env, a, itself).try();
    Ok(0)
}

show = (env: Env, a: Alloc, model: Command<Id>) Res<AllocError> {
    argv ::= a.Vec<str>();
    argv.add("tool").try();
    parsed = model.parse(env, argv, 1).try();
    parsed.problem.match({
        Ok         => println("clean"),
        Err(usage) => {
            message = usage.message(a, model.name).try();
            println("{}", message.view());
        },
    });
}
