// An option's value is the next word unless that word is itself an option;
// numeric options also take negative numbers.

{ Vec } = std.collections
{ Command, command, Spec, Kind, Matches } = std.cli
{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Id = { Text | Number | Unsigned | Other }

main = (env: Env) Res<i32, AllocError> {
    a     ::= env.mem.alloc();
    model ::= command<Id>(a, "tool", "");
    model.option(Id.Text, "--text", Spec()).try();
    model.option(Id.Number, "--number", Spec(kind: Kind.Signed)).try();
    model.option(Id.Unsigned, "--unsigned", Spec(kind: Kind.Unsigned)).try();
    model.flag(Id.Other, "--other", Spec()).try();

    show(a, model.parse(env, line(a, "--text --other").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--number -1").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--number --other").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--number=-1").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--text=-x").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--number=").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--text --").try(), 1).try()).try();
    show(a, model.parse(env, line(a, "--unsigned -1").try(), 1).try()).try();
    show(
        a,
        model.parse(env, line(a, "--unsigned --other").try(), 1).try()
    ).try();
    Ok(0)
}

show = (a: Alloc, parsed: Matches<Id>) Res<AllocError> {
    parsed.problem.match({
        Err(usage) => {
            message = usage.message(a, "tool").try();
            println("error: {}", message.view());
        },
        Ok         => parsed.found.loop((f) {
            f.id.match({
                Text     => println("text `{}`", f.text),
                Number   => println("number `{}`", f.text),
                Unsigned => println("unsigned `{}`", f.text),
                Other    => println("other"),
            });
        }),
    });
}

line = (a: Alloc, words: str) Res<Vec<str>, AllocError> {
    argv ::= a.Vec<str>();
    argv.add("tool").try();
    words.split(' ').loop((word) { argv.add(word).try(); });
    Ok(argv)
}
