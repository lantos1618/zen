{ Res, Ok, Err } = std.core
{ Alloc, AllocError, Ptr } = std.mem
{ Env } = std.env
{ println } = std.io

// create<T> must call the supplied allocator once, with T's layout, and
// propagate refusal before the caller can access a pointer.
Probe = {
    base: Alloc,
    calls: Ptr<usize>,
    size: Ptr<usize>,
    alignment: Ptr<usize>,
    refuse: bool,
}
Probe.impl(Alloc, {
    raw = (self: @Self, size: usize, align: usize) Res<Ptr<u8>, AllocError> {
        self.calls.write(0, self.calls.read(0) + 1);
        self.size.write(0, size);
        self.alignment.write(0, align);
        self.refuse.match({ true => Err(AllocError.OutOfMemory), false => self.base.raw(size, align) })
    }
    realloc = <T>(self: @Self, p: Ptr<T>, count: usize) Res<Ptr<T>, AllocError> {
        self.base.realloc(p, count)
    }
})
make = (a: Alloc) Res<i32, AllocError> {
    p = a.create<i32>().try();
    p.write(0, 42);
    Ok(p.read(0))
}
main = (env: Env) Res<(), AllocError> {
    base      = env.mem.alloc();
    calls     = base.create<usize>().try();
    size      = base.create<usize>().try();
    alignment = base.create<usize>().try();
    calls.write(0, 0);
    size.write(0, 0);
    alignment.write(0, 0);
    probe = Probe(
        base: base,
        calls: calls,
        size: size,
        alignment: alignment,
        refuse: false
    );
    println("value {}", make(probe).try());
    println(
        "calls {} size {} aligned {}",
        calls.read(0),
        size.read(0),
        alignment.read(0) >= 4 && alignment.read(0) % 4 == 0
    );
    refused = Probe(
        base: base,
        calls: calls,
        size: size,
        alignment: alignment,
        refuse: true
    );
    make(refused).match({ Ok(_) => println("refusal ignored"), Err(OutOfMemory) => println("refused") });
    println("calls {}", calls.read(0));
    Ok(())
}
