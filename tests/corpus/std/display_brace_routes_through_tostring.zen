// tests/corpus/std/display_brace_routes_through_tostring.zen
// {} in a format string routes through the type's toString. this
// is the same machinery for a Point nested in a sentence and for a
// Point printed on its own

Res, Ok, Display, IoError, WriteError, Sink = std.core
AllocError = std.mem
Env = std.env
println = std.io

Error = AllocError | IoError

Point = {
    x: i32,
    y: i32,
}

Point.impl(Display, {
    toString ::= (self: @Self, out :: Sink) Res<(), WriteError> {
        out.fmt("{}:{}", self.x, self.y)
    }
})

main = (env: Env) Res<i32, Error> {
    alloc ::= env.mem.alloc();
    p = Point(x: 7, y: 8);

    s = alloc.String("point {}", p).try();
    println("{}", s.view());
    println("{} then {}", p, "done");
    Ok(0);
}
