// tests/corpus/std/drop_runs_at_inner_block_exit.zen
// each block owns its own bindings: the inner one dies at the
// inner brace, the outer one survives it and dies at the end of
// main. a drop hoisted to the end of the function prints these
// two in the wrong order

Res, Ok, Drop = std.core
AllocError = std.mem
Env = std.env
println = std.io

Noisy = {
    id: i32,
    env: Env,
}

Noisy.impl(Drop, {
    drop = (self :: @Self) {
        env = self.env;
        println("drop {}", self.id);
    }
})

main = (env: Env) Res<i32, AllocError> {
    outer = Noisy(id: 1, env: env);
    println("outer alive");
    {
        inner = Noisy(id: 2, env: env);
        println("inner alive");
    }
    println("between");
    Ok(0);
}
