Env, FsError, fs_message = std.env
Res, Ok = std.core
AllocError = std.mem
println = std.io

main = (env: Env) Res<(), AllocError> {
    println("{}", fs_message(FsError.NotFound));
    println("{}", fs_message(FsError.Denied));
    println("{}", fs_message(FsError.IsDir));
    println("{}", fs_message(FsError.Exists));
    println("{}", fs_message(FsError.Failed));
    println("{}", fs_message(FsError.OutOfMemory));
    Ok(())
}
