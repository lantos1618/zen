// Equal str bytes address the same map entry across different bindings.

Res, Ok = std.core
AllocError = std.mem
Env = std.env
println = std.io

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    ages  ::= alloc.Map<str, i32>();

    ages.set("ada", 36).try();
    ages.set("grace", 45).try();

    ages.get("ada").match({
        Ok(n) => println("ada {}", n),
        None  => println("ada missing"),
    });
    ages.get("grace").match({
        Ok(n) => println("grace {}", n),
        None  => println("grace missing"),
    });
    Ok(0);
}
