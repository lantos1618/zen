Res, Ok, Path = std.core
AllocError = std.mem
Env = std.env
println = std.io

main = (env: Env) Res<(), AllocError> {
    path = Path("src/app/main.zen");
    println("{}", path.name());
    println("{}", path.parent().value_or(Path("")).text);
    println("{}", path.ext().value_or(""));
    println("{}", Path("LICENSE").ext().match({
        Ok(_) => true,
        None  => false,
    }));
    Ok(())
}
