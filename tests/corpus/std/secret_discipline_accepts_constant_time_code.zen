// Code the secret discipline accepts: masks, wrapping arithmetic, wide
// products, public indices into secret memory, secret fields, secret
// results, stores through Secret pointers, and explicit declassification.
Secret, declassify, Choice = std.ct
ct_eq, ct_lt, ct_select, ct_swap, ct_memeq, ct_lookup = std.ct
bit_xor, bit_and, shift_right, mul_wide, truncate_u64, truncate_u8 = std.core.num
to_u64 = std.core.num
Ptr = std.mem

Key = { bytes: Secret<Ptr<u8>>, len: usize }

// Sum of the key's bytes: the index is public, the pointee secret.
checksum = (key: Key) Secret<u64> {
    acc :: u64 = 0;
    Range(0, key.len).loop((i) { acc = acc +% key.bytes.read(i).to_u64(); });
    acc
}

// A branch-free minimum and a high product word.
min_mul = (a: Secret<u64>, b: Secret<u64>) Secret<u64> {
    low = ct_lt(a, b).ct_select(a, b);
    low.mul_wide(b).shift_right(64).truncate_u64() +% low
}

// Montgomery-ladder shaped: swap by a secret bit, through Secret pointers.
ladder_step = (x: Secret<Ptr<u64>>, y: Secret<Ptr<u64>>, bit: Secret<u64>) {
    ct_swap(x, y, 4, ct_eq(bit.bit_and(1), 1));
    Range<usize>(0, 4).loop((i) { x.write(i, x.read(i) +% y.read(i)); });
}

// A secret result: the written result type says so, so it may leave.
decode = (bytes: Secret<Ptr<u8>>) Secret<u8> { bytes.read(0).bit_xor(90) }

// Names resolve to their binding: `bit` in the second loop is a new,
// public binding, and a call whose result is not written Secret is public
// (its own body is checked against that promise).
bits = (key: Secret<u64>) u64 {
    acc :: u64 = 0;
    Range<usize>(0, 4).loop((i) {
        bit = key.shift_right(i).bit_and(1);
        acc = acc +% declassify(bit);
    });
    Range(0, 4).loop((i) {
        bit = i;
        (bit != 2).then(() { acc = acc +% 1; });
    });
    ok = is_small(key);
    ok.match({ true => acc, false => acc +% 100 })
}

is_small = (key: Secret<u64>) bool { ct_lt(key, 16).declassify_bool() }

main = (env: Env) Res<(), AllocError> {
    a   = env.mem.alloc();
    raw = a.raw(16, 16).try();
    Range<usize>(0, 16).loop((i) { raw.write(i, i.truncate_u8() *% 17); });
    key   = Key(bytes: raw, len: 16);
    total = checksum(key);
    println("checksum {}", declassify(total));
    println("min_mul {}", declassify(min_mul(18446744073709551615, 3)));
    println("bits {}", bits(5));

    words = a.raw(64, 16).try().to<u64>();
    Range<usize>(0, 8).loop((i) { words.write(i, i.to_u64()); });
    ladder_step(words, words.offset(4), 1);
    println(
        "ladder {} {} {} {}",
        words.read(0),
        words.read(3),
        words.read(4),
        words.read(7)
    );

    // Public decisions come from declassify at a visible point.
    tag: Secret<Ptr<u8>> = raw;
    same                 = ct_memeq(tag, raw, 16);
    same.declassify_bool().then(() { println("tags equal"); });
    println("lookup {}", declassify(ct_lookup(tag, 16, 3)));
    println("decode {}", declassify(decode(tag)));
    Ok(())
}
