{ Suite } = std.test
{ Res, IoError } = std.core
{ Env } = std.env

main = (env: Env) Res<i32, IoError> {
    suite ::= Suite(env: env);
    suite.run("pass", (test) { test.expect_eq(4, 4) }).try();
    suite.run("fail", (test) { test.expect(false) }).try();
    suite.run("after failure", (test) { test.expect(true) }).try();
    suite.finish()
}
