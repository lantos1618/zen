// tests/corpus/std/vec_grows_past_sixteen.zen
// grows 0 -> 1 -> 2 -> 4 -> 8 -> 16 -> 32; read back through get
// rather than loop, so this fails if realloc moved the buffer and
// indexed access still points at the old pages

{ Res, Ok, Range } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    v     ::= alloc.Vec<i32>();

    Range<i32>(0, 8).loop((h, n) {
        v.add(n).try();
    });
    at8 = v.ptr();
    Range<i32>(8, 17).loop((h, n) { v.add(n).try(); });

    println("len {}", v.len);
    println("latest grew in place {}", at8.same(v.ptr()));
    Range<usize>(0, 17).loop((h, i) {
        v.get(i).match({
            Ok(n) => println("{}", n),
            None  => println("missing {}", i),
        });
    });
    Ok(0);
}
