// Volatile pointer access, the compiler barrier, `wipe`, and forced inlining.
AllocError, Ptr, compiler_barrier, wipe = std.mem
rotate_left = std.core.num
Res, Ok, Range = std.core
Env = std.env
println = std.io

// A module-level `inline` function is inlined into every caller.
mix = inline (a: u32, b: u32) u32 { a.bit_xor(b).rotate_left(7) +% b }

inline = (x: u32) u32 { x + 1 }

twice = inline <T>(value: T) T { value }

main = (env: Env) Res<(), AllocError> {
    a     = env.mem.alloc();
    words = a.raw(32, 16).try().to<u32>();
    Range(0, 8).loop((i) { words.write_volatile(i, i.truncate_u32() *% 16843009); });
    total: u32 ::= 0;
    Range(0, 8).loop((i) { total = total +% words.read_volatile(i); });
    println("volatile sum: {}", total);
    compiler_barrier();
    bytes = words.to<u8>();
    wipe(bytes, 20);
    println("wiped: {} {} {}", bytes.read(0), bytes.read(19), bytes.read(20));
    wipe(bytes, 0);
    wipe(words.to<u64>().offset(1), 2);
    println("wiped words: {} {}", words.read(5), words.read(6));
    println("mix: {} {}", mix(1, 2), mix(4294967295, 1));
    // A function merely named `inline` is still an ordinary call.
    println("named inline: {} {}", inline(41), twice(5));
    Ok(())
}
