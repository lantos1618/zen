// The closing `"""` line's indentation is removed from every line, so the
// literal can sit at the code's indentation while deeper lines keep their
// extra indentation. A line of only whitespace is an empty line of text,
// whatever its width.
show = (text: str) {
    text.lines().loop((line) { println("|{}|", line); });
}

main = () i32 {
    show("""
        fn main() {
            body();

        }
        """);
    // Closing at column 1 strips nothing.
    show("""
  two spaces
    four spaces
""");
    // The closing line sets the indentation, not the least-indented line.
    show("""
            twelve
        eight
        """);
    0
}
