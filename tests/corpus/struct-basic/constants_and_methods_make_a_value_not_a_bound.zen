// A type whose only data members are defaulted constants is still a value:
// `Caps()` constructs it and its methods read the constants. It is not a
// bound, though it declares functions and no stored fields.
{ println } = std.io

Caps = {
    limit: usize = 3,
    name: str = "caps",

    describe = (self: @Self) usize { self.limit + 1 }
}

main = () {
    c = Caps();
    println("{} {} {}", c.describe(), c.limit, c.name);
}
