// TWO MODULES EACH EXPORT A FUNCTION OF THE SAME NAME ON THEIR OWN TYPE,
// both are imported, and both are called in one file. The receiver's type
// picks; neither import order nor declaration order may.
//
// The two types are deliberately shaped alike (small i32 fields) so a body
// compiled against the wrong type still links and prints a plausible
// number, not garbage.
//
// Breaks if: an overload set gathered from two imports is resolved by name
// instead of by parameter type -- `b.span()` answers 34 (P's body) instead
// of 13.

Box, span = box.box
P, span = pt.pt

main = (env: Env) Res<i32, AllocError> {
    b = Box(w: 3, h: 4);
    println("box {}", b.span());
    println("p   {}", span(P(w: 30)));
    println("p-dot {}", P(w: 30).span());
    Ok(0);
}
