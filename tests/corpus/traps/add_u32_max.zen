// tests/corpus/traps/add_u32_max.zen
// u32.MAX + 1 traps. unsigned overflow is still overflow: it
// wraps only where +% says so

Res, Ok = std.core
OutOfBounds = std.collections
Env = std.env
println = std.io

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = Overflow | DivideByZero | OutOfBounds

main = (env: Env) Res<i32, Error> {
    x: u32 = u32.MAX;
    sum    = x + 1;
    println("{}", sum);
    Ok(0);
}
