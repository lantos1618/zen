// tests/corpus/traps/mul_u16_max.zen
// u16.MAX * 2 traps: the product needs one more bit than u16 has

{ Res, Ok } = std.core
{ OutOfBounds } = std.collections
{ Env } = std.env
{ println } = std.io

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = { Overflow | DivideByZero | OutOfBounds }

main = (env: Env) Res<i32, Error> {
    x: u16  = u16.MAX;
    product = x * 2;
    println("{}", product);
    Ok(0);
}
