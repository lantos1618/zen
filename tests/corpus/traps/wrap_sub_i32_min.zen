// tests/corpus/traps/wrap_sub_i32_min.zen
// i32.MIN -% 1 does NOT trap. it wraps to i32.MAX and exits 0

{ Res, Ok } = std.core
{ OutOfBounds } = std.collections
{ Env } = std.env
{ println } = std.io

// main must name an error type. a trap never lifts into Res:
// it aborts the process
Error = { Overflow | DivideByZero | OutOfBounds }

main = (env: Env) Res<i32, Error> {
    x: i32  = i32.MIN;
    wrapped = x -% 1;
    println("{}", wrapped);
    Ok(0);
}
