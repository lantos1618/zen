// the determinism fixture's entry point.
//
// it is a real program rather than a pile of declarations so that a red in
// check.sh can be triaged: if the emitted C differs but both binaries print
// this same line, the nondeterminism is in NAMES or ORDER, and the emitter
// is the place to look. If the output differs too, it is in semantics, and
// the bug is upstream of gen_c.

a = alpha
b = beta
d = delta
g = gamma

// The standard imports come after the four modules, so every permutation
// check.sh asks for moves the four modules relative to one another.
{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    println("total {} {} {}", a.total(), b.total(), d.total());
    println("name {} {} {} {}", a.name(), b.name(), d.name(), g.name());
    println("tag {} {} {}", a.tag(), b.tag(), g.marker());
    println("label {}", d.label());
    Ok(0);
}
