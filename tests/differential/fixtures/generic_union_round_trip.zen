{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// One generic union is instantiated at different payload widths. Both values
// must retain their tag and payload through native C.
Opt<T> = { Some: T | None }

some = <T>(value: T) Opt<T> { Opt.Some(value) }

pick_i32 = (value: Opt<i32>) i32 {
    value.match({ Some(n) => n, None => 0 })
}

pick_str = (value: Opt<str>) str {
    value.match({ Some(text) => text, None => "none" })
}

main = (env: Env) Res<i32, AllocError> {
    number: Opt<i32> = some(41);
    text: Opt<str>   = some("seven");
    println("{} {}", pick_i32(number), pick_str(text));
    (env.argv.len > 0).match({ true => Ok(0), false => Ok(9) })
}
