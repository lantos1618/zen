// Catches: definite assignment checked per block instead of per path, so a binding
// set on only one branch is accepted and read uninitialized on the other.
{ Res, IoError } = std.core
{ Env } = std.env

pick = (env: Env, b: bool) Res<IoError> {
    label :: str;
    b.match({ true => { label = "set"; }, false => () });
    env.out.println("{}", label)
}

main = (env: Env) Res<IoError> { pick(env, true) }

//! error: 9:27
//! hint: label is read before it is set on some path
