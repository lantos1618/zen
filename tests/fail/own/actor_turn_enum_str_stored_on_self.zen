// A str bound from a received enum is a view into the message too.
{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor

Error = AllocError | IoError | ActorStartError | ActorError
Chat = { Say: str | Show: str }
Keeper = { last :: str = "" }

Keeper.impl(Actor, {
    receive = (self :: @Self, ctx: Context, m: Chat) {
        m.match({
            Say(s)  => { self.last = s; },
            Show(_) => ctx.env.out.println("last {}", self.last).ignore(),
        })
    }
})

main = (env: Env) Res<i32, Error> {
    k = env.spawn(Keeper()).try();
    k.send(Chat.Say("hello world")).try();
    k.send(Chat.Show("ZZZZZZZZZZZ")).try();
    k.stop();
    k.join();
    Ok(0)
}

//! error: 14:26
//! hint: may not be stored through `self`
