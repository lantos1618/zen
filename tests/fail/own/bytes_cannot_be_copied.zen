// Bytes is Drop, so a second name for it is refused: a send can move it to
// another actor without leaving the sender a way to reach the same bytes.

{ Res, Ok, Error } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ Actor, ActorError, ActorStartError, Context, Bytes, bytes } = std.actor

W = {}
W.impl(Actor, { take = (self :: @Self, ctx: Context, b: Bytes) { () } })

Failure = AllocError | ActorStartError | ActorError

main = (env: Env) Res<i32, Failure> {
    w = env.spawn(W()).try();
    k     ::= bytes("x").try();
    alias ::= k;
    w.take(consume k).try();
    Ok(0)
}

//! error: 17:15
//! hint: cannot copy a Drop value
