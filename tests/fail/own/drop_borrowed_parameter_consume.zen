{ Res, Ok } = std.core
{ AllocError, Arena } = std.mem
{ Env } = std.env

destroy = (arena :: Arena) { (consume arena).drop(); }
main = (env: Env) Res<i32, AllocError> {
    arena ::= env.mem.alloc();
    destroy(arena);
    Ok(0)
}

//! error: 5:31
//! hint: explicit destruction requires an owned value
