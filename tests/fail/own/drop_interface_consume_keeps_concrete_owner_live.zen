{ Res, Ok, Drop } = std.core
{ AllocError } = std.mem
{ Env } = std.env

borrowed = (owner: Drop) Drop { owner }
main = (env: Env) Res<i32, AllocError> {
    arena = env.mem.alloc();
    handle = borrowed(arena);
    (consume handle).drop();
    Ok(0)
}

