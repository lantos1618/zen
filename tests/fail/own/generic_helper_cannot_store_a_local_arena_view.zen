{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

Cell<T> = { value :: T }
store = <T>(cell :: Cell<T>, value: T) { cell.value = value; }
bad = (env: Env, cell :: Cell<str>) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    store(cell, text.view());
}
main = (env: Env) Res<AllocError> {
    cell ::= Cell<str>(value: "");
    bad(env, cell).try();
}

