{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box = { text :: str }
put = (box :: Box, text: str) { box.text = text; }
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
}
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    put(box, text.view());
}

