{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

Box = { text :: str }
put = (box :: Box, text: str) { box.text = text; }
bad = (env: Env) Res<Box, AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    box ::= Box(text: "");
    put(box, text.view());
    Ok(box)
}
main = (env: Env) Res<AllocError> { bad(env).try(); Ok }

