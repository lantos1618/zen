{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

Box = {
    text :: str,
    put = (self :: @Self, text: str) { self.text = text; }
}
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    box.put(text.view());
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
}

