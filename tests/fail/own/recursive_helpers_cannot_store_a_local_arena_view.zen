{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

Box = { text :: str }
first = (box :: Box, text: str, again: bool) {
    again.match({ true => second(
        box,
        text,
        false
    ), false => { box.text = text; } });
}
second = (box :: Box, text: str, again: bool) { first(box, text, again); }
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    second(box, text.view(), true);
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
}

