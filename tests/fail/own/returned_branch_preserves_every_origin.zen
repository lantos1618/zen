{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box = { text :: str }
Input = { text: str, scratch: str }
Envelope = { input: Input, other: str }
choose = (input: Input, select: bool) str {
    select.match({ true => input.scratch, false => input.text })
}
put = (box :: Box, input: Input) { box.text = choose(input, false); }
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("temporary").try();
    put(box, Input(text: text.view(), scratch: "static"));
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
}

