{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Box = { text :: str }
Input = { text: str, scratch: str }
Envelope = { input: Input, other: str }
identity = <T>(value: T) T { value }
wrap = (input: Input) Envelope { Envelope(
    input: identity(input),
    other: "static"
) }
put = (box :: Box, input: Input) {
    returned = wrap(input);
    box.text = returned.input.text;
}
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("temporary").try();
    put(box, Input(text: text.view(), scratch: "static"));
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
}

