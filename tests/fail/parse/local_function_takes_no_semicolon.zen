{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io

// A local function is a declaration, and a declaration ends at its body.
main = (env: Env) Res<i32, IoError> {
    succ = (x: i32) i32 { x + 1 };
    println("{}", succ(2));
    Ok(0);
}

//! error: 7:34
//! hint: a declaration takes no `;`
