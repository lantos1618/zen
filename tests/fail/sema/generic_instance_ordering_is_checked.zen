// Ordering requires numbers; a generic comparison instantiated with
// `str` is refused by sema.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

less = <T>(a: T, b: T) bool { a < b }

main = (env: Env) Res<i32, AllocError> {
    println("{}", less("a", "b"));
    Ok(0)
}

//! error: 9:33
//! hint: operator is not defined for these operands: arithmetic and ordering require numbers; remainder and wrapping require integers — `str`
