// A lambda passed to a function captures the local; writing an immutable
// one through the capture is refused.
//
// position: the write.

{ println } = std.io

apply = (f: () ()) { f(); }

main = () i32 {
    x = 1;
    apply(() { x = 2; });
    println("{}", x);
    0
}

//! error: 12:16
//! hint: cannot write through an immutable binding: x is declared `:`
