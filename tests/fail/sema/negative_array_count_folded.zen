// The sign check applies after constant folding, not only to a written
// unary minus. This expression folds to negative one, and its recovery type
// prevents the initializer and index from producing follow-on diagnostics.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    values: [u8, 1 - 2] = [1, 2];
    println("{}", values[0]);
    Ok(0);
}

//! error: 11:18
//! hint: an array count cannot be negative: fixed-array lengths are zero or greater
