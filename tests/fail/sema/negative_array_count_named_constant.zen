// Looking through a constant name must retain the sign of the value it
// names; a negative count cannot silently become a zero-length array.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

NEGATIVE: i64 = -1

main = (env: Env) Res<i32, AllocError> {
    values: [u8, NEGATIVE] = [1, 2];
    println("{}", values[0]);
    Ok(0);
}

//! error: 12:18
//! hint: an array count cannot be negative: fixed-array lengths are zero or greater
