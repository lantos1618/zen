// no `%` operator for f64 values.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

remainder = (left: f64, right: f64) f64 { left % right }

main = (env: Env) Res<i32, AllocError> { Ok(0) }

