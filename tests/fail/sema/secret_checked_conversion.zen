// A checked narrowing tests the value and returns None when it does not fit.
{ Secret } = std.ct
{ to_usize } = std.core.num
{ Res } = std.core
narrow = (key: Secret<u64>) Secret<Res<usize>> {
    key.to_usize()
}
main = () {}

