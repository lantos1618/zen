// position: the value that does not fit the annotation.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    k           = 2;
    r           = (k > 5).then(() { println("big") });
    s: Res<i32> = r;
    s.match({ Ok(v) => println("{}", v), None => println("none") });
    Ok(0);
}

