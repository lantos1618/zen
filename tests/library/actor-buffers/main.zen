Res, Ok = std.core
AllocError = std.mem
Vec = std.collections
Env = std.env
Actor, ActorError, ActorStartError, Context = std.actor

Probe = c.bind("probe.h", {
    exercise* = () ()
    recorded* = (byte: u8, sequence: u8) ()
    completed* = () ()
})
Native = c.bind("stdlib.h", { abort* = () () })
Worker = {}
Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, data: Vec<u8>) {
        (data.len > 0).then(() {
            buffer ::= data;
            buffer.add(99).match({ Ok(_) => (), Err(_) => Native.abort() });
            (buffer.len == 3 && buffer.get(
                2
            ).match({ Ok(n) => n == 99, None => false })).match({ true => (), false => Native.abort() });
            buffer.get(0).match({ Ok(n) => buffer.get(1).match({ Ok(sequence) => Probe.recorded(n, sequence), None => Native.abort() }), None => Native.abort() });
        });
    }
    stopped = (self :: @Self, ctx: Context) { Probe.completed(); }
})
main = (env: Env) Res<i32, AllocError | ActorStartError | ActorError> {
    worker = env.spawn(Worker()).try();
    arena ::= env.mem.alloc();
    warm  ::= arena.Vec<u8>();
    worker.process(consume warm).try();
    Probe.exercise();
    worker.stop();
    worker.join();
    Ok(0)
}
