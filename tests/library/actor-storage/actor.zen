Native = c.bind("stdlib.h", { abort* = () () })
Pause = c.bind("unistd.h", { usleep* = (microseconds: u32) i32 })
Worker = { turns :: usize = 0 }
Worker.impl(Actor, {
    receive = (self :: @Self, ctx: Context, value: usize) { self.turns = self.turns + value; }
    stopped = (self :: @Self, ctx: Context) {
        (self.turns == 10000).match({true => println(
            "PASS: 10000 generated actor turns drained"
        ), false => Native.abort()});
    }
})
main = (env: Env) Res<i32, ActorStartError | ActorError> {
    worker = env.spawn(Worker()).try();
    accepted ::= 0;
    loop(accepted < 10000, (h) {
        worker.receive(1).match({
            Ok(_)      => { accepted = accepted + 1; },
            Err(error) => error.match({Full => { Pause.usleep(10); }, _ => { Err(error).try(); }}),
        });
    });
    worker.stop(); worker.join();
    Ok(0)
}
