fill_random, EntropyError = std.entropy
Res, Ok, Range = std.core
AllocError, null_ptr = std.mem
Env = std.env
println = std.io
Probe = c.bind("probe.h", {
    entropy_probe_calls = () usize
    entropy_probe_reset = () ()
})
main = (env: Env) Res<i32, AllocError> {
    a     = env.mem.alloc();
    bytes = a.raw(515, 1).try();
    @scope.defer(() { a.free(bytes); });
    good ::= true;
    Probe.entropy_probe_reset();
    good = fill_random(
        null_ptr<u8>(),
        0
    ).match({Ok(_) => true, _ => false}) && good;
    good = fill_random(
        null_ptr<u8>(),
        1
    ).match({Err(EntropyError.Invalid) => true, _ => false}) && good;
    good = Probe.entropy_probe_calls() == 0 && good;
    Range(0, 515).loop((i) { bytes.write(i, 173); });
    good = fill_random(
        bytes.offset(1),
        513
    ).match({Ok(_) => true, _ => false}) && good;
    good = Probe.entropy_probe_calls() == 1 && bytes.read(0) == 173 && bytes.read(514) == 173 && good;
    Range(0, 513).loop((i) { good = bytes.read(i + 1).to_usize() == i % 251 + 1 && good; });
    println("entropy span, bounds and null/empty contract: {}", good);
    Ok(good.match({true => 0, false => 1}))
}
