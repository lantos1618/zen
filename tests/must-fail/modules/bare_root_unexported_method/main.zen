// `Bag` travels with `add`, never with `rehome` -- and the module alias
// that carries `Bag` here must not carry `rehome` with it.

Res, Ok, IoError = std.core
Env = std.env
println = std.io

zz = vec

main = (env: Env) Res<i32, IoError> {
    b ::= zz.Bag(len: 0);
    b.rehome();
    println("{}", b.len);
    Ok(0);
}
