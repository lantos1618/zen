// One missing import is one diagnostic. After the first use is reported,
// the name resolves as its import would, so the later uses — and every
// type check that depends on them — say nothing more.
//
// position: the first `Vec`.

first = (v: Vec<i32>) usize { v.len }
second = (v: Vec<i32>, w: Vec<u8>) usize { v.len + w.len }

main = () i32 { 0 }
