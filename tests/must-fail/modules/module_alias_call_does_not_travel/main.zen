// `pick = two` aliases the module `two`; it imports no function. a bare
// call through the alias names a module, not a function, so it is
// rejected rather than resolved against any exported `pick`
{ Tag } = tag.tag
{ Res, Ok, IoError } = std.core
{ Env } = std.env
{ println } = std.io
o1 = one
pick = two

main = (env: Env) Res<i32, IoError> {
    t = Tag(v: 0);
    println("{}", pick(t, 2));
    Ok(0);
}
