// one and two both export `pick` for `Tag`, and this module imports
// neither. the call can only reach them by travelling with `Tag`, and
// nothing ranks one module's export above the other's, so it is a
// collision; before, whichever module loaded first answered silently
Tag = tag.tag
o1 = one
o2 = two

main = (env: Env) Res<i32, IoError> {
    t = Tag(v: 0);
    println("{}", pick(t, 2));
    Ok(0);
}
