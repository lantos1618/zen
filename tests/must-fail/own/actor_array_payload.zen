// Fixed arrays copy their cells, not allocator-backed graphs stored in them.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Vec } = std.collections
{ Env } = std.env
{ Actor, Ref, ActorError, Context } = std.actor

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: [Vec<u8>, 2]) {
        ctx.env.out.println("received").ignore()
    }
})

forward = (worker: Ref<Worker>, payload: [Vec<u8>, 2]) Res<ActorError> {
    worker.process(payload).try();
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
