Reader = { read = (self: @Self) i32 }

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: Reader) {
        ctx.env.out.println("received")
    }
})

forward = (worker: Ref<Worker>, payload: Reader) Res<(), ActorError> {
    worker.process(payload).try();
    Ok(())
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
