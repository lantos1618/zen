// A str a message holds through fields and variants is copied, but a str
// inside a Res is not described, so the payload is refused.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ Actor, Ref, ActorError, Context } = std.actor

TextBox = { text: Res<str> }

Worker = {}

Worker.impl(Actor, {
    process = (self :: @Self, ctx: Context, payload: TextBox) {
        ctx.env.out.println("received").ignore()
    }
})

forward = (worker: Ref<Worker>, payload: TextBox) Res<ActorError> {
    worker.process(payload).try();
}

main = (env: Env) Res<i32, AllocError> { Ok(0) }
