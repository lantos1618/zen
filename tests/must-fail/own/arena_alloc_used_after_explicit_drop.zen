{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ dup } = std.text

allocator = (alloc: Alloc) Alloc { alloc }
main = (env: Env) Res<i32, AllocError> {
    arena ::= env.mem.alloc();
    alloc = allocator(arena);
    (consume arena).drop();
    text = "hello".dup(alloc).try();
    Ok(0)
}
