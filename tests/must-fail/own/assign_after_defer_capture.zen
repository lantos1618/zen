// Assigning `b` drops the Buf it held, but the deferred closure still
// holds its own copy of that Buf and reads it when the block ends.

{ Res, Ok, Drop, IoError } = std.core
{ Env } = std.env
{ println } = std.io

Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) { println("drop {}", self.id) } })

main = (env: Env) Res<i32, IoError> {
    b ::= Buf(id: 3);
    @scope.defer(() { println("deferred {}", b.id) });
    b = Buf(id: 4);
    Ok(0)
}
