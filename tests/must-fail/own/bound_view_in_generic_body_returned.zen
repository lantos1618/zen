// A type variable may be instantiated with a concrete allocator, and the
// instance then builds the bound value over this body's copy of it.
Holder = { alloc: Alloc }
keep = (alloc: Alloc) Holder { Holder(alloc: alloc) }
wrap = <A>(owner: A) Holder { keep(owner) }
main = (env: Env) Res<(), AllocError> {
    held = wrap(env.mem.alloc());
    held.alloc.raw(8, 8).try();
    Ok(())
}
