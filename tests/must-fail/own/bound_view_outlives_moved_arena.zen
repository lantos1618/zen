{ Res, Ok } = std.core
{ AllocError, Arena } = std.mem
{ Map } = std.collections
{ Env } = std.env

// The map keeps the address of `fresh` as its allocator. Moving the arena
// into `owner` takes its pages but leaves that address behind, so the map
// may not follow it into caller storage.
Owner = { arena :: Arena, names :: Map<str, i32> }
refill = (owner :: Owner, env: Env) Res<AllocError> {
    fresh ::= env.mem.alloc();
    names ::= fresh.Map<str, i32>();
    names.set("a", 1).try();
    owner.arena.drop();
    owner.arena = consume fresh;
    owner.names = names;
    Ok
}
main = (env: Env) Res<AllocError> {
    base = env.mem.alloc();
    owner ::= Owner(arena: env.mem.alloc(), names: base.Map<str, i32>());
    refill(owner, env).try();
}
