// Each field of a constructed struct holds its own copy of its argument.
// Passing the Drop binding `b` by name to both fields makes three owners
// of one Buf: `b` itself and the two fields.

{ Res, Ok, Drop, IoError } = std.core
{ Env } = std.env
{ println } = std.io

Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) { println("drop {}", self.id) } })

Two = { left: Buf, right: Buf }

main = (env: Env) Res<i32, IoError> {
    b = Buf(id: 1);
    p = Two(left: b, right: b);
    println("{} {}", p.left.id, p.right.id);
    Ok(0)
}
