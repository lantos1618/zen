// The deferred closure copies `b` when it is registered and reads that
// copy when the block ends. Moving `b` afterwards hands the same value to
// `g`, which drops it first: the closure would read a dropped Buf.

{ Res, Ok, Drop, IoError } = std.core
{ Env } = std.env
{ println } = std.io

Buf = { id: i32 }
Buf.impl(Drop, { drop = (self :: @Self) { println("drop {}", self.id) } })

main = (env: Env) Res<i32, IoError> {
    b = Buf(id: 3);
    @scope.defer(() { println("deferred {}", b.id) });
    g = consume b;
    println("moved {}", g.id);
    Ok(0)
}
