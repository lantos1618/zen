{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Input = { text: str }
Box = { text :: str }
store = (box :: Box, input: Input) { box.text = input.text; }
put = (box :: Box, input: Input) { store(box, input); }
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("dangling").try();
    put(box, Input(text: text.view()));
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
    println(box.text);
}
