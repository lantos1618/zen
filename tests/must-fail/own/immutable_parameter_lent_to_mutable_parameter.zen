{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// A `:` parameter is a borrow the callee may not write, so it cannot be
// handed on to a parameter that does.
Counter = { n :: i32 }
bump = (counter :: Counter) { counter.n = counter.n + 1; }
twice = (counter: Counter) { bump(counter); }
main = (env: Env) Res<AllocError> {
    counter ::= Counter(n: 1);
    twice(counter);
    println("{}", counter.n);
}
