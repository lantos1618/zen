// the rule is not a Vec rule. any method declared `self :: @Self`
// needs a mutable receiver, in user code, with no std type involved.

Res, Ok, IoError = std.core
Env = std.env
println = std.io

Counter = {
    n :: i32,

    bump* = (self :: @Self) { self.n = self.n + 1; }
    read* = (self: @Self) i32 { self.n }
}

main = (env: Env) Res<i32, IoError> {
    c = Counter(n: 0);
    c.bump();
    println("{}", c.read());
    Ok(0);
}
