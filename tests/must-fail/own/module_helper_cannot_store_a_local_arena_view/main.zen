{ Box, store } = helper
{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
bad = (env: Env, box :: Box) Res<AllocError> {
    a    = env.mem.alloc();
    text = a.String("hello").try();
    store(box, text.view());
}
main = (env: Env) Res<AllocError> {
    box ::= Box(text: "");
    bad(env, box).try();
}
