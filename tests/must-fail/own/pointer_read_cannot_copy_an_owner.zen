Res, Ok, Drop = std.core
AllocError = std.mem
Env = std.env

Owner = { id: i32 }
Owner.impl(Drop, { drop = (self :: @Self) {} })
main = (env: Env) Res<i32, AllocError> {
    p = env.mem.alloc().create<Owner>().try();
    item ::= Owner(id: 1);
    p.write(0, consume item);
    copied = p.read(0);
    Ok(0)
}
