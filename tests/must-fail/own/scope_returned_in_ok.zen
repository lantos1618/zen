// the same escape wearing a wrapper: `Ok(@scope)` hands the block to a
// value whose type carries it out of the function. The caller's defer
// then registers on a dead frame, and the loss was silent at -O0.

{ Res, Ok, Scope, IoError } = std.core
{ Env } = std.env
{ println } = std.io

here = () Res<Scope, IoError> {
    Ok(@scope)
}

main = (env: Env) Res<i32, IoError> {
    d = here().try();
    d.defer(() { println("goodbye") });
    Ok(0);
}
