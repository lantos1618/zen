// one binding further out: `t` names `s`, which names the block. A
// value read through either name is the same dead frame to the caller,
// so the flag propagates one written step at declaration time.

Res, Ok, Scope, IoError = std.core
Env = std.env
println = std.io

here = () Scope {
    s = @scope;
    t = s;
    t
}

main = (env: Env) Res<i32, IoError> {
    d = here();
    d.defer(() { println("goodbye") });
    Ok(0);
}
