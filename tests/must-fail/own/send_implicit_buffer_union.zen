{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Vec } = std.collections
{ Env } = std.env
{ Actor, ActorError, ActorStartError, Context } = std.actor
{ println } = std.io

Bytes = Vec<u8> | bool
Worker = {}
Worker.impl(Actor, {
    read = (self :: @Self, ctx: Context, data: Bytes) { println("received"); }
})
main = (env: Env) Res<i32, AllocError | ActorStartError | ActorError> {
    arena ::= env.mem.alloc();
    buf   ::= arena.Vec<u8>();
    buf.add(7).try();
    worker = env.spawn(Worker()).try();
    worker.read(consume buf).try();
    worker.stop(); worker.join();
    Ok(0)
}
