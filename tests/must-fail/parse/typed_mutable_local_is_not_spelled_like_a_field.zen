// A field or parameter is made mutable with `name :: T`; a local with a type
// spells the same thing `name: T ::= value`. The field spelling written in a
// body gets one diagnostic naming the local spelling, and the binding is kept
// so the rest of the body is still checked.
//
// position: the `::`.

Circle = { r: f32 }

main = () i32 {
    c :: Circle = Circle(r: 2.0);
    println("{}", c.r);
    0
}
