// A typed mutable local is written `name :: T = value`, the way a mutable
// field or parameter is. The older `name: T ::= value` is refused with one
// diagnostic naming that spelling, and the binding is kept so the rest of
// the body is still checked.
//
// position: the `::=`.

println = std.io

main = () i32 {
    count: i32 ::= 3;
    count = count + 1;
    println("{}", count);
    0
}
