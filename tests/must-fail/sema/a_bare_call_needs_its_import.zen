// A bare name is visible only through an import (docs/DESIGN.md, Modules).
// `sqrt` is exported by std.math, but only `pow` is imported from it, so a
// bare `sqrt(9.0)` binds nothing. Resolving the bare call through every module's
// exports by its first argument would let a module's own name lose to one
// it never imported. The diagnostic names the import that would bind it.
//
// position: the call.

{ pow } = std.math
{ Res } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    n = sqrt(9.0);
    println("{}", n);
    0
}
