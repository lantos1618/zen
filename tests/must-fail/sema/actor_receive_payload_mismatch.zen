{ Actor, Context, Receive, Ref } = std.actor
{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

Chunk = { n: i32 }
Wrong = {}

Wrong.impl(Actor, {
    receive = (self :: @Self, ctx: Context, text: str) ()
})

accept = <R: Actor + Receive<Chunk>>(receiver: R) { () }

main = (env: Env) Res<i32, AllocError> {
    accept(Wrong());
    Ok(0)
}
