// Explicit type arguments on associated generic functions settle their
// signatures before ordinary arguments are checked.

Res, Ok = std.core
AllocError = std.mem
Env = std.env
println = std.io

Tool = {
    id = <T>(value: T) T { value }
}

main = (env: Env) Res<i32, AllocError> {
    text: str = "wrong";
    println("{}", Tool.id<i32>(text));
    Ok(0);
}
