// A positional supply does not disable the missing-field check.
// position: the incomplete construction.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Point = {
    x: i32,
    y: i32,
}

main = (env: Env) Res<i32, AllocError> {
    p = Point(7);
    println("{}", p.y);
    Ok(0);
}
