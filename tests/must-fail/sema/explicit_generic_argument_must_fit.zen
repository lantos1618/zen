// A written argument settles T before values are checked against the resulting
// signature. `id<str>` therefore cannot accept an i32.

Res, Ok = std.core
AllocError = std.mem
Env = std.env
println = std.io

id = <T>(value: T) T { value }

main = (env: Env) Res<i32, AllocError> {
    number: i32 = 1;
    println("{}", id<str>(number));
    Ok(0);
}
