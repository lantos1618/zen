// A function-typed parameter carries only a function type, not declaration-
// level generic metadata. Written type arguments cannot be applied to it.

Res, Ok = std.core
AllocError = std.mem
Env = std.env

apply = (id: (value: i32) i32) i32 { id<i32>(1) }

main = (env: Env) Res<i32, AllocError> { Ok(0) }
