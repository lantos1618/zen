{ Res, Ok } = std.core
{ Env } = std.env
{ Actor, Ref, ActorError, ActorStartError, Context } = std.actor

Msg = { Add: u64 | Reset }

Counter = { total :: u64 = 0 }

Counter.impl(Actor, {
    receive = (self :: @Self, ctx: Context, m: Msg) { }
    poke    = (self :: @Self, ctx: Context) { }
})

Error = ActorStartError | ActorError

main = (env: Env) Res<i32, Error> {
    c           = env.spawn(Counter()).try();
    r: Ref<Msg> = c;
    r.poke().try();
    Ok(0)
}
