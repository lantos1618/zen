// Ordering has no `Ord` dispatch and therefore remains a built-in numeric
// operation. String equality is legal, but string ordering is not.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env

before = (left: str, right: str) bool { left < right }

main = (env: Env) Res<i32, AllocError> { Ok(0) }
