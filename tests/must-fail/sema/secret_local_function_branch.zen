// A local function's Secret parameter may not choose a match arm, as a
// top-level function's may not.
{ Secret, declassify } = std.ct
{ bit_and } = std.core.num
{ println } = std.io
main = () {
    parity = (k: Secret<u64>) u64 {
        picked: u64 = k.bit_and(1).match({ 0 => 7, _ => 9 });
        declassify(picked)
    }
    println("{}", parity(4));
}
