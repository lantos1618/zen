// Taint follows bindings, including assignments inside closures.
Secret, declassify = std.ct
bit_xor = std.core.num
fold = (key: Secret<u64>) u64 {
    acc :: u64 = 0;
    Range(0, 4).loop((i) { acc = acc.bit_xor(key); });
    picked: u64 = acc.match({ 0 => 1, _ => 2 });
    declassify(picked)
}
main = () {}
