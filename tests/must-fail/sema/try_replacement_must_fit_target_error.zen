{ Res, Err, Error } = std.core
{ Env } = std.env

SourceError = { | Bad }
SourceError.impl(Error, {})
TargetError = { | Changed }
TargetError.impl(Error, {})

raise = () Res<i32, SourceError> { Err(SourceError.Bad) }

wrong = () Res<i32, TargetError> {
    raise().try(false)
}

main = (env: Env) Res<i32, TargetError> { wrong() }
