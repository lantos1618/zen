// name resolution: `total` is never bound. a compiler that reports this
// as a type error instead has resolved it to something, which is worse.
//
// position: the unresolved name.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<i32, AllocError> {
    println("{}", total);
    Ok(0);
}
