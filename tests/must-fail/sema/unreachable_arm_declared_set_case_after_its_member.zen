// The same rule through a declared set: on `Both = Kind | Fail`,
// `Err(Kind)` covers `Err(Authentication)`.

Res, Ok, Err = std.core
AllocError = std.mem
Env = std.env
println = std.io

Kind = Io | Protocol | Authentication
Fail = Mismatch | Accepted
Both = Kind | Fail

name = (r: Res<i32, Both>) str {
    r.match({
        Err(Kind)           => "kind",
        Err(Authentication) => "authentication",
        Err(Fail)           => "fail",
        Ok(_)               => "ok",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", name(Err(Kind.Io)));
    Ok(0);
}
