// An integer literal named twice: the second arm never runs.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

digit = (n: i32) str {
    n.match({
        0 => "zero",
        1 => "one",
        0 => "nought",
        _ => "many",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", digit(0));
    Ok(0);
}
