// `Err(e)` binds every error; a case below it never runs.

{ Res, Ok, Err, Error } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Kind = { Io | Protocol }
Kind.impl(Error, {})
Fail = { Mismatch | Accepted }
Fail.impl(Error, {})

name = (r: Res<i32, Kind | Fail>) str {
    r.match({
        Err(e)        => "error",
        Err(Protocol) => "protocol",
        Ok(_)         => "ok",
    })
}

main = (env: Env) Res<i32, AllocError> {
    println("{}", name(Err(Kind.Io)));
    Ok(0);
}
