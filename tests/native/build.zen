// The native-backend differential corpus runner, built with the C backend.
{ Builder, BuildError, Codegen } = std.build
{ Res, Ok, Path } = std.core

build = (b :: Builder) Res<(), BuildError> {
    b.exe("native-corpus", { src: Path("main.zen"), deps: [], backend: Codegen.C }).try();
    Ok(())
}
