// A Secret parameter keeps its secrecy record even when the body never
// reaches a barrier: C marks it for tools/ct, the jit runs it, and a backend
// without that analysis (asm, JS) refuses it by name instead of dropping it.
{ Secret } = std.ct
{ println } = std.io

pick = (k: Secret<u64>, n: u64) u64 { n +% 1 }

main = () {
    key: Secret<u64> = 7;
    println("{}", pick(key, 2));
}

//! out: 3
