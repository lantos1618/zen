{ project, Action } = zen.zen_project
{ ProjectArgs } = std.build
{ Res, Ok } = std.core
{ Alloc, AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

run = (env: Env, a: Alloc, target: str) Res<AllocError> {
    job  = ProjectArgs(
        root: "src/app",
        target: target,
        std_root: "src",
        argv: a.Vec<str>()
    );
    code = project(env, a, job, Action.Test).try();
    println("result {} {}", target, code);
}

main = (env: Env) Res<AllocError> {
    a = env.mem.alloc();
    run(env, a, "passing").try();
    run(env, a, "failing").try();
    run(env, a, "missing").try();
    run(env, a, "").try();
}

//! out: ok passing
//! out: zen test: 1 passed, 0 failed
//! out: result passing 0
//! out: not ok failing (exit 7)
//! out: zen test: 0 passed, 1 failed
//! out: result failing 1
//! out: zen test: no matching executable test targets
//! out: result missing 1
//! out: ok passing
//! out: not ok failing (exit 7)
//! out: ok after_failure
//! out: zen test: 2 passed, 1 failed
//! out: result  1
