{ println } = std.io
{ Res, Ok } = std.core
{ AllocError, Ptr } = std.mem
{ Env } = std.env

// `Ptr.read` copies, so a `:` callee keeps what was read even when another
// argument writes the same storage through a second `Ptr`.
Big = { a :: u64, b :: u64, c :: u64 }
Holder = { p: Ptr<Big> }
poke = (x: Big, h: Holder) u64 {
    h.p.write(0, Big(a: 7, b: 0, c: 9));
    x.a * 100 + x.b * 10 + x.c
}
via_ptr = (p: Ptr<Big>, h: Holder) u64 { poke(p.read(0), h) }
main = (env: Env) Res<AllocError> {
    a = env.mem.alloc();
    v ::= a.Vec<Big>();
    v.add(Big(a: 1, b: 2, c: 3)).try();
    println("{}", via_ptr(v.ptr(), Holder(p: v.ptr())));
    v.ptr().write(0, Big(a: 1, b: 2, c: 3));
    println("{}", poke(v.ptr().read(0), Holder(p: v.ptr())));
    Ok(())
}

//! out: 123
//! out: 123
