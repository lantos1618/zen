{ Bundle } = schema.schema
{ println } = std.io

carry = <T>(value: T) T { value }

make = <T>(value: T) Bundle<T> {
    bundle = Bundle<T>();
    println("{}", carry<T>(value));
    bundle
}

main = () {
    narrow = make<u8>(3);
    wide   = make<i64>(4);
    println("{} {}", narrow.slot.marker, narrow.slot.data.is_null());
    println("{} {}", wide.slot.marker, wide.slot.data.is_null());
}

//! out: 3
//! out: 4
//! out: 7 true
//! out: 7 true
