// Indexed writes must preserve their value, selected slot, and neighboring
// elements. Distinct values and out-of-order indices expose misplaced writes.

{ Res, Ok, Range } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

sum = (xs: [i32, 4]) i32 { xs[0] + xs[1] + xs[2] + xs[3]; }

main = (env: Env) Res<i32, AllocError> {
    buf ::= [0, 0, 0, 0];

    // literal indices, deliberately not in ascending order
    buf[3] = 7;
    println("a {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    buf[0] = 1;
    println("b {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    buf[2] = 5;
    println("c {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // a RUNTIME index: the slot is chosen by a value, not by the
    // position of the statement
    i ::= 1;
    buf[i] = 9;
    println("d {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // overwriting is a write too, and it must reach the same slot twice
    buf[i] = 4;
    println("e {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);

    // every slot written from a loop counter, each to a different value
    m ::= 0;
    Range(0, 4).loop((h, k) {
        buf[k] = m * 10 + 2;
        m      = m + 1;
    });
    println("f {} {} {} {}", buf[0], buf[1], buf[2], buf[3]);
    println("sum {}", sum(buf));
    Ok(0);
}

//! out: a 0 0 0 7
//! out: b 1 0 0 7
//! out: c 1 0 5 7
//! out: d 1 9 5 7
//! out: e 1 4 5 7
//! out: f 2 12 22 32
//! out: sum 68
