// A returned tagged value contains a record whose fields are built in place.
// The second field is a match of block expressions. Distinct counter values
// check that every nested destination receives the right value once, in the
// order the constructor arguments were written.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Wide = { a: i64, b: i64, c: i64, d: i64 }

Envelope = { left: Wide, right: Wide }

Counter = {
    n :: i64,

    next = (self :: @Self) i64 {
        was    = self.n;
        self.n = self.n + 1;
        was;
    }
}

make = (counter :: Counter, choose: bool) Res<Envelope, AllocError> {
    Ok(Envelope(
        left: Wide(
            a: counter.next(),
            b: counter.next(),
            c: counter.next(),
            d: counter.next()
        ),
        right: choose.match({
            true  => {
                Wide(
                    a: counter.next() + 100,
                    b: counter.next(),
                    c: counter.next(),
                    d: counter.next()
                )
            },
            false => {
                Wide(
                    a: counter.next() + 200,
                    b: counter.next(),
                    c: counter.next(),
                    d: counter.next()
                )
            },
        })
    ))
}

main = (env: Env) Res<i32, AllocError> {
    counter ::= Counter(n: 0);
    yes = make(counter, true).try();
    no  = make(counter, false).try();
    println(
        "yes left {} {} {} {}",
        yes.left.a,
        yes.left.b,
        yes.left.c,
        yes.left.d
    );
    println(
        "yes right {} {} {} {}",
        yes.right.a,
        yes.right.b,
        yes.right.c,
        yes.right.d
    );
    println("no left {} {} {} {}", no.left.a, no.left.b, no.left.c, no.left.d);
    println(
        "no right {} {} {} {}",
        no.right.a,
        no.right.b,
        no.right.c,
        no.right.d
    );
    println("count {}", counter.n);
    Ok(0)
}

//! out: yes left 0 1 2 3
//! out: yes right 104 5 6 7
//! out: no left 8 9 10 11
//! out: no right 212 13 14 15
//! out: count 16
