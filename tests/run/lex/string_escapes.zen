{ Res, Ok, IoError } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// the escapes a string literal must accept, and the exact bytes each
// one produces.
Error = AllocError | IoError

main = (env: Env) Res<i32, Error> {
    println("tab:\there");
    println("newline:\nsecond");
    println("backslash:\\");
    println("quote:\"");
    println("all four:\t\\\"|");
    Ok(0);
}

//! out: tab:	here
//! out: newline:
//! out: second
//! out: backslash:\
//! out: quote:"
//! out: all four:	\"|
