// Catches: the interpreter recursing on the host stack past what it can hold, so deep
// user recursion crashes (SIGSEGV, exit 139) instead of stopping at Limits.RUN_DEPTH.

down = (n: i32) i32 { (n == 0).match({ true => 0, false => down(n - 1) }) }
main = () i32 { down(100000) }

//! exit: 1
//! err: a resource limit was reached
