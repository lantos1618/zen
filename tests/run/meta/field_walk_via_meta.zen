// Reflection visits each field in declaration order, preserving its type.
// Compare with field_walk_by_hand; distinct values also expose skipped or
// repeated fields, while break/next and generic boxes exercise walk control.

{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Row = {
    n: i64,
    flag: bool,
    tag: str,

    show* = (self: @Self) {
        @meta(self: @Self).fields().loop((h, field) {
            println("{}={}", field.name, self.at(field));
        });
    },

    skip_tag* = (self: @Self) {
        @meta(self: @Self).fields().loop((h, field) {
            field.name.eq("tag").then(() { h.next(); });
            println("kept {}", field.name);
        });
    },

    stop_at_flag* = (self: @Self) {
        @meta(self: @Self).fields().loop((h, field) {
            field.name.eq("flag").then(() { h.break(); });
            println("seen {}", field.name);
        });
    },
}

Box<T> = {
    v: T,

    show* = (self: @Self) {
        @meta(self: @Self).fields().loop((h, field) {
            println("box.{}={}", field.name, self.at(field));
        });
    },
}

describe* = (r: Row) {
    @meta(row: Row).fields().loop((h, field) {
        println("[{}] {}", field.name, r.at(field));
    });
}

main = (env: Env) Res<i32, AllocError> {
    r = Row(n: 17, flag: true, tag: "qy");
    r.show();
    describe(r);
    r.skip_tag();
    r.stop_at_flag();
    println("count {}", @meta(row: Row).fields().len);
    Box<i64>(v: 41).show();
    Box<str>(v: "hi").show();
    Ok(0);
}

//! out: n=17
//! out: flag=true
//! out: tag=qy
//! out: [n] 17
//! out: [flag] true
//! out: [tag] qy
//! out: kept n
//! out: kept flag
//! out: seen n
//! out: count 3
//! out: box.v=41
//! out: box.v=hi
