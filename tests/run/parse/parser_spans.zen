// tests/corpus/parse/parser_spans.zen
// Position accuracy: the exact span of every node in a small file.
//
// TESTING.md calls this "the one everyone skips and the one that
// decays fastest", and POSITIONS.md is the table it decays against.
// This is those conventions, executable, on a file small enough to
// hold in the head:
//
//   - 1-based lines, 1-based BYTE columns
//   - half-open: `end` is one past the last byte, so `Point` on line 2
//     is 2:1..2:6
//   - a node's span includes its own delimiters and all its children,
//     and excludes the separator that follows it
//   - a STATEMENT's span includes its `;`; the expression inside it
//     does not
//   - a node's span does NOT include its leading trivia
//   - the module's span is the whole file, trivia included

{ scan, Source } = std.lex.lex
{ Parser, module } = std.parse
{ Ast } = std.ast.ast_arena
{ Span } = std.source
{ Decl, Block, Bind } = std.ast.ast_node
{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

// The file, with the columns it asserts:
//
//   1  // a note
//   2  Point = {
//   3      x: i32,
//   4  }
//   5
//   6  main = () i32 {
//   7      p = Point(x: 3);
//   8      0
//   9  }
SOURCE: str = "// a note\nPoint = {\n    x: i32,\n}\n\nmain = () i32 {\n    p = Point(x: 3);\n    0\n}\n"

sp = (env: Env, label: str, s: Span) {
    println(
        "{} {}:{}..{}:{}",
        label,
        s.start.line,
        s.start.col,
        s.end.line,
        s.end.col
    );
}

show_struct = (env: Env, tree: Ast, d: Decl) {
    d.kind.match({
        Struct(s) => {
            sp(env, "struct.name", s.name.span);
            sp(env, "struct.body", s.body_span);
            s.members.loop((h, mem) {
                sp(env, "member", mem.span);
                mem.kind.match({
                    Field(f) => {
                        sp(env, "field.name", f.name.span);
                        f.type.match({
                            Ok(t) => sp(
                                env,
                                "field.type",
                                tree.type_at(t).span
                            ),
                            None  => println("field.type absent"),
                        });
                    },
                    _        => println("member is not a field"),
                });
            });
        },
        _         => println("decl 0 is not a struct"),
    });
}

show_fn = (env: Env, tree: Ast, d: Decl) {
    d.kind.match({
        Function(f) => {
            sp(env, "fn.name", f.name.span);
            sp(env, "fn.params", f.params_span);
            f.ret.match({
                Ok(t) => sp(env, "fn.ret", tree.type_at(t).span),
                None  => println("fn.ret absent"),
            });
            f.body.match({
                Ok(b) => show_body(env, tree, tree.block_at(b)),
                None  => println("fn.body absent"),
            });
        },
        _           => println("decl 1 is not a function"),
    });
}

show_body = (env: Env, tree: Ast, b: Block) {
    sp(env, "fn.block", b.span);
    b.stmts.loop((h, s) {
        sp(env, "stmt", s.span);
        s.kind.match({
            Bind(bd) => show_bind(env, tree, bd),
            _        => println("stmt is not a bind"),
        });
    });
    b.value.match({
        Ok(v) => sp(env, "block.value", tree.expr_at(v).span),
        None  => println("block.value absent"),
    });
}

show_bind = (env: Env, tree: Ast, bd: Bind) {
    sp(env, "bind.target", tree.expr_at(bd.target).span);
    e = tree.expr_at(bd.value);
    sp(env, "bind.value", e.span);
    e.kind.match({
        Call(c) => c.args.loop((h, a) {
            sp(env, "arg", a.span);
            sp(env, "arg.value", tree.expr_at(a.value).span);
        }),
        _       => println("bind.value is not a call"),
    });
}

main = (env: Env) Res<i32, AllocError> {
    alloc ::= env.mem.alloc();
    lexed = scan(alloc, Source(file: "t.zen", text: SOURCE)).try();
    p ::= alloc.Parser(lexed);
    m = p.module("t").try();

    sp(env, "module", m.span);
    println("lex {} parse {}", lexed.diags.len, p.diags.len);
    println("decls {}", m.decls.len);

    m.decls.get(0).match({
        Ok(d) => {
            sp(env, "decl0", d.span);
            println("decl0.leading {}", d.leading.len);
            show_struct(env, p.tree, d);
        },
        None  => println("no decl 0"),
    });

    m.decls.get(1).match({
        Ok(d) => {
            sp(env, "decl1", d.span);
            show_fn(env, p.tree, d);
        },
        None  => println("no decl 1"),
    });

    Ok(0);
}

//! out: module 1:1..10:1
//! out: lex 0 parse 0
//! out: decls 2
//! out: decl0 2:1..4:2
//! out: decl0.leading 1
//! out: struct.name 2:1..2:6
//! out: struct.body 2:9..4:2
//! out: member 3:5..3:11
//! out: field.name 3:5..3:6
//! out: field.type 3:8..3:11
//! out: decl1 6:1..9:2
//! out: fn.name 6:1..6:5
//! out: fn.params 6:8..6:10
//! out: fn.ret 6:11..6:14
//! out: fn.block 6:15..9:2
//! out: stmt 7:5..7:21
//! out: bind.target 7:5..7:6
//! out: bind.value 7:9..7:20
//! out: arg 7:15..7:19
//! out: arg.value 7:18..7:19
//! out: block.value 8:5..8:6
