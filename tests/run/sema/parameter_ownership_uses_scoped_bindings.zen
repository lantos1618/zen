{ Source, scan } = std.lex
{ Parser, module } = std.parse
{ Checker } = sema.sema_check
{ check_all } = sema.sema_decl
{ Res, Ok } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

main = (env: Env) Res<AllocError> {
    a      = env.mem.alloc();
    source = "R = { len: u64 }\nread = (p: R) u64 { p.len }\nshadow = (p: R) u64 { { p ::= R(len: 0); moved = consume p; }; p.len }\nretained = (p: R) R { p }\nconsumed = (p: R) R { consume p }\nconditional = (p: R, take: bool) R { take.match({ true => consume p, false => R(len: 0) }) }\nwritten = (p :: R) { p = R(len: 0); }\nclosure_shadow = (p: R) u64 { f = (p: R) R { consume p }; p.len }\n";
    lexed  = scan(a, Source(file: "ownership.zen", text: source)).try();
    parser ::= a.Parser(lexed);
    parsed = parser.module("ownership").try();
    parser.tree.add_module(parsed).try();
    checker ::= a.Checker(parser.tree).try();
    checker.check_all().try();
    println("valid {}", checker.diag_count() == 0);
    parsed.decls.loop((decl) {
        decl.kind.match({
            Function(f) => checker.parameter_use(f, 0).when_ok((use) {
                name = use.match({
                    Lent        => "lent",
                    Retained    => "retained",
                    Consumed    => "consumed",
                    Conditional => "conditional",
                });
                println("{} {}", f.name.text, name);
            }),
            _           => (),
        });
    });
}

//! out: valid true
//! out: read lent
//! out: shadow lent
//! out: retained retained
//! out: consumed consumed
//! out: conditional conditional
//! out: written retained
//! out: closure_shadow lent
