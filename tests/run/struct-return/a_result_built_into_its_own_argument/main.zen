// A STRUCT RESULT ASSIGNED BACK OVER ONE OF ITS OWN INPUTS.
//
// A backend may build a large result straight in the caller's variable
// instead of copying it out on return. That is only sound when nothing the
// callee reads can reach that variable; c_ir_result_pointer pins the C
// renderer's half of that rule, and this test pins the whole pipeline
// from source. Each callee here writes its result
// one field at a time and reads its inputs again between the writes, so a
// result built over `x` while `x` is still an input changes what the later
// fields read:
//
//   - `x = step(x)`: the argument is the destination.
//   - `y = y.mix(y)`: the `::` receiver is a live alias of the
//     destination, and the method writes through it mid-build.
//   - `z = pick(z, 1).value_or(z)`: the result is a `Res` payload, built
//     the way `Vec.get` builds one, then unwrapped back over its input.

{ Res, Ok, None } = std.core
{ AllocError } = std.mem
{ Env } = std.env
{ println } = std.io

Big = {
    a*:: i64,
    b*:: i64,
    c*:: i64,
    d*:: i64,

    mix = (self :: @Self, src: Big) Big {
        out ::= Big(a: 0, b: 0, c: 0, d: 0);
        out.a  = src.b;
        self.a = self.a + 100;
        out.b  = src.a + self.a;
        out.c  = self.b + out.a;
        out.d  = src.d;
        out
    }
}

step = (src: Big) Big {
    out ::= Big(a: 0, b: 0, c: 0, d: 0);
    out.a = src.d;
    out.b = src.a + out.a;
    out.c = src.b;
    out.d = src.c + src.a;
    out
}

pick = (src: Big, k: i64) Res<Big> {
    (k > 0).match({
        true  => Ok(step(src)),
        false => None,
    })
}

main = (env: Env) Res<i32, AllocError> {
    x ::= Big(a: 1, b: 2, c: 3, d: 4);
    x = step(x);
    println("step {} {} {} {}", x.a, x.b, x.c, x.d);

    y ::= Big(a: 1, b: 2, c: 3, d: 4);
    y = y.mix(y);
    println("mix {} {} {} {}", y.a, y.b, y.c, y.d);

    z ::= Big(a: 1, b: 2, c: 3, d: 4);
    z = pick(z, 1).value_or(z);
    println("pick {} {} {} {}", z.a, z.b, z.c, z.d);
    Ok(0);
}

//! out: step 4 5 2 4
//! out: mix 2 102 4 4
//! out: pick 4 5 2 4
