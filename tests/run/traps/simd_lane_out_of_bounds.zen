// A lane index at or beyond the lane count traps at the index argument.
{ splat_u32x4, lane } = std.simd
{ println } = std.io

pick = (i: usize) usize { i + 3 }

main = () {
    v    = splat_u32x4(7);
    last = v.lane(pick(0));
    println("in bounds: {}", last);
    past = v.lane(pick(1));
    println("unreachable: {}", past);
}

//! out: in bounds: 7
//! exit: 134
//! err: simd_lane_out_of_bounds.zen:11:19: trap: index out of bounds
