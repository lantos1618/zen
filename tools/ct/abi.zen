// Where a C function's secret parameters arrive, from the generated C.
//
// The Zen C backend writes ` /* zen:secret zu_l3key *zu_l3out */` after the
// parameter list of every function with a parameter written std.ct.Secret
// (`*` marks a pointer whose pointee is secret), with `public-result` when
// the result is not written Secret (sema's discipline makes it public). This module reads those
// definitions, sizes the parameter types from the struct definitions in
// the same file, and assigns them to registers and stack slots by the
// SysV x86-64 or AAPCS64 calling convention, which is what the assembly
// taint analysis is seeded with.
//
// Covered: integers, pointers, bool, u128 (a register pair), std.simd
// vectors (the zg_u<bits>x<lanes> types: an XMM/YMM or V register, a
// 32-byte vector on the stack on x86-64 outside AVX functions and through a
// hidden pointer on arm64), and structs and fixed arrays of those (by
// value: in one or two registers up to 16 bytes, otherwise on the stack on
// x86-64 and through a hidden pointer on arm64; a small struct of vectors
// in vector registers). A by-value parameter the C backend lends as a
// `const T *` holds its secret bytes behind the pointer. Floating-point
// parameters take vector registers and are treated as public. A result
// larger than 16 bytes takes %rdi for its return pointer on x86-64 (x8 on
// arm64, which takes no argument register).
Alloc, AllocError = std.mem
Vec, Map = std.collections
str, String = std.text
Range = std.core
parse_usize = std.text
truncate_u32, to_i64 = std.core.num
Isa, Seed, CallShape, Writable = taint

Param* = { ctype*: str, name*: str }

// One definition carrying the secret marker.
Marked* = {
    symbol*: str,
    result*: str,
    params*: Vec<Param>,
    secret*: Vec<str>,     // C names of secret-valued parameters
    pointee*: Vec<str>,    // C names of pointers to secret memory
    // C names of pointers to memory holding pointers to secret memory
    // (manifest `**name`).
    pointee2*: Vec<str>,
    // Secret-dependent conditional branches allowed, for a function whose
    // one decision is a public outcome (an AEAD open's authentication).
    branches* :: usize = 0,
    // Compiled for AVX (x86-64): 32-byte vectors travel in YMM registers.
    avx* :: bool = false,
    // The result register must be public at every return; callers may
    // rely on that.
    public_result* :: bool = false,
}

// `vector`: passed in the SIMD&FP registers (a vector, a float, or a small
// struct made only of those).
Layout* = { size*: usize, align*: usize, vector*: bool }

MARK: str = "/* zen:secret"

// Every marked definition in the file, in file order.
marked_functions* = (a: Alloc, c: str) Res<Vec<Marked>, AllocError> {
    out ::= a.Vec<Marked>();
    c.lines().loop((line) {
        (line.starts_with("static ") && line.contains(MARK) && line.ends_with("{")).then(() {
            parse_definition(a, plain_definition(a, line).try()).when_ok((m) { out.add(m).try(); });
        });
    });
    Ok(out)
}

// An `inline` function's definition carries the always_inline attribute
// (after any target attribute), whose parentheses come before the parameter
// list; parsing reads the line without it.
ALWAYS_INLINE*: str = "inline __attribute__((always_inline)) "
plain_definition* = (a: Alloc, line: str) Res<str, AllocError> {
    line.find(ALWAYS_INLINE).match({
        Ok(at) => a.String("{}{}", line.slice(0, at), line.slice(at + ALWAYS_INLINE.len, line.len)).match({
            Ok(s)  => Ok(s.view()),
            Err(e) => Err(e),
        }),
        None   => Ok(line),
    })
}

targets_avx = (line: str) bool {
    line.contains("ZG_TARGET_AVX") || line.contains("target(\"avx")
}

parse_definition = (a: Alloc, line: str) Res<Marked> {
    open   = line.find('(').try();
    mark   = line.find(MARK).try();
    close  = line.slice(0, mark).rfind(')').try();
    head   = line.slice(0, open).trim().try();
    space  = head.rfind(' ').try();
    symbol = head.slice(space + 1, head.len);
    result = head.slice(0, space).trim().try();
    params ::= a.Vec<Param>();
    line.slice(open + 1, close).split(',').loop((part) {
        text = part.trim().value_or("");
        (text.len > 0 && !text.eq("void")).then(() {
            cut = last_identifier(text);
            params.add(Param(
                ctype: text.slice(0, cut).trim().value_or(""),
                name: text.slice(cut, text.len)
            )).match({ _ => () });
        });
    });
    secret  ::= a.Vec<str>();
    pointee ::= a.Vec<str>();
    words = line.slice(mark + MARK.len, line.len);
    words.split(' ').loop((w) {
        (w.starts_with("zu_") || w.starts_with("*zu_") || w.starts_with("zg_")
            || w.starts_with("*zg_")).then(() {
            w.starts_with("*").match({
                true  => pointee.add(w.slice(1, w.len)),
                false => secret.add(w),
            }).match({ _ => () });
        });
    });
    Ok(Marked(
        symbol: symbol,
        result: strip_qualifiers(result),
        params: params,
        secret: secret,
        pointee: pointee,
        pointee2: a.Vec<str>(),
        avx: targets_avx(line),
        // The backend writes `public-result` for a checked function whose
        // result is not written Secret.
        public_result: words.contains(" public-result")
    ))
}

is_ident = (c: u8) bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

last_identifier = (text: str) usize {
    at ::= text.len;
    loop(() { at > 0 && is_ident(text.index(at - 1)) }, (h) { at = at - 1; });
    at
}

// `static inline __attribute__((always_inline)) T` and
// `static ZG_TARGET_AVX2 T` -> `T`.
strip_qualifiers = (result: str) str {
    close = result.rfind(')');
    rest ::= close.match({
        Ok(i) => result.slice(i + 1, result.len).trim().value_or(result),
        None  => result,
    });
    loop((h) {
        word = rest.find(' ').match({ Ok(i) => rest.slice(0, i), None => rest });
        (word.eq("static") || word.eq("inline") || word.starts_with("ZG_")).match({
            true  => {
                (word.len == rest.len).match({
                    true  => h.break(),
                    false => { rest = rest.slice(word.len + 1, rest.len).trim().value_or(rest); },
                });
            },
            false => h.break(),
        });
    });
    rest
}

// ---------------------------------------------------------------------
// Type layout
// ---------------------------------------------------------------------

// `zg_u32x8` -> 32 bytes. The C backend aligns every vector type to 16.
vector_layout = (ctype: str) Res<Layout> {
    (ctype.starts_with("zg_u") && ctype.contains('x')).ensure().try();
    body  = ctype.slice(4, ctype.len);
    cross = body.find('x').try();
    bits  = body.slice(0, cross).parse_usize().try();
    lanes = body.slice(cross + 1, body.len).parse_usize().try();
    Ok(Layout(size: bits / 8 * lanes, align: 16, vector: true))
}

scalar_layout = (ctype: str) Res<Layout> {
    ctype.contains('*').match({
        true  => Ok(Layout(size: 8, align: 8, vector: false)),
        false => ctype.match({
            "uint8_t"       => Ok(Layout(size: 1, align: 1, vector: false)),
            "int8_t"        => Ok(Layout(size: 1, align: 1, vector: false)),
            "bool"          => Ok(Layout(size: 1, align: 1, vector: false)),
            "char"          => Ok(Layout(size: 1, align: 1, vector: false)),
            "unsigned char" => Ok(Layout(size: 1, align: 1, vector: false)),
            "uint16_t"      => Ok(Layout(size: 2, align: 2, vector: false)),
            "int16_t"       => Ok(Layout(size: 2, align: 2, vector: false)),
            "uint32_t"      => Ok(Layout(size: 4, align: 4, vector: false)),
            "int32_t"       => Ok(Layout(size: 4, align: 4, vector: false)),
            "int"           => Ok(Layout(size: 4, align: 4, vector: false)),
            "unsigned"      => Ok(Layout(size: 4, align: 4, vector: false)),
            "float"         => Ok(Layout(size: 4, align: 4, vector: true)),
            "uint64_t"      => Ok(Layout(size: 8, align: 8, vector: false)),
            "int64_t"       => Ok(Layout(size: 8, align: 8, vector: false)),
            "size_t"        => Ok(Layout(size: 8, align: 8, vector: false)),
            "long"          => Ok(Layout(size: 8, align: 8, vector: false)),
            "double"        => Ok(Layout(size: 8, align: 8, vector: true)),
            "zg_u128"       => Ok(Layout(size: 16, align: 16, vector: false)),
            "zg_str"        => Ok(Layout(size: 16, align: 8, vector: false)),
            _               => vector_layout(ctype),
        }),
    })
}

round_up = (n: usize, align: usize) usize {
    (align == 0).match({ true => n, false => (n + align - 1) / align * align })
}

// The body lines of `struct NAME {` .. `};`.
struct_body = (a: Alloc, c: str, name: str) Res<Vec<str>, AllocError> {
    head = a.String("struct {} {", name).try();
    out    ::= a.Vec<str>();
    inside ::= false;
    depth  ::= 0;
    c.lines().loop((h, line) {
        inside.match({
            false => { line.starts_with(head.view()).then(() { inside = true; depth = 1; }); },
            true  => {
                t = line.trim().value_or("");
                (t.ends_with("{")).then(() { depth = depth + 1; });
                (t.starts_with("}")).then(() { depth = depth - 1; });
                (depth == 0).match({
                    true  => h.break(),
                    false => out.add(t).try(),
                });
            },
        });
    });
    Ok(out)
}

// Size and alignment of a C type spelled in the generated file. Nested
// `union {` blocks take their largest member; `struct {` blocks sum.
layout_of* = (a: Alloc, c: str, ctype: str) Res<Layout> {
    scalar_layout(ctype).match({
        Ok(l) => Ok(l),
        None  => {
            body = struct_body(
                a,
                c,
                ctype
            ).match({ Ok(b) => b, Err(_) => a.Vec<str>() });
            (body.len > 0).ensure().try();
            aggregate(a, c, body, 0, body.len, false)
        },
    })
}

// Lay out the fields in body[from..to]; `union` overlaps them.
aggregate = (
    a     : Alloc,
    c     : str,
    body  : Vec<str>,
    from  : usize,
    to    : usize,
    union : bool
) Res<Layout> {
    size: usize  ::= 0;
    align: usize ::= 1;
    vector       ::= true;
    i            ::= from;
    ok           ::= true;
    loop(() { i < to && ok }, (h) {
        line   = body.get(i).value_or("");
        nested = line.eq("union {") || line.eq("struct {");
        nested.match({
            true  => {
                // Find the matching close.
                depth ::= 1;
                j     ::= i + 1;
                loop(() { j < to && depth > 0 }, (h2) {
                    t = body.get(j).value_or("");
                    t.ends_with("{").then(() { depth = depth + 1; });
                    t.starts_with("}").then(() { depth = depth - 1; });
                    j = j + 1;
                });
                inner = aggregate(a, c, body, i + 1, j - 1, line.eq("union {"));
                inner.match({
                    Ok(l) => {
                        align  = align.max(l.align);
                        size   = union.match({ true => size.max(l.size), false => round_up(size, l.align) + l.size });
                        vector = vector && l.vector;
                    },
                    None  => { ok = false; },
                });
                i = j;
            },
            false => {
                field(a, c, line).match({
                    Ok(l) => {
                        align  = align.max(l.align);
                        size   = union.match({ true => size.max(l.size), false => round_up(size, l.align) + l.size });
                        vector = vector && l.vector;
                    },
                    None  => { ok = false; },
                });
                i = i + 1;
            },
        });
    });
    ok.ensure().try();
    Ok(Layout(size: round_up(size, align), align: align, vector: vector && size > 0))
}

max = (
    self  : usize,
    other : usize
) usize { (self > other).match({ true => self, false => other }) }

// `uint64_t zg_elems[4];`, `zu_tFoo_1234 zu_m1x;`, `uint8_t *zu_m1p;`
field = (a: Alloc, c: str, line: str) Res<Layout> {
    text  = line.ends_with(";").match({ true => line.slice(0, line.len - 1), false => line });
    count = text.ends_with("]").match({
        true  => text.slice(
            text.rfind('[').try() + 1,
            text.len - 1
        ).parse_usize().try(),
        false => 1,
    });
    decl  = text.ends_with("]").match({ true => text.slice(0, text.rfind('[').try()), false => text });
    cut   = last_identifier(decl);
    ctype = decl.slice(0, cut).trim().try();
    l     = layout_of(a, c, ctype).try();
    Ok(Layout(size: l.size * count, align: l.align, vector: l.vector))
}

// ---------------------------------------------------------------------
// Calling conventions
// ---------------------------------------------------------------------

X86_ARGS = [str, 6]("rdi", "rsi", "rdx", "rcx", "r8", "r9")

// Where one parameter arrives. Gpr and Vreg carry the first register and
// Placed.regs the count; Stack the entry-relative offset of its bytes;
// the *Pointer forms a hidden pointer to a copy (arm64 aggregates over 16
// bytes and 32-byte vectors).
Where = | Gpr(usize) | Vreg(usize) | Stack(usize) | GprPointer(usize) | StackPointer(usize)

Placed = { param: Param, layout: Layout, at: Where, regs: usize }

// Every parameter's location under the target's calling convention.
placements = (a: Alloc, isa: Isa, c: str, m: Marked) Res<Vec<Placed>, AllocError> {
    out   ::= a.Vec<Placed>();
    next  ::= 0;
    vnext ::= 0;
    // Stack arguments start above the return address on x86-64 and at the
    // stack pointer on arm64.
    stack: usize ::= isa.match({ X86 => 8, Arm => 0 });
    limit: usize = isa.match({ X86 => 6, Arm => 8 });
    x86 = isa.match({ X86 => true, Arm => false });
    (x86 && hidden_result(a, isa, c, m.result, m.avx) > 0).then(() { next = 1; });
    m.params.loop((p) {
        l = layout_of(a, c, p.ctype).match({ Ok(v) => v, None => Layout(size: 8, align: 8, vector: false) });
        // Registers a vector-class parameter needs: one per vector on
        // arm64 (a homogeneous aggregate of up to four), one on x86-64.
        vregs = x86.match({
            true  => 1,
            false => (l.size > 16 && l.size % 16 == 0 && l.size <= 64).match({ true => l.size / 16, false => 1 }),
        });
        fits_vreg = l.vector && x86.match({
            true  => l.size <= 16 || (l.size <= 32 && m.avx && l.align >= 16 && vector_type(p.ctype)),
            false => l.size <= 16 || (l.size <= 64 && l.size % 16 == 0 && !vector_type(p.ctype)),
        });
        where: Where = (fits_vreg && vnext + vregs <= 8).match({
            true  => {
                w = Where.Vreg(vnext);
                vnext = vnext + vregs;
                w
            },
            false => {
                regs     = (l.size + 7) / 8;
                // arm64 puts a 16-byte-aligned pair in an even register pair.
                (!x86 && !l.vector && l.align == 16 && next % 2 == 1 && l.size <= 16).then(() {
                    next = next + 1;
                });
                indirect = !x86 && l.size > 16;
                in_regs  = !l.vector && l.size <= 16 && next + regs <= limit;
                (in_regs || (indirect && next < limit)).match({
                    true  => {
                        w = indirect.match({ true => Where.GprPointer(next), false => Where.Gpr(next) });
                        next = next + indirect.match({ true => 1, false => regs });
                        w
                    },
                    false => {
                        stack = round_up(stack, l.align.max(8));
                        w = indirect.match({ true => Where.StackPointer(stack), false => Where.Stack(stack) });
                        stack = stack + indirect.match({ true => 8, false => round_up(l.size, 8) });
                        (!x86 && !l.vector).then(() { next = limit; });
                        (!x86 && l.vector).then(() { vnext = 8; });
                        w
                    },
                })
            },
        });
        count = where.match({
            Gpr(_)  => (l.size + 7) / 8,
            Vreg(_) => vregs,
            _       => 1,
        });
        out.add(Placed(param: p, layout: l, at: where, regs: count)).try();
    });
    Ok(out)
}

// A std.simd CPU capability (Avx2, Aes, Clmul, ...): a struct whose one
// field is the `proof` byte.
capability = (a: Alloc, c: str, ctype: str) bool {
    struct_body(a, c, ctype).match({
        Ok(body) => body.len == 1 && body.get(0).value_or("").eq("uint8_t zu_m5proof;"),
        Err(_)   => false,
    })
}

// A std.simd vector type itself (not a struct that contains vectors).
vector_type = (ctype: str) bool { vector_layout(ctype).match({ Ok(_) => true, None => false }) }

// Bytes a result of C type `result` returns through a hidden pointer, or 0.
hidden_result = (a: Alloc, isa: Isa, c: str, result: str, avx: bool) usize {
    layout_of(a, c, result).match({
        None    => 0,
        Ok(l)   => in_result_registers(isa, l, vector_type(result), avx).match({ true => 0, false => l.size }),
    })
}

in_result_registers = (isa: Isa, l: Layout, vector: bool, avx: bool) bool {
    isa.match({
        X86 => l.size <= 16 || (vector && l.size <= 32 && avx),
        Arm => l.size <= 16 || (l.vector && !vector && l.size <= 64 && l.size % 16 == 0),
    })
}

seed_of* = (a: Alloc, isa: Isa, c: str, m: Marked) Res<Seed, AllocError> {
    values   ::= a.Vec<str>();
    pointers ::= a.Vec<str>();
    slots    ::= a.Vec<i64>();
    pslots   ::= a.Vec<i64>();
    pointers2 ::= a.Vec<str>();
    // The hidden result pointer addresses memory that will hold the
    // result, which the body may build there and read back. A public
    // result returned that way must not have secrets stored into it.
    hidden = hidden_result(a, isa, c, m.result, m.avx) > 0;
    hidden_reg = isa.match({ X86 => "rdi", Arm => "x8" });
    hidden.then(() { pointers.add(hidden_reg).try(); });
    placements(a, isa, c, m).try().loop((pl) {
        marked_value = pl.param.name.is_in(m.secret);
        point2 = pl.param.name.is_in(m.pointee2);
        // A by-value aggregate the C backend lends as `const T *`: the
        // secret bytes are behind the pointer.
        lent  = pl.param.ctype.starts_with("const ") && pl.param.ctype.ends_with("*");
        value = marked_value && !lent;
        point = pl.param.name.is_in(m.pointee) || (marked_value && lent);
        pl.at.match({
            Gpr(i)          => Range(0, pl.regs).loop((k) {
                reg = reg_name(a, isa, i + k).try();
                value.then(() { values.add(reg).try(); });
                point.then(() { pointers.add(reg).try(); });
                point2.then(() { pointers2.add(reg).try(); });
            }),
            Vreg(i)         => Range(0, pl.regs).loop((k) {
                value.then(() { values.add(vector_name(a, isa, i + k).try()).try(); });
            }),
            Stack(at)       => {
                point.then(() { pslots.add(wide(at)).try(); });
                value.then(() {
                    Range(0, (pl.layout.size + 7) / 8).loop((k) { slots.add(wide(at + k * 8)).try(); });
                });
            },
            GprPointer(i)   => { (value || point).then(() { pointers.add(reg_name(a, isa, i).try()).try(); }); },
            StackPointer(at) => { (value || point).then(() { pslots.add(wide(at)).try(); }); },
        });
    });
    Ok(Seed(
        values: values,
        pointers: pointers,
        slots: slots,
        pointer_slots: pslots,
        pointers2: pointers2,
        result_pointer: (hidden && m.public_result).match({ true => hidden_reg, false => "" })
    ))
}

// Registers that carry the result of `m` when it is audited as
// public-result: the integer result register (or pair), or the first
// vector register. A result through a hidden pointer is memory, which the
// analysis does not follow.
result_registers* = (a: Alloc, isa: Isa, c: str, m: Marked) Res<Vec<str>, AllocError> {
    out ::= a.Vec<str>();
    m.public_result.then(() {
        layout_of(a, c, m.result).when_ok((l) {
            in_result_registers(isa, l, vector_type(m.result), m.avx).then(() {
                l.vector.match({
                    true  => out.add(vector_name(a, isa, 0).try()).try(),
                    false => {
                        // A byte-sized result (bool, u8) is only its low byte.
                        out.add(isa.match({
                            X86 => (l.size == 1).match({ true => "rax/1", false => "rax" }),
                            Arm => "x0",
                        })).try();
                        (l.size > 8).then(() { out.add(isa.match({ X86 => "rdx", Arm => "x1" })).try(); });
                    },
                });
            });
        });
    });
    Ok(out)
}

wide = (n: usize) i64 { n.truncate_u32().to_i64() }

reg_name = (a: Alloc, isa: Isa, i: usize) Res<str, AllocError> {
    isa.match({
        X86 => Ok(X86_ARGS[i]),
        Arm => a.String("x{}", i).match({ Ok(s) => Ok(s.view()), Err(e) => Err(e) }),
    })
}

// The analysis's name for vector register i: mm<i> (xmm/ymm/zmm) or v<i>.
vector_name = (a: Alloc, isa: Isa, i: usize) Res<str, AllocError> {
    isa.match({
        X86 => a.String("mm{}", i),
        Arm => a.String("v{}", i),
    }).match({ Ok(s) => Ok(s.view()), Err(e) => Err(e) })
}

// ---------------------------------------------------------------------
// Manifests: functions audited without a Secret marker
// ---------------------------------------------------------------------

// A manifest names functions whose inputs are secret but whose signatures
// cannot say so (shared arithmetic that also serves public verification):
//
//   # module  function          secret parameters (*name: secret pointee)
//   p256      table_select      n
//   aes_gcm   ghash_mul         x y
//   tls13_cert_config  Tls13CertConfig.release  *self
//   aes_gcm   aes_gcm_open      *key *scratch branches=1
//   chacha20_simd  stream8      *j public-result
//   aes_gcm_simd   ctr_hw       **hw *output
//
// Every definition of the function (each overload and instantiation) is
// audited. An entry that matches no definition is an error, unless its
// module is written `?module`: the program may not reach that module.
// `branches=N` allows N secret-dependent conditional branches (see Marked);
// `public-result` requires the result register to be public at every
// return (for a result returned through a hidden pointer: that no secret is
// stored through it), which lets callers treat it as public. `**name` is a pointer to
// memory whose words point at secret memory (a struct of key-schedule
// pointers): a load through it yields a pointer to secrets.
Entry* = {
    module*: str,
    function*: str,
    secret*: Vec<str>,
    pointee*: Vec<str>,
    pointee2*: Vec<str>,
    optional*: bool,
    branches*: usize,
    public_result*: bool,
}

manifest_entries* = (a: Alloc, text: str) Res<Vec<Entry>, AllocError> {
    out ::= a.Vec<Entry>();
    text.lines().loop((raw) {
        line = raw.split_once('#').match({ Ok(p) => p.before, None => raw }).trim().value_or("");
        words ::= a.Vec<str>();
        line.split(' ').loop((w) { (w.len > 0).then(() { words.add(w).try(); }); });
        (words.len >= 2).then(() {
            secret   ::= a.Vec<str>();
            pointee  ::= a.Vec<str>();
            pointee2 ::= a.Vec<str>();
            branches ::= 0;
            public   ::= false;
            Range(2, words.len).loop((i) {
                w = words.get(i).value_or("");
                w.starts_with("branches=").match({
                    true  => { branches = w.slice(9, w.len).parse_usize().value_or(0); },
                    false => w.eq("public-result").match({
                        true  => { public = true; },
                        false => w.starts_with("**").match({
                            true  => pointee2.add(w.slice(2, w.len)).try(),
                            false => w.starts_with("*").match({
                                true  => pointee.add(w.slice(1, w.len)).try(),
                                false => secret.add(w).try(),
                            }),
                        }),
                    }),
                });
            });
            head     = words.get(0).value_or("");
            optional = head.starts_with("?");
            out.add(Entry(
                optional: optional,
                branches: branches,
                public_result: public,
                module: optional.match({ true => head.slice(
                    1,
                    head.len
                ), false => head }),
                function: words.get(1).value_or(""),
                secret: secret,
                pointee: pointee,
                pointee2: pointee2
            )).try();
        });
    });
    Ok(out)
}

// The Zen C backend's function symbol prefix: zu_f<n>_ then each path
// component of the module and the function (Type.method included) as
// <length><text>.
symbol_prefix* = (a: Alloc, e: Entry) Res<String, AllocError> {
    parts ::= a.Vec<str>();
    e.module.split('.').loop((p) { parts.add(p).try(); });
    e.function.split('.').loop((p) { parts.add(p).try(); });
    out ::= a.String("zu_f{}_", parts.len).try();
    parts.loop((p) { out.fmt("{}{}", p.len, p).try(); });
    Ok(out)
}

// A C parameter's name for a Zen parameter.
local_name = (a: Alloc, name: str) Res<str, AllocError> {
    a.String("zu_l{}{}", name.len, name).match({ Ok(s) => Ok(s.view()), Err(e) => Err(e) })
}

// Definitions matching a manifest entry, as marked functions.
manifest_functions* = (
    a : Alloc,
    c : str,
    e : Entry
) Res<Vec<Marked>, AllocError> {
    prefix = symbol_prefix(a, e).try();
    out ::= a.Vec<Marked>();
    c.lines().loop((raw) {
        (raw.starts_with("static ") && raw.ends_with("{")).then(() {
            line   = plain_definition(a, raw).try();
            open   = line.find('(').value_or(0);
            head   = line.slice(0, open);
            space  = head.rfind(' ').value_or(0);
            symbol = head.slice(space + 1, head.len);
            next   = symbol.slice(prefix.len().min(symbol.len), symbol.len);
            (symbol.starts_with(prefix.view()) && (next.len == 0 || next.starts_with("O"))).then(() {
                parse_plain(a, line).when_ok((m) {
                    secret   ::= a.Vec<str>();
                    pointee  ::= a.Vec<str>();
                    pointee2 ::= a.Vec<str>();
                    e.pointee2.loop(
                        (n) { pointee2.add(local_name(a, n).try()).try(); }
                    );
                    e.secret.loop(
                        (n) { secret.add(local_name(a, n).try()).try(); }
                    );
                    e.pointee.loop(
                        (n) { pointee.add(local_name(a, n).try()).try(); }
                    );
                    out.add(Marked(
                        symbol: m.symbol,
                        result: m.result,
                        params: m.params,
                        secret: secret,
                        pointee: pointee,
                        pointee2: pointee2,
                        branches: e.branches,
                        avx: m.avx,
                        public_result: e.public_result
                    )).try();
                });
            });
        });
    });
    Ok(out)
}

// A definition line without the marker comment.
parse_plain = (a: Alloc, raw: str) Res<Marked> {
    line   = plain_definition(a, raw).match({ Ok(l) => Ok(l), Err(_) => None }).try();
    at     = line.rfind(')').try();
    marked = a.String("{} {} */ {", line.slice(0, at + 1), MARK).match({ Ok(s) => Ok(s), Err(_) => None }).try();
    parse_definition(a, marked.view())
}

// ---------------------------------------------------------------------
// Parameter kinds from the mangled symbol
// ---------------------------------------------------------------------

// The C backend names a function zu_f<path>O<count>_<type codes> (see
// src/gen/gen_name.zen): a count is digits then `_`, a component its
// length then its text, and a type code one of z q, b<comp>,
// t<path>[I<types>], f<type><types>, u<types>, a<count><type>.
Mangled = {
    text: str,
    at :: usize,

    number = (self :: @Self) Res<usize> {
        start = self.at;
        loop(() { self.at < self.text.len && is_digit(self.text.index(self.at)) }, (h) { self.at = self.at + 1; });
        (self.at > start).ensure().try();
        self.text.slice(start, self.at).parse_usize()
    }

    count = (self :: @Self) Res<usize> {
        n = self.number().try();
        (self.at < self.text.len && self.text.index(self.at) == '_').ensure().try();
        self.at = self.at + 1;
        Ok(n)
    }

    component = (self :: @Self) Res<()> {
        n = self.number().try();
        (self.at + n <= self.text.len).ensure().try();
        self.at = self.at + n;
        Ok(())
    }

    types = (self :: @Self) Res<()> {
        n = self.count().try();
        ok ::= true;
        Range(0, n).loop((h, i) { self.skip_type().match({ Ok(_) => (), None => { ok = false; h.break(); } }); });
        ok.ensure()
    }

    skip_type = (self :: @Self) Res<()> {
        (self.at < self.text.len).ensure().try();
        tag = self.text.index(self.at);
        self.at = self.at + 1;
        (tag == 'z' || tag == 'q').match({
            true  => Ok(()),
            false => (tag == 'b').match({
                true  => self.component(),
                false => (tag == 't').match({
                    true  => {
                        k = self.count().try();
                        ok ::= true;
                        Range(0, k).loop((h, i) { self.component().match({ Ok(_) => (), None => { ok = false; h.break(); } }); });
                        ok.ensure().try();
                        (self.at < self.text.len && self.text.index(self.at) == 'I').match({
                            true  => {
                                self.at = self.at + 1;
                                self.types()
                            },
                            false => Ok(()),
                        })
                    },
                    false => (tag == 'f').match({
                        true  => {
                            self.skip_type().try();
                            self.types()
                        },
                        false => (tag == 'u').match({
                            true  => self.types(),
                            false => (tag == 'a').match({
                                true  => {
                                    self.count().try();
                                    self.skip_type()
                                },
                                false => None,
                            }),
                        }),
                    }),
                }),
            }),
        })
    }
}

is_digit = (c: u8) bool { c >= '0' && c <= '9' }

PTR_CODE: str = "t4_3std3mem7mem_ptr3PtrI"

// For each declared parameter, whether its Zen type is a Ptr<T> (an
// address with no extent); None when the symbol does not decode.
pointer_params = (a: Alloc, symbol: str) Res<Vec<bool>> {
    symbol.starts_with("zu_f").ensure().try();
    m ::= Mangled(text: symbol, at: 4);
    k = m.count().try();
    Range(0, k).loop((i) { m.component().match({ _ => () }); });
    (m.at < symbol.len && symbol.index(m.at) == 'O').ensure().try();
    m.at = m.at + 1;
    n = m.count().try();
    out ::= a.Vec<bool>();
    ok ::= true;
    Range(0, n).loop((h, i) {
        out.add(symbol.slice(m.at, symbol.len).starts_with(PTR_CODE)).match({ _ => () });
        m.skip_type().match({ Ok(_) => (), None => { ok = false; h.break(); } });
    });
    ok.ensure().try();
    Ok(out)
}

// Every function's calling shape, for the taint analysis's call rule:
// only its argument registers and stack arguments can carry a secret into
// the callee.
call_shapes* = (
    a   : Alloc,
    isa : Isa,
    c   : str
) Res<Map<str, CallShape>, AllocError> {
    out ::= a.Map<str, CallShape>();
    c.lines().loop((line) {
        head = line.starts_with("static ") && line.contains('(')
            && (line.ends_with(";") || line.ends_with("{"));
        head.then(() {
            parse_plain(a, line.ends_with(";").match({
                true  => a.String(
                    "{} {",
                    line.slice(0, line.len - 1)
                ).try().view(),
                false => line,
            })).when_ok((m) {
                out.set(m.symbol, shape_of(a, isa, c, m).try()).try();
            });
        });
    });
    Ok(out)
}

shape_of = (a: Alloc, isa: Isa, c: str, m: Marked) Res<CallShape, AllocError> {
    x86      = isa.match({ X86 => true, Arm => false });
    hidden   = hidden_result(a, isa, c, m.result, m.avx);
    gprs: usize ::= (x86 && hidden > 0).match({ true => 1, false => 0 });
    vectors: usize ::= 0;
    stack: usize ::= 0;
    writable ::= a.Vec<Writable>();
    ignored  ::= a.Vec<str>();
    // A `::` or lent parameter names exactly one value; a Ptr<T> any extent.
    kinds: Res<Vec<bool>> = pointer_params(a, m.symbol);
    decoded = kinds.match({ Ok(k) => k.len == m.params.len, None => false });
    pointer_args ::= a.Vec<str>();
    base: usize = isa.match({ X86 => 8, Arm => 0 });
    placements(a, isa, c, m).try().loop((pl) {
        pl.at.match({
            Gpr(i)           => {
                gprs = gprs.max(i + pl.regs);
                capability(a, c, pl.param.ctype).then(() { ignored.add(reg_name(a, isa, i).try()).try(); });
                pl.param.ctype.ends_with("*").then(() { pointer_args.add(reg_name(a, isa, i).try()).try(); });
                (pl.param.ctype.ends_with("*") && !pl.param.ctype.starts_with("const ")).then(() {
                    unbounded = !decoded || kinds.match({
                        Ok(k) => k.get(placed_index(m, pl.param.name)).value_or(true),
                        None  => true,
                    });
                    pointee = pl.param.ctype.slice(0, pl.param.ctype.len - 1).trim().value_or("");
                    bytes = unbounded.match({
                        true  => 0,
                        false => layout_of(a, c, pointee).match({ Ok(l) => l.size, None => 0 }),
                    });
                    writable.add(Writable(index: i, bytes: bytes)).try();
                });
            },
            Vreg(i)          => { vectors = vectors.max(i + pl.regs); },
            Stack(at)        => { stack = stack.max(at + round_up(pl.layout.size, 8) - base); },
            GprPointer(i)    => {
                gprs = gprs.max(i + 1);
                pointer_args.add(reg_name(a, isa, i).try()).try();
            },
            StackPointer(at) => { stack = stack.max(at + 8 - base); },
        });
    });
    result = layout_of(a, c, m.result);
    Ok(CallShape(
        gprs: gprs,
        vectors: vectors,
        stack: stack,
        returns: result.match({ Ok(_) => hidden == 0, None => false }),
        pair: result.match({ Ok(l) => !l.vector && l.size > 8 && l.size <= 16, None => false }),
        vector_result: result.match({ Ok(l) => l.vector && hidden == 0, None => false }),
        hidden: hidden,
        writable: writable,
        ignored: ignored,
        pointer_args: pointer_args,
        known: true,
        reads: a.Vec<str>(),
        reads_known: false,
        audited: false,
        public_result: false,
        values: a.Vec<str>(),
        pointers: a.Vec<str>(),
        slots: a.Vec<i64>(),
        pointer_slots: a.Vec<i64>(),
        pointers2: a.Vec<str>()
    ))
}

// The position of a parameter by its C name.
placed_index = (m: Marked, name: str) usize {
    Range(0, m.params.len).find((i) { m.params.get(i).match({ Ok(p) => p.name.eq(name), None => false }) }).value_or(0)
}

// The shape of an audited function: what its audit seeds and proves.
audited_shape* = (
    a     : Alloc,
    isa   : Isa,
    c     : str,
    m     : Marked,
    shape : CallShape
) Res<CallShape, AllocError> {
    seed = seed_of(a, isa, c, m).try();
    Ok(CallShape(
        gprs: shape.gprs,
        vectors: shape.vectors,
        stack: shape.stack,
        returns: shape.returns,
        pair: shape.pair,
        vector_result: shape.vector_result,
        hidden: shape.hidden,
        writable: shape.writable,
        ignored: shape.ignored,
        pointer_args: shape.pointer_args,
        known: true,
        reads: shape.reads,
        reads_known: shape.reads_known,
        audited: true,
        public_result: m.public_result,
        values: seed.values,
        pointers: seed.pointers,
        slots: seed.slots,
        pointer_slots: seed.pointer_slots,
        pointers2: seed.pointers2
    ))
}
