// Controls for tools/ct. The first group is constant time by construction
// and must pass every static and dynamic check. The `leaky_` group is code
// nobody marked Secret, so sema's discipline cannot see its secrets;
// controls/manifest.txt names its secret parameters, and every check must
// flag it. Both groups include vector (std.simd) code: secrets in XMM/YMM
// and V registers, vectors passed by value, spilled to the stack and
// combined by instructions that also read their destination.
Secret, declassify, Choice = std.ct
ct_eq, ct_lt, ct_select, ct_swap, ct_memeq, ct_lookup = std.ct
bit_xor, bit_and, shift_right, mul_wide, truncate_u64, truncate_u8 = std.core.num
to_u64, to_usize, add_carry, sub_borrow = std.core.num
Ptr = std.mem
Avx2, Clmul, Adx, Bmi2, avx2, clmul, adx, bmi2, mul_limbs, square_limbs = std.simd
load_u8x16, load_u32x4, load_u64x2, load_u32x8, lanes_u64x2, splat_u32x4 = std.simd

// Branch-free selection on a secret comparison.
select_min* = (a: Secret<u64>, b: Secret<u64>) Secret<u64> {
    ct_lt(a, b).ct_select(a, b)
}

// A four-limb product's low words, fiat style: wide multiplies and carries.
mul_low* = (x: Secret<[u64, 4]>, y: Secret<[u64, 4]>) Secret<[u64, 4]> {
    p0 = x[0].mul_wide(y[0]);
    p1 = x[0].mul_wide(y[1]) +% x[1].mul_wide(y[0]) +% p0.shift_right(64);
    p2 = x[0].mul_wide(y[2]) +% x[1].mul_wide(y[1]) +% x[2].mul_wide(y[0]) +% p1.shift_right(64);
    p3 = x[0].mul_wide(y[3]) +% x[1].mul_wide(y[2]) +% x[2].mul_wide(y[1]) +% x[3].mul_wide(y[0])
        +% p2.shift_right(64);
    [u64, 4](p0.truncate_u64(), p1.truncate_u64(), p2.truncate_u64(), p3.truncate_u64())
}

// Carry and borrow chains over secret limbs: x + y - z, four limbs.
carry_chain* = (x: Secret<[u64, 4]>, y: Secret<[u64, 4]>, z: Secret<[u64, 4]>) Secret<[u64, 4]> {
    s0 = x[0].add_carry(y[0], 0); s1 = x[1].add_carry(y[1], s0[1]);
    s2 = x[2].add_carry(y[2], s1[1]); s3 = x[3].add_carry(y[3], s2[1]);
    d0 = s0[0].sub_borrow(z[0], 0); d1 = s1[0].sub_borrow(z[1], d0[1]);
    d2 = s2[0].sub_borrow(z[2], d1[1]); d3 = s3[0].sub_borrow(z[3], d2[1]);
    [u64, 4](d0[0], d1[0], d2[0], d3[0])
}

// The two-chain products (MULX, ADCX, ADOX on x86-64) of secret limbs.
limb_products* = (adx: Adx, bmi: Bmi2, x: Secret<[u64, 4]>, y: Secret<[u64, 4]>) Secret<[u64, 8]> {
    p = x.mul_limbs(y, adx, bmi);
    q = x.square_limbs(adx, bmi);
    [u64, 8](p[0].bit_xor(q[0]), p[1], p[2], p[3], p[4], p[5], p[6], p[7].bit_xor(q[7]))
}

// A Montgomery-ladder step: swap two field elements by a secret bit.
ladder_swap* = (x: Secret<Ptr<u64>>, y: Secret<Ptr<u64>>, bit: Secret<u64>) {
    ct_swap(x, y, 10, ct_eq(bit.bit_and(1), 1));
}

// Tag comparison over every byte.
tags_equal* = (tag: Secret<Ptr<u8>>, expected: Ptr<u8>) bool {
    ct_memeq(tag, expected, 16).declassify_bool()
}

// A full-scan table read at a secret index.
sbox* = (table: Ptr<u8>, index: Secret<usize>) Secret<u8> { ct_lookup(
    table,
    256,
    index
) }

// Uses its secret as an address only after declassifying it: the marker
// std.ct leaves in the assembly makes the value public there, so this passes.
declassified_index* = (key: Secret<u64>, table: Ptr<u8>) u8 {
    table.read(declassify(key).truncate_u8().to_usize())
}

// ChaCha-style vector rounds on a secret key: loads, adds, xors, lane
// rotations and shuffles, stored back to secret memory.
vector_rounds* = (key: Secret<Ptr<u8>>, out: Secret<Ptr<u8>>) {
    a ::= load_u32x4(key, 0);
    b ::= load_u32x4(key, 16);
    c ::= load_u32x4(key, 32);
    d ::= load_u32x4(key, 48);
    Range(0, 10).loop((i) {
        a = a.add_wrap(b); d = d.bit_xor(a).rotate_left(16);
        c = c.add_wrap(d); b = b.bit_xor(c).rotate_left(12);
        a = a.add_wrap(b); d = d.bit_xor(a).rotate_left(8);
        c = c.add_wrap(d); b = b.bit_xor(c).rotate_left(7);
        b = b.shuffle([1, 2, 3, 0]);
        c = c.shuffle([2, 3, 0, 1]);
        d = d.shuffle([3, 0, 1, 2]);
    });
    a.store(out, 0);
    b.store(out, 16);
    c.store(out, 32);
    d.store(out, 48);
}

// Secret vectors by value in and out (XMM/V registers).
vector_value* = (x: Secret<u64x2>, y: Secret<u64x2>) Secret<u64x2> {
    x.mul_low32(y).add_wrap(x.shift_right(32).mul_low32(y.shuffle([1, 0])))
}

// Eight-lane rounds compiled for AVX2 (YMM registers on x86-64).
wide_rounds* = (cpu: Avx2, key: Secret<Ptr<u8>>, out: Secret<Ptr<u8>>) {
    a ::= load_u32x8(key, 0);
    b ::= load_u32x8(key, 32);
    Range(0, 8).loop((i) {
        a = a.add_wrap(b).rotate_left(16);
        b = b.bit_xor(a).rotate_left(7).shuffle([7, 0, 1, 2, 3, 4, 5, 6]);
    });
    a.bit_xor(b).store(out, 0);
}

// A key schedule reached through a lent struct of pointers, as the
// hardware AES-GCM code passes its round keys.
Schedule* = { keys*: Ptr<u8>, powers*: Ptr<u8>, rounds*: usize }

// XORs every round key into a block: constant time.
schedule_mix* = (s: Schedule, out: Ptr<u8>) {
    b ::= load_u8x16(out, 0);
    Range(0, s.rounds).loop((r) { b = b.bit_xor(load_u8x16(s.keys, 16 * r)); });
    b.store(out, 0);
}

// Leaks through an early exit: the loop stops at the first difference.
leaky_compare* = (tag: Ptr<u8>, expected: Ptr<u8>) bool {
    same: bool ::= true;
    Range(0, 16).loop((h, i) {
        (tag.read(i) != expected.read(i)).then(() {
            same = false;
            h.break();
        });
    });
    same
}

// Leaks through the cache: the address depends on the secret.
leaky_index* = (table: Ptr<u8>, index: u64) u8 {
    table.read(index.truncate_u8().to_usize())
}

// Leaks through the cache from a limb of a by-value array argument (on the
// stack on x86-64, behind a hidden pointer on arm64).
leaky_limb* = (x: [u64, 4], table: Ptr<u8>) u8 {
    table.read(x[2].truncate_u8().to_usize())
}

// Leaks through division latency.
leaky_divide* = (key: u64, divisor: u64) u64 { key / divisor }

// Leaks through the cache: a lane of a secret vector chooses the address.
leaky_vector_index* = (key: Ptr<u8>, table: Ptr<u8>) u8 {
    v = load_u8x16(key, 0).bit_xor(load_u8x16(key, 16)).shuffle([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9, 3]);
    table.read(v.lane(5).to_usize())
}

// Leaks through a branch on a vector comparison.
leaky_vector_branch* = (key: Ptr<u8>, other: Ptr<u8>, sink: Ptr<u8>) {
    d = load_u64x2(key, 0).bit_xor(load_u64x2(other, 0));
    (d.lane(0).bit_or(d.lane(1)) == 0).then(() {
        Range(0, 64).loop((i) { sink.write_volatile(i, i.truncate_u8()); });
    });
}

// Leaks through the cache from a secret vector passed by value.
leaky_vector_param* = (v: u32x4, table: Ptr<u8>) u8 {
    table.read(v.lane(2).bit_and(255).to_usize())
}

// A lane chosen at run time: the vector goes to the stack and one byte of
// it comes back, which then chooses an address.
leaky_lane_spill* = (v: u8x16, i: usize, table: Ptr<u8>) u8 {
    table.read(v.lane(i % 16).to_usize())
}

// Multiply-accumulate into a secret accumulator (UMLAL on arm64, which
// reads its destination), then an address from the sum.
leaky_accumulate* = (acc: u64x2, x: u64x2, y: u64x2, table: Ptr<u8>) u8 {
    table.read(acc.add_wrap(x.mul_low32(y)).lane(0).truncate_u8().to_usize())
}

// A carry-less product whose secret operand is the destination of the
// two-address PCLMULQDQ on x86-64, then an address from the product.
leaky_clmul* = (cpu: Clmul, x: u64x2, h: u64x2, table: Ptr<u8>) u8 {
    table.read(x.clmul_low(h, cpu).lane(0).truncate_u8().to_usize())
}

// A product compiled for BMI2 (MULX on x86-64, which writes its low half to
// its middle operand and reads %rdx implicitly) whose low half chooses an
// address; the high half only goes to memory.
leaky_mulx_low* = (bmi: Bmi2, key: u64, m: u64, sink: Ptr<u64>, table: Ptr<u8>) u8 {
    p = key.mul_wide(m);
    sink.write(0, p.shift_right(64).truncate_u64());
    table.read(p.truncate_u64().truncate_u8().to_usize())
}

// A table lookup whose index parameter is public by its audit.
lookup* = (table: Ptr<u8>, index: u8) u8 { table.read(index.to_usize()) }

// Passes a secret to lookup's public index: the call is the leak.
leaky_call* = (key: Ptr<u8>, table: Ptr<u8>) u8 { lookup(table, key.read(0)) }

// A round-key byte, read through the lent schedule, chooses an address.
leaky_schedule* = (s: Schedule, table: Ptr<u8>) u8 {
    table.read(s.keys.read(s.rounds).to_usize())
}

// Audited as returning a public value, but returns key material.
leaky_result* = (key: Ptr<u8>) u64 { key.read_le64(0) }

// A 128-bit remainder, which C compiles to a call of the runtime library
// (__umodti3): the callee is not in the program, and the remainder of the
// secret chooses an address.
leaky_libcall* = (key: u64, d: u64, table: Ptr<u8>) u8 {
    table.read((key.to_u128().shift_left(64) % d.to_u128()).truncate_u64().truncate_u8().to_usize())
}

main = (env: Env) Res<(), AllocError> {
    a     = env.mem.alloc();
    bytes = a.raw(256, 16).try();
    Range(0, 256).loop((i) { bytes.write(i, i.truncate_u8() *% 29); });
    words = a.raw(160, 16).try().to<u64>();
    Range(0, 20).loop((i) { words.write(i, i.to_u64()); });
    x = [u64, 4](1, 2, 3, 4);
    y = [u64, 4](5, 6, 7, 8);
    ladder_swap(words, words.offset(10), 1);
    println(
        "{} {} {} {} {} {}",
        declassify(select_min(3, 9)),
        declassify(mul_low(x, y)[3]),
        words.read(0),
        tags_equal(bytes, bytes),
        declassify(sbox(bytes, 7)),
        declassified_index(3, bytes)
    );
    println(
        "{} {} {} {}",
        leaky_limb(x, bytes),
        leaky_compare(bytes, bytes.offset(1)),
        leaky_index(bytes, 300),
        leaky_divide(1000, 7)
    );
    mixed = a.raw(64, 16).try();
    vector_rounds(bytes, mixed);
    avx2().match({ Ok(cpu) => wide_rounds(cpu, bytes, mixed), None => () });
    leaky_vector_branch(bytes, bytes.offset(16), mixed);
    product = vector_value(lanes_u64x2(3, 5), lanes_u64x2(7, 11));
    println(
        "{} {} {} {} {} {}",
        mixed.read(0),
        declassify(product.lane(0)),
        leaky_vector_index(bytes, bytes),
        leaky_vector_param(splat_u32x4(9), bytes),
        leaky_lane_spill(load_u8x16(bytes, 0), 7, bytes),
        leaky_accumulate(lanes_u64x2(1, 2), lanes_u64x2(3, 4), lanes_u64x2(5, 6), bytes)
    );
    clmul().match({
        Ok(cpu) => println("{}", leaky_clmul(cpu, lanes_u64x2(3, 4), lanes_u64x2(5, 6), bytes)),
        None    => (),
    });
    println("{} {}", leaky_call(bytes, bytes), leaky_result(bytes));
    println("{}", leaky_libcall(1234, 97, bytes));
    chained = carry_chain(x, y, x);
    adx().match({
        Ok(fast) => bmi2().match({
            Ok(bmi) => println("{}", declassify(limb_products(fast, bmi, x, y)[7])),
            None    => (),
        }),
        None     => (),
    });
    bmi2().match({ Ok(bmi) => println("{}", leaky_mulx_low(bmi, 77, 91, words, bytes)), None => () });
    println("{}", declassify(chained[0]));
    schedule = Schedule(keys: bytes, powers: bytes.offset(128), rounds: 3);
    schedule_mix(schedule, mixed);
    println("{} {}", mixed.read(1), leaky_schedule(schedule, bytes));
    Ok(())
}
