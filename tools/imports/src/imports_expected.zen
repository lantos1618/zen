// A test names source positions in two places: a must-fail `.expected`
// lists the positions its diagnostic must point at, one `[path:]line:col`
// per line after the first (docs/TESTING.md), and a `.stderr` holds an
// expected substring that may contain `file.zen:line:col`. Inserting import
// lines above those positions moves them, so both move with the source.
Res, Ok, Err, None, ensure, loop = std.core
Alloc, AllocError = std.mem
Vec = std.collections
str, String = std.text
Env = std.env
println = std.io
Shift = imports_edit

// Move every position naming `file` in its test's sidecars as `shifts`
// moved its lines. A file outside tests/ has no sidecar to move.
shift_positions* = (env: Env, a: Alloc, file: str, shifts: Vec<Shift>)
                   Res<(), AllocError> {
    file.contains("tests/").match({
        false => Ok(()),
        true  => {
            file.contains("/must-fail/").then(() {
                owning_test(env, a, file, "expected").try().match({
                    None      => Ok(()),
                    Ok(owner) => shift_file(env, a, owner, shifts),
                }).try();
            });
            owning_test(env, a, file, "stderr").try().match({
                None      => Ok(()),
                Ok(owner) => shift_tokens_in(env, a, owner, shifts),
            })
        },
    })
}

// The sidecar that judges `file` and the names its positions use for it.
Owner = {
    expected: str,
    // The path a position names `file` by.
    named: str,
    // Whether a position without a path means `file`.
    entry: bool,
}

owning_test = (env: Env, a: Alloc, file: str, ext: str)
              Res<Res<Owner>, AllocError> {
    single ::= a.String().try();
    single.fmt("{}.{}", file.slice(0, file.len - 4), ext).try();
    env.fs.exists(single.view()).match({
        true  => Ok(Ok(Owner(
            expected: single.view(),
            named: base_of(file),
            entry: true,
        ))),
        false => directory_test(env, a, file, dir_of(file), ext),
    })
}

// The nearest enclosing directory test, whose sidecar sits at its root.
directory_test = (env: Env, a: Alloc, file: str, dir: str, ext: str)
                 Res<Res<Owner>, AllocError> {
    (dir.contains("tests/") && !dir.ends_with("tests")).match({
        false => Ok(None),
        true  => expected_in(env, a, dir, ext).try().match({
            None      => directory_test(env, a, file, dir_of(dir), ext),
            Ok(found) => {
                named = file.slice(dir.len + 1, file.len);
                entry = named.eq("main.zen") || named.eq(entry_name(a, dir).try());
                Ok(Ok(Owner(expected: found, named: named, entry: entry)))
            },
        }),
    })
}

expected_in = (env: Env, a: Alloc, dir: str, ext: str)
              Res<Res<str>, AllocError> {
    plain ::= a.String().try();
    plain.fmt("{}/.{}", dir, ext).try();
    main ::= a.String().try();
    main.fmt("{}/main.{}", dir, ext).try();
    own ::= a.String().try();
    own.fmt("{}/{}.{}", dir, base_of(dir), ext).try();
    Ok(env.fs.exists(plain.view()).match({
        true  => Ok(plain.view()),
        false => env.fs.exists(main.view()).match({
            true  => Ok(main.view()),
            false => env.fs.exists(own.view()).match({
                true  => Ok(own.view()),
                false => None,
            }),
        }),
    }))
}

entry_name = (a: Alloc, dir: str) Res<str, AllocError> {
    name ::= a.String().try();
    name.fmt("{}.zen", base_of(dir)).try();
    Ok(name.view())
}

shift_file = (env: Env, a: Alloc, owner: Owner, shifts: Vec<Shift>)
             Res<(), AllocError> {
    env.fs.read(a, owner.expected).match({
        Err(_)   => { println("zen-imports: cannot read {}", owner.expected); Ok(()) },
        Ok(text) => {
            out ::= a.String().try();
            text.view().lines().loop((h, i, line) {
                (i > 0).then(() { out.add("\n").try(); });
                (i == 0).match({
                    true  => out.add(line).try(),
                    false => shift_line(owner, line, shifts, out).try(),
                });
            });
            (text.view().ends_with("\n") && !out.view().ends_with("\n"))
                .then(() { out.add("\n").try(); });
            env.fs.write(owner.expected, out.view()).match({
                Ok(_)  => (),
                Err(_) => { println(
                    "zen-imports: cannot write {}",
                    owner.expected
                ); },
            });
            Ok(())
        },
    })
}

// One `[path:]line:col` line, moved when it names `owner`'s file; any other
// line is copied unchanged.
shift_line = (owner: Owner, line: str, shifts: Vec<Shift>, out :: String)
             Res<(), AllocError> {
    position(line).match({
        None   => out.add(line),
        Ok(at) => {
            mine = at.path.match({
                None  => owner.entry,
                Ok(p) => p.eq(owner.named),
            });
            (mine).match({
                false => out.add(line),
                true  => {
                    at.path.match({ Ok(p) => out.fmt(
                        "{}:",
                        p
                    ).try(), None => () });
                    out.fmt("{}:{}", moved(at.line, shifts), at.col)
                },
            })
        },
    })
}

moved = (line: usize, shifts: Vec<Shift>) usize {
    now ::= line;
    shifts.loop((s) {
        (line >= s.from).then(() { now = now + s.down - s.up; });
    });
    now
}

Position = { path: Res<str>, line: usize, col: usize }

position = (line: str) Res<Position> {
    text = line.trim().try();
    last = text.rfind(':').try();
    col  = text.slice(last + 1, text.len).parse_usize().try();
    head = text.slice(0, last);
    head.rfind(':').match({
        None    => Ok(Position(
            path: None,
            line: head.parse_usize().try(),
            col: col
        )),
        Ok(cut) => Ok(Position(
            path: Ok(head.slice(0, cut)),
            line: head.slice(cut + 1, head.len).parse_usize().try(),
            col: col,
        )),
    })
}

dir_of = (path: str) str {
    path.rfind('/').match({ Ok(i) => path.slice(0, i), None => "." })
}

base_of = (path: str) str {
    path.rfind('/').match({ Ok(i) => path.slice(i + 1, path.len), None => path })
}

// Every `named:line:col` in a `.stderr`, moved; the rest is copied.
shift_tokens_in = (env: Env, a: Alloc, owner: Owner, shifts: Vec<Shift>)
                  Res<(), AllocError> {
    env.fs.read(a, owner.expected).match({
        Err(_)   => { println("zen-imports: cannot read {}", owner.expected); Ok(()) },
        Ok(text) => {
            out ::= a.String().try();
            shift_tokens(text.view(), owner.named, shifts, out).try();
            env.fs.write(owner.expected, out.view()).match({
                Ok(_)  => (),
                Err(_) => { println(
                    "zen-imports: cannot write {}",
                    owner.expected
                ); },
            });
            Ok(())
        },
    })
}

shift_tokens = (text: str, named: str, shifts: Vec<Shift>, out :: String)
               Res<(), AllocError> {
    at ::= 0;
    loop((h) {
        text.slice(at, text.len).find(named).match({
            None      => {
                out.add(text.slice(at, text.len)).try();
                h.break();
            },
            Ok(found) => {
                start = at + found;
                out.add(text.slice(at, start + named.len)).try();
                at    = start + named.len;
                whole = start == 0 || !path_byte(text.index(start - 1));
                (whole).then(() {
                    token_position(text, at).match({
                        None    => (),
                        Ok(pos) => {
                            out.fmt(":{}:{}", moved(pos.line, shifts), pos.col)
                                .try();
                            at = pos.end;
                        },
                    });
                });
            },
        });
    });
    Ok(())
}

// A byte that can continue a path, so `std/x.zen` is not `x.zen`.
path_byte = (b: u8) bool {
    b == '/' || b == '_' || b == '.' || b.is_alnum()
}

Token = { line: usize, col: usize, end: usize }

// `:line:col` starting at byte `at`, and where it ends.
token_position = (text: str, at: usize) Res<Token> {
    (at < text.len && text.index(at) == ':').ensure().try();
    line_end = digits_end(text, at + 1);
    (line_end > at + 1 && line_end < text.len && text.index(line_end) == ':')
        .ensure().try();
    col_end = digits_end(text, line_end + 1);
    (col_end > line_end + 1).ensure().try();
    Ok(Token(
        line: text.slice(at + 1, line_end).parse_usize().try(),
        col: text.slice(line_end + 1, col_end).parse_usize().try(),
        end: col_end,
    ))
}

digits_end = (text: str, from: usize) usize {
    end ::= from;
    loop((h) {
        (end < text.len && text.index(end).is_digit()).match({
            true  => { end = end + 1; },
            false => h.break(),
        });
    });
    end
}
